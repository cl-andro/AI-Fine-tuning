[
  {
    "instruction": "K3s ctr pull image",
    "output": "k3s ctr images pull docker.io/library/nginx:latest"
  },
  {
    "instruction": "List all pods in all namespaces",
    "output": "k3s kubectl get pods --all-namespaces"
  },
  {
    "instruction": "Get K3s token for agents",
    "output": "sudo cat /var/lib/rancher/k3s/server/token"
  },
  {
    "instruction": "K3s kubectl rollout status",
    "output": "k3s kubectl rollout status deployment my-deployment"
  },
  {
    "instruction": "K3s kubectl create namespace",
    "output": "k3s kubectl create namespace my-namespace"
  },
  {
    "instruction": "K3s ctr tag image",
    "output": "k3s ctr images tag docker.io/library/nginx:latest myregistry/nginx:latest"
  },
  {
    "instruction": "Install K3s with cluster-init",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init"
  },
  {
    "instruction": "K3s kubectl exec into pod",
    "output": "k3s kubectl exec -it my-pod -- /bin/sh"
  },
  {
    "instruction": "K3s logs pod",
    "output": "k3s kubectl logs -n default my-pod"
  },
  {
    "instruction": "Delete etcd snapshot",
    "output": "k3s etcd-snapshot delete --name mysnapshot"
  },
  {
    "instruction": "Install K3s with debug",
    "output": "curl -sfL https://get.k3s.io | sh -s - --debug server --cluster-init"
  },
  {
    "instruction": "K3s kubectl top nodes",
    "output": "k3s kubectl top nodes"
  },
  {
    "instruction": "Install K3s with local storage",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--disable=local-storage' sh -"
  },
  {
    "instruction": "Install K3s server with embedded etcd",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init --token mytoken"
  },
  {
    "instruction": "K3s ctr run container",
    "output": "k3s ctr run docker.io/library/nginx:latest my-nginx"
  },
  {
    "instruction": "Install K3s with etcd only",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init --datastore-endpoint etcd://127.0.0.1:2379"
  },
  {
    "instruction": "K3s etcd-snapshot prune",
    "output": "k3s etcd-snapshot prune --snapshot-retention 5"
  },
  {
    "instruction": "Save an etcd snapshot",
    "output": "k3s etcd-snapshot save --snapshot-dir=/var/lib/rancher/k3s/server/db/snapshots"
  },
  {
    "instruction": "List nodes with k3s kubectl",
    "output": "k3s kubectl get nodes"
  },
  {
    "instruction": "K3s kubectl rollout restart",
    "output": "k3s kubectl rollout restart deployment my-deployment"
  },
  {
    "instruction": "K3s kubectl cordon node",
    "output": "k3s kubectl cordon my-node"
  },
  {
    "instruction": "K3s kubectl drain node",
    "output": "k3s kubectl drain my-node --ignore-daemonsets --delete-emptydir-data"
  },
  {
    "instruction": "Join agent with node label",
    "output": "k3s agent --server https://server:6443 --token abc123 --node-label role=worker"
  },
  {
    "instruction": "K3s get services",
    "output": "k3s kubectl get svc --all-namespaces"
  }
]