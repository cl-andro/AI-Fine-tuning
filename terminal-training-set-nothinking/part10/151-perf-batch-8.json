[
  {"instruction": "Convert perf data to CTF format", "output": "perf data convert --to-ctf perf.data"},
  {"instruction": "Convert perf data to JSON", "output": "perf script -i perf.data -F ip,sym --json > perf.json"},
  {"instruction": "Post-process perf data with python", "output": "perf script -i perf.data -s /usr/lib/python3/dist-packages/perf/scripting/sched-cpu-usage.py"},
  {"instruction": "Top sort by comm and dso", "output": "perf top -s comm,dso -e cycles"},
  {"instruction": "Top with hierarchical display", "output": "perf top --hierarchy -e cycles"},
  {"instruction": "Top with specific time unit", "output": "perf top -e cycles --delay 1000"},
  {"instruction": "Top only kernel functions", "output": "perf top -k 1 -e cycles"},
  {"instruction": "Top only userspace functions", "output": "perf top -u -e cycles"},
  {"instruction": "Top with frame pointer walk", "output": "perf top -g fp -e cycles"},
  {"instruction": "Top with DWARF unwind", "output": "perf top -g dwarf -e cycles"},
  {"instruction": "Top with LBR call chains", "output": "perf top -g lbr -e cycles"},
  {"instruction": "Top with symbol filtering", "output": "perf top -e cycles --sym-filter 'my*'"},
  {"instruction": "Top showing only PID", "output": "perf top -e cycles --pid 1234"},
  {"instruction": "Top showing only TID", "output": "perf top -e cycles --tid 1234"},
  {"instruction": "Top with event grouping", "output": "perf top -e '{cycles,instructions}'"},
  {"instruction": "Top in VT100 mode", "output": "perf top -E VT100 -e cycles"},
  {"instruction": "Top with sort order", "output": "perf top -e cycles --sort comm"},
  {"instruction": "Top with overhead calculation", "output": "perf top -e cycles --overhead"},
  {"instruction": "Top with zero sampling", "output": "perf top -z 0 -e cycles"},
  {"instruction": "Compare two perf.data files", "output": "perf diff perf.data.old perf.data"},
  {"instruction": "Show diff with percentage", "output": "perf diff -p perf.data.old perf.data"},
  {"instruction": "Change diff compute method", "output": "perf diff -c delta-abs perf.data.old perf.data"}
]