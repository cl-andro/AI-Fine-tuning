[
  {
    "instruction": "Create Lambda function",
    "output": "aws lambda create-function --function-name my-func --runtime python3.9 --role arn:aws:iam::123456789012:role/lambda-role --handler index.handler --zip-file fileb://func.zip"
  },
  {
    "instruction": "Describe VPCs",
    "output": "aws ec2 describe-vpcs --query 'Vpcs[*].[VpcId,IsDefault]' --output table"
  },
  {
    "instruction": "Describe saved CloudFormation stack",
    "output": "aws cloudformation describe-stacks --stack-name my-stack --query 'Stacks[*].Outputs' --output table"
  },
  {
    "instruction": "List Lambda functions",
    "output": "aws lambda list-functions --query 'Functions[*].[FunctionName,Runtime]' --output table"
  },
  {
    "instruction": "List objects in a bucket with details",
    "output": "aws s3 ls s3://my-bucket/ --human-readable --summarize"
  },
  {
    "instruction": "List load balancers",
    "output": "aws elbv2 describe-load-balancers --query 'LoadBalancers[*].[LoadBalancerName,DNSName]' --output table"
  },
  {
    "instruction": "Describe EC2 instance types",
    "output": "aws ec2 describe-instance-types --filters Name=instance-type,Values=t3.* --query 'InstanceTypes[*].[InstanceType,VCpuInfo.DefaultVCpus]' --output table"
  },
  {
    "instruction": "Stop an EC2 instance",
    "output": "aws ec2 stop-instances --instance-ids i-1234567890abcdef0"
  },
  {
    "instruction": "Create S3 bucket",
    "output": "aws s3 mb s3://my-new-bucket"
  },
  {
    "instruction": "Get CloudFormation stack events",
    "output": "aws cloudformation describe-stack-events --stack-name my-stack"
  },
  {
    "instruction": "Start EC2 instance",
    "output": "aws ec2 start-instances --instance-ids i-1234567890abcdef0"
  },
  {
    "instruction": "List CloudFormation stacks",
    "output": "aws cloudformation list-stacks --stack-status-filter CREATE_COMPLETE --query 'StackSummaries[*].[StackName,CreationTime]' --output table"
  },
  {
    "instruction": "List instances with pagination",
    "output": "aws ec2 describe-instances --max-items 50 --query 'Reservations[*].Instances[*].[InstanceId]' --output table"
  },
  {
    "instruction": "Get current AWS identity",
    "output": "aws sts get-caller-identity"
  },
  {
    "instruction": "Sync an S3 bucket to local directory",
    "output": "aws s3 sync s3://my-bucket/ ./local-folder/"
  },
  {
    "instruction": "List Lambda event source mappings",
    "output": "aws lambda list-event-source-mappings --function-name my-function"
  },
  {
    "instruction": "List SNS topics",
    "output": "aws sns list-topics --query 'Topics[*].TopicArn' --output table"
  },
  {
    "instruction": "Register targets with target group",
    "output": "aws elbv2 register-targets --target-group-arn arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/my-targets/1234567890123456 --targets Id=i-1234567890abcdef0"
  },
  {
    "instruction": "Subscribe to SNS topic",
    "output": "aws sns subscribe --topic-arn arn:aws:sns:us-east-1:123456789012:my-topic --protocol email --notification-endpoint user@example.com"
  },
  {
    "instruction": "List all S3 buckets",
    "output": "aws s3 ls"
  },
  {
    "instruction": "Create CloudWatch alarm",
    "output": "aws cloudwatch put-metric-alarm --alarm-name HighCPU --metric-name CPUUtilization --namespace AWS/EC2 --statistic Average --period 300 --threshold 80 --comparison-operator GreaterThanThreshold"
  },
  {
    "instruction": "List available AMIs",
    "output": "aws ec2 describe-images --owners self --query 'Images[*].[ImageId,Name]' --output table"
  },
  {
    "instruction": "Associate Elastic IP",
    "output": "aws ec2 associate-address --instance-id i-1234567890abcdef0 --allocation-id eipalloc-12345678"
  },
  {
    "instruction": "Put metric data",
    "output": "aws cloudwatch put-metric-data --namespace MyApp --metric-name Requests --value 1 --unit Count"
  },
  {
    "instruction": "Describe EC2 subnets",
    "output": "aws ec2 describe-subnets --filters Name=vpc-id,Values=vpc-12345678 --query 'Subnets[*].[SubnetId,CidrBlock,AvailabilityZone]' --output table"
  },
  {
    "instruction": "Send a message to an SQS queue",
    "output": "aws sqs send-message --queue-url https://sqs.us-east-1.amazonaws.com/123456789012/my-queue --message-body 'Hello World'"
  }
]