[
  {
    "instruction": "View timer target wants symlink",
    "output": "ls -l /etc/systemd/system/timers.target.wants/backup.timer"
  },
  {
    "instruction": "Show OnCalendar property of a timer",
    "output": "systemctl show -p OnCalendar backup.timer"
  },
  {
    "instruction": "List timer unit files by type",
    "output": "systemctl list-unit-files --type=timer"
  },
  {
    "instruction": "List waiting timers",
    "output": "systemctl list-timers --state=waiting"
  },
  {
    "instruction": "Show all timer properties",
    "output": "systemctl show backup.timer"
  },
  {
    "instruction": "List reverse dependencies of a timer",
    "output": "systemctl list-dependencies --reverse backup.timer"
  },
  {
    "instruction": "View timer unit file content",
    "output": "systemctl cat backup.timer"
  },
  {
    "instruction": "Create timer that fires every 15 minutes",
    "output": "systemd-run --on-active=15m --unit=quarterly /usr/bin/quarterly-check.sh"
  },
  {
    "instruction": "View journal entries for timer unit",
    "output": "journalctl -u backup.timer"
  },
  {
    "instruction": "List timers in JSON format",
    "output": "systemctl list-timers --json=pretty"
  },
  {
    "instruction": "Edit timer unit with drop-in",
    "output": "systemctl edit backup.timer"
  },
  {
    "instruction": "List elapsed timers",
    "output": "systemctl list-timers --state=elapsed"
  },
  {
    "instruction": "Unmask a timer",
    "output": "systemctl unmask backup.timer"
  },
  {
    "instruction": "View journal for timer-triggered service",
    "output": "journalctl -u backup.service"
  },
  {
    "instruction": "Analyze daily calendar expression",
    "output": "systemd-analyze calendar 'daily'"
  },
  {
    "instruction": "Show last trigger time of timer",
    "output": "systemctl show -p LastTriggerUSec backup.timer"
  },
  {
    "instruction": "Create a daily persistent timer unit",
    "output": "cat > /etc/systemd/system/backup.timer << 'EOF'\n[Unit]\nDescription=Daily backup\n[Timer]\nOnCalendar=daily\nPersistent=true\n[Install]\nWantedBy=timers.target\nEOF"
  },
  {
    "instruction": "Read static timer unit file",
    "output": "cat /etc/systemd/system/backup.timer"
  },
  {
    "instruction": "List system timer unit files",
    "output": "ls /etc/systemd/system/*.timer"
  },
  {
    "instruction": "Clean timer runtime state",
    "output": "systemctl clean backup.timer"
  },
  {
    "instruction": "List disabled timer unit files",
    "output": "systemctl list-unit-files --type=timer --state=disabled"
  }
]