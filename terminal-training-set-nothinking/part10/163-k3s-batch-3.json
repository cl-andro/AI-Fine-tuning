  },
  {
    "instruction": "Run k3s kubectl apply",
    "output": "k3s kubectl apply -f deployment.yaml"
  },
  {
    "instruction": "Install K3s with cluster-init",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init"
  },
  {
    "instruction": "K3s get all resources in namespace",
    "output": "k3s kubectl get all -n default"
  },
  {
    "instruction": "Save an etcd snapshot",
    "output": "k3s etcd-snapshot save --snapshot-dir=/var/lib/rancher/k3s/server/db/snapshots"
  },
  {
    "instruction": "Run K3s agent with custom server",
    "output": "k3s agent --server https://server:6443 --token abc123"
  },
  {
    "instruction": "K3s kubectl delete pod",
    "output": "k3s kubectl delete pod my-pod --grace-period=0 --force"
  },
  {
    "instruction": "K3s get events",
    "output": "k3s kubectl get events --all-namespaces"
  },
  {
    "instruction": "Install K3s with local storage",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--disable=local-storage' sh -"
  },
  {
    "instruction": "Restore etcd snapshot",
    "output": "k3s server --cluster-reset --cluster-reset-restore-snapshot=/var/lib/rancher/k3s/server/db/snapshots/on-demand-myserver-1680000000"
  },
  {
    "instruction": "K3s kubectl taint node",
    "output": "k3s kubectl taint nodes my-node dedicated=special:NoSchedule"
  },
  {
    "instruction": "K3s ctr containers list",
    "output": "k3s ctr containers list"
  },
  {
    "instruction": "List all pods in all namespaces",
    "output": "k3s kubectl get pods --all-namespaces"
  },
  {
    "instruction": "Join agent with node label",
    "output": "k3s agent --server https://server:6443 --token abc123 --node-label role=worker"
  },
  {
    "instruction": "Get K3s token for agents",
    "output": "sudo cat /var/lib/rancher/k3s/server/token"
  },
  {
    "instruction": "Install K3s without traefik",
