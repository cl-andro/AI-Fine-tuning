[
  {"instruction": "Docker run with no network namespace", "output": "docker run --net=host --rm alpine ip addr"},
  {"instruction": "Docker run with new PID namespace", "output": "docker run --pid=host --rm alpine ps aux"},
  {"instruction": "Docker share IPC namespace with host", "output": "docker run --ipc=host --rm alpine ipcs"},
  {"instruction": "Docker mount namespace propagation", "output": "docker run --mount type=bind,source=/mnt,target=/mnt,bind-propagation=slave --rm alpine ls /mnt"},
  {"instruction": "Docker run with user namespace", "output": "docker run --userns=host --rm alpine whoami"},
  {"instruction": "Docker run with cgroup namespace", "output": "docker run --cgroupns=host --rm alpine cat /proc/self/cgroup"},
  {"instruction": "Docker with UTS namespace sharing", "output": "docker run --uts=host --rm alpine hostname"},
  {"instruction": "Run docker in separate network namespace", "output": "docker run --net=isolated_ns --rm alpine ip addr"},
  {"instruction": "Create Docker container with all namespaces", "output": "docker run --rm alpine sh -c 'for ns in /proc/self/ns/*; do echo \"$(basename $ns): $(readlink $ns)\"; done'"},
  {"instruction": "Check namespaces of running container", "output": "docker inspect --format '{{.State.Pid}}' container_name | xargs -I{} ls -la /proc/{}/ns/"},
  {"instruction": "Enter container namespace from host", "output": "nsenter -t $(docker inspect --format '{{.State.Pid}}' container_name) -a /bin/bash"},
  {"instruction": "Enter container net namespace only", "output": "nsenter -t $(docker inspect --format '{{.State.Pid}}' container_name) -n -- /bin/bash"},
  {"instruction": "Check all namespaces of container", "output": "PID=$(docker inspect --format '{{.State.Pid}}' container_name); for ns in /proc/$PID/ns/*; do echo \"$(basename $ns): $(readlink $ns)\"; done"},
  {"instruction": "Find which containers share a namespace", "output": "for c in $(docker ps -q); do echo \"$c: $(docker inspect --format '{{.State.Pid}}' $c)\"; done | awk '{print $2}' | xargs -I{} readlink /proc/{}/ns/net"},
  {"instruction": "LXC container namespace debugging", "output": "lxc-info -n container_name; lsns -p $(lxc-info -n container_name -p 2>/dev/null)"},
  {"instruction": "Check namespaces for podman container", "output": "podman inspect --format '{{.State.Pid}}' container_name | xargs -I{} ls -la /proc/{}/ns/"},
  {"instruction": "Enter podman container namespace", "output": "nsenter -t $(podman inspect --format '{{.State.Pid}}' container_name) -a /bin/bash"},
  {"instruction": "Run docker with specific capabilities", "output": "docker run --cap-add=NET_ADMIN --rm alpine ip link"},
  {"instruction": "Docker container without network except loopback", "output": "docker run --net=none --rm alpine ip addr"},
  {"instruction": "Use slirp4netns for rootless networking", "output": "slirp4netns --configure /proc/$$/ns/net tap0"},
  {"instruction": "Use pasta for net namespace", "output": "pasta --config-net -t 8080 -u 5353"},
  {"instruction": "Check if runc uses namespaces", "output": "cat /proc/$(pgrep -x runc 2>/dev/null)/status 2>/dev/null | grep CapEff || echo 'runc not running'"}
]