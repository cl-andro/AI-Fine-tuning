[
  {
    "instruction": "Create helm-based operator",
    "output": "operator-sdk init --plugins helm.sdk.operatorframework.io/v1 --domain example.com"
  },
  {
    "instruction": "Push bundle image",
    "output": "make docker-push IMG=my-registry/my-operator-bundle:v0.0.1"
  },
  {
    "instruction": "Initialize an operator with operator-sdk",
    "output": "operator-sdk init --domain example.com --repo github.com/example/my-operator"
  },
  {
    "instruction": "Build bundle image",
    "output": "make bundle-build BUNDLE_IMG=my-registry/my-operator-bundle:v0.0.1"
  },
  {
    "instruction": "Run controller locally",
    "output": "make run"
  },
  {
    "instruction": "Generate bundle metadata",
    "output": "operator-sdk generate kustomize manifests --interactive=false"
  },
  {
    "instruction": "Create a new API/CRD",
    "output": "operator-sdk create api --group apps --version v1 --kind MyApp --resource --controller"
  },
  {
    "instruction": "Build operator and push",
    "output": "make docker-build docker-push IMG=my-registry/my-operator:latest"
  },
  {
    "instruction": "Create config samples",
    "output": "make generate"
  },
  {
    "instruction": "Create CRD example",
    "output": "kubebuilder create example --group apps --version v1 --kind MyApp --output-file config/samples/apps_v1_myapp.yaml"
  },
  {
    "instruction": "Install CRDs",
    "output": "make install"
  },
  {
    "instruction": "Initialize with ready-to-run",
    "output": "operator-sdk init --domain example.com --repo github.com/example/my-operator --skip-go-version-check"
  },
  {
    "instruction": "Create OLM catalog source",
    "output": "operator-sdk run bundle my-registry/my-operator-bundle:v0.0.1 --namespace operators --install-mode AllNamespaces"
  },
  {
    "instruction": "Package operator for OLM",
    "output": "operator-sdk run bundle docker.io/my-registry/my-operator-bundle:v0.0.1"
  },
  {
    "instruction": "Configure webhook with cert-manager",
    "output": "kubebuilder create webhook --group apps --version v1 --kind MyApp --defaulting --cert-dir=/tmp/k8s-webhook-server/serving-certs"
  },
  {
    "instruction": "Generate CRD YAML",
    "output": "make generate && make manifests"
  },
  {
    "instruction": "Create a webhook",
    "output": "kubebuilder create webhook --group apps --version v1 --kind MyApp --programmatic-validation"
  },
  {
    "instruction": "Create API with short names",
    "output": "operator-sdk create api --group apps --version v1 --kind MyApp --resource --controller --namespaced --plural myapps"
  },
  {
    "instruction": "List operator SDK versions",
    "output": "operator-sdk version"
  },
  {
    "instruction": "Deploy with custom namespace",
    "output": "make deploy IMG=my-registry/my-operator:v1 NAMESPACE=my-namespace"
  }
]