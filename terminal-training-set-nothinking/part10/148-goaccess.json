[
  {"instruction": "Generate HTML report from access log", "output": "goaccess access.log -a -o report.html"},
  {"instruction": "Parse access log with COMBINED format", "output": "goaccess --log-format=COMBINED access.log"},
  {"instruction": "Launch real-time HTML dashboard", "output": "goaccess access.log --real-time-html -o report.html"},
  {"instruction": "Use GeoIP database for location data", "output": "goaccess access.log --geoip-database=/usr/share/GeoIP/GeoLite2-City.mmdb"},
  {"instruction": "Ignore search engine crawlers", "output": "goaccess access.log --ignore-crawlers"},
  {"instruction": "Open GoAccess interactive dashboard", "output": "goaccess access.log -a"},
  {"instruction": "Parse Apache combined log format", "output": "goaccess access.log --log-format='%h %^[%d:%t %^] \"%r\" %s %b \"%R\" \"%u\"'"},
  {"instruction": "Parse Nginx combined log format", "output": "goaccess /var/log/nginx/access.log --log-format=COMBINED"},
  {"instruction": "Output report as JSON", "output": "goaccess access.log -a -o report.json"},
  {"instruction": "Output report as CSV", "output": "goaccess access.log -a -o report.csv"},
  {"instruction": "Filter by date range", "output": "goaccess access.log --date-spec=2025-01-01+2025-01-31"},
  {"instruction": "Filter by specific hour", "output": "goaccess access.log --hour-spec=9..17"},
  {"instruction": "Exclude specific IP addresses", "output": "goaccess access.log --exclude-ip=192.168.1.1"},
  {"instruction": "Include only specific status codes", "output": "goaccess access.log --status-code=200,301,404"},
  {"instruction": "Exclude specific status codes", "output": "goaccess access.log --status-code=!500,502"},
  {"instruction": "Use custom date format", "output": "goaccess access.log --date-format='%d/%b/%Y'"},
  {"instruction": "Use custom time format", "output": "goaccess access.log --time-format='%H:%M:%S'"},
  {"instruction": "Disable IP geo-location", "output": "goaccess access.log --no-geoip"},
  {"instruction": "Disable SSL/TLS analysis", "output": "goaccess access.log --no-tls"},
  {"instruction": "Disable query string in stats", "output": "goaccess access.log --no-query-string"},
  {"instruction": "Set number of items per panel", "output": "goaccess access.log --items-per-panel=15"}
]