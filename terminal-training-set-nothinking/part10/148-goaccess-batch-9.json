[
  {"instruction": "Check GoAccess default config file location", "output": "goaccess --dcf"},
  {"instruction": "Create GoAccess config from defaults", "output": "goaccess --dcf > /etc/goaccess/goaccess.conf"},
  {"instruction": "Load GoAccess config file", "output": "goaccess access.log --config-file=/etc/goaccess/goaccess.conf -a -o report.html"},
  {"instruction": "Set default log format in config", "output": "echo 'log-format COMBINED' > /etc/goaccess/goaccess.conf"},
  {"instruction": "Set default date format in config", "output": "echo 'date-format %d/%b/%Y' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set default time format in config", "output": "echo 'time-format %T' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Enable real-time HTML in config", "output": "echo -e 'real-time-html true\\noutput /var/www/html/report.html' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set GeoIP database path in config", "output": "echo 'geoip-database /usr/share/GeoIP/GeoLite2-City.mmdb' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set color scheme in config file", "output": "echo 'color-scheme 1' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Enable panel persistence in config", "output": "echo 'keep-db true' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set excluded IPs in config", "output": "echo 'exclude-ip 127.0.0.1' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set ignored crawlers in config", "output": "echo 'ignore-crawlers true' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set items per panel in config", "output": "echo 'items-per-panel 10' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set sort panel in config", "output": "echo 'sort-panel VISITORS,BY_HITS' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Enable bandwidth reporting in config", "output": "echo 'bandwidth MB' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set HTML report preferences in config", "output": "echo 'html-prefs {\"theme\":\"dark\",\"show-charts\":true}' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set date specification in config", "output": "echo 'date-spec 2025-01-01+2025-01-31' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set hour specification in config", "output": "echo 'hour-spec 9..17' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Enable debug mode in config", "output": "echo 'debug true' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Disable TLS in config", "output": "echo 'no-tls true' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Set active panel in config", "output": "echo 'active-panel VISITORS' >> /etc/goaccess/goaccess.conf"},
  {"instruction": "Validate GoAccess config file", "output": "goaccess --config-file=/etc/goaccess/goaccess.conf --config-test"}
]