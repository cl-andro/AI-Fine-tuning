[
  {
    "instruction": "Check bootctl installation path",
    "output": "bootctl --print-esp-path"
  },
  {
    "instruction": "Add a kernel via kernel-install",
    "output": "kernel-install add 6.1.0-13-amd64 /boot/vmlinuz-6.1.0-13-amd64"
  },
  {
    "instruction": "Check EFI variables",
    "output": "efibootmgr"
  },
  {
    "instruction": "Add kernel with kernel-install and all plugins",
    "output": "kernel-install add 6.1.0-14-amd64 /boot/vmlinuz-6.1.0-14-amd64"
  },
  {
    "instruction": "Install systemd-boot to ESP",
    "output": "bootctl install"
  },
  {
    "instruction": "Disable boot entry editor for security",
    "output": "printf 'editor 0\\n' >> /boot/loader/loader.conf"
  },
  {
    "instruction": "View boot entries with full details",
    "output": "bootctl list --all"
  },
  {
    "instruction": "List boot entries with JSON output",
    "output": "bootctl list --json=pretty"
  },
  {
    "instruction": "Check boot entries for UKI support",
    "output": "grep -l 'uki' /boot/loader/entries/*.conf 2>/dev/null"
  },
  {
    "instruction": "Check kernel-install configuration",
    "output": "cat /etc/kernel/install.conf 2>/dev/null || echo 'using defaults'"
  },
  {
    "instruction": "View a boot loader entry file",
    "output": "cat /boot/loader/entries/6.1.0-13-amd64.conf"
  },
  {
    "instruction": "Set current kernel as default",
    "output": "bootctl set @current"
  },
  {
    "instruction": "List all files in ESP partition",
    "output": "find /boot/efi -type f 2>/dev/null | head -30"
  },
  {
    "instruction": "Set boot timeout to 10 seconds",
    "output": "bootctl set-timeout 10"
  },
  {
    "instruction": "Delete EFI boot entry 0003",
    "output": "efibootmgr -b 0003 -B"
  },
  {
    "instruction": "Show systemd-boot random seed status",
    "output": "bootctl random-seed"
  },
  {
    "instruction": "Check bootctl version",
    "output": "bootctl --version"
  },
  {
    "instruction": "Create a boot entry for custom kernel",
    "output": "printf 'title Custom Kernel\\nlinux /vmlinuz-custom\\ninitrd /initrd-custom\\noptions root=UUID=abc123 ro quiet\\n' > /boot/loader/entries/custom.conf"
  },
  {
    "instruction": "Update bootloader files only",
    "output": "bootctl update --graceful"
  },
  {
    "instruction": "List boot loader entries",
    "output": "bootctl list"
  },
  {
    "instruction": "Set default timeout in loader.conf",
    "output": "printf 'timeout 5\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "Check sd-boot current config",
    "output": "cat /boot/loader/entries.srel 2>/dev/null; echo '(type file)'"
  },
  {
    "instruction": "Check if systemd-stub is in use",
    "output": "bootctl status | grep -i stub"
  }
]