[
  {"instruction": "Set hostname in new UTS namespace", "output": "unshare --uts bash -c 'hostname mycontainer && hostname'"},
  {"instruction": "Change hostname without affecting host", "output": "unshare --uts hostname isolated-host && hostname"},
  {"instruction": "Check domainname in UTS namespace", "output": "unshare --uts bash -c 'domainname mydomain && domainname'"},
  {"instruction": "Set NIS domainname in new ns", "output": "unshare --uts bash -c 'domainname test-nis && domainname'"},
  {"instruction": "Verify hostname is isolated", "output": "unshare --uts bash -c 'hostname container && hostname && readlink /proc/self/ns/uts'"},
  {"instruction": "Check IPC namespace isolation", "output": "unshare --ipc bash -c 'ipcs -q; ipcs -s; ipcs -m'"},
  {"instruction": "Create shared memory in IPC namespace", "output": "unshare --ipc bash -c 'ipcmk -M 1024 && ipcs -m'"},
  {"instruction": "Check IPC semaphore in namespace", "output": "unshare --ipc bash -c 'ipcmk -S 1 && ipcs -s'"},
  {"instruction": "Check message queue in namespace", "output": "unshare --ipc bash -c 'ipcmk -Q && ipcs -q'"},
  {"instruction": "Remove System V IPC in namespace", "output": "unshare --ipc bash -c 'ipcrm -M shmid'"},
  {"instruction": "Create cgroup namespace and see own cgroup", "output": "unshare --cgroup bash -c 'cat /proc/self/cgroup'"},
  {"instruction": "Check cgroup controllers in namespace", "output": "unshare --cgroup bash -c 'cat /sys/fs/cgroup/cgroup.controllers 2>/dev/null || echo no cgroup'"},
  {"instruction": "Run with cgroup namespace only", "output": "unshare --cgroup /bin/bash -c 'echo cgroup ns created'"},
  {"instruction": "Create time namespace with offset", "output": "unshare --time bash -c 'echo time ns created'"},
  {"instruction": "Set boot time offset in time namespace", "output": "echo 'boottime 0 3600' > /proc/self/ns/timens_offset 2>/dev/null || echo 'Requires kernel support'"},
  {"instruction": "Check monotonic clock in time ns", "output": "unshare --time bash -c 'cat /proc/self/ns/time_for_children'"},
  {"instruction": "Run with all namespace isolation", "output": "unshare --mount --uts --ipc --net --pid --fork --mount-proc /bin/bash"},
  {"instruction": "Check current user namespace mapping", "output": "cat /proc/self/uid_map"},
  {"instruction": "Check current group namespace mapping", "output": "cat /proc/self/gid_map"},
  {"instruction": "Map user inside user namespace", "output": "unshare -U bash -c 'echo \"0 1000 1\" > /proc/self/uid_map' 2>/dev/null || echo 'Cannot map'"},
  {"instruction": "Check capabilities inside user namespace", "output": "unshare -r capsh --print"},
  {"instruction": "Create user namespace and map users", "output": "unshare -U bash -c 'echo deny > /proc/self/setgroups 2>/dev/null; echo \"0 1000 1\" > /proc/self/uid_map 2>/dev/null; id'"}
]