[
  {
    "instruction": "Run command on dedicated CPUs",
    "output": "taskset -c 0-3 myapp"
  },
  {
    "instruction": "Show CPU present set",
    "output": "cat /sys/devices/system/cpu/present"
  },
  {
    "instruction": "Show CPU governor settings",
    "output": "cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show interactive topology",
    "output": "lstopo"
  },
  {
    "instruction": "Show microarchitecture details",
    "output": "cpuid -1 | grep 'uarch'"
  },
  {
    "instruction": "Show NUMA node memory info",
    "output": "numactl --hardware | grep 'node.*size'"
  },
  {
    "instruction": "Show CPU topology graphically",
    "output": "lstopo-no-graphics"
  },
  {
    "instruction": "Show memory used per NUMA node",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show CPU parsing JSON",
    "output": "lscpu --all --json"
  },
  {
    "instruction": "Show all cache sizes",
    "output": "lscpu --caches --parse"
  },
  {
    "instruction": "Show die IDs",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/die_id | sort -u"
  },
  {
    "instruction": "Show NUMA node distances",
    "output": "numactl --hardware | grep distance"
  },
  {
    "instruction": "Show physical package IDs",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/physical_package_id | sort -u"
  },
  {
    "instruction": "Show process CPU affinity",
    "output": "taskset -p $$"
  },
  {
    "instruction": "Show process NUMA policy",
    "output": "numactl --show"
  },
  {
    "instruction": "Show hypervisor info",
    "output": "lscpu --all --hypervisor"
  },
  {
    "instruction": "Show CPU cache info",
    "output": "lscpu --all --caches"
  },
  {
    "instruction": "Show topology in machine readable form",
    "output": "lscpu --all --parse=Node,CPU,Core,Socket,Cache,Online --output-all"
  },
  {
    "instruction": "Show CPU topology as PNG",
    "output": "lstopo --output-format png topo.png"
  },
  {
    "instruction": "Show all topology info per core",
    "output": "for i in /sys/devices/system/cpu/cpu*/topology/; do echo \"=== $i ===\"; cat \"$i/core_cpus_list\" 2>/dev/null; done"
  },
  {
    "instruction": "Show frequency of all cores",
    "output": "lscpu --all --frequency --output-all"
  },
  {
    "instruction": "Show CPU online/offline",
    "output": "cat /sys/devices/system/cpu/online"
  },
  {
    "instruction": "Show CPU isolation info",
    "output": "cat /sys/devices/system/cpu/isolated"
  },
  {
    "instruction": "Show CPU frequency info",
    "output": "lscpu --all --frequency"
  }
]