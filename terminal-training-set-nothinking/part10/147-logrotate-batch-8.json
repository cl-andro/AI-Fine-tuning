[
  {"instruction": "Rotate logs with hourly frequency using cron", "output": "echo '0 * * * * root /usr/sbin/logrotate -f /etc/logrotate.d/hourly' > /etc/cron.d/logrotate-hourly"},
  {"instruction": "Schedule logrotate every 6 hours", "output": "echo '0 */6 * * * root /usr/sbin/logrotate -f /etc/logrotate.conf' > /etc/cron.d/logrotate-6h"},
  {"instruction": "Schedule logrotate at midnight", "output": "echo '0 0 * * * root /usr/sbin/logrotate -f /etc/logrotate.conf' > /etc/cron.d/logrotate-midnight"},
  {"instruction": "Schedule logrotate every Sunday", "output": "echo '0 2 * * 0 root /usr/sbin/logrotate -f /etc/logrotate.conf' > /etc/cron.d/logrotate-sunday"},
  {"instruction": "Run logrotate on first of month", "output": "echo '0 3 1 * * root /usr/sbin/logrotate -f /etc/logrotate.conf' > /etc/cron.d/logrotate-monthly"},
  {"instruction": "Add logrotate entry to root crontab", "output": "echo '0 4 * * * /usr/sbin/logrotate -f /etc/logrotate.conf' | crontab -"},
  {"instruction": "View current logrotate cron jobs", "output": "ls -la /etc/cron.d/ | grep logrotate"},
  {"instruction": "Check if logrotate is enabled in systemd", "output": "systemctl is-enabled logrotate.timer"},
  {"instruction": "Start logrotate timer", "output": "systemctl start logrotate.timer"},
  {"instruction": "Enable logrotate timer at boot", "output": "systemctl enable logrotate.timer"},
  {"instruction": "Stop logrotate timer temporarily", "output": "systemctl stop logrotate.timer"},
  {"instruction": "Disable logrotate timer", "output": "systemctl disable logrotate.timer"},
  {"instruction": "View logrotate timer status", "output": "systemctl status logrotate.timer"},
  {"instruction": "View logrotate service logs", "output": "journalctl -u logrotate.service"},
  {"instruction": "View last logrotate run output", "output": "journalctl -u logrotate.service --no-pager -n 20"},
  {"instruction": "Follow logrotate service logs", "output": "journalctl -u logrotate.service -f"},
  {"instruction": "Check logrotate last run time", "output": "systemctl show logrotate.timer -p LastTriggerUSec"},
  {"instruction": "View logrotate timer calendar", "output": "systemctl show logrotate.timer -p Calendar"},
  {"instruction": "Debug logrotate timer activation", "output": "systemd-analyze verify /lib/systemd/system/logrotate.timer"},
  {"instruction": "Edit logrotate systemd service", "output": "systemctl edit logrotate.service"},
  {"instruction": "Reload systemd after logrotate changes", "output": "systemctl daemon-reload"}
]