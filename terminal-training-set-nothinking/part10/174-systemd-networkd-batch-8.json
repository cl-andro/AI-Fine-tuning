[
  {
    "instruction": "Configure DHCP use NTP from server",
    "output": "printf '[DHCPv4]\\nUseNTP=true\\n' > /etc/systemd/network/10-dhcp-ntp.network"
  },
  {
    "instruction": "Display link LLDP neighbors",
    "output": "networkctl lldp"
  },
  {
    "instruction": "Create a VLAN netdev",
    "output": "printf '[NetDev]\\nName=vlan10\\nKind=vlan\\n[VLAN]\\nId=10\\n' > /etc/systemd/network/15-vlan10.netdev"
  },
  {
    "instruction": "Stop networkd service",
    "output": "systemctl stop systemd-networkd"
  },
  {
    "instruction": "Enable IPv6 privacy extensions",
    "output": "printf '[Network]\\nIPv6PrivacyExtensions=yes\\n' > /etc/systemd/network/10-ipv6-privacy.network"
  },
  {
    "instruction": "Display link status in JSON format",
    "output": "networkctl --json=pretty status"
  },
  {
    "instruction": "Create a network for VLAN tagged interface",
    "output": "printf '[Match]\\nName=eth0.10\\n[Network]\\nDHCP=ipv4\\n' > /etc/systemd/network/10-vlan-interface.network"
  },
  {
    "instruction": "Reload network configuration",
    "output": "networkctl reload"
  },
  {
    "instruction": "List all network links",
    "output": "networkctl list"
  },
  {
    "instruction": "Check status of a specific link",
    "output": "networkctl status eth0"
  },
  {
    "instruction": "Create network config with DNS server list",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=no\\nDNS=8.8.8.8\\nDNS=1.1.1.1\\nAddress=192.168.1.10/24\\nGateway=192.168.1.1\\n' > /etc/systemd/network/10-static-dns.network"
  },
  {
    "instruction": "Create bond member config for eth1",
    "output": "printf '[Match]\\nName=eth1\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/21-eth1-bond-member.network"
  },
  {
    "instruction": "Check overall network status",
    "output": "networkctl status"
  },
  {
    "instruction": "Create bridge port config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBridge=br0\\n' > /etc/systemd/network/20-eth0-bridge-member.network"
  },
  {
    "instruction": "Configure route table",
    "output": "printf '[Match]\\nName=eth0\\n[Route]\\nDestination=10.0.0.0/8\\nGateway=192.168.1.1\\nTable=100\\n' > /etc/systemd/network/10-route.network"
  },
  {
    "instruction": "Configure DHCP use DNS from DHCP server",
    "output": "printf '[DHCPv4]\\nUseDNS=true\\n' > /etc/systemd/network/10-dhcp-dns.network"
  },
  {
    "instruction": "Configure bonding with LACP rate",
    "output": "printf '[NetDev]\\nName=bond0\\nKind=bond\\n[Bond]\\nMode=802.3ad\\nLACPTransmitRate=fast\\n' > /etc/systemd/network/10-bond-lacp-rate.netdev"
  },
  {
    "instruction": "Reload networkd after config changes",
    "output": "systemctl reload systemd-networkd"
  },
  {
    "instruction": "Enable networkd at boot",
    "output": "systemctl enable systemd-networkd"
  },
  {
    "instruction": "Set DHCP server on network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCPServer=yes\\n' > /etc/systemd/network/10-dhcp-server.network"
  },
  {
    "instruction": "Create bond member config for eth0",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/20-eth0-bond-member.network"
  },
  {
    "instruction": "Create a dummy interface",
    "output": "printf '[NetDev]\\nName=dummy0\\nKind=dummy\\n' > /etc/systemd/network/10-dummy.netdev"
  },
  {
    "instruction": "Disable IPv6 on an interface",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nLinkLocalAddressing=no\\nIPv6AcceptRA=no\\n' > /etc/systemd/network/10-no-ipv6.network"
  }
]