[
  {"instruction": "Filter strace with multiple syscall classes", "output": "strace -e trace=%file,%process ls"},
  {"instruction": "Trace all syscalls except file operations", "output": "strace -e trace='!file' ls"},
  {"instruction": "Trace file and network syscalls only", "output": "strace -e trace=file,network curl http://example.com"},
  {"instruction": "Use strace with seccomp filter", "output": "strace --seccomp-bpf ls"},
  {"instruction": "Combine file and desc classes", "output": "strace -e trace=%file,%desc ls"},
  {"instruction": "Trace memory and IPC syscalls", "output": "strace -e trace=memory,ipc ls"},
  {"instruction": "Show all syscalls starting with 'f'", "output": "strace -e trace=fsync,fchmod,fchown,fstat ls"},
  {"instruction": "Trace kernel function entry/exit style", "output": "strace -e trace=%process -e inject=clone:delay_us=10000 ls"},
  {"instruction": "Show decode of socket structures", "output": "strace -v -e trace=socket,connect ls"},
  {"instruction": "Display thread id in each line", "output": "strace -f -T ls 2>&1 | head -20"},
  {"instruction": "Monitor with parseable output", "output": "strace -ff -o log -tt ls"},
  {"instruction": "Collect timestamped strace for profiling", "output": "strace -ttt -T -o /tmp/profiling.log myapp"},
  {"instruction": "Write per-pid trace files", "output": "strace -ff -i -o /tmp/trace myapp"},
  {"instruction": "Log with both relative and absolute time", "output": "strace -r -tt -o /tmp/timing.log ls"},
  {"instruction": "Disable personality change detection", "output": "strace -E LD_LIBRARY_PATH=/custom/lib ls"},
  {"instruction": "Pass environment variable through strace", "output": "strace -E MYVAR=hello env | grep MYVAR"},
  {"instruction": "Set STRAFTER env for strace filter and action", "output": "STRAFTER_ACTIONS=count strace -c ls"},
  {"instruction": "Count filtered syscalls for a script", "output": "strace -c -e trace=openat,read,write python3 -c 'print(open(\"/etc/hostname\").read())'"},
  {"instruction": "Log syscalls with fd numbers decoded", "output": "strace --decode-fds=path -e trace=openat,read ls /tmp"},
  {"instruction": "Monitor splice/tee system calls", "output": "strace -e trace=splice,tee,vmplice ls"},
  {"instruction": "Watch copy_file_range operations", "output": "strace -e trace=copy_file_range cp /tmp/largefile /tmp/copy"},
  {"instruction": "Process audit-like logging with strace", "output": "strace -f -o /var/log/strace-audit.log -p 1 -e trace=execve,clone,openat,unlink,connect,bind"}
]