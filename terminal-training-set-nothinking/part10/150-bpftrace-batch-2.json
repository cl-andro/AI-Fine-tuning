[
  {"instruction": "Trace new process creation", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_execve { printf(\"exec: %s\\n\", str(args->filename)); }'"},
  {"instruction": "Trace OOM killer events", "output": "bpftrace -e 'tracepoint:oom:mark_victim { printf(\"OOM killed %s\\n\", comm); }'"},
  {"instruction": "Trace signals sent to processes", "output": "bpftrace -e 'tracepoint:signal:signal_generate { printf(\"signal %d sent to %d\\n\", args->sig, args->pid); }'"},
  {"instruction": "Monitor CPU scheduler latency", "output": "bpftrace -e 'tracepoint:sched:sched_wakeup { @[comm] = hist(args->prio); }'"},
  {"instruction": "Trace block device requests", "output": "bpftrace -e 'kprobe:blk_start_request { printf(\"block request %s\\n\", args->req->rq_disk->disk_name); }'"},
  {"instruction": "Count file descriptors opened per process", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat { @[comm] = count(); }'"},
  {"instruction": "Trace network packet drops", "output": "bpftrace -e 'kprobe:kfree_skb { printf(\"packet dropped: %s\\n\", str(args->skb->dev->name)); }'"},
  {"instruction": "Track container create events (cgroup)", "output": "bpftrace -e 'tracepoint:cgroup:cgroup_mkdir { printf(\"cgroup created: %s\\n\", str(args->path)); }'"},
  {"instruction": "Monitor TCP retransmissions", "output": "bpftrace -e 'kprobe:tcp_retransmit_skb { printf(\"retransmit from %s\\n\", ntop(args->sk->__sk_common.skc_daddr)); }'"},
  {"instruction": "Trace file close operations", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_close { @[comm] = count(); }'"},
  {"instruction": "Monitor write latency distribution", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_write { @start[tid] = nsecs; } tracepoint:syscalls:sys_exit_write { @usecs = hist((nsecs - @start[tid]) / 1000); delete(@start[tid]); }'"},
  {"instruction": "Trace kill signals and targets", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_kill { printf(\"kill by %s to PID %d sig %d\\n\", comm, args->pid, args->sig); }'"},
  {"instruction": "Track disk IOPS per process", "output": "bpftrace -e 'kprobe:blk_account_io_start { @[comm] = count(); }'"},
  {"instruction": "Count socket operations per protocol", "output": "bpftrace -e 'kprobe:sock_sendmsg { @[comm] = count(); }'"},
  {"instruction": "Monitor page cache misses", "output": "bpftrace -e 'kprobe:mark_page_accessed { @[comm] = count(); }'"},
  {"instruction": "Trace slab memory allocations", "output": "bpftrace -e 'kprobe:kmem_cache_alloc { @[str(args->cachep->name)] = count(); }'"},
  {"instruction": "Monitor kernel module loading", "output": "bpftrace -e 'kprobe:load_module { printf(\"module loaded: %s\\n\", str(args->mod->name)); }'"},
  {"instruction": "Track CPU frequency changes", "output": "bpftrace -e 'kprobe:intel_pstate_set_pstate { printf(\"pstate changed to %u\\n\", args->target_pstate); }'"},
  {"instruction": "Monitor filesystem mount operations", "output": "bpftrace -e 'kprobe:do_mount { printf(\"mount %s on %s\\n\", str(args->dev_name), str(args->dir_page)); }'"},
  {"instruction": "Trace interrupt handlers", "output": "bpftrace -e 'kprobe:handle_irq_event { printf(\"IRQ %d handled\\n\", args->action->irq); }'"},
  {"instruction": "Monitor softirq execution times", "output": "bpftrace -e 'tracepoint:irq:softirq_entry { @start[tid] = nsecs; } tracepoint:irq:softirq_exit { @usecs = hist((nsecs - @start[tid]) / 1000); delete(@start[tid]); }'"},
  {"instruction": "Track user login events", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_login { printf(\"login by %s\\n\", comm); }'"}
]