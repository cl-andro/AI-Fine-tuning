[
  {
    "instruction": "Point /etc/resolv.conf to stub resolver",
    "output": "ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"
  },
  {
    "instruction": "Set default DNS server for all interfaces",
    "output": "resolvectl dns 8.8.8.8"
  },
  {
    "instruction": "Set LLMNR mode for interface",
    "output": "resolvectl llmnr eth0 yes"
  },
  {
    "instruction": "Check DNS servers from resolved config",
    "output": "resolvectl status | grep 'DNS Server'"
  },
  {
    "instruction": "Query a specific record type (SRV) for service",
    "output": "resolvectl query --type=SRV _http._tcp.example.com"
  },
  {
    "instruction": "Check DNSSEC setting for an interface",
    "output": "resolvectl dnssec eth0"
  },
  {
    "instruction": "View resolved journal logs",
    "output": "journalctl -u systemd-resolved"
  },
  {
    "instruction": "Set DNS cache max TTL",
    "output": "printf '[Resolve]\\nCacheMaxTTL=3600\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Query DNS over TLS status",
    "output": "resolvectl dnsovertls"
  },
  {
    "instruction": "Point /etc/resolv.conf to actual DNS servers",
    "output": "ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf"
  },
  {
    "instruction": "Set DNS search domain for interface",
    "output": "resolvectl domain eth0 example.com"
  },
  {
    "instruction": "Set DNS over TLS for interface",
    "output": "resolvectl dnsovertls eth0 true"
  },
  {
    "instruction": "Query with cache disabled",
    "output": "resolvectl query --cache=no example.com"
  },
  {
    "instruction": "Query DNS in reverse for IP address",
    "output": "resolvectl query 8.8.8.8"
  },
  {
    "instruction": "Flush all DNS caches",
    "output": "resolvectl flush-caches"
  },
  {
    "instruction": "Set network manager integration",
    "output": "printf '[Resolve]\\nMulticastDNS=yes\\nLLMNR=yes\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Set DNS stub listener to localhost only",
    "output": "printf '[Resolve]\\nDNSStubListener=local\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Check DNSSEC status globally",
    "output": "resolvectl dnssec"
  },
  {
    "instruction": "Set DNS server for an interface",
    "output": "resolvectl dns eth0 1.1.1.1"
  },
  {
    "instruction": "Query with DNSSEC validation",
    "output": "resolvectl query --dnssec example.com"
  },
  {
    "instruction": "Disable DNSSEC validation",
    "output": "resolvectl dnssec eth0 no"
  }
]