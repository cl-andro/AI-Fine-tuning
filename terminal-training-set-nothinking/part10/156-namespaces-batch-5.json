[
  {"instruction": "Create new user namespace with full root", "output": "unshare -r /bin/bash -c 'whoami; id'"},
  {"instruction": "Enter user namespace of process", "output": "nsenter -U -t 1234 /bin/bash"},
  {"instruction": "Mix user and mount namespace", "output": "unshare -U -r -m /bin/bash"},
  {"instruction": "Mix user and pid namespace", "output": "unshare -U -r --pid --fork --mount-proc /bin/bash"},
  {"instruction": "Mix user and net namespace", "output": "unshare -U -r -n /bin/bash"},
  {"instruction": "Create user namespace and run ip link", "output": "unshare -r -n bash -c 'ip link set lo up; ip addr; ping -c1 127.0.0.1'"},
  {"instruction": "All namespaces together as non-root", "output": "unshare -U -r -m -n -p --fork --mount-proc /bin/bash"},
  {"instruction": "Test seccomp in namespaces", "output": "unshare -U -r bash -c 'echo \"seccomp: $(cat /proc/self/status | grep Seccomp)\" '"},
  {"instruction": "Create user namespace with subuid", "output": "unshare -U bash -c 'echo \"0 $(id -u) 1\" > /proc/self/uid_map 2>/dev/null; id'"},
  {"instruction": "Run as unprivileged user in user ns", "output": "unshare -U -r bash -c 'su nobody -c \"id\"'"},
  {"instruction": "Use newuidmap for user mapping", "output": "unshare -U bash -c 'newuidmap $$ 0 100000 65536 && newgidmap $$ 0 100000 65536'"},
  {"instruction": "Check kernel support for user namespaces", "output": "cat /proc/sys/user/max_user_namespaces"},
  {"instruction": "Enable unprivileged user namespaces", "output": "sysctl -w kernel.unprivileged_userns_clone=1 2>/dev/null || echo 'Unavailable'"},
  {"instruction": "User namespace root vs real root", "output": "unshare -r bash -c 'cat /proc/self/status | grep CapEff; id -u'"},
  {"instruction": "Map multiple UIDs in user namespace", "output": "unshare -U bash -c 'echo \"0 1000 10\" > /proc/self/uid_map 2>/dev/null; cat /proc/self/uid_map'"},
  {"instruction": "Access files with user namespace", "output": "unshare -U -r bash -c 'ls -la /root' 2>&1"},
  {"instruction": "Create user namespace and mount", "output": "unshare -U -r -m bash -c 'mount -t tmpfs tmpfs /tmp; df -h /tmp'"},
  {"instruction": "Write to /proc/sys in user namespace", "output": "unshare -U -r bash -c 'echo 1 > /proc/sys/net/ipv4/ip_forward 2>&1 || echo cannot'"},
  {"instruction": "Read sysctl inside user namespace", "output": "unshare -U -r bash -c 'sysctl net.ipv4.ip_forward'"},
  {"instruction": "Create user namespace with setgroups deny", "output": "unshare -U bash -c 'echo deny > /proc/self/setgroups 2>/dev/null; id'"},
  {"instruction": "Check setgroups file in user ns", "output": "unshare -U bash -c 'cat /proc/self/setgroups 2>/dev/null'"},
  {"instruction": "Test user namespace ping as root", "output": "unshare -U -r -n bash -c 'ip link set lo up; ping -c1 127.0.0.1'"}
]