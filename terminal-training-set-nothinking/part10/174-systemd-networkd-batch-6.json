[
  {
    "instruction": "Configure DHCP use NTP from server",
    "output": "printf '[DHCPv4]\\nUseNTP=true\\n' > /etc/systemd/network/10-dhcp-ntp.network"
  },
  {
    "instruction": "Set networkd to ignore carrier loss",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nUnmanaged=yes\\n' > /etc/systemd/network/10-unmanaged.network"
  },
  {
    "instruction": "List all network links",
    "output": "networkctl list"
  },
  {
    "instruction": "Enable networkd at boot",
    "output": "systemctl enable systemd-networkd"
  },
  {
    "instruction": "Create a static IP network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nAddress=192.168.1.100/24\\nGateway=192.168.1.1\\nDNS=8.8.8.8\\n' > /etc/systemd/network/10-eth0-static.network"
  },
  {
    "instruction": "Set MAC address for an interface",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nMACAddress=00:11:22:33:44:55\\n' > /etc/systemd/network/10-mac.network"
  },
  {
    "instruction": "Stop networkd service",
    "output": "systemctl stop systemd-networkd"
  },
  {
    "instruction": "Check networkd service status",
    "output": "systemctl status systemd-networkd"
  },
  {
    "instruction": "Forcibly reconfigure all interfaces",
    "output": "networkctl reconfigure"
  },
  {
    "instruction": "Set DHCP lease timeout",
    "output": "printf '[DHCPv4]\\nMaxAttempts=10\\n' > /etc/systemd/network/10-dhcp-timeout.network"
  },
  {
    "instruction": "Disable IPv6 on an interface",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nLinkLocalAddressing=no\\nIPv6AcceptRA=no\\n' > /etc/systemd/network/10-no-ipv6.network"
  },
  {
    "instruction": "Renew DHCP lease on an interface",
    "output": "networkctl renew eth0"
  },
  {
    "instruction": "Check overall network status",
    "output": "networkctl status"
  },
  {
    "instruction": "Create bond member config for eth1",
    "output": "printf '[Match]\\nName=eth1\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/21-eth1-bond-member.network"
  },
  {
    "instruction": "Reload networkd after config changes",
    "output": "systemctl reload systemd-networkd"
  },
  {
    "instruction": "Create a bridge netdev",
    "output": "printf '[NetDev]\\nName=br0\\nKind=bridge\\n' > /etc/systemd/network/10-bridge.netdev"
  },
  {
    "instruction": "Set bond primary slave",
    "output": "printf '[Bond]\\nPrimarySlave=eth0\\n' > /etc/systemd/network/10-bond-primary.netdev"
  },
  {
    "instruction": "Configure bonding with LACP rate",
    "output": "printf '[NetDev]\\nName=bond0\\nKind=bond\\n[Bond]\\nMode=802.3ad\\nLACPTransmitRate=fast\\n' > /etc/systemd/network/10-bond-lacp-rate.netdev"
  },
  {
    "instruction": "Configure DHCP client identifier type",
    "output": "printf '[DHCPv4]\\nClientIdentifier=mac\\n' > /etc/systemd/network/10-dhcp-client-id.network"
  },
  {
    "instruction": "Create network config with multiple addresses",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nAddress=192.168.1.10/24\\nAddress=10.0.0.10/24\\n' > /etc/systemd/network/10-multi-ip.network"
  },
  {
    "instruction": "Create bridge port config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBridge=br0\\n' > /etc/systemd/network/20-eth0-bridge-member.network"
  },
  {
    "instruction": "Configure interface speed and duplex",
    "output": "printf '[Link]\\nSpeedBytesPerSec=1G\\nDuplex=full\\n' > /etc/systemd/network/10-speed-duplex.link"
  },
  {
    "instruction": "Show link operational state",
    "output": "networkctl status eth0 --no-pager"
  },
  {
    "instruction": "Configure interface MTU",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nMTUBytes=9000\\n' > /etc/systemd/network/10-mtu.network"
  },
  {
    "instruction": "Create a simple DHCP network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=ipv4\\n' > /etc/systemd/network/10-eth0.network"
  }
]