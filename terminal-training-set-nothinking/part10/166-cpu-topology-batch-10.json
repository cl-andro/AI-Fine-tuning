[
  {
    "instruction": "Show CPU topology in YAML",
    "output": "lstopo-no-graphics --output-format yaml"
  },
  {
    "instruction": "Show CPU cache info",
    "output": "lscpu --all --caches"
  },
  {
    "instruction": "Show CPU parsing JSON",
    "output": "lscpu --all --json"
  },
  {
    "instruction": "Show NUMA node free memory",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show NUMA node memory info",
    "output": "numactl --hardware | grep 'node.*size'"
  },
  {
    "instruction": "Show architecture specific info",
    "output": "x86info -a"
  },
  {
    "instruction": "Bind to specific cpus",
    "output": "taskset -c 0,2,4 myapp"
  },
  {
    "instruction": "Show frequency of all cores",
    "output": "lscpu --all --frequency --output-all"
  },
  {
    "instruction": "Get CPU count",
    "output": "nproc --all"
  },
  {
    "instruction": "Set CPU governor to performance",
    "output": "echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show memory used per NUMA node",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show microarchitecture details",
    "output": "cpuid -1 | grep 'uarch'"
  },
  {
    "instruction": "Show cache index0 type",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/type"
  },
  {
    "instruction": "Show die IDs",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/die_id | sort -u"
  },
  {
    "instruction": "Show cache index0 size",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/size"
  },
  {
    "instruction": "Run with memory policy preferred",
    "output": "numactl --preferred=0 myapp"
  },
  {
    "instruction": "Run with policy interleaved",
    "output": "numactl --interleave=all myapp"
  },
  {
    "instruction": "Show AMD specific CPU info",
    "output": "cpuid -1 | grep -i 'L1'"
  },
  {
    "instruction": "Show CPU online/offline",
    "output": "cat /sys/devices/system/cpu/online"
  },
  {
    "instruction": "Show process NUMA policy",
    "output": "numactl --show"
  },
  {
    "instruction": "Show CPU info in extended format",
    "output": "lscpu --all --extended"
  },
  {
    "instruction": "Show CPU governor settings",
    "output": "cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "List cpu sibling maps",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/core_cpus_list"
  },
  {
    "instruction": "Show CPU topology from sysfs",
    "output": "cat /sys/devices/system/cpu/cpu0/topology/core_cpus_list"
  },
  {
    "instruction": "Show all cache sizes",
    "output": "lscpu --caches --parse"
  },
  {
    "instruction": "Show CPU flags",
    "output": "lscpu | grep Flags"
  }
]