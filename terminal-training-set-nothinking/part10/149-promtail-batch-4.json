[
  {"instruction": "Query logs with line format filter", "output": "logcli query '{job=\"nginx\"} | logfmt'"},
  {"instruction": "Query logs with json format filter", "output": "logcli query '{job=\"app\"} | json'"},
  {"instruction": "Extract json fields in logql query", "output": "logcli query '{job=\"app\"} | json | line_format \"method={{.method}} status={{.status}}\"'"},
  {"instruction": "Calculate error rate over 5 minutes", "output": "logcli query 'sum by (job) (rate({job=\"nginx\"} |= \"error\" [5m]))'"},
  {"instruction": "Show top 10 error paths", "output": "logcli query 'topk(10, sum by (path) (count_over_time({job=\"nginx\"} |= \"error\" [1h])))'"},
  {"instruction": "Get log volume per job", "output": "logcli query 'sum by (job) (rate({job=~\".+\"}[5m]))'"},
  {"instruction": "Query logs for specific request ID", "output": "logcli query '{job=\"app\"} |= \"req-abc123\"'"},
  {"instruction": "Query logs excluding health checks", "output": "logcli query '{job=\"nginx\"} != \"/healthz\"'"},
  {"instruction": "Query logs with regex filter", "output": "logcli query '{job=\"nginx\"} |~ \"(error|exception|fatal)\"'"},
  {"instruction": "Query logs excluding pattern", "output": "logcli query '{job=\"nginx\"} !~ \"(debug|trace)\"'"},
  {"instruction": "Query log stream for last 5 minutes", "output": "logcli query '{job=\"nginx\"}' --since=5m"},
  {"instruction": "Query log stream for last 24 hours", "output": "logcli query '{job=\"nginx\"}' --since=24h"},
  {"instruction": "Tail logs from Loki", "output": "logcli query '{job=\"nginx\"}' --tail"},
  {"instruction": "Tail logs with specific filter", "output": "logcli query '{job=\"nginx\"} |= \"error\"' --tail"},
  {"instruction": "Query logs with batch output format", "output": "logcli query '{job=\"nginx\"}' --batch=1000 -o jsonl"},
  {"instruction": "Query logs at a specific point in time", "output": "logcli query '{job=\"nginx\"}' --from=2025-03-15T10:00:00Z --to=2025-03-15T10:05:00Z"},
  {"instruction": "Show log query statistics only", "output": "logcli query '{job=\"nginx\"}' --stats"},
  {"instruction": "Query without displaying log lines", "output": "logcli query '{job=\"nginx\"}' --no-labels"},
  {"instruction": "Query without coloring output", "output": "logcli query '{job=\"nginx\"}' --no-color"},
  {"instruction": "Set logcli address explicitly", "output": "logcli --addr=http://localhost:3100 query '{job=\"nginx\"}'"},
  {"instruction": "Logcli authenticate with bearer token", "output": "logcli --bearer-token=your-token query '{job=\"nginx\"}'"},
  {"instruction": "Logcli query with TLS", "output": "logcli --tls-skip-verify --addr=https://loki.example.com query '{job=\"nginx\"}'"}
]