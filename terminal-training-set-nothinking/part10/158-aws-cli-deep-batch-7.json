[
  {
    "instruction": "Tag an EC2 instance",
    "output": "aws ec2 create-tags --resources i-1234567890abcdef0 --tags Key=Name,Value=WebServer"
  },
  {
    "instruction": "List running EC2 instances with name tag",
    "output": "aws ec2 describe-instances --filters Name=instance-state-name,Values=running --query 'Reservations[*].Instances[*].[InstanceId,Tags[?Key==`Name`].Value|[0]]' --output table"
  },
  {
    "instruction": "Get current AWS identity",
    "output": "aws sts get-caller-identity"
  },
  {
    "instruction": "Associate Elastic IP",
    "output": "aws ec2 associate-address --instance-id i-1234567890abcdef0 --allocation-id eipalloc-12345678"
  },
  {
    "instruction": "Create CloudWatch alarm",
    "output": "aws cloudwatch put-metric-alarm --alarm-name HighCPU --metric-name CPUUtilization --namespace AWS/EC2 --statistic Average --period 300 --threshold 80 --comparison-operator GreaterThanThreshold"
  },
  {
    "instruction": "List EBS volumes",
    "output": "aws ec2 describe-volumes --query 'Volumes[*].[VolumeId,Size,State]' --output table"
  },
  {
    "instruction": "List objects in a bucket with details",
    "output": "aws s3 ls s3://my-bucket/ --human-readable --summarize"
  },
  {
    "instruction": "Describe SQS queue attributes",
    "output": "aws sqs get-queue-attributes --queue-url https://sqs.us-east-1.amazonaws.com/123456789012/my-queue --attribute-names All"
  },
  {
    "instruction": "List available AMIs",
    "output": "aws ec2 describe-images --owners self --query 'Images[*].[ImageId,Name]' --output table"
  },
  {
    "instruction": "Receive messages from SQS",
    "output": "aws sqs receive-message --queue-url https://sqs.us-east-1.amazonaws.com/123456789012/my-queue --attribute-names All --message-attribute-names All"
  },
  {
    "instruction": "Copy file to S3",
    "output": "aws s3 cp myfile.txt s3://my-bucket/"
  },
  {
    "instruction": "Create Lambda function",
    "output": "aws lambda create-function --function-name my-func --runtime python3.9 --role arn:aws:iam::123456789012:role/lambda-role --handler index.handler --zip-file fileb://func.zip"
  },
  {
    "instruction": "Delete S3 bucket contents",
    "output": "aws s3 rm s3://my-bucket/ --recursive"
  },
  {
    "instruction": "Set default region in config",
    "output": "aws configure set region us-west-2"
  },
  {
    "instruction": "Create Elastic IP",
    "output": "aws ec2 allocate-address --domain vpc"
  },
  {
    "instruction": "Send a message to an SQS queue",
    "output": "aws sqs send-message --queue-url https://sqs.us-east-1.amazonaws.com/123456789012/my-queue --message-body 'Hello World'"
  },
  {
    "instruction": "List CloudFormation stacks",
    "output": "aws cloudformation list-stacks --stack-status-filter CREATE_COMPLETE --query 'StackSummaries[*].[StackName,CreationTime]' --output table"
  },
  {
    "instruction": "Create SQS queue",
    "output": "aws sqs create-queue --queue-name my-queue --attributes DelaySeconds=5"
  },
  {
    "instruction": "List instances with pagination",
    "output": "aws ec2 describe-instances --max-items 50 --query 'Reservations[*].Instances[*].[InstanceId]' --output table"
  },
  {
    "instruction": "Stop an EC2 instance",
    "output": "aws ec2 stop-instances --instance-ids i-1234567890abcdef0"
  },
  {
    "instruction": "List Lambda event source mappings",
    "output": "aws lambda list-event-source-mappings --function-name my-function"
  },
  {
    "instruction": "Attach EBS volume",
    "output": "aws ec2 attach-volume --volume-id vol-1234567890abcdef0 --instance-id i-1234567890abcdef0 --device /dev/sdf"
  },
  {
    "instruction": "Create an EC2 instance",
    "output": "aws ec2 run-instances --image-id ami-0abcdef1234567890 --instance-type t3.micro --key-name my-key"
  },
  {
    "instruction": "List load balancers",
    "output": "aws elbv2 describe-load-balancers --query 'LoadBalancers[*].[LoadBalancerName,DNSName]' --output table"
  },
  {
    "instruction": "Invoke a Lambda function",
    "output": "aws lambda invoke --function-name my-function --payload '{\"key\":\"value\"}' response.json"
  },
  {
    "instruction": "Invoke Lambda async",
    "output": "aws lambda invoke --function-name my-function --invocation-type Event --payload '{}' /dev/null"
  }
]