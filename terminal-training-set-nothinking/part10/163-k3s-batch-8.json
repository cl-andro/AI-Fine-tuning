    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION=v1.28.2+k3s1 sh -"
  },
  {
    "instruction": "K3s etcd-snapshot prune",
    "output": "k3s etcd-snapshot prune --snapshot-retention 5"
  },
  {
    "instruction": "Install K3s with flannel disabled",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--flannel-backend=none' sh -"
  },
  {
    "instruction": "Install K3s server with embedded etcd",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init --token mytoken"
  },
  {
    "instruction": "Save an etcd snapshot",
    "output": "k3s etcd-snapshot save --snapshot-dir=/var/lib/rancher/k3s/server/db/snapshots"
  },
  {
    "instruction": "K3s get services",
    "output": "k3s kubectl get svc --all-namespaces"
  },
  {
    "instruction": "K3s get secrets",
    "output": "k3s kubectl get secrets --all-namespaces"
  },
  {
    "instruction": "K3s get events",
    "output": "k3s kubectl get events --all-namespaces"
  },
  {
    "instruction": "Install K3s server only on node",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --node-taint CriticalAddonsOnly=true:NoExecute"
  },
  {
    "instruction": "K3s kubectl create secret generic",
    "output": "k3s kubectl create secret generic my-secret --from-literal=password=test123"
  },
  {
    "instruction": "K3s get all resources in namespace",
    "output": "k3s kubectl get all -n default"
  },
  {
    "instruction": "List etcd snapshots",
    "output": "k3s etcd-snapshot list"
  },
  {
    "instruction": "K3s kubectl top nodes",
    "output": "k3s kubectl top nodes"
  },
  {
    "instruction": "List nodes with k3s kubectl",
    "output": "k3s kubectl get nodes"
  },
  {
    "instruction": "K3s kubectl scale deployment",
    "output": "k3s kubectl scale deployment my-deployment --replicas 5"
