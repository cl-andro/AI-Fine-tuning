  {
    "instruction": "K3s kubectl rollout status",
    "output": "k3s kubectl rollout status deployment my-deployment"
  },
  {
    "instruction": "Restore etcd snapshot",
    "output": "k3s server --cluster-reset --cluster-reset-restore-snapshot=/var/lib/rancher/k3s/server/db/snapshots/on-demand-myserver-1680000000"
