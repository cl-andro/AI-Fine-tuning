    "instruction": "Install K3s with local storage",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--disable=local-storage' sh -"
  },
  {
    "instruction": "K3s kubectl taint node",
    "output": "k3s kubectl taint nodes my-node dedicated=special:NoSchedule"
  },
  {
    "instruction": "Run K3s agent with custom server",
