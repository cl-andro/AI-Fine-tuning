[
  {"instruction": "Install libcap libraries for development", "output": "apt-get install -y libcap-dev libcap2-bin"},
  {"instruction": "Write C program to manage capabilities", "output": "cat > /tmp/cap_demo.c << 'EOF'\n#include <stdio.h>\n#include <sys/capability.h>\nint main() {\n    cap_t caps = cap_get_proc();\n    char *txt = cap_to_text(caps, NULL);\n    printf(\"Current caps: %s\\n\", txt);\n    cap_free(txt);\n    cap_free(caps);\n    return 0;\n}\nEOF\ngcc -o /tmp/cap_demo /tmp/cap_demo.c -lcap"},
  {"instruction": "Compile and run capability demo", "output": "gcc -o /tmp/cap_demo /tmp/cap_demo.c -lcap && /tmp/cap_demo"},
  {"instruction": "Set capability on compiled demo", "output": "setcap cap_net_raw+ep /tmp/cap_demo"},
  {"instruction": "Use cap_from_text to set caps in code", "output": "cat > /tmp/cap_set.c << 'EOF'\n#include <sys/capability.h>\nint main() {\n    cap_t caps = cap_from_text(\"cap_net_raw+ep\");\n    cap_set_file(\"/tmp/cap_demo\", caps);\n    cap_free(caps);\n    return 0;\n}\nEOF\ngcc -o /tmp/cap_set /tmp/cap_set.c -lcap"},
  {"instruction": "Check capset syscall with strace", "output": "strace -e trace=capset,capget capsh --print 2>&1 | head -20"},
  {"instruction": "Trace kernel capability checks", "output": "strace -e trace=capget getcap /bin/ping"},
  {"instruction": "Add capability to user via pam_cap", "output": "echo 'cap_net_raw user1' >> /etc/security/capability.conf"},
  {"instruction": "Configure PAM for user capabilities", "output": "echo 'auth required pam_cap.so' >> /etc/pam.d/common-auth"},
  {"instruction": "Use capsh to preserve caps across user switch", "output": "capsh --keep=1 --user=nobody --addamb=cap_net_raw -- -c 'ping -c 1 127.0.0.1'"},
  {"instruction": "Check pam_cap capabilities file", "output": "cat /etc/security/capability.conf"},
  {"instruction": "Use systemd service with ambient caps", "output": "cat > /etc/systemd/system/mycap.service << 'EOF'\n[Service]\nExecStart=/usr/local/bin/myapp\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nUser=nobody\nEOF"},
  {"instruction": "Reload and start capability service", "output": "systemctl daemon-reload && systemctl start mycap.service"},
  {"instruction": "Check ambient capabilities for systemd service", "output": "systemctl show mycap.service -p AmbientCapabilities"},
  {"instruction": "Make systemd unit keep capabilities", "output": "cat > /etc/systemd/system/myapp.service.d/caps.conf << 'EOF'\n[Service]\nCapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW\nAmbientCapabilities=CAP_NET_BIND_SERVICE\nSecureBits=keep-caps\nEOF"},
  {"instruction": "Set keep-caps securebit for binary", "output": "setcap cap_net_raw+ep /usr/bin/myapp && chmod u-s /usr/bin/myapp"},
  {"instruction": "Document securebits flags", "output": "cat /proc/self/status | grep -i 'secure'"},
  {"instruction": "Check NO_SETUID_FIXUP securebit", "output": "capsh --keep=1 --drop=cap_setuid -- -c 'echo \"securebits active\"'"},
  {"instruction": "Lock capability state with SECBIT_KEEP_CAPS_LOCKED", "output": "capsh --keep=1 --drop=all --locked -- -c 'echo \"locked\"'"},
  {"instruction": "Verify no-new-privileges with capsh", "output": "capsh --no-new-privs -- -c 'echo \"no new privs\"'"},
  {"instruction": "Test no_new_privs with exec", "output": "capsh --no-new-privs -- -c 'cat /proc/self/status | grep NoNew'"},
  {"instruction": "Set an ambient capability for script", "output": "capsh --keep=1 --user=nobody --addamb=cap_net_bind_service -- -c 'python3 -m http.server 80'"}
]