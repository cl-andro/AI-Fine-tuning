[
  {
    "instruction": "Create override to set restart limit",
    "output": "printf '[Service]\\nStartLimitIntervalSec=30\\nStartLimitBurst=3\\n' | sudo tee /etc/systemd/system/nginx.service.d/restart.conf"
  },
  {
    "instruction": "Set CPU shares property on a unit",
    "output": "systemctl set-property nginx.service CPUShares=512"
  },
  {
    "instruction": "Revert unit file to vendor default",
    "output": "systemctl revert nginx.service"
  },
  {
    "instruction": "Show all properties of a unit",
    "output": "systemctl show nginx.service"
  },
  {
    "instruction": "List runtime systemd units",
    "output": "ls /run/systemd/system/"
  },
  {
    "instruction": "List all installed unit files",
    "output": "systemctl list-unit-files"
  },
  {
    "instruction": "List unit files matching nginx pattern",
    "output": "systemctl list-unit-files 'nginx*'"
  },
  {
    "instruction": "Create drop-in directory for overrides",
    "output": "mkdir -p /etc/systemd/system/nginx.service.d"
  },
  {
    "instruction": "Reload a service without restarting",
    "output": "systemctl reload nginx.service"
  },
  {
    "instruction": "List system targets",
    "output": "systemctl list-units --type=target"
  },
  {
    "instruction": "Edit limits drop-in for a service",
    "output": "systemctl edit --drop-in limits.conf nginx.service"
  },
  {
    "instruction": "List system timers",
    "output": "systemctl list-timers"
  },
  {
    "instruction": "Show Wants property of SSH service",
    "output": "systemctl show -p Wants ssh.service"
  },
  {
    "instruction": "List all loaded service units",
    "output": "systemctl list-units --type=service"
  },
  {
    "instruction": "Check if service is active",
    "output": "systemctl is-active nginx.service"
  },
  {
    "instruction": "Set memory limit on a unit",
    "output": "systemctl set-property nginx.service MemoryMax=512M"
  },
  {
    "instruction": "List path units",
    "output": "systemctl list-units --type=path"
  },
  {
    "instruction": "Clean runtime state of a service",
    "output": "systemctl clean nginx.service"
  },
  {
    "instruction": "List swap units",
    "output": "systemctl list-units --type=swap"
  },
  {
    "instruction": "Add SSH as required for multi-user target",
    "output": "systemctl add-requires multi-user.target ssh.service"
  },
  {
    "instruction": "Show systemd version",
    "output": "systemctl --version"
  },
  {
    "instruction": "List static unit files",
    "output": "systemctl list-unit-files --state=static"
  },
  {
    "instruction": "List system paths",
    "output": "systemctl list-paths"
  },
  {
    "instruction": "List automount units",
    "output": "systemctl list-units --type=automount"
  },
  {
    "instruction": "List unit file dependencies",
    "output": "systemctl list-dependencies nginx.service"
  }
