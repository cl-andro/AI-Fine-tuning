[
  {"instruction": "Run memcheck with full leak detection", "output": "valgrind --leak-check=full ./myprogram"},
  {"instruction": "Run cachegrind for cache profiling", "output": "valgrind --tool=cachegrind ./myprogram"},
  {"instruction": "Run massif for heap profiling", "output": "valgrind --tool=massif ./myprogram"},
  {"instruction": "Display massif output with ms_print", "output": "ms_print massif.out.12345"},
  {"instruction": "Run helgrind for thread race detection", "output": "valgrind --tool=helgrind ./myprogram"},
  {"instruction": "Run drd for thread error detection", "output": "valgrind --tool=drd ./myprogram"},
  {"instruction": "Annotate callgrind output", "output": "callgrind_annotate callgrind.out.12345"},
  {"instruction": "Run memcheck showing reachable leaks", "output": "valgrind --leak-check=full --show-leak-kinds=all ./myprogram"},
  {"instruction": "Track origins of uninitialized values", "output": "valgrind --track-origins=yes ./myprogram"},
  {"instruction": "Run with suppression file", "output": "valgrind --suppressions=/path/to/suppressions.txt ./myprogram"},
  {"instruction": "Generate error count summary only", "output": "valgrind -q ./myprogram"},
  {"instruction": "Show reachable and indirect leaks", "output": "valgrind --leak-check=full --show-leak-kinds=reachable,indirect ./myprogram"},
  {"instruction": "Run valgrind with child processes", "output": "valgrind --trace-children=yes ./myprogram"},
  {"instruction": "Set valgrind error exit code", "output": "valgrind --error-exitcode=1 ./myprogram"},
  {"instruction": "Run with verbose diagnostics", "output": "valgrind --verbose ./myprogram"},
  {"instruction": "Log valgrind output to file", "output": "valgrind --log-file=/tmp/valgrind.log ./myprogram"},
  {"instruction": "Run memcheck with malloc/free stats", "output": "valgrind --stats=yes ./myprogram"},
  {"instruction": "Use GDB server mode with valgrind", "output": "valgrind --vgdb=yes --vgdb-error=0 ./myprogram"},
  {"instruction": "Run valgrind with time stamp", "output": "valgrind --time-stamp=yes ./myprogram"},
  {"instruction": "Read valgrind version", "output": "valgrind --version"},
  {"instruction": "List all valgrind tools", "output": "valgrind --help 2>&1 | grep -i 'tool:'"},
  {"instruction": "Run callgrind for call graph profiling", "output": "valgrind --tool=callgrind ./myprogram"}
]