[
  {
    "instruction": "View NUMA node hugepage distribution per node directory",
    "output": "for n in /sys/devices/system/node/node*/hugepages; do echo \"$n: $(cat $n/hugepages-2048kB/nr_hugepages 2>/dev/null)\"; done"
  },
  {
    "instruction": "Set up 64 hugepages of 2MB size",
    "output": "echo 64 | sudo tee /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check kernel config for hugetlbfs support",
    "output": "grep -i HUGETLBFS /boot/config-$(uname -r)"
  },
  {
    "instruction": "Set number of hugepages to 512",
    "output": "echo 512 | sudo tee /proc/sys/vm/nr_hugepages"
  },
  {
    "instruction": "Enable THP zero page",
    "output": "echo 1 | sudo tee /sys/kernel/mm/transparent_hugepage/use_zero_page"
  },
  {
    "instruction": "Mount hugetlbfs with 1GB page size",
    "output": "sudo mount -t hugetlbfs -o pagesize=1G hugetlbfs /mnt/huge_1gb"
  },
  {
    "instruction": "Check current hugepage size",
    "output": "grep Hugepagesize /proc/meminfo"
  },
  {
    "instruction": "List all hugepage filesystem mounts",
    "output": "mount -t hugetlbfs"
  },
  {
    "instruction": "View THP PMD size",
    "output": "cat /sys/kernel/mm/transparent_hugepage/hpage_pmd_size"
  },
  {
    "instruction": "View kernel boot parameters for hugepages",
    "output": "cat /proc/cmdline | tr ' ' '\\n' | grep -i huge"
  },
  {
    "instruction": "Set number of hugepages to 1024",
    "output": "echo 1024 | sudo tee /proc/sys/vm/nr_hugepages"
  },
  {
    "instruction": "View THP allocation statistics from vmstat",
    "output": "grep thp_ /proc/vmstat"
  },
  {
    "instruction": "Show system hugepage usage summary from meminfo",
    "output": "cat /proc/meminfo | grep -E '^Huge'"
  },
  {
    "instruction": "Check current THP enabled mode string",
    "output": "cat /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "Check 1GB hugepage count",
    "output": "cat /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"
  },
  {
    "instruction": "Set hugetlb SHM group to GID 1000",
    "output": "echo 1000 | sudo tee /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "View THP khugepaged full scans counter",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/full_scans"
  },
  {
    "instruction": "Disable THP defragmentation",
    "output": "echo never | sudo tee /sys/kernel/mm/transparent_hugepage/defrag"
  },
  {
    "instruction": "Check NUMA node 0 hugepage count",
    "output": "cat /sys/devices/system/node/node0/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check HugePages_Total value",
    "output": "grep HugePages_Total /proc/meminfo"
  },
  {
    "instruction": "Display NUMA hugepage distribution per node",
    "output": "cat /sys/devices/system/node/node*/meminfo | grep Huge"
  },
  {
    "instruction": "Check transparent hugepage mode",
    "output": "cat /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "Set hugetlb_shm_group via sysctl",
    "output": "sudo sysctl vm.hugetlb_shm_group=2000"
  },
  {
    "instruction": "Check 2MB hugepage count",
    "output": "cat /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check hugepage and THP vmstat counters",
    "output": "cat /proc/vmstat | grep -E 'huge|thp'"
  }
]