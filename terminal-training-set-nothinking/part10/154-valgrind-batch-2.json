[
  {"instruction": "Memcheck with leak only summary", "output": "valgrind --leak-check=summary ./myprogram"},
  {"instruction": "Ignore certain leaks via suppression", "output": "valgrind --gen-suppressions=yes --leak-check=full ./myprogram 2>&1 | tail -30"},
  {"instruction": "Run with max stackframe size set", "output": "valgrind --max-stackframe=1048576 ./myprogram"},
  {"instruction": "Limit number of errors shown", "output": "valgrind --errors-for-leak-kinds=definite --error-limit=yes ./myprogram"},
  {"instruction": "Show reachable but not freed", "output": "valgrind --show-reachable=yes ./myprogram"},
  {"instruction": "Track file descriptor leaks", "output": "valgrind --track-fds=yes ./myprogram"},
  {"instruction": "Define client request for valgrind", "output": "valgrind --client-perms=yes ./myprogram"},
  {"instruction": "Do memcheck on Python extensions", "output": "valgrind --tool=memcheck python3 -c 'print(\"hello\")'"},
  {"instruction": "Suppress known Python errors", "output": "valgrind --suppressions=/usr/lib/valgrind/python3.supp python3 -c 'print(\"hello\")'"},
  {"instruction": "Run with full leak check and fd tracking", "output": "valgrind --leak-check=full --track-fds=yes ./myprogram"},
  {"instruction": "Check system-call parameter validity", "output": "valgrind --track-fds=yes --track-origins=yes ./myprogram"},
  {"instruction": "Show malloc/free stack traces", "output": "valgrind --leak-check=full --show-malloc-free=yes ./myprogram"},
  {"instruction": "Enable expensive but thorough analysis", "output": "valgrind --expensive-definedness-checks=yes ./myprogram"},
  {"instruction": "Memcheck partial-loads-flag", "output": "valgrind --partial-loads-flag=yes ./myprogram"},
  {"instruction": "Set smc-check (self-modifying code)", "output": "valgrind --smc-check=all ./myprogram"},
  {"instruction": "Run with specific alignment check", "output": "valgrind --alignment=8 ./myprogram"},
  {"instruction": "Enable memcheck's undefined value heuristic", "output": "valgrind --undef-value-errors=yes ./myprogram"},
  {"instruction": "Disable memcheck (run none tool)", "output": "valgrind --tool=none ./myprogram"},
  {"instruction": "Run memcheck with leak probe", "output": "valgrind --leak-check=full --leak-resolution=high ./myprogram"},
  {"instruction": "Set memcheck freelist volume", "output": "valgrind --freelist-vol=100000000 ./myprogram"},
  {"instruction": "Run sigprocmask check via memcheck", "output": "valgrind --sigprocmask=yes ./myprogram"},
  {"instruction": "Guard pages around heap objects", "output": "valgrind --extra-alloc-oversize=256 ./myprogram"}
