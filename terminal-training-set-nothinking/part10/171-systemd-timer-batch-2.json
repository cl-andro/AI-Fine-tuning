[
  {
    "instruction": "Analyze weekly calendar expression",
    "output": "systemd-analyze calendar 'weekly'"
  },
  {
    "instruction": "List running timers",
    "output": "systemctl list-timers --state=running"
  },
  {
    "instruction": "List dependencies of a timer",
    "output": "systemctl list-dependencies backup.timer"
  },
  {
    "instruction": "List waiting timers",
    "output": "systemctl list-timers --state=waiting"
  },
  {
    "instruction": "Show all timer properties",
    "output": "systemctl show backup.timer"
  },
  {
    "instruction": "Reload daemon after timer file changes",
    "output": "systemctl daemon-reload"
  },
  {
    "instruction": "List timer unit files by type",
    "output": "systemctl list-unit-files --type=timer"
  },
  {
    "instruction": "Add timer to timers.target wants",
    "output": "systemctl add-wants timers.target backup.timer"
  },
  {
    "instruction": "Edit timer unit with drop-in",
    "output": "systemctl edit backup.timer"
  },
  {
    "instruction": "Analyze calendar with five iterations",
    "output": "systemd-analyze calendar --iterations=5 '*-*-* *:00,30:00'"
  },
  {
    "instruction": "Check timer status",
    "output": "systemctl status backup.timer"
  },
  {
    "instruction": "Create timer for every 6 hours",
    "output": "systemd-run --on-calendar='*-*-* */6:00:00' /usr/bin/every-6-hours.sh"
  },
  {
    "instruction": "List system timer unit files",
    "output": "ls /etc/systemd/system/*.timer"
  },
  {
    "instruction": "Create transient user timer",
    "output": "systemd-run --user --on-calendar='daily' /usr/bin/user-script.sh"
  },
  {
    "instruction": "Show last trigger time of timer",
    "output": "systemctl show -p LastTriggerUSec backup.timer"
  },
  {
    "instruction": "Run a command daily at 2 AM via transient timer",
    "output": "systemd-run --on-calendar='*-*-* 02:00:00' /usr/bin/backup.sh"
  },
  {
    "instruction": "List timers in JSON format",
    "output": "systemctl list-timers --json=pretty"
  },
  {
    "instruction": "Analyze hourly calendar expression",
    "output": "systemd-analyze calendar 'hourly'"
  },
  {
    "instruction": "Create timer for weekdays at 9 AM",
    "output": "systemd-run --on-calendar='Mon..Fri *-*-* 09:00:00' /usr/bin/workday-start.sh"
  },
  {
    "instruction": "Run a command 1 hour after unit activates",
    "output": "systemd-run --on-unit-active=1h /usr/bin/hourly.sh"
  }
