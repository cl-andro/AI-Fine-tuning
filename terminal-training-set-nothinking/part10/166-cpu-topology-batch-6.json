[
  {
    "instruction": "Get CPU count",
    "output": "nproc --all"
  },
  {
    "instruction": "Show NUMA node distances",
    "output": "numactl --hardware | grep distance"
  },
  {
    "instruction": "Show CPU flags",
    "output": "lscpu | grep Flags"
  },
  {
    "instruction": "Show NUMA node free memory",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show architecture specific info",
    "output": "x86info -a"
  },
  {
    "instruction": "Show die IDs",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/die_id | sort -u"
  },
  {
    "instruction": "Show hypervisor info",
    "output": "lscpu --all --hypervisor"
  },
  {
    "instruction": "Show cache index0 size",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/size"
  },
  {
    "instruction": "Show core to socket mapping",
    "output": "lscpu --all --parse=CPU,Core,Socket"
  },
  {
    "instruction": "Show NUMA hardware info",
    "output": "numactl --hardware"
  },
  {
    "instruction": "Set CPU governor to performance",
    "output": "echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show process NUMA policy",
    "output": "numactl --show"
  },
  {
    "instruction": "Show all topology info per core",
    "output": "for i in /sys/devices/system/cpu/cpu*/topology/; do echo \"=== $i ===\"; cat \"$i/core_cpus_list\" 2>/dev/null; done"
  },
  {
    "instruction": "Show CPU online/offline",
    "output": "cat /sys/devices/system/cpu/online"
  },
  {
    "instruction": "Show CPU topology as PNG",
    "output": "lstopo --output-format png topo.png"
  },
  {
    "instruction": "Show interactive topology",
    "output": "lstopo"
  },
  {
    "instruction": "Show cache index0 type",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/type"
  },
  {
    "instruction": "Show CPU topology from sysfs",
    "output": "cat /sys/devices/system/cpu/cpu0/topology/core_cpus_list"
  },
  {
    "instruction": "Show CPU topology graphically",
    "output": "lstopo-no-graphics"
  },
  {
    "instruction": "Show thread siblings per core",
    "output": "lscpu --all --parse=CPU,Core,Socket | grep -v '#'"
  },
  {
    "instruction": "Show CPU in JSON",
    "output": "lscpu --json"
  },
  {
    "instruction": "Show detailed CPUID info",
    "output": "cpuid -1"
