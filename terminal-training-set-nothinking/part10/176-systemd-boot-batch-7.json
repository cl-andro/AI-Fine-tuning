[
  {
    "instruction": "Set default timeout in loader.conf",
    "output": "printf 'timeout 5\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "Set current kernel as default",
    "output": "bootctl set @current"
  },
  {
    "instruction": "Set next boot to UEFI entry 0001",
    "output": "efibootmgr -n 0001"
  },
  {
    "instruction": "Remove a kernel via kernel-install",
    "output": "kernel-install remove 6.1.0-13-amd64"
  },
  {
    "instruction": "Check if system is booted with UEFI",
    "output": "test -d /sys/firmware/efi && echo 'UEFI' || echo 'Legacy'"
  },
  {
    "instruction": "Set boot timeout to 10 seconds",
    "output": "bootctl set-timeout 10"
  },
  {
    "instruction": "Rebuild initramfs for specific kernel",
    "output": "update-initramfs -k 6.1.0-13-amd64 -u"
  },
  {
    "instruction": "Check kernel-install configuration",
    "output": "cat /etc/kernel/install.conf 2>/dev/null || echo 'using defaults'"
  },
  {
    "instruction": "Check bootloader status",
    "output": "bootctl status"
  },
  {
    "instruction": "Show systemd-boot random seed status",
    "output": "bootctl random-seed"
  },
  {
    "instruction": "Edit loader.conf to add editor option",
    "output": "printf 'editor no\\n' >> /boot/loader/loader.conf"
  },
  {
    "instruction": "Check boot entries for UKI support",
    "output": "grep -l 'uki' /boot/loader/entries/*.conf 2>/dev/null"
  },
  {
    "instruction": "Set boot order to entries 0001,0002",
    "output": "efibootmgr -o 0001,0002"
  },
  {
    "instruction": "Add a kernel via kernel-install",
    "output": "kernel-install add 6.1.0-13-amd64 /boot/vmlinuz-6.1.0-13-amd64"
  },
  {
    "instruction": "Create a boot entry for custom kernel",
    "output": "printf 'title Custom Kernel\\nlinux /vmlinuz-custom\\ninitrd /initrd-custom\\noptions root=UUID=abc123 ro quiet\\n' > /boot/loader/entries/custom.conf"
  },
  {
    "instruction": "View boot loader configuration",
    "output": "cat /boot/loader/loader.conf"
  },
  {
    "instruction": "Create a UKI boot entry",
    "output": "printf 'title My UKI\\nefi /EFI/Linux/my-uki.efi\\n' > /boot/loader/entries/my-uki.conf"
  },
  {
    "instruction": "Check if secure boot is enabled",
    "output": "mokutil --sb-state"
  },
  {
    "instruction": "Set kernel-install layout to bls",
    "output": "printf 'layout=bls\\n' > /etc/kernel/install.conf"
  },
  {
    "instruction": "List boot loader entry files",
    "output": "ls /boot/loader/entries/"
  }
]