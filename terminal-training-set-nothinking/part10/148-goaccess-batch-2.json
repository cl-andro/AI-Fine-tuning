[
  {"instruction": "Analyze multiple log files at once", "output": "goaccess access.log.1 access.log.2 -a -o report.html"},
  {"instruction": "Analyze gzipped log files", "output": "goaccess access.log.gz -a -o report.html"},
  {"instruction": "Analyze logs from stdin", "output": "cat access.log | goaccess -a -o report.html"},
  {"instruction": "Analyze logs with zcat pipe", "output": "zcat access.log.*.gz | goaccess -a -o report.html"},
  {"instruction": "Merge multiple months of logs", "output": "cat /var/log/nginx/access.log.* | goaccess -a -o annual-report.html"},
  {"instruction": "Analyze access log with proxy protocol", "output": "goaccess access.log --log-format='%^ %h %^ %^ [%d:%t %^] \"%r\" %s %b \"%R\" \"%u\"'"},
  {"instruction": "Parse Amazon S3 log format", "output": "goaccess access.log --log-format='%d %^ %h %^ %^ %^ %^ %^ %r %s %^ %^ %^ %^ %^ %^'"},
  {"instruction": "Parse CloudFront log format", "output": "goaccess access.log --log-format='%d\\t%t\\t%^\\t%h\\t%^\\t%^\\t%r\\t%s\\t%^\\t%^\\t%^\\t%^\\t%^\\t%^\\t%^\\t%^\\t%^'"},
  {"instruction": "Analyze with debug output", "output": "goaccess access.log --debug -a"},
  {"instruction": "Show invalid log lines during parsing", "output": "goaccess access.log --invalid-requests -a"},
  {"instruction": "Enable double-encoding decoding", "output": "goaccess access.log --double-decode -a"},
  {"instruction": "Enable IP anonymization for privacy", "output": "goaccess access.log --anonymize-ip -a"},
  {"instruction": "Set bandwidth reporting unit to MB", "output": "goaccess access.log --bandwidth=MB -a"},
  {"instruction": "Set bandwidth reporting unit to GB", "output": "goaccess access.log --bandwidth=GB -a"},
  {"instruction": "Disable colored output for terminals", "output": "goaccess access.log --no-color -a"},
  {"instruction": "Enable color scheme", "output": "goaccess access.log --color-scheme=1 -a"},
  {"instruction": "Use config file for options", "output": "goaccess access.log --config-file=/etc/goaccess/goaccess.conf -a"},
  {"instruction": "Enable real-time output to terminal", "output": "goaccess access.log --real-time-log=access.log -o /dev/stdout"},
  {"instruction": "Set real-time HTML refresh interval", "output": "goaccess access.log --real-time-html --real-time-html-refresh=10 -o report.html"},
  {"instruction": "Persist real-time data to disk", "output": "goaccess access.log --real-time-html --daemonize -o /var/www/html/report.html"},
  {"instruction": "Restore from persisted real-time data", "output": "goaccess --restore -o report.html"},
  {"instruction": "Analyze with keep-db for incremental updates", "output": "goaccess access.log --keep-db -o report.html"},
  {"instruction": "Load existing database file", "output": "goaccess --load-db -o report.html"}
