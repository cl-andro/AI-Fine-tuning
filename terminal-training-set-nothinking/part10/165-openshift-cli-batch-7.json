[
  {
    "instruction": "Describe a pod",
    "output": "oc describe pod my-pod -n my-project"
  },
  {
    "instruction": "Create secret",
    "output": "oc create secret generic app-secret --from-literal=password=test"
  },
  {
    "instruction": "Login to OpenShift cluster",
    "output": "oc login https://api.openshift.example.com:6443 -u admin -p password --insecure-skip-tls-verify"
  },
  {
    "instruction": "Create service account",
    "output": "oc create sa my-sa -n my-project"
  },
  {
    "instruction": "New app from source code",
    "output": "oc new-app https://github.com/openshift/nodejs-ex --name=nodejs-app"
  },
  {
    "instruction": "Set deployment resources",
    "output": "oc set resources deployment my-app --limits cpu=500m,memory=1Gi"
  },
  {
    "instruction": "List operators",
    "output": "oc get operators -n openshift-operators"
  },
  {
    "instruction": "Create cronjob",
    "output": "oc create cronjob my-cron --image=busybox --schedule='*/5 * * * *' -- date"
  },
  {
    "instruction": "Login with token",
    "output": "oc login --token=my-token --server=https://api.openshift.example.com:6443"
  },
  {
    "instruction": "List projects",
    "output": "oc get projects"
  },
  {
    "instruction": "Delete a project",
    "output": "oc delete project my-project"
  },
  {
    "instruction": "Start a build",
    "output": "oc start-build my-build -n my-project"
  },
  {
    "instruction": "Port forward to a pod",
    "output": "oc port-forward pod/my-pod 8080:80"
  },
  {
    "instruction": "Attach to running container",
    "output": "oc attach my-pod -c my-container -n my-project"
  },
  {
    "instruction": "Get all pods",
    "output": "oc get pods --all-namespaces"
  },
  {
    "instruction": "Follow pod logs",
    "output": "oc logs -f my-pod -n my-project"
  },
  {
    "instruction": "List cluster nodes",
    "output": "oc get nodes"
  },
  {
    "instruction": "Get resource usage",
    "output": "oc adm top pods --all-namespaces"
  },
  {
    "instruction": "Get current user",
    "output": "oc whoami"
  },
  {
    "instruction": "View project info",
    "output": "oc describe project my-project"
  },
  {
    "instruction": "Describe node",
    "output": "oc describe node my-node"
  },
  {
    "instruction": "Remote shell into a pod",
    "output": "oc rsh my-pod -n my-project"
  }
]