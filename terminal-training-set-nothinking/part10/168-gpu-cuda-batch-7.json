[
  {
    "instruction": "Unload nvidia kernel driver",
    "output": "sudo modprobe -r nvidia"
  },
  {
    "instruction": "List supported GPU clocks",
    "output": "nvidia-smi -q -d SUPPORTED_CLOCKS"
  },
  {
    "instruction": "Check nvidia kernel module parameters",
    "output": "modinfo nvidia | grep parm"
  },
  {
    "instruction": "Show detailed GPU information",
