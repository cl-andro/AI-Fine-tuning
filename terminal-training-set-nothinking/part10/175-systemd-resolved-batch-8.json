[
  {
    "instruction": "Disable LLMNR on an interface",
    "output": "resolvectl llmnr eth0 no"
  },
  {
    "instruction": "View resolved journal logs",
    "output": "journalctl -u systemd-resolved"
  },
  {
    "instruction": "Disable DNS stub listener",
    "output": "printf '[Resolve]\\nDNSStubListener=no\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Check which DNS server resolved a query",
    "output": "resolvectl query example.com --no-pager"
  },
  {
    "instruction": "Show resolved cache statistics",
    "output": "resolvectl statistics | grep -i cache"
  },
  {
    "instruction": "Set DNS cache max TTL",
    "output": "printf '[Resolve]\\nCacheMaxTTL=3600\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Set network manager integration",
    "output": "printf '[Resolve]\\nMulticastDNS=yes\\nLLMNR=yes\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Set DNS over TLS for interface",
    "output": "resolvectl dnsovertls eth0 true"
  },
  {
    "instruction": "Enable DNSSEC validation on interface",
    "output": "resolvectl dnssec eth0 yes"
  },
  {
    "instruction": "Query a specific record type (MX) for domain",
    "output": "resolvectl query --type=MX example.com"
  },
  {
    "instruction": "Show DNS domain list per interface",
    "output": "resolvectl domain"
  },
  {
    "instruction": "Display resolved configuration file",
    "output": "cat /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Follow resolved journal in real time",
    "output": "journalctl -u systemd-resolved -f"
  },
  {
    "instruction": "Flush all DNS caches",
    "output": "resolvectl flush-caches"
  },
  {
    "instruction": "Point /etc/resolv.conf to actual DNS servers",
    "output": "ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf"
  },
  {
    "instruction": "Check LLMNR hostname resolution",
    "output": "resolvectl query --type=A hostname.local"
  },
  {
    "instruction": "Set interface as default route for DNS",
    "output": "resolvectl default-route eth0 true"
  },
  {
    "instruction": "Query a specific record type (SRV) for service",
    "output": "resolvectl query --type=SRV _http._tcp.example.com"
  },
  {
    "instruction": "Set DNS server for an interface",
    "output": "resolvectl dns eth0 1.1.1.1"
  },
  {
    "instruction": "Check DNS servers from resolved config",
    "output": "resolvectl status | grep 'DNS Server'"
  },
  {
    "instruction": "Set default DNS server for all interfaces",
    "output": "resolvectl dns 8.8.8.8"
  }
]