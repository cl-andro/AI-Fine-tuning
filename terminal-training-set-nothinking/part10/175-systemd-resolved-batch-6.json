[
  {
    "instruction": "Set DNS search domain for interface",
    "output": "resolvectl domain eth0 example.com"
  },
  {
    "instruction": "Set default DNS server for all interfaces",
    "output": "resolvectl dns 8.8.8.8"
  },
  {
    "instruction": "Display resolved configuration file",
    "output": "cat /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Enable DNSSEC validation on interface",
    "output": "resolvectl dnssec eth0 yes"
  },
  {
    "instruction": "Query DNS in reverse for IP address",
    "output": "resolvectl query 8.8.8.8"
  },
  {
    "instruction": "Disable DNS over TLS",
    "output": "resolvectl dnsovertls eth0 false"
  },
  {
    "instruction": "Flush all DNS caches",
    "output": "resolvectl flush-caches"
  },
  {
    "instruction": "Check DNSSEC status globally",
    "output": "resolvectl dnssec"
  },
  {
    "instruction": "Restart resolved service",
    "output": "systemctl restart systemd-resolved"
  },
  {
    "instruction": "Follow resolved journal in real time",
    "output": "journalctl -u systemd-resolved -f"
  },
  {
    "instruction": "Query DNS for a domain name",
    "output": "resolvectl query example.com"
  },
  {
    "instruction": "Check which interface handles a domain",
    "output": "resolvectl query example.com | grep -i link"
  },
  {
    "instruction": "Set read-ethers for mDNS",
    "output": "resolvectl mdns eth0 resolve"
  },
  {
    "instruction": "Set DNS cache negative TTL",
    "output": "printf '[Resolve]\\nCacheNegativeTTL=10\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Show DNS server list per interface",
    "output": "resolvectl dns"
  },
  {
    "instruction": "Query with DNSSEC validation",
    "output": "resolvectl query --dnssec example.com"
  },
  {
    "instruction": "Disable DNS stub listener",
    "output": "printf '[Resolve]\\nDNSStubListener=no\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Set DNS cache max TTL",
    "output": "printf '[Resolve]\\nCacheMaxTTL=3600\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Check resolver global status",
    "output": "resolvectl status"
  },
  {
    "instruction": "Set mDNS mode for interface",
    "output": "resolvectl mdns eth0 yes"
  },
  {
    "instruction": "Query DNS statistics",
    "output": "resolvectl statistics"
  },
  {
    "instruction": "Query SRV record with service and proto",
    "output": "resolvectl query --type=SRV _ldap._tcp.example.com"
  },
  {
    "instruction": "Query DNS over TLS status",
    "output": "resolvectl dnsovertls"
  },
  {
    "instruction": "Set DNS over TLS for interface",
    "output": "resolvectl dnsovertls eth0 true"
  },
  {
    "instruction": "Disable LLMNR on an interface",
    "output": "resolvectl llmnr eth0 no"
