[
  {"instruction": "Save resource usage summary with strace", "output": "strace -c -o /tmp/summary.txt curl http://example.com"},
  {"instruction": "Count file I/O operations in backup script", "output": "strace -c -f -o /tmp/backup-io.txt tar czf /tmp/backup.tar.gz /etc"},
  {"instruction": "Compare syscall count before/after optimization", "output": "strace -c -o before.txt ./myapp && strace -c -o after.txt ./myapp-optimized"},
  {"instruction": "Measure time spent in each syscall (wall clock)", "output": "strace -c -w -o /tmp/time-per-syscall.txt curl http://example.com"},
  {"instruction": "Count syscalls per-second rate", "output": "strace -c -S calls -p $(pgrep -f myapp) 2>&1; sleep 5"},
  {"instruction": "Find top syscalls by time spent", "output": "strace -c -w -S time myapp 2>&1"},
  {"instruction": "Analyze syscall error rates", "output": "strace -c -e status=failed myapp 2>&1"},
  {"instruction": "Save detailed trace but only summary to stdout", "output": "strace -o /tmp/detail.log -c myapp 2>&1"},
  {"instruction": "Count thread creation rate", "output": "strace -c -e trace=clone myapp 2>&1"},
  {"instruction": "Measure network call latency", "output": "strace -c -w -e trace=network curl http://example.com"},
  {"instruction": "Count memory allocations from strace", "output": "strace -c -e trace=mmap,brk myapp 2>&1"},
  {"instruction": "Summarize file operation counts", "output": "strace -c -e trace=file ls -R /etc 2>&1 | tail -20"},
  {"instruction": "Profile process creation frequency", "output": "strace -c -e trace=process -f make -j4 2>&1 | tail -20"},
  {"instruction": "CPU time per syscall type (children included)", "output": "strace -c -w -f myapp 2>&1"},
  {"instruction": "Count signals received during run", "output": "strace -c -e trace=signal sleep 10 & sleep 1; kill -USR1 %1; wait 2>&1"},
  {"instruction": "Sort syscall count descending", "output": "strace -c -S calls myapp 2>&1"},
  {"instruction": "Sort syscall errors descending", "output": "strace -c -e status=failed myapp 2>&1"},
  {"instruction": "Show number of context switches", "output": "strace -c -e trace=desc myapp 2>&1 | head -20"},
  {"instruction": "Analyze docker syscall usage", "output": "strace -c -f -o /tmp/docker-syscalls.txt docker run alpine ls"},
  {"instruction": "Check if process is CPU or IO bound via strace", "output": "strace -c myapp 2>&1 | grep -E 'read|write|nanosleep'"},
  {"instruction": "Measure time dilation between real and sys time", "output": "strace -c -w myapp 2>&1 | tail -10"},
  {"instruction": "Get system-wide syscall histogram", "output": "strace -c -p 1 -f -o /dev/null & sleep 10; kill %1"}
]