[
  {"instruction": "Recursively find capabilities on all files", "output": "getcap -r /"},
  {"instruction": "Allow ping with raw socket capability", "output": "setcap cap_net_raw+ep /bin/ping"},
  {"instruction": "Print current capability set", "output": "capsh --print"},
  {"instruction": "Remove all capabilities from a file", "output": "setcap -r /path/to/file"},
  {"instruction": "Run command with inherited network admin", "output": "capsh --inh=cap_net_admin -- -c \"command\""},
  {"instruction": "View capabilities of a process by PID", "output": "getpcaps 1234"},
  {"instruction": "List all Linux capabilities", "output": "capsh --help 2>&1 | grep -i 'cap_'"},
  {"instruction": "Check capabilities on a binary", "output": "getcap /bin/ping"},
  {"instruction": "Give tcpdump packet capture capability", "output": "setcap cap_net_raw,cap_net_admin+ep /usr/sbin/tcpdump"},
  {"instruction": "Set capabilities on python binary", "output": "setcap cap_net_bind_service+ep /usr/bin/python3"},
  {"instruction": "Allow binding to privileged ports", "output": "setcap cap_net_bind_service+ep /usr/bin/node"},
  {"instruction": "Decode capability number to name", "output": "capsh --decode=6"},
  {"instruction": "Show supported capabilities", "output": "cat /proc/sys/kernel/cap_last"},
  {"instruction": "Display capability sets for current shell", "output": "cat /proc/self/status | grep Cap"},
  {"instruction": "Convert capability hex mask to human-readable", "output": "capsh --decode=$(grep CapEff /proc/self/status | awk '{print $2}')"},
  {"instruction": "Run command as uid 0 with dropped caps", "output": "capsh --drop=cap_sys_admin,cap_setuid -- -c \"id\""},
  {"instruction": "Keep capabilities across uid change", "output": "capsh --keep=1 --user=nobody -- -c \"getpcaps $$\""},
  {"instruction": "Check capabilities on directory", "output": "getcap -r /usr/bin/ 2>/dev/null | head -20"},
  {"instruction": "Set capability with specific inheritable set", "output": "setcap cap_net_raw+ei /bin/ping"},
  {"instruction": "Set capability with all three flags (effective, inheritable, permitted)", "output": "setcap cap_dac_override+epi /bin/myapp"},
  {"instruction": "View available capabilities in Debian", "output": "apt-cache search libcap"},
  {"instruction": "Install libcap tools", "output": "apt-get install -y libcap2-bin"}
]