[
  {
    "instruction": "Show CPU isolation info",
    "output": "cat /sys/devices/system/cpu/isolated"
  },
  {
    "instruction": "Show CPU frequency info",
    "output": "lscpu --all --frequency"
  },
  {
    "instruction": "Show all CPU info",
    "output": "cat /proc/cpuinfo"
  },
  {
    "instruction": "Show NUMA node distances",
    "output": "numactl --hardware | grep distance"
  },
  {
    "instruction": "Run with memory policy local",
    "output": "numactl --localalloc myapp"
  },
  {
    "instruction": "Show CPU flags",
    "output": "lscpu | grep Flags"
  },
  {
    "instruction": "Set CPU governor to performance",
    "output": "echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show architecture specific info",
    "output": "x86info -a"
  },
  {
    "instruction": "Show CPU topology as PNG",
    "output": "lstopo --output-format png topo.png"
  },
  {
    "instruction": "Show CPU governor settings",
    "output": "cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show PLATFORM info with cpuid",
    "output": "cpuid -1 | grep -E '(Intel|AMD|family|model)'"
  },
  {
    "instruction": "Show all cache sizes",
    "output": "lscpu --caches --parse"
  },
  {
    "instruction": "Show CPU cache info",
    "output": "lscpu --all --caches"
  },
  {
    "instruction": "Show physical package IDs",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/physical_package_id | sort -u"
  },
  {
    "instruction": "Show AMD specific CPU info",
    "output": "cpuid -1 | grep -i 'L1'"
  },
  {
    "instruction": "Show all topology info per core",
    "output": "for i in /sys/devices/system/cpu/cpu*/topology/; do echo \"=== $i ===\"; cat \"$i/core_cpus_list\" 2>/dev/null; done"
  },
  {
    "instruction": "Show CPU present set",
    "output": "cat /sys/devices/system/cpu/present"
  },
  {
    "instruction": "Show CPU topology in YAML",
    "output": "lstopo-no-graphics --output-format yaml"
  },
  {
    "instruction": "Show cache topology",
    "output": "ls /sys/devices/system/cpu/cpu0/cache/"
  },
  {
    "instruction": "Show core to socket mapping",
    "output": "lscpu --all --parse=CPU,Core,Socket"
  },
  {
    "instruction": "Show NUMA statistics with numastat",
    "output": "numastat"
  },
  {
    "instruction": "Show NUMA node free memory",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show CPU in JSON",
    "output": "lscpu --json"
  }
]