[
  {"instruction": "Analyze only unique visitors", "output": "goaccess access.log --unique-visitors -a -o report.html"},
  {"instruction": "Show only top referrers", "output": "goaccess access.log --enable-panel=REFERRERS -a"},
  {"instruction": "Show only visitor hostnames", "output": "goaccess access.log --enable-panel=HOSTS -a"},
  {"instruction": "Disable all panels except requested ones", "output": "goaccess access.log --disable-panel=* --enable-panel=VISITORS -a"},
  {"instruction": "Enable browser breakdown panel", "output": "goaccess access.log --enable-panel=BROWSERS -a"},
  {"instruction": "Enable OS breakdown panel", "output": "goaccess access.log --enable-panel=OS -a"},
  {"instruction": "Enable status code panel", "output": "goaccess access.log --enable-panel=STATUS_CODES -a"},
  {"instruction": "Enable 404 stats panel", "output": "goaccess access.log --enable-panel=NOT_FOUND -a"},
  {"instruction": "Enable geo location panel", "output": "goaccess access.log --enable-panel=GEO_LOCATION -a"},
  {"instruction": "Enable request timeline panel", "output": "goaccess access.log --enable-panel=TIMELINE -a"},
  {"instruction": "Enable virtual hosts panel", "output": "goaccess access.log --enable-panel=VIRTUAL_HOSTS -a"},
  {"instruction": "Generate report with only key metrics", "output": "goaccess access.log --enable-panel=VISITORS,REQUESTS,STATUS_CODES -a -o summary.html"},
  {"instruction": "Sort visitors by hit count", "output": "goaccess access.log --sort-panel=VISITORS,BY_HITS -a"},
  {"instruction": "Sort visitors by bandwidth usage", "output": "goaccess access.log --sort-panel=VISITORS,BY_BANDWIDTH -a"},
  {"instruction": "Sort requested files by data transferred", "output": "goaccess access.log --sort-panel=REQUESTS,BY_DATA -a"},
  {"instruction": "Sort by average response time", "output": "goaccess access.log --sort-panel=REQUESTS,BY_AVG_TS -a"},
  {"instruction": "Set default sort order", "output": "goaccess access.log --sort-panel=REQUESTS,BY_HITS -a"},
  {"instruction": "Filter by specific country", "output": "goaccess access.log --geoip-database=GeoLite2-City.mmdb --match-panel=GEO_LOCATION,COUNTRY,US -a"},
  {"instruction": "Filter by specific filename pattern", "output": "goaccess access.log --match-panel=REQUESTS,REQUEST,\\.php -a"},
  {"instruction": "Filter logged-in users", "output": "goaccess access.log --match-panel=HOSTS,USER,john -a"},
  {"instruction": "Exclude .jpg requests from report", "output": "goaccess access.log --ignore-panel=REQUESTS --match-panel=REQUESTS,REQUEST,^(?!.*\\.jpg).*$ -a"}
]