[
  {"instruction": "Trace open/read/write syscalls", "output": "strace -e trace=open,read,write ls"},
  {"instruction": "Attach to running process with timestamps", "output": "strace -p 1234 -f -t"},
  {"instruction": "Count syscalls for a command", "output": "strace -c ls"},
  {"instruction": "Save strace output to file", "output": "strace -o output.log ls"},
  {"instruction": "Count library calls with ltrace", "output": "ltrace -c ls"},
  {"instruction": "Trace specific library functions", "output": "ltrace -e malloc+free ls"},
  {"instruction": "Follow child processes with strace", "output": "strace -f ls"},
  {"instruction": "Trace network-related syscalls", "output": "strace -e trace=network curl http://example.com"},
  {"instruction": "Trace file descriptor operations", "output": "strace -e trace=desc ls"},
  {"instruction": "Trace signal handling", "output": "strace -e trace=signal sleep 5"},
  {"instruction": "Trace process management syscalls", "output": "strace -e trace=process ls"},
  {"instruction": "Trace memory mapping syscalls", "output": "strace -e trace=memory ls"},
  {"instruction": "Trace IPC syscalls", "output": "strace -e trace=ipc ls"},
  {"instruction": "Show only file opens", "output": "strace -e openat ls"},
  {"instruction": "Show only file read returns", "output": "strace -e read ls 2>&1 | grep '^read'"},
  {"instruction": "Show absolute timestamps", "output": "strace -tt ls"},
  {"instruction": "Show microsecond timestamps", "output": "strace -ttt ls"},
  {"instruction": "Show relative timestamps", "output": "strace -r ls"},
  {"instruction": "Show syscall durations", "output": "strace -T ls"},
  {"instruction": "Limit strace output length", "output": "strace -s 256 ls"},
  {"instruction": "Hex dump of read/write buffers", "output": "strace -e read -x ls 2>&1 | head -30"},
  {"instruction": "Show full decoded buffers", "output": "strace -v ls 2>&1 | head -20"}
]