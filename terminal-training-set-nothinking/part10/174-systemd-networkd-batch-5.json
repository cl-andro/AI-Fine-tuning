[
  {
    "instruction": "Enable networkd at boot",
    "output": "systemctl enable systemd-networkd"
  },
  {
    "instruction": "Display link status in JSON format",
    "output": "networkctl --json=pretty status"
  },
  {
    "instruction": "Configure DHCP use DNS from DHCP server",
    "output": "printf '[DHCPv4]\\nUseDNS=true\\n' > /etc/systemd/network/10-dhcp-dns.network"
  },
  {
    "instruction": "Create bond member config for eth0",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/20-eth0-bond-member.network"
  },
  {
    "instruction": "Configure DHCP with hostname",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=ipv4\\n[DHCPv4]\\nHostname=myhost\\n' > /etc/systemd/network/10-dhcp-hostname.network"
  },
  {
    "instruction": "Reload networkd after config changes",
    "output": "systemctl reload systemd-networkd"
  },
  {
    "instruction": "Create network config with multiple addresses",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nAddress=192.168.1.10/24\\nAddress=10.0.0.10/24\\n' > /etc/systemd/network/10-multi-ip.network"
  },
  {
    "instruction": "Set networkd to ignore carrier loss",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nUnmanaged=yes\\n' > /etc/systemd/network/10-unmanaged.network"
  },
  {
    "instruction": "Start networkd service",
    "output": "systemctl start systemd-networkd"
  },
  {
    "instruction": "Create bridge port config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBridge=br0\\n' > /etc/systemd/network/20-eth0-bridge-member.network"
  },
  {
    "instruction": "Configure interface MTU",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nMTUBytes=9000\\n' > /etc/systemd/network/10-mtu.network"
  },
  {
    "instruction": "Configure wireless network",
    "output": "printf '[Match]\\nName=wlan0\\n[Network]\\nDHCP=ipv4\\n' > /etc/systemd/network/10-wifi.network"
  },
  {
    "instruction": "Check overall network status",
    "output": "networkctl status"
  },
  {
    "instruction": "Create a dummy interface",
    "output": "printf '[NetDev]\\nName=dummy0\\nKind=dummy\\n' > /etc/systemd/network/10-dummy.netdev"
  },
  {
    "instruction": "List all network links",
    "output": "networkctl list"
  },
  {
    "instruction": "Configure wake on LAN",
    "output": "printf '[Link]\\nWakeOnLan=magic\\n' > /etc/systemd/network/10-wol.link"
  },
  {
    "instruction": "Create a bridge netdev",
    "output": "printf '[NetDev]\\nName=br0\\nKind=bridge\\n' > /etc/systemd/network/10-bridge.netdev"
  },
  {
    "instruction": "Create a VXLAN netdev",
    "output": "printf '[NetDev]\\nName=vxlan100\\nKind=vxlan\\n[VXLAN]\\nId=100\\nRemote=10.0.0.1\\n' > /etc/systemd/network/15-vxlan.netdev"
  },
  {
    "instruction": "Reconfigure a network interface",
    "output": "networkctl reconfigure eth0"
  },
  {
    "instruction": "Show link operational state",
    "output": "networkctl status eth0 --no-pager"
  },
  {
    "instruction": "Display link LLDP neighbors",
    "output": "networkctl lldp"
  },
  {
    "instruction": "Restart networkd service",
    "output": "systemctl restart systemd-networkd"
  },
  {
    "instruction": "Check status of a specific link",
    "output": "networkctl status eth0"
  },
  {
    "instruction": "Set DHCP lease timeout",
    "output": "printf '[DHCPv4]\\nMaxAttempts=10\\n' > /etc/systemd/network/10-dhcp-timeout.network"
  },
  {
    "instruction": "Follow networkd journal in real time",
    "output": "journalctl -u systemd-networkd -f"
  },
  {
    "instruction": "Reload network configuration",
    "output": "networkctl reload"
  }
]