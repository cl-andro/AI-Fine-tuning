[
  {
    "instruction": "Deploy a Nuclio function",
    "output": "nctl deploy --run-image myuser/myfunction:latest --path /path/to/func.yaml"
  },
  {
    "instruction": "Deploy OpenFaaS secret",
    "output": "faas-cli secret create my-secret --from-literal=secret-value"
  },
  {
    "instruction": "List all OpenFaaS stacks",
    "output": "faas-cli describe -f stack.yml"
  },
  {
    "instruction": "Deploy serverless with specific config",
    "output": "serverless deploy --config serverless.prod.yml --stage prod"
  },
  {
    "instruction": "Deploy a serverless framework project",
    "output": "serverless deploy --stage production --region us-east-1"
  },
  {
    "instruction": "Stream serverless logs",
    "output": "serverless logs --function myFunction --tail"
  },
  {
    "instruction": "Create knative function with env vars",
    "output": "kn func create my-function --env VAR1=value1 --env VAR2=value2"
  },
  {
    "instruction": "Login to OpenFaaS gateway",
    "output": "faas-cli login --gateway http://127.0.0.1:8080 --password admin"
  },
  {
    "instruction": "Push OpenFaaS image",
    "output": "faas-cli publish --image myuser/myfunction:latest"
  },
  {
    "instruction": "List Nuclio functions",
    "output": "nctl get function --platform local"
  },
  {
    "instruction": "tail serverless logs for all functions",
    "output": "serverless logs --all --tail"
  },
  {
    "instruction": "Delete Nuclio function",
    "output": "nctl delete function my-function --platform local"
  },
  {
    "instruction": "Print serverless framework version",
    "output": "serverless --version"
  },
  {
    "instruction": "Create serverless config",
    "output": "serverless config credentials --provider aws --key AKIAIOSFODNN7EXAMPLE --secret wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  },
  {
    "instruction": "List knative function revisions",
    "output": "kn service revisions --function my-function"
  },
  {
    "instruction": "Deploy serverless with stages",
    "output": "serverless deploy --stage staging --region us-west-2"
  },
  {
    "instruction": "Invoke serverless with Cognito auth",
    "output": "serverless invoke --function auth --data '{\"username\":\"admin\"}'"
  },
  {
    "instruction": "Deploy knative service with autoscaling",
    "output": "kn service update my-service --concurrency-limit 50 --min-scale 1 --max-scale 10"
  },
  {
    "instruction": "Invoke serverless locally",
    "output": "serverless invoke local --function myFunction --data '{\"test\":true}'"
  },
  {
    "instruction": "List knative service revisions",
    "output": "kn service list-revisions --service my-function"
  },
  {
    "instruction": "Create OpenFaaS function from template",
    "output": "faas-cli new my-function --lang python"
  }
