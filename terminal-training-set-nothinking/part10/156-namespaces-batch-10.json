[
  {"instruction": "Use unshare with rootfs argument", "output": "unshare --mount --fork --root=/path/to/rootfs /bin/bash"},
  {"instruction": "Create chroot with mount namespace and proc", "output": "unshare --mount bash -c 'chroot /path/to/rootfs /bin/bash -c \"mount -t proc proc /proc; ps aux\"'"},
  {"instruction": "Combine selinux and namespaces", "output": "runcon -t container_t unshare -m -n -p --fork --mount-proc /bin/bash"},
  {"instruction": "Use apparmor with namespace confined process", "output": "aa-exec -p /path/to/profile -- unshare -n /bin/bash"},
  {"instruction": "Check process namespace with seccomp-box", "output": "seccomp-unshare -n -p -- /bin/bash -c 'ps aux'"},
  {"instruction": "Use bubblewrap for sandboxing", "output": "bwrap --ro-bind /usr /usr --dev /dev --proc /proc --tmpfs /tmp bash"},
  {"instruction": "Build bubblewrap with user namespace", "output": "bwrap --unshare-user --unshare-pid --unshare-net --ro-bind /usr /usr --proc /proc bash"},
  {"instruction": "Firejail with namespace isolation", "output": "firejail --net=none --private-tmp firefox"},
  {"instruction": "Firejail network namespace setup", "output": "firejail --net=eth0 --ip=192.168.1.100 firefox"},
  {"instruction": "Check firejail namespace status", "output": "firejail --list"},
  {"instruction": "Use flatpak sandbox namespaces", "output": "flatpak run --command=ls org.gnome.Epiphany /proc/self/ns/"},
  {"instruction": "Snap confinement namespaces", "output": "snap run --shell firefox; readlink /proc/self/ns/net"},
  {"instruction": "Check snap with systemd namespace", "output": "systemctl show snap.firefox -p PrivateNetwork"},
  {"instruction": "Use Linux namespace for process sandboxing", "output": "unshare -n -p --fork --mount-proc bash -c 'ip link set lo up; python3 -m http.server 8080'"},
  {"instruction": "Isolated development environment with unshare", "output": "unshare --mount --uts --ipc --net --pid --fork --mount-proc bash --rcfile <(echo 'PS1=\"[isolated] \\w $ \"')"},
  {"instruction": "Net namespace for isolated testing", "output": "unshare -n bash -c 'ip link set lo up && ping -c2 127.0.0.1 && curl --version'"},
  {"instruction": "Create namespace for DNS testing", "output": "unshare -n bash -c 'ip link set lo up && echo \"nameserver 8.8.8.8\" > /etc/resolv.conf; dig google.com'"},
  {"instruction": "Namespace-based service isolation", "output": "unshare --net --pid --fork --mount-proc bash -c 'ip link set lo up; nc -l -p 8080 &; bg; ps aux'"},
  {"instruction": "Debug namespace limits", "output": "cat /proc/sys/user/max_user_namespaces; ulimit -n; ulimit -u"},
  {"instruction": "Check namespace inode usage", "output": "ls -la /proc/self/ns/ && stat /proc/self/ns/net"},
  {"instruction": "Show namespace hierarchy with pstree", "output": "pstree -p $$ | head -30"},
  {"instruction": "Display namespace information for debugging", "output": "echo; for ns in net pid mnt uts ipc user cgroup time; do printf \"%-6s: %s\\n\" \"$ns\" \"$(readlink /proc/self/ns/$ns 2>/dev/null)\"; done"}
]