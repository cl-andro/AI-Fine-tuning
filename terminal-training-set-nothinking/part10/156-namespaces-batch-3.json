[
  {"instruction": "Start a container with all namespaces", "output": "unshare --mount --uts --ipc --net --pid --fork --mount-proc -- /bin/bash"},
  {"instruction": "Create PID namespace and see pid 1", "output": "unshare --pid --fork --mount-proc /bin/bash -c 'echo PID 1 is: $$; sleep 10 & echo PID of sleep: $!'"},
  {"instruction": "Show pid namespace nesting", "output": "cat /proc/self/status | grep NSpid"},
  {"instruction": "Check /proc in PID namespace", "output": "unshare --pid --fork --mount-proc /bin/bash -c 'ps aux'"},
  {"instruction": "Signal init from PID namespace", "output": "unshare --pid --fork --mount-proc /bin/bash -c 'kill -TERM 1'"},
  {"instruction": "Mount /proc inside PID namespace", "output": "unshare --pid --fork bash -c 'mount -t proc none /proc && ps aux'"},
  {"instruction": "Create chroot with mount namespace", "output": "unshare --mount bash -c 'mount --bind /mnt/chroot /mnt/chroot && chroot /mnt/chroot /bin/bash'"},
  {"instruction": "Private mount namespace example", "output": "unshare --mount bash -c 'mount -t tmpfs tmpfs /mnt; df /mnt'"},
  {"instruction": "Create slave mount namespace", "output": "unshare --mount --propagation slave bash -c 'mount -t tmpfs tmpfs /mnt; df /mnt'"},
  {"instruction": "Check mount propagation type", "output": "cat /proc/self/mountinfo | grep '/' | head -5"},
  {"instruction": "Set shared mount propagation", "output": "mount --make-shared /mnt"},
  {"instruction": "Set slave mount propagation", "output": "mount --make-slave /mnt"},
  {"instruction": "Set private mount propagation", "output": "mount --make-private /mnt"},
  {"instruction": "Create bind mount inside namespace", "output": "unshare --mount bash -c 'mount --bind /path /mnt && ls /mnt'"},
  {"instruction": "Mount tmpfs for /tmp in namespace", "output": "unshare --mount bash -c 'mount -t tmpfs -o size=100M tmpfs /tmp; df -h /tmp'"},
  {"instruction": "Unshare mount and pivot root", "output": "unshare --mount bash -c 'pivot_root /newroot /newroot/oldroot && exec chroot . /bin/bash'"},
  {"instruction": "Check which namespaces you are in", "output": "for ns in mnt uts ipc pid net user cgroup time; do echo -n \"$ns: \"; readlink /proc/self/ns/$ns; done"},
  {"instruction": "Compare namespaces between two processes", "output": "diff <(ls -la /proc/1/ns/) <(ls -la /proc/$$/ns/)"},
  {"instruction": "Show namespace inode numbers", "output": "stat -c '%i' /proc/self/ns/net"},
  {"instruction": "Determine if two processes share net ns", "output": "[ $(stat -c '%i' /proc/1234/ns/net) = $(stat -c '%i' /proc/5678/ns/net) ] && echo 'same' || echo 'different'"},
  {"instruction": "List all network namespace inodes", "output": "ls -l /proc/*/ns/net 2>/dev/null | awk '{print $11}' | sort -u"},
  {"instruction": "Count unique PID namespaces", "output": "ls -l /proc/*/ns/pid 2>/dev/null | awk '{print $11}' | sort -u | wc -l"}
]