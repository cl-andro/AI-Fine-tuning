[
  {"instruction": "Trace system-wide openat calls with filename", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat { printf(\"%s %s\\n\", comm, str(args->filename)); }'"},
  {"instruction": "Count all process context switches", "output": "bpftrace -e 'tracepoint:sched:sched_switch { @[comm] = count(); }'"},
  {"instruction": "Monitor new thread creation", "output": "bpftrace -e 'tracepoint:sched:sched_process_fork { printf(\"fork: %s -> %d\\n\", comm, args->child_pid); }'"},
  {"instruction": "Track process exit codes", "output": "bpftrace -e 'tracepoint:sched:sched_process_exit { printf(\"exit: %s code=%d\\n\", comm, args->exit_code); }'"},
  {"instruction": "Monitor process state changes", "output": "bpftrace -e 'tracepoint:sched:sched_process_hang { printf(\"hung: %s\\n\", comm); }'"},
  {"instruction": "Trace when processes get stuck in D state", "output": "bpftrace -e 'tracepoint:sched:sched_process_wait { printf(\"wait: %s\\n\", comm); }'"},
  {"instruction": "Monitor CPU migrations", "output": "bpftrace -e 'tracepoint:sched:sched_migrate_task { printf(\"migrate: %s from %d to %d\\n\", args->comm, args->orig_cpu, args->dest_cpu); }'"},
  {"instruction": "Track process preemption", "output": "bpftrace -e 'tracepoint:sched:sched_wakeup_new { printf(\"wakeup new: %s\\n\", args->comm); }'"},
  {"instruction": "Monitor numa page migrations", "output": "bpftrace -e 'tracepoint:migrate:mm_migrate_pages { printf(\"page migration by %s\\n\", comm); }'"},
  {"instruction": "Trace compaction events", "output": "bpftrace -e 'tracepoint:compaction:mm_compaction_begin { printf(\"compaction started\\n\"); }'"},
  {"instruction": "Monitor writeback events", "output": "bpftrace -e 'tracepoint:writeback:writeback_start { printf(\"writeback started for %s\\n\", str(args->bdi)); }'"},
  {"instruction": "Track dirty page ratio", "output": "bpftrace -e 'tracepoint:balance_dirty_pages:balance_dirty_pages { printf(\"dirty pages balanced\\n\"); }'"},
  {"instruction": "Monitor vmscan activity", "output": "bpftrace -e 'tracepoint:vmscan:mm_vmscan_kswapd_wake { printf(\"kswapd woken\\n\"); }'"},
  {"instruction": "Track page allocation failures", "output": "bpftrace -e 'tracepoint:page_alloc:page_alloc_retry { printf(\"page alloc retry\\n\"); }'"},
  {"instruction": "Monitor THP allocations", "output": "bpftrace -e 'tracepoint:khugepaged:khugepaged_collapse_file { printf(\"THP collapse\\n\"); }'"},
  {"instruction": "Trace mmap calls", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_mmap { printf(\"mmap by %s size=%d\\n\", comm, args->len); }'"},
  {"instruction": "Monitor brk/sbrk heap changes", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_brk { printf(\"brk by %s\\n\", comm); }'"},
  {"instruction": "Trace mprotect calls", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_mprotect { printf(\"mprotect by %s\\n\", comm); }'"},
  {"instruction": "Monitor mlock operations", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_mlock { printf(\"mlock by %s\\n\", comm); }'"},
  {"instruction": "Track munmap calls", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_munmap { printf(\"munmap by %s\\n\", comm); }'"},
  {"instruction": "Monitor remap_file_pages", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_remap_file_pages { printf(\"remap_file_pages by %s\\n\", comm); }'"}
