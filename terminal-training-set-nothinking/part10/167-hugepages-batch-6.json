    "output": "echo madvise | sudo tee /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "Check current hugepage size",
    "output": "grep Hugepagesize /proc/meminfo"
  },
  {
    "instruction": "Check THP max_ptes_none value",
