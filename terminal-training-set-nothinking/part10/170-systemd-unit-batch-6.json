[
  {
    "instruction": "List system sockets",
    "output": "systemctl list-sockets"
  },
  {
    "instruction": "List all service unit files including generated",
    "output": "systemctl list-unit-files --type=service --all"
  },
  {
    "instruction": "List failed services",
    "output": "systemctl list-units --type=service --state=failed"
  },
  {
    "instruction": "List system timers",
    "output": "systemctl list-timers"
  },
  {
    "instruction": "Edit limits drop-in for a service",
    "output": "systemctl edit --drop-in limits.conf nginx.service"
  },
  {
    "instruction": "List indirect unit files",
    "output": "systemctl list-unit-files --state=indirect"
  },
  {
    "instruction": "Restart a service",
    "output": "systemctl restart nginx.service"
  },
  {
    "instruction": "List vendor unit files from lib",
    "output": "ls /lib/systemd/system/*.service"
  },
  {
    "instruction": "Revert unit file to vendor default",
    "output": "systemctl revert nginx.service"
  },
  {
    "instruction": "Link a unit file from another location",
    "output": "systemctl link /opt/nginx/nginx.service"
  },
  {
    "instruction": "List all loaded service units",
    "output": "systemctl list-units --type=service"
  },
  {
    "instruction": "Dump full systemd manager state",
    "output": "systemctl dump"
  },
  {
    "instruction": "Check systemd-analyze for unit config verify",
    "output": "systemd-analyze verify nginx.service"
  },
  {
    "instruction": "Create override config using heredoc",
    "output": "cat > /etc/systemd/system/nginx.service.d/override.conf << 'EOF'\n[Service]\nRestart=always\nRestartSec=10\nEOF"
  },
  {
    "instruction": "List all disabled unit files",
    "output": "systemctl list-unit-files --state=disabled"
  },
  {
    "instruction": "Check overall system state",
    "output": "systemctl is-system-running"
  },
  {
    "instruction": "List all unit files by state and type",
    "output": "systemctl list-unit-files --type=service --state=indirect,generated"
  },
  {
    "instruction": "Apply preset policy to a service",
    "output": "systemctl preset nginx.service"
  },
  {
    "instruction": "List automount units",
    "output": "systemctl list-units --type=automount"
  },
  {
    "instruction": "Restart service only if running",
    "output": "systemctl try-restart nginx.service"
  },
  {
    "instruction": "Disable service from starting at boot",
    "output": "systemctl disable nginx.service"
  },
  {
    "instruction": "Check if service is active",
    "output": "systemctl is-active nginx.service"
  },
  {
    "instruction": "Create override to set restart limit",
    "output": "printf '[Service]\\nStartLimitIntervalSec=30\\nStartLimitBurst=3\\n' | sudo tee /etc/systemd/system/nginx.service.d/restart.conf"
  },
  {
    "instruction": "Show all properties of a unit",
    "output": "systemctl show nginx.service"
  },
  {
    "instruction": "List generated unit files",
    "output": "systemctl list-unit-files --state=generated"
  },
  {
    "instruction": "Stop a running service",
    "output": "systemctl stop nginx.service"
