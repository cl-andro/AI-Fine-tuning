[
  {"instruction": "Track TCP connections via /proc", "output": "strace -e trace=connect,accept,bind netstat -an"},
  {"instruction": "Monitor DNS resolution traffic", "output": "strace -e trace=network host google.com 2>&1 | grep -E 'connect|sendto|recvfrom'"},
  {"instruction": "Trace HTTP request via curl", "output": "strace -e trace=network,sendto,recvfrom curl http://example.com"},
  {"instruction": "Monitor socket creation in python script", "output": "strace -e trace=socket python3 -c 'import socket; s=socket.socket(); s.connect((\"example.com\",80))'"},
  {"instruction": "Trace all file modifications in a command", "output": "strace -e trace=write,pwrite,rename,mkdir,unlink touch /tmp/test.txt"},
  {"instruction": "Watch all stat calls", "output": "strace -e trace=stat,lstat,fstat ls -l"},
  {"instruction": "Monitor file permission changes", "output": "strace -e trace=chmod,fchmod,chown chmod 644 /tmp/test.txt"},
  {"instruction": "Track directory changes with chdir", "output": "strace -e trace=chdir,fchdir cd /tmp"},
  {"instruction": "Monitor process priority changes", "output": "strace -e trace=nice,setpriority renice 10 -p 1"},
  {"instruction": "Watch mount and unmount operations", "output": "strace -e trace=mount,umount mount /dev/sda1 /mnt"},
  {"instruction": "Trace swap on/off calls", "output": "strace -e trace=swapon,swapoff swapon /swapfile"},
  {"instruction": "Monitor sync and fsync calls", "output": "strace -e trace=fsync,sync,fdatasync dd if=/dev/zero of=/tmp/test bs=1M count=10"},
  {"instruction": "Track ioctl operations", "output": "strace -e trace=ioctl fdisk -l 2>&1 | head -30"},
  {"instruction": "Monitor ptrace calls", "output": "strace -e trace=ptrace strace ls"},
  {"instruction": "Watch prctl calls", "output": "strace -e trace=prctl ls"},
  {"instruction": "Monitor capget/capset", "output": "strace -e trace=capget,capset getcap /bin/ping"},
  {"instruction": "Trace getcpu calls", "output": "strace -e trace=getcpu ls 2>&1 | head -10"},
  {"instruction": "Watch sched_get/setattr", "output": "strace -e trace=sched_getattr,sched_setattr chrt -r 1 sleep 1"},
  {"instruction": "Monitor time related syscalls", "output": "strace -e trace=time,gettimeofday,clock_gettime date"},
  {"instruction": "Watch getpid/getppid calls", "output": "strace -e trace=getpid,getppid ps"},
  {"instruction": "Monitor uname syscalls", "output": "strace -e trace=uname uname -a"},
  {"instruction": "Trace syslog syscalls", "output": "strace -e trace=syslog dmesg 2>&1 | head -10"}
