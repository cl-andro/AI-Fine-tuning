[
  {
    "instruction": "Create PVC",
    "output": "oc create pvc my-pvc --access-modes ReadWriteOnce --resources requests.storage=10Gi"
  },
  {
    "instruction": "Scale a deployment",
    "output": "oc scale deployment my-app --replicas 5"
  },
  {
    "instruction": "Create a new project",
    "output": "oc new-project my-project --display-name='My Project'"
  },
  {
    "instruction": "Set deployment env vars",
    "output": "oc set env deployment/my-app DATABASE_URL=postgres://..."
  },
  {
    "instruction": "Get pod YAML",
    "output": "oc get pod my-pod -o yaml"
  },
  {
    "instruction": "Get all api resources",
    "output": "oc api-resources --namespaced=true"
  },
  {
    "instruction": "Get routes",
    "output": "oc get routes -n my-project"
  },
  {
    "instruction": "Create a route",
    "output": "oc create route edge --service=my-service --cert=tls.crt --key=tls.key"
  },
  {
    "instruction": "Create configmap",
    "output": "oc create configmap app-config --from-file=config.properties"
  },
  {
    "instruction": "Process and apply a template",
    "output": "oc process -f template.yaml | oc apply -f -"
  },
  {
    "instruction": "Get events",
    "output": "oc get events -n my-project"
  },
  {
    "instruction": "List imagestreams",
    "output": "oc get imagestreams -n openshift"
  },
  {
    "instruction": "Get pod logs for previous instance",
    "output": "oc logs -p my-pod -n my-project"
  },
  {
    "instruction": "Debug a pod",
    "output": "oc debug pod/my-pod -- /bin/sh"
  },
  {
    "instruction": "Cancel a build",
    "output": "oc cancel-build my-build-1 -n my-project"
  },
  {
    "instruction": "Rollout status",
    "output": "oc rollout status deployment/my-app"
  },
  {
    "instruction": "Edit a resource",
    "output": "oc edit deployment my-app"
  },
  {
    "instruction": "Expose a service",
    "output": "oc expose svc my-service --hostname=myapp.example.com"
  },
  {
    "instruction": "Get build configs",
    "output": "oc get bc -n my-project"
  },
  {
    "instruction": "Switch project",
    "output": "oc project my-project"
  },
  {
    "instruction": "Adm manage node",
    "output": "oc adm manage-node my-node --schedulable=false"
  },
  {
    "instruction": "Get services",
    "output": "oc get svc -n my-project"
  },
  {
    "instruction": "New app from Docker image",
    "output": "oc new-app --docker-image=nginx:latest --name=nginx-web"
  },
  {
    "instruction": "Apply a file",
    "output": "oc apply -f deployment.yaml -n my-project"
  },
  {
    "instruction": "Deploy from image stream",
    "output": "oc new-app --image-stream=php --name=my-app"
  },
  {
    "instruction": "Get TLS secrets",
    "output": "oc get secrets --all-namespaces | grep tls"
  }
]