[
  {
    "instruction": "Show DNS domain list per interface",
    "output": "resolvectl domain"
  },
  {
    "instruction": "Set DNS stub listener to localhost only",
    "output": "printf '[Resolve]\\nDNSStubListener=local\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Check which interface handles a domain",
    "output": "resolvectl query example.com | grep -i link"
  },
  {
    "instruction": "Display resolved configuration file",
    "output": "cat /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Check DNS servers from resolved config",
    "output": "resolvectl status | grep 'DNS Server'"
  },
  {
    "instruction": "Query CNAME record for domain",
    "output": "resolvectl query --type=CNAME example.com"
  },
  {
    "instruction": "Set network manager integration",
    "output": "printf '[Resolve]\\nMulticastDNS=yes\\nLLMNR=yes\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Set DNS server for an interface",
    "output": "resolvectl dns eth0 1.1.1.1"
  },
  {
    "instruction": "Disable mDNS on an interface",
    "output": "resolvectl mdns eth0 no"
  },
  {
    "instruction": "Show resolved cache statistics",
    "output": "resolvectl statistics | grep -i cache"
  },
  {
    "instruction": "Check which DNS server resolved a query",
    "output": "resolvectl query example.com --no-pager"
  },
  {
    "instruction": "Query DNS in reverse for IP address",
    "output": "resolvectl query 8.8.8.8"
  },
  {
    "instruction": "Set multiple DNS servers",
    "output": "resolvectl dns eth0 1.1.1.1 8.8.8.8"
  },
  {
    "instruction": "Show DNS server list per interface",
    "output": "resolvectl dns"
  },
  {
    "instruction": "Query DNS statistics",
    "output": "resolvectl statistics"
  },
  {
    "instruction": "Disable DNS stub listener",
    "output": "printf '[Resolve]\\nDNSStubListener=no\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Query with DNSSEC validation",
    "output": "resolvectl query --dnssec example.com"
  },
  {
    "instruction": "Set LLMNR mode for interface",
    "output": "resolvectl llmnr eth0 yes"
  },
  {
    "instruction": "Set DNS over TLS for interface",
    "output": "resolvectl dnsovertls eth0 true"
  },
  {
    "instruction": "Check if systemd-resolved is used as resolver",
    "output": "ls -la /etc/resolv.conf"
  },
  {
    "instruction": "Check resolver global status",
    "output": "resolvectl status"
  },
  {
    "instruction": "Perform multicast DNS query",
    "output": "resolvectl query --type=AAAA myhost.local"
  },
  {
    "instruction": "Follow resolved journal in real time",
    "output": "journalctl -u systemd-resolved -f"
  }
]