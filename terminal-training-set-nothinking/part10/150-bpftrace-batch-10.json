[
  {"instruction": "Create bpftrace one-liner for top file reads", "output": "bpftrace -e 'tracepoint:syscalls:sys_exit_read { @[comm] = sum(args->ret); } interval:s:10 { print(@, 5); clear(@); }'"},
  {"instruction": "Track NUMA memory allocations", "output": "bpftrace -e 'tracepoint:kmem:alloc_node { printf(\"alloc from node %d by %s\\n\", args->node, comm); }'"},
  {"instruction": "Monitor huge page allocations", "output": "bpftrace -e 'tracepoint:kmem:mm_page_alloc { printf(\"page alloc order=%d\\n\", args->order); }'"},
  {"instruction": "Count pages swapped in/out", "output": "bpftrace -e 'tracepoint:swap:swap_readpage { @[\"swap_in\"] = count(); } tracepoint:swap:swap_writepage { @[\"swap_out\"] = count(); }'"},
  {"instruction": "Monitor memory reclaim behavior", "output": "bpftrace -e 'kprobe:try_to_free_pages { printf(\"memory reclaim by %s\\n\", comm); }'"},
