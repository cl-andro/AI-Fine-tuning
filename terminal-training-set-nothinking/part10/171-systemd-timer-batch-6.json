[
  {
    "instruction": "List disabled timer unit files",
    "output": "systemctl list-unit-files --type=timer --state=disabled"
  },
  {
    "instruction": "Persist a timer to survive reboots",
    "output": "printf '[Timer]\\nPersistent=true\\n' | sudo tee /etc/systemd/system/backup.timer.d/persist.conf"
  },
  {
    "instruction": "List dependencies of a timer",
    "output": "systemctl list-dependencies backup.timer"
  },
  {
    "instruction": "Stop a timer manually",
    "output": "systemctl stop backup.timer"
  },
  {
    "instruction": "Show OnCalendar property of a timer",
    "output": "systemctl show -p OnCalendar backup.timer"
  },
  {
    "instruction": "Reload daemon after timer file changes",
    "output": "systemctl daemon-reload"
  },
  {
    "instruction": "Edit timer unit with drop-in",
    "output": "systemctl edit backup.timer"
  },
  {
    "instruction": "Analyze a calendar expression for next runs",
    "output": "systemd-analyze calendar 'Mon *-*-* 00:00:00'"
  },
  {
    "instruction": "Reenable a timer",
    "output": "systemctl reenable backup.timer"
  },
  {
    "instruction": "Analyze calendar with base time",
    "output": "systemd-analyze calendar '*-*-* 00:00:00' --base-time=2024-01-01"
  },
  {
    "instruction": "View timer unit file content",
    "output": "systemctl cat backup.timer"
  },
  {
    "instruction": "View journal for timer-triggered service",
    "output": "journalctl -u backup.service"
  },
  {
    "instruction": "List waiting timers",
    "output": "systemctl list-timers --state=waiting"
  },
  {
    "instruction": "Create timer that fires every 15 minutes",
    "output": "systemd-run --on-active=15m --unit=quarterly /usr/bin/quarterly-check.sh"
  },
  {
    "instruction": "Create transient timer with custom unit name",
    "output": "systemd-run --unit=custom --on-calendar='*-*-* *:00:00' /usr/bin/custom-script.sh"
  },
  {
    "instruction": "Change OnCalendar property at runtime",
    "output": "systemctl set-property backup.timer OnCalendar='*-*-* 03:00:00'"
  },
  {
    "instruction": "Analyze weekly calendar expression",
    "output": "systemd-analyze calendar 'weekly'"
  },
  {
    "instruction": "List timers filtered by glob pattern",
    "output": "systemctl list-timers 'backup*'"
  },
  {
    "instruction": "Check timer status",
    "output": "systemctl status backup.timer"
  },
  {
    "instruction": "Analyze timestamp for now plus 1 hour",
    "output": "systemd-analyze timestamp 'now + 1 hour'"
  },
  {
    "instruction": "Analyze daily calendar expression",
    "output": "systemd-analyze calendar 'daily'"
  },
  {
    "instruction": "Run a command 30 minutes from now",
    "output": "systemd-run --on-active=30m /usr/bin/check.sh"
  }
]