[
  {
    "instruction": "Show NUMA statistics with numastat",
    "output": "numastat"
  },
  {
    "instruction": "Show all CPU info",
    "output": "cat /proc/cpuinfo"
  },
  {
    "instruction": "Show core to socket mapping",
    "output": "lscpu --all --parse=CPU,Core,Socket"
  },
  {
    "instruction": "Show CPU topology in YAML",
    "output": "lstopo-no-graphics --output-format yaml"
  },
  {
    "instruction": "Bind a command to a specific NUMA node",
    "output": "numactl --cpunodebind=0 --membind=0 myapp"
  },
  {
    "instruction": "Show NUMA node free memory",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show CPU flags",
    "output": "lscpu | grep Flags"
  },
  {
    "instruction": "Show cluster topology",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/cluster_cpus_list"
  },
  {
    "instruction": "Show CPU vulnerability info",
    "output": "cat /sys/devices/system/cpu/vulnerabilities/*"
  },
  {
    "instruction": "Show CPU info in extended format",
    "output": "lscpu --all --extended"
  },
  {
    "instruction": "Run with policy interleaved",
    "output": "numactl --interleave=all myapp"
  },
  {
    "instruction": "Set CPU governor to performance",
    "output": "echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show AMD specific CPU info",
    "output": "cpuid -1 | grep -i 'L1'"
  },
  {
    "instruction": "Run with memory policy preferred",
    "output": "numactl --preferred=0 myapp"
  },
  {
    "instruction": "Show thread siblings per core",
    "output": "lscpu --all --parse=CPU,Core,Socket | grep -v '#'"
  },
  {
    "instruction": "Show PLATFORM info with cpuid",
    "output": "cpuid -1 | grep -E '(Intel|AMD|family|model)'"
  },
  {
    "instruction": "Show NUMA hardware info",
    "output": "numactl --hardware"
  },
  {
    "instruction": "Get CPU count",
    "output": "nproc --all"
  },
  {
    "instruction": "Show cache topology",
    "output": "ls /sys/devices/system/cpu/cpu0/cache/"
  },
  {
    "instruction": "Show CPU in JSON",
    "output": "lscpu --json"
  },
  {
    "instruction": "Run with memory policy local",
    "output": "numactl --localalloc myapp"
  },
  {
    "instruction": "Bind to specific cpus",
    "output": "taskset -c 0,2,4 myapp"
  },
  {
    "instruction": "Show cache index0 size",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/size"
  },
  {
    "instruction": "Show cache index0 type",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/type"
  }
]