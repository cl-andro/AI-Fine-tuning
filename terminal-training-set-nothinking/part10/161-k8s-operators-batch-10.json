[
  {
    "instruction": "Scorecard with kuttl",
    "output": "operator-sdk scorecard --bundle ./bundle --selector='suite=kuttlsuite'"
  },
  {
    "instruction": "Create OLM catalog source",
    "output": "operator-sdk run bundle my-registry/my-operator-bundle:v0.0.1 --namespace operators --install-mode AllNamespaces"
  },
  {
    "instruction": "Initialize with ready-to-run",
    "output": "operator-sdk init --domain example.com --repo github.com/example/my-operator --skip-go-version-check"
  },
  {
    "instruction": "Package operator for OLM",
    "output": "operator-sdk run bundle docker.io/my-registry/my-operator-bundle:v0.0.1"
  },
  {
    "instruction": "Validate with OLM",
    "output": "operator-sdk bundle validate ./bundle --select-optional name=operatorhub"
  },
  {
    "instruction": "Build operator image",
    "output": "make docker-build IMG=my-registry/my-operator:v1"
  },
  {
    "instruction": "Scaffold a new project with Dockerfile",
    "output": "operator-sdk init --domain example.com --repo github.com/example/my-operator --project-name my-operator"
  },
  {
    "instruction": "Install OLM",
    "output": "operator-sdk olm install"
  },
  {
    "instruction": "Set project license",
    "output": "kubebuilder init --domain example.com --repo github.com/example/my-operator --license apache2"
  },
  {
    "instruction": "Create API with cluster-scoped",
    "output": "operator-sdk create api --group apps --version v1 --kind MyApp --resource --controller --namespaced=false"
  },
  {
    "instruction": "Install CRDs",
    "output": "make install"
  },
  {
    "instruction": "Update dependencies",
    "output": "go mod tidy"
  },
  {
    "instruction": "Add a second API",
    "output": "operator-sdk create api --group cache --version v1 --kind Memcached --resource --controller"
  },
  {
    "instruction": "Generate CRD YAML",
    "output": "make generate && make manifests"
  },
  {
    "instruction": "Create API with short names",
    "output": "operator-sdk create api --group apps --version v1 --kind MyApp --resource --controller --namespaced --plural myapps"
  },
  {
    "instruction": "Scorecard tests",
    "output": "operator-sdk scorecard --bundle ./bundle"
  },
  {
    "instruction": "Build operator with specific arch",
    "output": "make docker-build IMG=my-registry/my-operator:v1 GOOS=linux GOARCH=amd64"
  },
  {
    "instruction": "Create a webhook",
    "output": "kubebuilder create webhook --group apps --version v1 --kind MyApp --programmatic-validation"
  },
  {
    "instruction": "Create config samples",
    "output": "make generate"
  },
  {
    "instruction": "Create external plugin",
    "output": "operator-sdk create api --group apps --version v1 --kind MyApp --external-plugins example-plugin"
  },
  {
    "instruction": "Run operator locally with custom kubeconfig",
    "output": "make run ENABLE_WEBHOOKS=false"
  }
]