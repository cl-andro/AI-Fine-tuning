[
  {
    "instruction": "List all enabled unit files",
    "output": "systemctl list-unit-files --state=enabled"
  },
  {
    "instruction": "Reload a service without restarting",
    "output": "systemctl reload nginx.service"
  },
  {
    "instruction": "Create override config using heredoc",
    "output": "cat > /etc/systemd/system/nginx.service.d/override.conf << 'EOF'\n[Service]\nRestart=always\nRestartSec=10\nEOF"
  },
  {
    "instruction": "Show all properties of a unit",
    "output": "systemctl show nginx.service"
  },
  {
    "instruction": "Check if service is active",
    "output": "systemctl is-active nginx.service"
  },
  {
    "instruction": "List unit files matching nginx pattern",
    "output": "systemctl list-unit-files 'nginx*'"
  },
  {
    "instruction": "List all masked unit files",
    "output": "systemctl list-unit-files --state=masked"
  },
  {
    "instruction": "Apply preset policy to a service",
    "output": "systemctl preset nginx.service"
  },
  {
    "instruction": "Check service status with details",
    "output": "systemctl status nginx.service"
  },
  {
    "instruction": "Add service as required by multi-user target",
    "output": "systemctl add-requires multi-user.target nginx.service"
  },
  {
    "instruction": "List enabled and disabled service unit files",
    "output": "systemctl list-unit-files --type=service --state=enabled,disabled"
