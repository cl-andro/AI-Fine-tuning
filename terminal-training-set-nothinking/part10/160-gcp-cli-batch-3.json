    "output": "gcloud projects remove-iam-policy-binding my-project-id --member user:user@example.com --role roles/viewer"
  },
  {
    "instruction": "Deploy a Cloud Run service",
    "output": "gcloud run deploy my-service --image gcr.io/my-project/my-image --region us-central1"
  },
  {
    "instruction": "Set autoscaling for MIG",
    "output": "gcloud compute instance-groups managed set-autoscaling my-mig --zone us-central1-a --max-num-replicas 10 --min-num-replicas 2 --target-cpu-utilization 0.8"
  },
  {
    "instruction": "Create instance template",
    "output": "gcloud compute instance-templates create my-template --machine-type e2-medium --image-family ubuntu-2204-lts --image-project ubuntu-os-cloud"
  },
  {
