[
  {"instruction": "Run memcheck with leak-check on exit", "output": "valgrind --leak-check=full --show-leak-kinds=all --undef-value-errors=no ./myprogram"},
  {"instruction": "Run all basic checks combined", "output": "valgrind --leak-check=full --track-origins=yes --track-fds=yes ./myprogram"},
  {"instruction": "Run valgrind with comprehensive diagnostics", "output": "valgrind -v --leak-check=full --show-leak-kinds=all --track-origins=yes ./myprogram"},
  {"instruction": "Quick check for errors only (no leak)", "output": "valgrind --leak-check=no --errors-for-leak-kinds=none ./myprogram"},
  {"instruction": "Run with undefined-value skip", "output": "valgrind --leak-check=full --undef-value-errors=no ./myprogram"},
  {"instruction": "Use in scripts with exit code on error", "output": "valgrind --error-exitcode=1 --leak-check=full ./myprogram 2>&1 && echo 'PASS' || echo 'FAIL'"},
  {"instruction": "Check for syscall param errors", "output": "valgrind --track-fds=yes --sigprocmask=yes ./myprogram 2>&1 | grep -i 'Syscall param'"},
  {"instruction": "Verify valgrind finding with GDB", "output": "vgdb --pid=$(pgrep -f valgrind) --command='bt' 2>&1"},
  {"instruction": "Run memcheck for a specific function", "output": "valgrind --toggle-collect=myFunction ./myprogram"},
  {"instruction": "Find overhead of valgrind tool", "output": "time valgrind --tool=none ./myprogram"},
  {"instruction": "Run callgrind and see performance counters", "output": "valgrind --tool=callgrind --dump-every-bb=yes ./myprogram"},
  {"instruction": "Profile multithreaded app with cachegrind", "output": "valgrind --tool=cachegrind --cache-sim=yes ./my_threaded_app"},
  {"instruction": "Attach valgrind to already running process", "output": "valgrind --smc-check=all -- ./myprogram $(cat /proc/1234/cmdline | tr '\\0' ' ')"},
  {"instruction": "Use valgrind with other-wrapper", "output": "valgrind --wrapper='gdb --args' ./myprogram"},
  {"instruction": "Set valgrind to use specific address space", "output": "valgrind --aspace-minaddr=0x10000000 ./myprogram"},
  {"instruction": "Run valgrind with simulation of low memory", "output": "valgrind --aspace-maxaddr=0x70000000 ./myprogram"},
  {"instruction": "Valgrind with debug option on fail", "output": "valgrind --vgdb-error=1 --vgdb-prefix=./vgdb ./myprogram"},
  {"instruction": "Run in quiet mode with only errors", "output": "valgrind -q --leak-check=full ./myprogram"},
  {"instruction": "Show heap summary only", "output": "valgrind --leak-check=summary --show-leak-kinds=all ./myprogram"},
  {"instruction": "Limit test run to errors only", "output": "valgrind --error-limit=yes --max-errors=10 ./myprogram"},
  {"instruction": "Run with extended help options", "output": "valgrind --help-debug 2>&1 | head -80"},
  {"instruction": "Check valgrind debug options for tool", "output": "valgrind --tool=memcheck --help 2>&1 | head -50"}
]