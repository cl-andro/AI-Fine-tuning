[
  {
    "instruction": "Create network config with multiple addresses",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nAddress=192.168.1.10/24\\nAddress=10.0.0.10/24\\n' > /etc/systemd/network/10-multi-ip.network"
  },
  {
    "instruction": "Create bond member config for eth1",
    "output": "printf '[Match]\\nName=eth1\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/21-eth1-bond-member.network"
  },
  {
    "instruction": "Display link status in JSON format",
    "output": "networkctl --json=pretty status"
  },
  {
    "instruction": "Reload network configuration",
    "output": "networkctl reload"
  },
  {
    "instruction": "Create a dummy interface",
    "output": "printf '[NetDev]\\nName=dummy0\\nKind=dummy\\n' > /etc/systemd/network/10-dummy.netdev"
  },
  {
    "instruction": "List all netdev config files",
    "output": "ls /etc/systemd/network/*.netdev"
  },
  {
    "instruction": "Configure bonding with LACP rate",
    "output": "printf '[NetDev]\\nName=bond0\\nKind=bond\\n[Bond]\\nMode=802.3ad\\nLACPTransmitRate=fast\\n' > /etc/systemd/network/10-bond-lacp-rate.netdev"
  },
  {
    "instruction": "Create a simple DHCP network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=ipv4\\n' > /etc/systemd/network/10-eth0.network"
  },
  {
    "instruction": "Configure DHCP with hostname",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=ipv4\\n[DHCPv4]\\nHostname=myhost\\n' > /etc/systemd/network/10-dhcp-hostname.network"
  },
  {
    "instruction": "Configure route table",
    "output": "printf '[Match]\\nName=eth0\\n[Route]\\nDestination=10.0.0.0/8\\nGateway=192.168.1.1\\nTable=100\\n' > /etc/systemd/network/10-route.network"
  },
  {
    "instruction": "Display networkd config file content",
    "output": "cat /etc/systemd/network/10-eth0.network"
  },
  {
    "instruction": "Renew DHCP lease on an interface",
    "output": "networkctl renew eth0"
  },
  {
    "instruction": "Start networkd service",
    "output": "systemctl start systemd-networkd"
  },
  {
    "instruction": "Follow networkd journal in real time",
    "output": "journalctl -u systemd-networkd -f"
  },
  {
    "instruction": "Configure interface speed and duplex",
    "output": "printf '[Link]\\nSpeedBytesPerSec=1G\\nDuplex=full\\n' > /etc/systemd/network/10-speed-duplex.link"
  },
  {
    "instruction": "Configure wake on LAN",
    "output": "printf '[Link]\\nWakeOnLan=magic\\n' > /etc/systemd/network/10-wol.link"
  },
  {
    "instruction": "Forcibly reconfigure all interfaces",
    "output": "networkctl reconfigure"
  },
  {
    "instruction": "Create bridge port config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBridge=br0\\n' > /etc/systemd/network/20-eth0-bridge-member.network"
  },
  {
    "instruction": "Create a network for VLAN tagged interface",
    "output": "printf '[Match]\\nName=eth0.10\\n[Network]\\nDHCP=ipv4\\n' > /etc/systemd/network/10-vlan-interface.network"
  },
  {
    "instruction": "Set networkd to ignore carrier loss",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nUnmanaged=yes\\n' > /etc/systemd/network/10-unmanaged.network"
  },
  {
    "instruction": "Show all networkd config files",
    "output": "ls /etc/systemd/network/"
  },
  {
    "instruction": "Set bond primary slave",
    "output": "printf '[Bond]\\nPrimarySlave=eth0\\n' > /etc/systemd/network/10-bond-primary.netdev"
  },
  {
    "instruction": "Configure IPv6 on interface",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nIPv6AcceptRA=yes\\nAddress=2001:db8::1/64\\nGateway=2001:db8::ff\\n' > /etc/systemd/network/10-ipv6.network"
  },
  {
    "instruction": "Show link operational state",
    "output": "networkctl status eth0 --no-pager"
  },
  {
    "instruction": "Configure DHCP use DNS from DHCP server",
    "output": "printf '[DHCPv4]\\nUseDNS=true\\n' > /etc/systemd/network/10-dhcp-dns.network"
  },
  {
    "instruction": "Create a bond netdev config",
    "output": "printf '[NetDev]\\nName=bond0\\nKind=bond\\n[Bond]\\nMode=802.3ad\\nMIIMonitorSec=1s\\n' > /etc/systemd/network/10-bond0.netdev"
  }
]