    "output": "go mod tidy"
  },
  {
    "instruction": "Create API with short names",
    "output": "operator-sdk create api --group apps --version v1 --kind MyApp --resource --controller --namespaced --plural myapps"
  },
  {
    "instruction": "Deploy operator",
    "output": "make deploy IMG=my-registry/my-operator:v1"
  },
  {
