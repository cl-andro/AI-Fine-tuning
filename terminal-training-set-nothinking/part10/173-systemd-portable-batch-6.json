[
  {
    "instruction": "Attach a portable image with specific profile",
    "output": "portablectl attach --profile=trusted /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach portable image without copying",
    "output": "portablectl attach --copy=none /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Check portablectl version",
    "output": "portablectl --version"
  },
  {
    "instruction": "List only attached portable images",
    "output": "portablectl list --attached"
  },
  {
    "instruction": "Spawn shell inside portable image context",
    "output": "systemd-run --portable=/var/lib/portable/myapp.raw -t /bin/bash"
  },
  {
    "instruction": "Check if a portable image is currently attached",
    "output": "portablectl list | grep myapp"
  },
  {
    "instruction": "Check status of portable service after attach",
    "output": "systemctl status myapp.service"
  },
  {
    "instruction": "Attach a portable image",
    "output": "portablectl attach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Compare portable image content",
    "output": "unsquashfs -s /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Read os-release from portable image",
    "output": "unsquashfs -cat /var/lib/portable/myapp.raw etc/os-release"
  },
  {
    "instruction": "Reattach portable to refresh units",
    "output": "portablectl reattach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Run portable service and check isolation",
    "output": "systemd-run --unit=test --portable=/var/lib/portable/myapp.raw /usr/bin/myapp"
  },
  {
    "instruction": "Enable and start portable daemon",
    "output": "systemctl enable --now systemd-portabled.service"
  },
  {
    "instruction": "Check documentation for portable services",
    "output": "less /usr/share/doc/systemd/portable.html 2>/dev/null || echo 'systemd-portable docs'"
  },
  {
    "instruction": "Show portable image OS release info",
    "output": "unsquashfs -l /var/lib/portable/myapp.raw etc/os-release 2>/dev/null; echo 'check inside image'"
  },
  {
    "instruction": "Check systemd portable service status",
    "output": "systemctl is-active systemd-portabled.service"
  },
  {
    "instruction": "Start a portable service",
    "output": "systemctl start myapp.service"
  },
  {
    "instruction": "Inspect portable image with extended info",
    "output": "portablectl inspect --full /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Create a minimal portable image directory",
    "output": "mkdir -p /var/lib/portable/myapp/usr/bin /var/lib/portable/myapp/lib/systemd/system"
  },
  {
    "instruction": "Force detach portable service",
    "output": "portablectl detach --now myapp"
  },
  {
    "instruction": "List files in portable image",
    "output": "unsquashfs -ll /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Create portable image with os-release",
    "output": "mkdir -p /tmp/portable-build/usr/lib && echo 'ID=myapp\nVERSION_ID=1.0' > /tmp/portable-build/usr/lib/os-release && mksquashfs /tmp/portable-build /var/lib/portable/myapp.raw"
  }
]