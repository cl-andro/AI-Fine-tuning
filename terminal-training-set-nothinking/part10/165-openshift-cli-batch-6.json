[
  {
    "instruction": "Get services",
    "output": "oc get svc -n my-project"
  },
  {
    "instruction": "Process and apply a template",
    "output": "oc process -f template.yaml | oc apply -f -"
  },
  {
    "instruction": "View project info",
    "output": "oc describe project my-project"
  },
  {
    "instruction": "Set deployment env vars",
    "output": "oc set env deployment/my-app DATABASE_URL=postgres://..."
  },
  {
    "instruction": "Login to OpenShift cluster",
    "output": "oc login https://api.openshift.example.com:6443 -u admin -p password --insecure-skip-tls-verify"
  },
  {
    "instruction": "List operators",
    "output": "oc get operators -n openshift-operators"
  },
  {
    "instruction": "Create PVC",
    "output": "oc create pvc my-pvc --access-modes ReadWriteOnce --resources requests.storage=10Gi"
  },
  {
    "instruction": "Get cluster version",
    "output": "oc get clusterversion"
  },
  {
    "instruction": "Attach to running container",
    "output": "oc attach my-pod -c my-container -n my-project"
  },
  {
    "instruction": "Apply a file",
    "output": "oc apply -f deployment.yaml -n my-project"
  },
  {
    "instruction": "Start a build",
    "output": "oc start-build my-build -n my-project"
  },
  {
    "instruction": "Get routes",
    "output": "oc get routes -n my-project"
  },
  {
    "instruction": "Create secret",
    "output": "oc create secret generic app-secret --from-literal=password=test"
  },
  {
    "instruction": "List imagestreams",
    "output": "oc get imagestreams -n openshift"
  },
  {
    "instruction": "Adm manage node",
    "output": "oc adm manage-node my-node --schedulable=false"
  },
  {
    "instruction": "Remote shell into a pod",
    "output": "oc rsh my-pod -n my-project"
  },
  {
    "instruction": "Set deployment resources",
    "output": "oc set resources deployment my-app --limits cpu=500m,memory=1Gi"
  },
  {
    "instruction": "Describe node",
    "output": "oc describe node my-node"
  },
  {
    "instruction": "New app from Docker image",
    "output": "oc new-app --docker-image=nginx:latest --name=nginx-web"
  },
  {
    "instruction": "List cluster nodes",
    "output": "oc get nodes"
  },
  {
    "instruction": "Get current user",
    "output": "oc whoami"
  },
  {
    "instruction": "Cancel a build",
    "output": "oc cancel-build my-build-1 -n my-project"
  },
  {
    "instruction": "Get TLS secrets",
    "output": "oc get secrets --all-namespaces | grep tls"
  },
  {
    "instruction": "Create cronjob",
    "output": "oc create cronjob my-cron --image=busybox --schedule='*/5 * * * *' -- date"
  }
]