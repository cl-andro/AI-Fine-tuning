[
  {
    "instruction": "Show NVLink capabilities",
    "output": "nvidia-smi nvlink -c"
  },
  {
    "instruction": "Display GPU PCI Express link info",
    "output": "nvidia-smi -q -d PCIE"
  },
  {
    "instruction": "Unload nvidia kernel driver",
    "output": "sudo modprobe -r nvidia"
  },
  {
    "instruction": "Query GPU encoder and decoder sessions",
    "output": "nvidia-smi --query-gpu=encoder.stats.sessionCount,decoder.stats.sessionCount --format=csv"
  },
  {
    "instruction": "Destroy all MIG instances",
    "output": "nvidia-smi mig -dci"
  },
  {
    "instruction": "Display ECC mode for all GPUs",
    "output": "nvidia-smi --query-gpu=ecc.mode.current,ecc.errors.uncorrected.total --format=csv"
