[
  {"instruction": "Generate HTML report with custom title", "output": "goaccess access.log -a -o report.html --html-title='Site Analytics Q1 2025'"},
  {"instruction": "Set HTML report refresh rate", "output": "goaccess access.log --real-time-html --html-refresh=5 -o report.html"},
  {"instruction": "Use dark theme for HTML report", "output": "goaccess access.log -a -o report.html --html-prefs='{\"theme\":\"dark\"}'"},
  {"instruction": "Include chart visualizations in report", "output": "goaccess access.log -a -o report.html --html-prefs='{\"show-charts\":true}'"},
  {"instruction": "Enable legend in HTML graphs", "output": "goaccess access.log -a -o report.html --html-prefs='{\"show-legend\":true}'"},
  {"instruction": "Set custom number format", "output": "goaccess access.log -a -o report.html --html-prefs='{\"num-format\":\"en\"}'"},
  {"instruction": "Generate minified HTML report", "output": "goaccess access.log -a -o report.html --html-minify"},
  {"instruction": "Output JSON with pretty printing", "output": "goaccess access.log -a -o report.json --json-pretty-print"},
  {"instruction": "Output CSV with all columns", "output": "goaccess access.log -a -o report.csv --csv-delimiter=','"},
  {"instruction": "Set CSV delimiter to semicolon", "output": "goaccess access.log -a -o report.csv --csv-delimiter=';'"},
  {"instruction": "Generate TSV output", "output": "goaccess access.log -a -o report.tsv --csv-delimiter=$'\\t'"},
  {"instruction": "Export report to multiple formats", "output": "goaccess access.log -a -o report.html -o report.json"},
  {"instruction": "Redirect report to stdout", "output": "goaccess access.log -a -o - > report.html"},
  {"instruction": "Generate report with no timestamp columns", "output": "goaccess access.log -a -o report.html --no-timestamp"},
  {"instruction": "Use custom HTML template", "output": "goaccess access.log -a -o report.html --html-template=my_template.html"},
  {"instruction": "Set custom CSS for HTML report", "output": "goaccess access.log -a -o report.html --html-custom-css='body { font-family: monospace; }'"},
  {"instruction": "Generate printable HTML version", "output": "goaccess access.log -a -o report-print.html --html-prefs='{\"theme\":\"light\"}'"},
  {"instruction": "Embed GeoIP data directly in HTML", "output": "goaccess access.log --geoip-database=GeoLite2-City.mmdb -a -o report-geo.html"},
  {"instruction": "Create comprehensive report with all panels", "output": "goaccess access.log --enable-panel=* -a -o full-report.html"},
  {"instruction": "Generate report with bandwidth statistics", "output": "goaccess access.log --enable-panel=BANDWIDTH -a -o bandwidth-report.html"},
  {"instruction": "Create dashboard for mobile view", "output": "goaccess access.log --html-prefs='{\"mobile\":true}' -a -o mobile-report.html"}
]