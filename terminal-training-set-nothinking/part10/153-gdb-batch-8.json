[
  {"instruction": "Debug segmentation fault with backtrace", "output": "gdb -batch -ex run -ex bt -ex 'info registers' -ex quit ./crashing_program"},
  {"instruction": "Find null pointer dereference", "output": "gdb -batch -ex run -ex 'print *ptr' -ex bt ./crashing_program"},
  {"instruction": "Get full crash details", "output": "gdb -batch -ex run -ex 'bt full' -ex 'info locals' -ex quit ./crashing_program"},
  {"instruction": "Debug infinite loop with backtrace", "output": "gdb -batch -ex run -ex 'thread apply all bt' ./hanging_program"},
  {"instruction": "Attach to hung process and backtrace", "output": "gdb -batch -ex 'thread apply all bt' -p 1234"},
  {"instruction": "Debug memory corruption by watching pointer", "output": "gdb -ex 'watch *ptr' -ex run ./myprogram"},
  {"instruction": "Debug use-after-free with watchpoint", "output": "gdb -ex 'watch -location *ptr' -ex run ./myprogram"},
  {"instruction": "Debug heap corruption with MALLOC_CHECK_", "output": "MALLOC_CHECK_=3 gdb ./myprogram"},
  {"instruction": "Debug assertion failure", "output": "gdb -batch -ex run -ex bt -ex 'frame 0' -ex quit ./myprogram 2>&1"},
  {"instruction": "Debug buffer overflow with address sanitizer", "output": "gdb -ex run -ex bt ./myprogram 2>&1 | grep -E 'asan|sanitizer|overflow'"},
  {"instruction": "Debug race condition with breakpoints", "output": "gdb -ex 'break critical_section' -ex 'thread apply all bt' -p 1234"},
  {"instruction": "Find memory leak with gdb and breakpoints", "output": "gdb -ex 'break malloc' -ex 'commands' -ex 'print backtrace' -ex 'continue' -ex 'end' -ex run ./myprogram"},
  {"instruction": "Debug stack overflow", "output": "gdb -batch -ex run -ex 'bt full' ./stackoverflow 2>&1 | head -50"},
  {"instruction": "Track dangling pointer assignment", "output": "gdb -ex 'watch *ptr' -ex run ./myprogram"},
  {"instruction": "Debug double free with watchpoint", "output": "gdb -ex 'break free' -ex run -ex bt ./myprogram"},
  {"instruction": "Find uninitialized memory access", "output": "gdb -ex 'break main' -ex run -ex 'print myvar' -ex 'step' -ex 'print myvar' ./myprogram"},
  {"instruction": "Check for printf format string bug", "output": "gdb -ex 'break printf' -ex run -ex 'bt' ./myprogram"},
  {"instruction": "Debug crash in shared library function", "output": "gdb -batch -ex run -ex 'bt' -ex 'info sharedlibrary' ./myprogram"},
  {"instruction": "Find whether signal was cause of exit", "output": "gdb -batch -ex run -ex quit ./myprogram; echo 'Exit code:' $?; dmesg | tail -5 | grep -i segfault"},
  {"instruction": "Get floating point exception backtrace", "output": "gdb -batch -ex run -ex 'bt' -ex 'info registers' ./fpe_program"},
  {"instruction": "Trace SIGABRT from assert", "output": "gdb -batch -ex run -ex 'bt full' -ex 'frame 0' -ex 'print __abort_message' ./assert_program"},
  {"instruction": "Debug abort with full details", "output": "gdb -batch -ex run -ex 'bt full' -ex 'info registers' -ex 'disassemble $pc-20,$pc+20' ./aborting_program"}
