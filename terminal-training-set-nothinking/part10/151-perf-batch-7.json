[
  {"instruction": "Install perf on Debian", "output": "apt-get install -y linux-perf"},
  {"instruction": "Check if perf is available", "output": "perf --version"},
  {"instruction": "Reduce perf sampling freq restriction", "output": "echo 0 > /proc/sys/kernel/perf_event_max_sample_rate"},
  {"instruction": "Set perf max sample rate", "output": "echo 10000 > /proc/sys/kernel/perf_event_max_sample_rate"},
  {"instruction": "Allow perf for non-root users", "output": "echo 0 > /proc/sys/kernel/perf_event_paranoid"},
  {"instruction": "Set perf paranoid level", "output": "echo 2 > /proc/sys/kernel/perf_event_paranoid"},
  {"instruction": "Enable kernel profiling for perf", "output": "echo 0 > /proc/sys/kernel/kptr_restrict"},
  {"instruction": "Restore kernel pointer restriction", "output": "echo 1 > /proc/sys/kernel/kptr_restrict"},
  {"instruction": "Show available perf events", "output": "perf list | grep -i -E 'cache|cycle|instruc'"},
  {"instruction": "List hardware events", "output": "perf list hw"},
  {"instruction": "List software events", "output": "perf list sw"},
  {"instruction": "List cache events", "output": "perf list cache"},
  {"instruction": "List tracepoint events", "output": "perf list tracepoint"},
  {"instruction": "List all PMU events", "output": "perf list pmu"},
  {"instruction": "List raw hardware events", "output": "perf list raw"},
  {"instruction": "Show perf event details", "output": "perf list -v cycles"},
  {"instruction": "Show perf list with descriptions", "output": "perf list --desc"},
  {"instruction": "List perf metric groups", "output": "perf list metric"},
  {"instruction": "Check system for PMU support", "output": "ls /sys/bus/event_source/devices/"},
  {"instruction": "Show CPU PMU capabilities", "output": "cat /sys/bus/event_source/devices/cpu/caps"},
  {"instruction": "Show perf event format", "output": "cat /sys/bus/event_source/devices/cpu/format/*"},
  {"instruction": "Check perf_event_paranoid setting", "output": "cat /proc/sys/kernel/perf_event_paranoid"}
]