[
  {"instruction": "Show bpftool version", "output": "bpftool --version"},
  {"instruction": "List all BPF programs with details", "output": "bpftool prog list --json"},
  {"instruction": "Show BPF program by ID", "output": "bpftool prog show id 42"},
  {"instruction": "Pin a BPF program to BPF filesystem", "output": "bpftool prog pin id 42 /sys/fs/bpf/my_prog"},
  {"instruction": "List BPF maps", "output": "bpftool map list"},
  {"instruction": "Show BPF map contents", "output": "bpftool map dump id 1"},
  {"instruction": "Create new BPF map", "output": "bpftool map create /sys/fs/bpf/my_map type hash key 8 value 8 entries 1024 name my_map"},
  {"instruction": "Update BPF map entry", "output": "bpftool map update id 1 key 0x00 0x01 0x02 0x03 value 0x0a 0x0b 0x0c 0x0d"},
  {"instruction": "Delete BPF map entry", "output": "bpftool map delete id 1 key 0x00 0x01 0x02 0x03"},
  {"instruction": "Show BPF map by name", "output": "bpftool map show name my_map"},
  {"instruction": "List all BPF links (attachments)", "output": "bpftool link list"},
  {"instruction": "Show BPF link by ID", "output": "bpftool link show id 5"},
  {"instruction": "List BPF iterators", "output": "bpftool iter list"},
  {"instruction": "Show BPF program pinned in filesystem", "output": "bpftool prog show pinned /sys/fs/bpf/my_prog"},
  {"instruction": "Detach BPF program from net device", "output": "bpftool net detach xdp dev eth0"},
  {"instruction": "Attach XDP BPF program to interface", "output": "bpftool net attach xdp id 42 dev eth0"},
  {"instruction": "Show BPF feature flags", "output": "bpftool feature"},
  {"instruction": "Show kernel BPF JIT compiler status", "output": "bpftool feature | grep -i jit"},
  {"instruction": "Display BPF program tag info", "output": "bpftool prog show id 42 | grep tag"},
  {"instruction": "Show BPF program run time stats", "output": "bpftool prog profile id 42 duration 10"},
  {"instruction": "Show network-attached BPF programs", "output": "bpftool net list"},
  {"instruction": "Monitor BPF trace pipe output", "output": "cat /sys/kernel/debug/tracing/trace_pipe | bpftool"}
]