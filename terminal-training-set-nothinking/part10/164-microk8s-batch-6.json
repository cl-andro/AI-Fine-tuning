[
  {
    "instruction": "MicroK8s kubectl top pods",
    "output": "microk8s kubectl top pods --all-namespaces"
  },
  {
    "instruction": "Get MicroK8s cluster info",
    "output": "microk8s kubectl cluster-info"
  },
  {
    "instruction": "Deploy with kubectl",
    "output": "microk8s kubectl apply -f deployment.yaml"
  },
  {
    "instruction": "Start MicroK8s",
    "output": "microk8s start"
  },
  {
    "instruction": "Disable dashboard",
    "output": "microk8s disable dashboard"
  },
  {
    "instruction": "MicroK8s kubectl logs",
    "output": "microk8s kubectl logs -n default deployment/nginx"
  },
  {
    "instruction": "MicroK8s kubectl get nodes",
    "output": "microk8s kubectl get nodes -o wide"
  },
  {
    "instruction": "Enable Helm3",
    "output": "microk8s enable helm3"
  },
  {
    "instruction": "Enable DNS addon",
    "output": "microk8s enable dns"
  },
  {
    "instruction": "Enable GPU support",
    "output": "microk8s enable gpu"
  },
  {
    "instruction": "View dashboard token",
    "output": "microk8s kubectl describe secret -n kube-system microk8s-dashboard-token"
  },
  {
    "instruction": "Refresh MicroK8s status",
    "output": "microk8s status --wait-ready --timeout 30"
  },
  {
    "instruction": "Enable Knative",
    "output": "microk8s enable knative"
  },
  {
    "instruction": "MicroK8s kubectl expose deployment",
    "output": "microk8s kubectl expose deployment nginx --port 80 --type NodePort"
  },
  {
    "instruction": "MicroK8s kubectl exec",
    "output": "microk8s kubectl exec -it my-pod -- /bin/bash"
  },
  {
    "instruction": "Disable all addons",
    "output": "microk8s disable dns dashboard storage ingress metallb registry"
  },
  {
    "instruction": "MicroK8s kubectl describe pod",
    "output": "microk8s kubectl describe pod my-pod"
  },
  {
    "instruction": "Enable registry addon",
    "output": "microk8s enable registry"
  },
  {
    "instruction": "Join with comma-separated addresses",
    "output": "microk8s join 192.168.1.10:25000/abc123,192.168.1.11:25000/abc123"
  },
  {
    "instruction": "Enable community addons",
    "output": "microk8s enable community"
  }
