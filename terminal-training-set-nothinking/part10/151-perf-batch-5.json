[
  {"instruction": "Capture system-wide CPU profile for flamegraph", "output": "perf record -F 99 -a -g --call-graph dwarf -- sleep 60"},
  {"instruction": "Generate flamegraph from perf data", "output": "perf script | /opt/FlameGraph/stackcollapse-perf.pl | /opt/FlameGraph/flamegraph.pl > flamegraph.svg"},
  {"instruction": "Profile specific process for 30 seconds", "output": "perf record -F 99 -p 1234 -g -- sleep 30"},
  {"instruction": "Profile with LBR (Last Branch Record)", "output": "perf record -b -a sleep 10"},
  {"instruction": "Profile with mem load/store sampling", "output": "perf mem record -a sleep 10"},
  {"instruction": "Report memory access sampling", "output": "perf mem report --stdio"},
  {"instruction": "Profile data TLB misses", "output": "perf stat -e dTLB-load-misses,dTLB-store-misses -a sleep 5"},
  {"instruction": "Profile instruction TLB misses", "output": "perf stat -e iTLB-load-misses -a sleep 5"},
  {"instruction": "Profile node loads and stores", "output": "perf stat -e node-loads,node-stores -a sleep 5"},
  {"instruction": "Profile front-end and back-end stalls", "output": "perf stat -e stalled-cycles-frontend,stalled-cycles-backend -a sleep 5"},
  {"instruction": "Measure branch prediction accuracy", "output": "perf stat -e branches,branch-misses -a sleep 5"},
  {"instruction": "Profile L1 data cache stores", "output": "perf stat -e L1-dcache-stores -a sleep 5"},
  {"instruction": "Profile L1 instruction cache misses", "output": "perf stat -e L1-icache-loads,L1-icache-misses -a sleep 5"},
  {"instruction": "Measure LLC prefetch misses", "output": "perf stat -e LLC-prefetch-misses -a sleep 5"},
  {"instruction": "Profile topology metrics", "output": "perf stat -M TopdownL1 -a sleep 5"},
  {"instruction": "Measure SMT (hyper-threading) metrics", "output": "perf stat -M smt -a sleep 5"},
  {"instruction": "Profile with PEBS precise store", "output": "perf record -e mem-stores:ppp -a sleep 10"},
  {"instruction": "Profile with data address profiling", "output": "perf record -e mem-loads:ppp -a -- sleep 10"},
  {"instruction": "Measure FP operations", "output": "perf stat -e fp_arith_inst_retired.256b_packed_single -a sleep 5"},
  {"instruction": "Profile vector operations", "output": "perf stat -e avx_insts.all -a sleep 5"},
  {"instruction": "Measure TLB shootdowns", "output": "perf stat -e tlb:tlb_flush -a sleep 5"},
  {"instruction": "Profile system calls per second", "output": "perf stat -e raw_syscalls:sys_enter -a sleep 5"}
]