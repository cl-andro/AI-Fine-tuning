[
  {
    "instruction": "Set number of hugepages to 1024",
    "output": "echo 1024 | sudo tee /proc/sys/vm/nr_hugepages"
  },
  {
    "instruction": "List available hugepage sizes",
    "output": "ls /sys/kernel/mm/hugepages/"
  },
  {
    "instruction": "Show system hugepage usage summary from meminfo",
    "output": "cat /proc/meminfo | grep -E '^Huge'"
  },
  {
    "instruction": "Display Hugetlb value in megabytes",
    "output": "awk '/Hugetlb/ {printf \"%.0f MB\\n\", $2/1024}' /proc/meminfo"
  },
  {
    "instruction": "Check overcommit hugepages value",
    "output": "cat /proc/sys/vm/nr_overcommit_hugepages"
  },
  {
    "instruction": "View THP PMD size",
    "output": "cat /sys/kernel/mm/transparent_hugepage/hpage_pmd_size"
  },
  {
    "instruction": "Set khugepaged scan rate to 4096 pages",
    "output": "echo 4096 | sudo tee /sys/kernel/mm/transparent_hugepage/khugepaged/pages_to_scan"
  },
  {
    "instruction": "Set overcommit hugepages to 256",
    "output": "echo 256 | sudo tee /proc/sys/vm/nr_overcommit_hugepages"
  },
  {
    "instruction": "List all hugepage filesystem mounts",
    "output": "mount -t hugetlbfs"
  },
  {
    "instruction": "Display memory info for huge and total fields",
    "output": "cat /proc/meminfo | grep -E '^(MemTotal|MemFree|Huge)'"
  },
  {
    "instruction": "Mount hugetlbfs at /dev/hugepages",
    "output": "sudo mount -t hugetlbfs hugetlbfs /dev/hugepages"
  },
  {
    "instruction": "Check NUMA node 0 hugepage count",
    "output": "cat /sys/devices/system/node/node0/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Set hugetlb SHM group to GID 1000",
    "output": "echo 1000 | sudo tee /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "View NUMA node hugepage distribution per node directory",
    "output": "for n in /sys/devices/system/node/node*/hugepages; do echo \"$n: $(cat $n/hugepages-2048kB/nr_hugepages 2>/dev/null)\"; done"
  },
  {
    "instruction": "Check if THP supports shmem",
    "output": "cat /sys/kernel/mm/transparent_hugepage/shmem_enabled"
  },
  {
    "instruction": "Check THP defragmentation settings",
    "output": "cat /sys/kernel/mm/transparent_hugepage/defrag"
  },
  {
    "instruction": "Show hugepage statistics from memory info",
    "output": "grep -i huge /proc/meminfo"
  },
  {
    "instruction": "Check THP max_ptes_none value",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/max_ptes_none"
  },
  {
    "instruction": "Check transparent hugepage mode",
    "output": "cat /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "Check current nr_hugepages value",
    "output": "cat /proc/sys/vm/nr_hugepages"
  }
]