[
  {"instruction": "Use perf c2c for cache coherence analysis", "output": "perf c2c record -a sleep 30"},
  {"instruction": "Report cache coherence data", "output": "perf c2c report --stdio"},
  {"instruction": "Use perf kmem for slab allocator analysis", "output": "perf kmem record -a sleep 10"},
  {"instruction": "Report kernel memory allocation", "output": "perf kmem stat --stdioc"},
  {"instruction": "Use perf kvm for guest analysis", "output": "perf kvm stat live"},
  {"instruction": "Record kvm guest events", "output": "perf kvm record -p 1234 -a sleep 10"},
  {"instruction": "Report kvm events", "output": "perf kvm stat report --stdio"},
  {"instruction": "Use perf lock for lock analysis", "output": "perf lock record -a sleep 10"},
  {"instruction": "Report kernel lock contention", "output": "perf lock report --stdio"},
  {"instruction": "Show lock contention info", "output": "perf lock info --stdio"},
  {"instruction": "Use perf sched for scheduler analysis", "output": "perf sched record -a sleep 10"},
  {"instruction": "Report scheduler latency", "output": "perf sched latency --stdio"},
  {"instruction": "Show scheduler map", "output": "perf sched map --stdio"},
  {"instruction": "Display scheduler timehist", "output": "perf sched timehist --stdio"},
  {"instruction": "Show scheduler replay", "output": "perf sched replay --stdio"},
  {"instruction": "Use perf timechart", "output": "perf timechart record -a sleep 10"},
  {"instruction": "Generate timechart SVG", "output": "perf timechart -i perf.data -o timechart.svg"},
  {"instruction": "Use perf probe to add dynamic probes", "output": "perf probe --add 'do_sys_open filename:string'"},
  {"instruction": "List all perf probes", "output": "perf probe --list"},
  {"instruction": "Remove a perf probe", "output": "perf probe --del do_sys_open"},
  {"instruction": "Add probe with line number", "output": "perf probe -x /usr/bin/nginx 'main:10 http_request'"},
  {"instruction": "Trace using perf probe", "output": "perf record -e probe:do_sys_open -a sleep 10"}
