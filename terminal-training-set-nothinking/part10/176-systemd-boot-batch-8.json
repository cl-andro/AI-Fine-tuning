[
  {
    "instruction": "Check initramfs generation after kernel add",
    "output": "ls -lh /boot/initrd.img-*"
  },
  {
    "instruction": "View a boot loader entry file",
    "output": "cat /boot/loader/entries/6.1.0-13-amd64.conf"
  },
  {
    "instruction": "Remove a kernel via kernel-install",
    "output": "kernel-install remove 6.1.0-13-amd64"
  },
  {
    "instruction": "Show boot loader menu timeout",
    "output": "bootctl status | grep -i timeout"
  },
  {
    "instruction": "Rebuild initramfs for specific kernel",
    "output": "update-initramfs -k 6.1.0-13-amd64 -u"
  },
  {
    "instruction": "Check kernel-install layout",
    "output": "ls /boot/*/"
  },
  {
    "instruction": "Add kernel with kernel-install and all plugins",
    "output": "kernel-install add 6.1.0-14-amd64 /boot/vmlinuz-6.1.0-14-amd64"
  },
  {
    "instruction": "Check if secure boot is enabled",
    "output": "mokutil --sb-state"
  },
  {
    "instruction": "Set console mode in loader.conf",
    "output": "printf 'console-mode 1\\n' >> /boot/loader/loader.conf"
  },
  {
    "instruction": "Check EFI variables",
    "output": "efibootmgr"
  },
  {
    "instruction": "View UKI file information",
    "output": "objdump -h /boot/efi/EFI/Linux/my-uki.efi 2>/dev/null | head -20"
  },
  {
    "instruction": "Show systemd-boot random seed status",
    "output": "bootctl random-seed"
  },
  {
    "instruction": "View boot entries with full details",
    "output": "bootctl list --all"
  },
  {
    "instruction": "List boot loader entry files",
    "output": "ls /boot/loader/entries/"
  },
  {
    "instruction": "Set default entry in loader.conf",
    "output": "printf 'default @current\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "Show boot loader random seed",
    "output": "cat /boot/loader/random-seed 2>/dev/null; echo '(if exists)'"
  },
  {
    "instruction": "Set current kernel as default",
    "output": "bootctl set @current"
  },
  {
    "instruction": "Set boot loader entry-whitelist",
    "output": "printf 'entry-whitelist custom\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "Update bootloader files only",
    "output": "bootctl update --graceful"
  },
  {
    "instruction": "Check bootctl installation path",
    "output": "bootctl --print-esp-path"
  },
  {
    "instruction": "Edit loader.conf to add editor option",
    "output": "printf 'editor no\\n' >> /boot/loader/loader.conf"
  },
  {
    "instruction": "Check systemd-boot build ID",
    "output": "bootctl status | grep -i firmware"
  },
  {
    "instruction": "List all installed kernels",
    "output": "ls /boot/vmlinuz-*"
  },
  {
    "instruction": "View boot loader configuration",
    "output": "cat /boot/loader/loader.conf"
  }
]