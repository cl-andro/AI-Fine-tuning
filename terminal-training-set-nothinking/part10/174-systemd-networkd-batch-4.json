[
  {
    "instruction": "Create network config with multiple addresses",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nAddress=192.168.1.10/24\\nAddress=10.0.0.10/24\\n' > /etc/systemd/network/10-multi-ip.network"
  },
  {
    "instruction": "Enable networkd at boot",
    "output": "systemctl enable systemd-networkd"
  },
  {
    "instruction": "Set DHCP lease timeout",
    "output": "printf '[DHCPv4]\\nMaxAttempts=10\\n' > /etc/systemd/network/10-dhcp-timeout.network"
  },
  {
    "instruction": "List all network links",
    "output": "networkctl list"
  },
  {
    "instruction": "Create a VLAN netdev",
    "output": "printf '[NetDev]\\nName=vlan10\\nKind=vlan\\n[VLAN]\\nId=10\\n' > /etc/systemd/network/15-vlan10.netdev"
  },
  {
    "instruction": "Create bond member config for eth0",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/20-eth0-bond-member.network"
  },
  {
    "instruction": "Create network config with DNS server list",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=no\\nDNS=8.8.8.8\\nDNS=1.1.1.1\\nAddress=192.168.1.10/24\\nGateway=192.168.1.1\\n' > /etc/systemd/network/10-static-dns.network"
  },
  {
    "instruction": "Create a VXLAN netdev",
    "output": "printf '[NetDev]\\nName=vxlan100\\nKind=vxlan\\n[VXLAN]\\nId=100\\nRemote=10.0.0.1\\n' > /etc/systemd/network/15-vxlan.netdev"
  },
  {
    "instruction": "Create bridge port config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBridge=br0\\n' > /etc/systemd/network/20-eth0-bridge-member.network"
  },
  {
    "instruction": "Configure interface MTU",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nMTUBytes=9000\\n' > /etc/systemd/network/10-mtu.network"
  },
  {
    "instruction": "Configure interface speed and duplex",
    "output": "printf '[Link]\\nSpeedBytesPerSec=1G\\nDuplex=full\\n' > /etc/systemd/network/10-speed-duplex.link"
  },
  {
    "instruction": "List all link config files",
    "output": "ls /etc/systemd/network/*.link"
  },
  {
    "instruction": "Check networkd service status",
    "output": "systemctl status systemd-networkd"
  },
  {
    "instruction": "List all netdev config files",
    "output": "ls /etc/systemd/network/*.netdev"
  },
  {
    "instruction": "Restart networkd service",
    "output": "systemctl restart systemd-networkd"
  },
  {
    "instruction": "Create a bond netdev config",
    "output": "printf '[NetDev]\\nName=bond0\\nKind=bond\\n[Bond]\\nMode=802.3ad\\nMIIMonitorSec=1s\\n' > /etc/systemd/network/10-bond0.netdev"
  },
  {
    "instruction": "Forcibly reconfigure all interfaces",
    "output": "networkctl reconfigure"
  },
  {
    "instruction": "Configure DHCP use NTP from server",
    "output": "printf '[DHCPv4]\\nUseNTP=true\\n' > /etc/systemd/network/10-dhcp-ntp.network"
  },
  {
    "instruction": "Set DHCP server on network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCPServer=yes\\n' > /etc/systemd/network/10-dhcp-server.network"
  },
  {
    "instruction": "Display link LLDP neighbors",
    "output": "networkctl lldp"
  },
  {
    "instruction": "Configure IPv6 on interface",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nIPv6AcceptRA=yes\\nAddress=2001:db8::1/64\\nGateway=2001:db8::ff\\n' > /etc/systemd/network/10-ipv6.network"
  },
  {
    "instruction": "Configure DHCP with hostname",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=ipv4\\n[DHCPv4]\\nHostname=myhost\\n' > /etc/systemd/network/10-dhcp-hostname.network"
  }
]