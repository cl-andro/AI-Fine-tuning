[
  {
    "instruction": "Check status of portable service after attach",
    "output": "systemctl status myapp.service"
  },
  {
    "instruction": "Attach portable with read-only root",
    "output": "portablectl attach --property=ProtectSystem=yes /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Show help for portablectl",
    "output": "portablectl --help"
  },
  {
    "instruction": "Run portable service and check isolation",
    "output": "systemd-run --unit=test --portable=/var/lib/portable/myapp.raw /usr/bin/myapp"
  },
  {
    "instruction": "Detach portable image by image path",
    "output": "portablectl detach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Check status of a portable service unit",
    "output": "systemctl status systemd-portabled.service"
  },
  {
    "instruction": "Verify portable image is valid OS",
    "output": "test -f /var/lib/portable/myapp.raw && unsquashfs -l /var/lib/portable/myapp.raw usr/lib/os-release 2>/dev/null && echo 'Valid'"
  },
  {
    "instruction": "Set memory limit on portable service",
    "output": "systemctl set-property myapp.service MemoryMax=256M"
  },
  {
    "instruction": "Detach a portable service",
    "output": "portablectl detach myapp"
  },
  {
    "instruction": "Copy portable service unit for modifications",
    "output": "portablectl attach --copy=auto --force /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Inspect portable image with extended info",
    "output": "portablectl inspect --full /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Compare portable image content",
    "output": "unsquashfs -s /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Create squashed portable image from directory",
    "output": "mksquashfs /var/lib/portable/myapp /var/lib/portable/myapp.raw -noappend"
  },
  {
    "instruction": "Check portablectl version",
    "output": "portablectl --version"
  },
  {
    "instruction": "Attach portable with network namespace bind",
    "output": "portablectl attach --property=PrivateNetwork=yes /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Place service unit in portable image",
    "output": "mkdir -p /var/lib/portable/myapp/lib/systemd/system && printf '[Service]\\nExecStart=/usr/bin/myapp\\n' > /var/lib/portable/myapp/lib/systemd/system/myapp.service"
  },
  {
    "instruction": "Detach multiple portable images at once",
    "output": "portablectl detach app1 app2"
  },
  {
    "instruction": "Attach portable with no profile validation",
    "output": "portablectl attach --profile=untrusted /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach a portable image with specific profile",
    "output": "portablectl attach --profile=trusted /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "List only attached portable images",
    "output": "portablectl list --attached"
  },
  {
    "instruction": "Attach multiple portable images at once",
    "output": "portablectl attach /var/lib/portable/app1.raw /var/lib/portable/app2.raw"
  },
  {
    "instruction": "Start a portable service",
    "output": "systemctl start myapp.service"
  },
  {
    "instruction": "Spawn shell inside portable image context",
    "output": "systemd-run --portable=/var/lib/portable/myapp.raw -t /bin/bash"
  },
  {
    "instruction": "Check systemd portable service status",
    "output": "systemctl is-active systemd-portabled.service"
  }
]