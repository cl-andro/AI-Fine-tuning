[
  {
    "instruction": "List system timers",
    "output": "systemctl list-timers"
  },
  {
    "instruction": "List system targets",
    "output": "systemctl list-units --type=target"
  },
  {
    "instruction": "List device units",
    "output": "systemctl list-units --type=device"
  },
  {
    "instruction": "List enabled and disabled service unit files",
    "output": "systemctl list-unit-files --type=service --state=enabled,disabled"
  },
  {
    "instruction": "Dump full systemd manager state",
    "output": "systemctl dump"
  },
  {
    "instruction": "Edit unit file directly as full file",
    "output": "systemctl edit --full nginx.service"
  },
  {
    "instruction": "Enable and start service immediately",
    "output": "systemctl enable --now nginx.service"
  },
  {
    "instruction": "Set CPU shares property on a unit",
    "output": "systemctl set-property nginx.service CPUShares=512"
  },
  {
    "instruction": "List mount units",
    "output": "systemctl list-units --type=mount"
  },
  {
    "instruction": "List scope units",
    "output": "systemctl list-units --type=scope"
  },
  {
    "instruction": "List unit files matching ssh pattern",
    "output": "systemctl list-unit-files 'ssh*'"
  },
  {
    "instruction": "Start a service immediately",
    "output": "systemctl start nginx.service"
  },
  {
    "instruction": "Show specific property of a unit",
    "output": "systemctl show -p ConditionPathExists nginx.service"
  },
  {
    "instruction": "List static unit files",
    "output": "systemctl list-unit-files --state=static"
  },
  {
    "instruction": "List runtime systemd units",
    "output": "ls /run/systemd/system/"
  },
  {
    "instruction": "List all loaded service units",
    "output": "systemctl list-units --type=service"
  },
  {
    "instruction": "Check if service is active",
    "output": "systemctl is-active nginx.service"
  },
  {
    "instruction": "Send signal to a service process",
    "output": "systemctl kill -s HUP nginx.service"
  },
  {
    "instruction": "List all unit files by state and type",
    "output": "systemctl list-unit-files --type=service --state=indirect,generated"
  },
  {
    "instruction": "List all installed unit files",
    "output": "systemctl list-unit-files"
  }
]