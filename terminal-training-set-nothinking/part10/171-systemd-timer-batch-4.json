[
  {
    "instruction": "Analyze specific timestamp",
    "output": "systemd-analyze timestamp '2024-01-01 00:00:00'"
  },
  {
    "instruction": "List disabled timer unit files",
    "output": "systemctl list-unit-files --type=timer --state=disabled"
  },
  {
    "instruction": "List reverse dependencies of a timer",
    "output": "systemctl list-dependencies --reverse backup.timer"
  },
  {
    "instruction": "Create a transient timer for midnight echo",
    "output": "systemd-run --on-calendar='*-*-* 00:00:00' systemd-cat echo \"midnight\""
  },
  {
    "instruction": "Check if timer is enabled",
    "output": "systemctl is-enabled backup.timer"
  },
  {
    "instruction": "List elapsed timers",
    "output": "systemctl list-timers --state=elapsed"
  },
  {
    "instruction": "Create transient timer with custom unit name",
    "output": "systemd-run --unit=custom --on-calendar='*-*-* *:00:00' /usr/bin/custom-script.sh"
  },
  {
    "instruction": "View journal for timer-triggered service",
    "output": "journalctl -u backup.service"
  },
  {
    "instruction": "Create timer with randomized delay",
    "output": "systemd-run --on-calendar='daily' --timer-property=RandomizedDelaySec=1h /usr/bin/random-backup.sh"
  },
  {
    "instruction": "Kill a timer unit",
    "output": "systemctl kill -s HUP backup.timer"
  },
  {
    "instruction": "Run a command 1 hour after unit activates",
    "output": "systemd-run --on-unit-active=1h /usr/bin/hourly.sh"
  },
  {
    "instruction": "Analyze hourly calendar expression",
    "output": "systemd-analyze calendar 'hourly'"
  },
  {
    "instruction": "Analyze custom calendar: first of month at 4 AM",
    "output": "systemd-analyze calendar '*-*-01 04:00:00'"
  },
  {
    "instruction": "Show all timer properties",
    "output": "systemctl show backup.timer"
  },
  {
    "instruction": "Create timer for every 6 hours",
    "output": "systemd-run --on-calendar='*-*-* */6:00:00' /usr/bin/every-6-hours.sh"
  },
  {
    "instruction": "List vendor timer unit files",
    "output": "ls /lib/systemd/system/*.timer"
  },
  {
    "instruction": "Check timer status",
    "output": "systemctl status backup.timer"
  },
  {
    "instruction": "Reload daemon after timer file changes",
    "output": "systemctl daemon-reload"
  },
  {
    "instruction": "Analyze weekly calendar expression",
    "output": "systemd-analyze calendar 'weekly'"
  },
  {
    "instruction": "Create override for timer schedule",
    "output": "printf '[Timer]\\nOnCalendar=*-*-* 04:00:00\\n' | sudo tee /etc/systemd/system/backup.timer.d/override.conf"
  },
  {
    "instruction": "Create timer that fires every 15 minutes",
    "output": "systemd-run --on-active=15m --unit=quarterly /usr/bin/quarterly-check.sh"
  },
  {
    "instruction": "Show monotonic timer elapse from boot",
    "output": "systemctl show -p NextElapseUSecMonotonic backup.timer"
  },
  {
    "instruction": "Mask a timer",
    "output": "systemctl mask backup.timer"
  }
]