[
  {
    "instruction": "Attach a portable image",
    "output": "portablectl attach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Spawn shell inside portable image context",
    "output": "systemd-run --portable=/var/lib/portable/myapp.raw -t /bin/bash"
  },
  {
    "instruction": "Read os-release from portable image",
    "output": "unsquashfs -cat /var/lib/portable/myapp.raw etc/os-release"
  },
  {
    "instruction": "Copy portable service unit for modifications",
    "output": "portablectl attach --copy=auto --force /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach with runtime symlinks only",
    "output": "portablectl attach --copy=copy /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach portable with specific env variables",
    "output": "portablectl attach --property=Environment=FOO=bar /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Force detach portable service",
    "output": "portablectl detach --now myapp"
  },
  {
    "instruction": "Attach multiple portable images at once",
    "output": "portablectl attach /var/lib/portable/app1.raw /var/lib/portable/app2.raw"
  },
  {
    "instruction": "List all portable services",
    "output": "portablectl list"
  },
  {
    "instruction": "Check journal for portable service",
    "output": "journalctl -u myapp.service"
  },
  {
    "instruction": "List portable images directory",
    "output": "ls /var/lib/portable/"
  },
  {
    "instruction": "Check portablectl version",
    "output": "portablectl --version"
  },
  {
    "instruction": "Check documentation for portable services",
    "output": "less /usr/share/doc/systemd/portable.html 2>/dev/null || echo 'systemd-portable docs'"
  },
  {
    "instruction": "Inspect a portable image",
    "output": "portablectl inspect /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Check portable image size",
    "output": "ls -lh /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Compare portable image content",
    "output": "unsquashfs -s /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Enable portable daemon at boot",
    "output": "systemctl enable systemd-portabled"
  },
  {
    "instruction": "Attach portable with read-only root",
    "output": "portablectl attach --property=ProtectSystem=yes /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Check status of a portable service unit",
    "output": "systemctl status systemd-portabled.service"
  },
  {
    "instruction": "Create a minimal portable image directory",
    "output": "mkdir -p /var/lib/portable/myapp/usr/bin /var/lib/portable/myapp/lib/systemd/system"
  },
  {
    "instruction": "Attach portable image and copy to runtime",
    "output": "portablectl attach --copy=auto /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Create squashed portable image from directory",
    "output": "mksquashfs /var/lib/portable/myapp /var/lib/portable/myapp.raw -noappend"
  },
  {
    "instruction": "Reattach portable to refresh units",
    "output": "portablectl reattach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Detach a portable service",
    "output": "portablectl detach myapp"
  },
  {
    "instruction": "Create portable image with os-release",
    "output": "mkdir -p /tmp/portable-build/usr/lib && echo 'ID=myapp\nVERSION_ID=1.0' > /tmp/portable-build/usr/lib/os-release && mksquashfs /tmp/portable-build /var/lib/portable/myapp.raw"
  }
]