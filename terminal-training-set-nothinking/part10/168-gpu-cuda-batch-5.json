[
  {
    "instruction": "Show GPU process info with utilization",
    "output": "nvidia-smi pmon -c 1 -s u"
  },
  {
    "instruction": "Show GPU topology in CPU affinity format",
    "output": "nvidia-smi topo -m -c"
  },
  {
    "instruction": "Launch Python training on GPU 0 and 1",
    "output": "CUDA_VISIBLE_DEVICES=0,1 python train.py"
  },
  {
    "instruction": "Check if GPU persistence mode is enabled",
    "output": "nvidia-smi -q -d PERSISTENCE_MODE"
  },
  {
    "instruction": "Enable persistence mode on all GPUs",
    "output": "nvidia-smi -pm 1"
  },
  {
    "instruction": "List CUDA device files",
    "output": "ls /dev/nvidia*"
  },
  {
    "instruction": "Run training exclusively on GPU 1",
    "output": "CUDA_VISIBLE_DEVICES=1 python train.py"
  },
  {
    "instruction": "Show GPU compute mode",
    "output": "nvidia-smi --query-gpu=compute_mode --format=csv"
  },
  {
    "instruction": "Show nvidia driver version",
    "output": "nvidia-smi --query-gpu=driver_version --format=csv"
  },
  {
    "instruction": "Start nvidia-persistenced service",
    "output": "sudo systemctl start nvidia-persistenced"
  },
  {
    "instruction": "Query GPU serial number",
    "output": "nvidia-smi --query-gpu=serial --format=csv"
  },
  {
    "instruction": "Enable MIG mode on GPU 0",
    "output": "nvidia-smi -i 0 -mig 1"
  },
  {
    "instruction": "Query GPU retired pages info",
    "output": "nvidia-smi -q -d RETIRED_PAGES"
  },
  {
    "instruction": "Display GPU clock event reasons",
    "output": "nvidia-smi -q -d CLOCK_EVENT_REASONS"
  },
  {
    "instruction": "Display GPU topology matrix",
    "output": "nvidia-smi topo -m"
  },
  {
    "instruction": "Display GPU process monitor snapshot",
    "output": "nvidia-smi pmon -c 1"
  },
  {
    "instruction": "Generate Xorg configuration for nvidia",
    "output": "sudo nvidia-xconfig"
  },
  {
    "instruction": "Display GPU memory details",
    "output": "nvidia-smi -q -d MEMORY"
  },
  {
    "instruction": "List supported GPU clocks",
    "output": "nvidia-smi -q -d SUPPORTED_CLOCKS"
  },
  {
    "instruction": "Display GPU memory bandwidth info",
    "output": "nvidia-smi -q -d MEMORY | grep -i bandwidth"
  },
  {
    "instruction": "Reset GPU 0",
    "output": "nvidia-smi -r -i 0"
  },
  {
    "instruction": "Query GPU maximum clocks",
    "output": "nvidia-smi -q -d MAX_CLOCKS"
  },
  {
    "instruction": "Show GPU framebuffer memory usage",
    "output": "nvidia-smi --query-gpu=memory.total,memory.free,memory.used --format=csv"
  }
]