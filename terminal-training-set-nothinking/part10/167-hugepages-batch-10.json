[
  {
    "instruction": "Show hugepage statistics from memory info",
    "output": "grep -i huge /proc/meminfo"
  },
  {
    "instruction": "Display THP enabled and defrag modes together",
    "output": "for f in enabled defrag; do echo \"$f: $(cat /sys/kernel/mm/transparent_hugepage/$f)\"; done"
  },
  {
    "instruction": "Set hugetlb SHM group to GID 1000",
    "output": "echo 1000 | sudo tee /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "Check if process uses transparent hugepages via smaps",
    "output": "grep AnonHugePages /proc/1/smaps 2>/dev/null; echo 'check PID=1'"
  },
  {
    "instruction": "Enable transparent hugepages via sysfs",
    "output": "echo always | sudo tee /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "View hugetlb SHM group setting",
    "output": "cat /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "Set NUMA node 0 hugepages to 64",
    "output": "echo 64 | sudo tee /sys/devices/system/node/node0/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check 1GB hugepage count",
    "output": "cat /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"
  },
  {
    "instruction": "Mount hugetlbfs with 2MB page size",
    "output": "sudo mount -t hugetlbfs -o pagesize=2M hugetlbfs /mnt/huge"
  },
  {
    "instruction": "Check THP khugepaged pages_to_scan",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/pages_to_scan"
  },
  {
    "instruction": "Show system hugepage usage summary from meminfo",
    "output": "cat /proc/meminfo | grep -E '^Huge'"
  },
  {
    "instruction": "Check transparent hugepage mode",
    "output": "cat /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "Allocate 100 hugepages immediately",
    "output": "echo 100 | sudo tee /proc/sys/vm/nr_hugepages"
  },
  {
    "instruction": "Check hugepage and THP vmstat counters",
    "output": "cat /proc/vmstat | grep -E 'huge|thp'"
  },
  {
    "instruction": "Disable THP defragmentation",
    "output": "echo never | sudo tee /sys/kernel/mm/transparent_hugepage/defrag"
  },
  {
    "instruction": "Check if THP supports shmem",
    "output": "cat /sys/kernel/mm/transparent_hugepage/shmem_enabled"
  },
  {
    "instruction": "Check nr_overcommit_hugepages current value",
    "output": "cat /proc/sys/vm/nr_overcommit_hugepages"
  },
  {
    "instruction": "Check 2MB hugepage count",
    "output": "cat /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check THP defragmentation settings",
    "output": "cat /sys/kernel/mm/transparent_hugepage/defrag"
  },
  {
    "instruction": "Check khugepaged sleep duration in milliseconds",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/sleep_millisecs"
  },
  {
    "instruction": "Check available hugepage sizes from hstates directory",
    "output": "ls /sys/kernel/mm/hugepages/"
  },
  {
    "instruction": "Check shared memory segments using hugepages",
    "output": "ipcs -m"
  },
  {
    "instruction": "Persist 128 hugepages via sysctl config file",
    "output": "echo 'vm.nr_hugepages=128' | sudo tee /etc/sysctl.d/hugepages.conf"
  },
  {
    "instruction": "Enable THP zero page",
    "output": "echo 1 | sudo tee /sys/kernel/mm/transparent_hugepage/use_zero_page"
  },
  {
    "instruction": "Display Hugetlb value in megabytes",
    "output": "awk '/Hugetlb/ {printf \"%.0f MB\\n\", $2/1024}' /proc/meminfo"
  },
  {
    "instruction": "Check free hugepages count",
    "output": "grep HugePages_Free /proc/meminfo"
  }
]