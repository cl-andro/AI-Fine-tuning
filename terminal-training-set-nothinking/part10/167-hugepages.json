[
  {
    "instruction": "Check if process uses transparent hugepages via smaps",
    "output": "grep AnonHugePages /proc/1/smaps 2>/dev/null; echo 'check PID=1'"
  },
  {
    "instruction": "Check THP zero page status",
    "output": "cat /sys/kernel/mm/transparent_hugepage/use_zero_page"
  },
  {
    "instruction": "Mount hugetlbfs with 1GB page size",
    "output": "sudo mount -t hugetlbfs -o pagesize=1G hugetlbfs /mnt/huge_1gb"
  },
  {
    "instruction": "Display detailed hugepage pool list",
    "output": "hugeadm --pool-list"
  },
  {
    "instruction": "View THP khugepaged full scans counter",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/full_scans"
  },
  {
    "instruction": "Display hugepage and overcommit meminfo fields",
    "output": "cat /proc/meminfo | grep -E 'Huge|Commit|Over'"
  },
  {
    "instruction": "Check THP max_ptes_none value",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/max_ptes_none"
  },
  {
    "instruction": "Mount hugetlbfs with 2MB page size",
    "output": "sudo mount -t hugetlbfs -o pagesize=2M hugetlbfs /mnt/huge"
  },
  {
    "instruction": "Show hugepage statistics from memory info",
    "output": "grep -i huge /proc/meminfo"
  },
  {
    "instruction": "View hugetlb SHM group setting",
    "output": "cat /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "View hugepage documentation",
    "output": "cat /usr/share/doc/linux-doc/Documentation/admin-guide/mm/hugetlbpage.rst 2>/dev/null | head -50 || echo 'Docs not found'"
  },
  {
    "instruction": "Set number of hugepages to 512",
    "output": "echo 512 | sudo tee /proc/sys/vm/nr_hugepages"
  },
  {
    "instruction": "Check shared memory segments using hugepages",
    "output": "ipcs -m"
  },
  {
    "instruction": "View kernel boot parameters for hugepages",
    "output": "cat /proc/cmdline | tr ' ' '\\n' | grep -i huge"
  },
  {
    "instruction": "Check hugepage and THP vmstat counters",
    "output": "cat /proc/vmstat | grep -E 'huge|thp'"
  },
  {
    "instruction": "Check 2MB hugepage count",
    "output": "cat /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check HugePages_Rsvd reserved count",
    "output": "grep HugePages_Rsvd /proc/meminfo"
  },
  {
    "instruction": "Check transparent hugepage mode",
    "output": "cat /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "List available hugepage sizes",
    "output": "ls /sys/kernel/mm/hugepages/"
  },
  {
    "instruction": "Check free hugepages count",
    "output": "grep HugePages_Free /proc/meminfo"
  },
  {
    "instruction": "Set hugetlb SHM group to GID 1000",
    "output": "echo 1000 | sudo tee /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "Create a hugetlbfs mount automatically",
    "output": "hugeadm --create-mount"
  },
  {
    "instruction": "Check kernel config for transparent hugepage support",
    "output": "grep TRANSPARENT_HUGEPAGE /boot/config-$(uname -r)"
  },
  {
    "instruction": "Check kernel config for hugepage options",
    "output": "grep -E 'HUGETLB|TRANSPARENT_HUGEPAGE' /boot/config-$(uname -r)"
  },
  {
    "instruction": "Check hugepage pool maximum setting",
    "output": "cat /proc/sys/vm/hugetlb_pool_max 2>/dev/null; echo '(may not exist)'"
  }
]