    "output": "gcloud iam roles list --format='table(name,title)'"
  },
  {
    "instruction": "List Cloud SQL instances",
    "output": "gcloud sql instances list --format='table(name,databaseVersion,region)'"
  },
  {
    "instruction": "List Cloud Functions",
    "output": "gcloud functions list --format='table(name,status,runtime)'"
  },
  {
    "instruction": "Query BigQuery with dry run",
    "output": "bq query --dry_run --use_legacy_sql=false 'SELECT * FROM `my_dataset.my_table` LIMIT 100'"
  },
  {
    "instruction": "Run a BigQuery query",
    "output": "bq query --use_legacy_sql=false 'SELECT name, COUNT(*) FROM `my_dataset.my_table` GROUP BY name'"
  },
  {
    "instruction": "Create managed instance group",
    "output": "gcloud compute instance-groups managed create my-mig --base-instance-name my-instance --size 3 --template my-template --zone us-central1-a"
  },
  {
    "instruction": "Start/stop compute instance",
    "output": "gcloud compute instances start my-instance --zone us-central1-a"
  },
  {
    "instruction": "List instances with all metadata",
    "output": "gcloud compute instances list --format='json' | jq '.[].name'"
  },
  {
    "instruction": "Set autoscaling for MIG",
    "output": "gcloud compute instance-groups managed set-autoscaling my-mig --zone us-central1-a --max-num-replicas 10 --min-num-replicas 2 --target-cpu-utilization 0.8"
  },
  {
    "instruction": "Create a GCS bucket",
    "output": "gsutil mb gs://my-new-bucket/"
  },
  {
    "instruction": "Set project",
    "output": "gcloud config set project my-project-id"
  },
  {
    "instruction": "Pull Pub/Sub messages",
    "output": "gcloud pubsub subscriptions pull my-sub --auto-ack --limit 10"
  },
  {
    "instruction": "Create a firewall rule",
    "output": "gcloud compute firewall-rules create allow-http --allow tcp:80 --source-ranges 0.0.0.0/0 --target-tags http-server"
  },
  {
    "instruction": "Deploy Cloud Run with vCPU",
    "output": "gcloud run deploy my-service --image gcr.io/my-project/my-image --cpu 2 --memory 1Gi"
  },
  {
    "instruction": "Delete a compute instance",
    "output": "gcloud compute instances delete my-instance --zone us-central1-a --quiet"
  },
  {
    "instruction": "Filter instances by zone",
    "output": "gcloud compute instances list --filter='zone:us-central1-a' --format='table(name,status)'"
  },
  {
    "instruction": "Create GKE cluster",
    "output": "gcloud container clusters create my-cluster --zone us-central1-a --num-nodes 3"
  },
  {
    "instruction": "List GKE clusters",
    "output": "gcloud container clusters list --format='table(name,location,status,masterVersion)'"
  },
  {
    "instruction": "List service accounts",
    "output": "gcloud iam service-accounts list --format='table(email,displayName)'"
  },
  {
    "instruction": "Remove IAM policy binding",
    "output": "gcloud projects remove-iam-policy-binding my-project-id --member user:user@example.com --role roles/viewer"
  },
  {
    "instruction": "Create and download service account key",
    "output": "gcloud iam service-accounts keys create key.json --iam-account my-sa@my-project-id.iam.gserviceaccount.com"
  },
  {
    "instruction": "List compute instances with format",
    "output": "gcloud compute instances list --format=\"table(name,zone,status,networkInterfaces[0].networkIP)\""
  },
  {
    "instruction": "List storage buckets",
    "output": "gsutil ls"
