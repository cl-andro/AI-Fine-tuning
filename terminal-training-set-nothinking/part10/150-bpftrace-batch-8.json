[
  {"instruction": "Show all tracepoints with syscalls", "output": "bpftrace -l 'tracepoint:syscalls:*' | head -50"},
  {"instruction": "List all kprobes for networking", "output": "bpftrace -l 'kprobe:*net*' | head -30"},
  {"instruction": "List all kprobes for filesystem", "output": "bpftrace -l 'kprobe:*file*' | head -30"},
  {"instruction": "List all kprobes for memory management", "output": "bpftrace -l 'kprobe:*mm_*' | head -30"},
  {"instruction": "List all kprobes for scheduler", "output": "bpftrace -l 'kprobe:*sched*' | head -30"},
  {"instruction": "Search for probes matching pattern", "output": "bpftrace -l 'kprobe:*tcp*'"},
  {"instruction": "List tracepoints for IRQ subsystem", "output": "bpftrace -l 'tracepoint:irq:*'"},
  {"instruction": "List tracepoints for block device layer", "output": "bpftrace -l 'tracepoint:block:*'"},
  {"instruction": "List tracepoints for USB subsystem", "output": "bpftrace -l 'tracepoint:usb:*'"},
  {"instruction": "List all available kprobes", "output": "bpftrace -l 'kprobe:*' | wc -l"},
  {"instruction": "List tracepoints for random generator", "output": "bpftrace -l 'tracepoint:random:*'"},
  {"instruction": "List tracepoints for regulator framework", "output": "bpftrace -l 'tracepoint:regulator:*'"},
  {"instruction": "List tracepoints for regulator framework", "output": "bpftrace -l 'tracepoint:regulator:*' 2>&1 || echo 'No regulator tracepoints'"},
  {"instruction": "Display probe type help", "output": "bpftrace --help 2>&1 | head -30"},
  {"instruction": "List software events", "output": "bpftrace -l 'software:*'"},
  {"instruction": "List hardware events", "output": "bpftrace -l 'hardware:*'"},
  {"instruction": "Check bpftrace kernel config requirements", "output": "bpftrace --check-config 2>&1 | grep -iE 'ok|missing'"},
  {"instruction": "Show available bpftrace built-in functions", "output": "bpftrace --help 2>&1 | grep -A 5 'Builtins'"},
  {"instruction": "List variable types in bpftrace", "output": "bpftrace --help 2>&1 | grep -iE 'variable|map|histogram'"},
  {"instruction": "Show bpftrace probe format info", "output": "bpftrace --help 2>&1 | grep -A 10 'Probe'"},
  {"instruction": "Display bpftrace man page short description", "output": "man bpftrace 2>/dev/null | head -20 || bpftrace --help 2>&1 | head -20"},
  {"instruction": "Count total available probes", "output": "bpftrace -l '*' | wc -l"}
