[
  {
    "instruction": "Run a command 30 minutes from now",
    "output": "systemd-run --on-active=30m /usr/bin/check.sh"
  },
  {
    "instruction": "Analyze calendar with five iterations",
    "output": "systemd-analyze calendar --iterations=5 '*-*-* *:00,30:00'"
  },
  {
    "instruction": "List dependencies of a timer",
    "output": "systemctl list-dependencies backup.timer"
  },
  {
    "instruction": "Show last trigger time of timer",
    "output": "systemctl show -p LastTriggerUSec backup.timer"
  },
  {
    "instruction": "View journal entries for timer unit",
    "output": "journalctl -u backup.timer"
  },
  {
    "instruction": "List system timer unit files",
    "output": "ls /etc/systemd/system/*.timer"
  },
  {
    "instruction": "Show next realtime elapse of timer",
    "output": "systemctl show -p NextElapseUSecRealtime backup.timer"
  },
  {
    "instruction": "Read static timer unit file",
    "output": "cat /etc/systemd/system/backup.timer"
  },
  {
    "instruction": "Analyze a calendar expression for next runs",
    "output": "systemd-analyze calendar 'Mon *-*-* 00:00:00'"
  },
  {
    "instruction": "Reenable a timer",
    "output": "systemctl reenable backup.timer"
  },
  {
    "instruction": "Show monotonic timer elapse from boot",
    "output": "systemctl show -p NextElapseUSecMonotonic backup.timer"
  },
  {
    "instruction": "Create timer for every 6 hours",
    "output": "systemd-run --on-calendar='*-*-* */6:00:00' /usr/bin/every-6-hours.sh"
  },
  {
    "instruction": "Kill a timer unit",
    "output": "systemctl kill -s HUP backup.timer"
  },
  {
    "instruction": "List all active timers",
    "output": "systemctl list-timers"
  },
  {
    "instruction": "Run a command daily at 2 AM via transient timer",
    "output": "systemd-run --on-calendar='*-*-* 02:00:00' /usr/bin/backup.sh"
  },
  {
    "instruction": "Check timer status",
    "output": "systemctl status backup.timer"
  },
  {
    "instruction": "List running timers",
    "output": "systemctl list-timers --state=running"
  },
  {
    "instruction": "Analyze hourly calendar expression",
    "output": "systemd-analyze calendar 'hourly'"
  },
  {
    "instruction": "Create timer that fires every 15 minutes",
    "output": "systemd-run --on-active=15m --unit=quarterly /usr/bin/quarterly-check.sh"
  },
  {
    "instruction": "Create timer for weekdays at 9 AM",
    "output": "systemd-run --on-calendar='Mon..Fri *-*-* 09:00:00' /usr/bin/workday-start.sh"
  },
  {
    "instruction": "Reset failed timer state",
    "output": "systemctl reset-failed backup.timer"
  },
  {
    "instruction": "Create override for timer schedule",
    "output": "printf '[Timer]\\nOnCalendar=*-*-* 04:00:00\\n' | sudo tee /etc/systemd/system/backup.timer.d/override.conf"
  },
  {
    "instruction": "Create timer schedule with seconds precision",
    "output": "systemd-analyze calendar '*-*-* *:*:30'"
  },
  {
    "instruction": "Add timer to timers.target wants",
    "output": "systemctl add-wants timers.target backup.timer"
  }
]