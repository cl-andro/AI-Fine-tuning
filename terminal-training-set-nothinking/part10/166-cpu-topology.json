[
  {
    "instruction": "Show memory used per NUMA node",
    "output": "numactl --hardware | grep 'free'"
  },
  {
    "instruction": "Show process NUMA policy",
    "output": "numactl --show"
  },
  {
    "instruction": "Show CPU flags",
    "output": "lscpu | grep Flags"
  },
  {
    "instruction": "Run command on dedicated CPUs",
    "output": "taskset -c 0-3 myapp"
  },
  {
    "instruction": "Show CPU parsing JSON",
    "output": "lscpu --all --json"
  },
  {
    "instruction": "Show process CPU affinity",
    "output": "taskset -p $$"
  },
  {
    "instruction": "Bind a command to a specific NUMA node",
    "output": "numactl --cpunodebind=0 --membind=0 myapp"
  },
  {
    "instruction": "Show CPU isolation info",
    "output": "cat /sys/devices/system/cpu/isolated"
  },
  {
    "instruction": "Show CPU topology from sysfs",
    "output": "cat /sys/devices/system/cpu/cpu0/topology/core_cpus_list"
  },
  {
    "instruction": "Show architecture specific info",
    "output": "x86info -a"
  },
  {
    "instruction": "Set CPU governor to performance",
    "output": "echo performance | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show cache index0 type",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/type"
  },
  {
    "instruction": "Show cache index0 size",
    "output": "cat /sys/devices/system/cpu/cpu0/cache/index0/size"
  },
  {
    "instruction": "Show NUMA node memory info",
    "output": "numactl --hardware | grep 'node.*size'"
  },
  {
    "instruction": "Show CPU vulnerability info",
    "output": "cat /sys/devices/system/cpu/vulnerabilities/*"
  },
  {
    "instruction": "Show all CPU info",
    "output": "cat /proc/cpuinfo"
  },
  {
    "instruction": "Run with memory policy local",
    "output": "numactl --localalloc myapp"
  },
  {
    "instruction": "Run with policy interleaved",
    "output": "numactl --interleave=all myapp"
  },
  {
    "instruction": "Show CPU governor settings",
    "output": "cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
  },
  {
    "instruction": "Show all topology info per core",
    "output": "for i in /sys/devices/system/cpu/cpu*/topology/; do echo \"=== $i ===\"; cat \"$i/core_cpus_list\" 2>/dev/null; done"
  },
  {
    "instruction": "Show detailed CPUID info",
    "output": "cpuid -1"
  },
  {
    "instruction": "Show cluster topology",
    "output": "cat /sys/devices/system/cpu/cpu*/topology/cluster_cpus_list"
  }
]