[
  {
    "instruction": "List unit files filtered by service type",
    "output": "systemctl list-unit-files --type=service"
  },
  {
    "instruction": "Link a unit file from another location",
    "output": "systemctl link /opt/nginx/nginx.service"
  },
  {
    "instruction": "Edit unit file directly as full file",
    "output": "systemctl edit --full nginx.service"
  },
  {
    "instruction": "List scope units",
    "output": "systemctl list-units --type=scope"
  },
  {
    "instruction": "View full unit file for nginx service",
    "output": "systemctl cat nginx.service"
  },
  {
    "instruction": "List slice units",
    "output": "systemctl list-units --type=slice"
  },
  {
    "instruction": "Check if service is enabled",
    "output": "systemctl is-enabled nginx.service"
  },
  {
    "instruction": "List all loaded service units",
    "output": "systemctl list-units --type=service"
  },
  {
    "instruction": "Check service status with details",
    "output": "systemctl status nginx.service"
  },
  {
    "instruction": "List runtime systemd units",
    "output": "ls /run/systemd/system/"
  },
  {
    "instruction": "List failed services",
    "output": "systemctl list-units --type=service --state=failed"
  },
  {
    "instruction": "Show Wants property of SSH service",
    "output": "systemctl show -p Wants ssh.service"
  },
  {
    "instruction": "Set memory limit on a unit",
    "output": "systemctl set-property nginx.service MemoryMax=512M"
  },
  {
    "instruction": "List running services",
    "output": "systemctl list-units --type=service --state=running"
  },
  {
    "instruction": "Disable service from starting at boot",
    "output": "systemctl disable nginx.service"
  },
  {
    "instruction": "List exited services",
    "output": "systemctl list-units --type=service --state=exited"
  },
  {
    "instruction": "List all unit files by state and type",
    "output": "systemctl list-unit-files --type=service --state=indirect,generated"
  },
  {
    "instruction": "List unit files matching nginx pattern",
    "output": "systemctl list-unit-files 'nginx*'"
  },
  {
    "instruction": "List device units",
    "output": "systemctl list-units --type=device"
  },
  {
    "instruction": "List static unit files",
    "output": "systemctl list-unit-files --state=static"
