  },
  {
    "instruction": "List boot loader entries",
    "output": "bootctl list"
  },
  {
    "instruction": "Check bootctl version",
    "output": "bootctl --version"
  },
  {
    "instruction": "Check EFI variables",
    "output": "efibootmgr"
  },
  {
    "instruction": "Check bootloader status",
    "output": "bootctl status"
  },
  {
    "instruction": "Check kernel-install layout",
    "output": "ls /boot/*/"
