  {"instruction": "Enter PID namespace only", "output": "nsenter -p -t 1234 /bin/bash"},
  {"instruction": "Enter user namespace only", "output": "nsenter -U -t 1234 /bin/bash"},
  {"instruction": "Enter cgroup namespace only", "output": "nsenter -C -t 1234 /bin/bash"},
  {"instruction": "Enter time namespace only", "output": "nsenter -T -t 1234 /bin/bash"},
  {"instruction": "Enter PID and net namespace only", "output": "nsenter -p -n -t 1234 /bin/bash"},
  {"instruction": "Use nsenter without target (current NS)", "output": "nsenter -t 1 -n -p /bin/bash"},
