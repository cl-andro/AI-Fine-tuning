[
  {
    "instruction": "Create override to set restart limit",
    "output": "printf '[Service]\\nStartLimitIntervalSec=30\\nStartLimitBurst=3\\n' | sudo tee /etc/systemd/system/nginx.service.d/restart.conf"
  },
  {
    "instruction": "Check if a service has failed",
    "output": "systemctl is-failed nginx.service"
  },
  {
    "instruction": "Check overall system state",
    "output": "systemctl is-system-running"
  },
  {
    "instruction": "List failed services",
    "output": "systemctl list-units --type=service --state=failed"
  },
  {
    "instruction": "View full unit file for nginx service",
    "output": "systemctl cat nginx.service"
  },
  {
    "instruction": "Reload a service without restarting",
    "output": "systemctl reload nginx.service"
  },
  {
    "instruction": "Create drop-in directory for overrides",
    "output": "mkdir -p /etc/systemd/system/nginx.service.d"
  },
  {
    "instruction": "List vendor unit files from lib",
    "output": "ls /lib/systemd/system/*.service"
  },
  {
    "instruction": "Add service as required by multi-user target",
    "output": "systemctl add-requires multi-user.target nginx.service"
  },
  {
    "instruction": "Show systemd version",
    "output": "systemctl --version"
  },
  {
    "instruction": "List enabled and disabled service unit files",
    "output": "systemctl list-unit-files --type=service --state=enabled,disabled"
  },
  {
    "instruction": "Reset a failed service state",
    "output": "systemctl reset-failed nginx.service"
  },
  {
    "instruction": "List scope units",
    "output": "systemctl list-units --type=scope"
  },
  {
    "instruction": "Mask a service to prevent any start",
    "output": "systemctl mask apache2.service"
  },
  {
    "instruction": "Restart service only if running",
    "output": "systemctl try-restart nginx.service"
  },
  {
    "instruction": "List all masked unit files",
    "output": "systemctl list-unit-files --state=masked"
  },
  {
    "instruction": "List all enabled unit files",
    "output": "systemctl list-unit-files --state=enabled"
  },
  {
    "instruction": "Dump full systemd manager state",
    "output": "systemctl dump"
  },
  {
    "instruction": "List drop-in directories",
    "output": "ls -d /etc/systemd/system/*.d/"
  },
  {
    "instruction": "List all unit files by state and type",
    "output": "systemctl list-unit-files --type=service --state=indirect,generated"
  },
  {
    "instruction": "Check service status with details",
    "output": "systemctl status nginx.service"
  }
]