[
  {
    "instruction": "Start a portable service",
    "output": "systemctl start myapp.service"
  },
  {
    "instruction": "List portable images with detailed info",
    "output": "portablectl list --full"
  },
  {
    "instruction": "Reattach portable to refresh units",
    "output": "portablectl reattach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Create a portable squashfs image",
    "output": "mksquashfs /var/lib/machines/myapp /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Check status of a portable service unit",
    "output": "systemctl status systemd-portabled.service"
  },
  {
    "instruction": "Check journal for portable service",
    "output": "journalctl -u myapp.service"
  },
  {
    "instruction": "Attach multiple portable images at once",
    "output": "portablectl attach /var/lib/portable/app1.raw /var/lib/portable/app2.raw"
  },
  {
    "instruction": "List only attached portable images",
    "output": "portablectl list --attached"
  },
  {
    "instruction": "Attach portable with no profile validation",
    "output": "portablectl attach --profile=untrusted /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Show help for portablectl",
    "output": "portablectl --help"
  },
  {
    "instruction": "Attach portable image and copy to runtime",
    "output": "portablectl attach --copy=auto /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach portable with network namespace bind",
    "output": "portablectl attach --property=PrivateNetwork=yes /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Enable portable daemon at boot",
    "output": "systemctl enable systemd-portabled"
  },
  {
    "instruction": "List all portable services",
    "output": "portablectl list"
  },
  {
    "instruction": "Attach a portable image with specific profile",
    "output": "portablectl attach --profile=trusted /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Restart the portable daemon",
    "output": "systemctl restart systemd-portabled"
  },
  {
    "instruction": "Place service unit in portable image",
    "output": "mkdir -p /var/lib/portable/myapp/lib/systemd/system && printf '[Service]\\nExecStart=/usr/bin/myapp\\n' > /var/lib/portable/myapp/lib/systemd/system/myapp.service"
  },
  {
    "instruction": "Inspect an attached portable service",
    "output": "portablectl inspect myapp"
  },
  {
    "instruction": "Verify portable image is valid OS",
    "output": "test -f /var/lib/portable/myapp.raw && unsquashfs -l /var/lib/portable/myapp.raw usr/lib/os-release 2>/dev/null && echo 'Valid'"
  },
  {
    "instruction": "Check if a portable image is currently attached",
    "output": "portablectl list | grep myapp"
  },
  {
    "instruction": "Create a minimal portable image directory",
    "output": "mkdir -p /var/lib/portable/myapp/usr/bin /var/lib/portable/myapp/lib/systemd/system"
  },
  {
    "instruction": "Check portable image size",
    "output": "ls -lh /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Inspect portable image with extended info",
    "output": "portablectl inspect --full /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Show portable image OS release info",
    "output": "unsquashfs -l /var/lib/portable/myapp.raw etc/os-release 2>/dev/null; echo 'check inside image'"
  },
  {
    "instruction": "List only detached portable images",
    "output": "portablectl list --detached"
  },
  {
    "instruction": "Check documentation for portable services",
    "output": "less /usr/share/doc/systemd/portable.html 2>/dev/null || echo 'systemd-portable docs'"
  }
]