[
  {"instruction": "Trace a process that is already running", "output": "strace -p 1234"},
  {"instruction": "Attach to multiple PIDs", "output": "strace -p 1234 -p 5678"},
  {"instruction": "Attach to a thread within a process", "output": "strace -p 1234 -T"},
  {"instruction": "Attach and follow all threads", "output": "strace -f -p 1234"},
  {"instruction": "Attach without interrupting process", "output": "strace -p 1234 -e inject=openat:delay_us=0"},
  {"instruction": "Kill process after strace", "output": "strace -p 1234 -z"},
  {"instruction": "Detach after timeout from attach", "output": "timeout 5 strace -p 1234"},
  {"instruction": "Trace the process group", "output": "strace -p --pgid 1234"},
  {"instruction": "Follow fork with verbose output", "output": "strace -vf ls"},
  {"instruction": "Show child process tree", "output": "strace -f -e trace=clone,fork,vfork ls"},
  {"instruction": "Wait for child start then trace", "output": "strace -f --seccomp-bpf ls"},
  {"instruction": "Attach strace to a daemon", "output": "strace -p $(pgrep -x nginx) -f -o nginx_strace.log"},
  {"instruction": "Monitor a command and children", "output": "strace -f -o log.txt sh -c 'ls; ps; date'"},
  {"instruction": "Trace with signal on attach/detach", "output": "strace -p 1234 --syscall-limit=100"},
  {"instruction": "Strace with pausing after errors", "output": "strace -e fault=openat:error=EACCES:when=1+ --pause=100 ls"},
  {"instruction": "Show decoded syscall args in full", "output": "strace -v -e trace=openat ls"},
  {"instruction": "Show long strings in their entirety", "output": "strace -s 4096 ls"},
  {"instruction": "Print raw environment strings", "output": "strace -v -e trace=execve /bin/true"},
  {"instruction": "Show read data in hex and ASCII", "output": "strace -e read -xx ls 2>&1 | head -20"},
  {"instruction": "Display current working dir changes", "output": "strace -e trace=chdir,fchdir,getcwd cd /tmp"},
  {"instruction": "Show file descriptor table for each proc", "output": "strace -e trace=close,dup,dup2 ls"},
  {"instruction": "Track epoll file descriptors", "output": "strace -e trace=epoll_create,epoll_ctl,epoll_wait ls"}
]