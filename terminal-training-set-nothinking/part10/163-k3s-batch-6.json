[
  {
    "instruction": "Install K3s with debug",
    "output": "curl -sfL https://get.k3s.io | sh -s - --debug server --cluster-init"
  },
  {
    "instruction": "Install K3s server with embedded etcd",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init --token mytoken"
  },
  {
    "instruction": "Install K3s with local storage",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--disable=local-storage' sh -"
  },
  {
    "instruction": "K3s kubectl label node",
    "output": "k3s kubectl label node my-node zone=us-west"
  },
  {
    "instruction": "Run k3s kubectl apply",
    "output": "k3s kubectl apply -f deployment.yaml"
  },
  {
    "instruction": "K3s ctr tag image",
    "output": "k3s ctr images tag docker.io/library/nginx:latest myregistry/nginx:latest"
  },
  {
    "instruction": "K3s kubectl top nodes",
    "output": "k3s kubectl top nodes"
  },
  {
    "instruction": "K3s kubectl create namespace",
    "output": "k3s kubectl create namespace my-namespace"
  },
  {
    "instruction": "K3s kubectl port-forward",
    "output": "k3s kubectl port-forward svc/my-service 8080:80"
  },
  {
    "instruction": "Install K3s without traefik",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--disable=traefik' sh -"
  },
  {
    "instruction": "K3s kubectl cordon node",
    "output": "k3s kubectl cordon my-node"
  },
  {
    "instruction": "K3s kubectl taint node",
    "output": "k3s kubectl taint nodes my-node dedicated=special:NoSchedule"
  },
  {
    "instruction": "K3s kubectl delete pod",
    "output": "k3s kubectl delete pod my-pod --grace-period=0 --force"
  },
  {
    "instruction": "List images with k3s ctr",
    "output": "k3s ctr images list"
  },
  {
    "instruction": "K3s get events",
    "output": "k3s kubectl get events --all-namespaces"
  },
  {
    "instruction": "K3s logs pod",
    "output": "k3s kubectl logs -n default my-pod"
  },
  {
    "instruction": "K3s ctr run container",
    "output": "k3s ctr run docker.io/library/nginx:latest my-nginx"
  },
  {
    "instruction": "Install K3s with flannel disabled",
    "output": "curl -sfL https://get.k3s.io | INSTALL_K3S_FLAGS='--flannel-backend=none' sh -"
  },
  {
    "instruction": "Install K3s with etcd only",
    "output": "curl -sfL https://get.k3s.io | sh -s - server --cluster-init --datastore-endpoint etcd://127.0.0.1:2379"
  },
  {
    "instruction": "K3s kubectl get configmaps",
    "output": "k3s kubectl get configmaps --all-namespaces"
  },
  {
    "instruction": "K3s kubectl create secret generic",
    "output": "k3s kubectl create secret generic my-secret --from-literal=password=test123"
  }
]