[
  {"instruction": "Trace file opens with kprobe", "output": "bpftrace -e 'kprobe:do_sys_open { printf(\"%s\\n\", str(args->filename)); }'"},
  {"instruction": "List all bpftrace probes", "output": "bpftrace --list probes"},
  {"instruction": "List all BPF programs loaded", "output": "bpftool prog list"},
  {"instruction": "Show BPF programs attached to networking", "output": "bpftool net"},
  {"instruction": "Trace execve syscalls with execsnoop", "output": "execsnoop.bt"},
  {"instruction": "Trace block I/O latency with biolatency", "output": "biolatency.bt"},
  {"instruction": "Trace file opens with opensnoop", "output": "opensnoop.bt"},
  {"instruction": "Trace TCP connection life with tcplife", "output": "tcplife.bt"},
  {"instruction": "Trace syscalls for a specific PID", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_* /pid == 1234/ { printf(\"%s\\n\", probe); }'"},
  {"instruction": "Count all syscalls system-wide", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_* { @[probe] = count(); }'"},
  {"instruction": "Trace read/write calls by process", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_read { @[comm] = count(); }'"},
  {"instruction": "Profile kernel stack traces", "output": "bpftrace -e 'profile:hz:99 { @[kstack] = count(); }'"},
  {"instruction": "Profile user stack traces", "output": "bpftrace -e 'profile:hz:99 { @[ustack] = count(); }'"},
  {"instruction": "Count page faults by process", "output": "bpftrace -e 'software:page-faults:1 { @[comm] = count(); }'"},
  {"instruction": "Trace malloc calls", "output": "bpftrace -e 'usdt:/lib/x86_64-linux-gnu/libc.so.6:malloc { printf(\"malloc by %s\\n\", comm); }'"},
  {"instruction": "Trace TCP connect attempts", "output": "bpftrace -e 'kprobe:tcp_v4_connect { printf(\"connect to %s\\n\", ntop(args->sk->__sk_common.skc_daddr)); }'"},
  {"instruction": "Show bpftrace version", "output": "bpftrace --version"},
  {"instruction": "List all tracepoints", "output": "bpftrace -l 'tracepoint:*'"},
  {"instruction": "List kprobe targets", "output": "bpftrace -l 'kprobe:*'"},
  {"instruction": "List USDT probes in a binary", "output": "bpftrace -l 'usdt:/usr/bin/nginx:*'"},
  {"instruction": "Run bpftrace one-liner with kernel headers", "output": "bpftrace -e 'kprobe:do_nanosleep { printf(\"sleep by %s\\n\", comm); }'"}
]