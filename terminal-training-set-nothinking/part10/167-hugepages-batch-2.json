[
  {
    "instruction": "Set NUMA node 0 hugepages to 64",
    "output": "echo 64 | sudo tee /sys/devices/system/node/node0/hugepages/hugepages-2048kB/nr_hugepages"
  },
  {
    "instruction": "Check kernel config for transparent hugepage support",
    "output": "grep TRANSPARENT_HUGEPAGE /boot/config-$(uname -r)"
  },
  {
    "instruction": "Check shared memory segments using hugepages",
    "output": "ipcs -m"
  },
  {
    "instruction": "Check 1GB hugepage count",
    "output": "cat /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"
  },
  {
    "instruction": "Set khugepaged scan rate to 4096 pages",
    "output": "echo 4096 | sudo tee /sys/kernel/mm/transparent_hugepage/khugepaged/pages_to_scan"
  },
  {
    "instruction": "Check kernel config for hugetlbfs support",
    "output": "grep -i HUGETLBFS /boot/config-$(uname -r)"
  },
  {
    "instruction": "Check nr_overcommit_hugepages current value",
    "output": "cat /proc/sys/vm/nr_overcommit_hugepages"
  },
  {
    "instruction": "Display NUMA hugepage distribution per node",
    "output": "cat /sys/devices/system/node/node*/meminfo | grep Huge"
  },
  {
    "instruction": "Check free hugepages count",
    "output": "grep HugePages_Free /proc/meminfo"
  },
  {
    "instruction": "Check if THP supports shmem",
    "output": "cat /sys/kernel/mm/transparent_hugepage/shmem_enabled"
  },
  {
    "instruction": "Check THP khugepaged pages_to_scan",
    "output": "cat /sys/kernel/mm/transparent_hugepage/khugepaged/pages_to_scan"
  },
  {
    "instruction": "View all hugepage nr_hugepages values per size",
    "output": "find /sys/kernel/mm/hugepages -name nr_hugepages -exec sh -c 'echo \"$1: $(cat $1)\"' _ {} \\;"
  },
  {
    "instruction": "Make hugepage setting persistent via sysctl.d",
    "output": "echo 'vm.nr_hugepages=512' | sudo tee /etc/sysctl.d/hugepages.conf"
  },
  {
    "instruction": "Check hugepage surplus count",
    "output": "grep HugePages_Surp /proc/meminfo"
  },
  {
    "instruction": "Check hugetlb_shm_group sysctl value",
    "output": "sudo sysctl vm.hugetlb_shm_group"
  },
  {
    "instruction": "Set khugepaged sleep time to 5 seconds",
    "output": "echo 5000 | sudo tee /sys/kernel/mm/transparent_hugepage/khugepaged/sleep_millisecs"
  },
  {
    "instruction": "List all hugepage filesystem mounts",
    "output": "mount -t hugetlbfs"
  },
  {
    "instruction": "Check HugePages_Total value",
    "output": "grep HugePages_Total /proc/meminfo"
  },
  {
    "instruction": "Check hugetlbfs mount details",
    "output": "mount | grep hugetlbfs"
  },
  {
    "instruction": "Show hugepage pool information with hugeadm",
    "output": "hugeadm --list-all"
  },
  {
    "instruction": "Set hugetlb_shm_group via sysctl",
    "output": "sudo sysctl vm.hugetlb_shm_group=2000"
  },
  {
    "instruction": "View hugetlb SHM group setting",
    "output": "cat /proc/sys/vm/hugetlb_shm_group"
  },
  {
    "instruction": "Enable transparent hugepages always",
    "output": "echo always | sudo tee /sys/kernel/mm/transparent_hugepage/enabled"
  },
  {
    "instruction": "View THP PMD size",
    "output": "cat /sys/kernel/mm/transparent_hugepage/hpage_pmd_size"
  }
