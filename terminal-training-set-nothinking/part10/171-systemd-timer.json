[
  {
    "instruction": "Show last trigger time of timer",
    "output": "systemctl show -p LastTriggerUSec backup.timer"
  },
  {
    "instruction": "Create override for timer schedule",
    "output": "printf '[Timer]\\nOnCalendar=*-*-* 04:00:00\\n' | sudo tee /etc/systemd/system/backup.timer.d/override.conf"
  },
  {
    "instruction": "List timers filtered by glob pattern",
    "output": "systemctl list-timers 'backup*'"
  },
  {
    "instruction": "Kill a timer unit",
    "output": "systemctl kill -s HUP backup.timer"
  },
  {
    "instruction": "Show monotonic timer elapse from boot",
    "output": "systemctl show -p NextElapseUSecMonotonic backup.timer"
  },
  {
    "instruction": "List reverse dependencies of a timer",
    "output": "systemctl list-dependencies --reverse backup.timer"
  },
  {
    "instruction": "Create a transient timer for midnight echo",
    "output": "systemd-run --on-calendar='*-*-* 00:00:00' systemd-cat echo \"midnight\""
  },
  {
    "instruction": "Edit timer unit with drop-in",
    "output": "systemctl edit backup.timer"
  },
  {
    "instruction": "Show all timer properties",
    "output": "systemctl show backup.timer"
  },
  {
    "instruction": "Change OnCalendar property at runtime",
    "output": "systemctl set-property backup.timer OnCalendar='*-*-* 03:00:00'"
  },
  {
    "instruction": "Analyze monthly calendar expression",
    "output": "systemd-analyze calendar 'monthly'"
  },
  {
    "instruction": "Run a command 5 minutes after boot",
    "output": "systemd-run --on-startup=5m /usr/bin/delayed-start.sh"
  },
  {
    "instruction": "Create timer for weekdays at 9 AM",
    "output": "systemd-run --on-calendar='Mon..Fri *-*-* 09:00:00' /usr/bin/workday-start.sh"
  },
  {
    "instruction": "Check if timer is active",
    "output": "systemctl is-active backup.timer"
  },
  {
    "instruction": "Analyze a calendar expression for next runs",
    "output": "systemd-analyze calendar 'Mon *-*-* 00:00:00'"
  },
  {
    "instruction": "List running timers",
    "output": "systemctl list-timers --state=running"
  },
  {
    "instruction": "List dependencies of a timer",
    "output": "systemctl list-dependencies backup.timer"
  },
  {
    "instruction": "List timer unit files by type",
    "output": "systemctl list-unit-files --type=timer"
  },
  {
    "instruction": "List timers without pager",
    "output": "systemctl list-timers --no-pager"
  },
  {
    "instruction": "View journal entries for timer unit",
    "output": "journalctl -u backup.timer"
  },
  {
    "instruction": "Analyze custom calendar: first of month at 4 AM",
    "output": "systemd-analyze calendar '*-*-01 04:00:00'"
  },
  {
    "instruction": "Create timer for every 6 hours",
    "output": "systemd-run --on-calendar='*-*-* */6:00:00' /usr/bin/every-6-hours.sh"
  },
  {
    "instruction": "Clean timer runtime state",
    "output": "systemctl clean backup.timer"
  }
]