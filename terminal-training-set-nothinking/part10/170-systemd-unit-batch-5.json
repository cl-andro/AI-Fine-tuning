[
  {
    "instruction": "Stop a running service",
    "output": "systemctl stop nginx.service"
  },
  {
    "instruction": "Enable service to start at boot",
    "output": "systemctl enable nginx.service"
  },
  {
    "instruction": "Grep After directive from unit file",
    "output": "systemctl cat nginx.service | grep -i after"
  },
  {
    "instruction": "List all enabled unit files",
    "output": "systemctl list-unit-files --state=enabled"
  },
  {
    "instruction": "List all wants directories",
    "output": "ls -d /etc/systemd/system/*.wants/"
  },
  {
    "instruction": "List unit files matching ssh pattern",
    "output": "systemctl list-unit-files 'ssh*'"
  },
  {
    "instruction": "Check overall system state",
    "output": "systemctl is-system-running"
  },
  {
    "instruction": "Check systemd-analyze for unit config verify",
    "output": "systemd-analyze verify nginx.service"
  },
  {
    "instruction": "Show systemd version",
    "output": "systemctl --version"
  },
  {
    "instruction": "List unit files filtered by service type",
    "output": "systemctl list-unit-files --type=service"
  },
  {
    "instruction": "List wants symlinks in multi-user target",
    "output": "ls /etc/systemd/system/multi-user.target.wants/"
  },
  {
    "instruction": "Create override config using heredoc",
    "output": "cat > /etc/systemd/system/nginx.service.d/override.conf << 'EOF'\n[Service]\nRestart=always\nRestartSec=10\nEOF"
  },
  {
    "instruction": "List system sockets",
    "output": "systemctl list-sockets"
  },
  {
    "instruction": "List path units",
    "output": "systemctl list-units --type=path"
  },
  {
    "instruction": "Enable and start service immediately",
    "output": "systemctl enable --now nginx.service"
  },
  {
    "instruction": "Reset a failed service state",
    "output": "systemctl reset-failed nginx.service"
  },
  {
    "instruction": "Show Wants property of SSH service",
    "output": "systemctl show -p Wants ssh.service"
  },
  {
    "instruction": "Revert unit file to vendor default",
    "output": "systemctl revert nginx.service"
  },
  {
    "instruction": "List all loaded service units",
    "output": "systemctl list-units --type=service"
  },
  {
    "instruction": "List all installed unit files",
    "output": "systemctl list-unit-files"
  }
]