[
  {
    "instruction": "List dependencies of a timer",
    "output": "systemctl list-dependencies backup.timer"
  },
  {
    "instruction": "List elapsed timers",
    "output": "systemctl list-timers --state=elapsed"
  },
  {
    "instruction": "Reenable a timer",
    "output": "systemctl reenable backup.timer"
  },
  {
    "instruction": "Analyze custom calendar: first of month at 4 AM",
    "output": "systemd-analyze calendar '*-*-01 04:00:00'"
  },
  {
    "instruction": "Create override for timer schedule",
    "output": "printf '[Timer]\\nOnCalendar=*-*-* 04:00:00\\n' | sudo tee /etc/systemd/system/backup.timer.d/override.conf"
  },
  {
    "instruction": "Read static timer unit file",
    "output": "cat /etc/systemd/system/backup.timer"
  },
  {
    "instruction": "Run a command 5 minutes after boot",
    "output": "systemd-run --on-startup=5m /usr/bin/delayed-start.sh"
  },
  {
    "instruction": "Edit timer unit with drop-in",
    "output": "systemctl edit backup.timer"
  },
  {
    "instruction": "Run a command 1 hour after unit activates",
    "output": "systemd-run --on-unit-active=1h /usr/bin/hourly.sh"
  },
  {
    "instruction": "List reverse dependencies of a timer",
    "output": "systemctl list-dependencies --reverse backup.timer"
  },
  {
    "instruction": "Analyze Sunday calendar for 2024",
    "output": "systemd-analyze calendar 'Sun 2024-*-* 00:00:00'"
  },
  {
    "instruction": "List timers filtered by glob pattern",
    "output": "systemctl list-timers 'backup*'"
  },
  {
    "instruction": "Check if timer is active",
    "output": "systemctl is-active backup.timer"
  },
  {
    "instruction": "List system timer unit files",
    "output": "ls /etc/systemd/system/*.timer"
  },
  {
    "instruction": "Show next realtime elapse of timer",
    "output": "systemctl show -p NextElapseUSecRealtime backup.timer"
  },
  {
    "instruction": "View timer unit file content",
    "output": "systemctl cat backup.timer"
  },
  {
    "instruction": "List timers in JSON format",
    "output": "systemctl list-timers --json=pretty"
  },
  {
    "instruction": "Create timer for weekdays at 9 AM",
    "output": "systemd-run --on-calendar='Mon..Fri *-*-* 09:00:00' /usr/bin/workday-start.sh"
  },
  {
    "instruction": "Show all timer properties",
    "output": "systemctl show backup.timer"
  },
  {
    "instruction": "Persist a timer to survive reboots",
    "output": "printf '[Timer]\\nPersistent=true\\n' | sudo tee /etc/systemd/system/backup.timer.d/persist.conf"
  },
  {
    "instruction": "View journal entries for timer unit",
    "output": "journalctl -u backup.timer"
  },
  {
    "instruction": "Analyze calendar with base time",
    "output": "systemd-analyze calendar '*-*-* 00:00:00' --base-time=2024-01-01"
  },
  {
    "instruction": "View journal for timer-triggered service",
    "output": "journalctl -u backup.service"
  },
  {
    "instruction": "Stop a timer manually",
    "output": "systemctl stop backup.timer"
  },
  {
    "instruction": "Reload daemon after timer file changes",
    "output": "systemctl daemon-reload"
  }
]