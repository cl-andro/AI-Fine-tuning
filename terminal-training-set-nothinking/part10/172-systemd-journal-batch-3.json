[
  {
    "instruction": "List boot IDs with timestamps",
    "output": "journalctl --list-boots"
  },
  {
    "instruction": "Filter journal by audit session",
    "output": "journalctl _AUDIT_SESSION=1"
  },
  {
    "instruction": "View journal in JSON pretty format",
    "output": "journalctl -o json-pretty"
  },
  {
    "instruction": "Filter journal by kernel subsystem",
    "output": "journalctl _KERNEL_SUBSYSTEM=block"
  },
  {
    "instruction": "Filter journal by SELinux context",
    "output": "journalctl _SELINUX_CONTEXT=system_u:system_r:sshd_t"
  },
  {
