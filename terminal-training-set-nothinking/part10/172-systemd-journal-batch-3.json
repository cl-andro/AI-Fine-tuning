  {
    "instruction": "Show journal in short monotonic format",
    "output": "journalctl -o short-monotonic"
  },
  {
    "instruction": "Show journal in export format for transfer",
    "output": "journalctl -o export"
  },
  {
    "instruction": "Monitor journal and execute script on new entries",
    "output": "journalctl -f -o json | while read line; do echo \"$line\"; done"
  },
  {
    "instruction": "Show journal fields and their values",
    "output": "journalctl --fields"
