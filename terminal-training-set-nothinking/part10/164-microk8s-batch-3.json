[
  {
    "instruction": "Enable registry addon",
    "output": "microk8s enable registry"
  },
  {
    "instruction": "Enable community addons",
    "output": "microk8s enable community"
  },
  {
    "instruction": "Add node to cluster with worker flag",
    "output": "microk8s join 192.168.1.10:25000/abc123 --worker"
  },
  {
    "instruction": "MicroK8s kubectl get services",
    "output": "microk8s kubectl get svc --all-namespaces"
  },
  {
    "instruction": "Join cluster as control plane",
    "output": "microk8s join node:25000/abc123"
  },
  {
    "instruction": "Start MicroK8s",
    "output": "microk8s start"
  },
  {
    "instruction": "Reset MicroK8s",
    "output": "microk8s reset"
  },
  {
    "instruction": "Enable storage addon",
    "output": "microk8s enable storage"
  },
  {
    "instruction": "View dashboard token",
    "output": "microk8s kubectl describe secret -n kube-system microk8s-dashboard-token"
  },
  {
    "instruction": "Get join token on control plane",
    "output": "microk8s add-node"
  },
  {
    "instruction": "Enable OpenEBS",
    "output": "microk8s enable openebs"
  },
  {
    "instruction": "Enable RBAC",
    "output": "microk8s enable rbac"
  },
  {
    "instruction": "List all pods across all namespaces",
    "output": "microk8s kubectl get all --all-namespaces"
  },
  {
    "instruction": "Enable GPU support",
    "output": "microk8s enable gpu"
  },
  {
    "instruction": "Enable cert-manager",
    "output": "microk8s enable cert-manager"
  },
  {
    "instruction": "Check MicroK8s status",
    "output": "microk8s status --wait-ready"
  },
  {
    "instruction": "MicroK8s kubectl get CRDs",
    "output": "microk8s kubectl get crds"
  },
  {
    "instruction": "MicroK8s kubectl logs",
    "output": "microk8s kubectl logs -n default deployment/nginx"
  },
  {
    "instruction": "Inspect MicroK8s",
    "output": "microk8s inspect"
  },
  {
    "instruction": "Stop MicroK8s",
    "output": "microk8s stop"
  },
  {
    "instruction": "MicroK8s kubectl expose deployment",
    "output": "microk8s kubectl expose deployment nginx --port 80 --type NodePort"
