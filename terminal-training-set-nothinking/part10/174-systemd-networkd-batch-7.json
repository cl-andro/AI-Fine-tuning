[
  {
    "instruction": "Set MAC address for an interface",
    "output": "printf '[Match]\\nName=eth0\\n[Link]\\nMACAddress=00:11:22:33:44:55\\n' > /etc/systemd/network/10-mac.network"
  },
  {
    "instruction": "Create a VXLAN netdev",
    "output": "printf '[NetDev]\\nName=vxlan100\\nKind=vxlan\\n[VXLAN]\\nId=100\\nRemote=10.0.0.1\\n' > /etc/systemd/network/15-vxlan.netdev"
  },
  {
    "instruction": "Configure DHCP with hostname",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCP=ipv4\\n[DHCPv4]\\nHostname=myhost\\n' > /etc/systemd/network/10-dhcp-hostname.network"
  },
  {
    "instruction": "Show link operational state",
    "output": "networkctl status eth0 --no-pager"
  },
  {
    "instruction": "Create a VLAN netdev",
    "output": "printf '[NetDev]\\nName=vlan10\\nKind=vlan\\n[VLAN]\\nId=10\\n' > /etc/systemd/network/15-vlan10.netdev"
  },
  {
    "instruction": "Set DHCP server on network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nDHCPServer=yes\\n' > /etc/systemd/network/10-dhcp-server.network"
  },
  {
    "instruction": "Reconfigure a network interface",
    "output": "networkctl reconfigure eth0"
  },
  {
    "instruction": "Create bridge port config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nBridge=br0\\n' > /etc/systemd/network/20-eth0-bridge-member.network"
  },
  {
    "instruction": "View networkd journal logs",
    "output": "journalctl -u systemd-networkd"
  },
  {
    "instruction": "Display networkd config file content",
    "output": "cat /etc/systemd/network/10-eth0.network"
  },
  {
    "instruction": "Create a static IP network config",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nAddress=192.168.1.100/24\\nGateway=192.168.1.1\\nDNS=8.8.8.8\\n' > /etc/systemd/network/10-eth0-static.network"
  },
  {
    "instruction": "Create bond member config for eth1",
    "output": "printf '[Match]\\nName=eth1\\n[Network]\\nBond=bond0\\n' > /etc/systemd/network/21-eth1-bond-member.network"
  },
  {
    "instruction": "Renew DHCP lease on an interface",
    "output": "networkctl renew eth0"
  },
  {
    "instruction": "Enable IPv6 privacy extensions",
    "output": "printf '[Network]\\nIPv6PrivacyExtensions=yes\\n' > /etc/systemd/network/10-ipv6-privacy.network"
  },
  {
    "instruction": "Configure DHCP use NTP from server",
    "output": "printf '[DHCPv4]\\nUseNTP=true\\n' > /etc/systemd/network/10-dhcp-ntp.network"
  },
  {
    "instruction": "Check status of a specific link",
    "output": "networkctl status eth0"
  },
  {
    "instruction": "Configure IPv6 on interface",
    "output": "printf '[Match]\\nName=eth0\\n[Network]\\nIPv6AcceptRA=yes\\nAddress=2001:db8::1/64\\nGateway=2001:db8::ff\\n' > /etc/systemd/network/10-ipv6.network"
  },
  {
    "instruction": "Enable networkd at boot",
    "output": "systemctl enable systemd-networkd"
  },
  {
    "instruction": "Configure wake on LAN",
    "output": "printf '[Link]\\nWakeOnLan=magic\\n' > /etc/systemd/network/10-wol.link"
  },
  {
    "instruction": "Create a dummy interface",
    "output": "printf '[NetDev]\\nName=dummy0\\nKind=dummy\\n' > /etc/systemd/network/10-dummy.netdev"
  },
  {
    "instruction": "Restart networkd service",
    "output": "systemctl restart systemd-networkd"
  }
]