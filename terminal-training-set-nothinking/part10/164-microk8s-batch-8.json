[
  {
    "instruction": "Enable Helm3",
    "output": "microk8s enable helm3"
  },
  {
    "instruction": "Enable Istio",
    "output": "microk8s enable istio"
  },
  {
    "instruction": "Enable community addons",
    "output": "microk8s enable community"
  },
  {
    "instruction": "Get pods in namespace",
    "output": "microk8s kubectl get pods -n default"
  },
  {
    "instruction": "Stop MicroK8s",
    "output": "microk8s stop"
  },
  {
    "instruction": "List all pods across all namespaces",
    "output": "microk8s kubectl get all --all-namespaces"
  },
  {
    "instruction": "MicroK8s kubectl create deployment",
    "output": "microk8s kubectl create deployment nginx --image nginx"
  },
  {
    "instruction": "MicroK8s kubectl logs",
    "output": "microk8s kubectl logs -n default deployment/nginx"
  },
  {
    "instruction": "Inspect MicroK8s",
    "output": "microk8s inspect"
  },
  {
    "instruction": "MicroK8s kubectl delete all",
    "output": "microk8s kubectl delete all --all -n default"
  },
  {
    "instruction": "MicroK8s kubectl top pods",
    "output": "microk8s kubectl top pods --all-namespaces"
  },
  {
    "instruction": "View dashboard token",
    "output": "microk8s kubectl describe secret -n kube-system microk8s-dashboard-token"
  },
  {
    "instruction": "MicroK8s kubectl expose deployment",
    "output": "microk8s kubectl expose deployment nginx --port 80 --type NodePort"
  },
  {
    "instruction": "MicroK8s kubectl exec",
    "output": "microk8s kubectl exec -it my-pod -- /bin/bash"
  },
  {
    "instruction": "Get join token on control plane",
    "output": "microk8s add-node"
  },
  {
    "instruction": "Leave a cluster",
    "output": "microk8s leave"
  },
  {
    "instruction": "Disable dashboard",
    "output": "microk8s disable dashboard"
  },
  {
    "instruction": "Enable fluentd",
    "output": "microk8s enable fluentd"
  },
  {
    "instruction": "MicroK8s kubectl get services",
    "output": "microk8s kubectl get svc --all-namespaces"
  },
  {
    "instruction": "Add node to cluster with worker flag",
    "output": "microk8s join 192.168.1.10:25000/abc123 --worker"
  },
  {
    "instruction": "Get MicroK8s cluster info",
    "output": "microk8s kubectl cluster-info"
  },
  {
    "instruction": "Start MicroK8s",
    "output": "microk8s start"
  },
  {
    "instruction": "MicroK8s kubectl port-forward",
    "output": "microk8s kubectl port-forward svc/my-service 8080:80"
  },
  {
    "instruction": "Enable dashboard with default auth",
    "output": "microk8s enable dashboard --no-check"
  },
  {
    "instruction": "Show MicroK8s config",
    "output": "microk8s config"
  }
