[
  {
    "instruction": "View boot loader configuration",
    "output": "cat /boot/loader/loader.conf"
  },
  {
    "instruction": "Create a UKI boot entry",
    "output": "printf 'title My UKI\\nefi /EFI/Linux/my-uki.efi\\n' > /boot/loader/entries/my-uki.conf"
  },
  {
    "instruction": "Check sd-boot current config",
    "output": "cat /boot/loader/entries.srel 2>/dev/null; echo '(type file)'"
  },
  {
    "instruction": "Set kernel-install layout to bls",
    "output": "printf 'layout=bls\\n' > /etc/kernel/install.conf"
  },
  {
    "instruction": "Add kernel with kernel-install and make-dracut",
    "output": "kernel-install add 6.2.0-1-amd64 /boot/vmlinuz-6.2.0-1-amd64"
  },
  {
    "instruction": "Add a kernel via kernel-install",
    "output": "kernel-install add 6.1.0-13-amd64 /boot/vmlinuz-6.1.0-13-amd64"
  },
  {
    "instruction": "Set default timeout in loader.conf",
    "output": "printf 'timeout 5\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "Set boot loader entry-whitelist",
    "output": "printf 'entry-whitelist custom\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "List all installed kernels",
    "output": "ls /boot/vmlinuz-*"
  },
  {
    "instruction": "Check if systemd-stub is in use",
    "output": "bootctl status | grep -i stub"
  },
  {
    "instruction": "Check bootloader status",
    "output": "bootctl status"
  },
  {
    "instruction": "Set default entry in loader.conf",
    "output": "printf 'default @current\\n' > /boot/loader/loader.conf"
  },
  {
    "instruction": "Set boot order to entries 0001,0002",
    "output": "efibootmgr -o 0001,0002"
  },
  {
    "instruction": "Check systemd-boot build ID",
    "output": "bootctl status | grep -i firmware"
  },
  {
    "instruction": "Check if secure boot is enabled",
    "output": "mokutil --sb-state"
  },
  {
    "instruction": "Show systemd-boot random seed status",
    "output": "bootctl random-seed"
  },
  {
    "instruction": "Check boot entries for UKI support",
    "output": "grep -l 'uki' /boot/loader/entries/*.conf 2>/dev/null"
  },
  {
    "instruction": "Set current kernel as default",
    "output": "bootctl set @current"
  },
  {
    "instruction": "Check kernel signature status",
    "output": "pesign -S -i /boot/vmlinuz-6.1.0-13-amd64 | grep -i sign"
  },
  {
    "instruction": "List all files in ESP partition",
    "output": "find /boot/efi -type f 2>/dev/null | head -30"
  },
  {
    "instruction": "Set next boot to UEFI entry 0001",
    "output": "efibootmgr -n 0001"
  },
  {
    "instruction": "View UKI file information",
    "output": "objdump -h /boot/efi/EFI/Linux/my-uki.efi 2>/dev/null | head -20"
  },
  {
    "instruction": "Set boot entry one-shot for next boot",
    "output": "bootctl set-oneshot @current"
  },
  {
    "instruction": "Check EFI boot entries",
    "output": "efibootmgr -v"
  }
]