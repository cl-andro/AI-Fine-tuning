[
  {
    "instruction": "Create portable image with os-release",
    "output": "mkdir -p /tmp/portable-build/usr/lib && echo 'ID=myapp\nVERSION_ID=1.0' > /tmp/portable-build/usr/lib/os-release && mksquashfs /tmp/portable-build /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Check status of portable service after attach",
    "output": "systemctl status myapp.service"
  },
  {
    "instruction": "Enable portable daemon at boot",
    "output": "systemctl enable systemd-portabled"
  },
  {
    "instruction": "Check systemd portable service status",
    "output": "systemctl is-active systemd-portabled.service"
  },
  {
    "instruction": "Attach a portable image",
    "output": "portablectl attach /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach portable with no profile validation",
    "output": "portablectl attach --profile=untrusted /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach portable image with a specific unit name prefix",
    "output": "portablectl attach --prefix=/usr/local /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Attach portable with read-only root",
    "output": "portablectl attach --property=ProtectSystem=yes /var/lib/portable/myapp.raw"
  },
  {
    "instruction": "Show help for portablectl",
    "output": "portablectl --help"
  },
  {
    "instruction": "List only detached portable images",
    "output": "portablectl list --detached"
