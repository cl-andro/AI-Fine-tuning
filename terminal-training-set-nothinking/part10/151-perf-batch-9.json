[
  {"instruction": "Archive perf data with build-ids", "output": "perf archive perf.data"},
  {"instruction": "Inject build-ids into perf data", "output": "perf inject -b -i perf.data -o perf.injected.data"},
  {"instruction": "Merge multiple perf data files", "output": "perf data merge perf.data.1 perf.data.2"},
  {"instruction": "Trim perf data to specific time range", "output": "perf data convert -i perf.data --to-ctf --time 10%,90%"},
  {"instruction": "Show perf data info", "output": "perf report -i perf.data --header --stdio | head -30"},
  {"instruction": "Display perf data file size", "output": "ls -lh perf.data"},
  {"instruction": "Check build-ids in perf data", "output": "perf buildid-list -i perf.data"},
  {"instruction": "List all perf data events", "output": "perf script -i perf.data -F event -D | sort -u"},
  {"instruction": "Show CPUs in perf data", "output": "perf report -i perf.data --header --stdio | grep 'Samples on CPU'"},
  {"instruction": "Display event counts from perf data", "output": "perf report -i perf.data --stat --stdio"},
  {"instruction": "Show event type distribution", "output": "perf report -i perf.data --group --stdio"},
  {"instruction": "Get number of samples in perf data", "output": "perf report -i perf.data --header --stdio | grep 'Samples'"},
  {"instruction": "Show perf.data loss events", "output": "perf report -i perf.data --stats --stdio | grep -i lost"},
  {"instruction": "Display perf.data with features", "output": "perf report -i perf.data --full-source-path --stdio"},
  {"instruction": "Demangle perf data symbols", "output": "perf report -i perf.data --demangle --stdio"},
  {"instruction": "Show report with inline info", "output": "perf report -i perf.data --inline --stdio"},
  {"instruction": "Display children self overhead", "output": "perf report -i perf.data --children --stdio"},
  {"instruction": "Show caller/callee in report", "output": "perf report -i perf.data --call-graph callee --stdio"},
  {"instruction": "Display report with total period", "output": "perf report -i perf.data --total-period --stdio"},
  {"instruction": "Show grouped events in report", "output": "perf report -i perf.data --group --stdio"},
  {"instruction": "Display report overhead per CPU", "output": "perf report -i perf.data --cpu 0,1 --stdio"},
  {"instruction": "Show symbol filters in report", "output": "perf report -i perf.data --symbols my_func --stdio"}
]