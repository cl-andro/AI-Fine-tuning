[
  {"instruction": "Trace ltrace with library and syscall", "output": "ltrace -S ls"},
  {"instruction": "Show library call count summary only", "output": "ltrace -c -C ls"},
  {"instruction": "Filter ltrace to include only printf family", "output": "ltrace -e 'printf+sprintf+fprintf' ls 2>&1 | head -10"},
  {"instruction": "Sort ltrace summary by call count", "output": "ltrace -c -S calls ls"},
  {"instruction": "Exclude specific library calls", "output": "ltrace -e '!strlen+memcpy' ls"},
  {"instruction": "Trace only calls returning a pointer", "output": "ltrace -e '@' ls 2>&1 | head -10"},
  {"instruction": "Show library function arguments in hex", "output": "ltrace -x ls 2>&1 | head -10"},
  {"instruction": "Long output with argument values for ltrace", "output": "ltrace -s 256 -n 2 ls"},
  {"instruction": "Indent nested calls in ltrace", "output": "ltrace -n 4 -e 'malloc+free' ls"},
  {"instruction": "Trace calls by PID with ltrace", "output": "ltrace -p 1234"},
  {"instruction": "Follow children with ltrace", "output": "ltrace -f ls"},
  {"instruction": "Log ltrace output to file", "output": "ltrace -o ltrace.log ls"},
  {"instruction": "Show system calls through ltrace", "output": "ltrace -S -o syscall.log ls"},
  {"instruction": "Alias ltrace output for specific lib", "output": "ltrace -l libc.so.6 -e malloc ls"},
  {"instruction": "Only trace from one library in ltrace", "output": "ltrace -l /lib/x86_64-linux-gnu/libc-2.31.so ls"},
  {"instruction": "Trace demangled C++ symbols", "output": "ltrace -C ./cpp_app"},
  {"instruction": "Show ltrace version", "output": "ltrace --version"},
  {"instruction": "Show ltrace help", "output": "ltrace --help | head -30"},
  {"instruction": "Install strace on Debian", "output": "apt-get install -y strace ltrace"},
  {"instruction": "Check strace version", "output": "strace --version"},
  {"instruction": "Check strace help for PID", "output": "strace --help 2>&1 | grep -i pid"},
  {"instruction": "Show strace command help", "output": "strace --help 2>&1 | head -40"}
]