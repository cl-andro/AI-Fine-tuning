[
  {
    "instruction": "Restart a service",
    "output": "systemctl restart nginx.service"
  },
  {
    "instruction": "Show specific property of a unit",
    "output": "systemctl show -p ConditionPathExists nginx.service"
  },
  {
    "instruction": "List all wants directories",
    "output": "ls -d /etc/systemd/system/*.wants/"
  },
  {
    "instruction": "Check if a service has failed",
    "output": "systemctl is-failed nginx.service"
  },
  {
    "instruction": "Set CPU shares property on a unit",
    "output": "systemctl set-property nginx.service CPUShares=512"
  },
  {
    "instruction": "Create override to set restart limit",
    "output": "printf '[Service]\\nStartLimitIntervalSec=30\\nStartLimitBurst=3\\n' | sudo tee /etc/systemd/system/nginx.service.d/restart.conf"
  },
  {
    "instruction": "Disable service from starting at boot",
    "output": "systemctl disable nginx.service"
  },
  {
    "instruction": "Dump full systemd manager state",
    "output": "systemctl dump"
  },
  {
    "instruction": "List wants symlinks in multi-user target",
    "output": "ls /etc/systemd/system/multi-user.target.wants/"
  },
  {
    "instruction": "List all masked unit files",
    "output": "systemctl list-unit-files --state=masked"
  },
  {
    "instruction": "Set memory limit on a unit",
    "output": "systemctl set-property nginx.service MemoryMax=512M"
  },
  {
    "instruction": "Restart service only if running",
    "output": "systemctl try-restart nginx.service"
  },
  {
    "instruction": "List system sockets",
    "output": "systemctl list-sockets"
  },
  {
    "instruction": "List enabled and disabled service unit files",
    "output": "systemctl list-unit-files --type=service --state=enabled,disabled"
  },
  {
    "instruction": "Edit unit file directly as full file",
    "output": "systemctl edit --full nginx.service"
  },
  {
    "instruction": "Reenable service (disable then enable)",
    "output": "systemctl reenable nginx.service"
  },
  {
    "instruction": "Add SSH as required for multi-user target",
    "output": "systemctl add-requires multi-user.target ssh.service"
  },
  {
    "instruction": "Reload a service without restarting",
    "output": "systemctl reload nginx.service"
  },
  {
    "instruction": "Create drop-in directory for overrides",
    "output": "mkdir -p /etc/systemd/system/nginx.service.d"
  },
  {
    "instruction": "List all installed unit files",
    "output": "systemctl list-unit-files"
  },
  {
    "instruction": "List all unit files by state and type",
    "output": "systemctl list-unit-files --type=service --state=indirect,generated"
  },
  {
    "instruction": "Check systemd-analyze for unit config verify",
    "output": "systemd-analyze verify nginx.service"
  },
  {
    "instruction": "Link a unit file from another location",
    "output": "systemctl link /opt/nginx/nginx.service"
  },
  {
    "instruction": "Send signal to a service process",
    "output": "systemctl kill -s HUP nginx.service"
  },
  {
    "instruction": "Read full unit file from etc",
    "output": "cat /etc/systemd/system/nginx.service"
  }
]