  {"instruction": "Display report sorted by dso", "output": "perf report -s dso --stdio"},
  {"instruction": "Show report with branch stacks", "output": "perf report -b --stdio"},
  {"instruction": "Display report with branch history", "output": "perf report -B --stdio"},
  {"instruction": "Show report with memory access info", "output": "perf report -M --stdio"},
  {"instruction": "Display report with instruction samples", "output": "perf report -I --stdio"},
  {"instruction": "Show report with weighted samples", "output": "perf report -w --stdio"},
  {"instruction": "Display report with raw trace", "output": "perf report -R --stdio"},
  {"instruction": "Show report for perf.data file", "output": "perf report -i perf.data --stdio"},
