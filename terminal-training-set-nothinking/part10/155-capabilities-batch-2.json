[
  {"instruction": "Check capabilities on system binaries", "output": "getcap /usr/bin/* /bin/* 2>/dev/null"},
  {"instruction": "Find files with setuid AND capabilities", "output": "getcap -r / 2>/dev/null | grep -v '=' | head -20"},
  {"instruction": "Find all files with capabilities set", "output": "getcap -r / 2>/dev/null | grep -v 'no capabilities'"},
  {"instruction": "Check capabilities of a running process by name", "output": "getpcaps $(pgrep -x sshd)"},
  {"instruction": "Display all process capabilities decoded", "output": "grep Cap /proc/1/status | while read l; do echo \"$l -> $(capsh --decode=$(echo $l|awk '{print $2}'))\"; done"},
  {"instruction": "Drop all capabilities for a command", "output": "capsh --drop=all -- -c \"echo 'running with no caps'\""},
  {"instruction": "Keep permitted set across exec", "output": "capsh --keep=1 -- -c \"/usr/bin/getpcaps $$\""},
  {"instruction": "Ambient capabilities for non-root user", "output": "capsh --keep=1 --user=nobody --addamb=cap_net_raw -- -c \"capsh --print\""},
  {"instruction": "Set ambient cap for ping from non-root", "output": "capsh --keep=1 --user=nobody --addamb=cap_net_raw -- -c \"/bin/ping -c 1 127.0.0.1\""},
  {"instruction": "Drop capability from bounding set", "output": "capsh --drop=cap_sys_admin -- -c \"capsh --print | grep Bounding\""},
  {"instruction": "Lock the bounding set (cannot regain)", "output": "capsh --drop=cap_sys_module --locked -- -c \"echo locked\""},
  {"instruction": "Check cap_last_cap for kernel limit", "output": "cat /proc/sys/kernel/cap_last_cap"},
  {"instruction": "Decode specific capability bits", "output": "python3 -c \"caps=open('/proc/self/status').read().split('\\n'); print(\\\"\\n\\\".join([l for l in caps if 'Cap' in l]))\""},
  {"instruction": "Set file cap and verify with getcap", "output": "setcap cap_net_raw+ep /bin/ping && getcap /bin/ping"},
  {"instruction": "Remove capability from file silently", "output": "setcap -r /bin/ping 2>/dev/null"},
  {"instruction": "Set capability with no effective bit", "output": "setcap cap_net_raw+p /bin/myapp"},
  {"instruction": "Test if current process has CAP_NET_ADMIN", "output": "capsh --has-cap=cap_net_admin && echo 'yes' || echo 'no'"},
  {"instruction": "Current process effective capability check", "output": "capsh --has-cap=cap_net_raw$$"},
  {"instruction": "Display human readable process capabilities", "output": "capsh --print 2>&1 | grep -E 'Current|Bounding|Secure|Ambient'"},
  {"instruction": "Compare two capability sets", "output": "capsh --drop=cap_chown -- -c \"capsh --print | grep Current\""},
  {"instruction": "Set capability with specific file flags", "output": "setcap cap_net_raw=ep /bin/ping"},
  {"instruction": "View capabilities in hex", "output": "cat /proc/self/status | grep CapEff"}
]