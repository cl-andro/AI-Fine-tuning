  {"instruction": "Fault injection on specific syscall", "output": "strace -e fault=openat:error=ENOENT cat /tmp/nonexistent"},
  {"instruction": "Inject multiple errors selectively", "output": "strace -e trace=openat -e fault=openat:error=EACCES:when=3 cat /dev/null"},
  {"instruction": "Retry failed syscall three times", "output": "strace -e trace=openat -e inject=openat:retry=3 ls"},
  {"instruction": "Error injection with probability", "output": "strace -e fault=openat:error=ENOENT:when=50% ls"},
