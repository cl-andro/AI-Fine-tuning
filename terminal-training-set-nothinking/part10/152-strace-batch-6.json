[
  {"instruction": "Monitor file writes with full data dump", "output": "strace -e write -s 4096 -xx ls 2>&1 | head -30"},
  {"instruction": "Show read return values only", "output": "strace -e trace=read -e status=successful ls"},
  {"instruction": "Show failed syscalls only", "output": "strace -e trace=openat -e status=failed ls /nonexistent"},
  {"instruction": "Summarize failed syscalls across run", "output": "strace -c -e status=bad ls /nonexistent 2>&1"},
