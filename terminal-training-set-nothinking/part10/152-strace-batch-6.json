  {"instruction": "Monitor signal masks", "output": "strace -e trace=rt_sigprocmask sleep 1"},
  {"instruction": "Trace real-time signal usage", "output": "strace -e trace=rt_sigqueueinfo ls"},
  {"instruction": "Decode sigset_t in output", "output": "strace -v -e trace=rt_sigaction sleep 1 2>&1 | head -15"},
  {"instruction": "Show pending signals list", "output": "strace -e trace=rt_sigpending sleep 1 2>&1 | head -10"},
  {"instruction": "Trace sigsuspend and sigwaitinfo", "output": "strace -e trace=rt_sigsuspend,rt_sigtimedwait sleep 1"},
