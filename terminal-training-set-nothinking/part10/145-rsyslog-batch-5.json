[
  {"instruction": "Use rsyslog to forward local7 facility to a remote server", "output": "echo 'local7.* @192.168.1.100:514' >> /etc/rsyslog.d/local7_forward.conf"},
  {"instruction": "Create syslog-ng template for RFC 3164 format", "output": "echo 'template t_rfc3164 { template(\"%PRI% %TIMESTAMP% %HOST% %MSG%\"); };' >> /etc/syslog-ng/conf.d/rfc3164.conf"},
  {"instruction": "Set up rsyslog to drop messages with a specific hostname", "output": "echo ':hostname, isequal, \"localhost\" ~' >> /etc/rsyslog.d/drop_localhost.conf"},
  {"instruction": "Configure syslog-ng with Redis output destination", "output": "echo 'destination d_redis { redis(host(\"localhost\") port(6379) command(\"LPUSH\" \"syslog\" \"${MSG}\")); };' >> /etc/syslog-ng/conf.d/redis_dest.conf"},
  {"instruction": "Set up rsyslog to use a specific timezone in timestamps", "output": "echo 'template(name=\"TimeZone\" type=\"string\" string=\"%TIMESTAMP:::date-rfc3339% %HOSTNAME% %syslogtag%%msg%\\n\")' > /etc/rsyslog.d/timezone.conf && echo '$ActionFileDefaultTemplate TimeZone' >> /etc/rsyslog.d/timezone.conf"},
  {"instruction": "Create syslog-ng rewrite to mask card numbers", "output": "echo 'rewrite r_mask_cc { subst(\"([0-9]{4}-){3}[0-9]{4}\", \"XXXX-XXXX-XXXX-XXXX\", value(\"MSG\")); };' >> /etc/syslog-ng/conf.d/mask_cc.conf"},
  {"instruction": "Use rsyslog to aggregate logs from multiple files", "output": "echo 'module(load=\"imfile\")' > /etc/rsyslog.d/aggregate.conf && echo 'input(type=\"imfile\" File=\"/var/log/nginx/*.log\" Tag=\"nginx\")' >> /etc/rsyslog.d/aggregate.conf"},
  {"instruction": "Configure syslog-ng to log in JSON with host and program", "output": "echo 'template t_json_full { template(\"{\\\"@timestamp\\\":\\\"${ISODATE}\\\",\\\"host\\\":\\\"${HOST}\\\",\\\"program\\\":\\\"${PROGRAM}\\\",\\\"message\\\":\\\"${MSG}\\\"}\\n\"); };' >> /etc/syslog-ng/conf.d/json_full.conf"},
  {"instruction": "Set up rsyslog to send SNMP traps on critical errors", "output": "echo 'module(load=\"omsnmp\")' > /etc/rsyslog.d/snmp.conf && echo 'action(type=\"omsnmp\" server=\"192.168.1.100\")' >> /etc/rsyslog.d/snmp.conf"},
  {"instruction": "Create syslog-ng log path with embedded parser", "output": "echo 'log { source(s_sys); parser(p_kv); destination(d_json); };' >> /etc/syslog-ng/conf.d/parser_logpath.conf"},
  {"instruction": "Use rsyslog for RFC 3195 (COOKED) logging", "output": "echo 'module(load=\"omcooked\")' > /etc/rsyslog.d/cooked.conf"},
  {"instruction": "Configure syslog-ng with RabbitMQ AMQP output", "output": "echo 'destination d_amqp { amqp(host(\"localhost\") port(5672) vhost(\"/\") username(\"guest\") password(\"guest\") exchange(\"syslog\") exchange_type(\"topic\") routing_key(\"syslog.info\")); };' >> /etc/syslog-ng/conf.d/amqp.conf"},
  {"instruction": "Set up rsyslog to separate logs by a specific tag", "output": "echo ':syslogtag, startswith, \"python:\" /var/log/python.log' >> /etc/rsyslog.d/python_tag.conf"},
  {"instruction": "Create syslog-ng rewrite to normalize message format", "output": "echo 'rewrite r_normalize { subst(\"\\t\", \" \", value(\"MSG\")); };' >> /etc/syslog-ng/conf.d/normalize_rewrite.conf"},
  {"instruction": "Use rsyslog to forward all messages except debug", "output": "echo '*.info @192.168.1.100:514' >> /etc/rsyslog.d/info_forward.conf"},
  {"instruction": "Configure syslog-ng to collect logs from Windows Event Log", "output": "echo 'source s_windows { udp(port(519)); };' >> /etc/syslog-ng/conf.d/windows_source.conf"},
  {"instruction": "Set up rsyslog with circular buffering", "output": "echo 'global(circularBufferSize=\"50000\")' > /etc/rsyslog.d/circular.conf"},
  {"instruction": "Use syslog-ng to compress log files on disk", "output": "echo 'options { compress(level(9)); };' >> /etc/syslog-ng/conf.d/compress_opts.conf"},
  {"instruction": "Create rsyslog config to log all to a single remote server", "output": "echo '*.* @192.168.1.100:514' > /etc/rsyslog.d/single_forward.conf && echo '*.* @@192.168.1.100:514' >> /etc/rsyslog.d/single_forward.conf"},
  {"instruction": "Configure syslog-ng to use multiple CPU cores", "output": "echo 'options { threaded(yes); };' >> /etc/syslog-ng/conf.d/threaded.conf"},
  {"instruction": "Initialize rsyslog working directory for queues", "output": "echo 'global(workDirectory=\"/var/spool/rsyslog\")' > /etc/rsyslog.d/workdir.conf"},
  {"instruction": "Set up syslog-ng to parse JSON messages automatically", "output": "echo 'parser p_json { json-parser(); };' >> /etc/syslog-ng/conf.d/json_parser.conf"},
  {"instruction": "Use rsyslog to log based on message ID", "output": "echo ':msgid, isequal, \"TCPIN\" /var/log/tcp_connections.log' >> /etc/rsyslog.d/msgid.conf"},
  {"instruction": "Configure syslog-ng to use HDFS output", "output": "echo 'destination d_hdfs { hdfs(uri(\"hdfs://namenode:8020/user/syslog/\")); };' >> /etc/syslog-ng/conf.d/hdfs.conf"},
  {"instruction": "Restart rsyslog with debug output to stdout", "output": "rsyslogd -N1 -d > /tmp/rsyslog_debug.log 2>&1"}
]
