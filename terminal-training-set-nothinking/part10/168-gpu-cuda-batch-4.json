    "instruction": "Query GPU info for X configuration",
    "output": "nvidia-xconfig --query-gpu-info"
  },
  {
    "instruction": "Check if GPU persistence mode is enabled",
    "output": "nvidia-smi -q -d PERSISTENCE_MODE"
  },
  {
    "instruction": "Show NVLink capabilities",
    "output": "nvidia-smi nvlink -c"
  },
  {
    "instruction": "Display NVLink error counters",
    "output": "nvidia-smi nvlink -e"
  },
  {
    "instruction": "Set GPU clocks to maximum performance",
    "output": "nvidia-smi -acp MAX"
  },
  {
    "instruction": "Show GPU memory mapped IO region",
    "output": "lspci -v -d 10de: | grep -i memory"
  },
  {
    "instruction": "Show GPU topology in CPU affinity format",
    "output": "nvidia-smi topo -m -c"
  },
  {
    "instruction": "Load nvidia driver with debug registry key",
    "output": "sudo modprobe nvidia NVreg_RegistryDwords=\"RMHwDebugInfo=1\""
  },
  {
    "instruction": "Enable persistence mode on all GPUs",
    "output": "nvidia-smi -pm 1"
  },
  {
    "instruction": "Check nvidia driver loaded parameters",
    "output": "cat /sys/module/nvidia/parameters/*"
  },
  {
    "instruction": "Enable MIG mode on GPU 0",
    "output": "nvidia-smi -i 0 -mig 1"
  },
  {
    "instruction": "Show GPU UUID",
    "output": "nvidia-smi --query-gpu=uuid --format=csv"
  },
  {
    "instruction": "Display GPU index paired with PCI bus ID",
    "output": "nvidia-smi --query-gpu=index,pci.bus_id --format=csv"
  },
  {
    "instruction": "Show nvidia driver version",
    "output": "nvidia-smi --query-gpu=driver_version --format=csv"
  },
  {
    "instruction": "Display GPU memory bandwidth info",
    "output": "nvidia-smi -q -d MEMORY | grep -i bandwidth"
  },
  {
    "instruction": "Show GPU compute mode",
    "output": "nvidia-smi --query-gpu=compute_mode --format=csv"
  },
  {
    "instruction": "Show GPU affinity for running processes",
    "output": "nvidia-smi topo -a"
  },
  {
    "instruction": "Display ECC mode for all GPUs",
    "output": "nvidia-smi --query-gpu=ecc.mode.current,ecc.errors.uncorrected.total --format=csv"
  },
  {
    "instruction": "Set GPU fan speed to 80 percent",
    "output": "nvidia-settings -a GPUFanControlState=1 -a GPUTargetFanSpeed=80"
  },
  {
    "instruction": "Check if MIG mode is currently enabled",
    "output": "nvidia-smi --query-gpu=mig.mode.current --format=csv"
  },
  {
    "instruction": "Show GPU framebuffer memory usage",
    "output": "nvidia-smi --query-gpu=memory.total,memory.free,memory.used --format=csv"
  },
  {
    "instruction": "Disable MIG mode on GPU 0",
    "output": "nvidia-smi -i 0 -mig 0"
  }
