[
  {
    "instruction": "Set DNS over TLS for interface",
    "output": "resolvectl dnsovertls eth0 true"
  },
  {
    "instruction": "View resolved journal logs",
    "output": "journalctl -u systemd-resolved"
  },
  {
    "instruction": "Check DNSSEC setting for an interface",
    "output": "resolvectl dnssec eth0"
  },
  {
    "instruction": "Set DNS search domain for interface",
    "output": "resolvectl domain eth0 example.com"
  },
  {
    "instruction": "Query TXT record for domain",
    "output": "resolvectl query --type=TXT example.com"
  },
  {
    "instruction": "Check which interface handles a domain",
    "output": "resolvectl query example.com | grep -i link"
  },
  {
    "instruction": "Check resolved service status",
    "output": "systemctl status systemd-resolved"
  },
  {
    "instruction": "Query all record types for a domain",
    "output": "resolvectl query --type=ANY example.com"
  },
  {
    "instruction": "Flush all DNS caches",
    "output": "resolvectl flush-caches"
  },
  {
    "instruction": "Query SRV record with service and proto",
    "output": "resolvectl query --type=SRV _ldap._tcp.example.com"
  },
  {
    "instruction": "Set read-ethers for mDNS",
    "output": "resolvectl mdns eth0 resolve"
  },
  {
    "instruction": "Disable mDNS on an interface",
    "output": "resolvectl mdns eth0 no"
  },
  {
    "instruction": "Point /etc/resolv.conf to stub resolver",
    "output": "ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"
  },
  {
    "instruction": "Show all search domains per link",
    "output": "resolvectl domain --all"
  },
  {
    "instruction": "Check which DNS server resolved a query",
    "output": "resolvectl query example.com --no-pager"
  },
  {
    "instruction": "Query a specific record type (SRV) for service",
    "output": "resolvectl query --type=SRV _http._tcp.example.com"
  },
  {
    "instruction": "Query DNS statistics",
    "output": "resolvectl statistics"
  },
  {
    "instruction": "Show all DNS server info per link",
    "output": "resolvectl dns --all"
  },
  {
    "instruction": "Perform multicast DNS query",
    "output": "resolvectl query --type=AAAA myhost.local"
  },
  {
    "instruction": "Set DNS cache negative TTL",
    "output": "printf '[Resolve]\\nCacheNegativeTTL=10\\n' >> /etc/systemd/resolved.conf"
  },
  {
    "instruction": "Set multiple search domains",
    "output": "resolvectl domain eth0 example.com example.org"
  },
  {
    "instruction": "Set default DNS server for all interfaces",
    "output": "resolvectl dns 8.8.8.8"
  }
]