[
  {"instruction": "Print instruction pointer with syscalls", "output": "strace -i ls"},
  {"instruction": "Show syscall success/failure exit codes", "output": "strace -e trace=openat ls 2>&1 | grep -E '= [0-9]+|-1'"},  
  {"instruction": "Summarise syscall statistics with calls and errors", "output": "strace -c -S calls ls"},
  {"instruction": "Sort ctrace summary by syscall name", "output": "strace -c -S name ls"},
  {"instruction": "Show syscall count per process", "output": "strace -c -p 1234"},
  {"instruction": "Follow clones with syscall filtering", "output": "strace -f -e trace=process ls"},
  {"instruction": "Replace strace output with column format", "output": "strace -c -w ls"},
  {"instruction": "Log to file with each PID separate", "output": "strace -ff -o log ls"},
  {"instruction": "Show only write syscalls with content", "output": "strace -e write -s 512 ls 2>&1 | head -20"},
  {"instruction": "Monitor file operations excluding success", "output": "strace -e trace=openat,read,write -e fault=openat:error=ENOENT:when=1 ls"},
  {"instruction": "Inject fault into every 5th openat call", "output": "strace -e trace=openat -e fault=openat:error=EACCES:when=5 ls"},
  {"instruction": "Delay each openat call by 100ms", "output": "strace -e trace=openat -e inject=openat:delay_us=100000 ls"},
  {"instruction": "Retry failed syscalls with timing info", "output": "strace -e trace=openat -e inject=openat:retry=3 ls"},
  {"instruction": "Decode netlink sockets", "output": "strace -e trace=network -e decode-fds=all ip link"},
  {"instruction": "Trace unix domain sockets", "output": "strace -e trace=%unix nc -lU /tmp/test.sock"},
  {"instruction": "Trace raw signal values", "output": "strace -e trace=signal -x kill -9 1"},
  {"instruction": "Send output to both file and stderr", "output": "strace -o /dev/stderr -e write ls"},
  {"instruction": "Suppress header and timestamps", "output": "strace -qq ls"},
  {"instruction": "Minimal output with only errors", "output": "strace -Z ls 2>&1 | head -10"},
  {"instruction": "Detach after specified number of syscalls", "output": "strace -P /tmp/test -e trace=openat -O 5 ls"},
  {"instruction": "Start tracing after N syscalls", "output": "strace -S 100 -e write ls 2>&1 | head -20"},
  {"instruction": "Enable stack traces with each syscall", "output": "strace -k ls 2>&1 | head -40"}
]