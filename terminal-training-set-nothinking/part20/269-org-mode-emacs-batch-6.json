[
  {"instruction": "How to export Org to HTML with a navigation bar", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-preamble \"<nav><a href=\\\"index.html\\\">Home</a></nav>\")' --funcall org-html-export-to-html"},
  {"instruction": "How to export Org to LaTeX with a custom font size", "output": "emacs --batch --visit=doc.org --eval '(setq org-latex-classes (list (list \"myarticle\" \"\\\\documentclass[12pt]{article}\" (org-get-latex-classes))))' --funcall org-latex-export-to-pdf"},
  {"instruction": "How to execute all code and tangle in one command", "output": "emacs --batch --visit=code.org --eval '(org-babel-execute-buffer)' --eval '(org-babel-tangle)'"},
  {"instruction": "How to execute babel blocks without confirmation", "output": "emacs --batch --visit=code.org --eval '(setq org-confirm-babel-evaluate nil)' --eval '(org-babel-execute-buffer)'"},
  {"instruction": "How to load babel languages from the command line", "output": "emacs --batch --eval '(org-babel-do-load-languages (quote org-babel-load-languages) (quote ((python . t) (shell . t))))' --visit=code.org --eval '(org-babel-execute-buffer)'"},
  {"instruction": "How to publish a project and then open the result", "output": "emacs --batch --eval '(org-publish-all t)'"},
  {"instruction": "How to set the base directory for org-publish", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"site\" :base-directory \"~/org/\" :publishing-directory \"~/public_html/\" :publishing-function (quote org-html-publish-to-html))))) (org-publish-all t))'"},
  {"instruction": "How to set the HTML head tag for analytics", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-head \"<script async src=\\\"https://analytics.js\\\"></script>\")' --funcall org-html-export-to-html"},
  {"instruction": "How to embed SVG in Org HTML export", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-htmlize-output-type (quote inline-css))' --funcall org-html-export-to-html"},
  {"instruction": "How to set a custom LaTeX class for beamer", "output": "emacs --batch --visit=slides.org --eval '(setq org-beamer-theme \"metropolis\")' --funcall org-beamer-export-to-pdf"},
  {"instruction": "How to disable section numbers in export", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-section-numbers nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to set the level of headings to include", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-headline-levels 3)' --funcall org-html-export-to-html"},
  {"instruction": "How to preserve line breaks in Org export", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-preserve-breaks t)' --funcall org-html-export-to-html"},
  {"instruction": "How to set a custom time format for deadlines", "output": "emacs --batch --visit=tasks.org --eval '(setq org-deadline-warning-days 14)' --funcall org-batch-agenda"},
  {"instruction": "How to set the agenda span for batch agenda", "output": "emacs --batch --eval '(org-batch-agenda \"a\" org-agenda-span (quote week))'"},
  {"instruction": "How to list all agenda files from the command line", "output": "emacs --batch --eval '(require '\\''org-agenda)' --eval '(princ org-agenda-files)'"},
  {"instruction": "How to add a file to the agenda list", "output": "emacs --batch --eval '(org-agenda-file-to-front \"~/org/work.org\")'"},
  {"instruction": "How to remove a file from the agenda list", "output": "emacs --batch --eval '(org-remove-file \"~/org/work.org\")'"},
  {"instruction": "How to generate a tags-todo agenda", "output": "emacs --batch --eval '(org-batch-agenda \"m\" org-tags-match-list-sublevels t)'"},
  {"instruction": "How to generate a list of deadlines", "output": "emacs --batch --eval '(org-batch-agenda \"d\")'"},
  {"instruction": "How to show your daily schedule from Org", "output": "emacs --batch --eval '(org-batch-agenda \"a\")'"},
  {"instruction": "How to export with a specific Org buffer language", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-language \"fr\")' --funcall org-html-export-to-html"},
  {"instruction": "How to enable Org special editing features", "output": "emacs --batch --visit=doc.org --eval '(org-special-edit)'"},
  {"instruction": "How to open an org-mode file in a specific Emacs config", "output": "emacs --batch --load=~/.emacs.d/org-config.el --visit=doc.org --funcall org-html-export-to-html"},
  {"instruction": "How to build all snippets in an Org file", "output": "emacs --batch --visit=doc.org --eval '(org-sbe)'"}
]