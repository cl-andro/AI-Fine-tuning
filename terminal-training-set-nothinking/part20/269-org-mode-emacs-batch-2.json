[
  {"instruction": "How to export an Org file to EPUB format", "output": "emacs --batch --visit=book.org --funcall org-epub-export-to-epub"},
  {"instruction": "How to export Org to Texinfo", "output": "emacs --batch --visit=manual.org --funcall org-texinfo-export-to-texinfo"},
  {"instruction": "How to export Org to groff man page", "output": "emacs --batch --visit=man.org --funcall org-man-export-to-man"},
  {"instruction": "How to execute only Python source blocks in Babel", "output": "emacs --batch --visit=code.org --eval '(org-babel-map-src-blocks nil (when (string= \"python\" org-babel-current-src-block-lang) (org-babel-execute-src-block)))'"},
  {"instruction": "How to tangle source files to a specific directory", "output": "emacs --batch --visit=code.org --eval '(setq org-babel-tangle-use-relative-file-links nil)' --eval '(org-babel-tangle)'"},
  {"instruction": "How to publish only modified files in an Org project", "output": "emacs --batch --eval '(org-publish-all t)'"},
  {"instruction": "How to publish a project with a specific publishing function", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"site\" :base-directory \"~/org\" :publishing-directory \"~/public_html\" :publishing-function org-html-publish-to-html)))) (org-publish \"site\" t))'"},
  {"instruction": "How to export Org with a custom LaTeX class", "output": "emacs --batch --visit=paper.org --eval '(add-to-list '\\''org-latex-classes (list \"myclass\" \"\\\\documentclass{myclass}\" (org-get-latex-classes)))' --funcall org-latex-export-to-pdf"},
  {"instruction": "How to execute a shell command in eshell from batch", "output": "emacs --batch --eval '(eshell-command \"echo batch-test > /tmp/result.txt\")'"},
  {"instruction": "How to batch export all org files in a directory", "output": "emacs --batch --eval '(dolist (f (directory-files \"~/org\" t \"\\.org$\")) (with-current-buffer (find-file-noselect f) (org-html-export-to-html)))'"},
  {"instruction": "How to generate a sparse tree agenda", "output": "emacs --batch --eval '(org-batch-agenda \"s\" org-agenda-span (quote month))'"},
  {"instruction": "How to generate a block agenda view", "output": "emacs --batch --eval '(org-batch-agenda \"#\")'"},
  {"instruction": "How to evaluate a lisp expression in an org buffer", "output": "emacs --batch --visit=example.org --eval '(org-ctrl-c-ctrl-c)'"},
  {"instruction": "How to run an Emacs Lisp file with debug output", "output": "emacs --batch --load=script.el --debug-init"},
  {"instruction": "How to export a region of an Org file", "output": "emacs --batch --visit=doc.org --eval '(org-export-region-as-html)'"},
  {"instruction": "How to convert Org to markdown with Pandoc style", "output": "emacs --batch --visit=doc.org --eval '(setq org-md-headline-style (quote atx))' --funcall org-md-export-to-markdown"},
  {"instruction": "How to insert a timestamp programmatically", "output": "emacs --batch --eval '(insert (format-time-string \"<%%Y-%%m-%%d %%a>\"))'"},
  {"instruction": "How to count words in an Org buffer", "output": "emacs --batch --visit=doc.org --eval '(count-words (point-min) (point-max))'"},
  {"instruction": "How to show the Org export dispatcher", "output": "emacs --batch --visit=doc.org --eval '(org-export-dispatch)'"},
  {"instruction": "How to export with a custom in-buffer setting", "output": "emacs --batch --visit=doc.org --eval '(org-export-html-with-tags nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to evaluate all babel blocks in specific language", "output": "emacs --batch --visit=code.org --eval '(org-babel-execute-buffer)' --eval '(save-some-buffers t)'"},
  {"instruction": "How to strip export metadata from output", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-creator nil org-export-with-date nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to execute a babel block by name", "output": "emacs --batch --visit=code.org --eval '(org-babel-execute-src-block nil (org-babel-src-block-namer \"my-block\"))'"},
  {"instruction": "How to show the list of available export backends", "output": "emacs --batch --eval '(require '\\''ox)' --eval '(message (mapconcat #'symbol-name ox-export-backends \", \"))'"},
  {"instruction": "How to upgrade Org mode from ELPA", "output": "emacs --batch --eval '(package-refresh-contents)' --eval '(package-install (quote org))'"}
]