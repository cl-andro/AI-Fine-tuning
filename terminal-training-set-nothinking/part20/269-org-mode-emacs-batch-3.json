[
  {"instruction": "How to export Org file to HTML with a CSS file", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-head \"<link rel=\\\"stylesheet\\\" href=\\\"style.css\\\">\")' --funcall org-html-export-to-html"},
  {"instruction": "How to export Org to LaTeX with a specific document class", "output": "emacs --batch --visit=paper.org --eval '(setq org-latex-classes (cons (list \"article\" \"\\\\documentclass[11pt]{article}\" (org-get-latex-classes)) org-latex-classes))' --funcall org-latex-export-to-pdf"},
  {"instruction": "How to batch export to multiple formats at once", "output": "emacs --batch --visit=doc.org --funcall org-html-export-to-html --funcall org-latex-export-to-pdf --funcall org-md-export-to-markdown"},
  {"instruction": "How to execute shell commands as org babel blocks", "output": "emacs --batch --visit=script.org --eval '(org-babel-execute-buffer)'"},
  {"instruction": "How to evaluate only the source block at point", "output": "emacs --batch --visit=code.org --eval '(save-excursion (org-babel-previous-src-block) (org-babel-execute-src-block))'"},
  {"instruction": "How to publish only a subtree from a file", "output": "emacs --batch --visit=doc.org --eval '(org-publish-subtree)'"},
  {"instruction": "How to force publishing even if unchanged", "output": "emacs --batch --eval '(org-publish-all nil)'"},
  {"instruction": "How to export with customized date format", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-date-timestamp-format \"%%Y-%%m-%%d\")' --funcall org-html-export-to-html"},
  {"instruction": "How to use a specific org-publish-project", "output": "emacs --batch --eval '(org-publish \"notes\" t)'"},
  {"instruction": "How to list all org-publish projects", "output": "emacs --batch --eval '(message (mapconcat #'car org-publish-project-alist \"\\n\"))'"},
  {"instruction": "How to run eshell interactively in batch mode", "output": "emacs --batch --eval '(eshell t)' --eval '(eshell-command \"pwd\")' --eval '(kill-emacs)'"},
  {"instruction": "How to evaluate a script with org-mode loaded", "output": "emacs --batch --load=~/.emacs.d/init.el --visit=doc.org --funcall org-html-export-to-html"},
  {"instruction": "How to set org-export-headline-levels" , "output": "emacs --batch --visit=doc.org --eval '(setq org-export-headline-levels 4)' --funcall org-html-export-to-html"},
  {"instruction": "How to set the export language", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-language \"de\")' --funcall org-html-export-to-html"},
  {"instruction": "How to exclude tags from export", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-tags nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to include the table of contents in export", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-toc t)' --funcall org-html-export-to-html"},
  {"instruction": "How to set the HTML validation for export", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-validation-link nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to export org as a reveal.js presentation", "output": "emacs --batch --visit=slides.org --funcall org-re-reveal-export-to-html"},
  {"instruction": "How to run an org-mode hook from command line", "output": "emacs --batch --visit=file.org --eval '(run-hooks (quote org-mode-hook))'"},
  {"instruction": "How to get the org-id of a heading", "output": "emacs --batch --visit=file.org --eval '(org-id-get)'"},
  {"instruction": "How to set org-id method globally", "output": "emacs --batch --eval '(setq org-id-method (quote uuid))'"},
  {"instruction": "How to navigate to a specific org heading by ID", "output": "emacs --batch --visit=file.org --eval '(org-id-goto \"my-uuid-here\")'"},
  {"instruction": "How to archive done tasks", "output": "emacs --batch --visit=tasks.org --eval '(org-archive-subtree)'"},
  {"instruction": "How to set a tag on a heading from CLI", "output": "emacs --batch --visit=file.org --eval '(org-set-tags-to \"@work\")'"},
  {"instruction": "How to show the org mode version installed", "output": "emacs --batch --eval '(require '\\''org)' --eval '(princ org-version)'"}
]