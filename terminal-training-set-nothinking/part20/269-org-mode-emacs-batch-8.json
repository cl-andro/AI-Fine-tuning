[
  {"instruction": "How to export an Org file to PDF with lualatex", "output": "emacs --batch --visit=doc.org --eval '(setq org-latex-pdf-process (list \"lualatex -interaction nonstopmode %f\"))' --funcall org-latex-export-to-pdf"},
  {"instruction": "How to export Org to HTML with a specific encoding", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-coding-system (quote utf-8-unix))' --funcall org-html-export-to-html"},
  {"instruction": "How to execute a specific named code block", "output": "emacs --batch --visit=code.org --eval '(org-babel-execute-src-block nil (nth 1 (assoc \"my-block-name\" (org-babel-src-block-names))))'"},
  {"instruction": "How to tangle only code blocks tagged with :tangle", "output": "emacs --batch --visit=code.org --eval '(setq org-babel-tangle-comment-format-beg nil)' --eval '(org-babel-tangle)'"},
  {"instruction": "How to tangle all source blocks except tests", "output": "emacs --batch --visit=code.org --eval '(let ((org-babel-default-header-args (quote ((:tangle . \"no\"))))) (org-babel-tangle))'"},
  {"instruction": "How to publish with a clean destination directory", "output": "emacs --batch --eval '(org-publish-remove-all-timestamps)' --eval '(org-publish-all t)'"},
  {"instruction": "How to set :recursive t for nested publishing", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"docs\" :base-directory \"~/docs\" :recursive t :publishing-directory \"~/www\")))) (org-publish-all t))'"},
  {"instruction": "How to define a new publishing project dynamically", "output": "emacs --batch --eval '(push (list \"new-project\" :base-directory \"~/new\" :publishing-directory \"~/out\" :publishing-function (quote org-html-publish-to-html)) org-publish-project-alist)' --eval '(org-publish-all t)'"},
  {"instruction": "How to set the export subtrees on publish", "output": "emacs --batch --eval '(org-publish-project \"blog\" t)'"},
  {"instruction": "How to export with the (require ox-extra) module", "output": "emacs --batch --eval '(require '\\''ox-extra)' --visit=doc.org --funcall org-html-export-to-html"},
  {"instruction": "How to configure org-publish for a git repository", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"git-docs\" :base-directory (shell-command-to-string \"git rev-parse --show-toplevel\") :publishing-directory \"/tmp/docs\")))) (org-publish-all t))'"},
  {"instruction": "How to export to ODT with a specific styles template", "output": "emacs --batch --visit=doc.org --eval '(let ((org-odt-styles-file \"~/templates/custom.ott\")) (org-odt-export-to-odt))'"},
  {"instruction": "How to set the HTML home page link in navigation", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-home/up-format \"<a href=\\\"../\\\">Up</a>\")' --funcall org-html-export-to-html"},
  {"instruction": "How to exclude an enclosure tag from export", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-divs (quote ((preamble \"header\" \"main\") (content \"main\" \"content\") (postamble \"footer\" \"postamble\"))))' --funcall org-html-export-to-html"},
  {"instruction": "How to set a custom HTML preamble format", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-preamble-format (quote ((\"en\" \"<h1>My Site</h1>\"))))' --funcall org-html-export-to-html"},
  {"instruction": "How to set the HTML postamble format for copyright", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-postamble-format (quote ((\"en\" \"<p>Copyright 2025</p>\"))))' --funcall org-html-export-to-html"},
  {"instruction": "How to enable link validation during export", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-broken-links (quote mark))' --funcall org-html-export-to-html"},
  {"instruction": "How to add an index to a published project", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"site\" :makeindex t)))) (org-publish-all t))'"},
  {"instruction": "How to create a multi-language publishing project", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"en\" :base-directory \"~/org/en\") (list \"de\" :base-directory \"~/org/de\") (list \"site\" :components (quote (\"en\" \"de\")))))) (org-publish-all t))'"},
  {"instruction": "How to set the output file for export", "output": "emacs --batch --visit=doc.org --eval '(org-html-export-to-html)'"},
  {"instruction": "How to convert Org to TeX without compilation", "output": "emacs --batch --visit=doc.org --funcall org-latex-export-to-latex"},
  {"instruction": "How to convert Org to Texinfo without compilation", "output": "emacs --batch --visit=doc.org --funcall org-texinfo-export-to-texinfo"},
  {"instruction": "How to export an Org file without final newline", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-allow-bind-keywords t)' --funcall org-html-export-to-html"},
  {"instruction": "How to set the default Org babel language", "output": "emacs --batch --eval '(setq org-babel-default-header-args:python (quote ((:session . \"py\") (:results . \"output\"))))' --visit=code.org --eval '(org-babel-execute-buffer)'"},
  {"instruction": "How to set the org directory from environment", "output": "emacs --batch --eval '(setq org-directory (getenv \"ORG_DIR\"))' --visit=doc.org --funcall org-html-export-to-html"}
]