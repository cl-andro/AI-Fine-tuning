[
  {"instruction": "How to create a custom Helix keybinding to save", "output": "echo '[keys.normal.\"C-s\"]' >> ~/.config/helix/config.toml && echo '\"C-s\" = \":w\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to create a custom Helix keybinding to close buffer", "output": "echo '[keys.normal.\"C-w\"]' >> ~/.config/helix/config.toml && echo '\"C-w\" = \":buffer-close\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to bind F5 to run the current file in Helix", "output": "echo '[keys.normal.\"F5\"]' >> ~/.config/helix/config.toml && echo '\"F5\" = \":run\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to bind a key to toggle line numbers in Helix", "output": "echo '[keys.normal.\"F2\"]' >> ~/.config/helix/config.toml && echo '\"F2\" = \":toggle line-number\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to create a command alias in Helix", "output": "echo '[keys.normal.\"leader\"]' >> ~/.config/helix/config.toml && echo '\"leader\" = { \"w\" = \":w\", \"q\" = \":q\" }' >> ~/.config/helix/config.toml"},
  {"instruction": "How to configure the Helix DAP (debug adapter)", "output": "echo '[debugger]' >> ~/.config/helix/config.toml && echo 'dap = \"lldb-vscode\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to start a debugging session in Helix", "output": "hx -c ':debug start' file.rs"},
  {"instruction": "How to set a breakpoint from the Helix CLI", "output": "hx -c ':debug breakpoint 10' file.rs"},
  {"instruction": "How to continue execution in Helix debugger", "output": "hx -c ':debug continue' file.rs"},
  {"instruction": "How to step over in Helix debugger", "output": "hx -c ':debug step-over' file.rs"},
  {"instruction": "How to step into a function in Helix debugger", "output": "hx -c ':debug step-into' file.rs"},
  {"instruction": "How to step out of a function in Helix debugger", "output": "hx -c ':debug step-out' file.rs"},
  {"instruction": "How to evaluate an expression in the Helix debugger", "output": "hx -c ':debug evaluate my_var' file.rs"},
  {"instruction": "How to configure the Helix LSP for Rust", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"rust\"' >> ~/.config/helix/languages.toml && echo 'language-servers = [\"rust-analyzer\"]' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure multiple language servers in Helix", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"python\"' >> ~/.config/helix/languages.toml && echo 'language-servers = [\"pyright\", \"ruff\"]' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to set a language server config in Helix", "output": "echo '[language-server.pyright.config.settings]' >> ~/.config/helix/languages.toml && echo 'python.analysis.typeCheckingMode = \"basic\"' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure the Helix tree-sitter parser for a language", "output": "echo '[[grammar]]' >> ~/.config/helix/languages.toml && echo 'name = \"python\"' >> ~/.config/helix/languages.toml && echo 'source = { git = \"https://github.com/tree-sitter/tree-sitter-python\", rev = \"main\" }' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to add a custom language in Helix", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"my-lang\"' >> ~/.config/helix/languages.toml && echo 'scope = \"source.my-lang\"' >> ~/.config/helix/languages.toml && echo 'injection-regex = \"my-lang\"' >> ~/.config/helix/languages.toml && echo 'file-types = [\".myl\"]' >> ~/.config/helix/languages.toml && echo 'roots = []' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure the Helix comment token", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"python\"' >> ~/.config/helix/languages.toml && echo 'comment-token = \"#\"' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to set the Helix indent configuration per language", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"python\"' >> ~/.config/helix/languages.toml && echo 'indent = { tab-width = 4, unit = \"    \" }' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to set the formatter for a language in Helix", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"python\"' >> ~/.config/helix/languages.toml && echo 'formatter = { command = \"black\", args = [\"-\"] }' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to disable the LSP for a language in Helix", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"markdown\"' >> ~/.config/helix/languages.toml && echo 'language-servers = []' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure Helix text width for a language", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"rust\"' >> ~/.config/helix/languages.toml && echo 'text-width = 100' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to set the Helix soft-wrap for a specific language", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"markdown\"' >> ~/.config/helix/languages.toml && echo 'soft-wrap.enable = true' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure Helix language roots for project detection", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"rust\"' >> ~/.config/helix/languages.toml && echo 'roots = [\"Cargo.toml\"]' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to auto-close pairs in Helix", "output": "echo 'auto-pairs = true' >> ~/.config/helix/config.toml"}
]