[
  {"instruction": "How to batch process all .org files into .html recursively", "output": "emacs --batch --eval '(dolist (f (directory-files-recursively \"~/docs\" \"\\.org$\")) (with-current-buffer (find-file-noselect f) (org-html-export-to-html)))'"},
  {"instruction": "How to export Org to HTML with a custom CSS class for code", "output": "emacs --batch --visit=code.org --eval '(setq org-html-fontify-code t)' --funcall org-html-export-to-html"},
  {"instruction": "How to execute all babel blocks in a live session", "output": "emacs --batch --visit=code.org --eval '(setq org-babel-python-command \"python3\")' --eval '(org-babel-execute-buffer)'"},
  {"instruction": "How to execute org babel with remote data", "output": "emacs --batch --visit=code.org --eval '(org-babel-execute-buffer)'"},
  {"instruction": "How to tangle to a subdirectory preserving structure", "output": "emacs --batch --visit=code.org --eval '(setq org-babel-tangle-use-relative-file-links t)' --eval '(org-babel-tangle)'"},
  {"instruction": "How to publish only the homepage of a project", "output": "emacs --batch --eval '(org-publish-file \"~/org/index.org\" org-publish-project-alist t)'"},
  {"instruction": "How to set the publishing function to HTML in a project", "output": "emacs --batch --eval '(push (list \"html\" :publishing-function (quote org-html-publish-to-html)) org-publish-project-alist)' --eval '(org-publish-all t)'"},
  {"instruction": "How to exclude certain tags from publishing", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"site\" :exclude \"draft\")))) (org-publish-all t))'"},
  {"instruction": "How to publish Markdown from Org", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"md\" :publishing-function (quote org-md-publish-to-markdown))))) (org-publish-all t))'"},
  {"instruction": "How to generate a sitemap with dates", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"blog\" :auto-sitemap t :sitemap-sort-files (quote chronologically) :sitemap-date-format \"%%Y-%%m-%%d\" :sitemap-file-entry-format \"%t %d\")))) (org-publish-all t))'"},
  {"instruction": "How to publish with a custom preparation function", "output": "emacs --batch --eval '(defun my-prep (project) (message \"Preparing %s\" project))' --eval '(let ((org-publish-project-alist (list (list \"site\" :preparation-function (quote my-prep))))) (org-publish-all t))'"},
  {"instruction": "How to set the HTML output directory structure", "output": "emacs --batch --eval '(let ((org-publish-project-alist (list (list \"site\" :publishing-directory \"~/site\" :base-directory \"~/org\")))) (org-publish-all t))'"},
  {"instruction": "How to publish only HTML files and skip static assets", "output": "emacs --batch --eval '(org-publish \"site\" t nil)'"},
  {"instruction": "How to parse an Org file into its element tree", "output": "emacs --batch --visit=doc.org --eval '(pp (org-element-parse-buffer))'"},
  {"instruction": "How to extract all URLs from an Org file", "output": "emacs --batch --visit=links.org --eval '(org-element-map (org-element-parse-buffer) (quote link) (lambda (l) (print (org-element-property :raw-link l))))'"},
  {"instruction": "How to count all headings in an Org file by level", "output": "emacs --batch --visit=file.org --eval '(let ((counts (make-hash-table))) (org-element-map (org-element-parse-buffer) (quote headline) (lambda (h) (let ((l (org-element-property :level h))) (puthash l (1+ (gethash l counts 0)) counts)))) (maphash (lambda (k v) (message \"Level %d: %d\" k v)) counts))'"},
  {"instruction": "How to extract all TODO items", "output": "emacs --batch --visit=file.org --eval '(org-element-map (org-element-parse-buffer) (quote headline) (lambda (h) (when (org-element-property :todo-keyword h) (print (org-element-property :raw-value h)))))'"},
  {"instruction": "How to get all tags on headings", "output": "emacs --batch --visit=file.org --eval '(org-element-map (org-element-parse-buffer) (quote headline) (lambda (h) (print (org-element-property :tags h))))'"},
  {"instruction": "How to extract all scheduled dates", "output": "emacs --batch --visit=file.org --eval '(org-element-map (org-element-parse-buffer) (quote headline) (lambda (h) (let ((s (org-element-property :scheduled h))) (when s (print (org-timestamp-translate s))))))'"},
  {"instruction": "How to extract all deadlines from an Org file", "output": "emacs --batch --visit=file.org --eval '(org-element-map (org-element-parse-buffer) (quote headline) (lambda (h) (let ((d (org-element-property :deadline h))) (when d (print (org-timestamp-translate d))))))'"},
  {"instruction": "How to extract all clock entries", "output": "emacs --batch --visit=clock.org --eval '(org-element-map (org-element-parse-buffer) (quote clock) (lambda (c) (print (org-element-property :value c))))'"},
  {"instruction": "How to extract all drawer contents", "output": "emacs --batch --visit=file.org --eval '(org-element-map (org-element-parse-buffer) (quote drawer) (lambda (d) (print (org-element-property :drawer-name d))))'"},
  {"instruction": "How to extract all footnote definitions", "output": "emacs --batch --visit=file.org --eval '(org-element-map (org-element-parse-buffer) (quote footnote-definition) (lambda (f) (print (org-element-property :label f))))'"},
  {"instruction": "How to extract all src blocks with their languages", "output": "emacs --batch --visit=code.org --eval '(org-element-map (org-element-parse-buffer) (quote src-block) (lambda (s) (print (cons (org-element-property :language s) (org-element-property :value s)))))'"},
  {"instruction": "How to extract all table data from an Org file", "output": "emacs --batch --visit=data.org --eval '(org-element-map (org-element-parse-buffer) (quote table) (lambda (tbl) (org-element-map tbl (quote table-row) (lambda (row) (org-element-map row (quote table-cell) (lambda (c) (print (org-element-property :value c))))))))'"}
]