  {"instruction": "How to recalculate all Org tables", "output": "emacs --batch --visit=table.org --eval '(org-table-recalculate-buffer-tables)'"},
  {"instruction": "How to convert an Org table to CSV", "output": "emacs --batch --visit=table.org --eval '(org-table-export \"table.csv\")'"},
  {"instruction": "How to import CSV into an Org table", "output": "emacs --batch --visit=table.org --eval '(org-table-import \"data.csv\")'"},
  {"instruction": "How to sort an Org table by a column", "output": "emacs --batch --visit=table.org --eval '(org-table-sort-lines nil ?N)'"},
