[
  {"instruction": "How to export Org to plain text with UTF-8 encoding", "output": "emacs --batch --visit=doc.org --eval '(setq org-ascii-charset (quote utf-8))' --funcall org-ascii-export-to-ascii"},
  {"instruction": "How to export Org file to HTML with a MathJax configuration", "output": "emacs --batch --visit=math.org --eval '(setq org-html-mathjax-options (quote ((scale \"150\") (align \"center\"))))' --funcall org-html-export-to-html"},
  {"instruction": "How to export Org to LaTeX with a custom package", "output": "emacs --batch --visit=doc.org --eval '(add-to-list '\\''org-latex-packages-alist (list \"\" \"minted\" t))' --funcall org-latex-export-to-pdf"},
  {"instruction": "How to evaluate all babel blocks and save results", "output": "emacs --batch --visit=code.org --eval '(org-babel-execute-buffer)' --eval '(org-babel-when-result-hash (org-babel-hash-buffer))'"},
  {"instruction": "How to tangle to files with shebang lines", "output": "emacs --batch --visit=code.org --eval '(setq org-babel-tangle-comment-format-beg \"#!/usr/bin/env python\")' --eval '(org-babel-tangle)'"},
  {"instruction": "How to publish with a custom publishing function", "output": "emacs --batch --eval '(org-publish \"docs\" t)'"},
  {"instruction": "How to set the base URL for Org HTML export", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-base-url \"https://example.com\")' --funcall org-html-export-to-html"},
  {"instruction": "How to export Org with preview of images", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-broken-links t)' --funcall org-html-export-to-html"},
  {"instruction": "How to export with a custom timestamp format", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-time-stamp-file nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to set the author for export", "output": "emacs --batch --visit=doc.org --eval '(setq org-export-with-author t)' --funcall org-html-export-to-html"},
  {"instruction": "How to set the email for export", "output": "emacs --batch --visit=doc.org --eval '(setq user-mail-address \"user@example.com\")' --funcall org-html-export-to-html"},
  {"instruction": "How to skip the preamble in HTML export", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-preamble nil)' --funcall org-html-export-to-html"},
  {"instruction": "How to set a custom HTML postamble", "output": "emacs --batch --visit=doc.org --eval '(setq org-html-postamble \"<footer>My footer</footer>\")' --funcall org-html-export-to-html"},
