[
  {"instruction": "How to set the Helix editor color theme in config", "output": "echo 'theme = \"catppuccin_mocha\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix line number display", "output": "echo 'line-number = \"relative\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix cursor shape", "output": "echo 'cursor-shape.insert = \"bar\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix scroll buffer", "output": "echo 'scroll-buffer = 8' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set Helix to use system clipboard", "output": "echo 'clipboard = true' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix completion timeout", "output": "echo 'completion-timeout = 50' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix auto-completion", "output": "echo 'auto-completion = false' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix auto-info display", "output": "echo 'auto-info = false' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix idle timeout for messages", "output": "echo 'idle-timeout = 5' >> ~/.config/helix/config.toml"},
  {"instruction": "How to configure the Helix editor bufferline", "output": "echo 'bufferline = \"always\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set Helix to soften tab bar display", "output": "echo 'bufferline-section-order = []' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix indent type", "output": "echo '[editor.indent]' >> ~/.config/helix/config.toml && echo 'mode = \"tabs-to-spaces\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix tab width", "output": "echo 'tab-width = 4' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix indent unit", "output": "echo 'indent-unit = 4' >> ~/.config/helix/config.toml"},
  {"instruction": "How to configure Helix language servers", "output": "echo '[language-server.pyright]' >> ~/.config/helix/languages.toml && echo 'command = \"pyright-langserver\"' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure language formatting in Helix", "output": "echo '[language.python]' >> ~/.config/helix/languages.toml && echo 'formatter = { command = \"black\", args = [\"-\"] }' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to disable a language server for a language in Helix", "output": "echo '[language.python]' >> ~/.config/helix/languages.toml && echo 'language-servers = []' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to add a file type association in Helix", "output": "echo '[[language]]' >> ~/.config/helix/languages.toml && echo 'name = \"mylang\"' >> ~/.config/helix/languages.toml && echo 'scope = \"source.mylang\"' >> ~/.config/helix/languages.toml"},
  {"instruction": "How to configure Helix key bindings", "output": "echo '[keys.normal]' >> ~/.config/helix/config.toml && echo '\"C-s\" = \":w\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to configure the Helix file picker", "output": "echo '[keys.normal.\"C-p\"]' >> ~/.config/helix/config.toml && echo '\"C-p\" = \"file_picker\"' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix editor soft wrap", "output": "echo 'soft-wrap.enable = true' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix editor word wrap", "output": "echo 'soft-wrap.wrap-at-text-width = true' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix gutter configuration", "output": "echo '[editor.gutter]' >> ~/.config/helix/config.toml && echo 'ruler-columns = [80, 120]' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set the Helix smart search case", "output": "echo 'smart-case = true' >> ~/.config/helix/config.toml"},
  {"instruction": "How to set Helix to autosave on focus lost", "output": "echo 'auto-save.focus-lost = true' >> ~/.config/helix/config.toml"}
]