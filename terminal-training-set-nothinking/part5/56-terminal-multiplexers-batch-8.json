[
  {"instruction": "Start abduco session named 'build' tailing syslog", "output": "abduco -c build tail -f /var/log/syslog"},
  {"instruction": "List all abduco sessions", "output": "abduco -l"},
  {"instruction": "Attach to abduco session 'build'", "output": "abduco -a build"},
  {"instruction": "Force attach to abduco session even if attached", "output": "abduco -a build -f"},
  {"instruction": "Attach to abduco session read-only", "output": "abduco -a server -r"},
  {"instruction": "Start abduco session running python server", "output": "abduco -c server python3 -m http.server 8080"},
  {"instruction": "Kill abduco session by name", "output": "abduco -k server"},
  {"instruction": "Start dtach session with socket file", "output": "dtach -c /tmp/dtach-socket htop"},
  {"instruction": "Attach to dtach session", "output": "dtach -a /tmp/dtach-socket"},
  {"instruction": "Attach to dtach session read-only", "output": "dtach -a /tmp/dtach-socket -r"},
  {"instruction": "Force attach to dtach detaching others", "output": "dtach -a /tmp/dtach-socket -z"},
  {"instruction": "Start dtach with resize notification (irssi)", "output": "dtach -c /tmp/irssi-socket -E irssi"},
  {"instruction": "Start dtach with no echo", "output": "dtach -c /tmp/nano-socket -N nano"},
  {"instruction": "Start dtach with keepalive", "output": "dtach -c /tmp/proc-socket -K htop"},
  {"instruction": "Start dtach with window size override", "output": "dtach -c /tmp/top-socket -w 120x40 top"},
  {"instruction": "Start dtach and immediately detach", "output": "dtach -c /tmp/ping-socket -z 'ping 8.8.8.8'"},
  {"instruction": "Attach to dtach with custom socket", "output": "dtach -a /tmp/other-socket"},
  {"instruction": "Check if dtach socket exists", "output": "ls -l /tmp/dtach-socket"},
  {"instruction": "Kill dtach session by PID and remove socket", "output": "kill $(fuser /tmp/dtach-socket 2>/dev/null) 2>/dev/null; rm -f /tmp/dtach-socket"},
  {"instruction": "List dtach sockets on the system", "output": "find /tmp -name 'dtach-*' -type s 2>/dev/null"},
  {"instruction": "Start abduco session in background", "output": "abduco -c deploy rsync -av /src /dst &"},
  {"instruction": "Start abduco with custom exit detach", "output": "abduco -c watch 'watch -n1 df -h'"}
]
