[
  {"instruction": "Use if/else in bpftrace to filter large allocations", "output": "bpftrace -e 'kprobe:do_sys_open { if (arg2 > 0) { printf(\"writeable\\n\"); } else { printf(\"readonly\\n\"); } }'"},
  {"instruction": "Use unroll in bpftrace for bounded loops", "output": "bpftrace -e 'BEGIN { unroll(5) { printf(\"hello %d\\n\", 0); } }'"},
  {"instruction": "Use BEGIN probe for setup", "output": "bpftrace -e 'BEGIN { printf(\"tracing started\\n\"); }'"},
  {"instruction": "Use END probe for summary", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat { @opens[comm] = count(); } END { print(@opens); }'"},
  {"instruction": "Trace specific PID only", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_read /pid == 1234/ { printf(\"%d\\n\", args->fd); }'"},
  {"instruction": "Trace specific TID only", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_write /tid == 5678/ { printf(\"%d bytes\\n\", args->count); }'"},
  {"instruction": "Filter by CPU number", "output": "bpftrace -e 'tracepoint:sched:sched_switch /cpu == 0/ { printf(\"switched on CPU0\\n\"); }'"},
  {"instruction": "Trace elapsed time since boot in nanoseconds", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_getpid { printf(\"%llu\\n\", elapsed); }'"},
  {"instruction": "Use @ map for per-process byte count", "output": "bpftrace -e 'tracepoint:syscalls:sys_exit_read { @reads[comm] += args->ret; }'"},
  {"instruction": "Use @map with count aggregation", "output": "bpftrace -e 'kprobe:do_sys_open { @opens[comm, str(arg1)] = count(); }'"},
  {"instruction": "Print kernel stack on block I/O", "output": "bpftrace -e 'kprobe:submit_bio { printf(\"%s\\n\", kstack); }'"},
  {"instruction": "Print user stack on malloc", "output": "bpftrace -e 'uprobe:/lib/libc.so.6:malloc { printf(\"%s\\n\", ustack); }'"},
  {"instruction": "Clear maps every 5 seconds", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_nanosleep { @slept = count(); } interval:s:5 { print(@); clear(@); }'"},
  {"instruction": "Trace signals sent between processes", "output": "bpftrace -e 'tracepoint:signal:signal_generate { printf(\"sig=%d pid=%d\\n\", args->sig, args->pid); }'"},
  {"instruction": "Trace TCP connections", "output": "bpftrace -e 'kprobe:tcp_connect { printf(\"connect from %s\\n\", comm); }'"},
  {"instruction": "Trace page faults", "output": "bpftrace -e 'tracepoint:exceptions:page_fault_user { @[comm, ustack] = count(); }'"},
  {"instruction": "Trace OOM killer events", "output": "bpftrace -e 'tracepoint:oom:mark_victim { printf(\"OOM victim: %s\\n\", comm); }'"},
  {"instruction": "Trace file system reads per mount point", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_read /args->fd > 0/ { @reads[comm] = count(); }'"},
  {"instruction": "Trace irq handler latency", "output": "bpftrace -e 'kprobe:handle_irq { @start[tid] = nsecs; } kretprobe:handle_irq /@start[tid]/ { @latency = hist(nsecs - @start[tid]); delete(@start[tid]); }'"},
  {"instruction": "Show total allocated memory per process", "output": "bpftrace -e 'uprobe:/lib/libc.so.6:malloc { @[comm] = sum(arg0); }'"},
  {"instruction": "Trace sysfs reads/writes", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat /str(args->filename) == \"/sys/class/power_supply/AC0/online\"/ { printf(\"%s reading AC status\\n\", comm); }'"},
  {"instruction": "Profile scheduler wakeups", "output": "bpftrace -e 'tracepoint:sched:sched_wakeup { @[comm, kstack] = count(); }'"},
  {"instruction": "Trace raw syscall numbers via tracepoint", "output": "bpftrace -e 'tracepoint:raw_syscalls:sys_enter { @syscalls[args->id] = count(); }'"},
  {"instruction": "Use map with max function", "output": "bpftrace -e 'tracepoint:syscalls:sys_exit_read { @max_read = max(args->ret); }'"},
  {"instruction": "Filter by comm name on open syscalls", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat /comm == \"bash\"/ { printf(\"%s\\n\", str(args->filename)); }'"}
]
