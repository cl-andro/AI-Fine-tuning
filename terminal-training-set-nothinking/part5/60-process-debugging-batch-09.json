[
  {"instruction": "Trace all open syscalls with bpftrace one-liner", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat { printf(\"%s %s\\n\", comm, str(args->filename)); }'"},
  {"instruction": "Count syscalls per process with bpftrace", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_write { @[comm] = count(); }'"},
  {"instruction": "Trace process exec events using tracepoint", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_execve { printf(\"%s execve\\n\", comm); }'"},
  {"instruction": "Use kprobe to trace do_sys_open entry", "output": "bpftrace -e 'kprobe:do_sys_open { printf(\"open: %s\\n\", str(arg1)); }'"},
  {"instruction": "Use kretprobe to capture return of kmalloc", "output": "bpftrace -e 'kretprobe:kmalloc { @[kstack()] = hist(retval); }'"},
  {"instruction": "Use uprobe to trace user function my_func", "output": "bpftrace -e 'uprobe:/usr/bin/program:my_func { printf(\"my_func called\\n\"); }'"},
  {"instruction": "Use uretprobe to capture return value", "output": "bpftrace -e 'uretprobe:/usr/bin/program:my_func { printf(\"my_func returned %d\\n\", retval); }'"},
  {"instruction": "Use USDT probe in a program", "output": "bpftrace -e 'usdt:/usr/bin/program:my_provider:my_probe { printf(\"probe hit\\n\"); }'"},
  {"instruction": "Profile on CPU at 99 Hz per CPU", "output": "bpftrace -e 'profile:hz:99 { @[comm, kstack] = count(); }'"},
  {"instruction": "Sample on hardware clock every 1000 cycles", "output": "bpftrace -e 'hardware:cycles:1000 { @[comm] = count(); }'"},
  {"instruction": "Use interval probe to print every second", "output": "bpftrace -e 'interval:s:1 { time(); print(@); clear(@); }'"},
  {"instruction": "Print PID and comm for each open syscall", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat { printf(\"%d %s\\n\", pid, comm); }'"},
  {"instruction": "Print UID and GID for file operations", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_openat { printf(\"uid=%d gid=%d\\n\", uid, gid); }'"},
  {"instruction": "Print CPU and nsecs for each context switch", "output": "bpftrace -e 'tracepoint:sched:sched_switch { printf(\"cpu=%d time=%llu\\n\", cpu, nsecs); }'"},
  {"instruction": "Print kernel stack on malloc", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_brk { @[kstack] = count(); }'"},
  {"instruction": "Print user stack on write syscall", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_write { @[ustack] = count(); }'"},
  {"instruction": "Access arg0 through arg9 in a kprobe", "output": "bpftrace -e 'kprobe:do_sys_open { printf(\"arg0=%lx\\n\", arg0); }'"},
  {"instruction": "Use retval in a kretprobe", "output": "bpftrace -e 'kretprobe:__kmalloc { printf(\"ret=%lx\\n\", retval); }'"},
  {"instruction": "Access args struct in tracepoint", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_read { printf(\"fd=%d\\n\", args->fd); }'"},
  {"instruction": "Use a positional parameter in bpftrace script", "output": "bpftrace -e 'kprobe:do_sys_open /str(arg1) == $1/ { printf(\"%s\\n\", str(arg1)); }' /etc/passwd"},
  {"instruction": "Use software probe for context switches", "output": "bpftrace -e 'software:context-switches:100 { @[comm] = count(); }'"},
  {"instruction": "Create a counting map for read sizes", "output": "bpftrace -e 'tracepoint:syscalls:sys_exit_read { @bytes = hist(args->ret); }'"},
  {"instruction": "Use lhist for latency histogram", "output": "bpftrace -e 'kprobe:do_sys_open { @start[tid] = nsecs; } kretprobe:do_sys_open /@start[tid]/ { @latency = lhist(nsecs - @start[tid], 1000, 100000, 1000); }'"},
  {"instruction": "Compute average read size", "output": "bpftrace -e 'tracepoint:syscalls:sys_exit_read { @sizes = avg(args->ret); }'"},
  {"instruction": "Track minimum and maximum block I/O latency", "output": "bpftrace -e 'kprobe:submit_bio { @start[tid] = nsecs; } kretprobe:submit_bio /@start[tid]/ { @min = min(nsecs - @start[tid]); @max = max(nsecs - @start[tid]); delete(@start[tid]); }'"},
  {"instruction": "Sum total bytes written", "output": "bpftrace -e 'tracepoint:syscalls:sys_exit_write { @total = sum(args->ret); }'"}
]
