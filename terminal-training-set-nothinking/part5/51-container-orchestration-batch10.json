[
  {"instruction": "Start MicroK8s (if not already running)", "output": "microk8s start"},
  {"instruction": "Stop MicroK8s cluster", "output": "microk8s stop"},
  {"instruction": "Check MicroK8s status", "output": "microk8s status"},
  {"instruction": "Check MicroK8s status with verbose details", "output": "microk8s status --wait-ready"},
  {"instruction": "List all MicroK8s addons", "output": "microk8s enable --help"},
  {"instruction": "Enable the MicroK8s dashboard addon", "output": "microk8s enable dashboard"},
  {"instruction": "Enable DNS in MicroK8s", "output": "microk8s enable dns"},
  {"instruction": "Enable storage in MicroK8s", "output": "microk8s enable storage"},
  {"instruction": "Enable Ingress in MicroK8s", "output": "microk8s enable ingress"},
  {"instruction": "Enable MetalLB with IP range", "output": "microk8s enable metallb:192.168.1.100-192.168.1.110"},
  {"instruction": "Enable Registry addon in MicroK8s", "output": "microk8s enable registry"},
  {"instruction": "Disable an addon in MicroK8s", "output": "microk8s disable dashboard"},
  {"instruction": "Run kubectl through MicroK8s", "output": "microk8s kubectl get nodes"},
  {"instruction": "Get all pods via MicroK8s kubectl", "output": "microk8s kubectl get pods -A"},
  {"instruction": "Create a deployment in MicroK8s", "output": "microk8s kubectl create deployment nginx --image nginx"},
  {"instruction": "Scale a deployment in MicroK8s", "output": "microk8s kubectl scale deployment nginx --replicas 3"},
  {"instruction": "Expose a deployment in MicroK8s", "output": "microk8s kubectl expose deployment nginx --port 80 --type NodePort"},
  {"instruction": "Get services in MicroK8s", "output": "microk8s kubectl get services"},
  {"instruction": "Apply a YAML file in MicroK8s", "output": "microk8s kubectl apply -f app.yaml"},
  {"instruction": "View logs of a pod in MicroK8s", "output": "microk8s kubectl logs pod/nginx-xxx"},
  {"instruction": "Join a worker node to MicroK8s cluster", "output": "microk8s add-node"},
  {"instruction": "Get the worker join command with token", "output": "microk8s add-node --token 12345 --worker"},
  {"instruction": "Remove a node from MicroK8s cluster", "output": "microk8s remove-node node2"},
  {"instruction": "Reset MicroK8s cluster to factory state", "output": "microk8s reset"},
  {"instruction": "Reset MicroK8s and destroy all data", "output": "microk8s reset --destroy-storage"},
  {"instruction": "Check MicroK8s cluster health", "output": "microk8s inspect"}
]
