[
  {"instruction": "Display all readelf information about an ELF", "output": "readelf -a /bin/ls"},
  {"instruction": "Show ELF header details", "output": "readelf -h /bin/ls"},
  {"instruction": "List program headers (segments)", "output": "readelf -l /bin/ls"},
  {"instruction": "List section headers", "output": "readelf -S /bin/ls"},
  {"instruction": "Show symbol table", "output": "readelf -s /bin/ls"},
  {"instruction": "Show relocation sections", "output": "readelf -r /bin/ls"},
  {"instruction": "Show dynamic section", "output": "readelf -d /bin/ls"},
  {"instruction": "Display notes section", "output": "readelf -n /bin/ls"},
  {"instruction": "Display unwind info", "output": "readelf -u /bin/ls"},
  {"instruction": "Display version info from .gnu.version_r", "output": "readelf --version-info /bin/ls"},
  {"instruction": "Wide output (no line truncation) with section details", "output": "readelf -S --wide --section-details /bin/ls"},
  {"instruction": "Dump raw hex of .rodata section", "output": "readelf -x .rodata /bin/ls"},
  {"instruction": "Dump string table of .strtab section", "output": "readelf -p .strtab /bin/ls"},
  {"instruction": "Hash table and symbol versioning info", "output": "readelf -Ds /bin/ls"},
  {"instruction": "Display core notes from a coredump", "output": "readelf -n core.dump"},
  {"instruction": "Demangle symbol names in symbol table", "output": "readelf -s --demangle /bin/ls"},
  {"instruction": "Use with decoded option to show enum values", "output": "readelf -h -d /bin/ls | head -30"},
  {"instruction": "Section groups display", "output": "readelf -g /bin/ls"},
  {"instruction": "Display program headers as segments (alternative view)", "output": "readelf --segments /bin/ls"},
  {"instruction": "Display archive index for .a file", "output": "readelf -a /usr/lib/x86_64-linux-gnu/libc.a 2>/dev/null | head -20"},
  {"instruction": "Display version strings and dependencies", "output": "readelf -V /bin/ls"},
  {"instruction": "Interpret notes section with verbose descriptors", "output": "readelf -n -v /bin/ls"}
]
