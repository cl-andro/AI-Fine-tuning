[
  {"instruction": "Create a new tmux session named 'dev'", "output": "tmux new-session -s dev"},
  {"instruction": "Detach from current tmux session", "output": "tmux detach"},
  {"instruction": "Attach to existing tmux session", "output": "tmux attach-session"},
  {"instruction": "Attach to session named 'dev'", "output": "tmux attach-session -t dev"},
  {"instruction": "Kill session named 'old'", "output": "tmux kill-session -t old"},
  {"instruction": "List all tmux sessions", "output": "tmux list-sessions"},
  {"instruction": "List windows in current session", "output": "tmux list-windows"},
  {"instruction": "List panes in current window", "output": "tmux list-panes"},
  {"instruction": "Select window number 3", "output": "tmux select-window -t :3"},
  {"instruction": "Select pane 2 in current window", "output": "tmux select-pane -t 2"},
  {"instruction": "Split window horizontally", "output": "tmux split-window -h"},
  {"instruction": "Split window vertically", "output": "tmux split-window -v"},
  {"instruction": "Resize pane up 10 lines", "output": "tmux resize-pane -U 10"},
  {"instruction": "Resize pane right 5 columns", "output": "tmux resize-pane -R 5"},
  {"instruction": "Swap pane 1 with pane 3", "output": "tmux swap-pane -s 1 -t 3"},
  {"instruction": "Swap window 1 with window 2", "output": "tmux swap-window -s 1 -t 2"},
  {"instruction": "Join pane from another session window", "output": "tmux join-pane -s other:2.1 -t :1.0"},
  {"instruction": "Break pane into new window", "output": "tmux break-pane -t :2"},
  {"instruction": "Send keys 'ls -la' to pane 1", "output": "tmux send-keys -t 1 'ls -la' Enter"},
  {"instruction": "Send prefix to underlying application", "output": "tmux send-prefix"},
  {"instruction": "Display message 'Hello World'", "output": "tmux display-message 'Hello World'"},
  {"instruction": "Display pane numbers interactively", "output": "tmux display-panes"}
]
