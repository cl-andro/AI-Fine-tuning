[
  {"instruction": "Copy a file via SCP with bandwidth limit", "output": "scp -l 1000 largefile.iso user@host:/dest/"},
  {"instruction": "SCP with port and identity file", "output": "scp -P 2222 -i ~/.ssh/deploy_key file.txt user@host:~/"},
  {"instruction": "SCP preserve file attributes", "output": "scp -p data.csv user@host:backup/"},
  {"instruction": "SCP copy a directory recursively", "output": "scp -r project/ user@host:~/projects/"},
  {"instruction": "SCP with compression for slow connections", "output": "scp -C -r logs/ user@host:backup/"},
  {"instruction": "SCP quiet mode with progress", "output": "scp -q source.zip user@host:~/"},
  {"instruction": "SFTP interactive session", "output": "sftp user@host"},
  {"instruction": "SFTP batch put multiple files", "output": "echo 'put file1.txt\nput file2.txt\nbye' | sftp -b - user@host"},
  {"instruction": "SFTP get with recursive and preserve flags", "output": "sftp -R user@host:/remote/dir /local/dest"},
  {"instruction": "SFTP with custom port and identity file", "output": "sftp -P 2222 -o IdentityFile=~/.ssh/key user@host"},
  {"instruction": "SFTP get all files matching pattern", "output": "echo 'mget *.csv /tmp/' | sftp user@host"},
  {"instruction": "SFTP resume a file transfer", "output": "echo 'reget largefile.iso' | sftp user@host"},
  {"instruction": "SFTP resume upload", "output": "echo 'reput localfile.tar' | sftp user@host"},
  {"instruction": "SFTP change remote directory on login", "output": "sftp user@host:/var/www/"},
  {"instruction": "SFTP with banner suppression", "output": "sftp -q user@host"},
  {"instruction": "scp3 with IPv4 forcing", "output": "scp -4 file.txt user@host:~/"},
  {"instruction": "scp3 with IPv6 forcing", "output": "scp -6 file.txt user@host:~/"},
  {"instruction": "Copy with scp and strict host key checking off", "output": "scp -o StrictHostKeyChecking=no file.txt user@host:~/"},
  {"instruction": "SFTP with connection keepalive", "output": "sftp -o ServerAliveInterval=60 user@host"},
  {"instruction": "SFTP with debug logging", "output": "sftp -v user@host"},
  {"instruction": "SCP copy with specified cipher", "output": "scp -c aes256-ctr secret.tar.gz user@host:~/"},
  {"instruction": "SCP limiting total time", "output": "scp -o ConnectTimeout=10 -o ServerAliveCountMax=3 file.txt user@host:~/"},
  {"instruction": "SFTP command to chmod remote file", "output": "echo 'chmod 755 script.sh' | sftp user@host"},
  {"instruction": "SFTP command to create directory", "output": "echo 'mkdir incoming' | sftp user@host"},
  {"instruction": "SFTP delete multiple remote files", "output": "echo 'rm *.tmp\nrm *.bak' | sftp user@host"},
  {"instruction": "SCP with proxy jump", "output": "scp -o ProxyJump=jump-host file.txt user@target-host:~/"}
]