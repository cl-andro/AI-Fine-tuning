[
  {"instruction": "Bring the Bluetooth device hci0 up", "output": "hciconfig hci0 up"},
  {"instruction": "Bring the Bluetooth device hci0 down", "output": "hciconfig hci0 down"},
  {"instruction": "Show detailed information about hci0", "output": "hciconfig hci0 info"},
  {"instruction": "Show basic information for all Bluetooth devices", "output": "hciconfig -a"},
  {"instruction": "Show all HCI devices with extended info", "output": "hciconfig"},
  {"instruction": "Reset the Bluetooth adapter hci0", "output": "hciconfig hci0 reset"},
  {"instruction": "Set class of device for hci0", "output": "hciconfig hci0 class 0x1C0104"},
  {"instruction": "Enable page scanning on hci0", "output": "hciconfig hci0 pscan"},
  {"instruction": "Enable inquiry scanning on hci0", "output": "hciconfig hci0 iscan"},
  {"instruction": "Enable both page and inquiry scanning", "output": "hciconfig hci0 piscan"},
  {"instruction": "Disable all scanning on hci0", "output": "hciconfig hci0 noscan"},
  {"instruction": "Enable authentication for all connections", "output": "hciconfig hci0 auth"},
  {"instruction": "Disable authentication requirement", "output": "hciconfig hci0 noauth"},
  {"instruction": "Enable encryption on all connections", "output": "hciconfig hci0 encrypt"},
  {"instruction": "Disable encryption on hci0", "output": "hciconfig hci0 noencrypt"},
  {"instruction": "Set the inquiry transmit power level", "output": "hciconfig hci0 inqpt 4"},
  {"instruction": "Set the inquiry access code (GIAC)", "output": "hciconfig hci0 iac 9E8B33"},
  {"instruction": "Set the Bluetooth device name", "output": "hciconfig hci0 name 'Debian-Desktop'"},
  {"instruction": "Read the RSSI of the connection to a device", "output": "hciconfig hci0 rssi 12:34:56:AB:CD:EF"},
  {"instruction": "Set link policy on hci0", "output": "hciconfig hci0 linkpol 0x000f"},
  {"instruction": "Enable BLE advertising on hci0", "output": "hciconfig hci0 leadv 0"},
  {"instruction": "Configure connection latency parameters", "output": "hciconfig hci0 connlat 0x0004 0x0064"},
  {"instruction": "Set a suspend event mask for power management", "output": "hciconfig hci0 susevent 0x00000001"},
  {"instruction": "Set the BLE random address for adveertising", "output": "hciconfig hci0 lerls 0x00:11:22:33:44:55"},
  {"instruction": "Read the BLE resolving list size", "output": "hciconfig hci0 le"},
  {"instruction": "Get extended information about hci0 including BLE features", "output": "hciconfig hci0 lerps"}
