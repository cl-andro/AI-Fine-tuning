[
  {"instruction": "Basic ddrescue from failing disk to image", "output": "ddrescue /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with no retry passes (quick scan)", "output": "ddrescue -n /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with 3 retry passes on bad sectors", "output": "ddrescue -r 3 /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with direct disk access bypassing cache", "output": "ddrescue -d /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with synchronous I/O", "output": "ddrescue -d -s /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Try bad sectors again before final retry", "output": "ddrescue --try-again /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with 5 max retries", "output": "ddrescue -r 5 /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Retrim previously trimmed sectors", "output": "ddrescue --retrim /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Verify recovered data integrity", "output": "ddrescue -v /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Fill unreadable sectors with zeros", "output": "ddrescue --fill-mode=+ /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Fill with byte pattern 0xff", "output": "ddrescue --fill-pattern=0xff /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Fill trimmed sectors", "output": "ddrescue --fill=+ /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue from input directory of source files", "output": "ddrescue --idir=/mnt/source /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Write output to directory as split files", "output": "ddrescue --odir=/mnt/dest /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with map log preallocation", "output": "ddrescue -m /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue specific sector range", "output": "ddrescue --min-sector 1000 --max-sector 100000 /dev/sda /tmp/part.img /tmp/part.log"},
  {"instruction": "Generate mapfile from existing rescue log", "output": "ddrescue --mapfile /tmp/rescue.log"},
  {"instruction": "Rescue in reverse direction", "output": "ddrescue --reverse /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Abort after 100 consecutive bad sectors", "output": "ddrescue -b 512 --abort-on-bad 100 /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Show rescue operation status", "output": "ddrescue --status /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with input offset", "output": "ddrescue --input-offset 10G /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Rescue with output offset", "output": "ddrescue --output-offset 10G /dev/sda /tmp/rescue.img /tmp/rescue.log"}
