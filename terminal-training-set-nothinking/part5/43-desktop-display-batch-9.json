[
  {
    "instruction": "List available display modes",
    "output": "xrandr"
  },
  {
    "instruction": "Set primary display to 1920x1080 at 60Hz",
    "output": "xrandr --output HDMI-1 --mode 1920x1080 --rate 60"
  },
  {
    "instruction": "Turn off secondary display",
    "output": "xrandr --output DP-1 --off"
  },
  {
    "instruction": "Extend desktop right of primary",
    "output": "xrandr --output HDMI-1 --auto --right-of eDP-1"
  },
  {
    "instruction": "Mirror displays",
    "output": "xrandr --output HDMI-1 --same-as eDP-1"
  },
  {
    "instruction": "Rotate display 90 degrees",
    "output": "xrandr --output HDMI-1 --rotate left"
  },
  {
    "instruction": "Set display DPI to 96",
    "output": "xrandr --dpi 96"
  },
  {
    "instruction": "Get display info with xdpyinfo",
    "output": "xdpyinfo | grep -E 'dimensions|resolution'"
  },
  {
    "instruction": "List window properties with xwininfo",
    "output": "xwininfo -root -tree"
  },
  {
    "instruction": "Set screen blanking timeout to 5 minutes",
    "output": "xset dpms 0 0 300"
  },
  {
    "instruction": "Check all xset settings",
    "output": "xset q"
  },
  {
    "instruction": "List input devices",
    "output": "xinput list"
  },
  {
    "instruction": "Show input device properties",
    "output": "xinput list-props 'Synaptics TouchPad'"
  },
  {
    "instruction": "Set touchpad tap-to-click on",
    "output": "xinput set-prop 'Synaptics TouchPad' 'libinput Tapping Enabled' 1"
  },
  {
    "instruction": "Type text with xdotool",
    "output": "xdotool type 'Hello World'"
  },
  {
    "instruction": "Move mouse to coordinates",
    "output": "xdotool mousemove 100 200"
  },
  {
    "instruction": "Click mouse button 1",
    "output": "xdotool click 1"
  },
  {
    "instruction": "Focus a window by name",
    "output": "xdotool search --name 'Terminal' windowactivate"
  },
  {
    "instruction": "Set keyboard layout to US",
    "output": "setxkbmap us"
  },
  {
    "instruction": "Set keyboard layout to German",
    "output": "setxkbmap de"
  }
]