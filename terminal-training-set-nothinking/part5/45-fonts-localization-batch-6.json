[
  {
    "instruction": "List all installed fonts",
    "output": "fc-list"
  },
  {
    "instruction": "Find font by name pattern",
    "output": "fc-list | grep -i 'dejavu'"
  },
  {
    "instruction": "List fonts by family and style",
    "output": "fc-list 'DejaVu Sans:style=Bold'"
  },
  {
    "instruction": "Update font cache",
    "output": "fc-cache -fv"
  },
  {
    "instruction": "Find best match for a font",
    "output": "fc-match 'Arial'"
  },
  {
    "instruction": "Scan a font file for details",
    "output": "fc-scan /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
  },
  {
    "instruction": "Query font properties",
    "output": "fc-query /usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf"
  },
  {
    "instruction": "List fontconfig configuration",
    "output": "fc-conflist"
  },
  {
    "instruction": "Create fonts.scale file",
    "output": "mkfontscale /usr/share/fonts/truetype/custom"
  },
  {
    "instruction": "Create fonts.dir file",
    "output": "mkfontdir /usr/share/fonts/truetype/custom"
  },
  {
    "instruction": "List X11 fonts",
    "output": "xlsfonts | head -20"
  },
  {
    "instruction": "Check current locale",
    "output": "localectl status"
  },
  {
    "instruction": "List available locales",
    "output": "localectl list-locales"
  },
  {
    "instruction": "Set system locale",
    "output": "localectl set-locale LANG=en_US.UTF-8"
  },
  {
    "instruction": "Generate locales",
    "output": "locale-gen en_US.UTF-8"
  },
  {
    "instruction": "List all available locales",
    "output": "locale -a"
  },
  {
    "instruction": "Check locale charmap",
    "output": "locale charmap"
  },
  {
    "instruction": "Define a new locale",
    "output": "localedef -i en_US -f UTF-8 en_US.UTF-8"
  },
  {
    "instruction": "Convert file encoding with iconv",
    "output": "iconv -f ISO-8859-1 -t UTF-8 input.txt > output.txt"
  },
  {
    "instruction": "Recode file to UTF-8",
    "output": "recode latin1..utf8 input.txt"
  }
