[
  {"instruction": "Enable laptop-mode-tools for aggressive disk power saving", "output": "sudo laptop-mode-tools enable"},
  {"instruction": "Disable laptop-mode-tools", "output": "sudo laptop-mode-tools disable"},
  {"instruction": "Check laptop-mode-tools status", "output": "sudo laptop-mode-tools status"},
  {"instruction": "View laptop-mode-tools configuration", "output": "cat /etc/laptop-mode/laptop-mode.conf"},
  {"instruction": "Force laptop mode on for a specific interval", "output": "echo 5 | sudo tee /proc/sys/vm/laptop_mode"},
  {"instruction": "Check if laptop mode is currently active", "output": "cat /proc/sys/vm/laptop_mode"},
  {"instruction": "Reload laptop-mode-tools configuration", "output": "sudo /etc/init.d/laptop-mode restart"},
  {"instruction": "Restart laptop-mode-tools service", "output": "sudo systemctl restart laptop-mode"},
  {"instruction": "Detect if the system is a laptop", "output": "laptop-detect"},
  {"instruction": "Check laptop detection exit code", "output": "laptop-detect && echo 'Is a laptop' || echo 'Not a laptop'"},
  {"instruction": "Run laptop-detect and print verbose info", "output": "laptop-detect -v"},
  {"instruction": "Check thermald daemon status", "output": "systemctl status thermald"},
  {"instruction": "Start the thermal daemon for active cooling management", "output": "sudo systemctl start thermald"},
  {"instruction": "Stop the thermal daemon", "output": "sudo systemctl stop thermald"},
  {"instruction": "Restart thermald after configuration changes", "output": "sudo systemctl restart thermald"},
  {"instruction": "Enable thermald to start at boot", "output": "sudo systemctl enable thermald"},
  {"instruction": "View thermald log entries", "output": "journalctl -u thermald -n 30"},
  {"instruction": "Check the thermald configuration file", "output": "cat /etc/thermald/thermal-conf.xml"},
  {"instruction": "Run auto-cpufreq in interactive mode", "output": "sudo auto-cpufreq --live"},
  {"instruction": "Run auto-cpufreq monitoring in live mode", "output": "sudo auto-cpufreq --monitor"},
  {"instruction": "Install auto-cpufreq as a systemd service", "output": "sudo auto-cpufreq --install"},
  {"instruction": "Remove auto-cpufreq systemd service", "output": "sudo auto-cpufreq --remove"},
  {"instruction": "Check auto-cpufreq current status and stats", "output": "sudo auto-cpufreq --stats"},
  {"instruction": "Show auto-cpufreq version information", "output": "auto-cpufreq --version"},
  {"instruction": "Show auto-cpufreq help", "output": "auto-cpufreq --help"},
  {"instruction": "Run auto-cpufreq force powersave for battery", "output": "sudo auto-cpufreq --force=powersave"},
  {"instruction": "Run auto-cpufreq force performance on AC power", "output": "sudo auto-cpufreq --force=performance"}
