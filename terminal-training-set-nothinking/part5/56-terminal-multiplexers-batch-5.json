[
  {"instruction": "Start screen with title 'logs' and command", "output": "screen -t logs tail -f /var/log/syslog"},
  {"instruction": "Start screen with logging enabled to file", "output": "screen -L -S debug"},
  {"instruction": "Start screen with custom config file", "output": "screen -c ~/.screenrc.custom"},
  {"instruction": "Set scrollback buffer to 5000 lines", "output": "screen -h 5000"},
  {"instruction": "Start screen with UTF-8 encoding", "output": "screen -U"},
  {"instruction": "Detach screen and log out cleanly", "output": "screen -D"},
  {"instruction": "Reattach to highest-numbered session", "output": "screen -RR"},
  {"instruction": "Send literal Ctrl+A to underlying app", "output": "screen -X eval 'stuff \\001'"},
  {"instruction": "Detach current screen session", "output": "screen -d"},
  {"instruction": "Kill current screen window", "output": "screen -X kill"},
  {"instruction": "Kill all windows and terminate screen", "output": "screen -X quit"},
  {"instruction": "Create a new screen window", "output": "screen"},
  {"instruction": "Switch to next screen window", "output": "screen -X next"},
  {"instruction": "Switch to previous screen window", "output": "screen -X prev"},
  {"instruction": "List all windows in screen session", "output": "screen -X windows"},
  {"instruction": "Show window list with details", "output": "screen -X windowlist"},
  {"instruction": "Redraw current screen window", "output": "screen -X redisplay"},
  {"instruction": "Clear screen in current window", "output": "screen -X clear"},
  {"instruction": "Switch directly to window 7", "output": "screen -X select 7"},
  {"instruction": "Rename current window to 'compiler'", "output": "screen -X title compiler"},
