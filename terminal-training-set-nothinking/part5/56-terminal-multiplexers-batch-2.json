[
  {"instruction": "Set default-shell to /bin/zsh", "output": "tmux set-option -g default-shell /bin/zsh"},
  {"instruction": "Disable window activity monitoring", "output": "tmux set-window-option -g monitor-activity off"},
  {"instruction": "Bind Ctrl+a to send prefix", "output": "tmux bind-key C-a send-prefix"},
  {"instruction": "Unbind Ctrl+b from any action", "output": "tmux unbind-key C-b"},
  {"instruction": "Source tmux configuration file", "output": "tmux source-file ~/.tmux.conf"},
  {"instruction": "Load buffer contents from file", "output": "tmux load-buffer ~/.ssh/id_rsa.pub"},
  {"instruction": "Save buffer to file", "output": "tmux save-buffer ~/tmux-buffer.txt"},
  {"instruction": "Enter copy mode for scrolling", "output": "tmux copy-mode"},
  {"instruction": "Capture pane 0 contents to buffer", "output": "tmux capture-pane -t :1.0"},
  {"instruction": "Capture last 100 lines of pane", "output": "tmux capture-pane -t :1.0 -S -100"},
  {"instruction": "Open interactive session chooser", "output": "tmux choose-session"},
  {"instruction": "Open tree view of sessions/windows/panes", "output": "tmux choose-tree"},
  {"instruction": "Open interactive client chooser", "output": "tmux choose-client"},
  {"instruction": "Show clock in current pane", "output": "tmux clock-mode"},
  {"instruction": "Pipe pane output to external script", "output": "tmux pipe-pane -o 'cat >> /tmp/pane.log'"},
  {"instruction": "Create new window in session 'dev'", "output": "tmux new-window -t dev"},
  {"instruction": "Create new window named 'monitor'", "output": "tmux new-window -n monitor"},
  {"instruction": "Rename current window to 'editor'", "output": "tmux rename-window editor"},
  {"instruction": "Rename session 'oldname' to 'newname'", "output": "tmux rename-session -t oldname newname"},
  {"instruction": "Create new session linked to existing deploy", "output": "tmux new-session -s prod -t deploy"},
  {"instruction": "Kill window number 3", "output": "tmux kill-window -t :3"},
  {"instruction": "Kill pane 1 in current window", "output": "tmux kill-pane -t 1"}
]
