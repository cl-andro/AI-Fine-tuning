[
  {"instruction": "Start the WirePlumber session manager", "output": "wireplumber"},
  {"instruction": "Start WirePlumber with verbose debugging", "output": "wireplumber --verbose"},
  {"instruction": "Check if wireplumber is running", "output": "pgrep -x wireplumber"},
  {"instruction": "Restart the pipewire-pulse service (replaces PulseAudio)", "output": "systemctl --user restart pipewire-pulse"},
  {"instruction": "Check status of pipewire-pulse service", "output": "systemctl --user status pipewire-pulse"},
  {"instruction": "Stop pipewire-pulse service", "output": "systemctl --user stop pipewire-pulse"},
  {"instruction": "Start the pipewire-pulse compatibility layer", "output": "systemctl --user start pipewire-pulse"},
  {"instruction": "List all ALSA playback devices", "output": "aplay -l"},
  {"instruction": "List all ALSA capture (recording) devices", "output": "arecord -l"},
  {"instruction": "List all ALSA PCM devices with details", "output": "aplay -L"},
  {"instruction": "Record audio from default ALSA mic to WAV", "output": "arecord -f cd recording.wav"},
  {"instruction": "Record 10 seconds of audio with ALSA at 44100 Hz, 16-bit", "output": "arecord -d 10 -f S16_LE -r 44100 -c 2 test.wav"},
  {"instruction": "Play a WAV file with ALSA using aplay", "output": "aplay music.wav"},
  {"instruction": "Play a WAV file at a specific ALSA device", "output": "aplay -D hw:0,0 music.wav"},
  {"instruction": "Play a raw PCM file with ALSA specifying format", "output": "aplay -f cd -t raw audio.raw"},
  {"instruction": "Get current ALSA mixer volumes and settings", "output": "amixer"},
  {"instruction": "Get ALSA controls for a specific sound card", "output": "amixer -c 0"},
  {"instruction": "Set Master playback volume to 80% with amixer", "output": "amixer set Master 80%"},
  {"instruction": "Set PCM volume to 75% with amixer", "output": "amixer set PCM 75%"},
  {"instruction": "Mute the Master channel with amixer", "output": "amixer set Master mute"},
  {"instruction": "Unmute the Master channel with amixer", "output": "amixer set Master unmute"},
  {"instruction": "Toggle mute on Master channel", "output": "amixer set Master toggle"},
  {"instruction": "Set Headphone volume to 70%", "output": "amixer set Headphone 70%"},
  {"instruction": "Capture (mic) volume set to 90%", "output": "amixer set Capture 90%"},
  {"instruction": "Toggle mute on internal microphone", "output": "amixer set 'Internal Mic' toggle"}
]
