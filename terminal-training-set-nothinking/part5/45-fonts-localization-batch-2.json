[
  {
    "instruction": "Convert filename encoding",
    "output": "convmv -f cp1251 -t utf8 --notest file.txt"
  },
  {
    "instruction": "Subset a font with pyftsubset",
    "output": "pyftsubset DejaVuSans.ttf --text='Hello World' --output-file=subset.ttf"
  },
  {
    "instruction": "Compress woff2 font",
    "output": "woff2_compress DejaVuSans.ttf"
  },
  {
    "instruction": "Check language pack availability",
    "output": "check-language-support -l de"
  },
  {
    "instruction": "Install German language pack",
    "output": "apt install -y $(check-language-support -l de)"
  },
  {
    "instruction": "Show font catalog",
    "output": "fc-cat /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
  },
  {
    "instruction": "Show fontconfig configuration",
    "output": "fc-conflist"
  },
  {
    "instruction": "Set font anti-aliasing",
    "output": "echo '<?xml version=\"1.0\"?><!DOCTYPE fontconfig SYSTEM \"fonts.dtd\"><fontconfig><match target=\"font\"><edit name=\"antialias\" mode=\"assign\"><bool>true</bool></edit></match></fontconfig>' > ~/.config/fontconfig/conf.d/10-antialias.conf"
  },
  {
    "instruction": "Set font hinting style",
    "output": "echo '<?xml version=\"1.0\"?><!DOCTYPE fontconfig SYSTEM \"fonts.dtd\"><fontconfig><match target=\"font\"><edit name=\"hinting\" mode=\"assign\"><bool>true</bool></edit></match></fontconfig>' > ~/.config/fontconfig/conf.d/10-hinting.conf"
  },
  {
    "instruction": "Clear fontconfig cache and rebuild",
    "output": "rm -rf ~/.cache/fontconfig && fc-cache -fv"
  },
  {
    "instruction": "Show font format info",
    "output": "fc-scan /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf | grep -E 'format|style' | head -10"
  },
  {
    "instruction": "Find all bold fonts",
    "output": "fc-list | grep -i bold | head -20"
  },
  {
    "instruction": "Find monospace fonts",
    "output": "fc-list | grep -i mono | head -20"
  },
  {
    "instruction": "List font dirs",
    "output": "fc-list --format='%{file}\\n' | sort -u | head -20"
  },
  {
    "instruction": "Create a font directory",
    "output": "mkdir -p ~/.local/share/fonts && fc-cache -fv"
  },
  {
    "instruction": "Install a font file system-wide",
    "output": "cp MyFont.ttf /usr/local/share/fonts/ && fc-cache -fv"
  },
  {
    "instruction": "Install all German locales",
    "output": "locale-gen de_DE de_DE.UTF-8 && dpkg-reconfigure locales"
  },
  {
    "instruction": "Show locale environment vars",
    "output": "locale -k LC_TIME"
  },
  {
    "instruction": "Install French language support",
    "output": "apt install -y language-pack-fr"
  },
  {
    "instruction": "Convert entire directory encoding",
    "output": "convmv -f utf8 -t latin1 --notest *.txt"
  },
  {
    "instruction": "Decompress woff2 font",
    "output": "woff2_decompress font.woff2"
  },
  {
    "instruction": "Show X font server fonts",
    "output": "xlsfonts | grep -i courier"
  },
  {
    "instruction": "Convert BDF to PCF font",
    "output": "bdftopcf font.bdf > font.pcf"
  },
  {
    "instruction": "Truncate a BDF font",
    "output": "bdftruncate 32 127 font.bdf > reduced.bdf"
  },
  {
    "instruction": "Show fontforge version",
    "output": "fontforge --version"
  }
]