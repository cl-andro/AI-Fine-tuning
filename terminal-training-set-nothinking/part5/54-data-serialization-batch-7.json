[
  {"instruction": "Decode a protobuf binary file to text", "output": "protoc --decode=MyMessage schema.proto < data.bin"},
  {"instruction": "Encode a protobuf text file to binary", "output": "protoc --encode=MyMessage schema.proto < data.txt > data.bin"},
  {"instruction": "Generate a protobuf descriptor set", "output": "protoc --descriptor_set_out=schema.desc --include_imports schema.proto"},
  {"instruction": "Specify proto import paths", "output": "protoc --proto_path=src --proto_path=/usr/include proto/api.proto"},
  {"instruction": "Generate JavaScript code from proto", "output": "protoc --js_out=import_style=commonjs,binary:./out proto/*.proto"},
  {"instruction": "Generate Python code from proto", "output": "protoc --python_out=./gen proto/*.proto"},
  {"instruction": "Generate Go code from proto", "output": "protoc --go_out=./gen --go_opt=paths=source_relative proto/*.proto"},
  {"instruction": "Generate gRPC Python stubs", "output": "python -m grpc_tools.protoc --python_out=. --grpc_python_out=. service.proto"},
  {"instruction": "Encode JSON as MessagePack using msgpack CLI", "output": "msgpack-cli encode data.json > data.msgpack"},
  {"instruction": "Decode MessagePack to JSON", "output": "msgpack-cli decode data.msgpack > output.json"},
  {"instruction": "Pretty-print MessagePack data", "output": "msgpack-cli decode --pretty data.msgpack"},
  {"instruction": "Encode CBOR diagnostic notation", "output": "cbor-diag --to-cbor data.diag > data.cbor"},
  {"instruction": "Decode CBOR to diagnostic notation", "output": "cbor-diag data.cbor > output.diag"},
  {"instruction": "Convert CBOR to JSON", "output": "cbor-diag --to-json data.cbor > data.json"},
  {"instruction": "Convert JSON to CBOR", "output": "cbor-diag --from-json data.json > data.cbor"},
  {"instruction": "Inspect CBOR data types", "output": "cbor-diag --verbose data.cbor"},
  {"instruction": "Stream-encode multiple JSON objects to CBOR", "output": "cat *.json | cbor-diag --from-json --stream > all.cbor"},
  {"instruction": "Decode protobuf with multiple message types", "output": "protoc --decode=Wrapper --decode=Payload schema.proto < mixed.bin"},
  {"instruction": "Use protoc with field masks", "output": "protoc --decode=google.protobuf.FieldMask empty.proto < mask.bin"},
  {"instruction": "Generate Java code from proto", "output": "protoc --java_out=./java proto/*.proto"},
  {"instruction": "Generate C++ code from proto definitions", "output": "protoc --cpp_out=./cpp proto/*.proto"},
  {"instruction": "Decode a protobuf any type", "output": "protoc --decode=google.protobuf.Any any.proto < message.bin"},
  {"instruction": "List fields in a protobuf descriptor", "output": "protoc --decode_raw < data.bin"},
  {"instruction": "Convert CSV to MessagePack via JSON", "output": "csvformat -j data.csv | msgpack-cli encode > data.msgpack"},
  {"instruction": "Batch decode multiple CBOR files", "output": "for f in *.cbor; do cbor-diag \"$f\" > \"${f%.cbor}.diag\"; done"}
