[
  {"instruction": "Suspend current tmux client", "output": "tmux suspend-client"},
  {"instruction": "Refresh client with new environment", "output": "tmux refresh-client -S"},
  {"instruction": "Send literal keys without interpretation", "output": "tmux send-keys -l 'echo $HOME'"},
  {"instruction": "Send copy-mode keys with no-wrap", "output": "tmux send-keys -X -N -R 'C-u'"},
  {"instruction": "Enter interactive customize mode", "output": "tmux customize-mode"},
  {"instruction": "Find window with 'nginx' in title/content", "output": "tmux find-window nginx"},
  {"instruction": "Jump to pane number 3", "output": "tmux jump-to-pane -t 3"},
  {"instruction": "Display a custom text menu", "output": "tmux display-menu -T 'Actions' 'Build' b 'run make' 'Deploy' d 'run deploy.sh'"},
  {"instruction": "Display popup with htop", "output": "tmux display-popup -w 80% -h 60% 'htop'"},
  {"instruction": "Show recent message log", "output": "tmux show-messages"},
  {"instruction": "Switch to next layout preset", "output": "tmux next-layout"},
  {"instruction": "Switch to previous layout preset", "output": "tmux previous-layout"},
  {"instruction": "Rotate panes forward", "output": "tmux rotate-window"},
  {"instruction": "Select tiled layout", "output": "tmux select-layout tiled"},
  {"instruction": "Start new screen session named 'work'", "output": "screen -S work"},
  {"instruction": "Reattach to detached screen session", "output": "screen -r"},
  {"instruction": "Reattach to session named 'work'", "output": "screen -r work"},
  {"instruction": "Start screen detached running htop", "output": "screen -d -m htop"},
  {"instruction": "List all screen sessions", "output": "screen -ls"},
  {"instruction": "Attach to multi-display screen session", "output": "screen -x"},
  {"instruction": "Send command string to screen window", "output": "screen -S work -X stuff 'ls -la\\n'"},
  {"instruction": "Select window 5 then reattach", "output": "screen -p 5 -r work"}
