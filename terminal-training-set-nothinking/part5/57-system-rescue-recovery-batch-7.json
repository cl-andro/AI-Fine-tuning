[
  {"instruction": "Clone disk with dc3dd from /dev/sda to /dev/sdb", "output": "dc3dd if=/dev/sda of=/dev/sdb"},
  {"instruction": "Clone with SHA256 hash verification", "output": "dc3dd if=/dev/sda of=/tmp/image.dd hash=sha256"},
  {"instruction": "Clone with log file output", "output": "dc3dd if=/dev/sda of=/tmp/image.dd log=/tmp/dc3dd.log"},
  {"instruction": "Clone specific sector count", "output": "dc3dd if=/dev/sda of=/tmp/part.dd count=10000"},
  {"instruction": "Resume interrupted dc3dd clone", "output": "dc3dd if=/dev/sda of=/tmp/image.dd hash=sha256 resume=/tmp/dc3dd.log"},
  {"instruction": "Clone with progress display", "output": "dc3dd if=/dev/sda of=/tmp/image.dd verb=on"},
  {"instruction": "Clone computing MD5 during copy", "output": "dc3dd if=/dev/sda of=/tmp/image.dd hash=md5"},
  {"instruction": "Split output into 2GB chunks", "output": "dc3dd if=/dev/sda of=/tmp/image.dd ofs=2G"},
  {"instruction": "Clone disk with dcfldd", "output": "dcfldd if=/dev/sda of=/tmp/image.dd"},
  {"instruction": "Clone with SHA256 hashlog", "output": "dcfldd if=/dev/sda of=/tmp/out.dd hash=sha256 hashlog=/tmp/hash.txt"},
  {"instruction": "Clone with 1-second status updates", "output": "dcfldd if=/dev/sda of=/tmp/image.dd sizeprobe=if statusinterval=1"},
  {"instruction": "Clone to multiple output files simultaneously", "output": "dcfldd if=/dev/sda of=/tmp/out1.dd of=/tmp/out2.dd"},
  {"instruction": "Clone with verify mode", "output": "dcfldd if=/dev/sda of=/tmp/image.dd verify=on"},
  {"instruction": "Clone with bad sector handling", "output": "dcfldd if=/dev/sda of=/tmp/image.dd bs=512 conv=noerror,notrunc"},
  {"instruction": "Clone with per-transfer display", "output": "dcfldd if=/dev/sda of=/tmp/image.dd display=on"},
  {"instruction": "GNU ddrescue with force and no-retry", "output": "ddrescue -f -n /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "ddrescue with direct I/O", "output": "ddrescue -f -d /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "ddrescue with 3 retries", "output": "ddrescue -f -r3 /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "ddrescue specific partition", "output": "ddrescue -f /dev/sda1 /tmp/part1.img /tmp/part1.log"},
  {"instruction": "ddrescue with mapfile preallocation", "output": "ddrescue -f -m /dev/sda /tmp/rescue.img /tmp/rescue.log"},
  {"instruction": "Check ddrescue mapfile status", "output": "ddrescue --status /tmp/rescue.log"},
  {"instruction": "Fill unreadable with zeros in ddrescue", "output": "ddrescue --fill=+ /dev/sda /tmp/rescue.img /tmp/rescue.log"}
