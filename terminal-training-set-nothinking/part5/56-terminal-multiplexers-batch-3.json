[
  {"instruction": "Respawn pane with htop", "output": "tmux respawn-pane -k 'htop'"},
  {"instruction": "Respawn window with default shell command", "output": "tmux respawn-window -k"},
  {"instruction": "Move window 2 to session other at index 1", "output": "tmux move-window -s 2 -t other:1"},
  {"instruction": "Link window 3 from other session", "output": "tmux link-window -s other:3 -t :5"},
  {"instruction": "Unlink current window from session", "output": "tmux unlink-window"},
  {"instruction": "Swap window 1 with 3 and detach others", "output": "tmux swap-window -d -D -dD"},
  {"instruction": "Set global environment variable in tmux", "output": "tmux set-environment -g EDITOR vim"},
  {"instruction": "Show all tmux environment variables", "output": "tmux show-environment"},
  {"instruction": "Set buffer from string literal", "output": "tmux set-buffer 'clipboard content'"},
  {"instruction": "Paste buffer 0 at cursor position", "output": "tmux paste-buffer -b 0"},
  {"instruction": "List all paste buffers", "output": "tmux list-buffers"},
  {"instruction": "Delete buffer named 'temp'", "output": "tmux delete-buffer -b temp"},
