[
  {"instruction": "Enable byobu at login", "output": "byobu-enable"},
  {"instruction": "Disable byobu at login", "output": "byobu-disable"},
  {"instruction": "Start a new byobu session", "output": "byobu"},
  {"instruction": "Create new byobu session named 'monitor'", "output": "byobu new-session -s monitor"},
  {"instruction": "List all byobu sessions", "output": "byobu list-sessions"},
  {"instruction": "Attach to existing byobu session", "output": "byobu attach"},
  {"instruction": "Attach to session named 'dev'", "output": "byobu attach -t dev"},
  {"instruction": "Send keys to byobu window 0", "output": "byobu send-keys -t 0 'systemctl status sshd' Enter"},
  {"instruction": "Create new byobu window named logs", "output": "byobu new-window -n 'logs'"},
  {"instruction": "Select window number 3", "output": "byobu select-window -t 3"},
  {"instruction": "Split pane vertically", "output": "byobu split-window -v"},
  {"instruction": "Split pane horizontally", "output": "byobu split-window -h"},
  {"instruction": "Toggle byobu status notifications", "output": "byobu-toggle"},
  {"instruction": "Open byobu configuration menu", "output": "byobu-config"},
  {"instruction": "Enable byobu shell prompt integration", "output": "byobu-shell"},
  {"instruction": "Set byobu status bar left format", "output": "byobu set-status-format 'status-left \"#S\"'"},
  {"instruction": "Kill byobu session 'temp'", "output": "byobu kill-session -t temp"},
  {"instruction": "Rename byobu session from old to new", "output": "byobu rename-session -t old new"},
  {"instruction": "Rename current byobu window", "output": "byobu rename-window 'dashboard'"},
  {"instruction": "Display byobu keybindings", "output": "byobu keybindings"},
  {"instruction": "Quit byobu and close all windows", "output": "byobu exit"},
  {"instruction": "Launch byobu with tmux backend explicitly", "output": "byobu-tmux new-session -s explicit"}
]
