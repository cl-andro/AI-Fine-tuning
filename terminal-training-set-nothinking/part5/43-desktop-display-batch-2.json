[
  {
    "instruction": "List Wayland outputs with wlr-randr",
    "output": "wlr-randr"
  },
  {
    "instruction": "Set brightness to 50%",
    "output": "brightnessctl set 50%"
  },
  {
    "instruction": "Check current brightness",
    "output": "brightnessctl get"
  },
  {
    "instruction": "Set Gnome theme to dark",
    "output": "gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'"
  },
  {
    "instruction": "Set wallpaper via gsettings",
    "output": "gsettings set org.gnome.desktop.background picture-uri file:///path/to/wallpaper.jpg"
  },
  {
    "instruction": "Configure automatic screen lock",
    "output": "gsettings set org.gnome.desktop.screensaver lock-enabled true"
  },
  {
    "instruction": "Enable display output auto detection",
    "output": "xrandr --auto"
  },
  {
    "instruction": "Set display below primary",
    "output": "xrandr --output HDMI-1 --auto --below eDP-1"
  },
  {
    "instruction": "Set display above primary",
    "output": "xrandr --output HDMI-1 --auto --above eDP-1"
  },
  {
    "instruction": "Reflect display horizontally",
    "output": "xrandr --output HDMI-1 --reflect x"
  },
  {
    "instruction": "Set display scale factor",
    "output": "xrandr --output eDP-1 --scale 1.5x1.5"
  },
  {
    "instruction": "Undo transform on display",
    "output": "xrandr --output eDP-1 --transform 1,0,0,0,1,0,0,0,1"
  },
  {
    "instruction": "Enable display power management",
    "output": "xset dpms force on"
  },
  {
    "instruction": "Force display to standby",
    "output": "xset dpms force standby"
  },
  {
    "instruction": "Disable screen saver",
    "output": "xset s off"
  },
  {
    "instruction": "Set mouse acceleration",
    "output": "xset m 2.0 4"
  },
  {
    "instruction": "Set keyboard repeat rate",
    "output": "xset r rate 200 30"
  },
  {
    "instruction": "Show root window properties",
    "output": "xprop -root"
  },
  {
    "instruction": "List font path",
    "output": "xset q | grep -A 1 'Font Path'"
  },
  {
    "instruction": "Release grab on input devices",
    "output": "xdotool key XF86LogGrabInfo"
  },
  {
    "instruction": "Get active window title",
    "output": "xdotool getactivewindow getwindowname"
  },
  {
    "instruction": "Sleep 2 seconds between commands",
    "output": "xdotool sleep 2"
  },
  {
    "instruction": "Search for windows with Firefox",
    "output": "xdotool search --class Firefox"
  },
  {
    "instruction": "List workspaces with wmctrl",
    "output": "wmctrl -d"
  },
  {
    "instruction": "Switch to workspace 2",
    "output": "wmctrl -s 1"
  },
  {
    "instruction": "List Wayland outputs",
    "output": "swaymsg -t get_outputs"
  }
]