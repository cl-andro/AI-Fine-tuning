[
  {"instruction": "How to enable OpenFlow metrics in ODL", "output": "log:set INFO org.opendaylight.openflowplugin.statistics"},
  {"instruction": "How to enable topology notifications in ODL", "output": "feature:install odl-mdsal-all"},
  {"instruction": "How to subscribe to ODL data change events", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"input\":{\"path\":\"/network-topology:network-topology\"}}' http://localhost:8181/restconf/operations/data-change-event-subscription:register"},
  {"instruction": "How to enable northbound REST API in ODL", "output": "feature:install odl-restconf-all"},
  {"instruction": "How to install OpenDaylight's SNMP plugin", "output": "feature:install odl-snmp"},
  {"instruction": "How to enable OpenStack integration in ODL", "output": "feature:install odl-ovsdb-openstack"},
  {"instruction": "How to configure ODL Neutron ML2", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"neutron-config\":{\"ml2-type-drivers\":\"vlan,flat,vxlan\"}}' http://localhost:8181/restconf/config/neutron:neutron-config"},
  {"instruction": "How to list ODL Neutron networks", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/neutron:networks"},
  {"instruction": "How to create ODL Neutron network", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"network\":{\"id\":\"net1\",\"name\":\"my-network\"}}' http://localhost:8181/restconf/config/neutron:networks"},
  {"instruction": "How to delete ODL Neutron network", "output": "curl -u admin:admin -X DELETE http://localhost:8181/restconf/config/neutron:networks/network/net1"},
  {"instruction": "How to install CAPWAP in ODL", "output": "feature:install odl-capwap"},
  {"instruction": "How to enable LLDP discovery in ODL", "output": "feature:install odl-l2switch-switch"},
  {"instruction": "How to enable ODL with clustering", "output": "bin/karaf -Dmember=1"},
  {"instruction": "How to configure seed nodes in ODL cluster", "output": "echo '-Dakka.cluster.seed-nodes=192.168.1.10:2550,192.168.1.11:2550' >> etc/default/karaf"},
  {"instruction": "How to check ODL cluster members", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/odl-cluster:cluster/members"},
  {"instruction": "How to get ODL datastore statistics", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/odl-datastore-statistics:statistics"},
  {"instruction": "How to enable ODL distributed datastore", "output": "feature:install odl-mdsal-clustering-distributed"},
  {"instruction": "How to check the clustering state from CLI", "output": "odl-cluster:status"},
  {"instruction": "How to check ODL data store journal status", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/mdsal-operational-datastore/shard:shards"},
  {"instruction": "How to flush ODL data store to disk", "output": "curl -u admin:admin -X POST http://localhost:8181/restconf/operations/mdsal-operational-datastore:flush"},
  {"instruction": "How to capture ODL thread dump", "output": "dev:dump-threads"},
  {"instruction": "How to set Karaf SSH port", "output": "export KARAF_SSH_PORT=8101 && bin/karaf"},
  {"instruction": "How to access Karaf SSH console", "output": "ssh -p 8101 admin@localhost"},
  {"instruction": "How to change ODL keystore password", "output": "keytool -storepasswd -keystore odl.jks"},
  {"instruction": "How to verify ODL installation integrity", "output": "feature:list | grep -i openflow"}
]