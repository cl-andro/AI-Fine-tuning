[
  {"instruction": "How to install Unbound on Debian", "output": "apt install unbound unbound-anchor"},
  {"instruction": "How to create Unbound logging directory", "output": "mkdir -p /var/log/unbound && chown unbound:unbound /var/log/unbound"},
  {"instruction": "How to configure Unbound to log to a file", "output": "echo '  logfile: \"/var/log/unbound/unbound.log\"' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to set up Unbound for DNSSEC with trust anchor", "output": "unbound-anchor -a /var/lib/unbound/root.key"},
  {"instruction": "How to test DNSSEC validation in Unbound", "output": "dig @127.0.0.1 sigfail.verteiltesysteme.net A"},
  {"instruction": "How to set Unbound to refuse queries from outside", "output": "echo '  access-control: 0.0.0.0/0 refuse' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to set Unbound to use systemd socket activation", "output": "echo '  use-systemd: yes' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to reduce Unbound memory footprint", "output": "echo '  edns-buffer-size: 1232' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to configure private address space in Unbound", "output": "echo '  private-address: 10.0.0.0/8' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to forward subdomain to specific resolver", "output": "echo 'forward-zone:\n  name: \"internal.corp\"\n  forward-addr: 10.0.0.2' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to add multiple forward zones in Unbound", "output": "echo 'forward-zone:\n  name: \".\"\n  forward-addr: 8.8.8.8\n  forward-addr: 8.8.4.4' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to configure Unbound for DoH (DNS over HTTPS)", "output": "echo 'forward-zone:\n  name: \".\"\n  forward-addr: https://1.1.1.1/dns-query' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to enable prefetching in Unbound", "output": "echo '  prefetch: yes' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to set up domain-insecure for specific domain", "output": "echo '  domain-insecure: \"example.com\"' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to add stub-zone for authoritative server", "output": "echo 'stub-zone:\n  name: \"example.com\"\n  stub-addr: 192.168.1.1\n  stub-prime: no' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to force TCP queries in Unbound", "output": "echo '  do-udp: no' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to adjust number of threads in Unbound", "output": "echo '  num-threads: 4' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to set outgoing port range in Unbound", "output": "echo '  outgoing-port-permit: 1024-65535' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to configure Unbound for maximum performance", "output": "echo '  infra-cache-numhosts: 50000\n  rrset-cache-size: 512m\n  msg-cache-size: 256m' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to block specified domains in Unbound", "output": "echo '  local-zone: \"ads.example.com\" redirect\n  local-data: \"ads.example.com A 127.0.0.1\"' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to serve a static record for a domain", "output": "echo '  local-data: \"static.example.com IN A 10.0.0.100\"' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to set up Unbound to return NXDOMAIN for certain domains", "output": "echo '  local-zone: \"tracking.example.com\" always_nxdomain' >> /etc/unbound/unbound.conf"},
  {"instruction": "How to check Unbound config for syntax errors", "output": "unbound-checkconf /etc/unbound/unbound.conf"},
  {"instruction": "How to restart unbound with systemctl", "output": "systemctl restart unbound"},
  {"instruction": "How to check unbound service status", "output": "systemctl status unbound"}
]