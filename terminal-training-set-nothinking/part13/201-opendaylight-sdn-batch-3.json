[
  {"instruction": "How to start OpenDaylight with custom port", "output": "export ORG_OSGI_SERVICE_HTTP_PORT=9090 && bin/karaf"},
  {"instruction": "How to add OpenFlow priority flow", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow-node-inventory:flow\":[{\"id\":\"high-pri\",\"priority\":100,\"match\":{\"ethernet-match\":{\"ethernet-type\":{\"type\":0x0800}}},\"instructions\":{\"instruction\":[{\"order\":0,\"apply-actions\":{\"action\":[{\"order\":0,\"drop-action\":{}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0/flow:high-pri"},
  {"instruction": "How to get ODL statistics for a flow", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes/node/openflow:1/table:0/flow:1"},
  {"instruction": "How to create a YANG model in ODL", "output": "echo 'module my-model { namespace \"urn:example:my-model\"; prefix my; revision 2025-01-01; container root { leaf name { type string; } } }' > ~/my-model.yang"},
  {"instruction": "How to validate a YANG file", "output": "yang-tools validate ~/my-model.yang"},
  {"instruction": "How to convert YANG to YIN format", "output": "yang-tools yang2yin ~/my-model.yang > ~/my-model.yin"},
  {"instruction": "How to convert YIN to YANG format", "output": "yang-tools yin2yang ~/my-model.yin > ~/my-model.yang"},
  {"instruction": "How to list YANG schema in ODL", "output": "curl -u admin:admin http://localhost:8181/restconf/config/yang-ext:mount/odl-sal:yang-schemas"},
  {"instruction": "How to get ODL datastore operational data", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes"},
  {"instruction": "How to get ODL datastore config data", "output": "curl -u admin:admin http://localhost:8181/restconf/config/opendaylight-inventory:nodes"},
  {"instruction": "How to send OpenFlow packet-out in ODL", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"input\":{\"node\":\"/opendaylight-inventory:nodes/node/openflow:1\",\"egress\":\"1\",\"buffer-id\":\"1\",\"payload\":\"base64payload\"}}' http://localhost:8181/restconf/operations/sal-raw-send-packet-out"},
  {"instruction": "How to list OpenDaylight Yang Models", "output": "feature:list | grep yang"},
  {"instruction": "How to install odl-yangtools-common", "output": "feature:install odl-yangtools-common"},
  {"instruction": "How to access OpenDaylight API docs", "output": "curl -u admin:admin http://localhost:8181/apidoc/explorer/"},
  {"instruction": "How to list ODL services from CLI", "output": "service:list"},
  {"instruction": "How to register a new ODL node", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"node\":[{\"node-id\":\"my-switch\",\"netconf-node-topology:host\":\"192.168.1.2\",\"netconf-node-topology:port\":830,\"netconf-node-topology:tcp-only\":false}]}' http://localhost:8181/restconf/config/network-topology:network-topology/topology/topology-netconf"},
  {"instruction": "How to remove an ODL node", "output": "curl -u admin:admin -X DELETE http://localhost:8181/restconf/config/network-topology:network-topology/topology/topology-netconf/node/my-switch"},
  {"instruction": "How to list ODL Netconf nodes", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/network-topology:network-topology/topology/topology-netconf"},
  {"instruction": "How to connect to a Netconf device via ODL", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"input\":{\"node\":\"my-switch\"}}' http://localhost:8181/restconf/operations/sal-netconf-connector:connect"},
  {"instruction": "How to disconnect a Netconf device", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"input\":{\"node\":\"my-switch\"}}' http://localhost:8181/restconf/operations/sal-netconf-connector:disconnect"},
  {"instruction": "How to get ODL cluster status", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/odl-cluster:cluster"},
  {"instruction": "How to list all OpenFlow groups", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes/node/openflow:1/group"},
  {"instruction": "How to add OpenFlow group in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"group-id\":1,\"group-type\":\"group-all\",\"buckets\":[{\"bucket-id\":1,\"actions\":[{\"order\":0,\"output-action\":{\"output-node-connector\":\"2\"}}]}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/group/1"},
  {"instruction": "How to get ODL active threads", "output": "dev:threads"},
  {"instruction": "How to get ODL uptime", "output": "system:info | grep Uptime"}
]