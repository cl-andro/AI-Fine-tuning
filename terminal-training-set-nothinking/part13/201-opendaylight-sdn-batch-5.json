[
  {"instruction": "How to install ODL from debian package", "output": "apt install opendaylight"},
  {"instruction": "How to download ODL from nexus", "output": "wget https://nexus.opendaylight.org/content/repositories/public/org/opendaylight/integration/karaf/0.10.0/karaf-0.10.0.tar.gz"},
  {"instruction": "How to unpack and start ODL", "output": "tar xzf karaf-0.10.0.tar.gz && cd karaf-0.10.0 && bin/start"},
  {"instruction": "How to view ODL OpenFlow port status", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes/node/openflow:1 | jq '.node[0].\"flow-node-inventory:node-connector\"'"},
  {"instruction": "How to add OpenFlow IPv4 flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"ipv4-flow\",\"priority\":100,\"match\":{\"ipv4-source\":\"10.0.0.0/24\",\"ethernet-match\":{\"ethernet-type\":{\"type\":2048}}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add ARP flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"arp-flow\",\"priority\":100,\"match\":{\"ethernet-match\":{\"ethernet-type\":{\"type\":0x0806}}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to install VPN service in ODL", "output": "feature:install odl-vpnservice-api"},
  {"instruction": "How to configure OVS with ODL controller", "output": "ovs-vsctl set-controller br0 tcp:192.168.1.10:6653"},
  {"instruction": "How to set OVS connection to ODL via SSL", "output": "ovs-vsctl set-controller br0 ssl:192.168.1.10:6653"},
  {"instruction": "How to check OVS ODL connection", "output": "ovs-vsctl show | grep Controller"},
  {"instruction": "How to create a TUNNEL in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"network-topology:node\":[{\"node-id\":\"tunnel-node\"}]}' http://localhost:8181/restconf/config/network-topology:network-topology/topology/ovsdb:1"},
  {"instruction": "How to get ODL operational datastore state", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/network-topology:network-topology/topology/ovsdb:1"},
  {"instruction": "How to enable OpenFlow TLS in ODL", "output": "feature:install odl-openflowplugin-flow-services-tls"},
  {"instruction": "How to generate ODL certificates for OpenFlow", "output": "keytool -genkey -alias odl -keyalg RSA -keystore odl.jks -keysize 2048"},
  {"instruction": "How to set https in ODL Karaf", "output": "export ORG_OSGI_SERVICE_HTTPS_PORT=8443 && bin/karaf"},
  {"instruction": "How to list OpenDaylight identity providers", "output": "curl -u admin:admin http://localhost:8181/restconf/config/aaa:id-providers"},
  {"instruction": "How to create ODL network topology from YAML", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d @topology.json http://localhost:8181/restconf/config/network-topology:network-topology"},
  {"instruction": "How to check ODL module health", "output": "http://localhost:8181/restconf/operational/module:module-status"},
  {"instruction": "How to remove an ODL feature", "output": "feature:uninstall odl-openflowplugin-flow-services"},
  {"instruction": "How to enable concurrent session for ODL", "output": "export KARAF_INTERACTIVE_SESSION_TIMEOUT=0 && bin/karaf"},
  {"instruction": "How to check ODL MDSAL datastore type", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/mdsal-operational-datastore"},
  {"instruction": "How to install odl-mdsal-clustering", "output": "feature:install odl-mdsal-clustering"},
  {"instruction": "How to install odl-topology-processing-framework", "output": "feature:install odl-topology-processing-framework"},
  {"instruction": "How to check ODL shard status", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/mdsal-operational-datastore/shard:shards"},
  {"instruction": "How to change ODL cluster member role", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"member-role\":\"member\"}' http://localhost:8181/restconf/config/odl-cluster:cluster"}
]