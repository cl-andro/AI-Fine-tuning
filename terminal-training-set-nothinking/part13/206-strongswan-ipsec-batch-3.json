[
  {"instruction": "How to set certificates path in swanctl.conf", "output": "echo 'secrets {\n  ecdsa {\n    file = /etc/swanctl/private/server.key\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to configure multiple subnets in IPsec", "output": "echo 'children {\n  nets {\n    local_ts = 10.0.0.0/24, 172.16.0.0/24\n    remote_ts = 10.1.0.0/24, 172.17.0.0/24\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to enable compression in IPsec", "output": "echo 'children {\n  net {\n    compression = yes\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set IPsec rekey time", "output": "echo 'children {\n  net {\n    rekey_time = 2h\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set IPsec lifetime", "output": "echo 'children {\n  net {\n    life_time = 8h\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set DPD (Dead Peer Detection) timeout", "output": "echo 'connections {\n  my-connection {\n    dpd_delay = 30s\n    dpd_timeout = 150s\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to enable MOBIKE in strongSwan", "output": "echo 'connections {\n  my-connection {\n    mobike = yes\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set fragment size in IKE", "output": "echo 'charon {\n  fragment_size = 1400\n}' >> /etc/strongswan.d/charon.conf"},
  {"instruction": "How to configure IPsec over TCP", "output": "echo 'connections {\n  my-connection {\n    remote_addrs = 192.168.2.10\n    transport = tcp\n    version = 2\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set IPsec to use a specific port", "output": "echo 'connections {\n  my-connection {\n    remote {\n      port = 4500\n    }\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to disable IPsec NAT traversal", "output": "echo 'charon {\n  nat_traversal = force\n}' >> /etc/strongswan.d/charon.conf"},
  {"instruction": "How to change charon keep_alive time", "output": "echo 'charon {\n  keep_alive = 20s\n}' >> /etc/strongswan.d/charon.conf"},
  {"instruction": "How to set IPsec cipher proposals", "output": "echo 'children {\n  net {\n    esp_proposals = aes256-sha256-modp2048\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set IKE proposals", "output": "echo 'connections {\n  my-connection {\n    proposals = aes256-sha256-modp2048\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to enable PFS in IPsec", "output": "echo 'children {\n  net {\n    esp_proposals = aes256-sha256-modp2048\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to disable PFS in IPsec", "output": "echo 'children {\n  net {\n    ah_proposals = aes256-sha256-modp2048\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to set lifetime margin for IPsec", "output": "echo 'charon {\n  rekey_margin = 10m\n  rekey_fuzz = 100%\n}' >> /etc/strongswan.d/charon.conf"},
  {"instruction": "How to rename strongSwan interfaces", "output": "echo 'charon {\n  interfaces_use = eth0\n}' >> /etc/strongswan.d/charon.conf"},
  {"instruction": "How to add virtual IP pool for IPsec", "output": "echo 'pools {\n  vpn-pool {\n    addrs = 10.5.0.0/24\n    dns = 8.8.8.8\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to assign DNS to IPsec clients", "output": "echo 'pools {\n  vpn-pool {\n    dns = 8.8.8.8, 1.1.1.1\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to use split-tunneling in IPsec", "output": "echo 'children {\n  net {\n    local_ts = 10.0.0.0/8\n    remote_ts = 0.0.0.0/0\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to route only specific subnets over IPsec", "output": "echo 'children {\n  net {\n    remote_ts = 10.0.0.0/8, 192.168.0.0/16\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to send all traffic over IPsec tunnel", "output": "echo 'children {\n  net {\n    remote_ts = 0.0.0.0/0\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to add an IPv6 pool in strongSwan", "output": "echo 'pools {\n  ipv6-pool {\n    addrs = fd00:dead:beef::/64\n  }\n}' >> /etc/swanctl/swanctl.conf"},
  {"instruction": "How to enable IPv6 over IPsec", "output": "echo 'children {\n  net {\n    local_ts = ::/0\n    remote_ts = ::/0\n    mode = tunnel\n  }\n}' >> /etc/swanctl/swanctl.conf"}
]