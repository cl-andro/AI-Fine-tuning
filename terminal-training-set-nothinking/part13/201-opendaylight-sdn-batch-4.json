[
  {"instruction": "How to enable OpenFlow packet-in logging", "output": "log:set DEBUG org.opendaylight.openflowplugin"},
  {"instruction": "How to install OVSDB Neutron in ODL", "output": "feature:install odl-ovsdb-openstack-neutron"},
  {"instruction": "How to install ODL Service Function Chaining", "output": "feature:install odl-sfc-core"},
  {"instruction": "How to enable ODL AAA", "output": "feature:install odl-aaa-shiro-core"},
  {"instruction": "How to change admin password in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"password\":\"newpassword123\"}' http://localhost:8181/restconf/config/aaa:aaa/users/user/admin"},
  {"instruction": "How to create a new user in ODL", "output": "curl -u admin:admin -X POST -H 'Content-Type: application/json' -d '{\"user\":[{\"name\":\"newuser\",\"password\":\"userpass\",\"roles\":[\"admin\"]}]}' http://localhost:8181/restconf/config/aaa:aaa/users"},
  {"instruction": "How to list ODL users", "output": "curl -u admin:admin http://localhost:8181/restconf/config/aaa:aaa/users"},
  {"instruction": "How to check ODL modules loaded", "output": "curl -u admin:admin http://localhost:8181/restconf/config/yang-ext:mount"},
  {"instruction": "How to create an OpenFlow meter in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"meter-id\":1,\"flags\":\"meter-kbps\",\"bands\":[{\"band-id\":1,\"band-type\":\"drop\",\"rate\":100,\"burst-size\":1000}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/meter/1"},
  {"instruction": "How to get all flows from ODL", "output": "curl -s -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes/node/openflow:1 | jq '.'"},
  {"instruction": "How to add layer 2 flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"l2-flow\",\"match\":{\"ethernet-match\":{\"ethernet-type\":{\"type\":0x0800}}},\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"output-action\":{\"output-node-connector\":\"2\"}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to set up VLAN flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"vlan-flow\",\"priority\":100,\"match\":{\"vlan-match\":{\"vlan-id\":{\"vlan-id\":100}}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add VXLAN tunnel flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"vxlan-flow\",\"priority\":50,\"match\":{\"tunnel\":{\"tunnel-id\":42}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to clear all OpenFlow flows", "output": "curl -u admin:admin -X DELETE http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to get node description from ODL", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes/node/openflow:1/node-connector/openflow:1:1"},
  {"instruction": "How to enable OpenFlow 1.3 in ODL", "output": "feature:install odl-openflowplugin-flow-services-ui"},
  {"instruction": "How to check ODL OpenFlow version", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes | jq '.nodes.node[].\"flow-node-inventory:switch-features\"'"},
  {"instruction": "How to get ODL system memory usage", "output": "system:memory"},
  {"instruction": "How to clean old jar cache in Karaf", "output": "rm -rf ~/.m2/repository/osgi/equinox"},
  {"instruction": "How to install stats monitor in ODL", "output": "feature:install odl-adsal-northbound"},
  {"instruction": "How to enable JMX monitoring in ODL", "output": "export KARAF_JMX_ENABLED=true && bin/karaf"},
  {"instruction": "How to check ODL port listeners", "output": "netstat -tlnp | grep java"},
  {"instruction": "How to increase Karaf command timeout", "output": "export KARAF_COMMAND_TIMEOUT=60000 && bin/karaf"},
  {"instruction": "How to set ODL to log to a file", "output": "log:set DEBUG > /tmp/odl-debug.log"}
]