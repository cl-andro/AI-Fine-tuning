[
  {"instruction": "How to enable query logging in BIND", "output": "rndc querylog on"},
  {"instruction": "How to set up a TSIG key for zone transfer", "output": "tsig-keygen -a hmac-sha256 zone-transfer-key"},
  {"instruction": "How to add TSIG key to named.conf", "output": "echo 'key \"zone-transfer-key\" { algorithm hmac-sha256; secret \"base64key==\"; };' >> /etc/bind/named.conf"},
  {"instruction": "How to allow zone transfer to a specific IP", "output": "echo 'zone \"example.com\" { type master; allow-transfer { 192.168.1.2; }; };' >> /etc/bind/named.conf.local"},
  {"instruction": "How to create a reverse zone file", "output": "echo 'zone \"1.168.192.in-addr.arpa\" { type master; file \"/etc/bind/db.192.168.1\"; };' >> /etc/bind/named.conf.local"},
  {"instruction": "How to add PTR records to reverse zone", "output": "echo '10 IN PTR ns1.example.com.' >> /etc/bind/db.192.168.1"},
  {"instruction": "How to restrict recursive queries to local network", "output": "echo 'options { allow-recursion { 127.0.0.1; 10.0.0.0/8; }; };' >> /etc/bind/named.conf.options"},
  {"instruction": "How to set up response rate limiting", "output": "echo 'options { rate-limit { responses-per-second 5; }; };' >> /etc/bind/named.conf.options"},
  {"instruction": "How to configure a stub zone", "output": "echo 'zone \"example.com\" { type stub; masters { 192.168.1.1; }; file \"stubs/db.example.com\"; };' >> /etc/bind/named.conf.local"},
  {"instruction": "How to set TTL for a zone file", "output": "echo '$TTL 86400' >> /etc/bind/db.example.com"},
  {"instruction": "How to add SRV record to zone file", "output": "echo '_sip._tcp IN SRV 10 60 5060 sip.example.com.' >> /etc/bind/db.example.com"},
  {"instruction": "How to check rndc connection status", "output": "rndc status"},
  {"instruction": "How to dump BIND cache to a file", "output": "rndc dumpdb"},
  {"instruction": "How to freeze a zone for editing", "output": "rndc freeze example.com"},
  {"instruction": "How to thaw a zone after editing", "output": "rndc thaw example.com"},
  {"instruction": "How to notify slaves of zone changes", "output": "rndc notify example.com"},
  {"instruction": "How to re-sign a DNSSEC zone", "output": "dnssec-signzone -A -o example.com -N INCREMENT /etc/bind/db.example.com"},
  {"instruction": "How to check DNSSEC DS record", "output": "dig DS example.com"},
  {"instruction": "How to configure BIND to listen on a specific IP", "output": "echo 'options { listen-on { 192.168.1.1; }; };' >> /etc/bind/named.conf.options"},
  {"instruction": "How to enable IPv6 in BIND", "output": "echo 'options { listen-on-v6 { any; }; };' >> /etc/bind/named.conf.options"},
  {"instruction": "How to set up RFC 1912 compliance logging", "output": "rndc logging"},
  {"instruction": "How to create a delegation in zone file", "output": "echo 'sub IN NS ns1.sub.example.com.' >> /etc/bind/db.example.com"},
  {"instruction": "How to add glue record for subdomain", "output": "echo 'ns1.sub IN A 10.0.1.1' >> /etc/bind/db.example.com"},
  {"instruction": "How to configure rndc controls in named.conf", "output": "echo 'controls { inet 127.0.0.1 port 953 allow { 127.0.0.1; } keys { \"rndc-key\"; }; };' >> /etc/bind/named.conf"},
  {"instruction": "How to update serial number in SOA record", "output": "sed -i 's/2024010101/2024010102/' /etc/bind/db.example.com"}
]