[
  {"instruction": "How to install OF-CONFIG in ODL", "output": "feature:install odl-of-config"},
  {"instruction": "How to set ODL logging pattern", "output": "log:set-pattern \"%d{ISO8601} [%t] %-5p %c %m%n\""},
  {"instruction": "How to enable remote logging in ODL", "output": "log:set syslog udp:localhost:514"},
  {"instruction": "How to list ODL remote transports", "output": "log:list-appenders"},
  {"instruction": "How to add new log appender in ODL", "output": "log:add-appender file /var/log/odl/odl-new.log"},
  {"instruction": "How to configure maven proxy for ODL", "output": "echo 'proxySet=true\nproxyHost=proxy.example.com\nproxyPort=8080' >> ~/.m2/settings.xml"},
  {"instruction": "How to enable OF over TLS in ODL", "output": "feature:install odl-openflowplugin-flow-services-tls"},
  {"instruction": "How to set OpenFlow idle timeout", "output": "export OPENFLOW_IDLE_TIMEOUT=300 && bin/karaf"},
  {"instruction": "How to check ODL southbound connections", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/sal-remote:remote-connections"},
  {"instruction": "How to set global flow table in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"global\",\"table-id\":0}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1"},
  {"instruction": "How to add IPV6 flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"ipv6-flow\",\"priority\":100,\"match\":{\"ethernet-match\":{\"ethernet-type\":{\"type\":0x86dd}}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add MPLS flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"mpls-flow\",\"priority\":100,\"match\":{\"protocol-match-fields\":{\"mpls-label\":100}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add TTL decrement action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"ttl-flow\",\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"dec-nw-ttl\":{}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add set-field action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"setvlan-flow\",\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"set-field\":{\"vlan-match\":{\"vlan-id\":{\"vlan-id\":200}}}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add goto-table action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"goto-flow\",\"instructions\":{\"instruction\":[{\"go-to-table\":{\"table-id\":1}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add push-vlan action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"pushvlan-flow\",\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"push-vlan-action\":{\"ethernet-type\":0x8100}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add pop-vlan action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"popvlan-flow\",\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"pop-vlan-action\":{}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add set-queue action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"queue-flow\",\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"set-queue\":{\"queue-id\":1}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add group action in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"group-flow\",\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"group-action\":{\"group-id\":1}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to view ODL flow table stats", "output": "curl -u admin:admin http://localhost:8181/restconf/operational/opendaylight-inventory:nodes/node/openflow:1/table:0 | jq '.'"},
  {"instruction": "How to add a flow that matches on TCP port in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"tcp80-flow\",\"priority\":100,\"match\":{\"ip-match\":{\"tcp-match\":{\"tcp-destination-port\":80}},\"ethernet-match\":{\"ethernet-type\":{\"type\":0x0800}}}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to add a drop-all flow in ODL", "output": "curl -u admin:admin -X PUT -H 'Content-Type: application/json' -d '{\"flow\":[{\"id\":\"drop-all\",\"priority\":1,\"instructions\":{\"instruction\":[{\"apply-actions\":{\"action\":[{\"drop-action\":{}}]}}]}}]}' http://localhost:8181/restconf/config/opendaylight-inventory:nodes/node/openflow:1/table:0"},
  {"instruction": "How to enable ODL flow metrics to Prometheus", "output": "feature:install odl-metrics-prometheus"},
  {"instruction": "How to get ODL Prometheus metrics", "output": "curl http://localhost:8080/metrics"}
]