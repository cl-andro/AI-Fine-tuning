[
  {"instruction": "How to enable recursor logging", "output": "echo 'loglevel=10' >> /etc/powerdns/recursor.conf"},
  {"instruction": "How to set recursor to use forwarders only", "output": "echo 'forward-zones-file=/etc/powerdns/forward-zones.conf' >> /etc/powerdns/recursor.conf"},
  {"instruction": "How to add authoritative server to recursor", "output": "echo 'allow-from=10.0.0.0/8' >> /etc/powerdns/recursor.conf"},
  {"instruction": "How to set recursor as authoritative for local zone", "output": "echo 'auth-zones=example.local=./example.local.zone' >> /etc/powerdns/recursor.conf"},
  {"instruction": "How to set up rec-control access", "output": "echo 'allow-from=127.0.0.1' >> /etc/powerdns/recursor.conf"},
  {"instruction": "How to check rec-control statistics", "output": "rec_control get-stats"},
  {"instruction": "How to get current queries rec_control list", "output": "rec_control get-query-ring"},
  {"instruction": "How to perform rec_control trace on a domain", "output": "rec_control trace-regex .* 1"},
  {"instruction": "How to set PowerDNS API key", "output": "echo 'api-key=mySecretKey123' >> /etc/powerdns/pdns.conf"},
  {"instruction": "How to enable PowerDNS API", "output": "echo 'api=yes' >> /etc/powerdns/pdns.conf"},
  {"instruction": "How to list zones via PowerDNS API", "output": "curl -H 'X-API-Key: mySecretKey123' http://127.0.0.1:8081/api/v1/servers/localhost/zones"},
  {"instruction": "How to create a zone via PowerDNS API", "output": "curl -X POST -H 'X-API-Key: mySecretKey123' -H 'Content-Type: application/json' -d '{\"name\":\"example.com.\",\"kind\":\"Master\",\"nameservers\":[\"ns1.example.com.\"]}' http://127.0.0.1:8081/api/v1/servers/localhost/zones"},
  {"instruction": "How to delete a zone via PowerDNS API", "output": "curl -X DELETE -H 'X-API-Key: mySecretKey123' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com."},
  {"instruction": "How to add a record via PowerDNS API", "output": "curl -X PATCH -H 'X-API-Key: mySecretKey123' -H 'Content-Type: application/json' -d '{\"rrsets\":[{\"name\":\"www.example.com.\",\"type\":\"A\",\"ttl\":3600,\"changetype\":\"REPLACE\",\"records\":[{\"content\":\"192.168.1.10\",\"disabled\":false}]}]}' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com."},
  {"instruction": "How to get zone details via API", "output": "curl -H 'X-API-Key: mySecretKey123' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com."},
  {"instruction": "How to add a CNAME record via API", "output": "curl -X PATCH -H 'X-API-Key: mySecretKey123' -H 'Content-Type: application/json' -d '{\"rrsets\":[{\"name\":\"mail.example.com.\",\"type\":\"CNAME\",\"ttl\":3600,\"changetype\":\"REPLACE\",\"records\":[{\"content\":\"www.example.com.\",\"disabled\":false}]}]}' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com."},
  {"instruction": "How to add an MX record via API", "output": "curl -X PATCH -H 'X-API-Key: mySecretKey123' -H 'Content-Type: application/json' -d '{\"rrsets\":[{\"name\":\"example.com.\",\"type\":\"MX\",\"ttl\":3600,\"changetype\":\"REPLACE\",\"records\":[{\"content\":\"10 mail.example.com.\",\"disabled\":false}]}]}' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com."},
  {"instruction": "How to enable DNSSEC via API", "output": "curl -X POST -H 'X-API-Key: mySecretKey123' -H 'Content-Type: application/json' -d '{}' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com./dnssec"},
  {"instruction": "How to get DNSSEC keys via API", "output": "curl -H 'X-API-Key: mySecretKey123' http://127.0.0.1:8081/api/v1/servers/localhost/zones/example.com./cryptokeys"},
  {"instruction": "How to search for zones in PowerDNS", "output": "pdnsutil search-zones example"},
  {"instruction": "How to rename a zone in PowerDNS", "output": "pdnsutil rename-zone old-example.com new-example.com"},
  {"instruction": "How to add a TKEY record type in PowerDNS", "output": "pdnsutil add-record example.com @ TYPE65534 \\# 10 0123456789"},
  {"instruction": "How to backup a zone to file in PowerDNS", "output": "pdnsutil export-zone-keys example.com > /tmp/example-keys.txt"},
  {"instruction": "How to set recursion limit in PowerDNS", "output": "echo 'max-recursion-depth=10' >> /etc/powerdns/recursor.conf"}
]