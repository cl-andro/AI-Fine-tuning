[
  {
    "instruction": "Use expect to automate interactive SSH login",
    "output": "apt install -y expect && echo -e '"
  },
  {
    "instruction": "Use expect to automate sudo password",
    "output": "echo -e '"
  },
  {
    "instruction": "Install Ansible for automation",
    "output": "apt install -y ansible"
  },
  {
    "instruction": "Check Ansible version and module list",
    "output": "ansible --version && ansible-doc -l | head -10"
  },
  {
    "instruction": "Create an Ansible inventory file",
    "output": "echo -e '[webservers]\\nweb1 ansible_host=192.168.1.10 ansible_user=root\\nweb2 ansible_host=192.168.1.11 ansible_user=root' > inventory.ini"
  },
  {
    "instruction": "Ping all hosts with Ansible",
    "output": "ansible all -i inventory.ini -m ping"
  },
  {
    "instruction": "Run a shell command on remote with Ansible",
    "output": "ansible all -i inventory.ini -m shell -a 'uptime'"
  },
  {
    "instruction": "Execute Ansible ad-hoc to install a package",
    "output": "ansible all -i inventory.ini -m apt -a 'name=nginx state=present' --become"
  },
  {
    "instruction": "Create a simple Ansible playbook",
    "output": "cat > playbook.yml << 'EOF'\n- hosts: all\n  become: yes\n  tasks:\n  - name: Install nginx\n    apt:\n      name: nginx\n      state: present\n  - name: Start nginx\n    service:\n      name: nginx\n      state: started\n      enabled: yes\nEOF"
  },
  {
    "instruction": "Run an Ansible playbook",
    "output": "ansible-playbook -i inventory.ini playbook.yml"
  },
  {
    "instruction": "Check Ansible playbook syntax",
    "output": "ansible-playbook --syntax-check playbook.yml"
  },
  {
    "instruction": "Dry-run an Ansible playbook",
    "output": "ansible-playbook -i inventory.ini playbook.yml --check"
  },
  {
    "instruction": "Use Ansible vault to encrypt a file",
    "output": "ansible-vault encrypt secrets.yml"
  },
  {
    "instruction": "Decrypt an Ansible vault file",
    "output": "ansible-vault decrypt secrets.yml --ask-vault-pass"
  },
  {
    "instruction": "Edit an Ansible vault file",
    "output": "ansible-vault edit secrets.yml"
  },
  {
    "instruction": "Install Ansible Galaxy collection",
    "output": "ansible-galaxy collection install community.docker"
  },
  {
    "instruction": "Create an Ansible role",
    "output": "ansible-galaxy role init myrole"
  },
  {
    "instruction": "List Ansible roles",
    "output": "ansible-galaxy role list"
  },
  {
