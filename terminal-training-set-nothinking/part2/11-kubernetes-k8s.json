[
  {"instruction": "List all Kubernetes pods in the default namespace", "output": "kubectl get pods"},
  {"instruction": "List pods in all namespaces", "output": "kubectl get pods --all-namespaces"},
  {"instruction": "Show detailed info about a pod", "output": "kubectl describe pod my-pod"},
  {"instruction": "View pod logs", "output": "kubectl logs my-pod"},
  {"instruction": "Follow pod logs in real time", "output": "kubectl logs -f my-pod"},
  {"instruction": "Execute a command inside a pod", "output": "kubectl exec -it my-pod -- bash"},
  {"instruction": "List all deployments", "output": "kubectl get deployments"},
  {"instruction": "Scale a deployment to 5 replicas", "output": "kubectl scale deployment my-app --replicas=5"},
  {"instruction": "Roll out a new deployment update", "output": "kubectl set image deployment/my-app my-app=myapp:v2"},
  {"instruction": "Check rollout status", "output": "kubectl rollout status deployment/my-app"},
  {"instruction": "Rollback a deployment to the previous revision", "output": "kubectl rollout undo deployment/my-app"},
  {"instruction": "List all services", "output": "kubectl get services"},
  {"instruction": "Expose a deployment as a service", "output": "kubectl expose deployment my-app --port=80 --target-port=8080 --type=LoadBalancer"},
  {"instruction": "List all configmaps", "output": "kubectl get configmaps"},
  {"instruction": "Create a configmap from a file", "output": "kubectl create configmap app-config --from-file=config.properties"},
  {"instruction": "List all secrets", "output": "kubectl get secrets"},
  {"instruction": "Create a secret from literal values", "output": "kubectl create secret generic db-secret --from-literal=password=secret123"},
  {"instruction": "Get the current cluster info", "output": "kubectl cluster-info"},
  {"instruction": "List all nodes in the cluster", "output": "kubectl get nodes"},
  {"instruction": "Show node resource usage", "output": "kubectl top nodes"},
  {"instruction": "Show pod resource usage", "output": "kubectl top pods"},
  {"instruction": "Port forward a pod to localhost", "output": "kubectl port-forward pod/my-pod 8080:80"},
  {"instruction": "Apply a YAML manifest", "output": "kubectl apply -f deployment.yaml"},
  {"instruction": "Delete a resource by manifest", "output": "kubectl delete -f deployment.yaml"},
  {"instruction": "Get pods with a label selector", "output": "kubectl get pods -l app=myapp"}
]
