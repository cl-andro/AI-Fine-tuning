[
  {"instruction": "Install etcdctl (etcd CLI)", "output": "apt install -y etcd-client"},
  {"instruction": "Check etcd cluster health", "output": "etcdctl --endpoints=https://127.0.0.1:2379 --cacert=/etc/kubernetes/pki/etcd/ca.crt --cert=/etc/kubernetes/pki/etcd/healthcheck-client.crt --key=/etc/kubernetes/pki/etcd/healthcheck-client.key endpoint health"},
  {"instruction": "List etcd keys", "output": "ETCDCTL_API=3 etcdctl --endpoints=https://127.0.0.1:2379 --cacert=/etc/kubernetes/pki/etcd/ca.crt --cert=/etc/kubernetes/pki/etcd/server.crt --key=/etc/kubernetes/pki/etcd/server.key get / --prefix --keys-only | head -20"},
  {"instruction": "Take an etcd snapshot", "output": "ETCDCTL_API=3 etcdctl snapshot save /backup/etcd-snapshot.db"},
  {"instruction": "Restore etcd from snapshot", "output": "ETCDCTL_API=3 etcdctl snapshot restore /backup/etcd-snapshot.db --data-dir=/var/lib/etcd-backup"},
  {"instruction": "Get Kubernetes control plane pod status", "output": "kubectl get pods -n kube-system -l component=kube-apiserver"},
  {"instruction": "Check kube-apiserver logs", "output": "kubectl logs -n kube-system kube-apiserver-node1 | head -20"},
  {"instruction": "Check kube-controller-manager logs", "output": "kubectl logs -n kube-system kube-controller-manager-node1 | head -20"},
  {"instruction": "Check kube-scheduler logs", "output": "kubectl logs -n kube-system kube-scheduler-node1 | head -20"},
  {"instruction": "Check kube-proxy config", "output": "kubectl get configmap -n kube-system kube-proxy -o yaml | head -40"},
  {"instruction": "Check kubelet version on node", "output": "kubectl get nodes -o wide"},
  {"instruction": "Check container runtime on nodes", "output": "kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name} {.status.nodeInfo.containerRuntimeVersion}\\n{end}'"},
  {"instruction": "Check kubelet logs", "output": "journalctl -u kubelet -n 50 --no-pager"},
  {"instruction": "Restart kubelet service", "output": "systemctl restart kubelet"},
  {"instruction": "Check kubelet config", "output": "kubelet --version && cat /var/lib/kubelet/config.yaml | head -20"},
  {"instruction": "Initialize a Kubernetes control plane with kubeadm", "output": "kubeadm init --pod-network-cidr=10.244.0.0/16 --apiserver-advertise-address=192.168.1.10"},
  {"instruction": "Join a worker node to the cluster", "output": "kubeadm join 192.168.1.10:6443 --token mytoken --discovery-token-ca-cert-hash sha256:xxx"},
  {"instruction": "Generate a new join token", "output": "kubeadm token create --print-join-command"},
  {"instruction": "List kubeadm tokens", "output": "kubeadm token list"},
  {"instruction": "Reset kubeadm (teardown cluster node)", "output": "kubeadm reset -f"},
  {"instruction": "Install a CNI plugin (Flannel)", "output": "kubectl apply -f https://raw.githubusercontent.com/flannel-io/flannel/master/Documentation/kube-flannel.yml"},
  {"instruction": "Install Calico CNI", "output": "kubectl apply -f https://docs.projectcalico.org/manifests/calico.yaml"},
  {"instruction": "Check node conditions", "output": "kubectl describe node node1 | grep -A 5 Conditions"},
  {"instruction": "Check node capacity", "output": "kubectl describe node node1 | grep -E 'Capacity:|Allocatable:'"},
  {"instruction": "Evacuate a node with pod disruption budget", "output": "kubectl drain node1 --ignore-daemonsets --delete-emptydir-data --disable-eviction"}
]
