  {"instruction": "Install and configure fail2ban for SSH", "output": "apt install -y fail2ban && cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local && sed -i 's/^bantime.*/bantime = 3600/' /etc/fail2ban/jail.local && systemctl restart fail2ban"},
