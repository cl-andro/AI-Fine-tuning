[
  {"instruction": "Check NUMA node memory allocation for a process", "output": "numastat -p 1234"},
  {"instruction": "Check memory usage of a process (RSS/HWM)", "output": "ps -o pid,rss,vsz,%mem,cmd -p 1234"},
  {"instruction": "Check top memory consumers", "output": "ps aux --sort=-%mem | awk 'NR>1{print $4 \"% \" $11}' | head -15"},
  {"instruction": "Check virtual memory statistics", "output": "vmstat 1 5 | tail -5"},
  {"instruction": "Check page faults per process", "output": "ps -o min_flt,maj_flt,cmd -p 1234"},
  {"instruction": "Check TLB (Translation Lookaside Buffer) stats", "output": "cat /proc/1234/status | grep -E 'VmPin|VmRSS|VmPTE'"},
  {"instruction": "Check memory fragmentation", "output": "cat /proc/buddyinfo | head -5"},
  {"instruction": "Check slab cache usage", "output": "cat /proc/slabinfo | head -20"},
  {"instruction": "Check zoneinfo for memory allocation details", "output": "cat /proc/zoneinfo | grep -A 5 'Node 0, zone'"},
  {"instruction": "Show memory mapping of a process", "output": "pmap -x 1234 | head -20"},
  {"instruction": "Check the largest memory mappings of a process", "output": "pmap -x 1234 | tail -n +3 | sort -k3 -rh | head -10"},
  {"instruction": "Check memory reclaim behavior", "output": "cat /proc/vmstat | grep -E 'pgsteal|pgscan'"},
  {"instruction": "Check kernel same-page merging (KSM) usage", "output": "cat /sys/kernel/mm/ksm/pages_shared"},
  {"instruction": "Enable KSM for memory deduplication", "output": "echo 1 > /sys/kernel/mm/ksm/run && echo 100 > /sys/kernel/mm/ksm/sleep_millisecs"},
  {"instruction": "Check kernel SLUB allocator debugging", "output": "cat /proc/sys/vm/slab_debug"},
  {"instruction": "Tune dirty page ratios for write-heavy workloads", "output": "sysctl -w vm.dirty_ratio=40 && sysctl -w vm.dirty_background_ratio=10"},
  {"instruction": "Tune dirty page expiration", "output": "sysctl -w vm.dirty_expire_centisecs=3000 && sysctl -w vm.dirty_writeback_centisecs=500"},
  {"instruction": "Set overcommit memory policy", "output": "sysctl -w vm.overcommit_memory=1 && sysctl -w vm.overcommit_ratio=80"},
  {"instruction": "Disable OOM killer for a critical process", "output": "echo -17 > /proc/1234/oom_adj"},
  {"instruction": "Check OOM killer score for a process", "output": "cat /proc/1234/oom_score"},
  {"instruction": "Check network socket memory usage", "output": "cat /proc/net/sockstat"},
  {"instruction": "Check network buffer usage", "output": "sysctl net.ipv4.tcp_mem"},
  {"instruction": "Tune network buffer size for high bandwidth", "output": "sysctl -w net.core.rmem_max=16777216 && sysctl -w net.core.wmem_max=16777216 && sysctl -w net.ipv4.tcp_rmem='4096 87380 16777216' && sysctl -w net.ipv4.tcp_wmem='4096 65536 16777216'"},
  {"instruction": "Enable TCP window scaling", "output": "sysctl -w net.ipv4.tcp_window_scaling=1"},
  {"instruction": "Enable TCP selective ACK", "output": "sysctl -w net.ipv4.tcp_sack=1"}
]
