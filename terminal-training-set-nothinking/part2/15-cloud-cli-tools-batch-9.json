[
  {"instruction": "List all Kubernetes pods in default namespace", "output": "kubectl get pods"},
  {"instruction": "List all Kubernetes services across all namespaces", "output": "kubectl get svc --all-namespaces"},
  {"instruction": "Show detailed pod description", "output": "kubectl describe pod nginx-pod"},
  {"instruction": "View pod logs continuously", "output": "kubectl logs -f deployment/my-app"},
  {"instruction": "Apply a Kubernetes manifest", "output": "kubectl apply -f deployment.yaml"},
  {"instruction": "Delete a Kubernetes deployment", "output": "kubectl delete deployment my-app"},
  {"instruction": "Get nodes in the cluster", "output": "kubectl get nodes -o wide"},
  {"instruction": "Execute a command in a running pod", "output": "kubectl exec -it my-pod -- /bin/bash"},
  {"instruction": "List all namespaces", "output": "kubectl get namespaces"},
  {"instruction": "Port-forward a pod to localhost", "output": "kubectl port-forward svc/my-service 8080:80"},
  {"instruction": "List all Helm releases", "output": "helm list"},
  {"instruction": "Install a Helm chart", "output": "helm install my-release bitnami/nginx"},
  {"instruction": "Upgrade a Helm release", "output": "helm upgrade my-release bitnami/nginx --values custom-values.yaml"},
  {"instruction": "Rollback a Helm release", "output": "helm rollback my-release 2"},
  {"instruction": "Uninstall a Helm release", "output": "helm uninstall my-release"},
  {"instruction": "List DigitalOcean droplets", "output": "doctl compute droplet list"},
  {"instruction": "Create a DigitalOcean droplet", "output": "doctl compute droplet create my-droplet --size s-1vcpu-1gb --image ubuntu-24-04 --region nyc1"},
  {"instruction": "Delete a DigitalOcean droplet", "output": "doctl compute droplet delete my-droplet"},
  {"instruction": "List DigitalOcean Kubernetes clusters", "output": "doctl kubernetes cluster list"},
  {"instruction": "List Linode instances", "output": "linode-cli linodes list"},
  {"instruction": "Create a Linode instance", "output": "linode-cli linodes create --type g6-nanode-1 --region us-east --image linode/debian12"},
  {"instruction": "Reboot a Linode instance", "output": "linode-cli linodes reboot 123456"},
  {"instruction": "List Linode regions", "output": "linode-cli regions list"},
  {"instruction": "Get DigitalOcean account info", "output": "doctl account get"}
]