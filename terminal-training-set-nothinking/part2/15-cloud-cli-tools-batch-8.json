  {"instruction": "Destroy a Pulumi stack", "output": "pulumi destroy --yes"},
  {"instruction": "List all Pulumi stacks", "output": "pulumi stack ls"},
  {"instruction": "Show Pulumi stack outputs", "output": "pulumi stack output"},
  {"instruction": "Test an Ansible ping connection", "output": "ansible all -i inventory.ini -m ping"},
  {"instruction": "Run an Ansible ad-hoc command", "output": "ansible webservers -i inventory.ini -m command -a 'uptime'"},
  {"instruction": "Execute an Ansible playbook", "output": "ansible-playbook -i inventory.ini site.yml"},
  {"instruction": "Run an Ansible playbook with extra vars", "output": "ansible-playbook -i inventory.ini site.yml --extra-vars 'env=staging'"},
  {"instruction": "Check an Ansible playbook syntax", "output": "ansible-playbook --syntax-check playbook.yml"},
