[{"instruction": "Install Zabbix server on Debian 12", "output": "wget https://repo.zabbix.com/zabbix/7.0/debian/pool/main/z/zabbix-release/zabbix-release_latest+debian12_all.deb && dpkg -i zabbix-release_latest+debian12_all.deb && apt update && apt install -y zabbix-server-mysql zabbix-frontend-php zabbix-sql-scripts zabbix-agent"}, {"instruction": "Start Zabbix server", "output": "systemctl enable --now zabbix-server zabbix-agent apache2"}, {"instruction": "Check Zabbix server status", "output": "systemctl status zabbix-server --no-pager -l"}, {"instruction": "Install Icinga2", "output": "apt install -y icinga2 monitoring-plugins && systemctl enable --now icinga2"}, {"instruction": "Check Icinga2 configuration", "output": "icinga2 daemon -C"}, {"instruction": "List Icinga2 hosts from CLI", "output": "icinga2 object list --type Host"}, {"instruction": "Install netdata", "output": "bash <(curl -Ss https://my-netdata.io/kickstart.sh) --stable-channel --disable-telemetry"}, {"instruction": "Access netdata dashboard locally", "output": "curl -s http://localhost:19999/api/v1/info | jq '.version' "}, {"instruction": "Install glances with all plugins", "output": "apt install -y glances && glances --version"}, {"instruction": "Run glances in server mode", "output": "glances -s -B 0.0.0.0 &"}, {"instruction": "Query glances via XML-RPC", "output": "curl -s http://localhost:61209/api/4/cpu | jq ."}, {"instruction": "Install htop", "output": "apt install -y htop && htop --version"}, {"instruction": "Install iotop for disk I/O monitoring", "output": "apt install -y iotop && iotop --version"}, {"instruction": "Run iotop to show top I/O processes", "output": "iotop -oP -d 2 -n 3"}, {"instruction": "Install sysstat (iostat, sar, mpstat)", "output": "apt install -y sysstat && systemctl enable --now sysstat"}, {"instruction": "Show disk statistics with iostat", "output": "iostat -xz 2 3"}, {"instruction": "Show CPU report with sar", "output": "sar -u 1 5"}, {"instruction": "Show memory usage with sar", "output": "sar -r 1 5"}, {"instruction": "Show network statistics with sar", "output": "sar -n DEV 1 5"}, {"instruction": "Show virtual memory stats with vmstat", "output": "vmstat 2 10"}, {"instruction": "Show disk stats with vmstat", "output": "vmstat -d 2 5"}, {"instruction": "Monitor memory in real-time with watch", "output": "watch -n 2 free -h"}, {"instruction": "Monitor disk I/O with watch and iostat", "output": "watch -n 2 'iostat -xz 1 1 | tail -20'"}, {"instruction": "Check system load with uptime", "output": "uptime && cat /proc/loadavg"}, {"instruction": "View kernel ring buffer for hardware errors", "output": "dmesg -T --level=err,warn | tail -30"}]