[
  {"instruction": "Analyze NFS performance with nfsstat", "output": "nfsstat -s"},
  {"instruction": "Check Samba throughput", "output": "smbstatus -p"},
  {"instruction": "Check process I/O wait", "output": "iostat -x 1 3 | grep -A 2 'avg-cpu'"},
  {"instruction": "Find processes with high I/O wait", "output": "iotop -o -n 5"},
  {"instruction": "Find processes with high context switch rate", "output": "pidstat -w 1 5 -p 1234"},
  {"instruction": "Check interrupt rate per CPU", "output": "cat /proc/interrupts | head -5 && mpstat -I CPU 1 2"},
  {"instruction": "Check softirq rates", "output": "cat /proc/softirqs | head -10"},
  {"instruction": "Check network packet drop rate", "output": "netstat -s | grep -E 'drop|overflow|error'"},
  {"instruction": "Check interface packet drops", "output": "ip -s link show eth0 | grep -E 'RX|dropped'"},
  {"instruction": "Check conntrack table usage", "output": "cat /proc/sys/net/netfilter/nf_conntrack_count"},
  {"instruction": "Check conntrack table max", "output": "cat /proc/sys/net/netfilter/nf_conntrack_max"},
  {"instruction": "Increase conntrack table size", "output": "sysctl -w net.netfilter.nf_conntrack_max=524288"},
  {"instruction": "Optimize for small file web serving", "output": "sysctl -w net.ipv4.tcp_tw_reuse=1 && sysctl -w net.ipv4.tcp_fin_timeout=15"},
  {"instruction": "Optimize for high-bandwidth video streaming", "output": "sysctl -w net.core.rmem_default=262144 && sysctl -w net.core.wmem_default=262144 && sysctl -w net.ipv4.tcp_congestion_control=bbr"},
  {"instruction": "Optimize for database server", "output": "sysctl -w vm.swappiness=1 && sysctl -w vm.dirty_ratio=20 && sysctl -w vm.dirty_background_ratio=5 && sysctl -w vm.vfs_cache_pressure=50"},
  {"instruction": "Optimize for virtualization host", "output": "sysctl -w vm.nr_hugepages=1024 && sysctl -w kernel.sched_migration_cost_ns=5000000 && echo 'performance' > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"},
  {"instruction": "Check if PSI (Pressure Stall Info) is enabled", "output": "cat /proc/pressure/cpu 2>/dev/null || echo PSI not enabled"},
  {"instruction": "Enable PSI if not enabled (kernel config)", "output": "echo 'CONFIG_PSI=y' >> /boot/config-$(uname -r) && echo 'psi=1' >> /etc/default/grub && update-grub"},
  {"instruction": "Check CPU pressure", "output": "cat /proc/pressure/cpu"},
  {"instruction": "Check memory pressure", "output": "cat /proc/pressure/memory"},
  {"instruction": "Check I/O pressure", "output": "cat /proc/pressure/io"},
  {"instruction": "Run a sustained CPU test with stress-ng", "output": "stress-ng --cpu $(nproc) --cpu-method matrixprod --timeout 60s"},
  {"instruction": "Run a memory stress test with stress-ng", "output": "stress-ng --vm 2 --vm-bytes 512M --timeout 30s"},
  {"instruction": "Run an I/O stress test with stress-ng", "output": "stress-ng --ioclass 3 --iostat 1 --hdd 1 --hdd-bytes 1G --timeout 30s"},
  {"instruction": "Run a cache thrashing test", "output": "stress-ng --cache 4 --cache-ways 16 --timeout 30s"}
