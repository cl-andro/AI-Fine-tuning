[
  {"instruction": "Connect to MySQL as root", "output": "mysql -u root -p"},
  {"instruction": "Show all MySQL databases", "output": "mysql -u root -p -e 'SHOW DATABASES;'"},
  {"instruction": "Create a MySQL database", "output": "mysql -u root -p -e 'CREATE DATABASE mydb;'"},
  {"instruction": "Import a SQL dump into MySQL", "output": "mysql -u root -p mydb < dump.sql"},
  {"instruction": "Export a MySQL database to a file", "output": "mysqldump -u root -p mydb > backup.sql"},
  {"instruction": "Connect to PostgreSQL", "output": "psql -U postgres"},
  {"instruction": "List PostgreSQL databases", "output": "psql -U postgres -l"},
  {"instruction": "Create a PostgreSQL database", "output": "createdb -U postgres mydb"},
  {"instruction": "Import a SQL dump into PostgreSQL", "output": "psql -U postgres mydb < dump.sql"},
  {"instruction": "Export a PostgreSQL database", "output": "pg_dump -U postgres mydb > backup.sql"},
  {"instruction": "Connect to SQLite database", "output": "sqlite3 mydb.db"},
  {"instruction": "List tables in SQLite", "output": "sqlite3 mydb.db '.tables'"},
  {"instruction": "Run a SQL query in SQLite", "output": "sqlite3 mydb.db 'SELECT * FROM users;'"},
  {"instruction": "Export SQLite database to SQL", "output": "sqlite3 mydb.db '.dump' > dump.sql"},
  {"instruction": "Check Redis server is running", "output": "redis-cli ping"},
  {"instruction": "Set a key in Redis", "output": "redis-cli set mykey 'hello'"},
  {"instruction": "Get a key from Redis", "output": "redis-cli get mykey"},
  {"instruction": "List all keys in Redis", "output": "redis-cli keys '*'"},
  {"instruction": "Connect to MongoDB", "output": "mongosh"},
  {"instruction": "Show MongoDB databases", "output": "mongosh --eval 'show dbs'"},
  {"instruction": "Start MariaDB service and connect", "output": "systemctl start mariadb && mysql -u root"},
  {"instruction": "Start PostgreSQL service", "output": "systemctl start postgresql"},
  {"instruction": "Start Redis server", "output": "systemctl start redis-server"},
  {"instruction": "Check MongoDB server status", "output": "systemctl status mongod"},
  {"instruction": "Run a query in MongoDB via shell", "output": "mongosh mydb --eval 'db.users.find().pretty()'"}
]
