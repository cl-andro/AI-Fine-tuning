[
  {"instruction": "Run Redis benchmark (10k requests, 50 parallel)", "output": "redis-benchmark -n 10000 -c 50"},
  {"instruction": "Check Redis memory usage", "output": "redis-cli info memory | grep -E 'used_memory:|maxmemory:'"},
  {"instruction": "Set Redis password", "output": "echo 'requirepass mypassword' >> /etc/redis/redis.conf && systemctl restart redis-server"},
  {"instruction": "Configure Redis for persistence", "output": "echo -e 'save 60 1000\\nsave 300 100\\nsave 3600 10\\nappendonly yes' >> /etc/redis/redis.conf && systemctl restart redis-server"},
  {"instruction": "Connect to Redis with password", "output": "redis-cli -a mypassword"},
  {"instruction": "Install and use memcached", "output": "apt install -y memcached libmemcached-tools && systemctl start memcached"},
  {"instruction": "Store a value in memcached", "output": "echo -e 'set mykey 0 3600 5\\nhello' | nc localhost 11211"},
  {"instruction": "Retrieve a value from memcached", "output": "echo -e 'get mykey' | nc localhost 11211"},
  {"instruction": "Install Elasticsearch", "output": "wget -qO- https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor -o /usr/share/keyrings/elasticsearch.gpg && echo 'deb [signed-by=/usr/share/keyrings/elasticsearch.gpg] https://artifacts.elastic.co/packages/8.x/apt stable main' > /etc/apt/sources.list.d/elastic-8.x.list && apt update && apt install -y elasticsearch"},
  {"instruction": "Configure Elasticsearch for single-node", "output": "echo -e 'discovery.type: single-node\\nxpack.security.enabled: false' >> /etc/elasticsearch/elasticsearch.yml && systemctl restart elasticsearch"},
  {"instruction": "Index a document in Elasticsearch", "output": "curl -X POST http://localhost:9200/mydb/_doc -H 'Content-Type: application/json' -d '{\"name\":\"John\",\"email\":\"john@example.com\"}'"},
  {"instruction": "Search Elasticsearch", "output": "curl -s http://localhost:9200/mydb/_search -H 'Content-Type: application/json' -d '{\"query\":{\"match\":{\"name\":\"John\"}}}' | jq '.'"},
  {"instruction": "Install and configure RabbitMQ", "output": "apt install -y rabbitmq-server && systemctl start rabbitmq-server"},
  {"instruction": "Check RabbitMQ status", "output": "rabbitmqctl status | head -30"},
  {"instruction": "Create a RabbitMQ user", "output": "rabbitmqctl add_user john password && rabbitmqctl set_permissions -p / john '.*' '.*' '.*'"},
  {"instruction": "List RabbitMQ queues", "output": "rabbitmqctl list_queues"},
  {"instruction": "Install and configure Kafka", "output": "apt install -y kafka && systemctl start kafka"},
  {"instruction": "Create a Kafka topic", "output": "kafka-topics --create --topic mytopic --bootstrap-server localhost:9092 --partitions 3 --replication-factor 1"},
  {"instruction": "List Kafka topics", "output": "kafka-topics --list --bootstrap-server localhost:9092"},
  {"instruction": "Produce a message to Kafka", "output": "echo '{\"key\":\"value\"}' | kafka-console-producer --topic mytopic --bootstrap-server localhost:9092"},
  {"instruction": "Consume messages from Kafka", "output": "kafka-console-consumer --topic mytopic --bootstrap-server localhost:9092 --from-beginning --max-messages 5"},
  {"instruction": "Check Kafka consumer group offsets", "output": "kafka-consumer-groups --bootstrap-server localhost:9092 --all-groups --describe"},
  {"instruction": "Install and use etcd", "output": "apt install -y etcd && systemctl start etcd"},
  {"instruction": "Put a key in etcd", "output": "etcdctl put /config/key 'value'"},
  {"instruction": "Get a key from etcd", "output": "etcdctl get /config/key"}
]
