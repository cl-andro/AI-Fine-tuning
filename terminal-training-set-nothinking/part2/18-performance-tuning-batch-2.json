[
  {"instruction": "Benchmark CPU with 7-zip (high memory CPU test)", "output": "7z b -mmt$(nproc)"},
  {"instruction": "Benchmark RAM speed with mbw", "output": "apt install -y mbw && mbw 1024"},
  {"instruction": "Test memory latency with lmbench", "output": "apt install -y lmbench && lat_mem_rd 128 512"},
  {"instruction": "Test memory bandwidth with stream", "output": "apt install -y stream && stream"},
  {"instruction": "Run openssl speed benchmark", "output": "openssl speed -multi $(nproc) sha256 aes-256-cbc"},
  {"instruction": "Benchmark disk random access with ioping", "output": "apt install -y ioping && ioping -c 10 /tmp"},
  {"instruction": "Measure mountpoint latency with ioping", "output": "ioping -c 100 -S 1M /var/lib/mysql"},
  {"instruction": "Check disk rotational delay", "output": "hdparm -I /dev/sda | grep -i 'rotational'"},
  {"instruction": "Check if disk is SSD or HDD", "output": "cat /sys/block/sda/queue/rotational"},
  {"instruction": "Enable TRIM for SSD", "output": "systemctl enable --now fstrim.timer && fstrim -av"},
  {"instruction": "Check kernel I/O scheduler", "output": "cat /sys/block/sda/queue/scheduler"},
  {"instruction": "Set I/O scheduler to none (NVMe optimal)", "output": "echo none > /sys/block/nvme0n1/queue/scheduler"},
  {"instruction": "Set I/O scheduler to deadline for HDDs", "output": "echo deadline > /sys/block/sda/queue/scheduler"},
  {"instruction": "Set I/O scheduler persistently (GRUB)", "output": "sed -i 's/GRUB_CMDLINE_LINUX=\"\"/GRUB_CMDLINE_LINUX=\"elevator=none\"/' /etc/default/grub && update-grub"},
  {"instruction": "Check block device queue depth", "output": "cat /sys/block/sda/device/queue_depth"},
  {"instruction": "Set block device queue depth", "output": "echo 256 > /sys/block/nvme0n1/device/queue_depth"},
  {"instruction": "Check CPU scaling governor per core", "output": "cat /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"},
  {"instruction": "Set CPU governor to powersave", "output": "for i in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo powersave > $i; done"},
  {"instruction": "Disable C-states for lower latency", "output": "echo 1 > /sys/module/intel_idle/parameters/max_cstate"},
  {"instruction": "Disable turbo boost", "output": "echo 1 > /sys/devices/system/cpu/intel_pstate/no_turbo"},
  {"instruction": "Check current CPU frequency", "output": "cat /proc/cpuinfo | grep -E 'processor|MHz'"},
  {"instruction": "Check CPU topology (cores, threads, sockets)", "output": "lscpu | grep -E 'Thread|Core|Socket|NUMA'"},
  {"instruction": "Pin a process to a specific CPU core", "output": "taskset -c 0-3 ./myapp"},
  {"instruction": "Check which CPUs a process is allowed to run on", "output": "taskset -p 1234"},
  {"instruction": "Move a running process to a specific CPU", "output": "taskset -pc 0-3 1234"}
]
