[
  {"instruction": "List namespaces", "output": "kubectl get namespaces"},
  {"instruction": "Create a namespace", "output": "kubectl create namespace mynamespace"},
  {"instruction": "Delete a namespace and all resources in it", "output": "kubectl delete namespace mynamespace"},
  {"instruction": "Get all resources in a namespace", "output": "kubectl get all -n mynamespace"},
  {"instruction": "List all PersistentVolumeClaims", "output": "kubectl get pvc"},
  {"instruction": "Create a pod YAML manifest from dry-run", "output": "kubectl run mypod --image=nginx --dry-run=client -o yaml > pod.yaml"},
  {"instruction": "Create a deployment YAML from dry-run", "output": "kubectl create deployment myapp --image=myapp --dry-run=client -o yaml > deploy.yaml"},
  {"instruction": "Export a service YAML", "output": "kubectl get svc my-service -o yaml > service.yaml"},
  {"instruction": "Watch pod events", "output": "kubectl get events --watch"},
  {"instruction": "Show pod labels", "output": "kubectl get pods --show-labels"},
  {"instruction": "Add a label to a pod", "output": "kubectl label pod mypod env=production"},
  {"instruction": "Remove a label from a pod", "output": "kubectl label pod mypod env-"},
  {"instruction": "Add an annotation to a pod", "output": "kubectl annotate pod mypod description='my service pod'"},
  {"instruction": "Cordon a node (mark unschedulable)", "output": "kubectl cordon node1"},
  {"instruction": "Uncordon a node", "output": "kubectl uncordon node1"},
  {"instruction": "Drain a node for maintenance", "output": "kubectl drain node1 --ignore-daemonsets --delete-emptydir-data"},
  {"instruction": "Taint a node", "output": "kubectl taint nodes node1 key=value:NoSchedule"},
  {"instruction": "Remove taint from a node", "output": "kubectl taint nodes node1 key=value:NoSchedule-"},
  {"instruction": "Get the kubeconfig current context", "output": "kubectl config current-context"},
  {"instruction": "List all kubeconfig contexts", "output": "kubectl config get-contexts"},
  {"instruction": "Switch to a different context", "output": "kubectl config use-context my-cluster"},
  {"instruction": "Set namespace for the current context", "output": "kubectl config set-context --current --namespace=mynamespace"},
  {"instruction": "View API resources available", "output": "kubectl api-resources"},
  {"instruction": "Explain a resource field", "output": "kubectl explain pod.spec.containers"},
  {"instruction": "Check API versions available", "output": "kubectl api-versions"}
]
