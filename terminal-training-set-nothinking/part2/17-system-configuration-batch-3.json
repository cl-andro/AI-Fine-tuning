[
  {"instruction": "Create a new ext4 filesystem", "output": "mkfs.ext4 /dev/sdb1"},
  {"instruction": "Create a filesystem with a label", "output": "mkfs.ext4 -L mydata /dev/sdb1"},
  {"instruction": "Mount a filesystem by UUID", "output": "mount UUID=abc123-... /mnt/data"},
  {"instruction": "Find UUID of a device", "output": "blkid /dev/sdb1"},
  {"instruction": "Edit /etc/fstab to auto-mount a partition", "output": "echo 'UUID=abc123-... /mnt/data ext4 defaults 0 2' >> /etc/fstab"},
  {"instruction": "Check a filesystem for errors (ext4)", "output": "fsck.ext4 -f /dev/sdb1"},
  {"instruction": "Force a filesystem check on next boot", "output": "tune2fs -C 999 /dev/sda1"},
  {"instruction": "Resize an ext4 filesystem", "output": "resize2fs /dev/myvg/mylv"},
  {"instruction": "Configure a disk partition with fdisk", "output": "echo -e 'g\\nn\\n\\n\\n+10G\\nw' | fdisk /dev/sdb"},
  {"instruction": "Create a GPT partition table on disk", "output": "parted /dev/sdb mklabel gpt"},
  {"instruction": "Create a partition with parted", "output": "parted /dev/sdb mkpart primary ext4 1MiB 10GiB"},
  {"instruction": "Print the partition table", "output": "parted /dev/sdb print"},
  {"instruction": "Resize a partition with parted", "output": "parted /dev/sdb resizepart 1 20GiB"},
  {"instruction": "Create a swap partition", "output": "mkswap /dev/sdb2 && swapon /dev/sdb2"},
  {"instruction": "Add swap to /etc/fstab", "output": "echo '/dev/sdb2 none swap sw 0 0' >> /etc/fstab"},
  {"instruction": "Configure tmpfs in /etc/fstab", "output": "echo 'tmpfs /var/ramdisk tmpfs defaults,size=1G 0 0' >> /etc/fstab"},
  {"instruction": "Configure a bind mount in /etc/fstab", "output": "echo '/original/path /bound/path none bind 0 0' >> /etc/fstab"},
  {"instruction": "Mount all filesystems from /etc/fstab", "output": "mount -a"},
  {"instruction": "Check which filesystems are mounted read-only", "output": "mount | grep ro | head -5"},
  {"instruction": "Remount a filesystem as read-write", "output": "mount -o remount,rw /"},
  {"instruction": "Configure automount with autofs", "output": "apt install -y autofs && echo '/net /etc/auto.net --timeout=60' >> /etc/auto.master && echo 'server -fstype=nfs4 192.168.1.10:/srv/nfs' > /etc/auto.net && systemctl restart autofs"},
  {"instruction": "Configure NTP client (chrony)", "output": "apt install -y chrony && systemctl enable --now chrony"},
  {"instruction": "Check NTP sync status with chronyc", "output": "chronyc tracking"},
  {"instruction": "List NTP sources with chronyc", "output": "chronyc sources -v"},
  {"instruction": "Configure a local NTP server in chrony", "output": "echo -e 'server 0.debian.pool.ntp.org iburst\\nserver 1.debian.pool.ntp.org iburst\\nallow 192.168.1.0/24' >> /etc/chrony/chrony.conf && systemctl restart chrony"}
]
