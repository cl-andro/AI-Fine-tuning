[
  {"instruction": "Check if GPG keys are available for apt sources", "output": "ls /usr/share/keyrings/"},
  {"instruction": "Encrypt a file with GPG", "output": "gpg -c file.txt"},
  {"instruction": "Decrypt a GPG encrypted file", "output": "gpg -d file.txt.gpg"},
  {"instruction": "Encrypt a file for a specific recipient", "output": "gpg -e -r recipient@example.com document.pdf"},
  {"instruction": "Sign a file with GPG", "output": "gpg --sign file.txt"},
  {"instruction": "Verify a GPG signature", "output": "gpg --verify file.txt.gpg"},
  {"instruction": "Export a GPG public key", "output": "gpg --export -a john@example.com > public.key"},
  {"instruction": "Import a GPG public key", "output": "gpg --import public.key"},
  {"instruction": "List GPG keys", "output": "gpg --list-keys"},
  {"instruction": "Delete a GPG key", "output": "gpg --delete-key john@example.com"},
  {"instruction": "Scan a system for rootkits with rkhunter", "output": "apt install -y rkhunter && rkhunter --check"},
  {"instruction": "Scan with chkrootkit", "output": "apt install -y chkrootkit && chkrootkit"},
  {"instruction": "Run lynis security audit", "output": "apt install -y lynis && lynis audit system"},
  {"instruction": "Scan for malware with ClamAV", "output": "apt install -y clamav && freshclam && clamscan -r /home/"},
  {"instruction": "Start and enable the ClamAV daemon", "output": "systemctl enable --now clamav-daemon"},
  {"instruction": "Install Tripwire (file integrity checker)", "output": "apt install -y tripwire && tripwire --init"},
  {"instruction": "Check Tripwire integrity database", "output": "tripwire --check | head -40"},
  {"instruction": "Install AIDE (file integrity checker)", "output": "apt install -y aide && aideinit && mv /var/lib/aide/aide.db.new /var/lib/aide/aide.db"},
  {"instruction": "Check AIDE integrity", "output": "aide --check | head -40"},
  {"instruction": "Check listening TCP ports for unexpected services", "output": "ss -tlnp | awk '{print $4}' | grep -v 127.0.0.1 | sort -u"},
  {"instruction": "Check if any process is listening on all interfaces", "output": "ss -tlnp | grep '0.0.0.0:'"},
  {"instruction": "Check the difference between open files and listening ports", "output": "diff <(lsof -iTCP -sTCP:LISTEN -P -n | awk '{print $9}') <(ss -tlnp | awk '{print $4}')"},
  {"instruction": "Find deleted files still held open by processes", "output": "lsof | grep '(deleted)' | head -10"},
  {"instruction": "Check if the system has any core dumps", "output": "ls /var/crash/ 2>/dev/null || echo no core dumps"},
  {"instruction": "Limit core dump size", "output": "echo '* hard core 0' >> /etc/security/limits.conf && echo 'fs.suid_dumpable=0' >> /etc/sysctl.conf && sysctl -p"}
]
