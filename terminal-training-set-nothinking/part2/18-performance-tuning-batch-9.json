[
  {"instruction": "Run ethtool to check NIC driver and firmware info", "output": "ethtool -i eth0"},
  {"instruction": "Query NIC ring buffer sizes", "output": "ethtool -g eth0"},
  {"instruction": "Increase NIC ring buffer size", "output": "ethtool -G eth0 rx 4096 tx 4096"},
  {"instruction": "Check NIC coalescing settings", "output": "ethtool -c eth0"},
  {"instruction": "Enable adaptive RX/TX coalescing", "output": "ethtool -C eth0 adaptive-rx on adaptive-tx on"},
  {"instruction": "Show NIC offload capabilities", "output": "ethtool -k eth0 | head -20"},
  {"instruction": "Enable TCP segmentation offload", "output": "ethtool -K eth0 tso on"},
  {"instruction": "Add a tc qdisc with fq_codel for low-latency networking", "output": "tc qdisc replace dev eth0 root fq_codel"},
  {"instruction": "Show active tc qdiscs", "output": "tc -s qdisc show dev eth0"},
  {"instruction": "Show socket statistics with ss", "output": "ss -tuln"},
  {"instruction": "Show active TCP connections with extended info", "output": "ss -tiep"},
  {"instruction": "Show socket buffer usage per process", "output": "ss -mep"},
  {"instruction": "Run netperf TCP throughput test", "output": "netperf -H 192.168.1.100 -t TCP_STREAM -l 30"},
  {"instruction": "Run netperf TCP request/response latency test", "output": "netperf -H 192.168.1.100 -t TCP_RR -l 30"},
  {"instruction": "Run iperf3 TCP upload test", "output": "iperf3 -c 192.168.1.100 -t 30 -P 4"},
  {"instruction": "Run iperf3 UDP bandwidth test", "output": "iperf3 -c 192.168.1.100 -u -b 1000M -t 30"},
  {"instruction": "Run iperf3 bidirectional test", "output": "iperf3 -c 192.168.1.100 --bidir -t 30"},
  {"instruction": "Use bpftrace to trace open syscalls", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_open { printf(\"%d %s\\n\", pid, str(args->filename)); }'"},
  {"instruction": "Use bpftrace to count syscalls per process", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_* { @[comm] = count(); }' interval:s:5 { exit(); }"},
  {"instruction": "Use bpftrace to trace block I/O latency", "output": "bpftrace -e 'kprobe:blk_account_io_done { @[comm] = hist(nsecs / 1000); }'"},
  {"instruction": "Use bpftrace to trace TCP connect attempts", "output": "bpftrace -e 'kretprobe:tcp_v4_connect { @[comm] = count(); }'"},
  {"instruction": "Use ftrace to trace all syscalls", "output": "echo 1 > /sys/kernel/tracing/events/syscalls/enable && cat /sys/kernel/tracing/trace_pipe | head -100"},
  {"instruction": "Use trace-cmd to trace all syscalls for a specific command", "output": "trace-cmd record -e syscalls ls -la && trace-cmd report | head -20"},
  {"instruction": "Run stress-ng fork bomb stressor", "output": "stress-ng --fork 4 --timeout 30s --metrics"},
  {"instruction": "Run stress-ng context switch stressor", "output": "stress-ng --switch 4 --timeout 30s --metrics"},
  {"instruction": "Run stress-ng pipe stressor", "output": "stress-ng --pipe 4 --timeout 30s --metrics"}]