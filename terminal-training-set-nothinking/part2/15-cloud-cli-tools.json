  {"instruction": "SSH into a GCP instance", "output": "gcloud compute ssh my-instance --zone us-central1-a"},
  {"instruction": "List GCP storage buckets", "output": "gsutil ls"},
  {"instruction": "Copy a file to GCP storage", "output": "gsutil cp file.txt gs://mybucket/file.txt"},
