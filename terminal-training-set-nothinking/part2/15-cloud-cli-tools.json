  {"instruction": "Start an EC2 instance", "output": "aws ec2 start-instances --instance-ids i-1234567890abcdef0"},
  {"instruction": "Stop an EC2 instance", "output": "aws ec2 stop-instances --instance-ids i-1234567890abcdef0"},
  {"instruction": "List AWS Lambda functions", "output": "aws lambda list-functions --query 'Functions[].FunctionName'"},
  {"instruction": "Invoke an AWS Lambda function", "output": "aws lambda invoke --function-name my-function response.json"},
