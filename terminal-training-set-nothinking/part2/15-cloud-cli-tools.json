[
  {"instruction": "List all AWS S3 buckets", "output": "aws s3 ls"},
  {"instruction": "Upload a file to S3", "output": "aws s3 cp file.txt s3://mybucket/file.txt"},
  {"instruction": "Download a file from S3", "output": "aws s3 cp s3://mybucket/file.txt file.txt"},
  {"instruction": "Sync a local directory to S3", "output": "aws s3 sync ./mydir s3://mybucket/mydir"},
