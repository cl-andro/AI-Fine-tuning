  {"instruction": "Stop an Azure VM", "output": "az vm stop --resource-group myRG --name myVM"},
  {"instruction": "List Azure storage containers", "output": "az storage container list --output table"},
  {"instruction": "Upload a blob to Azure storage", "output": "az storage blob upload --container-name mycontainer --file file.txt --name file.txt"},
