[
  {"instruction": "Install ossec HIDS agent and connect to manager", "output": "apt install -y ossec-hids-agent && /var/ossec/bin/agent-auth -m 192.168.1.50 -p 1515 && /var/ossec/bin/ossec-control start"},
  {"instruction": "Check ossec agent status", "output": "/var/ossec/bin/ossec-control status"},
  {"instruction": "Install Snort IDS", "output": "apt install -y snort && snort -T -c /etc/snort/snort.conf"},
  {"instruction": "Run Snort in IDS mode on an interface", "output": "snort -A console -q -c /etc/snort/snort.conf -i eth0"},
  {"instruction": "Capture traffic with tcpdump on port 80", "output": "tcpdump -i eth0 -n tcp port 80 -c 100 -w http.pcap"},
  {"instruction": "Read a pcap file with tcpdump", "output": "tcpdump -r http.pcap -X | head -50"},
  {"instruction": "Analyze pcap with tshark for HTTP requests", "output": "tshark -r http.pcap -Y 'http.request' -T fields -e http.host -e http.request.uri"},
  {"instruction": "Check file integrity with AIDE after init", "output": "aide --check | grep 'changed' | head -20"},
  {"instruction": "Update AIDE database after changes", "output": "aideinit --update && mv /var/lib/aide/aide.db.new /var/lib/aide/aide.db"},
  {"instruction": "Check all debsums for changed config files", "output": "debsums -c --config"},
  {"instruction": "Verify package integrity with rpm -V (if RPM-based)", "output": "rpm -Va | grep '^..5' | head -20"},
  {"instruction": "Check user accounts for empty passwords", "output": "awk -F: '($2 == \"\") {print}' /etc/shadow"},
  {"instruction": "Check for duplicate UIDs in passwd", "output": "awk -F: '{print $3}' /etc/passwd | sort | uniq -d | xargs -I{} grep '^[^:]*:[^:]*:{}:' /etc/passwd"},
  {"instruction": "Verify passwd and shadow file integrity", "output": "pwck -q && grpck -q"},
  {"instruction": "Lock all non-root system accounts", "output": "awk -F: '($3 < 1000 && $1 != \"root\") {system(\"passwd -l \" $1)}' /etc/passwd"},
  {"instruction": "Check account lockout status with pam_tally2", "output": "pam_tally2 --user john"},
  {"instruction": "Reset failed login count for a user", "output": "pam_tally2 --user john --reset"},
  {"instruction": "Set password expiration policy globally", "output": "sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS 90/' /etc/login.defs && sed -i 's/^PASS_MIN_DAYS.*/PASS_MIN_DAYS 7/' /etc/login.defs && sed -i 's/^PASS_WARN_AGE.*/PASS_WARN_AGE 14/' /etc/login.defs"},
  {"instruction": "Set file immutable attribute with chattr", "output": "chattr +i /etc/passwd && lsattr /etc/passwd"},
  {"instruction": "Remove immutable attribute from a file", "output": "chattr -i /etc/passwd"},
  {"instruction": "Find all SUID root binaries", "output": "find / -type f -perm -4000 -user root -exec ls -la {} \\; 2>/dev/null"},
  {"instruction": "Find all SGID binaries", "output": "find / -type f -perm -2000 -exec ls -la {} \\; 2>/dev/null"},
  {"instruction": "Find world-writable files owned by root", "output": "find / -type f -user root -perm -o+w -exec ls -la {} \\; 2>/dev/null"},
  {"instruction": "Generate a Diffie-Hellman parameters file", "output": "openssl dhparam -out dhparam.pem 2048"},
  {"instruction": "Check TLS 1.3 support with OpenSSL s_client", "output": "openssl s_client -connect example.com:443 -tls1_3 < /dev/null 2>/dev/null | head -10"}
]