[
  {"instruction": "List all AWS S3 buckets", "output": "aws s3 ls"},
  {"instruction": "List all EC2 instances in us-east-1", "output": "aws ec2 describe-instances --region us-east-1 --output table"},
  {"instruction": "Copy a file to an S3 bucket", "output": "aws s3 cp ./backup.tar.gz s3://my-backup-bucket/"},
  {"instruction": "Create a new S3 bucket", "output": "aws s3 mb s3://my-unique-bucket-name-2026"},
  {"instruction": "Sync a local directory to S3", "output": "aws s3 sync ./build/ s3://my-website-bucket/ --delete"},
  {"instruction": "List all EC2 security groups", "output": "aws ec2 describe-security-groups --query 'SecurityGroups[*].GroupName' --output text"},
  {"instruction": "Start an EC2 instance", "output": "aws ec2 start-instances --instance-ids i-0abc123def456"},
  {"instruction": "Stop an EC2 instance", "output": "aws ec2 stop-instances --instance-ids i-0abc123def456"},
  {"instruction": "List IAM users", "output": "aws iam list-users --output table"},
  {"instruction": "List S3 bucket contents recursively", "output": "aws s3 ls s3://my-bucket/ --recursive"},
  {"instruction": "List all Google Compute Engine instances", "output": "gcloud compute instances list"},
  {"instruction": "Describe a specific GCE instance", "output": "gcloud compute instances describe web-server-1 --zone us-central1-a"},
  {"instruction": "Create a GCE VM instance", "output": "gcloud compute instances create my-instance --zone us-east1-b --machine-type e2-medium --image-family debian-12 --image-project debian-cloud"},
  {"instruction": "SSH into a GCE instance", "output": "gcloud compute ssh my-instance --zone us-east1-b"},
  {"instruction": "List all Google Cloud Storage buckets", "output": "gcloud storage buckets list"},
  {"instruction": "List Azure virtual machines", "output": "az vm list --output table"},
  {"instruction": "Create an Azure VM", "output": "az vm create --resource-group myRG --name myVM --image Ubuntu2204 --admin-username azureuser --generate-ssh-keys"},
  {"instruction": "Show Azure VM details", "output": "az vm show --resource-group myRG --name myVM --query '{name:name,status:provisioningState}'"},
  {"instruction": "List Azure resource groups", "output": "az group list --output table"},
  {"instruction": "Deallocate an Azure VM", "output": "az vm deallocate --resource-group myRG --name myVM"},
  {"instruction": "List all Azure storage accounts", "output": "az storage account list --output table"},
  {"instruction": "Initialize a Terraform working directory", "output": "terraform init"},
  {"instruction": "Format Terraform configuration files", "output": "terraform fmt -recursive"},
  {"instruction": "Validate Terraform configuration", "output": "terraform validate"},
  {"instruction": "Plan Terraform infrastructure changes", "output": "terraform plan -out=tfplan"}
