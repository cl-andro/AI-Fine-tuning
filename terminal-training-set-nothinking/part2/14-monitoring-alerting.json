[
  {"instruction": "Install prometheus and node_exporter", "output": "apt install -y prometheus prometheus-node-exporter"},
  {"instruction": "Check Prometheus targets status", "output": "curl -s http://localhost:9090/api/v1/targets | jq '.data.activeTargets[] | {job: .labels.job, health: .health}'"},
  {"instruction": "Query a metric from Prometheus", "output": "curl -s 'http://localhost:9090/api/v1/query?query=node_cpu_seconds_total' | jq '.data.result[0].value'"},
  {"instruction": "Install Grafana", "output": "apt install -y grafana && systemctl enable --now grafana-server"},
  {"instruction": "Install Telegraf (metrics agent)", "output": "apt install -y telegraf"},
  {"instruction": "Check Telegraf service status", "output": "systemctl status telegraf"},
  {"instruction": "Install InfluxDB (time series DB)", "output": "apt install -y influxdb && systemctl start influxdb"},
  {"instruction": "Create a database in InfluxDB", "output": "curl -X POST http://localhost:8086/query --data-urlencode 'q=CREATE DATABASE mydb'"},
  {"instruction": "Install the ELK stack (Elasticsearch)", "output": "apt install -y elasticsearch"},
  {"instruction": "Start Elasticsearch service", "output": "systemctl start elasticsearch"},
  {"instruction": "Check Elasticsearch cluster health", "output": "curl -s http://localhost:9200/_cluster/health | jq '.'"},
  {"instruction": "Install Kibana (Elasticsearch UI)", "output": "apt install -y kibana && systemctl start kibana"},
  {"instruction": "Install Logstash (log processor)", "output": "apt install -y logstash"},
  {"instruction": "Send a test log to Logstash", "output": "echo '{\"message\":\"test log\"}' | nc localhost 5000"},
  {"instruction": "Install Netdata (real-time monitoring)", "output": "bash <(curl -Ss https://my-netdata.io/kickstart.sh) --non-interactive"},
  {"instruction": "Check Netdata health alerts", "output": "curl -s http://localhost:19999/api/v1/alarms | jq '.alarms | length'"},
  {"instruction": "Install nagios-plugins for monitoring", "output": "apt install -y nagios-plugins"},
  {"instruction": "Run a Nagios ping check", "output": "/usr/lib/nagios/plugins/check_ping -H 8.8.8.8 -w 100,20% -c 200,50%"},
  {"instruction": "Set up a simple cron job to check disk every hour", "output": "echo '0 * * * * /usr/lib/nagios/plugins/check_disk -w 20% -c 10% -e' | crontab -"},
  {"instruction": "Install SNMP daemon", "output": "apt install -y snmpd && systemctl start snmpd"},
  {"instruction": "Query a remote SNMP agent", "output": "snmpwalk -v2c -c public 192.168.1.100 system"},
  {"instruction": "Install the uptime command monitor", "output": "uptime && watch -n 60 uptime"},
  {"instruction": "Check system resource limits with a single command", "output": "ulimit -a"},
  {"instruction": "Generate a system report with sosreport", "output": "apt install -y sosreport && sosreport --batch"},
  {"instruction": "Run a network connectivity check script", "output": "for host in google.com github.com; do ping -c1 $host >/dev/null 2>&1 && echo \"$host: OK\" || echo \"$host: FAIL\"; done"}
]
