    "instruction": "Add healthcheck to a compose service",
    "output": "echo 'services: web: healthcheck: test: [\"CMD\", \"curl\", \"-f\", \"http://localhost\"] interval: 30s timeout: 10s retries: 3' >> docker-compose.yml"
  },
  {
