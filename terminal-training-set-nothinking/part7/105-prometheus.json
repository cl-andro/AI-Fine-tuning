[
  {
    "instruction": "Check Prometheus version",
    "output": "prometheus --version"
  },
  {
    "instruction": "Check promtool version",
    "output": "promtool --version"
  },
  {
    "instruction": "Start Prometheus with a config file",
    "output": "prometheus --config.file prometheus.yml"
  },
  {
    "instruction": "Start Prometheus with custom storage path",
    "output": "prometheus --config.file prometheus.yml --storage.tsdb.path /data/prometheus"
  },
  {
    "instruction": "Start Prometheus with retention time",
    "output": "prometheus --config.file prometheus.yml --storage.tsdb.retention.time 30d"
  },
  {
    "instruction": "Start Prometheus with web listen address",
    "output": "prometheus --config.file prometheus.yml --web.listen-address 0.0.0.0:9090"
  },
  {
    "instruction": "Start Prometheus with external labels",
    "output": "prometheus --config.file prometheus.yml --storage.tsdb.retention.size 50GB"
  },
  {
    "instruction": "Check Prometheus config validity",
    "output": "promtool check config prometheus.yml"
  },
  {
    "instruction": "Check Prometheus rules files",
    "output": "promtool check rules rules.yml"
  },
  {
    "instruction": "Test alert rules against unit tests",
    "output": "promtool test rules test.yml"
  },
  {
    "instruction": "Query Prometheus instant vector",
    "output": "promtool query instant http://localhost:9090 'up'"
  },
  {
    "instruction": "Query Prometheus range vector",
    "output": "promtool query range http://localhost:9090 'rate(http_requests_total[5m])' --start 2026-07-25T00:00:00Z --end 2026-07-26T00:00:00Z --step 60s"
  },
  {
    "instruction": "Query Prometheus with debug flag",
    "output": "promtool query instant http://localhost:9090 --debug 'up'"
  },
  {
    "instruction": "Label values query via promtool",
    "output": "promtool query series http://localhost:9090 '{job=\"node\"}'"
  },
  {
    "instruction": "Check series in Prometheus",
    "output": "promtool query series http://localhost:9090 'up'"
  },
  {
    "instruction": "Test PromQL expression with unit tests",
    "output": "promtool test rules promql-test.yml"
  },
  {
    "instruction": "Use amtool check alertmanager config",
    "output": "amtool check-config alertmanager.yml"
  },
  {
    "instruction": "Use amtool to silence an alert",
    "output": "amtool silence add --alertmanager.url http://localhost:9093 --duration 1h --comment \"Maintenance\" alertname=HighCPU"
  },
  {
    "instruction": "List active silences in Alertmanager",
    "output": "amtool silence list --alertmanager.url http://localhost:9093"
  },
  {
    "instruction": "Expire a silence in Alertmanager",
    "output": "amtool silence expire --alertmanager.url http://localhost:9093 silence-uuid"
  },
  {
    "instruction": "Query Alertmanager alerts",
    "output": "amtool alert query --alertmanager.url http://localhost:9093"
  },
  {
    "instruction": "Add a route in Alertmanager config",
    "output": "echo 'route: receiver: team-X group_by: [alertname] receivers: - name: team-X webhook_configs: - url: https://hooks.example.com/alert' > alertmanager.yml"
  },
  {
    "instruction": "Add an inhibit rule in Alertmanager",
    "output": "echo 'inhibit_rules: - source_match: severity: critical target_match: severity: warning equal: [alertname, cluster]' >> alertmanager.yml"
  },
  {
    "instruction": "Create a Prometheus scrape config for node_exporter",
    "output": "echo 'scrape_configs: - job_name: node static_configs: - targets: - localhost:9100' >> prometheus.yml"
  },
  {
    "instruction": "Add a scrape target with labels",
    "output": "echo 'scrape_configs: - job_name: web metrics_path: /metrics static_configs: - targets: - web1:8080 - web2:8080 labels: env: prod' >> prometheus.yml"
  }
