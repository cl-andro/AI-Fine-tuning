[
  {
    "instruction": "Use gh API with jq to filter output",
    "output": "gh api /repos/owner/repo/issues --jq '.[] | {title: .title, state: .state}'"
  },
  {
    "instruction": "Use gh API with pagination",
    "output": "gh api /repos/owner/repo/issues --paginate"
  },
  {
    "instruction": "Use gh API with a custom header",
    "output": "gh api /repos/owner/repo -H \"Accept: application/vnd.github+json\""
  },
  {
    "instruction": "Use gh API preview header",
    "output": "gh api /repos/owner/repo -H \"Accept: application/vnd.github.dorian-preview+json\""
  },
  {
    "instruction": "List repository branches",
    "output": "gh api repos/owner/repo/branches --jq '.[].name'"
  },
  {
    "instruction": "Create a branch via GitHub API",
    "output": "gh api repos/owner/repo/git/refs -f ref=\"refs/heads/new-branch\" -f sha=\"abc123\""
  },
  {
    "instruction": "Protect a branch",
    "output": "gh api repos/owner/repo/branches/main/protection -f required_status_checks[strict]=true -f enforce_admins=true --method PUT"
  },
  {
    "instruction": "List deploy keys",
    "output": "gh api repos/owner/repo/keys --jq '.[].title'"
  },
  {
    "instruction": "Add a deploy key",
    "output": "gh api repos/owner/repo/keys -f title=\"Deploy Key\" -f key=\"$(cat ~/.ssh/id_rsa.pub)\" -f read_only=true"
  },
  {
    "instruction": "Remove a deploy key",
    "output": "gh api repos/owner/repo/keys/12345 --method DELETE"
  },
  {
    "instruction": "List repository webhooks",
    "output": "gh api repos/owner/repo/hooks --jq '.[].config.url'"
  },
  {
    "instruction": "Create a webhook",
    "output": "gh api repos/owner/repo/hooks -f name=web -f config[url]=https://example.com/hook -f config[content_type]=json -f events[]=push"
  },
  {
    "instruction": "Delete a webhook",
    "output": "gh api repos/owner/repo/hooks/123456 --method DELETE"
  },
  {
    "instruction": "List organization repos",
    "output": "gh repo list my-org --limit 100"
  },
  {
    "instruction": "Create a repo in an organization",
    "output": "gh repo create my-org/my-repo --private"
  },
  {
    "instruction": "Transfer a repo to an organization",
    "output": "gh api repos/owner/repo/transfer -f new_owner=my-org --method POST"
  },
  {
    "instruction": "List organization members",
    "output": "gh api orgs/my-org/members --jq '.[].login'"
  },
  {
    "instruction": "List organization teams",
    "output": "gh api orgs/my-org/teams --jq '.[].name'"
  },
  {
    "instruction": "Create a team",
    "output": "gh api orgs/my-org/teams -f name=dev-team -f description=\"Development team\" -f privacy=closed"
  },
  {
    "instruction": "Add a member to a team",
    "output": "gh api orgs/my-org/teams/dev-team/memberships/username -f role=member --method PUT"
  },
  {
    "instruction": "Remove a member from a team",
    "output": "gh api orgs/my-org/teams/dev-team/memberships/username --method DELETE"
  },
  {
    "instruction": "List team repositories",
    "output": "gh api orgs/my-org/teams/dev-team/repos --jq '.[].name'"
  },
  {
    "instruction": "Add repository to a team",
    "output": "gh api orgs/my-org/teams/dev-team/repos/my-org/repo -f permission=push --method PUT"
  },
  {
    "instruction": "Remove repository from a team",
    "output": "gh api orgs/my-org/teams/dev-team/repos/my-org/repo --method DELETE"
  },
  {
    "instruction": "Set GH CLI to use a specific host",
    "output": "gh config set git_protocol ssh --host github.com"
  }
]