[
  {
    "instruction": "Create a release with assets",
    "output": "gh release create v1.0.0 ./dist/myapp.tar.gz --title \"Version 1.0.0\""
  },
  {
    "instruction": "Create a prerelease",
    "output": "gh release create v1.0.0-rc1 --prerelease --title \"Release candidate\""
  },
  {
    "instruction": "Create a draft release",
    "output": "gh release create v1.0.0 --draft --title \"Draft release\""
  },
  {
    "instruction": "Upload an asset to an existing release",
    "output": "gh release upload v1.0.0 ./build/output.tar.gz"
  },
  {
    "instruction": "Download a release asset",
    "output": "gh release download v1.0.0 --pattern \"*.tar.gz\""
  },
  {
    "instruction": "Download release assets to a directory",
    "output": "gh release download v1.0.0 --dir ./downloads"
  },
  {
    "instruction": "Delete a release",
    "output": "gh release delete v1.0.0 --yes"
  },
  {
    "instruction": "Delete a tag along with a release",
    "output": "gh release delete v1.0.0 --cleanup-tag --yes"
  },
  {
    "instruction": "List repository labels",
    "output": "gh label list"
  },
  {
    "instruction": "Create a label",
    "output": "gh label create bug --color ff0000 --description \"Bug report\""
  },
  {
    "instruction": "Edit a label",
    "output": "gh label edit bug --color cc0000 --name defect"
  },
  {
    "instruction": "Delete a label",
    "output": "gh label delete bug --yes"
  },
  {
    "instruction": "List milestones",
    "output": "gh api repos/owner/repo/milestones --jq '.[].title'"
  },
  {
    "instruction": "Create a milestone",
    "output": "gh api repos/owner/repo/milestones -f title=\"v2.0\" -f due_on=\"2026-12-31T23:59:59Z\""
  },
  {
    "instruction": "Close a milestone",
    "output": "gh api repos/owner/repo/milestones/1 -f state=closed --method PATCH"
  },
  {
    "instruction": "Search code in a repository",
    "output": "gh search code \"function main\" --repo owner/repo"
  },
  {
    "instruction": "Search issues globally",
    "output": "gh search issues \"bug\" --state open --limit 10"
  },
  {
    "instruction": "Search PRs by author",
    "output": "gh search prs --author @me --state open"
  },
  {
    "instruction": "Search repos by description",
    "output": "gh search repos --description \"machine learning\" --language python"
  },
  {
    "instruction": "Search commits in a repo",
    "output": "gh search commits \"fix typo\" --repo owner/repo"
  },
  {
    "instruction": "Make a GET request to the GitHub API",
    "output": "gh api /repos/owner/repo"
  },
  {
    "instruction": "Make a POST request to the GitHub API",
    "output": "gh api /repos/owner/repo/issues -f title=\"New issue\" -f body=\"Body\""
  },
  {
    "instruction": "Make a PATCH request to the GitHub API",
    "output": "gh api /repos/owner/repo -f description=\"New description\" --method PATCH"
  },
  {
    "instruction": "Make a DELETE request to the GitHub API",
    "output": "gh api /repos/owner/repo --method DELETE"
  },
  {
    "instruction": "Make an API request with nested JSON body",
    "output": "gh api /repos/owner/repo/issues --input body.json"
  }
]