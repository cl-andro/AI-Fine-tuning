[
  {
    "instruction": "Remove all unused networks",
    "output": "podman network prune"
  },
  {
    "instruction": "Connect a container to a network",
    "output": "podman network connect mynet webserver"
  },
  {
    "instruction": "Disconnect a container from a network",
    "output": "podman network disconnect mynet webserver"
  },
  {
    "instruction": "Create a Podman volume",
    "output": "podman volume create myvol"
  },
  {
    "instruction": "Create a volume with a driver",
    "output": "podman volume create --driver local myvol"
  },
  {
    "instruction": "Create a volume with options",
    "output": "podman volume create --opt type=tmpfs --opt device=tmpfs myvol"
  },
  {
    "instruction": "List Podman volumes",
    "output": "podman volume ls"
  },
  {
    "instruction": "Inspect a Podman volume",
    "output": "podman volume inspect myvol"
  },
  {
    "instruction": "Remove a Podman volume",
    "output": "podman volume rm myvol"
  },
  {
    "instruction": "Remove all unused volumes",
    "output": "podman volume prune"
  },
  {
    "instruction": "Use a volume in a container",
    "output": "podman run -v myvol:/data -d nginx"
  },
  {
    "instruction": "Create a secret in Podman",
    "output": "podman secret create mysecret ./secret.txt"
  },
  {
    "instruction": "List Podman secrets",
    "output": "podman secret ls"
  },
  {
    "instruction": "Inspect a Podman secret",
    "output": "podman secret inspect mysecret"
  },
  {
    "instruction": "Remove a Podman secret",
    "output": "podman secret rm mysecret"
  },
  {
    "instruction": "Use a secret in a container",
    "output": "podman run --secret mysecret -d nginx"
  },
  {
    "instruction": "Create a Podman config (kube)",
    "output": "podman generate kube webserver > webserver.yaml"
  },
  {
    "instruction": "Create Kubernetes YAML from a pod",
    "output": "podman generate kube mypod > mypod.yaml"
  },
  {
    "instruction": "Play a Kubernetes YAML file",
    "output": "podman play kube webserver.yaml"
  },
  {
    "instruction": "Play a Kubernetes YAML with network",
    "output": "podman play kube --network host webserver.yaml"
  },
  {
    "instruction": "Generate systemd unit for a container",
    "output": "podman generate systemd --name webserver > /etc/systemd/system/webserver.service"
  },
  {
    "instruction": "Generate systemd unit with restart policy",
    "output": "podman generate systemd --name webserver --restart-policy always > webserver.service"
  },
  {
    "instruction": "Enable a container via systemd",
    "output": "podman generate systemd --name webserver | sudo tee /etc/systemd/system/webserver.service && sudo systemctl enable webserver"
  },
  {
    "instruction": "Start a container as a systemd service",
    "output": "podman generate systemd --name webserver --files --new && sudo systemctl enable --now container-webserver"
  },
  {
    "instruction": "Recreate container on systemd service start",
    "output": "podman generate systemd --name webserver --new > /etc/systemd/system/webserver.service"
  }
]