[
  {
    "instruction": "Import existing infrastructure into state",
    "output": "terraform import aws_instance.web i-1234567890abcdef0"
  },
  {
    "instruction": "Refresh state against real resources",
    "output": "terraform refresh"
  },
  {
    "instruction": "Output all values from state",
    "output": "terraform output"
  },
  {
    "instruction": "Get a specific output value in JSON",
    "output": "terraform output -json instance_ip"
  },
  {
    "instruction": "Show the Terraform state in JSON format",
    "output": "terraform show -json"
  },
  {
    "instruction": "Create a workspace and switch to it",
    "output": "terraform workspace new staging"
  },
  {
    "instruction": "List all workspaces",
    "output": "terraform workspace list"
  },
  {
    "instruction": "Switch to an existing workspace",
    "output": "terraform workspace select production"
  },
  {
    "instruction": "Show current workspace name",
    "output": "terraform workspace show"
  },
  {
    "instruction": "Delete a workspace",
    "output": "terraform workspace delete old-staging"
  },
  {
    "instruction": "Force delete a workspace with existing state",
    "output": "terraform workspace delete -force stale-env"
  },
  {
    "instruction": "Pull remote state to local file",
    "output": "terraform state pull > backup.tfstate"
  },
  {
    "instruction": "Push a local state file to remote",
    "output": "terraform state push backup.tfstate"
  },
  {
    "instruction": "Taint a resource to force recreation",
    "output": "terraform taint aws_instance.web"
  },
  {
    "instruction": "Untaint a previously tainted resource",
    "output": "terraform untaint aws_instance.web"
  },
  {
    "instruction": "Replace a resource in-place",
    "output": "terraform apply -replace=aws_instance.web -auto-approve"
  },
  {
    "instruction": "Force unlock a stuck state",
    "output": "terraform force-unlock LOCK_ID"
  },
  {
    "instruction": "Enable detailed logs for debugging",
    "output": "TF_LOG=TRACE terraform apply -auto-approve"
  },
  {
    "instruction": "Log to a file instead of stderr",
    "output": "TF_LOG_PATH=./terraform.log terraform plan"
  },
  {
    "instruction": "Use a specific Terraform binary version",
    "output": "tfswitch --chdir=/infra plan"
  },
  {
    "instruction": "Run Terraform with limited log level",
    "output": "TF_LOG=WARN terraform plan"
  },
  {
    "instruction": "Generate a graph of dependencies in DOT format",
    "output": "terraform graph | dot -Tpng > graph.png"
  },
  {
    "instruction": "Get a resource count from state",
    "output": "terraform state list | wc -l"
  },
  {
    "instruction": "Show provider versions in use",
    "output": "terraform providers"
  },
  {
    "instruction": "Mirror providers for air-gapped env",
    "output": "terraform providers mirror /opt/terraform-mirror"
