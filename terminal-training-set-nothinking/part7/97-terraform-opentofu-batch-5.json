  {
    "instruction": "Run Terragrunt plan all",
    "output": "terragrunt run-all plan"
  },
  {
    "instruction": "Apply all Terragrunt modules",
    "output": "terragrunt run-all apply"
  },
  {
    "instruction": "Terragrunt output for a specific module",
    "output": "terragrunt output -json"
  },
  {
    "instruction": "Terragrunt destroy all",
    "output": "terragrunt run-all destroy"
  },
  {
    "instruction": "Terragrunt validate all",
    "output": "terragrunt run-all validate"
  },
  {
    "instruction": "Terragrunt with a custom source URL",
    "output": "terragrunt init -source https://github.com/org/infra.git//modules/vpc"
  },
  {
    "instruction": "Create a Terragrunt module with inputs",
    "output": "echo 'inputs = { region = \"us-east-1\", environment = \"prod\" }' > terragrunt.hcl"
  },
  {
    "instruction": "Generate a provider block via Terragrunt",
    "output": "echo 'generate \"provider\" { path = \"provider.tf\" if_exists = \"overwrite\" contents = \"provider \\\"aws\\\" { region = \\\"us-east-1\\\" }\" }' > terragrunt.hcl"
  },
  {
    "instruction": "Use dependency blocks in Terragrunt",
    "output": "echo 'dependency \"vpc\" { config_path = \"../vpc\" }' > terragrunt.hcl"
  },
  {
    "instruction": "Run terraform plan with a remote state data source",
    "output": "terraform plan -target=data.terraform_remote_state.vpc"
  },
  {
    "instruction": "Use the http data source to fetch external data",
    "output": "echo 'data \"http\" \"example\" { url = \"https://api.example.com/status\" request_headers = { Accept = \"application/json\" } }' > http.tf"
  },
  {
    "instruction": "Use external data source with a script",
    "output": "echo 'data \"external\" \"script\" { program = [\"bash\", \"${path.module}/script.sh\"] }' > external.tf"
  },
  {
    "instruction": "Generate a random pet name",
    "output": "echo 'resource \"random_pet\" \"name\" { length = 2 }' > random.tf"
  },
  {
    "instruction": "Generate a random password",
    "output": "echo 'resource \"random_password\" \"db_pass\" { length = 24 special = true }' > random.tf"
  },
  {
    "instruction": "Generate a random integer for port numbers",
    "output": "echo 'resource \"random_integer\" \"port\" { min = 1024 max = 65535 }' > random.tf"
  },
  {
    "instruction": "Generate a UUID with random_uuid",
    "output": "echo 'resource \"random_uuid\" \"id\" {}' > random.tf"
  },
  {
    "instruction": "Use random_shuffle for availability zones",
    "output": "echo 'resource \"random_shuffle\" \"az\" { input = [\"us-east-1a\", \"us-east-1b\", \"us-east-1c\"] result_count = 2 }' > random.tf"
  }
]