[
  {
    "instruction": "Use Podman with Quadlet (run .container files)",
    "output": "echo '[Container] Image=nginx:latest Port=8080:80' > ~/.config/containers/systemd/webserver.container && systemctl --user daemon-reload && systemctl --user start webserver"
  },
  {
    "instruction": "Create a Quadlet network file",
    "output": "echo '[Network] Subnet=10.90.0.0/24' > ~/.config/containers/systemd/mynet.network && systemctl --user daemon-reload"
  },
  {
    "instruction": "Create a Quadlet volume file",
    "output": "echo '[Volume]' > ~/.config/containers/systemd/myvol.volume"
  },
  {
    "instruction": "List active Quadlet units",
    "output": "systemctl --user list-units '*.container' '*.volume' '*.network'"
  },
  {
    "instruction": "Start a Quadlet container",
    "output": "systemctl --user start webserver"
  },
  {
    "instruction": "Stop a Quadlet container",
    "output": "systemctl --user stop webserver"
  },
  {
    "instruction": "View Quadlet container logs",
    "output": "journalctl --user -u webserver"
  },
  {
    "instruction": "Use Podman with containernetworking plugins",
    "output": "podman run --network macvlan -d nginx"
  },
  {
    "instruction": "Use Podman with ipvlan network",
    "output": "podman network create --driver ipvlan myipvlan"
  },
  {
    "instruction": "Use Podman with macvlan network",
    "output": "podman network create --driver macvlan --subnet 10.20.0.0/24 mymacvlan"
  },
  {
    "instruction": "Use Podman with a custom DNS server",
    "output": "podman run --dns 8.8.8.8 -d nginx"
  },
  {
    "instruction": "Use Podman with dns_search domain",
    "output": "podman run --dns-search example.com -d nginx"
  },
  {
    "instruction": "Use Podman with hostname from container name",
    "output": "podman run --hostname webserver -d nginx"
  },
  {
    "instruction": "Use Podman with add_host",
    "output": "podman run --add-host myservice:10.0.0.5 -d nginx"
  },
  {
    "instruction": "Use Podman with exposed ports",
    "output": "podman run --expose 443 -d nginx"
  },
  {
    "instruction": "Use Podman with publish all exposed ports",
    "output": "podman run -P -d nginx"
  },
  {
    "instruction": "Create a Podman machine with custom disk size",
    "output": "podman machine init --disk-size 100"
  },
  {
    "instruction": "Upgrade Podman machine OS",
    "output": "podman machine ssh sudo dnf upgrade -y"
  },
  {
    "instruction": "Export Podman machine to an image",
    "output": "podman machine ssh -- podman image save localhost/myapp:latest -o /tmp/myapp.tar && podman machine scp /tmp/myapp.tar host:/tmp/"
  },
  {
    "instruction": "Use Podman with FIPS mode",
    "output": "podman run --security-opt fips=true nginx"
  },
  {
    "instruction": "Use Podman with seccomp default",
    "output": "podman run --security-opt seccomp=default nginx"
  },
  {
    "instruction": "Use Podman with no-new-keyring",
    "output": "podman run --security-opt no-new-keyring nginx"
  },
  {
    "instruction": "Use Podman with unmask paths",
    "output": "podman run --security-opt unmask=/proc:/sys nginx"
  },
  {
    "instruction": "Use Podman with mask paths",
    "output": "podman run --security-opt mask=/proc/acpi nginx"
  }
]