[
  {
    "instruction": "Check GitHub CLI version",
    "output": "gh --version"
  },
  {
    "instruction": "Authenticate GitHub CLI with your account",
    "output": "gh auth login"
  },
  {
    "instruction": "Authenticate with a token",
    "output": "gh auth login --with-token < token.txt"
  },
  {
    "instruction": "Check authentication status",
    "output": "gh auth status"
  },
  {
    "instruction": "Logout from GitHub CLI",
    "output": "gh auth logout"
  },
  {
    "instruction": "Refresh authentication token",
    "output": "gh auth refresh"
  },
  {
    "instruction": "List all repositories in the current org/user",
    "output": "gh repo list"
  },
  {
    "instruction": "List repos with a specific language",
    "output": "gh repo list --language python"
  },
  {
    "instruction": "List repos sorted by last updated",
    "output": "gh repo list --sort updated --limit 20"
  },
  {
    "instruction": "View a repository",
    "output": "gh repo view owner/repo"
  },
  {
    "instruction": "View repo in the browser",
    "output": "gh repo view --web owner/repo"
  },
  {
    "instruction": "Clone a repository",
    "output": "gh repo clone owner/repo"
  },
  {
    "instruction": "Create a new repository",
    "output": "gh repo create my-new-repo --public"
  },
  {
    "instruction": "Create a private repository with description",
    "output": "gh repo create my-new-repo --private --description \"My description\""
  },
  {
    "instruction": "Create a repo from a template",
    "output": "gh repo create my-repo --template owner/template-repo"
  },
  {
    "instruction": "Fork a repository",
    "output": "gh repo fork owner/repo"
  },
  {
    "instruction": "Fork and clone a repository",
    "output": "gh repo fork owner/repo --clone"
  },
  {
    "instruction": "Fork to a specific organization",
    "output": "gh repo fork owner/repo --org my-org"
  },
  {
    "instruction": "Archive a repository",
    "output": "gh repo archive owner/repo"
  },
  {
    "instruction": "Rename a repository",
    "output": "gh repo rename new-name"
  },
  {
    "instruction": "Delete a repository",
    "output": "gh repo delete owner/repo --yes"
  },
  {
    "instruction": "List repository topics",
    "output": "gh repo view --json repositoryTopics --jq .repositoryTopics[].name"
  },
  {
    "instruction": "Add topics to a repository",
    "output": "gh repo edit --add-topic \"python\" --add-topic \"cli\""
  },
  {
    "instruction": "List repo collaborators",
    "output": "gh api repos/owner/repo/collaborators --jq '.[].login'"
  }
