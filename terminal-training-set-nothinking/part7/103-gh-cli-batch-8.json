[
  {
    "instruction": "Get the current user's profile",
    "output": "gh api user --jq '{login: .login, name: .name, email: .email}'"
  },
  {
    "instruction": "List the current user's repos",
    "output": "gh api user/repos --jq '.[].full_name'"
  },
  {
    "instruction": "List user's starred repos",
    "output": "gh api user/starred --jq '.[].full_name'"
  },
  {
    "instruction": "Star a repository",
    "output": "gh api user/starred/owner/repo --method PUT"
  },
  {
    "instruction": "Unstar a repository",
    "output": "gh api user/starred/owner/repo --method DELETE"
  },
  {
    "instruction": "Follow a user",
    "output": "gh api user/following/username --method PUT"
  },
  {
    "instruction": "Unfollow a user",
    "output": "gh api user/following/username --method DELETE"
  },
  {
    "instruction": "Watch/unwatch a repository",
    "output": "gh api repos/owner/repo/subscription -f subscribed=true --method PUT"
  },
  {
    "instruction": "Create a repository dispatch event",
    "output": "gh api repos/owner/repo/dispatches -f event_type=deploy -f client_payload[env]=production"
  },
  {
    "instruction": "List repository contributors",
    "output": "gh api repos/owner/repo/contributors --jq '.[].login'"
  },
  {
    "instruction": "Get repository traffic stats",
    "output": "gh api repos/owner/repo/traffic/views"
  },
  {
    "instruction": "Clone repos with SSH instead of HTTPS",
    "output": "gh config set git_protocol ssh"
  },
  {
    "instruction": "Set gh CLI to use HTTPS for git operations",
    "output": "gh config set git_protocol https"
  },
  {
    "instruction": "Set git editor for gh CLI",
    "output": "gh config set editor vim"
  },
  {
    "instruction": "View gh CLI configuration",
    "output": "gh config list"
  },
  {
    "instruction": "View gh CLI configuration for a specific host",
    "output": "gh config list --host github.com"
  },
  {
    "instruction": "Format gh output using Go templates",
    "output": "gh pr list --format '{{.number}} {{.title}}'"
  },
  {
    "instruction": "Format issue list as JSON",
    "output": "gh issue list --json number,title,state,assignees"
  },
  {
    "instruction": "Filter issues with JSON path",
    "output": "gh issue list --json number,title --jq '.[] | select(.number > 10)'"
  },
  {
    "instruction": "Use gh with colors disabled",
    "output": "gh config set prompt disabled"
  },
  {
    "instruction": "Use gh in non-interactive mode",
    "output": "gh issue create --title \"Auto issue\" --body \"Created by script\" --label automated"
  },
  {
    "instruction": "Bulk close issues by label",
    "output": "gh issue list --label stale --json number --jq '.[].number' | xargs -I{} gh issue close {}"
  },
  {
    "instruction": "Bulk add label to issues",
    "output": "gh issue list --label bug --json number --jq '.[].number' | xargs -I{} gh issue edit {} --add-label triaged"
  },
  {
    "instruction": "Create a project (classic) card from CLI",
    "output": "gh api /projects/columns/123/cards -f note=\"Task card\""
  },
  {
    "instruction": "Create a GitHub Project (v2) item via API",
    "output": "gh api /graphql -f query='mutation { addProjectV2ItemById(input: {projectId: \"PVT_123\", contentId: \"I_123\"}) { item { id } } }'"
  }
]