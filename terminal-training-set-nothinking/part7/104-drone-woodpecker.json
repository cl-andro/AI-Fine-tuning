[
  {
    "instruction": "Check Drone CLI version",
    "output": "drone --version"
  },
  {
    "instruction": "Authenticate Drone CLI with a token",
    "output": "drone login --server https://drone.example.com --token abc123"
  },
  {
    "instruction": "List Drone repositories",
    "output": "drone repo ls"
  },
  {
    "instruction": "List all repositories including inactive",
    "output": "drone repo ls --active false"
  },
  {
    "instruction": "Add a repository to Drone",
    "output": "drone repo add owner/repo"
  },
  {
    "instruction": "Add a repository with auto-cancel running builds",
    "output": "drone repo update owner/repo --build-cancel-running"
  },
  {
    "instruction": "Update a repository setting (trusted)",
    "output": "drone repo update owner/repo --trusted"
  },
  {
    "instruction": "Update repository visibility",
    "output": "drone repo update owner/repo --visibility internal"
  },
  {
    "instruction": "Remove a repository from Drone",
    "output": "drone repo rm owner/repo"
  },
  {
    "instruction": "Repair a repository's webhooks",
    "output": "drone repo repair owner/repo"
  },
  {
    "instruction": "List builds for a repository",
    "output": "drone build ls owner/repo"
  },
  {
    "instruction": "List builds with a limit",
    "output": "drone build ls owner/repo --limit 20"
  },
  {
    "instruction": "List builds for a specific branch",
    "output": "drone build ls owner/repo --branch main"
  },
  {
    "instruction": "View a specific build",
    "output": "drone build info owner/repo 42"
  },
  {
    "instruction": "View build logs for a specific step",
    "output": "drone build logs owner/repo 42 1"
  },
  {
    "instruction": "Tail build logs in real-time",
    "output": "drone build logs owner/repo 42 1 | tail -f"
  },
  {
    "instruction": "Start a new build",
    "output": "drone build start owner/repo 42"
  },
  {
    "instruction": "Stop a running build",
    "output": "drone build stop owner/repo 42"
  },
  {
    "instruction": "Approve a pending build",
    "output": "drone build approve owner/repo 42"
  },
  {
    "instruction": "Decline a pending build",
    "output": "drone build decline owner/repo 42"
  },
  {
    "instruction": "Queue a build for a specific commit",
    "output": "drone build queue owner/repo --commit abc123"
  },
  {
    "instruction": "List secrets for a repository",
    "output": "drone secret ls owner/repo"
  },
  {
    "instruction": "Add a secret to a repository",
    "output": "drone secret add owner/repo DOCKER_PASSWORD supersecret"
  },
  {
    "instruction": "Add a secret and allow it in pull requests",
    "output": "drone secret add owner/repo MY_TOKEN supersecret --allow-pull-request"
  },
  {
    "instruction": "Update an existing secret",
    "output": "drone secret update owner/repo DOCKER_PASSWORD newpassword"
  }
]