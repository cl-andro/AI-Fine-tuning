[
  {
    "instruction": "Check Terraform version",
    "output": "terraform version"
  },
  {
    "instruction": "Initialize a Terraform working directory",
    "output": "terraform init"
  },
  {
    "instruction": "Initialize with backend config file",
    "output": "terraform init -backend-config=backend.hcl"
  },
  {
    "instruction": "Initialize without backend migration prompts",
    "output": "terraform init -force-copy -input=false"
  },
  {
    "instruction": "Upgrade all providers to latest allowed",
    "output": "terraform init -upgrade"
  },
  {
    "instruction": "Format all .tf files in directory",
    "output": "terraform fmt -recursive"
  },
  {
    "instruction": "Check Terraform formatting in CI mode",
    "output": "terraform fmt -check -recursive"
  },
  {
    "instruction": "Validate the configuration syntax",
    "output": "terraform validate"
  },
  {
    "instruction": "Show the execution plan",
    "output": "terraform plan"
  },
  {
    "instruction": "Save a plan to a file",
    "output": "terraform plan -out=tfplan"
  },
  {
    "instruction": "Plan with variable overrides",
    "output": "terraform plan -var='region=us-east-1' -var='instance_type=t3.micro'"
  },
  {
    "instruction": "Plan using a var file",
    "output": "terraform plan -var-file=production.tfvars"
  },
  {
    "instruction": "Plan targeting a specific resource",
    "output": "terraform plan -target=aws_instance.web"
  },
  {
    "instruction": "Plan and destroy resources",
    "output": "terraform plan -destroy"
  },
  {
    "instruction": "Plan with variable file auto-loaded from directory",
    "output": "terraform plan -var-file=terraform.tfvars"
  },
  {
    "instruction": "Apply a saved plan",
    "output": "terraform apply tfplan"
  },
  {
    "instruction": "Apply without plan (auto-approve)",
    "output": "terraform apply -auto-approve"
  },
  {
    "instruction": "Apply with parallel operations limit",
    "output": "terraform apply -parallelism=5"
  },
  {
    "instruction": "Apply only to a specific target",
    "output": "terraform apply -target=module.vpc -auto-approve"
  },
  {
    "instruction": "Destroy all managed infrastructure",
    "output": "terraform destroy -auto-approve"
  },
  {
    "instruction": "Destroy targeting a specific resource",
    "output": "terraform destroy -target=aws_instance.bastion -auto-approve"
  },
  {
    "instruction": "Show current state listing",
    "output": "terraform state list"
  },
  {
    "instruction": "Show a specific resource's state",
    "output": "terraform state show aws_instance.web"
  },
  {
    "instruction": "Move a resource in state",
    "output": "terraform state mv aws_instance.old aws_instance.new"
  },
  {
    "instruction": "Remove a resource from state without destroying",
    "output": "terraform state rm aws_instance.orphaned"
  }
