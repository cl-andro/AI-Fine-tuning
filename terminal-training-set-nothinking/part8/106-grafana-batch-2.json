[
  {
    "instruction": "List Grafana alert rules",
    "output": "grafana-cli alerting rules ls"
  },
  {
    "instruction": "Pause an alert rule",
    "output": "grafana-cli alerting rules pause 1"
  },
  {
    "instruction": "Unpause an alert rule",
    "output": "grafana-cli alerting rules unpause 1"
  },
  {
    "instruction": "Test an alert rule",
    "output": "grafana-cli alerting rules test 1"
  },
  {
    "instruction": "List contact points in Grafana",
    "output": "grafana-cli alerting contact-points ls"
  },
  {
    "instruction": "Create a Slack contact point",
    "output": "grafana-cli alerting contact-points create --name slack --type slack --settings url=https://hooks.slack.com/services/T00/B00/xxx"
  },
  {
    "instruction": "Delete a contact point",
    "output": "grafana-cli alerting contact-points delete 1"
  },
  {
    "instruction": "List notification policies",
    "output": "grafana-cli alerting notification-policies ls"
  },
  {
    "instruction": "Update notification policy",
    "output": "grafana-cli alerting notification-policies update --policy policy.json"
  },
  {
    "instruction": "List alertmanager configurations",
    "output": "grafana-cli alerting alertmanager ls"
  },
  {
    "instruction": "Upload a datasource via provisioning file",
    "output": "echo 'apiVersion: 1 datasources: - name: Prometheus type: prometheus access: proxy url: http://prometheus:9090 isDefault: true' > /etc/grafana/provisioning/datasources/prometheus.yml"
  },
  {
    "instruction": "Upload a dashboard via provisioning file",
    "output": "echo 'apiVersion: 1 providers: - name: default orgId: 1 folder: \"\" type: file options: path: /var/lib/grafana/dashboards' > /etc/grafana/provisioning/dashboards/default.yml"
  },
  {
    "instruction": "Provision a dashboard JSON file",
    "output": "echo '{ \"title\": \"Node Exporter\", \"panels\": [] }' > /var/lib/grafana/dashboards/node-exporter.json"
  },
  {
    "instruction": "Run Grafana in Docker",
    "output": "docker run -d --name grafana -p 3000:3000 -v $PWD/grafana.ini:/etc/grafana/grafana.ini grafana/grafana"
  },
  {
    "instruction": "Run Grafana with env for admin password",
    "output": "docker run -d --name grafana -p 3000:3000 -e GF_SECURITY_ADMIN_PASSWORD=admin123 grafana/grafana"
  },
  {
    "instruction": "Run Grafana with LDAP config",
    "output": "docker run -d --name grafana -p 3000:3000 -v $PWD/ldap.toml:/etc/grafana/ldap.toml grafana/grafana"
  },
  {
    "instruction": "Check Grafana health via API",
    "output": "curl http://admin:admin@localhost:3000/api/health"
  },
  {
    "instruction": "Get Grafana org list via API",
    "output": "curl -s http://admin:admin@localhost:3000/api/orgs | jq '.'"
  },
  {
    "instruction": "Get Grafana user list via API",
    "output": "curl -s http://admin:admin@localhost:3000/api/users | jq '.'"
  },
  {
    "instruction": "Create Grafana API key via API",
    "output": "curl -X POST http://admin:admin@localhost:3000/api/auth/keys -H 'Content-Type: application/json' -d '{\"name\":\"deploy\",\"role\":\"Admin\",\"secondsToLive\":86400}'"
  },
  {
    "instruction": "Create a Grafana datasource via API",
    "output": "curl -X POST http://admin:admin@localhost:3000/api/datasources -H 'Content-Type: application/json' -d '{\"name\":\"Prometheus\",\"type\":\"prometheus\",\"url\":\"http://prometheus:9090\",\"access\":\"proxy\",\"isDefault\":true}'"
  },
  {
    "instruction": "Create a Grafana dashboard via API from JSON",
    "output": "curl -X POST http://admin:admin@localhost:3000/api/dashboards/db -H 'Content-Type: application/json' -d '{\"dashboard\": {\"title\": \"My Dashboard\", \"panels\": []}, \"overwrite\": true}'"
  },
  {
    "instruction": "Get a list of Grafana dashboards via API",
    "output": "curl -s http://admin:admin@localhost:3000/api/search?type=dash-db | jq '.'"
  },
  {
    "instruction": "Delete a Grafana dashboard via API",
    "output": "curl -X DELETE http://admin:admin@localhost:3000/api/dashboards/uid/my-dashboard"
  },
  {
    "instruction": "Create a Grafana folder via API",
    "output": "curl -X POST http://admin:admin@localhost:3000/api/folders -H 'Content-Type: application/json' -d '{\"title\": \"Infrastructure\", \"uid\": \"infra\"}'"
  }
]