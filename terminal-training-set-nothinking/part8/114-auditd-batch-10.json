[
  {
    "instruction": "Watch nginx config directory",
    "output": "auditctl -w /etc/nginx/ -p wa -k nginx_config"
  },
  {
    "instruction": "Delete all audit rules",
    "output": "auditctl -D"
  },
  {
    "instruction": "Set buffer size to 8192",
    "output": "auditctl -b 8192"
  },
  {
    "instruction": "Set failure mode to 1",
    "output": "auditctl -f 1"
  },
  {
    "instruction": "Set rate limit to 1000",
    "output": "auditctl -r 1000"
  },
  {
    "instruction": "Search audit log by key",
    "output": "ausearch -k passwd_changes"
  },
  {
    "instruction": "Search audit log by executable",
    "output": "ausearch -x /usr/bin/sshd"
  },
  {
    "instruction": "Search audit log by UID",
    "output": "ausearch -ui 1000"
  },
  {
    "instruction": "Search audit log by time range",
    "output": "ausearch -ts 09:00:00 -te 17:00:00"
  },
  {
    "instruction": "Search audit log for today",
    "output": "ausearch --start today"
  },
  {
    "instruction": "Search for failed syscalls",
    "output": "ausearch -sv no"
  },
  {
    "instruction": "Search by process ID",
    "output": "ausearch -p 1234"
  },
  {
    "instruction": "Search for SELinux AVCS",
    "output": "ausearch -m avc"
  },
  {
    "instruction": "Generate audit report by executable",
    "output": "aureport -x"
  },
  {
    "instruction": "Generate audit summary report",
    "output": "aureport --summary"
  },
  {
    "instruction": "Generate audit report by user",
    "output": "aureport -u"
  },
  {
    "instruction": "Generate audit report by time",
    "output": "aureport -t"
  },
  {
    "instruction": "Generate audit file change report",
    "output": "aureport -f"
  },
  {
    "instruction": "Generate audit login report",
    "output": "aureport -l"
  },
  {
    "instruction": "Add persistent audit rule",
    "output": "echo \"-w /etc/passwd -p wa -k passwd_changes\" >> /etc/audit/rules.d/audit.rules"
  },
  {
    "instruction": "Add integration check for /etc",
    "output": "echo \"-a always,exit -S openat -F dir=/etc -F key=etc_integrity\" >> /etc/audit/rules.d/audit.rules"
  },
  {
    "instruction": "List audit log files",
    "output": "ls /var/log/audit/"
  },
  {
    "instruction": "Check current audit status",
    "output": "auditctl -s"
  },
  {
    "instruction": "Add audit rule for time changes",
    "output": "auditctl -a always,exit -S settimeofday -S adjtimex -k time_change"
  }
]