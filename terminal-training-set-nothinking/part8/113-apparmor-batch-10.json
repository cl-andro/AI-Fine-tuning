[
  {
    "instruction": "Run log profiler iteration 22",
    "output": "aa-logprof"
  },
  {
    "instruction": "Parse and load nginx profile 22",
    "output": "apparmor_parser -r /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Load profile with kernel cache",
    "output": "apparmor_parser -r -W /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Force reload skip cache",
    "output": "apparmor_parser -r -R /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Rebuild AppArmor cache",
    "output": "apparmor_parser -r --skip-cache /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "List enforce mode profiles",
    "output": "aa-status --enforced"
  },
  {
    "instruction": "List complain mode profiles",
    "output": "aa-status --complaining"
  },
  {
    "instruction": "Check if kernel module enabled",
    "output": "cat /sys/module/apparmor/parameters/enabled"
  },
  {
    "instruction": "View nginx profile file",
    "output": "cat /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Create basic profile template",
    "output": "echo \"#include <tunables/global>\nprofile test /usr/bin/test {\n  #include <abstractions/base>\n  /usr/bin/test r,\n}\" > /etc/apparmor.d/usr.bin.test"
  },
  {
    "instruction": "Reload all AppArmor profiles",
    "output": "systemctl reload apparmor"
  },
  {
    "instruction": "Restart AppArmor service",
    "output": "systemctl restart apparmor"
  },
  {
    "instruction": "Add capability to profile",
    "output": "echo \"  capability net_bind_service,\" >> /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Add file read rule",
    "output": "echo \"  /var/log/nginx/*.log r,\" >> /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Add file write rule",
    "output": "echo \"  /var/run/nginx.pid rw,\" >> /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Add network rule",
    "output": "echo \"  network tcp,\" >> /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Add deny rule",
    "output": "echo \"  deny /etc/shadow r,\" >> /etc/apparmor.d/usr.sbin.nginx"
  },
  {
    "instruction": "Check if process is confined",
    "output": "cat /proc/1/attr/current"
  },
  {
    "instruction": "Run command under profile",
    "output": "aa-exec -p /usr/sbin/nginx -- /bin/bash"
  },
  {
    "instruction": "Change profile at runtime",
    "output": "echo /usr/sbin/nginx > /proc/$(pidof nginx)/attr/current"
  },
  {
    "instruction": "List all profile files",
    "output": "find /etc/apparmor.d -type f -name '*.*' 2>/dev/null"
  },
  {
    "instruction": "Remove a profile",
    "output": "aa-disable /usr/bin/test"
  },
  {
    "instruction": "Check profile mode for process",
    "output": "cat /proc/$(pidof nginx)/attr/current"
  },
  {
    "instruction": "Load profile without cache",
    "output": "apparmor_parser -r -K /etc/apparmor.d/usr.sbin.nginx"
  }
]