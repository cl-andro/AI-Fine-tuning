[
  {
    "instruction": "Check Grafana CLI version",
    "output": "grafana-cli --version"
  },
  {
    "instruction": "List installed Grafana plugins",
    "output": "grafana-cli plugins ls"
  },
  {
    "instruction": "Install a Grafana plugin",
    "output": "grafana-cli plugins install grafana-piechart-panel"
  },
  {
    "instruction": "Install a plugin from a specific URL",
    "output": "grafana-cli --pluginUrl https://example.com/plugin.zip plugins install my-plugin"
  },
  {
    "instruction": "Update all Grafana plugins",
    "output": "grafana-cli plugins update-all"
  },
  {
    "instruction": "Update a specific Grafana plugin",
    "output": "grafana-cli plugins update grafana-piechart-panel"
  },
  {
    "instruction": "Uninstall a Grafana plugin",
    "output": "grafana-cli plugins uninstall grafana-piechart-panel"
  },
  {
    "instruction": "List Grafana datasources",
    "output": "grafana-cli datasources ls"
  },
  {
    "instruction": "Get a specific datasource by ID",
    "output": "grafana-cli datasources get 1"
  },
  {
    "instruction": "Delete a datasource",
    "output": "grafana-cli datasources delete 1"
  },
  {
    "instruction": "List all dashboards",
    "output": "grafana-cli dashboards ls"
  },
  {
    "instruction": "Get a specific dashboard by UID",
    "output": "grafana-cli dashboards get my-dashboard-uid"
  },
  {
    "instruction": "Delete a dashboard",
    "output": "grafana-cli dashboards delete my-dashboard-uid"
  },
  {
    "instruction": "List folders",
    "output": "grafana-cli folders ls"
  },
  {
    "instruction": "Create a folder",
    "output": "grafana-cli folders create my-folder"
  },
  {
    "instruction": "Delete a folder",
    "output": "grafana-cli folders delete 1"
  },
  {
    "instruction": "List users in Grafana",
    "output": "grafana-cli users ls"
  },
  {
    "instruction": "Create a new user",
    "output": "grafana-cli users create --login jdoe --password secret --name \"John Doe\" --email jdoe@example.com"
  },
  {
    "instruction": "Delete a user",
    "output": "grafana-cli users delete 1"
  },
  {
    "instruction": "List API keys",
    "output": "grafana-cli api-keys ls"
  },
  {
    "instruction": "Create an API key with Admin role",
    "output": "grafana-cli api-keys create --name mykey --role Admin --ttl 720h"
  },
  {
    "instruction": "Delete an API key",
    "output": "grafana-cli api-keys delete 1"
  },
  {
    "instruction": "List organizations",
    "output": "grafana-cli orgs ls"
  },
  {
    "instruction": "Create an organization",
    "output": "grafana-cli orgs create my-org"
  },
  {
    "instruction": "Delete an organization",
    "output": "grafana-cli orgs delete 1"
  }
