[
  {
    "instruction": "Install Grafana image renderer plugin",
    "output": "grafana-cli plugins install grafana-image-renderer"
  },
  {
    "instruction": "Enable Grafana dashboard previews",
    "output": "echo '[rendering] server_url = http://renderer:8081/render callback_url = http://grafana:3000/' >> /etc/grafana/grafana.ini"
  },
  {
    "instruction": "Export Grafana dashboard to PNG",
