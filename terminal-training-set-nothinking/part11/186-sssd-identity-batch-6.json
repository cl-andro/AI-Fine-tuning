[
  {
    "instruction": "How to join a domain with a one-time password",
    "output": "realm join --one-time-password=OTP ad.example.com"
  },
  {
    "instruction": "How to leave a domain",
    "output": "realm leave example.com"
  },
  {
    "instruction": "How to leave a domain and remove configuration",
    "output": "realm leave --remove example.com"
  },
  {
    "instruction": "How to list discovered domains",
    "output": "realm list"
  },
  {
    "instruction": "How to list details for a specific domain",
    "output": "realm list --name=example.com"
  },
  {
    "instruction": "How to permit all users from a domain",
    "output": "realm permit --all"
  },
  {
    "instruction": "How to permit a specific user from a domain",
    "output": "realm permit bob@example.com"
  },
  {
    "instruction": "How to restrict domain login to a specific group",
    "output": "realm permit -g admins@example.com"
  },
  {
    "instruction": "How to deny all domain users",
    "output": "realm deny --all"
  },
  {
    "instruction": "How to configure id_provider as LDAP in sssd.conf",
    "output": "echo 'id_provider = ldap' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to configure id_provider as AD",
    "output": "echo 'id_provider = ad' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to configure id_provider as IPA",
    "output": "echo 'id_provider = ipa' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to configure id_provider as proxy",
    "output": "echo 'id_provider = proxy' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to configure ldap_id_use_start_tls",
    "output": "echo 'ldap_id_use_start_tls = true' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to set LDAP default bind DN",
    "output": "echo 'ldap_default_bind_dn = cn=admin,dc=example,dc=com' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to set the LDAP autofs provider",
    "output": "echo 'autofs_provider = ldap' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to enable SSSD debug logs",
    "output": "echo 'debug_level = 9' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to enable SSSD enumeration",
    "output": "echo 'enumerate = true' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to enable subdomain inheritance",
    "output": "echo 'subdomain_inherit = ldap_search_base' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to override home directory in SSSD",
    "output": "echo 'override_homedir = /home/$domain/$user' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to set the default shell in SSSD",
    "output": "echo 'default_shell = /bin/bash' >> /etc/sssd/sssd.conf"
  },
  {
    "instruction": "How to set the fallback home directory",
    "output": "echo 'fallback_homedir = /home/%u' >> /etc/sssd/sssd.conf"
  }
]