[
  {
    "instruction": "How to check RAID array consistency",
    "output": "mdadm --detail --test /dev/md0"
  },
  {
    "instruction": "How to wait for RAID reshape to complete",
    "output": "mdadm --wait /dev/md0"
  },
  {
    "instruction": "How to create RAID with metadata version 1.2",
    "output": "mdadm --create /dev/md0 --level=1 --metadata=1.2 --raid-devices=2 /dev/sda /dev/sdb"
  },
  {
    "instruction": "How to create RAID with metadata version 0.90",
    "output": "mdadm --create /dev/md0 --level=1 --metadata=0.90 --raid-devices=2 /dev/sda /dev/sdb"
  },
  {
    "instruction": "How to create a named RAID array",
    "output": "mdadm --create /dev/md0 --level=1 --raid-devices=2 --name=backup /dev/sda /dev/sdb"
  },
  {
    "instruction": "How to append RAID config to mdadm.conf",
    "output": "mdadm --detail --scan >> /etc/mdadm/mdadm.conf"
  },
  {
    "instruction": "How to restore a RAID superblock from a backup file",
    "output": "mdadm --examine --backup-file=/tmp/backup /dev/sda"
  },
  {
    "instruction": "How to fail and remove a device in one command",
    "output": "mdadm --manage /dev/md0 --fail /dev/sda --remove /dev/sda"
  },
  {
    "instruction": "How to create RAID with write-behind enabled",
    "output": "mdadm --create /dev/md0 --level=1 --write-behind=1024 --raid-devices=2 /dev/sda /dev/sdb"
  },
  {
    "instruction": "How to set array to auto-readonly",
    "output": "mdadm --readonly /dev/md0"
  },
  {
    "instruction": "How to re-add a previously removed device",
    "output": "mdadm --manage /dev/md0 --re-add /dev/sda"
  },
  {
    "instruction": "How to create a RAID0 array with three disks",
    "output": "mdadm --create /dev/md0 --level=0 --raid-devices=3 /dev/sda /dev/sdb /dev/sdc"
  },
  {
    "instruction": "How to manually start a degraded RAID",
    "output": "mdadm --run /dev/md0"
  },
