  },
  {
    "instruction": "How to create RAID with a custom chunk size",
    "output": "mdadm --create /dev/md0 --level=5 --chunk=128 --raid-devices=3 /dev/sda /dev/sdb /dev/sdc"
  },
  {
    "instruction": "How to assemble an existing RAID array",
    "output": "mdadm --assemble /dev/md0 /dev/sda /dev/sdb"
