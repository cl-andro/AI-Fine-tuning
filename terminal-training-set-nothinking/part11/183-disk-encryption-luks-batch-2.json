    "output": "cryptsetup luksClose secret"
  },
  {
    "instruction": "How to close all LUKS devices",
    "output": "cryptsetup luksClose --all"
  },
  {
    "instruction": "How to add a new key to a LUKS device",
    "output": "cryptsetup luksAddKey /dev/sda1"
  },
  {
