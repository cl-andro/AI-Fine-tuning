    "output": "cryptsetup luksAddKey --key-slot 1 /dev/sda1"
  },
  {
    "instruction": "How to remove a key from LUKS",
    "output": "cryptsetup luksRemoveKey /dev/sda1"
  },
  {
    "instruction": "How to remove a key by slot number",
    "output": "cryptsetup luksKillSlot /dev/sda1 0"
  },
  {
