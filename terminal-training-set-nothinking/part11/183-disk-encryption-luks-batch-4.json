[
  {
    "instruction": "How to backup the LUKS header",
    "output": "cryptsetup luksHeaderBackup /dev/sda1 --header-backup-file /root/luks-header.bak"
  },
  {
    "instruction": "How to restore a LUKS header from backup",
    "output": "cryptsetup luksHeaderRestore /dev/sda1 --header-backup-file /root/luks-header.bak"
  },
  {
    "instruction": "How to dump LUKS header information",
    "output": "cryptsetup luksDump /dev/sda1"
  },
  {
    "instruction": "How to dump the LUKS2 JSON metadata area",
    "output": "cryptsetup luksDump --dump-json-metadata /dev/sda1"
  },
  {
    "instruction": "How to check LUKS device status",
    "output": "cryptsetup status secret"
  },
  {
    "instruction": "How to resize a LUKS device",
    "output": "cryptsetup resize secret"
  },
  {
    "instruction": "How to format LUKS as LUKS2 type",
    "output": "cryptsetup luksFormat --type luks2 /dev/sda1"
  },
  {
    "instruction": "How to erase all keys from a LUKS device",
    "output": "cryptsetup luksErase /dev/sda1"
  },
  {
    "instruction": "How to convert LUKS1 to LUKS2",
    "output": "cryptsetup convert --type luks2 /dev/sda1"
  },
  {
    "instruction": "How to convert LUKS2 to LUKS1",
    "output": "cryptsetup convert --type luks1 /dev/sda1"
  },
  {
    "instruction": "How to add a LUKS2 token for TPM2",
    "output": "cryptsetup token import /dev/sda1 --token-id 0 --key-description tpm2-token"
  },
  {
    "instruction": "How to remove a LUKS2 token",
    "output": "cryptsetup token remove /dev/sda1 --token-id 0"
  },
  {
    "instruction": "How to list LUKS2 tokens",
    "output": "cryptsetup token list /dev/sda1"
  },
  {
    "instruction": "How to encrypt an existing ext4 filesystem in-place",
    "output": "cryptsetup reencrypt --encrypt --reduce-device-size 32M /dev/sda1"
  },
  {
    "instruction": "How to decrypt an encrypted device in-place",
    "output": "cryptsetup reencrypt --decrypt /dev/sda1"
  },
  {
    "instruction": "How to pause reencryption",
    "output": "cryptsetup reencrypt --pause-only /dev/sda1"
  },
  {
    "instruction": "How to resume reencryption",
    "output": "cryptsetup reencrypt --resume-only /dev/sda1"
  },
  {
    "instruction": "How to format a detached LUKS header",
    "output": "cryptsetup luksFormat --header /boot/luks-header.img /dev/sda1"
  },
  {
    "instruction": "How to open LUKS with a detached header",
    "output": "cryptsetup luksOpen --header /boot/luks-header.img /dev/sda1 secret"
  },
  {
    "instruction": "How to test a passphrase on a LUKS device",
    "output": "cryptsetup luksOpen --test-passphrase /dev/sda1"
  },
  {
    "instruction": "How to set LUKS2 persistent flags",
    "output": "cryptsetup luksOpen --persistent /dev/sda1 secret"
  },
  {
    "instruction": "How to disable a LUKS2 keyslot",
    "output": "cryptsetup luksKillSlot /dev/sda1 2"
  }
