[
  {
    "instruction": "How to create a new btrfs subvolume",
    "output": "btrfs subvolume create /mnt/data/@home"
  },
  {
    "instruction": "How to list all btrfs subvolumes",
    "output": "btrfs subvolume list /mnt/data"
  },
  {
    "instruction": "How to show subvolume details",
    "output": "btrfs subvolume show /mnt/data/@home"
  },
  {
    "instruction": "How to delete a btrfs subvolume",
    "output": "btrfs subvolume delete /mnt/data/@old_snap"
  },
  {
    "instruction": "How to create a read-only snapshot",
    "output": "btrfs subvolume snapshot -r /mnt/data/@home /mnt/data/@home_ro"
  },
  {
    "instruction": "How to create a writable snapshot",
    "output": "btrfs subvolume snapshot /mnt/data/@home /mnt/data/@home_wip"
  },
  {
    "instruction": "How to send a snapshot to a file",
    "output": "btrfs send /mnt/data/@home_ro > /backup/home_snap.img"
  },
  {
    "instruction": "How to receive a snapshot from a file",
    "output": "btrfs receive /mnt/data < /backup/home_snap.img"
  },
  {
    "instruction": "How to send an incremental snapshot",
    "output": "btrfs send -p /mnt/data/@home_prev /mnt/data/@home_cur > inc.img"
  },
  {
    "instruction": "How to start a balance operation",
    "output": "btrfs balance start /mnt/data"
  },
  {
    "instruction": "How to pause a running balance",
    "output": "btrfs balance pause /mnt/data"
  },
  {
    "instruction": "How to resume a paused balance",
    "output": "btrfs balance resume /mnt/data"
  },
  {
    "instruction": "How to cancel a running balance",
    "output": "btrfs balance cancel /mnt/data"
  },
  {
    "instruction": "How to start a filtered balance on data only",
    "output": "btrfs balance start -d /mnt/data"
  },
  {
    "instruction": "How to balance metadata chunks only",
    "output": "btrfs balance start -m /mnt/data"
  },
  {
    "instruction": "How to show balance status",
    "output": "btrfs balance status /mnt/data"
  },
  {
    "instruction": "How to add a new device to a btrfs filesystem",
    "output": "btrfs device add /dev/sdb /mnt/data"
  },
  {
    "instruction": "How to remove a device from btrfs",
    "output": "btrfs device remove /dev/sdb /mnt/data"
  },
  {
