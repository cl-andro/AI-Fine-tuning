  },
  {
    "instruction": "How to convert an ext4 filesystem to btrfs",
    "output": "btrfs-convert /dev/sda1"
  },
  {
    "instruction": "How to check btrfs filesystem consistency",
    "output": "btrfs check /dev/sda1"
