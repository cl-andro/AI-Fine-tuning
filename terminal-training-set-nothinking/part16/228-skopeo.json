[
  {"instruction": "How to copy an image from Docker Hub to a private registry", "output": "skopeo copy docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to inspect an image on a remote registry", "output": "skopeo inspect docker://docker.io/library/alpine:latest"},
  {"instruction": "How to list all tags of a repository", "output": "skopeo list-tags docker://docker.io/library/nginx"},
  {"instruction": "How to copy an image from one tag to another on the same registry", "output": "skopeo copy docker://registry.example.com/myimage:v1 docker://registry.example.com/myimage:stable"},
  {"instruction": "How to copy an OCI image to a docker archive", "output": "skopeo copy docker://docker.io/library/alpine:latest docker-archive:alpine.tar"},
  {"instruction": "How to copy an image from a docker archive to a registry", "output": "skopeo copy docker-archive:alpine.tar docker://registry.example.com/alpine:latest"},
  {"instruction": "How to copy an image with all tags", "output": "skopeo copy --all docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to inspect an image with authentication", "output": "skopeo inspect --creds username:password docker://registry.example.com/private/image:latest"},
  {"instruction": "How to delete an image from a registry", "output": "skopeo delete docker://registry.example.com/myimage:old"},
  {"instruction": "How to sync all images from a directory to a registry", "output": "skopeo sync --src dir --dest docker /images/dir registry.example.com"},
  {"instruction": "How to sync all images from a registry to a directory", "output": "skopeo sync --src docker --dest dir registry.example.com /images/dir"},
  {"instruction": "How to copy an image without TLS verification", "output": "skopeo copy --src-tls-verify=false --dest-tls-verify=false docker://registry.internal/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to copy a multi-architecture image preserving all manifests", "output": "skopeo copy --multi-arch all docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to inspect raw manifest of an image", "output": "skopeo inspect --raw docker://docker.io/library/alpine:latest"},
  {"instruction": "How to get the image digest from a registry", "output": "skopeo inspect docker://docker.io/library/alpine:latest | jq -r '.Digest'"},
  {"instruction": "How to copy an image using a specific OS and architecture", "output": "skopeo copy --override-os linux --override-arch arm64 docker://docker.io/library/ubuntu:22.04 docker://registry.example.com/ubuntu:arm64"},
  {"instruction": "How to login to a container registry", "output": "skopeo login registry.example.com"},
  {"instruction": "How to logout from a container registry", "output": "skopeo logout registry.example.com"},
