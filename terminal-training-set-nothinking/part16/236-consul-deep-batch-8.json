[
  {"instruction": "How to generate a new root CA for Consul Connect", "output": "consul connect ca set-config -config='{\"provider\":\"consul\",\"config\":{\"PrivateKeyType\":\"ec\",\"PrivateKeyBits\":\"256\"}}'"},
  {"instruction": "How to rotate the Consul Connect CA", "output": "consul connect ca set-config -config='{\"provider\":\"consul\",\"config\":{\"RotationPeriod\":\"2160h\"}}'"},
  {"instruction": "How to make a Consul API request with curl", "output": "curl -H 'X-Consul-Token: my-token' http://127.0.0.1:8500/v1/agent/members"},
  {"instruction": "How to query the Consul agent self endpoint", "output": "curl http://127.0.0.1:8500/v1/agent/self"},
  {"instruction": "How to query the Consul agent health", "output": "curl http://127.0.0.1:8500/v1/agent/health/service:web"},
  {"instruction": "How to register a service via the Consul API", "output": "curl -X PUT -d '{\"Name\":\"web\",\"Port\":80}' http://127.0.0.1:8500/v1/agent/service/register"},
  {"instruction": "How to deregister a service via the Consul API", "output": "curl -X PUT http://127.0.0.1:8500/v1/agent/service/deregister/web-1"},
  {"instruction": "How to use Consul API to write a KV key", "output": "curl -X PUT -d 'my-value' http://127.0.0.1:8500/v1/kv/my-key"},
  {"instruction": "How to use Consul API to read a KV key", "output": "curl http://127.0.0.1:8500/v1/kv/my-key"},
  {"instruction": "How to use Consul API to delete a KV key", "output": "curl -X DELETE http://127.0.0.1:8500/v1/kv/my-key"},
  {"instruction": "How to create a Consul ACL token via API", "output": "curl -X PUT -d '{\"Policies\":[{\"Name\":\"my-policy\"}]}' http://127.0.0.1:8500/v1/acl/token"},
  {"instruction": "How to read a Consul ACL token via API", "output": "curl http://127.0.0.1:8500/v1/acl/token/abc123def"},
  {"instruction": "How to list all Consul ACL tokens via API", "output": "curl http://127.0.0.1:8500/v1/acl/tokens"},
  {"instruction": "How to create a Consul ACL policy via API", "output": "curl -X PUT -d '{\"Name\":\"my-policy\",\"Rules\":\"key \\\"\\\" { policy = \\\"read\\\" }\"}' http://127.0.0.1:8500/v1/acl/policy"},
  {"instruction": "How to query Consul service via API with filter", "output": "curl 'http://127.0.0.1:8500/v1/catalog/services?filter=Tags%20contains%20%22prod%22'"},
  {"instruction": "How to use Consul's health API for a specific service", "output": "curl http://127.0.0.1:8500/v1/health/service/web?passing=true"},
  {"instruction": "How to use Consul's health API with datacenter", "output": "curl http://127.0.0.1:8500/v1/health/service/web?dc=dc2"},
  {"instruction": "How to query Consul for all nodes with metadata", "output": "curl http://127.0.0.1:8500/v1/catalog/nodes"},
  {"instruction": "How to query Consul with a near parameter for closest node", "output": "curl 'http://127.0.0.1:8500/v1/health/service/web?near=_agent&passing=true'"},
  {"instruction": "How to use Consul status endpoint", "output": "curl http://127.0.0.1:8500/v1/status/leader"},
  {"instruction": "How to check the Consul Raft peers via API", "output": "curl http://127.0.0.1:8500/v1/operator/raft/list-peers"},
  {"instruction": "How to check the Consul autopilot config via API", "output": "curl http://127.0.0.1:8500/v1/operator/autopilot/configuration"},
  {"instruction": "How to query Consul connect intentions via API", "output": "curl http://127.0.0.1:8500/v1/connect/intentions"},
  {"instruction": "How to create a Consul connect intention via API", "output": "curl -X POST -d '{\"SourceName\":\"web\",\"DestinationName\":\"api\",\"Action\":\"allow\"}' http://127.0.0.1:8500/v1/connect/intentions"},
  {"instruction": "How to query the Consul namespace API", "output": "curl http://127.0.0.1:8500/v1/namespaces"}
