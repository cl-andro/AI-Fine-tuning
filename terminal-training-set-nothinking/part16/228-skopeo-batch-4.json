  {"instruction": "How to get the manifest of an image as JSON", "output": "skopeo inspect --raw docker://docker.io/library/alpine:latest | jq '.'"},
  {"instruction": "How to get the config blob of an image", "output": "skopeo inspect --config docker://docker.io/library/alpine:latest | jq '.'"}
