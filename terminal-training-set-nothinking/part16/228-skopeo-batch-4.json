[
  {"instruction": "How to copy an image with specific CPU architecture", "output": "skopeo copy --override-arch arm64 docker://docker.io/library/ubuntu:22.04 docker://registry.example.com/ubuntu:arm64"},
  {"instruction": "How to copy an image with specific OS variant", "output": "skopeo copy --override-variant v8 docker://docker.io/library/node:18 docker://registry.example.com/node:arm64v8"},
  {"instruction": "How to copy a manifest list preserving sub-manifests", "output": "skopeo copy --multi-arch all docker://docker.io/library/nginx:latest dir:nginx-manifests"},
  {"instruction": "How to copy only the current platform's manifest", "output": "skopeo copy docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to copy an image from a source requiring cert authentication", "output": "skopeo copy --src-cert-dir /etc/containers/certs docker://registry.source.com/image:latest docker://registry.dest.com/image:latest"},
  {"instruction": "How to copy an image with custom destination cert", "output": "skopeo copy --dest-cert-dir /etc/containers/certs docker://docker.io/library/nginx:latest docker://registry.dest.com/nginx:latest"},
  {"instruction": "How to copy an image with custom source key", "output": "skopeo copy --src-key /etc/containers/keys/source.key docker://registry.source.com/image:latest docker://registry.dest.com/image:latest"},
  {"instruction": "How to copy an image with custom destination key", "output": "skopeo copy --dest-key /etc/containers/keys/dest.key docker://docker.io/library/nginx:latest docker://registry.dest.com/nginx:latest"},
  {"instruction": "How to inspect an image on a registry behind a proxy", "output": "skopeo inspect --registry-token $(cat /var/run/secrets/kubernetes.io/serviceaccount/token) docker://registry.internal/image:latest"},
  {"instruction": "How to inspect an image with a custom user agent", "output": "skopeo inspect docker://docker.io/library/alpine:latest --user-agent myskopeo/1.0"},
  {"instruction": "How to copy an image from a registry using bearer token auth", "output": "skopeo copy --src-bearer-token $(cat /tmp/token) docker://registry.source.com/image:latest docker://registry.dest.com/image:latest"},
  {"instruction": "How to copy an image with destination bearer token auth", "output": "skopeo copy --dest-bearer-token $(cat /tmp/token) docker://docker.io/library/nginx:latest docker://registry.dest.com/nginx:latest"},
  {"instruction": "How to copy an image with source registry token", "output": "skopeo copy --src-registry-token TOKEN docker://registry.source.com/image:latest docker://registry.dest.com/image:latest"},
  {"instruction": "How to copy an image with destination registry token", "output": "skopeo copy --dest-registry-token TOKEN docker://docker.io/library/nginx:latest docker://registry.dest.com/nginx:latest"},
  {"instruction": "How to inspect an image and find the container config", "output": "skopeo inspect --config docker://docker.io/library/alpine:latest | jq '.config'"},
  {"instruction": "How to list tags using a specific OAuth2 token", "output": "skopeo list-tags --src-bearer-token $(cat /tmp/token) docker://registry.example.com/myapp"},
  {"instruction": "How to copy an image using S3 as source", "output": "skopeo copy s3://mybucket/images/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to copy an image to S3 as destination", "output": "skopeo copy docker://docker.io/library/nginx:latest s3://mybucket/images/nginx:latest"},
  {"instruction": "How to copy all tags from one repository to another using sync", "output": "skopeo sync --src docker --dest docker --keep-going registry.example.com/source registry.example.com/dest"},
  {"instruction": "How to copy with --override-os and --override-arch set to specific values", "output": "skopeo copy --override-os linux --override-arch s390x docker://docker.io/library/ubuntu:22.04 docker://registry.example.com/ubuntu:s390x"},
  {"instruction": "How to copy an image with no compression", "output": "skopeo copy --dest-compress=false docker://docker.io/library/alpine:latest docker://registry.example.com/alpine:latest"},
  {"instruction": "How to copy an image with zstd compression", "output": "skopeo copy --dest-compress-format zstd --dest-compress-level 3 docker://docker.io/library/alpine:latest docker://registry.example.com/alpine:latest"},
