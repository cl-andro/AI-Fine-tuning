[
  {"instruction": "How to list Flux ImagePolicy objects", "output": "flux get images policy"},
  {"instruction": "How to list Flux ImageUpdateAutomation objects", "output": "flux get images update"},
  {"instruction": "How to create a Flux ImageUpdateAutomation", "output": "flux create image update my-auto --git-repo=my-source --checkout-branch=main --push-branch=main --interval=30m --author-name=flux --author-email=flux@example.com"},
  {"instruction": "How to suspend a Flux ImageUpdateAutomation", "output": "flux suspend image update my-auto"},
  {"instruction": "How to resume a Flux ImageUpdateAutomation", "output": "flux resume image update my-auto"},
  {"instruction": "How to delete a Flux ImageUpdateAutomation", "output": "flux delete image update my-auto"},
  {"instruction": "How to create a Flux Alert", "output": "flux create alert my-alert --provider=my-provider --event-severity=info --event-source=Kustomization/my-kustomization"},
  {"instruction": "How to create a Flux Alert for all events", "output": "flux create alert my-alert --provider=my-provider --event-severity=info --event-source='*'"},
  {"instruction": "How to list Flux Alerts", "output": "flux get alerts"},
  {"instruction": "How to delete a Flux Alert", "output": "flux delete alert my-alert"},
  {"instruction": "How to create a Flux Provider for Slack", "output": "flux create alert-provider my-slack --type=slack --channel=flux-alerts --address=https://hooks.slack.com/services/T00/B00/xxxx"},
  {"instruction": "How to create a Flux Provider for Discord", "output": "flux create alert-provider my-discord --type=discord --address=https://discord.com/api/webhooks/xxxx"},
  {"instruction": "How to create a Flux Provider for OpsGenie", "output": "flux create alert-provider my-opsgenie --type=opsgenie --address=https://api.opsgenie.com/v2 --alert-labels='severity=critical'"},
  {"instruction": "How to list Flux Providers", "output": "flux get alert-providers"},
  {"instruction": "How to delete a Flux Provider", "output": "flux delete alert-provider my-provider"},
  {"instruction": "How to suspend and resume a Flux Kustomization", "output": "flux suspend kustomization my-kustomization"},
  {"instruction": "How to resume a Flux Kustomization", "output": "flux resume kustomization my-kustomization"},
  {"instruction": "How to export a Flux Kustomization as YAML", "output": "flux export kustomization my-kustomization > my-kustomization.yaml"},
  {"instruction": "How to export a Flux HelmRelease as YAML", "output": "flux export helmrelease my-release > my-release.yaml"},
  {"instruction": "How to export a Flux GitRepository as YAML", "output": "flux export source git my-source > my-source.yaml"},
  {"instruction": "How to create a Flux Kustomization with a post-build substitution", "output": "flux create kustomization my-kustomization --source=my-source --path=./k8s --prune=true --post-build='subst1:value1,subst2:value2' --interval=5m"},
  {"instruction": "How to create a Flux Kustomization with a depends on", "output": "flux create kustomization my-kustomization --source=my-source --path=./k8s --prune=true --depends-on=infra-kustomization --interval=5m"},
  {"instruction": "How to create a Flux Kustomization with a decryption provider", "output": "flux create kustomization my-kustomization --source=my-source --path=./k8s --prune=true --decryption-provider=sops --decryption-secret=sops-gpg --interval=5m"},
  {"instruction": "How to create a Flux Kustomization with a target namespace", "output": "flux create kustomization my-kustomization --source=my-source --path=./k8s --target-namespace=my-ns --interval=5m"},
