[
  {"instruction": "How to copy a single layer from an image", "output": "skopeo copy docker://docker.io/library/alpine:latest docker://registry.example.com/alpine:latest --max-layers 1"},
  {"instruction": "How to copy an image with a timeout per operation", "output": "skopeo copy --command-timeout 5m docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to copy an image with a retry delay", "output": "skopeo copy --retry-delay 10s docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to copy an image with specific blob info", "output": "skopeo copy --use-blob-info docker://docker.io/library/alpine:latest docker://registry.example.com/alpine:latest"},
  {"instruction": "How to copy an image with remove signatures", "output": "skopeo copy --remove-signatures docker://docker.io/library/alpine:latest docker://registry.example.com/alpine:latest"},
  {"instruction": "How to copy an image and verify signatures", "output": "skopeo copy --sign-passphrase-file /path/to/pass docker://docker.io/library/alpine:latest docker://registry.example.com/alpine:latest"},
  {"instruction": "How to generate a signature for an image", "output": "skopeo standalone-sign docker://registry.example.com/alpine:latest gpg-key-id /tmp/signature"},
  {"instruction": "How to verify an image signature", "output": "skopeo standalone-verify docker://registry.example.com/alpine:latest gpg-keyring /tmp/signature"},
  {"instruction": "How to delete a manifest list from a registry", "output": "skopeo delete docker://registry.example.com/mylist:latest"},
  {"instruction": "How to copy an image with the source from a container storage", "output": "skopeo copy containers-storage:myimage:latest docker://registry.example.com/myimage:latest"},
  {"instruction": "How to copy an image to container storage", "output": "skopeo copy docker://docker.io/library/nginx:latest containers-storage:nginx:latest"},
  {"instruction": "How to copy from a specific platform image in manifest list", "output": "skopeo copy --multi-arch auto docker://docker.io/library/nginx:latest docker://registry.example.com/nginx:latest"},
  {"instruction": "How to inspect a manifest list", "output": "skopeo inspect --raw docker://docker.io/library/nginx:latest | jq '.mediaType'"},
  {"instruction": "How to check if an image is a manifest list", "output": "skopeo inspect --raw docker://docker.io/library/nginx:latest | jq -r '.mediaType | contains(\"list\")'"},
