[
  {"instruction": "Generate a man page from a script with pod2man", "output": "pod2man --name=myutil --section=1 --center='Utils' --release=1.0 script.pod > myutil.1"},
  {"instruction": "Generate HTML from POD embedded in a Perl module", "output": "pod2html --infile=MyModule.pm --outfile=MyModule.html"},
  {"instruction": "Check POD syntax in a Perl module", "output": "podchecker MyModule.pm"},
  {"instruction": "Extract POD from a Perl script", "output": "podselect script.pl > extracted.pod"},
  {"instruction": "Create a literate programming document with Doxygen", "output": "doxygen -g && sed -i 's/EXTRACT_ALL *=.*/EXTRACT_ALL = YES/' Doxyfile"},
  {"instruction": "Set Doxyfile to generate only HTML and leave source browser enabled", "output": "sed -i 's/SOURCE_BROWSER *=.*/SOURCE_BROWSER = YES/; s/INLINE_SOURCES *=.*/INLINE_SOURCES = YES/' Doxyfile"},
  {"instruction": "Enable JavaScript index in Doxygen output", "output": "sed -i 's/GENERATE_TREEVIEW *=.*/GENERATE_TREEVIEW = YES/' Doxyfile"},
