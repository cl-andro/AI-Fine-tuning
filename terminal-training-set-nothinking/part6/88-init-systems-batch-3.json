  {"instruction": "Send restart to s6 service", "output": "s6-svc -r /service/myservice"},
  {"instruction": "Send hangup to s6 service", "output": "s6-svc -h /service/myservice"},
  {"instruction": "Send alarm to s6 service", "output": "s6-svc -a /service/myservice"},
  {"instruction": "Send interrupt to s6 service", "output": "s6-svc -i /service/myservice"},
  {"instruction": "Send terminate to s6 service", "output": "s6-svc -t /service/myservice"},
  {"instruction": "Send kill to s6 service", "output": "s6-svc -k /service/myservice"},
  {"instruction": "Send quit to s6 service", "output": "s6-svc -q /service/myservice"},
  {"instruction": "Check if s6 service is up", "output": "s6-svok /service/myservice"},
