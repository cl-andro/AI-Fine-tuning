[
  {"instruction": "List files in a Lustre filesystem", "output": "lfs ls /mnt/lustre"},
  {"instruction": "Check Lustre file striping", "output": "lfs getstripe /mnt/lustre/file"},
  {"instruction": "Set Lustre file striping to 4 OSTs", "output": "lfs setstripe -c 4 /mnt/lustre/newfile"},
  {"instruction": "Set Lustre stripe size to 4MB", "output": "lfs setstripe -S 4M /mnt/lustre/newdir"},
  {"instruction": "Show Lustre OST information", "output": "lfs osts"},
  {"instruction": "Show Lustre MDT information", "output": "lfs mdts"},
  {"instruction": "Check Lustre file path information", "output": "lfs path /mnt/lustre/file"},
  {"instruction": "Show Lustre disk usage for a directory", "output": "lfs df /mnt/lustre"},
  {"instruction": "Show Lustre disk usage per OST", "output": "lfs df -h /mnt/lustre"},
  {"instruction": "Find files by OST index in Lustre", "output": "lfs find --ost 0 /mnt/lustre"},
  {"instruction": "Find files by stripe count in Lustre", "output": "lfs find --stripe-count 2 /mnt/lustre"},
  {"instruction": "Check Lustre file layout in YAML", "output": "lfs getstripe -y /mnt/lustre/file"},
  {"instruction": "Check Lustre file layout in JSON", "output": "lfs getstripe --json /mnt/lustre/file"},
  {"instruction": "Set Lustre directory default stripe count", "output": "lfs setstripe -c 2 /mnt/lustre/newdir"},
  {"instruction": "Check Lustre version on a server", "output": "lctl version"},
  {"instruction": "Show Lustre configuration from lctl", "output": "lctl list_param *"},
  {"instruction": "Get Lustre debug logs", "output": "lctl dk"},
  {"instruction": "Clear Lustre debug logs", "output": "lctl clear"},
  {"instruction": "Set Lustre debug subsystem mask", "output": "lctl set_param debug=-1"},
  {"instruction": "Mark a time in Lustre debug logs", "output": "lctl mark 'my marker'"},
  {"instruction": "Show Lustre network configuration", "output": "lctl list_net"},
  {"instruction": "Mount a Lustre filesystem", "output": "mount -t lustre mgsnode@tcp0:/lustre /mnt/lustre"},
  {"instruction": "Mount Lustre with client tuning options", "output": "mount -t lustre -o user_xattr mgsnode@tcp0:/lustre /mnt/lustre"},
  {"instruction": "Format a Lustre MGT (Management Target)", "output": "mkfs.lustre --mgs --backfstype ldiskfs /dev/sdb"},
  {"instruction": "Format a Lustre MDT (Metadata Target)", "output": "mkfs.lustre --mdt --mgsnode=mgsnode@tcp0 --fsname=lustre --backfstype ldiskfs /dev/sdc"}
]
