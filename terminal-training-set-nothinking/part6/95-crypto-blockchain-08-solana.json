[
  {"instruction": "Get the current Solana CLI config", "output": "solana config get"},
  {"instruction": "Set the Solana CLI config URL to mainnet", "output": "solana config set --url https://api.mainnet-beta.solana.com"},
  {"instruction": "Set the Solana CLI config to devnet", "output": "solana config set --url https://api.devnet.solana.com"},
  {"instruction": "Set the Solana CLI to localhost validator", "output": "solana config set --url http://127.0.0.1:8899"},
  {"instruction": "Set the Solana keypair path", "output": "solana config set --keypair /home/user/.config/solana/id.json"},
  {"instruction": "Get the Solana wallet address", "output": "solana address"},
  {"instruction": "Check the SOL balance of the default wallet", "output": "solana balance"},
  {"instruction": "Check the SOL balance of a specific address", "output": "solana balance 7EcDhSYGxXyscszYEp35KHN8vvw3svAuREj1fJkWW2Cg"},
  {"instruction": "Request an airdrop of 2 SOL on devnet", "output": "solana airdrop 2"},
  {"instruction": "Airdrop SOL to a specific address on devnet", "output": "solana airdrop 1 7EcDhSYGxXyscszYEp35KHN8vvw3svAuREj1fJkWW2Cg --url https://api.devnet.solana.com"},
  {"instruction": "Transfer SOL to another address", "output": "solana transfer 7EcDhSYGxXyscszYEp35KHN8vvw3svAuREj1fJkWW2Cg 0.5 --allow-unfunded-recipient"},
  {"instruction": "Transfer SOL with a specific fee payer", "output": "solana transfer 7EcDhSYGxXyscszYEp35KHN8vvw3svAuREj1fJkWW2Cg 1.0 --fee-payer ~/.config/solana/id.json"},
  {"instruction": "Delegate stake to a validator", "output": "solana stake create-account --stake-amount 100 7EcDhSYGxXyscszYEp35KHN8vvw3svAuREj1fJkWW2Cg"},
  {"instruction": "Create a vote account", "output": "solana vote create-vote-account ~/validator-vote-keypair.json ~/validator-keypair.json ~/validator-withdrawer-keypair.json"},
  {"instruction": "Generate a new Solana keypair", "output": "solana-keygen new --outfile ~/.config/solana/new-wallet.json"},
  {"instruction": "Generate a keypair with a passphrase", "output": "solana-keygen new --outfile ~/.config/solana/secure.json --force"},
  {"instruction": "Deploy a Solana BPF program", "output": "solana deploy /home/user/projects/solana-program/target/deploy/my_program.so"},
  {"instruction": "Deploy a Solana program with upgrade authority", "output": "solana program deploy /home/user/programs/my_program.so --upgrade-authority ~/.config/solana/authority.json"},
  {"instruction": "Read a Solana program", "output": "solana program show --programs"},
  {"instruction": "Get the current Solana cluster version", "output": "solana cluster-version"},
  {"instruction": "Get the current Solana epoch info", "output": "solana epoch"},
  {"instruction": "Get a Solana block by slot", "output": "solana block 123456789"},
  {"instruction": "Get the current Solana slot", "output": "solana slot"},
  {"instruction": "Get the SOL supply information", "output": "solana supply"}
]
