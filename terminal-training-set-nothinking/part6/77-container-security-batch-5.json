[
  {"instruction": "Lint a Dockerfile with Hadolint", "output": "hadolint Dockerfile"},
  {"instruction": "Lint ignoring a specific rule", "output": "hadolint --ignore DL3000 Dockerfile"},
  {"instruction": "Lint with trusted registry only", "output": "hadolint --trusted-registry docker.io Dockerfile"},
  {"instruction": "Lint with no color output", "output": "hadolint --no-color Dockerfile"},
  {"instruction": "Lint output as TTY (default)", "output": "hadolint --format tty Dockerfile"},
  {"instruction": "Lint output as JSON", "output": "hadolint --format json Dockerfile"},
  {"instruction": "Lint output as Checkstyle", "output": "hadolint --format checkstyle Dockerfile"},
  {"instruction": "Lint with severity threshold", "output": "hadolint --failure-threshold error Dockerfile"},
  {"instruction": "Lint with custom rules file", "output": "hadolint --rules /path/to/hadolint.yaml Dockerfile"},
  {"instruction": "Lint with recursive find", "output": "find . -name Dockerfile -exec hadolint {} \\;"},
  {"instruction": "Lint ignoring multiple rules", "output": "hadolint --ignore DL3000 --ignore DL3008 Dockerfile"},
  {"instruction": "Lint with strict labels", "output": "hadolint --require-label maintainer Dockerfile"},
  {"instruction": "Check Hadolint version", "output": "hadolint --version"},
  {"instruction": "Lint a Dockerfile from stdin", "output": "cat Dockerfile | hadolint -"},
  {"instruction": "Lint with config file", "output": "hadolint --config /etc/hadolint/config.yaml Dockerfile"},
  {"instruction": "Lint multiple Dockerfiles and fail on errors", "output": "hadolint Dockerfile.prod Dockerfile.dev 2>&1"},
  {"instruction": "Lint and output only critical rules", "output": "hadolint --failure-threshold style Dockerfile"},
  {"instruction": "Lint with rule override severity", "output": "hadolint --override DL3000=warning Dockerfile"},
  {"instruction": "Lint with gitlab codeclimate output", "output": "hadolint --format codeclimate Dockerfile"},
  {"instruction": "Lint excluding a specific path", "output": "hadolint --no-color --ignore DL3000 --format json Dockerfile > results.json"}
]