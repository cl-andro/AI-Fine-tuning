[
  {"instruction": "Run bulk_extractor with all features", "output": "bulk_extractor -e all -o /output image.dd"},
  {"instruction": "Extract only email addresses", "output": "bulk_extractor -E email -o /output image.dd"},
  {"instruction": "Extract HTTP artifacts", "output": "bulk_extractor -E http -o /output image.dd"},
  {"instruction": "Extract network artifacts", "output": "bulk_extractor -E net -o /output image.dd"},
  {"instruction": "Extract EXIF metadata", "output": "bulk_extractor -E exif -o /output image.dd"},
  {"instruction": "Extract PDF artifacts", "output": "bulk_extractor -E pdf -o /output image.dd"},
  {"instruction": "Extract SQLite databases", "output": "bulk_extractor -E sqlite -o /output image.dd"},
  {"instruction": "Extract Windows PE files", "output": "bulk_extractor -E winpe -o /output image.dd"},
  {"instruction": "Extract base64 encoded data", "output": "bulk_extractor -E base64 -o /output image.dd"},
  {"instruction": "Extract AES encrypted data", "output": "bulk_extractor -E aes -o /output image.dd"},
  {"instruction": "Enable recursion into archives", "output": "bulk_extractor -R -e all -o /output image.dd"},
  {"instruction": "Scan using scanner file", "output": "bulk_extractor -S word_list.txt -o /output image.dd"},
  {"instruction": "Exclude specific scanners", "output": "bulk_extractor -x aes -x base64 -e all -o /output image.dd"},
  {"instruction": "Use custom output directory", "output": "bulk_extractor -e all -o /forensics/extracted image.dd"},
  {"instruction": "Enable parallel processing", "output": "bulk_extractor -e all -o /output -j 4 image.dd"},
  {"instruction": "Scan disk image with minimal features", "output": "bulk_extractor -e email -e http -e net -o /output image.dd"},
  {"instruction": "Process multiple images sequentially", "output": "bulk_extractor -e all -o /out1 image1.dd && bulk_extractor -e all -o /out2 image2.dd"},
  {"instruction": "Extract with custom context window", "output": "bulk_extractor -e all -o /output image.dd --context=500"},
  {"instruction": "Extract from EWF image file", "output": "bulk_extractor -e all -o /output image.E01"},
  {"instruction": "Extract only finder patterns from image", "output": "bulk_extractor -e all -o /output -M 100 image.dd"},
  {"instruction": "Run with max disk read size", "output": "bulk_extractor -e all -o /output -S max_read=1048576 image.dd"}
