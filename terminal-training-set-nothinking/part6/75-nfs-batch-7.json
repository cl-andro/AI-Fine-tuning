[
  {
    "instruction": "Show all NFS mount stats with version 4",
    "output": "mountstats -4 /mnt/nfs"
  },
  {
    "instruction": "Compare performance across NFS mounts",
    "output": "mountstats --list | awk '{print $1}' | xargs -I{} sh -c 'echo {}; mountstats {} | grep read:'"
  },
  {
    "instruction": "Show NFS mount bytes read/written",
    "output": "mountstats --nfs /mnt/nfs | grep bytes:"
  },
  {
    "instruction": "Check nfsd thread pool size",
    "output": "nfsconf --get nfsd threads"
  },
  {
    "instruction": "Set NFSD debug level",
    "output": "nfsconf --set nfsd debug 1"
  },
  {
    "instruction": "Get NFSD grace period",
    "output": "nfsconf --get nfsd grace-time"
  },
  {
    "instruction": "Enable NFSD lease",
    "output": "nfsconf --set nfsd lease-time 90"
  },
  {
    "instruction": "List NFS exports",
    "output": "showmount -e localhost"
  },
  {
    "instruction": "Kill stuck NFS mount",
    "output": "umount -f /mnt/nfs"
  },
  {
    "instruction": "Lazy unmount NFS share",
    "output": "umount -l /mnt/nfs"
  },
  {
    "instruction": "Remount NFS share",
    "output": "mount -o remount /mnt/nfs"
  },
  {
    "instruction": "Force NFS version 3 on mount",
    "output": "mount -t nfs -o nfsvers=3 server:/export /mnt/nfs"
  },
  {
    "instruction": "Mount NFS with Kerberos security",
    "output": "mount -t nfs -o sec=krb5 server:/export /mnt/nfs"
  },
  {
    "instruction": "Mount NFS with larger read/write buffers",
    "output": "mount -t nfs -o rsize=1048576,wsize=1048576 server:/export /mnt/nfs"
  },
  {
    "instruction": "Check NFS server status",
    "output": "systemctl status nfs-server"
  },
  {
    "instruction": "Restart NFS server",
    "output": "systemctl restart nfs-server"
  },
  {
    "instruction": "Check NFS connectivity",
    "output": "rpcinfo -p server"
  },
  {
    "instruction": "Check if portmap is listening",
    "output": "rpcinfo -p"
  },
  {
    "instruction": "Query NFS v4 capabilities",
    "output": "rpcinfo -s server nfs"
  },
  {
    "instruction": "Check NFS server mounts",
    "output": "cat /proc/fs/nfsd/pool_stats"
  },
  {
    "instruction": "Check kernel NFS client state",
    "output": "cat /proc/self/mountstats | grep nfs"
  },
  {
    "instruction": "Watch NFS operations in real time",
    "output": "nfsiostat 1"
  },
  {
    "instruction": "Repair NFS file permissions",
    "output": "nfs4_setfacl -s owner@:rwx::allow,group@:rx::allow /mnt/nfs/file"
  },
  {
    "instruction": "Get NFS ACL for a file",
    "output": "nfs4_getfacl /mnt/nfs/file"
  },
  {
    "instruction": "Trace NFS calls with ftrace",
    "output": "trace-cmd record -e nfs -e nfs4 -p function_graph"
  }
]