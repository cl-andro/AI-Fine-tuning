[
  {"instruction": "Create a new domain group", "output": "samba-tool group add 'IT Staff'"},
  {"instruction": "Delete a domain group", "output": "samba-tool group delete 'Old Group'"},
  {"instruction": "List all domain groups", "output": "samba-tool group list"},
  {"instruction": "List members of a group", "output": "samba-tool group listmembers 'Domain Admins'"},
  {"instruction": "Add a user to a group", "output": "samba-tool group addmembers 'IT Staff' jdoe,asmith"},
  {"instruction": "Remove a user from a group", "output": "samba-tool group removemembers 'IT Staff' jdoe"},
  {"instruction": "Create a group with specific OU", "output": "samba-tool group add 'Developers' --ou=OU=Groups,DC=example,DC=com"},
  {"instruction": "Add multiple members to group", "output": "samba-tool group addmembers 'ProjectX' user1,user2,user3 --member-type=user"},
  {"instruction": "Add a nested group", "output": "samba-tool group addmembers 'Admins' 'Domain Admins' --member-type=group"},
  {"instruction": "Create an OU", "output": "samba-tool ou create OU=Servers,DC=example,DC=com"},
  {"instruction": "List OUs in the domain", "output": "samba-tool ou list"},
  {"instruction": "Create an OU with description", "output": "samba-tool ou create OU=Contractors,DC=example,DC=com --description='External workers'"},
  {"instruction": "Create a computer account", "output": "samba-tool computer create 'WS-001'"},
  {"instruction": "Create a computer in specific OU", "output": "samba-tool computer create 'SRV-DB01' --ou=OU=Servers,DC=example,DC=com"},
  {"instruction": "List all computer accounts", "output": "samba-tool computer list"},
  {"instruction": "Delete a computer account", "output": "samba-tool computer delete 'WS-001'"},
  {"instruction": "Move a computer to another OU", "output": "samba-tool computer move 'SRV-DB01' 'OU=Databases,DC=example,DC=com'"},
  {"instruction": "List computers with specific OS", "output": "samba-tool computer list --os-name=Linux"},
  {"instruction": "Show group with specific type", "output": "samba-tool group list --group-type=security"},
  {"instruction": "Create a distribution group", "output": "samba-tool group add 'MailingList' --group-type=distribution"}
