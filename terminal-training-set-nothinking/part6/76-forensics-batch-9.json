[
  {"instruction": "Create an AFF image from raw disk", "output": "affconvert -o output.aff /dev/sdb"},
  {"instruction": "Convert raw image to AFF", "output": "affconvert -o evidence.aff image.dd"},
  {"instruction": "Convert AFF back to raw", "output": "affconvert -o image.dd evidence.aff"},
  {"instruction": "Print AFF image info/metadata", "output": "affinfo evidence.aff"},
  {"instruction": "Print AFF statistics", "output": "affstats evidence.aff"},
  {"instruction": "Verify AFF image integrity", "output": "affverify evidence.aff"},
  {"instruction": "List AFF segments", "output": "affsegment evidence.aff"},
  {"instruction": "Compress raw image to AFF", "output": "affconvert -z1 -o compressed.aff image.dd"},
  {"instruction": "Recompress AFF with higher compression", "output": "affconvert -z9 -o recompressed.aff evidence.aff"},
  {"instruction": "Copy AFF image to new file", "output": "affcopy evidence.aff evidence_copy.aff"},
  {"instruction": "Compare two AFF images", "output": "affcompare evidence1.aff evidence2.aff"},
  {"instruction": "Extract metadata from AFF", "output": "affcat evidence.aff > extracted.raw"},
  {"instruction": "Write metadata to AFF", "output": "affmeta -s evidence.aff 'case_number=CASE-001'"},
  {"instruction": "List all AFF metadata keys", "output": "affinfo -a evidence.aff"},
  {"instruction": "Encrypt AFF image with passphrase", "output": "affconvert -e -o encrypted.aff image.dd"},
  {"instruction": "Print AFF disk geometry info", "output": "affinfo -g evidence.aff"},
  {"instruction": "Convert between AFF versions", "output": "affconvert -v3 -o version3.aff evidence.aff"},
  {"instruction": "Copy raw to AFF with compression", "output": "affcopy -Z1 /dev/sdb evidence.aff"},
  {"instruction": "Summarize AFF image contents", "output": "affstats evidence.aff | head -20"},
  {"instruction": "Rebuild AFF from corrupted copy", "output": "affrecover -o recovered.aff damaged.aff"}
]