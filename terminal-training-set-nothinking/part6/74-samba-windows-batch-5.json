[
  {"instruction": "Register an SPN for a service account", "output": "samba-tool spn add 'HTTP/webserver.example.com' svc_web"},
  {"instruction": "List SPNs for an account", "output": "samba-tool spn list svc_web"},
  {"instruction": "Delete an SPN", "output": "samba-tool spn delete 'HTTP/webserver.example.com' svc_web"},
  {"instruction": "Resolve an SPN to an account", "output": "samba-tool spn resolve 'HTTP/webserver.example.com'"},
  {"instruction": "List all GPOs in the domain", "output": "samba-tool gpo list"},
  {"instruction": "List GPOs linked to an OU", "output": "samba-tool gpo list OU=Servers,DC=example,DC=com"},
  {"instruction": "Create a new GPO", "output": "samba-tool gpo create 'Security Policy'"},
  {"instruction": "Link a GPO to an OU", "output": "samba-tool gpo setlink OU=Servers,DC=example,DC=com '{GPO-GUID}'"},
  {"instruction": "Show FSMO role owners", "output": "samba-tool fsmo show"},
  {"instruction": "Transfer FSMO role", "output": "samba-tool fsmo transfer --role=rid --server=dc2.example.com"},
  {"instruction": "Seize FSMO role on DC failure", "output": "samba-tool fsmo seize --role=pdc --force"},
  {"instruction": "Create a DNS zone", "output": "samba-tool dns zonecreate 192.168.1.1 example.com -U administrator"},
  {"instruction": "Delete a DNS zone", "output": "samba-tool dns zonedelete 192.168.1.1 oldzone.local -U administrator"},
  {"instruction": "List DNS zones", "output": "samba-tool dns zonelist 192.168.1.1 -U administrator"},
  {"instruction": "Add a DNS A record", "output": "samba-tool dns add 192.168.1.1 example.com host1 A 10.0.0.1 -U administrator"},
  {"instruction": "Add a DNS CNAME record", "output": "samba-tool dns add 192.168.1.1 example.com www CNAME host1.example.com -U administrator"},
  {"instruction": "Delete a DNS record", "output": "samba-tool dns delete 192.168.1.1 example.com host1 A 10.0.0.1 -U administrator"},
  {"instruction": "Update a DNS record", "output": "samba-tool dns update 192.168.1.1 example.com host1 A 10.0.0.2 -U administrator"},
  {"instruction": "List delegation permissions", "output": "samba-tool delegation list"},
  {"instruction": "Set delegation for user", "output": "samba-tool delegation add 'jdoe' 'CN=Users,DC=example,DC=com' --delegation-type=all"}
]