[
  {"instruction": "Git-lfs migrate import with no refs", "output": "git lfs migrate import --everything --above=1MB"},
  {"instruction": "Git-lfs migrate info to see file size distribution", "output": "git lfs migrate info --everything --above=1MB"},
  {"instruction": "Git-lfs checkout files from pointer", "output": "git lfs checkout"},
  {"instruction": "Git-lfs update to fix hooks", "output": "git lfs update --force"},
  {"instruction": "Git-lfs track a file pattern globally", "output": "git lfs track '*.tar.gz' --lockable"},
  {"instruction": "Push git-lfs files from specific ref", "output": "git lfs push origin main --object-id HASH"},
  {"instruction": "Fetch git-lfs from a specific remote", "output": "git lfs fetch origin main"},
  {"instruction": "Git-lfs status showing unstaged pointers", "output": "git lfs status --porcelain"},
  {"instruction": "Git-lfs pointer object info", "output": "git lfs pointer --file=myfile.bin"},
  {"instruction": "Git-lfs logs show last transfer", "output": "git lfs logs last"},
  {"instruction": "Git-lfs logs boomtown for debugging", "output": "git lfs logs boomtown"},
  {"instruction": "Install git-lfs system-wide for all repos", "output": "git lfs install --system"},
  {"instruction": "Skip git-lfs smudge on checkout", "output": "GIT_LFS_SKIP_SMUDGE=1 git clone repo.git"},
  {"instruction": "Set git-lfs push batch size", "output": "git config lfs.concurrenttransfers 8"},
  {"instruction": "Set git-lfs transfer protocol version", "output": "git config lfs.transfer.maxretries 5"},
  {"instruction": "Unison with remote socket connection", "output": "unison /local ssh://user@host//remote/path -batch"},
  {"instruction": "Unison with specific SSH port", "output": "unison /local ssh://user@host:2222//remote/path -batch"},
  {"instruction": "Unison force preference to one side with conflict", "output": "unison myprofile -force /local/path"},
  {"instruction": "Unison merge script for three-way merge", "output": "unison myprofile -merge 'Name *.txt' /path/to/merge.sh"},
  {"instruction": "Unison diff for detecting changes", "output": "unison myprofile -diff 'diff -u' -terse"},
  {"instruction": "Lsyncd with a custom rsync binary", "output": "echo -e 'settings {\nrsync = \"/usr/bin/rsync\"\n}' > /etc/lsyncd/lsyncd.conf.lua"},
  {"instruction": "Lsyncd only sync on change events", "output": "echo -e 'settings {\ninotify = true\n}' >> /etc/lsyncd/lsyncd.conf.lua"},
  {"instruction": "Lsyncd with exclude list file", "output": "echo -e 'sync {\ndefault.rsync,\nsource = \"/src\",\ntarget = \"/dst\",\nexcludeFrom = \"/etc/lsyncd/exclude\"\n}' > /etc/lsyncd/lsyncd.conf.lua"},
  {"instruction": "Lsyncd using rsync+ssh with key", "output": "echo -e 'sync {\ndefault.rsyncssh,\nsource = \"/src\",\nhost = \"server\",\ntargetdir = \"/dst\",\nrsyncOpts = {\"-e\", \"ssh -i /root/.ssh/id_rsa\"}\n}' > /etc/lsyncd/lsyncd.conf.lua"},
  {"instruction": "Lsyncd dry run showing events", "output": "lsyncd -nodaemon -log all /etc/lsyncd/lsyncd.conf.lua"},
  {"instruction": "Lsyncd with status interval", "output": "echo -e 'settings {\nstatusInterval = 10\n}' >> /etc/lsyncd/lsyncd.conf.lua"}
]
