[
  {"instruction": "Validate smb.conf syntax", "output": "testparm"},
  {"instruction": "Validate smb.conf and show defaults", "output": "testparm -v"},
  {"instruction": "Validate smb.conf with suppressed prompt", "output": "testparm -s /etc/samba/smb.conf"},
  {"instruction": "Show parm options in verbose", "output": "testparm --parameter-name workgroup"},
  {"instruction": "Check smb.conf encoding", "output": "testparm --encoding"},
  {"instruction": "Show current Samba configuration", "output": "net conf list"},
  {"instruction": "Show a specific share config", "output": "net conf show data"},
  {"instruction": "Set a configuration option", "output": "net conf set global 'server min protocol' SMB2"},
  {"instruction": "Drop a configuration option", "output": "net conf drop global 'invalid users'"},
  {"instruction": "List all shares with their configs", "output": "net conf listshares"},
  {"instruction": "Import configuration from file", "output": "net conf import /path/to/smb.conf"},
  {"instruction": "Export configuration to file", "output": "net conf export /tmp/smb-backup.conf"},
  {"instruction": "List share permissions for a share", "output": "sharesec --view-share=data"},
  {"instruction": "Grant full access to share", "output": "sharesec --add=data:S-1-5-21-...-500:RWX"},
  {"instruction": "Revoke access from a share", "output": "sharesec --delete=data:S-1-5-21-...-500"},
  {"instruction": "Replace all share ACLs", "output": "sharesec --replace=data:S-1-5-21-...-512:RWX"},
  {"instruction": "Reload Samba configuration", "output": "smbcontrol smbd reload-config"},
  {"instruction": "Force Samba to log debug info", "output": "smbcontrol smbd debug 5"},
  {"instruction": "Shut down Samba gracefully", "output": "smbcontrol smbd shutdown"},
  {"instruction": "Print Samba process status", "output": "smbcontrol smbd ping"},
  {"instruction": "Notify all daemons to reload", "output": "smbcontrol all reload-config"},
  {"instruction": "Send custom message to nmbd", "output": "smbcontrol nmbd debug 3"}
]