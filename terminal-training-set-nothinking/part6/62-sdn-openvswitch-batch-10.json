[
  {
    "instruction": "Monitor OVS logs in real time",
    "output": "tail -f /var/log/openvswitch/ovs-vswitchd.log"
  },
  {
    "instruction": "Check OVS process health",
    "output": "systemctl status openvswitch-switch"
  },
  {
    "instruction": "Restart the OVS service",
    "output": "systemctl restart openvswitch-switch"
  },
  {
    "instruction": "Display OVS version",
    "output": "ovs-vsctl --version"
  },
  {
    "instruction": "Trace a packet through the pipeline",
    "output": "ovs-appctl ofproto/trace br0 'in_port=1,eth_src=00:00:00:00:00:01,eth_dst=00:00:00:00:00:02'"
  },
  {
    "instruction": "Check OVS memory map",
    "output": "ovs-appctl memory/show"
  },
  {
    "instruction": "List all OVS log files",
    "output": "ls -la /var/log/openvswitch/"
  },
  {
    "instruction": "Show interface error counters",
    "output": "ovs-vsctl get interface eth0 error"
  },
  {
    "instruction": "Dump multicast snooping table",
    "output": "ovs-appctl mdb/show br0"
  },
  {
    "instruction": "Check OVSDB server status",
    "output": "systemctl status ovsdb-server"
  },
  {
    "instruction": "Monitor OVS DB transactions",
    "output": "ovsdb-client monitor Open_vSwitch"
  },
  {
    "instruction": "Dump all ovsdb schema tables",
    "output": "ovsdb-client list-tables"
  },
  {
    "instruction": "Get all bridge statistics via JSON",
    "output": "ovsdb-client dump Open_vSwitch Bridge --format json"
  },
  {
    "instruction": "Check kernel module version",
    "output": "modinfo openvswitch"
  },
  {
    "instruction": "List OVS kernel module parameters",
    "output": "systool -vm openvswitch"
  },
  {
    "instruction": "Trace packet in table 0 with ct_state",
    "output": "ovs-appctl ofproto/trace br0 'in_port=1,ct_state=-trk,ip'"
  },
  {
    "instruction": "Monitor flow table changes with ovs-ofctl",
    "output": "ovs-ofctl monitor br0 --detach --pidfile=monitor.pid"
  },
  {
    "instruction": "Count total flows installed",
    "output": "ovs-ofctl dump-flows br0 | wc -l"
  },
  {
    "instruction": "Show OVS datapath cache hit ratio",
    "output": "ovs-dpctl show --statistics | grep -E '(hit|missed|lost)'"
  },
  {
    "instruction": "Check if eth0 has OF port number",
    "output": "ovs-vsctl get interface eth0 ofport"
  },
  {
    "instruction": "List all dpif backends and types",
    "output": "ovs-appctl dpif/list-dpif"
  },
  {
    "instruction": "Show the number of active ports",
    "output": "ovs-vsctl list-ports br0 | wc -l"
  }
]