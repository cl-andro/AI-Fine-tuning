[
  {"instruction": "Browse all SMB servers in network", "output": "smbtree"},
  {"instruction": "Browse SMB tree with guest auth", "output": "smbtree -N"},
  {"instruction": "Browse SMB tree with debug level 2", "output": "smbtree -d 2"},
  {"instruction": "Download a file via HTTP from SMB share", "output": "smbget smb://server/share/file.txt -U user"},
  {"instruction": "Download recursively with smbget", "output": "smbget -R smb://server/share/directory/ -U user"},
  {"instruction": "Resume a partial download", "output": "smbget -c smb://server/share/bigfile.iso -U user"},
  {"instruction": "Download using guest auth", "output": "smbget -a smb://server/share/public.txt"},
  {"instruction": "Set up Samba tape backup device", "output": "smbta-util add /dev/st0 my-tape"},
  {"instruction": "Remove tape backup device", "output": "smbta-util remove my-tape"},
  {"instruction": "List configured tape devices", "output": "smbta-util list"},
  {"instruction": "Find SMB servers on the network", "output": "findsmb"},
  {"instruction": "Find SMB servers with specific workgroup", "output": "findsmb -W WORKGROUP"},
  {"instruction": "Mount a CIFS share", "output": "mount.cifs //server/share /mnt/cifs -o user=jdoe,pass=password"},
  {"instruction": "Mount with vers=3.0 and credentials file", "output": "mount -t cifs //server/share /mnt/data -o credentials=/etc/smb-cred,vers=3.0"},
  {"instruction": "Mount with uid and gid mapping", "output": "mount.cifs //server/share /mnt/share -o user=jdoe,uid=1000,gid=1000"},
  {"instruction": "Mount with file mode and dir mode", "output": "mount -t cifs //server/share /mnt/win -o user=jdoe,file_mode=0644,dir_mode=0755"},
  {"instruction": "Mount with noexec and nosuid", "output": "mount -t cifs //server/share /mnt/secure -o user=jdoe,noexec,nosuid"},
  {"instruction": "Mount with SMB2 minimum protocol", "output": "mount -t cifs //server/share /mnt/backup -o user=jdoe,vers=2.0"},
  {"instruction": "Unmount a CIFS share", "output": "umount.cifs /mnt/cifs"},
  {"instruction": "Unmount all CIFS shares", "output": "umount -a -t cifs"},
  {"instruction": "Mount CIFS with domain credentials", "output": "mount.cifs //dc.example.com/dfsroot /mnt/dfs -o domain=EXAMPLE,user=jdoe,pass=secret"}
]