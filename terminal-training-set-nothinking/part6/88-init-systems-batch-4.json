[
  {"instruction": "Start Circus daemon with a watcher config", "output": "circusd /etc/circus.ini"},
  {"instruction": "Start Circus daemon in foreground", "output": "circusd --daemon false /etc/circus.ini"},
  {"instruction": "List Circus watchers", "output": "circusctl list"},
  {"instruction": "Get Circus status", "output": "circusctl status"},
  {"instruction": "Start a Circus watcher", "output": "circusctl start mywatcher"},
  {"instruction": "Stop a Circus watcher", "output": "circusctl stop mywatcher"},
  {"instruction": "Restart a Circus watcher", "output": "circusctl restart mywatcher"},
  {"instruction": "Show Circus watcher stats", "output": "circusctl stats mywatcher"},
  {"instruction": "Add a Circus watcher at runtime", "output": "circusctl add mywatcher \"cmd=python app.py numprocesses=4\""},
  {"instruction": "Remove a Circus watcher at runtime", "output": "circusctl rm mywatcher"},
  {"instruction": "Reload Circus configuration", "output": "circusctl reload"},
  {"instruction": "Shutdown Circus daemon", "output": "circusctl quit"},
  {"instruction": "Decrement Circus watcher processes", "output": "circusctl decr mywatcher 2"},
  {"instruction": "Increment Circus watcher processes", "output": "circusctl incr mywatcher 2"},
  {"instruction": "Show Circus watcher process tree", "output": "circus-top"},
  {"instruction": "Create a Circus watcher config entry", "output": "echo -e '[watcher:myapp]\ncmd = /usr/bin/python app.py\nnumprocesses = 4' >> /etc/circus.ini"},
  {"instruction": "Set Circus endpoint socket", "output": "echo -e '[circus]\nendpoint = tcp://127.0.0.1:5555' > /etc/circus.ini"},
  {"instruction": "Start Supervisor daemon", "output": "supervisord -c /etc/supervisor/supervisord.conf"},
  {"instruction": "Start Supervisor in foreground", "output": "supervisord -n -c /etc/supervisor/supervisord.conf"},
  {"instruction": "List Supervisor processes", "output": "supervisorctl status"},
  {"instruction": "Start a Supervisor process", "output": "supervisorctl start myprogram"},
  {"instruction": "Stop a Supervisor process", "output": "supervisorctl stop myprogram"},
  {"instruction": "Restart a Supervisor process", "output": "supervisorctl restart myprogram"},
  {"instruction": "Reload Supervisor configuration", "output": "supervisorctl reload"},
  {"instruction": "Reread Supervisor config changes", "output": "supervisorctl reread"},
  {"instruction": "Update Supervisor after config change", "output": "supervisorctl update"}
