[
  {"instruction": "Install systemd-boot (bootctl) to the EFI partition", "output": "bootctl install"},
  {"instruction": "Update all installed systemd-boot binaries", "output": "bootctl update"},
  {"instruction": "Show systemd-boot status", "output": "bootctl status"},
  {"instruction": "List all systemd-boot boot entries", "output": "bootctl list"},
  {"instruction": "Set the default systemd-boot entry", "output": "bootctl set-default @current"},
  {"instruction": "Set a one-time boot entry in systemd-boot", "output": "bootctl set-oneshot arch.conf"},
  {"instruction": "Create a systemd-boot entry file for Debian", "output": "cat > /boot/efi/loader/entries/debian.conf <<'EOF'\ntitle Debian GNU/Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions root=UUID=xxx rw quiet\nEOF"},
  {"instruction": "Set systemd-boot timeout to 5 seconds", "output": "echo 'timeout 5' >> /boot/efi/loader/loader.conf"},
  {"instruction": "Configure systemd-boot to show console mode", "output": "echo 'console-mode keep' >> /boot/efi/loader/loader.conf"},
  {"instruction": "Set systemd-boot editor to enabled", "output": "echo 'editor yes' >> /boot/efi/loader/loader.conf"},
  {"instruction": "Show systemd-boot random seed status", "output": "bootctl random-seed"},
  {"instruction": "Install systemd-boot to a specific ESP", "output": "bootctl install --esp-path=/boot"},
  {"instruction": "Remove old systemd-boot entries automatically", "output": "bootctl cleanup"},
  {"instruction": "Add a splash screen bitmap for systemd-boot", "output": "cp splash.bmp /boot/efi/loader/splash.bmp"},
  {"instruction": "Set systemd-boot to auto-archieve the last good entry", "output": "bootctl set-oneshot --no-reboot @saved"},
  {"instruction": "Enable systemd-boot to show a reboot-into-firmware entry", "output": "echo 'auto-firmware yes' >> /boot/efi/loader/loader.conf"},
  {"instruction": "List available systemd-boot entry tokens", "output": "bootctl list --json=pretty"},
  {"instruction": "Check systemd-boot version", "output": "bootctl --version"},
  {"instruction": "Install systemd-boot with all tools", "output": "bootctl install --make-entry-directory=yes"},
  {"instruction": "Set systemd-boot default entry by machine ID", "output": "bootctl set-default @current"},
  {"instruction": "Reload systemd-boot configuration without reboot", "output": "bootctl set-oneshot @default"}
]
