[
  {"instruction": "Vim: convert markdown to HTML using built-in", "output": "vim -c 'TOhtml | wqa' /home/user/doc.md"},
  {"instruction": "Vim: paste from system clipboard without auto-indent", "output": "vim -c 'set pastetoggle=<F2>' -c 'startinsert' /home/user/file.txt"},
  {"instruction": "Vim: open with minimal UI (no toolbar/menus)", "output": "vim -c 'set guioptions-=m guioptions-=T' /home/user/file.txt"},
  {"instruction": "Vim: run syntax check with external tool", "output": "vim -c '!python3 -m py_compile %' /home/user/file.py"},
  {"instruction": "Vim: view buffer list", "output": "vim -c 'ls' -c 'q'"},
  {"instruction": "Vim: edit file in a new tab", "output": "vim --cmd 'tabnew /home/user/file.txt'"},
  {"instruction": "Vim: close all but current buffer", "output": "vim -c 'on' /home/user/file.txt"},
  {"instruction": "Vim: highlight all search matches", "output": "vim -c 'set hls' -c '/pattern' /home/user/file.txt"},
  {"instruction": "Vim: recursively find and replace in all files", "output": "vim -c 'set autowrite' -c 'argdo %s/foo/bar/ge | update' **/*.txt -c 'qa'"},
  {"instruction": "Vim: check file encoding", "output": "vim -c 'set fileencoding? | q' /home/user/file.txt"},
  {"instruction": "Vim: manually set file encoding and save as UTF-8", "output": "vim -c 'set fileencoding=utf-8 | wq' /home/user/file.txt"},
  {"instruction": "Vim: open file in Vim and pipe line range to command", "output": "vim -c '10,20!column -t' -c 'wq' /home/user/data.tsv"},
  {"instruction": "Vim: markdown table formatting", "output": "vim -c '%!pandoc -t gfm --wrap=none' -c 'wq' /home/user/doc.md"},
  {"instruction": "Vim: convert file to Unix line endings", "output": "vim -c 'set fileformat=unix | wq' /home/user/file.txt"},
  {"instruction": "Vim: convert file to DOS line endings", "output": "vim -c 'set fileformat=dos | wq' /home/user/file.txt"},
  {"instruction": "Neovim: run Lua script to modify a file and save", "output": "nvim --headless -c 'lua vim.api.nvim_buf_set_lines(0, 0, -1, false, {\"new content\"})' +wq /home/user/file.txt"},
  {"instruction": "Neovim: use Lua to format JSON buffer", "output": "nvim --headless -c 'lua vim.fn.json_decode(vim.fn.getline(1, \"$\"))' +q /home/user/data.json"},
  {"instruction": "Neovim: install plugin in headless mode", "output": "nvim --headless +'Lazy install' +q"},
  {"instruction": "Neovim: run LSP code action via CLI", "output": "nvim --headless -c 'lua vim.lsp.buf.code_action()' -c 'wq' /home/user/file.py"},
  {"instruction": "Neovim: update plugins via CLI", "output": "nvim --headless +'Lazy update' +q"},
  {"instruction": "Emacs batch: batch rename function", "output": "emacs --batch --eval '(dired (expand-file-name \"/home/user/files\"))' --eval '(dired-do-rename)'"},
  {"instruction": "emacsclient: suppress frame creation", "output": "emacsclient -c --suppress-output /home/user/file.txt"},
  {"instruction": "emacsclient: kill emacs server", "output": "emacsclient -e '(kill-emacs)'"},
  {"instruction": "emacsclient: eval in specific buffer", "output": "emacsclient -e '(with-current-buffer \"file.txt\" (buffer-size))'"},
  {"instruction": "emacs --batch: run org-babel tangle", "output": "emacs --batch --visit /home/user/config.org --funcall org-babel-tangle"}
