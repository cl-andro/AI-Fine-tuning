[
  {
    "instruction": "Set power save off on wlan0",
    "output": "iw dev wlan0 set power_save off"
  },
  {
    "instruction": "Set power save on on wlan0",
    "output": "iw dev wlan0 set power_save on"
  },
  {
    "instruction": "Set wlan0 to 4addr mode (WDS)",
    "output": "iw dev wlan0 set 4addr on"
  },
  {
    "instruction": "Set wlan0 to station mode",
    "output": "iw dev wlan0 set type station"
  },
  {
    "instruction": "Set wlan0 MAC address",
    "output": "ip link set dev wlan0 address 00:11:22:33:44:55"
  },
  {
    "instruction": "Set the MTU on wlan0",
    "output": "ip link set dev wlan0 mtu 1500"
  },
  {
    "instruction": "Set wlan0 frequency to 5180 MHz",
    "output": "iw dev wlan0 set freq 5180"
  },
  {
    "instruction": "Set wlan0 bitrate fixed to 54 Mbps",
    "output": "iw dev wlan0 set bitrates legacy-2.4 54"
  },
  {
    "instruction": "Set wlan0 retry limits",
    "output": "iw dev wlan0 set retry short 7 long 4"
  },
  {
    "instruction": "Mark wlan0 as mesh point",
    "output": "iw dev wlan0 set type mp"
  },
  {
    "instruction": "Create a monitor interface on wlan0",
    "output": "iw dev wlan0 interface add mon0 type monitor"
  },
  {
    "instruction": "Delete a virtual interface",
    "output": "iw dev mon0 del"
  },
  {
    "instruction": "Create a WDS interface",
    "output": "iw dev wlan0 interface add wds0 type wds"
  },
  {
    "instruction": "Show all wpa_supplicant interfaces",
    "output": "wpa_cli -i wlan0 interface"
  },
  {
    "instruction": "Set WPA passphrase for network 0",
    "output": "wpa_cli set_network 0 psk '\"P@ssw0rd!\"'"
  },
  {
    "instruction": "Set network 0 key management",
    "output": "wpa_cli set_network 0 key_mgmt WPA-PSK"
  },
  {
    "instruction": "Set network 0 EAP method",
    "output": "wpa_cli set_network 0 eap PEAP"
  },
  {
    "instruction": "Set network 0 identity for EAP",
    "output": "wpa_cli set_network 0 identity '\"user@domain.com\"'"
  },
  {
    "instruction": "Set network 0 password for EAP",
    "output": "wpa_cli set_network 0 password '\"myPassword\"'"
  },
  {
    "instruction": "Set network 0 phase2 auth",
    "output": "wpa_cli set_network 0 phase2 'auth=MSCHAPV2'"
