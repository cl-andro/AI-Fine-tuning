[
  {"instruction": "Show current NFSv4 delegation type", "output": "cat /sys/module/nfs/parameters/delegation"},
  {"instruction": "Enable NFSv4 read delegations", "output": "echo 1 > /sys/module/nfsd/parameters/lease_time"},
  {"instruction": "Check delegation timeouts", "output": "nfs4_delegation --check"},
  {"instruction": "Show all NFSv4 delegations on server", "output": "cat /proc/fs/nfsd/delegations"},
  {"instruction": "Force recall of all delegations", "output": "exportfs -f"},
  {"instruction": "Start sm-notify (NFS reboot notification)", "output": "sm-notify"},
  {"instruction": "Start sm-notify with debug", "output": "sm-notify -d"},
  {"instruction": "Start sm-notify as background daemon", "output": "sm-notify -b"},
  {"instruction": "Start NFS statd (status monitor)", "output": "statd"},
  {"instruction": "Start statd with verbose", "output": "statd -d"},
  {"instruction": "Statd with specific port", "output": "statd -p 5000"},
  {"instruction": "Statd with specific state directory", "output": "statd -n /var/lib/nfs/sm"},
  {"instruction": "Check if statd is running", "output": "rpcinfo -p localhost | grep status"},
  {"instruction": "Query statd state from remote", "output": "rpcinfo -t remote-server statd"},
  {"instruction": "Start statd in foreground", "output": "statd -F"},
  {"instruction": "List statd known clients", "output": "ls -la /var/lib/nfs/sm/"},
  {"instruction": "Remove stale statd entries", "output": "rm -f /var/lib/nfs/sm/*"},
  {"instruction": "Check NFSv4 lease time", "output": "cat /proc/fs/nfsd/nfsv4leasetime"},
  {"instruction": "Set NFSv4 lease time to 90 seconds", "output": "echo 90 > /proc/fs/nfsd/nfsv4leasetime"},
  {"instruction": "Restart NFS server services sequentially", "output": "systemctl restart nfs-server && systemctl restart nfs-kernel-server"},
  {"instruction": "Check if NFS notifications are working", "output": "rpcinfo -t localhost nfs 4 2>/dev/null && echo NFSv4 OK"}
]