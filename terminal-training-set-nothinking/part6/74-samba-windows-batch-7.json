[
  {"instruction": "List domain users via winbind", "output": "wbinfo -u"},
  {"instruction": "List domain groups via winbind", "output": "wbinfo -g"},
  {"instruction": "Convert SID to name", "output": "wbinfo -s S-1-5-21-123456789-1234567890-123456789-500"},
  {"instruction": "Convert name to SID", "output": "wbinfo -n 'EXAMPLE\\\\jdoe'"},
  {"instruction": "Convert SID to Unix user", "output": "wbinfo -U S-1-5-21-...-500"},
  {"instruction": "Get user info by SID", "output": "wbinfo -i S-1-5-21-...-500"},
  {"instruction": "Get user groups from winbind", "output": "wbinfo -r jdoe"},
  {"instruction": "Check winbind connectivity", "output": "wbinfo -p"},
  {"instruction": "Test winbind trust relationship", "output": "wbinfo -t"},
  {"instruction": "Check if user is in a group", "output": "wbinfo -a 'EXAMPLE\\\\jdoe'%'password'"},
  {"instruction": "List all domain users verbose", "output": "wbinfo --domain-users --verbose"},
  {"instruction": "List all domain groups verbose", "output": "wbinfo --domain-groups --verbose"},
  {"instruction": "Get sequence number", "output": "wbinfo --sequence"},
  {"instruction": "Check winbindd process status", "output": "wbinfo --ping-dc"},
  {"instruction": "List domain groups for a specific domain", "output": "wbinfo -g --domain=EXAMPLE"},
  {"instruction": "Get user's display name", "output": "wbinfo --name-to-sid 'EXAMPLE\\\\jdoe'"},
  {"instruction": "Get SID for local group", "output": "wbinfo -n 'EXAMPLE\\\\Domain Admins'"},
  {"instruction": "Check all trust secrets", "output": "wbinfo --check-secret"},
  {"instruction": "Reset winbind offline status", "output": "wbinfo --online-status"},
  {"instruction": "List members of a domain group", "output": "wbinfo --group-members S-1-5-21-...-512"},
  {"instruction": "Convert multiple SIDs to names", "output": "wbinfo -s S-1-5-21-...-500 S-1-5-21-...-502"},
  {"instruction": "Show winbind cache statistics", "output": "wbinfo --cache-stats"}
]