[
  {
    "instruction": "Show help for saved_model_cli",
    "output": "saved_model_cli --help"
  },
  {
    "instruction": "Show the saved model tag set",
    "output": "saved_model_cli show --dir /tmp/model --all"
  },
  {
    "instruction": "Show model signature definition",
    "output": "saved_model_cli show --dir /tmp/model --tag_set serve --signature_def serving_default"
  },
  {
    "instruction": "Run inference with saved_model_cli",
    "output": "saved_model_cli run --dir /tmp/model --tag_set serve --signature_def serving_default --input_exprs 'input:0=[[1.0]]'"
  },
  {
    "instruction": "List all tag sets in a model",
    "output": "saved_model_cli show --dir /tmp/model --tag_set"
  },
  {
    "instruction": "Convert Keras model to TF Lite",
    "output": "tflite_convert --saved_model_dir /tmp/model --output_file /tmp/model.tflite"
  },
  {
    "instruction": "Convert TF model to TFLite with int8 quantization",
    "output": "tflite_convert --saved_model_dir /tmp/model --output_file /tmp/model_quant.tflite --inference_type QUINT8"
  },
  {
    "instruction": "Start TensorBoard with a logdir",
