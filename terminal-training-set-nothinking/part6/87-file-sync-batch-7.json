  {"instruction": "Rclone bisync (bidirectional sync)", "output": "rclone bisync /local remote:backup --resync"},
  {"instruction": "Rclone move (transfer and delete source)", "output": "rclone move /local remote:backup"},
  {"instruction": "Rclone copy new/changed files only", "output": "rclone copy /local remote:backup --ignore-existing"},
  {"instruction": "Rclone sync with max-age filter", "output": "rclone sync /local remote:backup --max-age 7d"},
  {"instruction": "Rclone sync with min-size filter", "output": "rclone sync /local remote:backup --min-size 1M"},
  {"instruction": "Rclone sync with max-size filter", "output": "rclone sync /local remote:backup --max-size 100M"},
  {"instruction": "Rclone sync preserving timestamps", "output": "rclone sync /local remote:backup --times"},
