[
  {"instruction": "Configure the Stellar CLI to the testnet", "output": "stellar config --endpoint https://horizon-testnet.stellar.org"},
  {"instruction": "Configure Stellar CLI for mainnet", "output": "stellar config --endpoint https://horizon.stellar.org"},
  {"instruction": "Generate a new Stellar keypair", "output": "stellar keypair generate"},
