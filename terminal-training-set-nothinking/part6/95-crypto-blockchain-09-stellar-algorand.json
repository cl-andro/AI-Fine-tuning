  {"instruction": "Create a Stellar trustline for USDC", "output": "stellar change-trust --asset USDC:GDQERNWOYW4Y3U6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7 --source-account my_secret_key"},
  {"instruction": "Manage Stellar offers on the DEX", "output": "stellar manage-offer --selling XLM --buying USDC:GDQERNWOYW4Y3U6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7 --amount 100 --price 0.5 --source-account my_secret_key"},
  {"instruction": "Create a new Stellar account using friendbot on testnet", "output": "curl \"https://friendbot.stellar.org?addr=GDQERNWOYW4Y3U6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7\""},
  {"instruction": "Deploy an Algorand smart contract (TEAL)", "output": "goal app create --creator XSAT6XG6K6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V6V --approval-prog /home/algo/approval.teal --clear-prog /home/algo/clear.teal --global-byteslices 64 --global-ints 64 --local-byteslices 8 --local-ints 8 -d /home/algorand/data"},
