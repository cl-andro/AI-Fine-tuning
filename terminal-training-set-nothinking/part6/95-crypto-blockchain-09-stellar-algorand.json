  {"instruction": "Check the Stellar account balance", "output": "stellar balances --account GDQERNWOYW4Y3U6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7"},
  {"instruction": "Send a Stellar payment to an address", "output": "stellar pay --destination GDQERNWOYW4Y3U6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7UQ6U7 --amount 100 XLM --source-account my_secret_key"},
  {"instruction": "Start the Algorand goal daemon", "output": "goal daemon -d /home/algorand/data"},
