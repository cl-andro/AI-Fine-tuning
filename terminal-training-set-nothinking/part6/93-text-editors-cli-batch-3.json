[
  {"instruction": "Sed: substitute only on lines matching pattern", "output": "sed '/^foo/s/bar/baz/g' /home/user/file.txt"},
  {"instruction": "Sed: insert line before match", "output": "sed '/pattern/i\\This is a new line' /home/user/file.txt"},
  {"instruction": "Sed: append line after match", "output": "sed '/pattern/a\\This follows the match' /home/user/file.txt"},
  {"instruction": "Sed: delete empty lines", "output": "sed -i '/^$/d' /home/user/file.txt"},
  {"instruction": "Sed: replace tabs with spaces", "output": "sed -i 's/\\t/    /g' /home/user/file.txt"},
  {"instruction": "Awk: filter by column value", "output": "awk '$3 > 100 {print $0}' /home/user/metrics.log"},
  {"instruction": "Awk: sum a column", "output": "awk '{sum += $2} END {print sum}' /home/user/numbers.txt"},
  {"instruction": "Awk: count lines matching pattern", "output": "awk '/error/ {count++} END {print count}' /home/user/log.txt"},
  {"instruction": "Awk: print with formatted output", "output": "awk '{printf \"%-20s %5d\\n\", $1, $2}' /home/user/data.txt"},
  {"instruction": "Awk: use custom field separator", "output": "awk -F ':' '{print $1, $6}' /etc/passwd"},
  {"instruction": "Ed (line editor): print line range", "output": "printf '%s\\n' '1,10p' q | ed /home/user/file.txt"},
  {"instruction": "Ed: substitute text", "output": "printf '%s\\n' ',s/old/new/g' w q | ed /home/user/file.txt"},
  {"instruction": "Ed: insert text at beginning", "output": "printf '%s\\n' '0a' 'New first line' '.' w q | ed /home/user/file.txt"},
  {"instruction": "Ed: delete lines 5-10", "output": "printf '%s\\n' '5,10d' w q | ed /home/user/file.txt"},
  {"instruction": "Ed: move line 10 to end of file", "output": "printf '%s\\n' '10m$' w q | ed /home/user/file.txt"},
  {"instruction": "Ed: copy line 5 to line 20", "output": "printf '%s\\n' '5t20' w q | ed /home/user/file.txt"},
  {"instruction": "Ed: join lines 3-5", "output": "printf '%s\\n' '3,5j' w q | ed /home/user/file.txt"},
  {"instruction": "Ed: global replace with confirmation", "output": "printf '%s\\n' 'g/old/ s//new/g' w q | ed /home/user/file.txt"},
