[
  {
    "instruction": "List private ioctl for wlan0",
    "output": "iwpriv wlan0"
  },
  {
    "instruction": "Set wlan0 private parameter",
    "output": "iwpriv wlan0 setMiracast=1"
  },
  {
    "instruction": "Enable 5GHz band (private)",
    "output": "iwpriv wlan0 setBand 5G"
  },
  {
    "instruction": "Set beacon interval via iwpriv",
    "output": "iwpriv wlan0 setBeaconInterval=100"
  },
  {
    "instruction": "Enable AMPDU aggregation",
    "output": "iwpriv wlan0 setAMPDU=1"
  },
  {
    "instruction": "Start hostapd with default config",
    "output": "hostapd /etc/hostapd/hostapd.conf"
  },
  {
    "instruction": "Start hostapd in debug mode",
    "output": "hostapd -d /etc/hostapd/hostapd.conf"
  },
  {
    "instruction": "Start hostapd with very verbose debug",
    "output": "hostapd -dd /etc/hostapd/hostapd.conf"
  },
  {
    "instruction": "Start hostapd in background",
    "output": "hostapd -B /etc/hostapd/hostapd.conf"
  },
  {
    "instruction": "Start hostapd with a PID file",
    "output": "hostapd -P /var/run/hostapd.pid /etc/hostapd/hostapd.conf"
  },
  {
    "instruction": "Start hostapd with timestamps",
    "output": "hostapd -t /etc/hostapd/hostapd.conf"
  },
  {
    "instruction": "Reload hostapd configuration",
    "output": "kill -HUP $(cat /var/run/hostapd.pid)"
  },
  {
    "instruction": "Check hostapd status",
    "output": "systemctl status hostapd"
  },
  {
    "instruction": "Enable hostapd on boot",
    "output": "systemctl enable hostapd"
  },
  {
    "instruction": "Test hostapd config for syntax errors",
    "output": "hostapd -d /etc/hostapd/hostapd.conf 2>&1 | head -20"
  },
  {
    "instruction": "Write a minimal hostapd config file",
    "output": "cat > /etc/hostapd/hostapd.conf << 'EOF'\ninterface=wlan0\ndriver=nl80211\nssid=MyAP\nhw_mode=g\nchannel=6\nwpa=2\nwpa_passphrase=secret123\nwpa_key_mgmt=WPA-PSK\nEOF"
  },
  {
    "instruction": "Start hostapd with WPA3 config",
    "output": "hostapd -B /etc/hostapd/hostapd-wpa3.conf"
  },
  {
    "instruction": "Stop hostapd gracefully",
    "output": "kill $(cat /var/run/hostapd.pid)"
  },
  {
    "instruction": "Show connected clients via hostapd",
    "output": "hostapd_cli all_sta"
  },
  {
    "instruction": "Use hostapd_cli to deauth a client",
    "output": "hostapd_cli deauthenticate 00:11:22:33:44:55"
  },
  {
    "instruction": "Use hostapd_cli to list stations",
    "output": "hostapd_cli list_sta"
  },
  {
