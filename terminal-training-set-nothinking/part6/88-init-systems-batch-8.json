[
  {
    "instruction": "Add a service to OpenRC non-default runlevel",
    "output": "rc-update add apache2 sysinit"
  },
  {
    "instruction": "Start OpenRC service with specific config file",
    "output": "rc-service -f /etc/conf.d/myapp myapp start"
  },
  {
    "instruction": "Check OpenRC service dependencies",
    "output": "rc-update -v show"
  },
  {
    "instruction": "OpenRC parallel startup setting",
    "output": "echo 'rc_parallel=YES' >> /etc/rc.conf"
  },
  {
    "instruction": "Create a supervice directory for daemontools",
    "output": "mkdir -p /service/myservice/log"
  },
  {
    "instruction": "Set daemontools supervise timeout",
    "output": "svc -t 30 /service/myservice"
  },
  {
    "instruction": "Check if supervise is running on a directory",
    "output": "supervise /service/myservice &"
  },
  {
    "instruction": "Run multilog with timestamp and rotation",
    "output": "multilog t s1000000 n10 /var/log/myservice"
  },
  {
    "instruction": "Set multilog processing script",
    "output": "multilog t ./main '|/usr/local/bin/processor'"
  },
  {
    "instruction": "Use tai64nlocal to convert current log timestamp",
    "output": "cat /var/log/myservice/current | tai64nlocal"
  },
  {
    "instruction": "Run a command under envdir with custom env",
    "output": "echo 'DATABASE_URL=postgres://localhost' > /etc/myapp/env/DATABASE_URL && envdir /etc/myapp/env myapp"
  },
  {
    "instruction": "Limit memory with softlimit",
    "output": "softlimit -m 1000000 mycommand"
  },
  {
    "instruction": "Limit open files with softlimit",
    "output": "softlimit -o 100 mycommand"
  },
  {
    "instruction": "Limit data segment with softlimit",
    "output": "softlimit -d 500000 mycommand"
  },
  {
    "instruction": "Set daemontools cdb conf via cvm",
    "output": "cvm qmail /etc/cvm/users"
  },
  {
    "instruction": "Create a daemontools log/run script",
    "output": "echo -e '"
  },
  {
    "instruction": "Check supervisorctl availability",
    "output": "supervisorctl avail"
  },
  {
    "instruction": "Set Supervisor minfds for child processes",
    "output": "echo 'minfds=1024' >> /etc/supervisor/supervisord.conf"
  },
  {
    "instruction": "Set Supervisor minprocs for child processes",
    "output": "echo 'minprocs=200' >> /etc/supervisor/supervisord.conf"
  },
  {
    "instruction": "Set Supervisor HTTP server credentials",
    "output": "echo -e '[inet_http_server]\nport=127.0.0.1:9001\nusername=admin\npassword=secret' >> /etc/supervisor/supervisord.conf"
  },
  {
    "instruction": "Set Supervisor unix socket path",
    "output": "echo -e '[unix_http_server]\nfile=/var/run/supervisor.sock' >> /etc/supervisor/supervisord.conf"
  },
  {
    "instruction": "Configure Supervisor child process log directory",
    "output": "echo 'childlogdir=/var/log/supervisor' >> /etc/supervisor/supervisord.conf"
  },
  {
    "instruction": "Set Supervisor serverurl for remote control",
    "output": "echo 'serverurl=http://127.0.0.1:9001' >> /etc/supervisor/supervisord.conf"
  },
  {
    "instruction": "Create a Superlance crash mail config",
    "output": "echo -e '[eventlistener:crashmail]\ncommand=crashmail -p 1 -m admin@example.com' >> /etc/supervisor/conf.d/crashmail.conf"
  },
  {
    "instruction": "Check Supervisor PID file location",
    "output": "supervisorctl pid"
  },
  {
    "instruction": "Show supervisorctl version",
    "output": "supervisorctl version"
  }
]