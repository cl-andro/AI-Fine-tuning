  {"instruction": "Enable an existing git-annex remote", "output": "git annex enableremote myremote"},
  {"instruction": "Sync git-annex with all remotes", "output": "git annex sync"},
  {"instruction": "Sync git-annex with content transfer", "output": "git annex sync --content"},
  {"instruction": "Track a file with git-lfs", "output": "git lfs track '*.psd'"},
  {"instruction": "List git-lfs tracked patterns", "output": "git lfs track"},
  {"instruction": "List files tracked by git-lfs", "output": "git lfs ls-files"},
