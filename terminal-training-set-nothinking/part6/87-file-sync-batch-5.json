  {"instruction": "Unlock a file with git-lfs", "output": "git lfs unlock important.bin"},
  {"instruction": "Install git-lfs hooks into repository", "output": "git lfs install"},
  {"instruction": "Uninstall git-lfs hooks", "output": "git lfs uninstall"},
