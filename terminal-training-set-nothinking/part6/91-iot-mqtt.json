[
  {
    "instruction": "Install Mosquitto MQTT broker and clients on Debian 12",
    "output": "sudo apt install mosquitto mosquitto-clients"
  },
  {
    "instruction": "Publish a message to an MQTT topic",
    "output": "mosquitto_pub --topic 'sensor/temperature' --message '22.5'"
  },
  {
    "instruction": "Publish with QoS 2 and retain flag",
    "output": "mosquitto_pub --topic 'sensor/humidity' --message '60' --qos 2 --retain"
  },
  {
    "instruction": "Publish message from file content",
    "output": "mosquitto_pub --topic 'config/device' --file /etc/device/config.json"
  },
  {
    "instruction": "Publish with message expiry",
    "output": "mosquitto_pub --topic 'sensor/battery' --message '85' --expiry 3600"
  },
  {
    "instruction": "Subscribe to MQTT topic with verbose output",
    "output": "mosquitto_sub --topic 'sensor/"
  },
  {
    "instruction": "Subscribe with QoS 2 and persistent session",
    "output": "mosquitto_sub --topic 'sensor/temperature' --qos 2 -c -i 'subscriber1'"
  },
  {
    "instruction": "Subscribe and show timestamps",
    "output": "mosquitto_sub --topic '"
  },
  {
    "instruction": "Subscribe for exactly 5 messages then exit",
    "output": "mosquitto_sub --topic 'test/"
  },
  {
    "instruction": "Publish with TLS using CA certificate",
    "output": "mosquitto_pub --topic 'secure/data' --message 'encrypted' --tls-version tlsv1.2 --cafile /etc/mosquitto/ca.crt"
  },
  {
    "instruction": "Publish with TLS client certificate",
    "output": "mosquitto_pub --topic 'secure/data' --message 'payload' --cafile ca.crt --cert client.crt --key client.key"
  },
  {
    "instruction": "Publish with TLS insecure mode",
    "output": "mosquitto_pub --topic 'test/tls' --message 'insecure' --cafile ca.crt --insecure"
  },
  {
    "instruction": "Publish with username and password",
    "output": "mosquitto_pub --topic 'restricted/data' --message 'secret' --username alice --pw 'password123'"
  },
  {
    "instruction": "Publish using password file",
    "output": "mosquitto_pub --topic 'restricted/data' --message 'secret' --username alice --pw-file /etc/mosquitto/passwd"
  },
  {
    "instruction": "Publish a Will message",
    "output": "mosquitto_pub --topic 'status/device' --message 'online' --will-topic 'status/device' --will-payload 'offline' --will-qos 1 --will-retain"
  },
  {
    "instruction": "Publish with debug output",
    "output": "mosquitto_pub --topic 'test/debug' --message 'checking' -d"
  },
  {
    "instruction": "Publish to a specific host and port",
    "output": "mosquitto_pub -h 192.168.1.100 -p 1883 --topic 'remote/data' --message 'hello'"
  },
  {
    "instruction": "Publish with client ID",
    "output": "mosquitto_pub --topic 'test/id' --message 'idtest' -i 'publisher1'"
  },
  {
    "instruction": "Subscribe with specific client ID",
    "output": "mosquitto_sub --topic 'test/"
  },
  {
    "instruction": "Create Mosquitto password file",
    "output": "mosquitto_passwd -c /etc/mosquitto/passwd alice"
  },
  {
    "instruction": "Create user non-interactively with mosquitto_passwd",
    "output": "mosquitto_passwd -c -b /etc/mosquitto/passwd alice password123"
  },
  {
    "instruction": "Verify Mosquitto password file",
    "output": "mosquitto_passwd -V /etc/mosquitto/passwd"
  },
  {
    "instruction": "Delete user from Mosquitto password file",
    "output": "mosquitto_passwd -D /etc/mosquitto/passwd bob"
  },
  {
    "instruction": "Install eclipse-mosquitto from Docker",
    "output": "sudo docker pull eclipse-mosquitto && sudo docker run -d --name mqtt-broker -p 1883:1883 eclipse-mosquitto"
  }
]