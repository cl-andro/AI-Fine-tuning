[
  {
    "instruction": "Restart networking services for wifi",
    "output": "systemctl restart networking"
  },
  {
    "instruction": "Restart wpa_supplicant service",
    "output": "systemctl restart wpa_supplicant"
  },
  {
    "instruction": "Renew DHCP lease on wlan0",
    "output": "dhclient wlan0"
  },
  {
    "instruction": "Release the current DHCP lease",
    "output": "dhclient -r wlan0"
  },
  {
    "instruction": "Get IP address with dhcpcd",
    "output": "dhcpcd wlan0"
  },
  {
    "instruction": "Check wlan0 link state",
    "output": "ip link show wlan0"
  },
  {
    "instruction": "Show wlan0 routing table",
    "output": "ip route show dev wlan0"
  },
  {
    "instruction": "Test connectivity via wifi",
    "output": "ping -I wlan0 -c 3 8.8.8.8"
  },
  {
    "instruction": "Diagnose wifi driver info",
    "output": "lspci -k | grep -i wireless"
  },
  {
    "instruction": "Check kernel wifi modules",
    "output": "lsmod | grep -E 'iwl|ath|brcm|rtl|mac80211'"
  },
  {
    "instruction": "Show wifi interface queue length",
    "output": "ip -s link show wlan0"
  },
  {
    "instruction": "Show signal strength with watch",
    "output": "watch -n 2 'iw dev wlan0 link'"
  },
  {
    "instruction": "Scan for hidden SSID networks",
    "output": "iw dev wlan0 scan | grep -E 'SSID|freq|signal'"
  },
  {
    "instruction": "Get the wifi channel width",
    "output": "iw dev wlan0 info | grep channel"
  },
  {
    "instruction": "Set a static IP on wlan0",
    "output": "ip addr add 192.168.1.100/24 dev wlan0"
  },
  {
    "instruction": "Debug wpa_supplicant connection loop",
    "output": "journalctl -u wpa_supplicant -f"
  },
  {
    "instruction": "Check rfkill hard block state",
    "output": "rfkill list | grep -E 'Hard|Soft'"
  },
  {
    "instruction": "Check wifi regulatory constraints",
    "output": "iw reg get"
  },
  {
    "instruction": "List frequencies allowed in current reg domain",
    "output": "iw list | grep -E 'MHz|DFS'"
  },
  {
    "instruction": "Enable wifi via nmcli",
    "output": "nmcli radio wifi on"
  },
  {
    "instruction": "Check network manager wifi status",
    "output": "nmcli dev wifi list"
  },
  {
    "instruction": "Read the wireless kernel log",
    "output": "dmesg | grep -i wlan"
  }
]