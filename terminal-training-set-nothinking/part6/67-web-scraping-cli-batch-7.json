[
  {
    "instruction": "Take a full-page screenshot with Playwright CLI",
    "output": "playwright screenshot --full-page https://example.com screenshot.png"
  },
  {
    "instruction": "Playwright: generate a PDF from a page",
    "output": "playwright pdf https://example.com page.pdf"
  },
  {
    "instruction": "Playwright: open a page in headed mode for debugging",
    "output": "playwright open --browser chromium https://example.com"
  },
  {
    "instruction": "Playwright: install all browser binaries",
    "output": "playwright install"
  },
  {
    "instruction": "Playwright: list available browsers",
    "output": "playwright install --help | grep 'chromium\\|firefox\\|webkit'"
  },
  {
    "instruction": "Playwright: screenshot a specific element by selector",
    "output": "playwright screenshot --selector '"
  },
  {
    "instruction": "Playwright: emulate a mobile device",
    "output": "playwright open --device 'iPhone 13' https://example.com"
  },
  {
    "instruction": "Take a screenshot using chromium-headless-render-pdf",
    "output": "chrome-headless-render-pdf --screenshot --url https://example.com --out screenshot.png"
  },
  {
    "instruction": "Render a PDF with chrome-headless-render-pdf",
    "output": "chrome-headless-render-pdf --url https://example.com --out page.pdf"
  },
  {
    "instruction": "chrome-headless-render-pdf: set custom viewport",
    "output": "chrome-headless-render-pdf --url https://example.com --out page.pdf --viewport.width 1280 --viewport.height 720"
  },
  {
    "instruction": "Puppeteer CLI: take a screenshot",
    "output": "puppeteer-cli screenshot https://example.com screenshot.png"
  },
  {
    "instruction": "Puppeteer CLI: generate PDF",
    "output": "puppeteer-cli pdf https://example.com page.pdf"
  },
  {
    "instruction": "Playwright: capture HAR file of page load",
    "output": "playwright open --save-har archive.har https://example.com"
  },
  {
    "instruction": "chrome-headless-render-pdf: add margin when rendering",
    "output": "chrome-headless-render-pdf --url https://example.com --out page.pdf --margin.top 1in --margin.bottom 1in"
  },
  {
    "instruction": "Playwright: wait for selector before screenshot",
    "output": "playwright screenshot --wait-for-selector '.loaded' https://example.com screenshot.png"
  },
  {
    "instruction": "Playwright: record video of page interaction",
    "output": "playwright open --video record https://example.com"
  },
  {
    "instruction": "Puppeteer CLI: set custom user agent",
    "output": "puppeteer-cli screenshot --user-agent 'Mozilla/5.0' https://example.com screenshot.png"
  },
  {
    "instruction": "chrome-headless-render-pdf: print background graphics",
    "output": "chrome-headless-render-pdf --url https://example.com --out page.pdf --print-background"
  },
  {
    "instruction": "Playwright: open with geolocation",
    "output": "playwright open --geolocation '40.7128,-74.0060' https://maps.google.com"
  },
  {
    "instruction": "Playwright: block specific domains during load",
    "output": "playwright open --block-domains analytics.google.com https://example.com"
  }
]