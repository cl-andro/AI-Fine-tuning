[
  {
    "instruction": "List all rfkill devices",
    "output": "rfkill list"
  },
  {
    "instruction": "List wifi rfkill devices only",
    "output": "rfkill list wifi"
  },
  {
    "instruction": "Block all wireless devices (soft block)",
    "output": "rfkill block wifi"
  },
  {
    "instruction": "Unblock all wireless devices",
    "output": "rfkill unblock wifi"
  },
  {
    "instruction": "Block all bluetooth devices",
    "output": "rfkill block bluetooth"
  },
  {
    "instruction": "Block all wireless types",
    "output": "rfkill block all"
  },
  {
    "instruction": "Unblock all wireless types",
    "output": "rfkill unblock all"
  },
  {
    "instruction": "Toggle wifi rfkill state",
    "output": "rfkill toggle wifi"
  },
  {
    "instruction": "Check the status of wlan rfkill",
    "output": "rfkill list wlan"
  },
  {
    "instruction": "Identify RF kill switch events",
    "output": "udevadm monitor --subsystem-match=rfkill"
  },
  {
    "instruction": "Start airmon-ng to check interfaces",
    "output": "airmon-ng"
  },
  {
    "instruction": "Kill interfering processes for monitor mode",
    "output": "airmon-ng check kill"
  },
  {
    "instruction": "Enable monitor mode on wlan0",
    "output": "airmon-ng start wlan0"
  },
  {
    "instruction": "Enable monitor mode on channel 6",
    "output": "airmon-ng start wlan0 6"
  },
  {
    "instruction": "Stop monitor mode on wlan0mon",
    "output": "airmon-ng stop wlan0mon"
  },
  {
    "instruction": "Start airodump-ng on wlan0mon",
    "output": "airodump-ng wlan0mon"
  },
  {
    "instruction": "Start airodump-ng on 5GHz band",
    "output": "airodump-ng wlan0mon --band a"
  },
  {
    "instruction": "Start airodump-ng on channel 6",
    "output": "airodump-ng wlan0mon --channel 6"
  },
  {
    "instruction": "Capture to a file with airodump-ng",
    "output": "airodump-ng wlan0mon -w /tmp/capture"
  },
  {
    "instruction": "Filter airodump-ng by BSSID",
    "output": "airodump-ng wlan0mon --bssid AA:BB:CC:DD:EE:FF"
  },
  {
    "instruction": "Use airodump-ng with a channel file",
    "output": "airodump-ng wlan0mon --channel 1-13 -w /tmp/scan"
  },
  {
    "instruction": "Start airodump-ng with both bands",
    "output": "airodump-ng wlan0mon --band abg -w /tmp/fullscan"
