[
  {
    "instruction": "Show nvcc compiler version",
    "output": "nvcc --version"
  },
  {
    "instruction": "Compile a CUDA kernel with nvcc",
    "output": "nvcc -o mykernel mykernel.cu -arch=sm_80"
  },
  {
    "instruction": "Compile CUDA with debug symbols",
    "output": "nvcc -g -G -o mykernel mykernel.cu"
  },
  {
    "instruction": "Compile CUDA with PTX output",
    "output": "nvcc -ptx mykernel.cu"
  },
  {
    "instruction": "Dump CUDA binary contents",
    "output": "cuobjdump /tmp/mykernel"
  },
  {
    "instruction": "Dump cubin sections with cuobjdump",
    "output": "cuobjdump -sass /tmp/mykernel"
  },
  {
    "instruction": "Dump ELF sections of CUDA binary",
    "output": "cuobjdump -elf /tmp/mykernel"
  },
  {
    "instruction": "Disassemble CUDA binary with nvdisasm",
    "output": "nvdisasm /tmp/mykernel"
  },
  {
    "instruction": "Disassemble a specific kernel",
    "output": "nvdisasm -gi mykernel"
  },
  {
    "instruction": "Profile with nvprof (legacy)",
    "output": "nvprof ./mykernel"
  },
  {
    "instruction": "Profile CUDA API calls with nvprof",
    "output": "nvprof --print-gpu-trace ./mykernel"
  },
  {
    "instruction": "Profile with Nsight Systems",
    "output": "nsys profile -o /tmp/profile ./mykernel"
  },
  {
    "instruction": "Nsight Systems with CUDA trace",
    "output": "nsys profile --trace=cuda,nvtx ./mykernel"
  },
  {
    "instruction": "Nsight Systems with MPI tracing",
    "output": "nsys profile --trace=mpi,cuda ./mpi_app"
  },
  {
    "instruction": "Nsight Compute for GPU kernel analysis",
    "output": "ncu -o /tmp/ncu_report ./mykernel"
  },
  {
    "instruction": "Nsight Compute with metrics",
    "output": "ncu --set full -o /tmp/ncu_report ./mykernel"
  },
  {
    "instruction": "Nsight Compute for a specific kernel",
    "output": "ncu --kernel-name mykernel --launch-count=1 ./mykernel"
  },
  {
    "instruction": "Show GPU architecture list for nvcc",
    "output": "nvcc --list-gpu-arch"
  },
  {
    "instruction": "Compile CUDA for multiple architectures",
    "output": "nvcc -gencode arch=compute_75,code=sm_75 -gencode arch=compute_80,code=sm_80 mykernel.cu"
  },
  {
    "instruction": "Run nvprof timeline trace",
    "output": "nvprof --output-profile /tmp/profile.nvprof ./mykernel"
  },
  {
    "instruction": "Use cuobjdump to extract PTX",
    "output": "cuobjdump -ptx /tmp/mykernel"
  },
  {
    "instruction": "Disassemble CUDA with line numbers",
    "output": "nvdisasm -gi -ndf /tmp/mykernel"
  }
]