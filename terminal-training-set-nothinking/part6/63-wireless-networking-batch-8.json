[
  {
    "instruction": "Listen to all wireless events",
    "output": "iw event"
  },
  {
    "instruction": "Listen to events on wlan0 only",
    "output": "iw event wlan0"
  },
  {
    "instruction": "Listen to regulatory events",
    "output": "iw event-reg"
  },
  {
    "instruction": "Listen to command events",
    "output": "iw event-cmd"
  },
  {
    "instruction": "Continuously watch wireless events",
    "output": "iw event -t"
  },
  {
    "instruction": "Set up mesh point on wlan0",
    "output": "iw dev wlan0 set type mp"
  },
  {
    "instruction": "Join a mesh network with mesh ID",
    "output": "iw dev wlan0 mesh join MyMesh freq 2437 HT20"
  },
  {
    "instruction": "Leave a mesh network",
    "output": "iw dev wlan0 mesh leave"
  },
  {
    "instruction": "Add a mesh peering",
    "output": "iw dev wlan0 station set 00:11:22:33:44:55 plink_action open"
  },
  {
    "instruction": "Set the mesh channel",
    "output": "iw dev wlan0 set channel 1 HT40+"
  },
  {
    "instruction": "Request specific channel width",
    "output": "iw dev wlan0 set channel 36 HT80"
  },
  {
    "instruction": "Set antenna bitmap on phy0",
    "output": "iw phy phy0 set antenna 1 1"
  },
  {
    "instruction": "Set the coverage class",
    "output": "iw phy phy0 set coverage 3"
  },
  {
    "instruction": "Set the distance for mesh",
    "output": "iw phy phy0 set distance 500"
  },
  {
    "instruction": "Set the wlan0 interface netns",
    "output": "iw phy phy0 set netns 1234"
  },
  {
    "instruction": "Monitor all management frames",
    "output": "iw dev wlan0 set type monitor && ip link set wlan0 up"
  },
  {
    "instruction": "List network namespaces",
    "output": "ip netns list"
  },
  {
    "instruction": "Move wlan1 to a network namespace",
    "output": "iw phy phy1 set netns myns"
  },
  {
    "instruction": "Set wlan0 to AP mode",
    "output": "iw dev wlan0 set type ap"
  },
  {
    "instruction": "Disable HT20 on wlan0",
    "output": "iw dev wlan0 set bitrates legacy-2.4 54"
  },
  {
    "instruction": "Get wlan0 link quality",
    "output": "cat /proc/net/wireless"
  },
  {
    "instruction": "Parse wireless stats from proc",
    "output": "awk 'NR==3 {print $3,$4,$5}' /proc/net/wireless"
  }
]