[
  {"instruction": "Configure rsync daemon with a module", "output": "echo -e '[backup]\npath = /data/backup\ncomment = Backup share\nread only = no\ntimeout = 300' >> /etc/rsyncd.conf"},
  {"instruction": "Initialize a Seafile client", "output": "seaf-cli init -d ~/.seafile"},
  {"instruction": "Start Seafile client daemon", "output": "seaf-cli start"},
  {"instruction": "Stop Seafile client daemon", "output": "seaf-cli stop"},
  {"instruction": "Sync a Seafile library to a local folder", "output": "seaf-cli sync -l LIB-ID -s https://seafile.example.com -d ~/seafile-data -u user@example.com -p password"},
  {"instruction": "List Seafile synced libraries", "output": "seaf-cli list"},
  {"instruction": "Show Seafile sync status", "output": "seaf-cli status"},
  {"instruction": "Download a Seafile library without syncing", "output": "seaf-cli download -l LIB-ID -d ~/seafile-dl"},
  {"instruction": "Desync a Seafile library", "output": "seaf-cli desync -l LIB-ID"},
  {"instruction": "Sync an ownCloud folder", "output": "owncloudcmd ~/owncloud https://owncloud.example.com"},
  {"instruction": "Sync ownCloud with specific folder", "output": "owncloudcmd -s --user user --password pass ~/owncloud https://owncloud.example.com/photos"},
  {"instruction": "Sync a Nextcloud folder non-interactively", "output": "nextcloudcmd --user user --password pass ~/nextcloud https://nextcloud.example.com"},
  {"instruction": "Nextcloud sync with exclude list", "output": "nextcloudcmd --exclude /path/to/exclude.lst ~/nextcloud https://nextcloud.example.com"},
  {"instruction": "Nextcloud sync trusted certificate", "output": "nextcloudcmd --trust ~/nextcloud https://nextcloud.example.com"},
  {"instruction": "Nextcloud sync with single file", "output": "nextcloudcmd ~/nextcloud https://nextcloud.example.com --path /Documents"},
  {"instruction": "Initialize a git-annex repository", "output": "git annex init 'My Laptop'"},
  {"instruction": "Add a file to git-annex", "output": "git annex add largefile.iso"},
  {"instruction": "Get a file from git-annex (download content)", "output": "git annex get largefile.iso"},
  {"instruction": "Drop file content from git-annex local", "output": "git annex drop largefile.iso"},
  {"instruction": "Move file content in git-annex", "output": "git annex move largefile.iso --to remote"},
  {"instruction": "Copy file content in git-annex", "output": "git annex copy largefile.iso --to remote"},
  {"instruction": "Unlock a git-annex file for editing", "output": "git annex unlock largefile.iso"},
  {"instruction": "Lock a git-annex file (undo unlock)", "output": "git annex lock largefile.iso"},
  {"instruction": "Show where git-annex file content is stored", "output": "git annex whereis largefile.iso"},
  {"instruction": "Find unused git-annex content", "output": "git annex unused"},
  {"instruction": "Fsck git-annex repository", "output": "git annex fsck"}
]
