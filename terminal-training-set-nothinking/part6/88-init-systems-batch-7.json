[
  {"instruction": "Configure Supervisor logfile size and backups", "output": "echo 'stdout_logfile_maxbytes=10MB\nstdout_logfile_backups=5' >> /etc/supervisor/conf.d/myapp.conf"},
  {"instruction": "Set Supervisor umask for process", "output": "echo 'umask=022' >> /etc/supervisor/conf.d/myapp.conf"},
  {"instruction": "Configure Supervisor to run as different user", "output": "echo 'user=www-data' >> /etc/supervisor/conf.d/myapp.conf"},
  {"instruction": "Create a Circus watcher with virtualenv Python", "output": "echo -e '[watcher:myapp]\ncmd = /opt/venv/bin/python app.py' >> /etc/circus.ini"},
  {"instruction": "Set Circus watcher copy environment", "output": "echo -e 'copy_env = True' >> /etc/circus.ini"},
  {"instruction": "Set Circus watcher number of processes per host", "output": "echo -e '[watcher:myapp]\nnumprocesses = 4' >> /etc/circus.ini"},
  {"instruction": "Set Circus watcher warmup delay", "output": "echo -e 'warmup_delay = 5' >> /etc/circus.ini"},
  {"instruction": "Configure Circus watcher graceful timeout", "output": "echo -e 'graceful_timeout = 30' >> /etc/circus.ini"},
  {"instruction": "Set Circus watcher send HUP signal on reload", "output": "echo -e 'send_hup = True' >> /etc/circus.ini"},
  {"instruction": "Create a Circus flapping config", "output": "echo -e '[watcher:myapp]\nmax_retry = 5\nretry_in = 3' >> /etc/circus.ini"},
  {"instruction": "Set Circus endpoint for web UI", "output": "echo -e '[circus]\nendpoint = tcp://127.0.0.1:5555\npubsub_endpoint = tcp://127.0.0.1:5556' > /etc/circus.ini"},
  {"instruction": "Configure Circus web interface", "output": "echo -e '[circus]\ncheck_delay = 5' >> /etc/circus.ini"},
  {"instruction": "Manage runit service with sv once-only", "output": "sv once myservice"},
  {"instruction": "Send SIGPWR to runit service", "output": "sv power myservice"},
  {"instruction": "Send SIGUSR1 to runit service", "output": "sv 1 myservice"},
  {"instruction": "Send SIGUSR2 to runit service", "output": "sv 2 myservice"},
  {"instruction": "Check runit service status (long format)", "output": "sv status -l myservice"},
  {"instruction": "Wait for runit service to become up", "output": "sv wait myservice"},
  {"instruction": "Show runit help", "output": "sv -h"},
  {"instruction": "Enable a sysvinit service with chkconfig on specific levels", "output": "chkconfig --level 2345 apache2 on"},
  {"instruction": "Add custom runlevel in sysvinit", "output": "mkdir /etc/init.d/rc_custom"},
  {"instruction": "Set default runlevel in sysvinit via inittab", "output": "sed -i 's/^id:[0-9]:initdefault:/id:3:initdefault:/' /etc/inittab"},
  {"instruction": "Show sysvinit current runlevel", "output": "runlevel"},
  {"instruction": "Check OpenRC specific service config", "output": "rc-config show myapp"}
