[
  {
    "instruction": "Log in to Hugging Face Hub",
    "output": "huggingface-cli login"
  },
  {
    "instruction": "Log in with a token",
    "output": "huggingface-cli login --token hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  {
    "instruction": "Log out of Hugging Face Hub",
    "output": "huggingface-cli logout"
  },
  {
    "instruction": "Check who is logged in",
    "output": "huggingface-cli whoami"
  },
  {
    "instruction": "Download a model from Hugging Face",
    "output": "huggingface-cli download google-bert/bert-base-uncased --local-dir ./bert"
  },
  {
    "instruction": "Download a specific file from a model",
    "output": "huggingface-cli download google-bert/bert-base-uncased config.json"
  },
  {
    "instruction": "Upload a folder to Hugging Face",
    "output": "huggingface-cli upload myuser/my-model ./model_dir/"
  },
  {
    "instruction": "Upload a single file",
    "output": "huggingface-cli upload myuser/my-model ./model.safetensors model.safetensors"
  },
  {
    "instruction": "List all models matching a query",
    "output": "huggingface-cli list-models --search text-classification --limit 10"
  },
  {
    "instruction": "List all datasets",
    "output": "huggingface-cli list-datasets --limit 5"
  },
  {
    "instruction": "List models sorted by likes",
    "output": "huggingface-cli list-models --sort likes --limit 10"
  },
  {
    "instruction": "List models for a specific author",
    "output": "huggingface-cli list-models --author google-bert"
  },
  {
    "instruction": "Show model info for BERT",
    "output": "huggingface-cli model-info google-bert/bert-base-uncased"
  },
  {
    "instruction": "List all files in a model repo",
    "output": "huggingface-cli list-models --repo-type model google-bert/bert-base-uncased"
  },
  {
    "instruction": "Use modellist to list cached models",
    "output": "modellist --cached"
  },
  {
    "instruction": "Use modellist to filter by framework",
    "output": "modellist --framework pytorch"
  },
  {
    "instruction": "Use modellist to show model sizes",
    "output": "modellist --human"
  },
  {
    "instruction": "Modellist all available models",
    "output": "modellist"
  },
  {
    "instruction": "Search models by tag via modellist",
    "output": "modellist --tag text-generation"
  },
