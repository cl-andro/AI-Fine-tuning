[
  {
    "instruction": "Check wpa_supplicant version",
    "output": "wpa_supplicant -v"
  },
  {
    "instruction": "Write WPA2-Enterprise wpa_supplicant config",
    "output": "cat > /etc/wpa_supplicant/wpa_supplicant.conf << 'EOF'\nnetwork={\n  ssid=\"EnterpriseNet\"\n  key_mgmt=WPA-EAP\n  eap=PEAP\n  identity=\"user@domain.com\"\n  password=\"mypass\"\n  phase2=\"auth=MSCHAPV2\"\n}\nEOF"
  },
  {
    "instruction": "Connect using WPA3-SAE on wpa_supplicant",
    "output": "wpa_cli -i wlan0 set_network 0 key_mgmt SAE"
  },
  {
    "instruction": "Set wpa_supplicant to use a specific driver",
    "output": "wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf -D nl80211,wext"
  },
  {
    "instruction": "Start wpa_supplicant with WPS",
    "output": "wpa_cli wps_pbc"
  },
  {
    "instruction": "Pin-based WPS enrollment",
    "output": "wpa_cli wps_pin any 12345670"
  },
  {
    "instruction": "Show WPS capabilities via wpa_cli",
    "output": "wpa_cli wps_capabilities"
  },
  {
    "instruction": "Set wpa_supplicant logging level",
    "output": "wpa_cli log_level DEBUG"
  },
  {
    "instruction": "Set the PMKSA caching lifetime",
    "output": "wpa_cli set_network 0 proactive_key_caching 1"
  },
  {
    "instruction": "Set fast reconnection (PMKSA)",
    "output": "wpa_cli set_network 0 proto RSN"
  },
  {
    "instruction": "Show BSS entries in wpa_cli",
    "output": "wpa_cli bss 0"
  },
  {
    "instruction": "Set wlan0 interface up in wpa_cli",
    "output": "wpa_cli interface wlan0"
  },
  {
    "instruction": "Set the ap_scan parameter",
    "output": "wpa_cli set ap_scan 1"
  },
  {
    "instruction": "Disable wpa_supplicant roaming",
    "output": "wpa_cli set disable_scan_offload 1"
  },
  {
    "instruction": "Run wpa_supplicant with all interfaces",
    "output": "wpa_supplicant -B -c /etc/wpa_supplicant.conf -D nl80211"
  },
  {
    "instruction": "Enable IEEE 802.11w PMF",
    "output": "wpa_cli set_network 0 ieee80211w 2"
  },
  {
    "instruction": "Set pairwise cipher for network 0",
    "output": "wpa_cli set_network 0 pairwise CCMP"
  },
  {
    "instruction": "Set group cipher for network 0",
    "output": "wpa_cli set_network 0 group CCMP"
  },
  {
    "instruction": "Set the frequency for network 0",
    "output": "wpa_cli set_network 0 frequency 5180"
  },
  {
    "instruction": "Use wpa_supplicant with EAP-TLS",
    "output": "wpa_cli set_network 0 eap TLS"
  },
  {
    "instruction": "Set client cert path for EAP-TLS",
    "output": "wpa_cli set_network 0 client_cert '/etc/cert/client.pem'"
  },
  {
    "instruction": "Set private key for EAP-TLS",
    "output": "wpa_cli set_network 0 private_key '/etc/cert/client.key'"
  }
]