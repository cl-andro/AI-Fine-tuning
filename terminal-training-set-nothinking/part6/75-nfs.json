[
  {"instruction": "Export all entries in /etc/exports", "output": "exportfs -a"},
  {"instruction": "Re-export all entries after editing exports", "output": "exportfs -r"},
  {"instruction": "Remove a specific export", "output": "exportfs -u server:/path"},
  {"instruction": "Remove all exports", "output": "exportfs -ua"},
  {"instruction": "Show current exports with verbose", "output": "exportfs -v"},
  {"instruction": "Show exports without DNS resolution", "output": "exportfs -s"},
  {"instruction": "Flush export table and re-export", "output": "exportfs -f"},
  {"instruction": "Ignore /etc/exports and use CLI options", "output": "exportfs -i -o rw,no_root_squash *:/srv/nfs"},
  {"instruction": "Export a directory read-only to subnet", "output": "exportfs -o ro 192.168.1.0/24:/srv/nfs"},
  {"instruction": "Export with squash options", "output": "exportfs -o rw,all_squash,anonuid=1000,anongid=1000 *:/srv/shared"},
  {"instruction": "Add export entry to /etc/exports", "output": "echo '/srv/nfs 192.168.1.0/24(rw,sync,no_subtree_check)' >> /etc/exports"},
  {"instruction": "Export a directory to a specific host", "output": "exportfs 10.0.0.5:/srv/nfs"},
  {"instruction": "Show exports matching a pattern", "output": "exportfs -v | grep nfs"},
  {"instruction": "Export with subtree check disabled", "output": "exportfs -o no_subtree_check *:/srv/nfs"},
  {"instruction": "Export with sync option", "output": "exportfs -o rw,sync *:/srv/nfs"},
  {"instruction": "Export with fsid=0 for NFSv4 pseudo-root", "output": "exportfs -o rw,fsid=0 *:/srv/nfs4"},
  {"instruction": "Export without root squash", "output": "exportfs -o rw,no_root_squash *:/srv/nfs"},
  {"instruction": "Export with insecure option for high ports", "output": "exportfs -o rw,insecure *:/srv/nfs"},
  {"instruction": "Show export list with no headers", "output": "exportfs -s --no-headers"},
  {"instruction": "Debug export resolution for a path", "output": "exportfs -v /srv/nfs"},
  {"instruction": "Export crossmnt for bind mounts", "output": "exportfs -o rw,crossmnt *:/srv/nfs"}
]