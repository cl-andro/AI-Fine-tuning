[
  {"instruction": "Crush reweight a Ceph OSD", "output": "ceph osd crush reweight osd.0 1.5"},
  {"instruction": "Show Ceph monitor status", "output": "ceph mon status"},
  {"instruction": "Get Ceph monitor map", "output": "ceph mon dump"},
  {"instruction": "Show Ceph manager status", "output": "ceph mgr stat"},
  {"instruction": "Show Ceph MDS (Metadata Server) status", "output": "ceph mds stat"},
  {"instruction": "Show Ceph filesystem disk usage", "output": "ceph df"},
  {"instruction": "Show Ceph pool-level disk usage", "output": "ceph df detail"},
  {"instruction": "List Ceph auth keys", "output": "ceph auth list"},
  {"instruction": "Get a specific Ceph auth key for client", "output": "ceph auth get client.admin"},
  {"instruction": "Export a Ceph auth key to a file", "output": "ceph auth export client.admin -o ceph.client.admin.keyring"},
  {"instruction": "Set a Ceph configuration option for the monitor", "output": "ceph config set mon mon_allow_pool_delete true"},
  {"instruction": "Get a Ceph configuration option", "output": "ceph config get mon mon_allow_pool_delete"},
  {"instruction": "Tell a Ceph daemon to perform a command", "output": "ceph tell osd.0 version"},
  {"instruction": "Tell a Ceph OSD to compact its leveldb", "output": "ceph tell osd.0 compact"},
  {"instruction": "Run a Ceph tell command on all OSDs", "output": "ceph tell osd.* version"},
  {"instruction": "Run a Ceph tell command on all monitors", "output": "ceph tell mon.* status"},
  {"instruction": "Ceph OSD reweight by utilization", "output": "ceph osd reweight-by-utilisation 120"},
  {"instruction": "Mark a Ceph OSD as out (rebalance data off it)", "output": "ceph osd out osd.0"},
  {"instruction": "Mark a Ceph OSD as in (rebalance data to it)", "output": "ceph osd in osd.0"},
  {"instruction": "Check if a Ceph OSD is safe to destroy", "output": "ceph osd safe-to-destroy osd.0"},
  {"instruction": "Show Ceph placement group statistics", "output": "ceph pg stat"},
  {"instruction": "Dump all Ceph placement group states", "output": "ceph pg dump"},
  {"instruction": "Dump Ceph PG state in JSON format", "output": "ceph pg dump -f json"},
  {"instruction": "Scrub a Ceph placement group", "output": "ceph pg scrub 1.0"},
  {"instruction": "Repair a Ceph placement group", "output": "ceph pg repair 1.0"}
]
