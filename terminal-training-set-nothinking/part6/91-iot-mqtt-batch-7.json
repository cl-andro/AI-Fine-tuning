[
  {"instruction": "Install Tasmota console tool", "output": "sudo pip install tasmota-cli"},
  {"instruction": "Tasmota CLI: turn device on", "output": "tasmota-cli -d sonoff1 -c power on"},
  {"instruction": "Tasmota CLI: set device MQTT broker", "output": "tasmota-cli -d sonoff1 -c MqttServer 192.168.1.100"},
  {"instruction": "Tasmota CLI: get device status", "output": "tasmota-cli -d sonoff1 -c Status 0"},
  {"instruction": "Home Assistant CLI: list all entities", "output": "ha entity list"},
  {"instruction": "Home Assistant CLI: get entity state", "output": "ha entity get light.living_room"},
  {"instruction": "Home Assistant CLI: call service", "output": "ha service call light.turn_on --arguments '{\"entity_id\":\"light.living_room\"}'"},
  {"instruction": "Home Assistant CLI: check config", "output": "ha core check --config /config"},
  {"instruction": "Home Assistant CLI: get system health", "output": "ha core health"},
  {"instruction": "Home Assistant CLI: create backup", "output": "ha snapshots new --name 'pre-upgrade'"},
  {"instruction": "Home Assistant CLI: list snapshots", "output": "ha snapshots list"},
  {"instruction": "Home Assistant CLI: restore snapshot", "output": "ha snapshots restore SNAPSHOT_ID"},
  {"instruction": "Home Assistant CLI: update core", "output": "ha core update --version 2026.6.0"},
  {"instruction": "Home Assistant CLI: add MQTT integration", "output": "ha config add integration mqtt --broker 192.168.1.100 --port 1883 --username mqtt --password secret"},
  {"instruction": "OpenHAB CLI: list all things", "output": "openhab-cli thing list"},
  {"instruction": "OpenHAB CLI: list all items", "output": "openhab-cli item list"},
  {"instruction": "OpenHAB CLI: send a command to an item", "output": "openhab-cli item command SwitchLight ON"},
  {"instruction": "OpenHAB CLI: get item status", "output": "openhab-cli item status TemperatureSensor"},
  {"instruction": "OpenHAB CLI: check bundle status", "output": "openhab-cli bundle list"},
  {"instruction": "OpenHAB CLI: add MQTT binding", "output": "openhab-cli bundle:install org.openhab.binding.mqtt"},
  {"instruction": "OpenHAB CLI: start bundle", "output": "openhab-cli bundle:start org.openhab.binding.mqtt"},
  {"instruction": "Mosquitto: set per-listener settings with different auth", "output": "echo 'listener 1883 localhost\nallow_anonymous true\n\nlistener 1884 0.0.0.0\npassword_file /etc/mosquitto/passwd' | sudo tee /etc/mosquitto/conf.d/multi-listener.conf && sudo systemctl restart mosquitto"},
  {"instruction": "test Mosquitto listener on port 1884", "output": "mosquitto_pub -p 1884 --topic 'internal/test' --message 'data' --username alice --pw password123"},
  {"instruction": "Subscribe with strict protocol version MQTT 3.1.1", "output": "mosquitto_sub --topic 'data' -V 311 -v"}
