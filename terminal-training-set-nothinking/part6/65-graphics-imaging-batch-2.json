[
  {
    "instruction": "Enhance contrast",
    "output": "convert input.jpg -contrast output.jpg"
  },
  {
    "instruction": "Adjust brightness and contrast",
    "output": "convert input.jpg -brightness-contrast 10x5 output.jpg"
  },
  {
    "instruction": "Fill a region with red color",
    "output": "convert input.jpg -fill red -draw 'rectangle 10,10 100,100' output.jpg"
  },
  {
    "instruction": "Tint an image with blue",
    "output": "convert input.jpg -fill blue -tint 50 output.jpg"
  },
  {
    "instruction": "Apply binary threshold at 50%",
    "output": "convert input.jpg -threshold 50% output.jpg"
  },
  {
    "instruction": "Apply local adaptive threshold",
    "output": "convert input.jpg -lat 10x10+5% output.jpg"
  },
  {
    "instruction": "Distort image with perspective",
    "output": "convert input.jpg -distort Perspective '0,0,0,0 300,0,300,0 0,200,0,200 300,200,280,180' output.jpg"
  },
  {
    "instruction": "Draw text on image",
    "output": "convert input.jpg -font Arial -pointsize 24 -fill white -annotate +10+50 'Hello World' output.jpg"
  },
  {
    "instruction": "Draw text with gravity center",
    "output": "convert input.jpg -gravity center -fill white -pointsize 32 -annotate 0 'Centered' output.jpg"
  },
  {
    "instruction": "Add a border around the image",
    "output": "convert input.jpg -border 10x10 -bordercolor black output.jpg"
  },
  {
