    "output": "convert input.jpg -frame 15x15 output.jpg"
  },
  {
    "instruction": "Trim white space from edges",
    "output": "convert input.jpg -trim output.jpg"
  },
  {
    "instruction": "Set alpha channel to transparent",
    "output": "convert input.png -alpha on -channel A -evaluate set 0% output.png"
  },
  {
    "instruction": "Strip all metadata",
    "output": "convert input.jpg -strip output.jpg"
  },
  {
    "instruction": "Set output bit depth to 8",
    "output": "convert input.jpg -depth 8 output.jpg"
  },
  {
    "instruction": "Create a thumbnail 200x200",
    "output": "convert input.jpg -thumbnail 200x200 output.jpg"
  },
  {
    "instruction": "Resize and pad to exact dimensions",
    "output": "convert input.jpg -resize 800x600 -background black -gravity center -extent 800x600 output.jpg"
  },
  {
    "instruction": "Convert to progressive JPEG",
    "output": "convert input.jpg -interlace Plane output.jpg"
