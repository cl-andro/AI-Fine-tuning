[
  {"instruction": "Extract file content by inode", "output": "icat -o 2048 image.dd 256"},
  {"instruction": "Extract file and redirect to local file", "output": "icat -o 2048 image.dd 256 > extracted_file.bin"},
  {"instruction": "Extract file from unallocated space", "output": "icat -r -o 2048 image.dd 256"},
  {"instruction": "Find inode by filename", "output": "ifind -o 2048 image.dd /etc/passwd"},
  {"instruction": "Find inode by filename with deleted file", "output": "ifind -d -o 2048 image.dd /etc/shadow"},
  {"instruction": "Show inode/attribute details", "output": "istat -o 2048 image.dd 256"},
  {"instruction": "Show inode details for NTFS $MFT", "output": "istat -o 2048 image.dd 0"},
  {"instruction": "Show detailed inode with timestamps", "output": "istat -o 2048 image.dd 256 | grep -i time"},
  {"instruction": "Read directory entries from a directory inode", "output": "icat -o 2048 image.dd 512 | xxd | head -20"},
  {"instruction": "Read journal content from ext4", "output": "jcat -o 2048 image.dd"},
  {"instruction": "List entries in the journal", "output": "jls -o 2048 image.dd"},
  {"instruction": "List journal entries with details", "output": "jls -d -o 2048 image.dd"},
  {"instruction": "Extract specific journal block", "output": "jcat -o 2048 image.dd -b 1024"},
  {"instruction": "Search for inode by name case-insensitive", "output": "ifind -o 2048 image.dd -n 'PASSWD'"},
  {"instruction": "Find inode at a specific block", "output": "ifind -o 2048 image.dd -b 4096"},
  {"instruction": "Extract first 1KB of a file", "output": "icat -o 2048 image.dd 256 | dd bs=1024 count=1"},
  {"instruction": "Extract file to stdout and pipe to strings", "output": "icat -o 2048 image.dd 256 | strings"},
  {"instruction": "Compare directory listing of two inodes", "output": "fls -o 2048 image.dd 256 && fls -o 2048 image.dd 512"},
