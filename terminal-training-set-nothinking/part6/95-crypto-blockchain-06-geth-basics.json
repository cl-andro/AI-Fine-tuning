[
  {"instruction": "Check the Geth version", "output": "geth version"},
  {"instruction": "Create a new account in Geth", "output": "geth account new"},
  {"instruction": "Create a new Geth account with a specific password file", "output": "geth account new --password /home/eth/password.txt"},
  {"instruction": "List all Geth accounts", "output": "geth account list"},
  {"instruction": "Import an existing private key into Geth", "output": "geth account import /home/eth/privatekey.txt"},
  {"instruction": "Update a Geth account passphrase", "output": "geth account update 0x1234567890abcdef1234567890abcdef12345678"},
  {"instruction": "Start Geth with a custom data directory", "output": "geth --datadir /home/geth/data"},
  {"instruction": "Start Geth on a custom network ID", "output": "geth --datadir /home/geth/data --networkid 1337"},
  {"instruction": "Start Geth in light sync mode", "output": "geth --datadir /home/geth/data --syncmode light"},
  {"instruction": "Start Geth with archive gcmode", "output": "geth --datadir /home/geth/data --gcmode archive"},
  {"instruction": "Start Geth with HTTP RPC enabled", "output": "geth --datadir /home/geth/data --http --http.port 8545 --http.api eth,net,web3"},
  {"instruction": "Start Geth with HTTP on all interfaces", "output": "geth --datadir /home/geth/data --http --http.addr 0.0.0.0 --http.port 8545 --http.api eth,net,web3,personal --http.corsdomain \"*\""},
  {"instruction": "Start Geth with WebSocket enabled", "output": "geth --datadir /home/geth/data --ws --ws.port 8546 --ws.api eth,net,web3"},
  {"instruction": "Start Geth with WS on all interfaces", "output": "geth --datadir /home/geth/data --ws --ws.addr 0.0.0.0 --ws.port 8546 --ws.api eth,net,web3 --ws.origins \"*\""},
  {"instruction": "Start Geth with auth RPC for Engine API", "output": "geth --datadir /home/geth/data --authrpc.port 8551 --authrpc.addr 127.0.0.1 --authrpc.jwtsecret /home/eth/jwt.hex"},
  {"instruction": "Start Geth with bootnodes", "output": "geth --datadir /home/geth/data --bootnodes enode://pubkey@192.168.1.1:30303"},
  {"instruction": "Start Geth with max peers limit", "output": "geth --datadir /home/geth/data --maxpeers 50"},
  {"instruction": "Start Geth with NAT traversal", "output": "geth --datadir /home/geth/data --nat extip:203.0.113.10"},
  {"instruction": "Start Geth with cache size set", "output": "geth --datadir /home/geth/data --cache 2048"},
  {"instruction": "Start Geth with txpool settings", "output": "geth --datadir /home/geth/data --txpool.locals 0x1234567890abcdef1234567890abcdef12345678 --txpool.pricelimit 1"},
  {"instruction": "Start Geth with verbosity level", "output": "geth --datadir /home/geth/data --verbosity 3"},
  {"instruction": "Start Geth with metrics enabled", "output": "geth --datadir /home/geth/data --metrics --metrics.addr 0.0.0.0 --metrics.port 6060"},
  {"instruction": "Start Geth without peer discovery", "output": "geth --datadir /home/geth/data --nodiscover --maxpeers 0"},
  {"instruction": "Start Geth with IPC disabled", "output": "geth --datadir /home/geth/data --ipcdisable"},
  {"instruction": "Start Geth with a specific identity string", "output": "geth --datadir /home/geth/data --identity \"MyGethNode\""}
]
