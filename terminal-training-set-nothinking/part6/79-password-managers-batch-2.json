[
  {"instruction": "Generate a password with Bitwarden CLI", "output": "bw generate --length 30 --uppercase --lowercase --numbers --special"},
  {"instruction": "Generate a passphrase with Bitwarden CLI", "output": "bw generate --passphrase --words 6 --separator -"},
  {"instruction": "Export Bitwarden vault as JSON", "output": "bw export --format json --output /tmp/bw-export.json"},
  {"instruction": "Export Bitwarden vault as CSV", "output": "bw export --format csv --output /tmp/bw-export.csv"},
  {"instruction": "Import items into Bitwarden vault", "output": "bw import --formats csv /path/to/import.csv"},
  {"instruction": "Sync Bitwarden vault with server", "output": "bw sync"},
  {"instruction": "Confirm an item in Bitwarden", "output": "bw confirm --itemid abc123-def456"},
  {"instruction": "Bitwarden config setup for self-hosted", "output": "bw config server https://vault.example.com"},
  {"instruction": "Start the Bitwarden CLI local server", "output": "bw serve --port 8087"},
  {"instruction": "Add an account to 1Password CLI", "output": "op account add --address my.1password.com --email user@example.com --secret-key A3-XXXXX-XXXXX"},
  {"instruction": "List all 1Password accounts configured", "output": "op account list"},
  {"instruction": "Forget a specific 1Password account", "output": "op account forget --account my.1password.com"},
  {"instruction": "Sign in to 1Password CLI", "output": "op signin --account my.1password.com"},
  {"instruction": "Sign out of 1Password CLI", "output": "op signout"},
  {"instruction": "Create a new 1Password item (login)", "output": "op item create --category login --title 'My Database' --vault Private --username dbadmin --password 's3cret!'"},
  {"instruction": "Get a specific 1Password item", "output": "op item get 'My Database' --vault Private"},
  {"instruction": "List all items in a 1Password vault", "output": "op item list --vault Private"},
  {"instruction": "Edit a 1Password item title", "output": "op item edit 'My Database' --title 'Updated Database'"},
  {"instruction": "Delete a 1Password item", "output": "op item delete 'My Database' --vault Private"},
  {"instruction": "Get a 1Password document", "output": "op document get 'my-document-id' --vault Private --output /tmp/doc.pdf"},
  {"instruction": "Create a 1Password document", "output": "op document create /tmp/doc.pdf --title 'SSL Cert' --vault Private"},
  {"instruction": "Delete a 1Password document", "output": "op document delete 'my-document-id' --vault Private"},
  {"instruction": "List all 1Password vaults", "output": "op vault list"},
  {"instruction": "Get details of a specific 1Password vault", "output": "op vault get Private"},
  {"instruction": "List all 1Password groups", "output": "op group list"}
]
