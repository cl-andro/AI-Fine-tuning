[
  {"instruction": "Run ansible-lint on a playbook", "output": "ansible-lint playbook.yml"},
  {"instruction": "Run ansible-lint parsing a full project", "output": "ansible-lint ."},
  {"instruction": "Run ansible-lint with a rules dir", "output": "ansible-lint -r /path/to/custom-rules playbook.yml"},
  {"instruction": "Run ansible-lint with verbose output", "output": "ansible-lint -v playbook.yml"},
  {"instruction": "Run ansible-lint without rules", "output": "ansible-lint -x 503,702 playbook.yml"},
  {"instruction": "Run terrascan on IaC directory", "output": "terrascan scan -i terraform -d ."},
  {"instruction": "Run terrascan with config file", "output": "terrascan scan -c config.toml -d ."},
  {"instruction": "Run terrascan scanning Kubernetes YAML", "output": "terrascan scan -i k8s -f deployment.yaml"},
  {"instruction": "Run tfsec on Terraform directory", "output": "tfsec ."},
  {"instruction": "Run tfsec with concise output", "output": "tfsec --concise-output ."},
  {"instruction": "Run tfsec with custom config", "output": "tfsec --config-file .tfsec/config.json ."},
  {"instruction": "Run tfsec with JSON output", "output": "tfsec --format json . > tfsec-report.json"},
  {"instruction": "Run checkov on a Terraform directory", "output": "checkov -d ."},
  {"instruction": "Run checkov on a specific file", "output": "checkov -f main.tf"},
  {"instruction": "Run checkov with config file", "output": "checkov -d . --config-file .checkov.yml"},
  {"instruction": "Run checkov with soft fail", "output": "checkov -d . --soft-fail"},
  {"instruction": "Run checkov with external checks directory", "output": "checkov -d . --external-checks-dir custom-checks/"},
  {"instruction": "Run trivy config scan on infrastructure dir", "output": "trivy config ."},
  {"instruction": "Run trivy config scan with severity filter", "output": "trivy config --severity CRITICAL,HIGH ."},
  {"instruction": "Run trivy config scanning and output to SARIF", "output": "trivy config --format sarif --output result.sarif ."},
  {"instruction": "Run conftest against a policy dir", "output": "conftest test --policy policy/ deployment.yaml"},
  {"instruction": "Run conftest with namespace", "output": "conftest test --namespace mynamespace --policy policy/ deployment.yaml"},
  {"instruction": "Run conftest with all-namespaces", "output": "conftest test --all-namespaces --policy policy/ terraform/"},
  {"instruction": "Run OPA eval against a policy", "output": "opa eval --data policy.rego --input input.json 'data.example.deny'"},
  {"instruction": "Run OPA test on rego files", "output": "opa test ."}
