[
  {"instruction": "Transcode a video with HandBrakeCLI to H.265", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 -e x265 -q 22"},
  {"instruction": "Convert video to MP4 using HandBrakeCLI with Fast 1080p30 preset", "output": "HandBrakeCLI -i input.mkv -o output.mp4 --preset Fast 1080p30"},
  {"instruction": "HandBrakeCLI set constant quality to 20", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 -q 20"},
  {"instruction": "HandBrakeCLI set frame rate to 30 fps", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 -r 30"},
  {"instruction": "HandBrakeCLI encode to MKV format", "output": "HandBrakeCLI -i input.mp4 -o output.mkv --format mkv"},
  {"instruction": "HandBrakeCLI include subtitle track 1", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --subtitle 1"},
  {"instruction": "HandBrakeCLI select audio track and encoder", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --audio 1 --aencoder av_aac"},
  {"instruction": "HandBrakeCLI auto-crop the video", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --crop 0:0:0:0"},
  {"instruction": "HandBrakeCLI enable decomb filter", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --decomb"},
  {"instruction": "HandBrakeCLI apply NL-Means denoise light", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --denoise nlmeans --denoise-tune light"},
  {"instruction": "HandBrakeCLI set video bitrate to 5000 kbps", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --vb 5000"},
  {"instruction": "HandBrakeCLI set audio bitrate to 256 kbps", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --ab 256"},
  {"instruction": "HandBrakeCLI set audio encoder to copy passthrough", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --aencoder copy"},
  {"instruction": "HandBrakeCLI list all available presets", "output": "HandBrakeCLI --preset-list"},
  {"instruction": "HandBrakeCLI encode with the HQ 1080p preset", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --preset HQ 1080p30 Surround"},
  {"instruction": "HandBrakeCLI set encoder level to 4.1", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 -e x264 --encoder-level 4.1"},
  {"instruction": "HandBrakeCLI encode a segment from 10s to 30s", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --start-at duration:10 --stop-at duration:20"},
  {"instruction": "HandBrakeCLI set encoder profile to high", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 -e x264 --encoder-profile high"},
  {"instruction": "HandBrakeCLI enable hqdn3d denoising", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --denoise hqdn3d"},
  {"instruction": "HandBrakeCLI burn-in the first subtitle", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --subtitle 1 --subtitle-burned"},
  {"instruction": "HandBrakeCLI select multiple audio tracks", "output": "HandBrakeCLI -i input.mp4 -o output.mp4 --audio 1,2 --aencoder copy,copy:av_aac"},
  {"instruction": "HandBrakeCLI show all possible encoders", "output": "HandBrakeCLI --encoder-list"}
]
