[
  {
    "instruction": "Create a circusd ini with multiple watchers",
    "output": "echo -e '[watcher:web]\ncmd = gunicorn app:main\nnumprocesses = 4\n\n[watcher:worker]\ncmd = celery worker\nnumprocesses = 2' > /etc/circus.ini"
  },
  {
    "instruction": "Configure Circus HTTP streaming endpoint",
    "output": "echo -e '[circus]\nhttpd = True\nhttpd_host = 127.0.0.1\nhttpd_port = 8080' >> /etc/circus.ini"
  },
  {
    "instruction": "Set Circus arbiter loglevel",
    "output": "echo -e '[circus]\nloglevel = DEBUG' >> /etc/circus.ini"
  },
  {
    "instruction": "Configure Circus watcher stdin/out/inheritance",
    "output": "echo -e '[watcher:myapp]\nstdout_stream.class = FileStream\nstdout_stream.filename = /var/log/myapp/stdout.log' >> /etc/circus.ini"
  },
  {
    "instruction": "Set Circus watcher close fds",
    "output": "echo 'closefds = True' >> /etc/circus.ini"
  },
  {
    "instruction": "Set Circus watcher working directory",
    "output": "echo 'working_dir = /opt/myapp' >> /etc/circus.ini"
  },
  {
    "instruction": "Set Circus watcher shell execution",
    "output": "echo 'shell = True' >> /etc/circus.ini"
  },
  {
    "instruction": "Set Circus watcher virtualenv",
    "output": "echo 'virtualenv = /opt/venv' >> /etc/circus.ini"
  },
  {
    "instruction": "Set Circus watcher uid/gid",
    "output": "echo -e 'uid = www-data\ngid = www-data' >> /etc/circus.ini"
  },
  {
    "instruction": "Stop a sysvinit service from /etc/init.d direct",
    "output": "/etc/init.d/ssh stop"
  },
  {
    "instruction": "Check sysvinit service PID via status",
    "output": "/etc/init.d/cron status"
  },
  {
    "instruction": "Enable sysvinit service via insserv with custom order",
    "output": "insserv -o 20 80 apache2"
  },
  {
    "instruction": "Check if insserv service is installed",
    "output": "insserv -c apache2"
  },
  {
    "instruction": "Verify sysvinit script syntax",
    "output": "/etc/init.d/myapp status > /dev/null 2>&1; echo 'Syntax OK'"
  },
  {
    "instruction": "Reload sysvinit configuration without restart",
    "output": "service apache2 reload"
  },
  {
    "instruction": "Check OpenRC default runlevel services",
    "output": "rc-update -s default"
  },
  {
    "instruction": "Override OpenRC service command args",
    "output": "echo 'command_args=\"--debug\"' >> /etc/conf.d/myapp"
  },
  {
    "instruction": "Enable OpenRC service debug logging",
    "output": "echo 'rc_logger=YES' >> /etc/rc.conf"
  },
  {
    "instruction": "Set OpenRC service timeout",
    "output": "echo 'rc_timeout=60' >> /etc/conf.d/myapp"
  },
  {
    "instruction": "Create an OpenRC supervisor-service",
    "output": "echo -e '"
  },
  {
    "instruction": "Enable OpenRC parallel startup",
    "output": "echo 'rc_parallel=YES' >> /etc/rc.conf"
  },
  {
    "instruction": "Configure OpenRC to run command on boot",
    "output": "rc-update add local default && echo 'mycommand &' >> /etc/local.d/mycommand.start"
  },
  {
    "instruction": "Mark OpenRC service as inactive temporarily",
    "output": "rc-service myapp --no-reexecute stop"
  },
  {
    "instruction": "Check runit service summary",
    "output": "sv status /etc/service/*"
  },
  {
    "instruction": "Enable runit service by removing down file",
    "output": "rm /etc/service/myservice/down"
  },
  {
    "instruction": "Disable runit service by creating down file",
    "output": "touch /etc/service/myservice/down"
  }
]