    "output": "montage *.jpg -tile 3x3 -frame 5x5 -geometry 200x200 montage_frame.jpg"
  },
  {
    "instruction": "Composite image A over B at offset",
    "output": "composite -geometry +50+50 overlay.png background.jpg output.jpg"
  },
  {
    "instruction": "Composite with gravity center",
    "output": "composite -gravity center watermark.png input.jpg output.jpg"
  },
  {
