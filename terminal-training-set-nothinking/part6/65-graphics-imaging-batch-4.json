[
  {
    "instruction": "Create a 2x2 montage of 4 images",
    "output": "montage img1.jpg img2.jpg img3.jpg img4.jpg -tile 2x2 -geometry 200x200+2+2 montage.jpg"
  },
  {
    "instruction": "Create a contact sheet with labels",
    "output": "montage *.jpg -tile 4x5 -geometry 150x150+3+3 -label '%f' contact_sheet.jpg"
  },
  {
