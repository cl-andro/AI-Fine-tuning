[
  {"instruction": "Join a domain as a member server", "output": "samba-tool domain join dc.example.com MEMBER -U administrator"},
  {"instruction": "Join a domain as a DC", "output": "samba-tool domain join dc.example.com DC -U administrator --dns-backend=SAMBA_INTERNAL"},
  {"instruction": "Leave a domain", "output": "samba-tool domain leave -U administrator"},
  {"instruction": "Show domain info", "output": "samba-tool domain info 192.168.1.1"},
  {"instruction": "Show domain level", "output": "samba-tool domain level show"},
  {"instruction": "Create a new domain user", "output": "samba-tool user create jdoe 'P@ssw0rd!'"},
  {"instruction": "Delete a domain user", "output": "samba-tool user delete jdoe"},
  {"instruction": "List all domain users", "output": "samba-tool user list"},
  {"instruction": "Enable a disabled user account", "output": "samba-tool user enable jdoe"},
  {"instruction": "Disable a user account", "output": "samba-tool user disable jdoe"},
  {"instruction": "Set a user's password", "output": "samba-tool user setpassword jdoe --newpassword='N3wP@ss!'"},
  {"instruction": "List groups for a user", "output": "samba-tool user listgroups jdoe"},
  {"instruction": "Create a user with specific OU", "output": "samba-tool user create jdoe 'P@ssw0rd!' --ou=OU=Users,DC=example,DC=com"},
  {"instruction": "Set user's expiry date", "output": "samba-tool user setexpiry jdoe --days=30"},
  {"instruction": "Get user's primary group", "output": "samba-tool user getprimarygroup jdoe"},
  {"instruction": "Set user's primary group", "output": "samba-tool user setprimarygroup jdoe 'Domain Admins'"},
  {"instruction": "Move a user to a different OU", "output": "samba-tool user move jdoe 'OU=Contractors,DC=example,DC=com'"},
  {"instruction": "Show user attributes", "output": "samba-tool user show jdoe --attributes=displayName,mail"},
  {"instruction": "List enabled users only", "output": "samba-tool user list --given-name=*"},
  {"instruction": "Sync user password to all DCs", "output": "samba-tool user syncpasswords jdoe"}
]