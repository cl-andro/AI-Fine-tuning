[
  {"instruction": "Generate a new Bitcoin address", "output": "bitcoin-cli getnewaddress"},
  {"instruction": "Generate a new bech32m address", "output": "bitcoin-cli getnewaddress \"\" bech32m"},
  {"instruction": "Generate a new legacy address", "output": "bitcoin-cli getnewaddress \"\" legacy"},
  {"instruction": "Validate a bitcoin address", "output": "bitcoin-cli validateaddress bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq"},
  {"instruction": "Get wallet information", "output": "bitcoin-cli getwalletinfo"},
  {"instruction": "List all wallet addresses", "output": "bitcoin-cli listaddressgroupings"},
  {"instruction": "Import a wallet from a dump file", "output": "bitcoin-cli importwallet /home/user/wallet_backup.dat"},
  {"instruction": "Dump wallet to a file", "output": "bitcoin-cli dumpwallet /home/user/bitcoin_wallet_dump.txt"},
  {"instruction": "Rescan the blockchain for wallet transactions", "output": "bitcoin-cli rescanblockchain"},
  {"instruction": "Rescan from a specific block height", "output": "bitcoin-cli rescanblockchain 680000"},
  {"instruction": "Set a ban on an IP address", "output": "bitcoin-cli setban 192.168.1.100 add"},
  {"instruction": "Remove a ban on an IP address", "output": "bitcoin-cli setban 192.168.1.100 remove"},
  {"instruction": "List all banned IPs", "output": "bitcoin-cli listbanned"},
  {"instruction": "Disconnect a peer by node ID", "output": "bitcoin-cli disconnectnode 1234"},
  {"instruction": "Add a node to the peer list", "output": "bitcoin-cli addnode 192.168.1.200 add"},
  {"instruction": "Remove a node from the peer list", "output": "bitcoin-cli addnode 192.168.1.200 remove"},
  {"instruction": "Get connection count", "output": "bitcoin-cli getconnectioncount"},
  {"instruction": "Get network statistics", "output": "bitcoin-cli getnettotals"},
  {"instruction": "Get information about the wallet's keypool", "output": "bitcoin-cli getwalletinfo | grep -i keypool"},
  {"instruction": "Encrypt the wallet with a passphrase", "output": "bitcoin-cli encryptwallet \"my-strong-passphrase\""},
  {"instruction": "Unlock the wallet for 60 seconds", "output": "bitcoin-cli walletpassphrase \"my-strong-passphrase\" 60"},
  {"instruction": "Change the wallet passphrase", "output": "bitcoin-cli walletpassphrasechange \"old-pass\" \"new-pass\""},
  {"instruction": "Backup the wallet to a specified path", "output": "bitcoin-cli backupwallet /backup/wallet_2026.dat"},
  {"instruction": "Import a private key into the wallet", "output": "bitcoin-cli importprivkey 5KYZdUEo39z3FPrtuX2QbbwGnNP5zTd7yyr2SC1j299sBCnWjss"},
  {"instruction": "Get address information including public key", "output": "bitcoin-cli getaddressinfo bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq"}
