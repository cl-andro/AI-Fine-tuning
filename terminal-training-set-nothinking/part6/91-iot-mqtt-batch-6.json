[
  {"instruction": "Install Eclipse Kanto from APT repository", "output": "echo 'deb https://download.eclipse.org/kanto/releases/latest/debian bookworm main' | sudo tee /etc/apt/sources.list.d/kanto.list && sudo apt update && sudo apt install kanto-cm kanto-mqtt"},
  {"instruction": "Start Eclipse Kanto MQTT bridge", "output": "sudo systemctl start kanto-mqtt && sudo systemctl enable kanto-mqtt"},
  {"instruction": "Configure Eclipse Kanto MQTT bridge", "output": "sudo nano /etc/kanto/mqtt/config.json"},
  {"instruction": "Stop Eclipse Kanto container", "output": "sudo kanto-cm stop my-container"},
  {"instruction": "Remove Eclipse Kanto container", "output": "sudo kanto-cm rm my-container"},
  {"instruction": "View Eclipse Kanto container logs", "output": "sudo kanto-cm logs my-container"},
  {"instruction": "Check Kanto MQTT bridge connectivity", "output": "mosquitto_pub --topic 'kanto/ping' --message 'ping' && mosquitto_sub --topic 'kanto/pong' -C 1"},
  {"instruction": "Install EdgeX Foundry snap", "output": "sudo snap install edgexfoundry"},
  {"instruction": "Check EdgeX services status", "output": "sudo snap run edgexfoundry.status"},
  {"instruction": "Restart EdgeX core service", "output": "sudo snap restart edgexfoundry.edgex-core-data"},
  {"instruction": "Get EdgeX metrics via EdgeX CLI", "output": "sudo edgex-cli metrics"},
  {"instruction": "List EdgeX device profiles", "output": "sudo edgex-cli profile list"},
  {"instruction": "Delete EdgeX device", "output": "sudo edgex-cli device rm --name MyDevice"},
  {"instruction": "Add EdgeX provision watcher", "output": "sudo edgex-cli watcher add --name HTTP-Watcher --profile Random-Device --service core-device --identifiers '{\"Protocol\":\"HTTP\"}'"},
  {"instruction": "Get EdgeX event count via CLI", "output": "sudo edgex-cli event count"},
  {"instruction": "Install balenaEtcher CLI", "output": "sudo apt install balena-etcher-electron"},
  {"instruction": "Flash OS image to SD card with balenaEtcher CLI", "output": "balena-etcher /path/to/raspios.img --drive /dev/sdX --yes"},
  {"instruction": "Balena deploy fleet via CLI", "output": "balena deploy myFleet --source /my/app"},
  {"instruction": "Balena list application releases", "output": "balena releases list myApp"},
  {"instruction": "Balena device logs in realtime", "output": "balena logs myDevice"},
  {"instruction": "ESPHome dashboard start", "output": "esphome dashboard /config/esphome"},
  {"instruction": "ESPHome clean build cache", "output": "esphome clean mydevice.yaml"},
  {"instruction": "ESPHome compile without uploading", "output": "esphome compile mydevice.yaml"},
  {"instruction": "List ESPHome connected devices via serial", "output": "esphome --list-devices"}
]
