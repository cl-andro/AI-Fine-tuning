[
  {"instruction": "Create index in cqlsh (Cassandra)", "output": "CREATE INDEX ON myapp.users (email);"},
  {"instruction": "Truncate table in cqlsh", "output": "TRUNCATE myapp.users;"},
  {"instruction": "Drop keyspace in cqlsh", "output": "DROP KEYSPACE IF EXISTS myapp;"},
  {"instruction": "Connect with cqlsh using authentication", "output": "cqlsh -u cassandra -p cassandra localhost 9042"},
  {"instruction": "Install InfluxDB CLI on Debian 12", "output": "sudo apt install influxdb2-cli"},
  {"instruction": "Connect to InfluxDB with influx CLI", "output": "influx config create -n default -u http://localhost:8086 -o myorg -t mytoken"},
  {"instruction": "List InfluxDB buckets", "output": "influx bucket list"},
  {"instruction": "Query InfluxDB with Flux", "output": "influx query 'from(bucket:\"sensor\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"temperature\")'"},
  {"instruction": "Write data to InfluxDB from CLI", "output": "influx write -b sensor -m temperature,location=office value=22.5"},
  {"instruction": "Write data to InfluxDB from file", "output": "influx write -b sensor -f /data/sensor_data.line"},
  {"instruction": "Create InfluxDB bucket", "output": "influx bucket create -n metrics -r 30d"},
  {"instruction": "List InfluxDB organizations", "output": "influx org list"},
  {"instruction": "List InfluxDB users", "output": "influx user list"},
  {"instruction": "Create InfluxDB API token", "output": "influx auth create -o myorg --write-buckets --read-buckets"},
  {"instruction": "Install ClickHouse client on Debian 12", "output": "sudo apt install clickhouse-client"},
  {"instruction": "Connect to ClickHouse with clickhouse-client", "output": "clickhouse-client --host localhost --port 9000 --user default --password mypass"},
  {"instruction": "List databases in ClickHouse", "output": "clickhouse-client -q 'SHOW DATABASES;'"},
  {"instruction": "List tables in ClickHouse", "output": "clickhouse-client -q 'SHOW TABLES FROM mydb;'"},
  {"instruction": "Describe ClickHouse table schema", "output": "clickhouse-client -q 'DESCRIBE TABLE mydb.events;'"},
  {"instruction": "SELECT query in ClickHouse", "output": "clickhouse-client -q 'SELECT count(), toDate(timestamp) AS day FROM mydb.events WHERE event_type = \"click\" GROUP BY day ORDER BY day;'"},
  {"instruction": "Create ClickHouse MergeTree table", "output": "clickhouse-client -q 'CREATE TABLE mydb.events (id UUID, event_type String, timestamp DateTime) ENGINE = MergeTree() ORDER BY timestamp;'"},
  {"instruction": "Insert data into ClickHouse", "output": "clickhouse-client -q 'INSERT INTO mydb.events VALUES (generateUUIDv4(), \"click\", now());'"},
  {"instruction": "Import CSV into ClickHouse", "output": "clickhouse-client --query 'INSERT INTO mydb.events FORMAT CSV' < /home/events.csv"},
  {"instruction": "Export ClickHouse query to CSV", "output": "clickhouse-client -q 'SELECT * FROM mydb.events FORMAT CSVWithNames' > /tmp/events_export.csv"},
  {"instruction": "Check ClickHouse system metrics", "output": "clickhouse-client -q 'SELECT * FROM system.metrics LIMIT 10;'"}
]
