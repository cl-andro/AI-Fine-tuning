[
  {"instruction": "Probe a GlusterFS server to add it to the trusted pool", "output": "gluster peer probe gluster-node2"},
  {"instruction": "Detach a peer from the GlusterFS trusted pool", "output": "gluster peer detach gluster-node2"},
  {"instruction": "Show GlusterFS peer status", "output": "gluster peer status"},
  {"instruction": "Create a GlusterFS distributed volume", "output": "gluster volume create gvol1 transport tcp gluster-node1:/brick1 gluster-node2:/brick2"},
  {"instruction": "Create a GlusterFS replicated volume with replica 2", "output": "gluster volume create gvol1 replica 2 gluster-node1:/brick1 gluster-node2:/brick2"},
  {"instruction": "Create a GlusterFS distributed-replicated volume", "output": "gluster volume create gvol1 replica 2 gluster-node1:/brick1 gluster-node2:/brick2 gluster-node3:/brick3 gluster-node4:/brick4"},
  {"instruction": "Create a GlusterFS striped volume", "output": "gluster volume create gvol1 stripe 2 gluster-node1:/brick1 gluster-node2:/brick2"},
  {"instruction": "Start a GlusterFS volume", "output": "gluster volume start gvol1"},
  {"instruction": "Stop a GlusterFS volume", "output": "gluster volume stop gvol1"},
  {"instruction": "Delete a GlusterFS volume", "output": "gluster volume delete gvol1"},
  {"instruction": "Show GlusterFS volume information", "output": "gluster volume info gvol1"},
  {"instruction": "Show GlusterFS volume status", "output": "gluster volume status gvol1"},
  {"instruction": "Show GlusterFS volume heal information", "output": "gluster volume heal gvol1 info"},
  {"instruction": "Trigger GlusterFS self-heal on a volume", "output": "gluster volume heal gvol1 full"},
  {"instruction": "Set a GlusterFS volume option", "output": "gluster volume set gvol1 performance.cache-size 256MB"},
  {"instruction": "Reset a GlusterFS volume option to default", "output": "gluster volume reset gvol1 performance.cache-size"},
  {"instruction": "Start GlusterFS volume rebalance", "output": "gluster volume rebalance gvol1 start"},
  {"instruction": "Check GlusterFS rebalance status", "output": "gluster volume rebalance gvol1 status"},
  {"instruction": "Stop GlusterFS volume rebalance", "output": "gluster volume rebalance gvol1 stop"},
  {"instruction": "Enable GlusterFS quota on a volume", "output": "gluster volume quota gvol1 enable"},
  {"instruction": "Set a GlusterFS quota limit on a directory", "output": "gluster volume quota gvol1 limit-usage /data 10GB"},
  {"instruction": "List GlusterFS quota limits", "output": "gluster volume quota gvol1 list"},
  {"instruction": "Show GlusterFS volume top open files", "output": "gluster volume top gvol1 open"},
  {"instruction": "Show GlusterFS volume top read performance", "output": "gluster volume top gvol1 read"},
  {"instruction": "Start GlusterFS volume profiling", "output": "gluster volume profile gvol1 start"}
