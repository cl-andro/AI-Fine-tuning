[
  {"instruction": "Get Bitcoin Core blockchain info", "output": "bitcoin-cli getblockchaininfo"},
  {"instruction": "Get the current block count", "output": "bitcoin-cli getblockcount"},
  {"instruction": "Get the block hash at a specific height", "output": "bitcoin-cli getblockhash 680000"},
  {"instruction": "Get full block details by hash", "output": "bitcoin-cli getblock 0000000000000000000a2c7b8e9d10f1c2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7"},
  {"instruction": "Get raw transaction data by TXID", "output": "bitcoin-cli getrawtransaction a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123"},
  {"instruction": "Decode a raw transaction hex", "output": "bitcoin-cli decoderawtransaction 020000000001010000..."},
  {"instruction": "Get transaction output details", "output": "bitcoin-cli gettxout a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123 0"},
  {"instruction": "Estimate a smart fee for 6 blocks", "output": "bitcoin-cli estimatesmartfee 6"},
  {"instruction": "Get a brief summary of Bitcoin Core info", "output": "bitcoin-cli -getinfo"},
  {"instruction": "Get the mining info", "output": "bitcoin-cli getmininginfo"},
  {"instruction": "Get the current difficulty", "output": "bitcoin-cli getdifficulty"},
  {"instruction": "Get the mempool information", "output": "bitcoin-cli getmempoolinfo"},
  {"instruction": "Get network info", "output": "bitcoin-cli getnetworkinfo"},
  {"instruction": "Get connected peer info", "output": "bitcoin-cli getpeerinfo"},
  {"instruction": "Get chain tips", "output": "bitcoin-cli getchaintips"},
  {"instruction": "Get chain TX stats", "output": "bitcoin-cli getchaintxstats"},
  {"instruction": "Get the server uptime", "output": "bitcoin-cli uptime"},
  {"instruction": "Check Bitcoin Core version", "output": "bitcoin-cli -version"},
  {"instruction": "Check mempool entry for a specific TXID", "output": "bitcoin-cli getmempoolentry a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123"},
  {"instruction": "Derive index info for a block", "output": "bitcoin-cli getblockheader 0000000000000000000a2c7b8e9d10f1c2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7"},
  {"instruction": "Stop Bitcoin Core daemon", "output": "bitcoin-cli stop"},
  {"instruction": "Get the current block template for mining", "output": "bitcoin-cli getblocktemplate {\"rules\":[\"segwit\"]}"},
  {"instruction": "Generate n blocks (regtest/testnet)", "output": "bitcoin-cli -generate 101"},
  {"instruction": "Get best block hash", "output": "bitcoin-cli getbestblockhash"},
  {"instruction": "Get raw mempool transactions", "output": "bitcoin-cli getrawmempool"}
]
