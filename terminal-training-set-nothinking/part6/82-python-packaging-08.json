[
  {"instruction": "Install pip on Debian 12", "output": "sudo apt install python3-pip"},
  {"instruction": "Install python3-venv", "output": "sudo apt install python3-venv"},
  {"instruction": "Check pip version", "output": "pip --version"},
  {"instruction": "Get pip help", "output": "pip --help"},
  {"instruction": "List installed pip packages with pip", "output": "pip list --format=columns"},
  {"instruction": "Upgrade pip itself", "output": "pip install --upgrade pip"},
  {"instruction": "Install a package with constraints", "output": "pip install -c constraints.txt requests"},
  {"instruction": "Install with requirement specifier", "output": "pip install 'requests>=2.28,<3.0'"},
  {"instruction": "Install wheels from a local directory", "output": "pip install --no-index --find-links=/tmp/wheels/ mypackage"},
  {"instruction": "Install with no compile", "output": "pip install --no-compile requests"},
  {"instruction": "Install with progress bar off", "output": "pip install --progress-bar off requests"},
  {"instruction": "Install with dry run", "output": "pip install --dry-run requests"},
  {"instruction": "Show pip requirements for a package", "output": "pip show --requirements requests"},
  {"instruction": "Verify installed packages integrity", "output": "pip verify requests"},
  {"instruction": "Build a wheel and install locally", "output": "pip wheel --no-deps . && pip install --no-index --find-links=./wheelhouse mypackage"},
  {"instruction": "Cache list pip", "output": "pip cache list"},
  {"instruction": "Remove a specific wheel from cache", "output": "pip cache remove requests"},
  {"instruction": "Install pipdeptree for dep visualization", "output": "pip install pipdeptree"},
  {"instruction": "Show dependency tree", "output": "pipdeptree"},
  {"instruction": "Show reverse dependency tree", "output": "pipdeptree --reverse"}
]
