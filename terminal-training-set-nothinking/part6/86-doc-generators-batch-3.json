[
  {"instruction": "Initialize a new mdBook project", "output": "mdbook init mybook --title 'My Book'"},
  {"instruction": "Initialize mdBook project without gitignore", "output": "mdbook init mybook --title 'My Book' --ignore=none"},
  {"instruction": "Build the mdBook static site", "output": "mdbook build mybook"},
