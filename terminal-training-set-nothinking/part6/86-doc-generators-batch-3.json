  {"instruction": "Watch mdBook source and auto-rebuild", "output": "mdbook watch mybook"},
  {"instruction": "Clean mdBook build artifacts", "output": "mdbook clean mybook"},
  {"instruction": "Run mdBook tests (rustdoc examples)", "output": "mdbook test mybook"},
  {"instruction": "Set the mdBook title in book.toml", "output": "echo -e '[book]\ntitle = \"My Book\"' > mybook/book.toml"},
  {"instruction": "Set mdBook output HTML theme", "output": "echo -e '[output.html]\ntheme = \"navy\"' >> mybook/book.toml"},
