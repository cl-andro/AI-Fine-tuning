[
  {"instruction": "Show all registered RPC programs", "output": "rpcinfo -p 192.168.1.100"},
  {"instruction": "Show all RPC services with details", "output": "rpcinfo -s 192.168.1.100"},
  {"instruction": "Check a TCP RPC service", "output": "rpcinfo -t server.example.com nfs"},
  {"instruction": "Check a UDP RPC service", "output": "rpcinfo -u server.example.com nfs"},
  {"instruction": "Show RPC with program number", "output": "rpcinfo -n 100003 server.example.com"},
  {"instruction": "Delete an RPC registration", "output": "rpcinfo -d 100003 4"},
  {"instruction": "Broadcast an RPC ping", "output": "rpcinfo -b 100003 4"},
  {"instruction": "Check RPC service on a specific version", "output": "rpcinfo -t server.example.com 100003 3"},
  {"instruction": "Show RPC with transport info", "output": "rpcinfo -m server.example.com"},
  {"instruction": "Check RPC using TCP explicitly", "output": "rpcinfo -T tcp server.example.com nfs"},
  {"instruction": "List all RPC services on localhost", "output": "rpcinfo -p localhost"},
  {"instruction": "Check if portmapper is running", "output": "rpcinfo -p server.example.com | grep portmapper"},
  {"instruction": "Show all RPC services with version info", "output": "rpcinfo -s server.example.com"},
  {"instruction": "Check NFS service on remote server", "output": "rpcinfo -u nfs-server nfs 3"},
  {"instruction": "Verify mountd RPC service", "output": "rpcinfo -t server.example.com mountd"},
  {"instruction": "Check rquotad service", "output": "rpcinfo -t server.example.com rquotad"},
  {"instruction": "Broadcast query for NFS services", "output": "rpcinfo -b 100003 3 2>/dev/null"},
  {"instruction": "Check if NFSv4 callback is registered", "output": "rpcinfo -t server.example.com nfs 4"},
  {"instruction": "Show RPC stats on server", "output": "rpcinfo -s -T udp server.example.com"},
  {"instruction": "List services with port numbers", "output": "rpcinfo -p server.example.com | sort -k 2"},
  {"instruction": "Check all NFS-related RPC services", "output": "rpcinfo -p server.example.com | grep -E '(nfs|mount|rquota|nlock)'"}
]