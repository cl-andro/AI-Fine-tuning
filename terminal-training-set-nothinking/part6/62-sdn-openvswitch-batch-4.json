[
  {
    "instruction": "Show OVSDB schema version",
    "output": "ovsdb-tool schema-version /etc/openvswitch/conf.db"
  },
  {
    "instruction": "List all tables in the OVSDB",
    "output": "ovsdb-tool list-tables /etc/openvswitch/conf.db"
  },
  {
    "instruction": "Dump all records from Bridge table",
    "output": "ovsdb-tool dump /etc/openvswitch/conf.db Bridge"
  },
  {
    "instruction": "Create a new OVSDB file",
    "output": "ovsdb-tool create /etc/openvswitch/conf.db"
  },
  {
    "instruction": "Compact the OVS database",
    "output": "ovsdb-tool compact /etc/openvswitch/conf.db"
  },
  {
    "instruction": "Check the OVSDB consistency",
    "output": "ovsdb-tool check-consistency /etc/openvswitch/conf.db"
  },
  {
    "instruction": "Query OVSDB for bridge table records",
    "output": "ovsdb-tool query /etc/openvswitch/conf.db '{\"op\":\"select\",\"table\":\"Bridge\"}'"
  },
  {
    "instruction": "Show OVSDB database mode",
    "output": "ovsdb-tool db-mode /etc/openvswitch/conf.db"
  },
  {
    "instruction": "Create a self-signed certificate with ovs-pki",
    "output": "ovs-pki init"
  },
  {
    "instruction": "Sign a certificate request with ovs-pki",
    "output": "ovs-pki sign controller"
  },
  {
    "instruction": "Create a switch certificate",
    "output": "ovs-pki req+sign switch"
  },
  {
    "instruction": "Decode a TCP dump with ovs-tcpundump",
    "output": "ovs-tcpundump < /tmp/capture.pcap"
  },
  {
    "instruction": "Read a pcap file as OpenFlow packets",
    "output": "ovs-tcpundump -i eth0 -r /tmp/trace.pcap"
  },
  {
    "instruction": "Dump OFPST_DESC from a switch",
    "output": "ovs-ofctl show br0"
  },
  {
    "instruction": "Install an OpenFlow meter entry",
    "output": "ovs-ofctl add-meter br0 'meter=1 kbps burst stats bands=type=drop rate=1000'"
  },
  {
    "instruction": "Add a group table entry",
    "output": "ovs-ofctl add-group br0 'group_id=1,type=select,bucket=output:1,bucket=output:2'"
  },
  {
    "instruction": "Query a specific meter",
    "output": "ovs-ofctl dump-meters br0"
  },
  {
    "instruction": "Dump group statistics",
    "output": "ovs-ofctl dump-groups br0"
  },
  {
    "instruction": "Read OpenFlow table features",
    "output": "ovs-ofctl queue-stats br0 all"
  },
  {
    "instruction": "Show OpenFlow queue configuration",
    "output": "ovs-ofctl queue-get-config br0 1"
  },
  {
    "instruction": "Add a flow with OF instruction WriteMetadata",
    "output": "ovs-ofctl add-flow br0 'table=0,write_metadata:0xdeadbeef/0xffffffff,actions=resubmit(,1)'"
  },
  {
    "instruction": "View OVSDB server log",
    "output": "ovsdb-tool show-log /etc/openvswitch/conf.db"
  }
]