[
  {"instruction": "Show all shares anonymously", "output": "smbclient -N -L //192.168.1.1"},
  {"instruction": "Connect with SMB2 protocol", "output": "smbclient //server/share -U user -m SMB2"},
  {"instruction": "Read a remote file and pipe to local command", "output": "smbclient //server/share -N -c 'get logfile -' | grep error"},
  {"instruction": "Download entire directory recursively", "output": "smbclient //server/share -U user -c 'recurse; prompt; mget *'"},
  {"instruction": "Upload a directory recursively", "output": "smbclient //server/share -U user -c 'recurse; prompt; mput localdir/*'"},
  {"instruction": "Show file with absolute path listing", "output": "smbclient //server/share -U user -c 'ls Documents'"},
  {"instruction": "Connect with specified port and IP", "output": "smbclient //server/share -U user -p 139 -I 10.0.0.1"},
  {"instruction": "Use ntlmv2 authentication", "output": "smbclient //server/share -U user --option 'client ntlmv2 auth=yes'"},
  {"instruction": "Set maximum protocol version", "output": "smbclient -L //server -U user --option 'client max protocol=SMB3'"},
  {"instruction": "Disable SPNEGO", "output": "smbclient //server/share -U user --option 'client use spnego=no'"},
  {"instruction": "Check connection with signing required", "output": "smbclient //server/share -U user --option 'client signing=required'"},
  {"instruction": "Rename a remote file", "output": "smbclient //server/share -U user -c 'rename oldname newname'"},
  {"instruction": "Print working directory remotely", "output": "smbclient //server/share -U user -c pwd"},
  {"instruction": "Show file permissions remotely", "output": "smbclient //server/share -U user -c 'allinfo file.txt'"},
  {"instruction": "Set archive bit on remote file", "output": "smbclient //server/share -U user -c 'setmode file.txt +a'"},
  {"instruction": "Restore from tar backup", "output": "smbclient //server/share -U user -c 'tarmode full; tar x backup.tar'"},
  {"instruction": "List shares with machine account", "output": "smbclient -L //server -k -U 'MACHINE$'"},
  {"instruction": "Connect with timeout option", "output": "smbclient //server/share -U user --option 'socket options=TCP_NODELAY'"},
  {"instruction": "Use a credentials file", "output": "smbclient //server/share -A /path/to/credentials.file"},
  {"instruction": "Query a workgroup server", "output": "smbclient -L //192.168.1.10 -W WORKGROUP -U user"},
  {"instruction": "Get a file and write to stdout", "output": "smbclient //server/share -U user -c 'get readme.txt /dev/stdout'"}
]