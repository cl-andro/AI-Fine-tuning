[
  {"instruction": "Get NFSv4 ACL for a file", "output": "nfs4_getfacl /mnt/nfs/file.txt"},
  {"instruction": "Get NFSv4 ACL recursively", "output": "nfs4_getfacl -R /mnt/nfs/directory"},
  {"instruction": "Set NFSv4 ACL with specific permissions", "output": "nfs4_setfacl -a A::jdoe@example.com:RW /mnt/nfs/file.txt"},
  {"instruction": "Set NFSv4 ACE for owner read-write", "output": "nfs4_setfacl -a A:OWNER@:RWX /mnt/nfs/file.txt"},
  {"instruction": "Remove a specific NFSv4 ACE", "output": "nfs4_setfacl -x A::jdoe@example.com:RW /mnt/nfs/file.txt"},
  {"instruction": "Set NFSv4 ACE for group read-execute", "output": "nfs4_setfacl -a A:GROUP@:RX /mnt/nfs/file.txt"},
  {"instruction": "Set NFSv4 ACE for everyone", "output": "nfs4_setfacl -a A:EVERYONE@:R /mnt/nfs/file.txt"},
  {"instruction": "Set NFSv4 ACL recursively", "output": "nfs4_setfacl -R -a A::jdoe@example.com:W /mnt/nfs/directory"},
  {"instruction": "Set NFSv4 ACL with deny entry", "output": "nfs4_setfacl -a D::jdoe@example.com:W /mnt/nfs/file.txt"},
  {"instruction": "Set mask in NFSv4 ACL", "output": "nfs4_setfacl -a M::RX /mnt/nfs/file.txt"},
  {"instruction": "Copy NFSv4 ACL from one file to another", "output": "nfs4_getfacl /mnt/nfs/source.txt | nfs4_setfacl -S - /mnt/nfs/dest.txt"},
  {"instruction": "Set ACL with specific ACE flags", "output": "nfs4_setfacl -a A::jdoe@example.com:RN /mnt/nfs/file.txt"},
  {"instruction": "Remove all non-inherited ACEs", "output": "nfs4_setfacl -S A::OWNER@:RWX,A:GROUP@:RX,A:EVERYONE@:R /mnt/nfs/file.txt"},
  {"instruction": "Set ACL with inheritance for directories", "output": "nfs4_setfacl -a A:g:GROUP@:RX:fd /mnt/nfs/directory"},
  {"instruction": "Get ACL in numeric format", "output": "nfs4_getfacl -n /mnt/nfs/file.txt"},
  {"instruction": "Set ACL with all wildcard domain", "output": "nfs4_setfacl -a A::*@example.com:RX /mnt/nfs/file.txt"},
  {"instruction": "Append ACE without clearing existing", "output": "nfs4_setfacl -a A::jdoe@example.com:RWX /mnt/nfs/file.txt"},
  {"instruction": "Check if file has ACL set", "output": "nfs4_getfacl /mnt/nfs/file.txt | head -5"},
  {"instruction": "Set ACL withdeny for everyone except", "output": "nfs4_setfacl -a D:EVERYONE@:W /mnt/nfs/file.txt"},
  {"instruction": "Remove all ACLs to restore default", "output": "nfs4_setfacl -S A::OWNER@:RWX,A:GROUP@:RX,A:EVERYONE@:R /mnt/nfs/file.txt"}
]