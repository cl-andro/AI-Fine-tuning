[
  {"instruction": "Conda activate an environment", "output": "conda activate myenv"},
  {"instruction": "Conda deactivate current environment", "output": "conda deactivate"},
  {"instruction": "Conda list all environments", "output": "conda env list"},
  {"instruction": "Conda clone an environment", "output": "conda create --name myclone --clone myenv"},
  {"instruction": "Conda install with strict channel priority", "output": "conda install --channel conda-forge --strict-channel-priority numpy"},
  {"instruction": "Conda update conda itself", "output": "conda update conda"},
  {"instruction": "Conda search with fuzzy matching", "output": "conda search '*numpy*'"},
  {"instruction": "Conda info about environment", "output": "conda info --envs"},
  {"instruction": "Conda list with regex", "output": "conda list '^num'"},
  {"instruction": "Conda install from explicit spec", "output": "conda install --file spec-file.txt"},
  {"instruction": "Conda remove unused packages", "output": "conda clean --packages --tarballs"},
  {"instruction": "Conda export explicit spec", "output": "conda list --explicit > spec-file.txt"},
  {"instruction": "Conda create from explicit spec", "output": "conda create --name myenv --file spec-file.txt"},
  {"instruction": "Conda run with working directory", "output": "conda run -n myenv --cwd /project python main.py"},
  {"instruction": "Conda build with custom channels", "output": "conda build -c conda-forge myrecipe"},
  {"instruction": "Conda upload package", "output": "anaconda upload /path/to/package.tar.bz2"},
  {"instruction": "Conda config set auto_update_conda", "output": "conda config --set auto_update_conda False"},
  {"instruction": "Conda config show sources", "output": "conda config --show-sources"},
  {"instruction": "Conda config remove channel", "output": "conda config --remove channels conda-forge"},
  {"instruction": "Conda config describe a key", "output": "conda config --describe channel_priority"}
]
