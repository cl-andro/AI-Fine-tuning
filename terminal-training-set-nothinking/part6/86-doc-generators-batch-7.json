[
  {"instruction": "Enable Asciidoctor source highlighting with rouge", "output": "asciidoctor -a source-highlighter=rouge document.adoc"},
  {"instruction": "Enable Asciidoctor source highlighting with pygments", "output": "asciidoctor -a source-highlighter=pygments document.adoc"},
  {"instruction": "Set Asciidoctor stylesheet", "output": "asciidoctor -a stylesheet=custom.css document.adoc"},
  {"instruction": "Create a PDF with Asciidoctor and custom theme", "output": "asciidoctor-pdf -a pdf-theme=custom document.adoc"},
  {"instruction": "Set Asciidoctor section numbering", "output": "asciidoctor -a sectnums document.adoc"},
  {"instruction": "Set Asciidoctor toc placement", "output": "asciidoctor -a toc=left document.adoc"},
  {"instruction": "Include document fragments with Asciidoctor", "output": "asciidoctor -a include='include::fragment.adoc[]' document.adoc"},
  {"instruction": "Render AsciiDoc as slide deck with reveal.js", "output": "asciidoctor-revealjs document.adoc"},
  {"instruction": "Build mdBook with additional CSS in book.toml", "output": "echo -e '[output.html]\nadditional-css = [\"custom.css\"]' >> book.toml"},
  {"instruction": "Enable mdBook mathjax support in book.toml", "output": "echo -e '[output.html.mathjax]\nenable = true' >> book.toml"},
  {"instruction": "Set mdBook git repository URL in book.toml", "output": "echo -e '[output.html]\ngit-repository-url = \"https://github.com/user/repo\"' >> book.toml"},
  {"instruction": "Set mdBook edit URL template in book.toml", "output": "echo -e '[output.html.edit-url-template] = \"https://github.com/user/repo/edit/main/{path}\"' >> book.toml"},
  {"instruction": "Enable mdBook multilingual support in book.toml", "output": "echo -e '[output.html.playground]\nrunnable = true' >> book.toml"},
  {"instruction": "Generate a man page from Markdown with pandoc", "output": "pandoc mydoc.md -o mydoc.1 --to man"},
  {"instruction": "Build a Sphinx HTML with single HTML file output", "output": "sphinx-build -b singlehtml source/ build/singlehtml"},
  {"instruction": "Build Sphinx epub output", "output": "sphinx-build -b epub source/ build/epub"},
  {"instruction": "Build Sphinx changes output", "output": "sphinx-build -b changes source/ build/changes"},
  {"instruction": "Build Sphinx linkcheck output", "output": "sphinx-build -b linkcheck source/ build/linkcheck"},
  {"instruction": "Build Sphinx coverage output", "output": "sphinx-build -b coverage source/ build/coverage"},
  {"instruction": "Build Sphinx doctest output", "output": "sphinx-build -b doctest source/ build/doctest"},
  {"instruction": "Set Sphinx intersphinx mapping in conf.py", "output": "echo \"extensions.append('sphinx.ext.intersphinx')\" >> source/conf.py"},
  {"instruction": "Configure intersphinx mapping for Python", "output": "echo \"intersphinx_mapping = {'python': ('https://docs.python.org/3', None)}\" >> source/conf.py"},
  {"instruction": "Set Sphinx nitpick_ignore in conf.py", "output": "echo \"nitpick_ignore = [('py:class', 'SomeClass')]\" >> source/conf.py"},
  {"instruction": "Set Sphinx smartquotes action", "output": "echo \"smartquotes_action = 'qDe'\" >> source/conf.py"}
