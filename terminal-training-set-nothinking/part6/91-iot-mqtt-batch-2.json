    "instruction": "Hash a password interactively with mosquitto_passwd",
    "output": "mosquitto_passwd -H /etc/mosquitto/passwd alice"
  },
  {
    "instruction": "Publish with null (zero-length) message",
    "output": "mosquitto_pub --topic 'test/null' -n"
  },
  {
    "instruction": "Publish as retained message",
    "output": "mosquitto_pub --topic 'status/last' --message 'online' -r"
  },
  {
    "instruction": "Subscribe without receiving retained messages",
    "output": "mosquitto_sub --topic 'status/"
  },
  {
    "instruction": "Subscribe with no message output",
    "output": "mosquitto_sub --topic 'test/#' -N"
  },
  {
    "instruction": "Subscribe with uppercase topic filtering",
    "output": "mosquitto_sub --topic 'SENSOR/"
  },
  {
    "instruction": "Subscribe with timeout 30 seconds",
    "output": "mosquitto_sub --topic 'test/"
  },
  {
    "instruction": "Install MQTT CLI (Eclipse Paho)",
    "output": "sudo apt install mqtt-cli"
  },
  {
    "instruction": "Publish with MQTT CLI",
    "output": "mqtt pub -t 'sensor/temp' -m '23.5' -h localhost -p 1883"
  },
  {
    "instruction": "Subscribe with MQTT CLI",
    "output": "mqtt sub -t 'sensor/"
  },
  {
    "instruction": "MQTT CLI with TLS connection",
    "output": "mqtt pub -t 'secure/topic' -m 'data' --cafile ca.crt --cert client.crt --key client.key"
  },
  {
    "instruction": "Install Node-RED on Debian 12",
    "output": "sudo npm install -g --unsafe-perm node-red"
  },
  {
    "instruction": "Start Node-RED as a service",
    "output": "sudo systemctl enable nodered.service && sudo systemctl start nodered"
  },
  {
    "instruction": "Initialize Node-RED admin",
    "output": "node-red admin init"
  },
  {
    "instruction": "Disable a Node-RED flow via CLI",
    "output": "node-red admin disable /path/to/flow.json"
  },
  {
    "instruction": "Enable a Node-RED flow via CLI",
    "output": "node-red admin enable /path/to/flow.json"
  },
  {
    "instruction": "Install Node-RED palette module via CLI",
    "output": "node-red admin install node-red-contrib-mqtt-broker"
  },
  {
    "instruction": "Uninstall Node-RED palette module via CLI",
    "output": "node-red admin uninstall node-red-contrib-mqtt-broker"
  },
  {
    "instruction": "List Node-RED installed modules",
    "output": "node-red admin list"
  },
  {
    "instruction": "Install Eclipse Kanto CLI",
    "output": "curl -fsSL https://raw.githubusercontent.com/eclipse-kanto/kanto/main/install.sh | sudo bash"
  },
  {
    "instruction": "Check Eclipse Kanto version",
    "output": "kanto --version"
  },
  {
    "instruction": "Start Eclipse Kanto container management",
    "output": "sudo systemctl start kanto-cm"
  },
  {
    "instruction": "List Eclipse Kanto containers",
    "output": "sudo kanto-cm list"
  },
  {
    "instruction": "Pull container with Eclipse Kanto",
    "output": "sudo kanto-cm pull eclipse-mosquitto:latest"
