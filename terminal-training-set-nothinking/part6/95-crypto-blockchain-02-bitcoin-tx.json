[
  {"instruction": "Send Bitcoin to an address", "output": "bitcoin-cli sendtoaddress bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq 0.01"},
  {"instruction": "Send Bitcoin with a comment and subtract fee from amount", "output": "bitcoin-cli sendtoaddress bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq 0.005 \"payment\" \"invoice_123\" true"},
  {"instruction": "Send many Bitcoin outputs at once", "output": "bitcoin-cli sendmany \"\" '{\"bc1q...\": 0.01, \"bc1p...\": 0.02}'"},
  {"instruction": "Create a raw transaction", "output": "bitcoin-cli createrawtransaction '[{\"txid\":\"a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123\",\"vout\":0}]' '{\"bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq\":0.01}'"},
  {"instruction": "Sign a raw transaction with wallet keys", "output": "bitcoin-cli signrawtransactionwithwallet 0200000001a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef01230000000000ffffffff011027000000000000160014...0000000000"},
  {"instruction": "Broadcast a signed raw transaction", "output": "bitcoin-cli sendrawtransaction 02000000000101a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef01230000000000ffffffff011027000000000000160014...00000000"},
  {"instruction": "List unspent transaction outputs", "output": "bitcoin-cli listunspent"},
  {"instruction": "List unspent with min conf and addresses", "output": "bitcoin-cli listunspent 1 9999999 '[\"bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq\"]'"},
  {"instruction": "List transactions in the wallet", "output": "bitcoin-cli listtransactions"},
  {"instruction": "List recent wallet transactions with count limit", "output": "bitcoin-cli listtransactions \"*\" 20 0"},
  {"instruction": "Get a specific wallet transaction by TXID", "output": "bitcoin-cli gettransaction a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123"},
  {"instruction": "Get the wallet balance", "output": "bitcoin-cli getbalance"},
  {"instruction": "Get the balance with min confirmations", "output": "bitcoin-cli getbalance \"*\" 6"},
  {"instruction": "Get the unconfirmed balance", "output": "bitcoin-cli getunconfirmedbalance"},
  {"instruction": "Lock an unspent output to prevent spending", "output": "bitcoin-cli lockunspent false '[{\"txid\":\"a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123\",\"vout\":0}]'"},
  {"instruction": "Unlock a previously locked output", "output": "bitcoin-cli lockunspent true '[{\"txid\":\"a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123\",\"vout\":0}]'"},
  {"instruction": "Abandon a transaction", "output": "bitcoin-cli abandontransaction a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123"},
  {"instruction": "Bump the fee of a pending transaction", "output": "bitcoin-cli bumpfee a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123"},
  {"instruction": "Fund a raw transaction", "output": "bitcoin-cli fundrawtransaction 0200000001a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef01230000000000ffffffff011027000000000000160014...00000000"},
  {"instruction": "Test a transaction creation without broadcasting", "output": "bitcoin-cli createrawtransaction '[{\"txid\":\"a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123\",\"vout\":0}]' '{\"bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq\":0.01}'"},
  {"instruction": "Combine multiple raw transactions", "output": "bitcoin-cli combinerawtransaction '[\"0200000001a1b2...00000000\",\"0200000001c3d4...00000000\"]'"},
  {"instruction": "Estimate the fee for a transaction", "output": "bitcoin-cli estimatesmartfee 2 ECONOMICAL"},
  {"instruction": "Create a PSBT (Partially Signed Bitcoin Transaction)", "output": "bitcoin-cli walletcreatefundedpsbt '[{\"txid\":\"a1b2c3d4e5f6789012345678abcdef9012345678abcdef0123456789abcdef0123\",\"vout\":0}]' '{\"bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq\":0.01}'"},
  {"instruction": "Finalize a PSBT", "output": "bitcoin-cli finalizepsbt cHNidP8BAJoCAAAAAqoB...="},
  {"instruction": "Decode a PSBT", "output": "bitcoin-cli decodepsbt cHNidP8BAJoCAAAAAqoB...="}
]
