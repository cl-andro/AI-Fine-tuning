[
  {"instruction": "Start vrrpd with a virtual IP on eth0", "output": "vrrpd -i eth0 -p 100 -v 51 192.168.1.100"},
  {"instruction": "Start vrrpd in debug mode", "output": "vrrpd -d -i eth0 -p 100 -v 51 192.168.1.100"},
  {"instruction": "Create a Pacemaker resource for a DRBD device", "output": "pcs resource create DRBD ocf:linbit:drbd drbd_resource=r0 op monitor interval=30s"},
  {"instruction": "Create a Pacemaker filesystem resource", "output": "pcs resource create FS ocf:heartbeat:Filesystem device=/dev/drbd0 directory=/mnt/data fstype=ext4"},
  {"instruction": "Create a Pacemaker resource group", "output": "pcs resource group add MyGroup VirtualIP FS"},
  {"instruction": "Create a Pacemaker master/slave resource", "output": "pcs resource create ClusterIP ocf:heartbeat:IPaddr2 ip=192.168.1.100 clone"},
  {"instruction": "Set Pacemaker resource stickiness", "output": "pcs resource defaults resource-stickiness=100"},
  {"instruction": "Configure Pacemaker migration threshold", "output": "pcs resource defaults migration-threshold=3"},
  {"instruction": "Enable STONITH in Pacemaker", "output": "pcs property set stonith-enabled=true"},
  {"instruction": "Set Pacemaker no-quorum policy", "output": "pcs property set no-quorum-policy=ignore"},
  {"instruction": "Configure Pacemaker symmetric cluster", "output": "pcs property set symmetric-cluster=true"},
  {"instruction": "Set Pacemaker election timeout", "output": "pcs property set election-timeout=60"},
  {"instruction": "Create a resource operation timeout", "output": "pcs resource op add VirtualIP monitor interval=10s timeout=20s"},
  {"instruction": "Show Pacemaker resource defaults", "output": "pcs resource defaults"},
  {"instruction": "Show Pacemaker resource operations", "output": "pcs resource op show VirtualIP"},
  {"instruction": "Show full Pacemaker configuration", "output": "pcs config show"},
  {"instruction": "Back up Pacemaker configuration", "output": "pcs config backup /tmp/pcs-backup"},
  {"instruction": "Restore Pacemaker configuration from backup", "output": "pcs config restore /tmp/pcs-backup"},
  {"instruction": "Check Corosync ring health in detail", "output": "corosync-cfgtool -s -d"},
  {"instruction": "Check Corosync quorum votes", "output": "corosync-quorumtool -s -v"},
  {"instruction": "Show Corosync node list from quorum tool", "output": "corosync-quorumtool -l"},
  {"instruction": "Set up a two-node Corosync cluster", "output": "pcs cluster setup --start --enable mycluster node1 node2"},
  {"instruction": "Symmetrically authenticate Corosync cluster", "output": "pcs cluster auth node1 node2 -u hacluster -p password"},
  {"instruction": "Check cluster status on a single node", "output": "pcs cluster status"},
  {"instruction": "PCS resource disable", "output": "pcs resource disable VirtualIP"}
