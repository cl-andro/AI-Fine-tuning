[
  {
    "instruction": "Compile and flash ESPHome firmware to device",
    "output": "esphome run mydevice.yaml --device /dev/ttyUSB0"
  },
  {
    "instruction": "Upload ESPHome firmware via OTA",
    "output": "esphome upload mydevice.yaml --ota"
  },
  {
    "instruction": "View ESPHome device logs",
    "output": "esphome logs mydevice.yaml"
  },
  {
    "instruction": "Install Tasmota CLI (tasmoadmin)",
    "output": "sudo npm install -g tasmoadmin"
  },
  {
    "instruction": "Scan network for Tasmota devices",
    "output": "tasmoadmin scan"
  },
  {
    "instruction": "List Tasmota devices",
    "output": "tasmoadmin list"
  },
  {
    "instruction": "Send MQTT command to Tasmota device",
    "output": "mosquitto_pub --topic 'cmnd/sonoff1/power' --message '1'"
  },
  {
    "instruction": "Get Tasmota device status via MQTT",
    "output": "mosquitto_sub --topic 'stat/sonoff1/"
  },
  {
    "instruction": "Configure Tasmota MQTT via HTTP",
    "output": "curl http://192.168.1.42/cm?cmnd=MqttServer%20192.168.1.100"
  },
  {
    "instruction": "Install Home Assistant CLI (ha)",
    "output": "sudo apt install home-assistant-cli"
  },
  {
    "instruction": "Check Home Assistant core status",
    "output": "ha core check"
  },
  {
    "instruction": "Restart Home Assistant via CLI",
    "output": "ha core restart"
  },
  {
    "instruction": "Install Home Assistant addon via CLI",
    "output": "ha addons install core_mosquitto"
  },
  {
    "instruction": "Start Home Assistant addon",
    "output": "ha addons start core_mosquitto"
  },
  {
    "instruction": "View Home Assistant addon logs",
    "output": "ha addons logs core_mosquitto --follow"
  },
  {
    "instruction": "List Home Assistant integrations via CLI",
    "output": "ha integrations"
  },
  {
    "instruction": "Install OpenHAB on Debian 12",
    "output": "curl -fsSL https://openhab.jfrog.io/artifactory/openhab-linuxpkg/keyrings/openh ub.key | sudo gpg --dearmor -o /usr/share/keyrings/openhab.gpg && echo 'deb [signed-by=/usr/share/keyrings/openhab.gpg] https://openhab.jfrog.io/artifactory/openhab-linuxpkg stable main' | sudo tee /etc/apt/sources.list.d/openhab.list && sudo apt update && sudo apt install openhab"
  },
  {
    "instruction": "Start OpenHAB service",
    "output": "sudo systemctl start openhab && sudo systemctl enable openhab"
  },
  {
    "instruction": "Check OpenHAB status via CLI",
    "output": "sudo openhab-cli info"
  },
  {
    "instruction": "List OpenHAB console commands",
    "output": "sudo openhab-cli help"
  },
  {
    "instruction": "Get OpenHAB thing status via console",
    "output": "sudo openhab-cli thing list"
  },
  {
    "instruction": "OpenHAB console: check MQTT binding",
    "output": "sudo openhab-cli bundle:list | grep -i mqtt"
  },
  {
    "instruction": "Publish will message with retain via mosquitto_pub",
    "output": "mosquitto_pub --topic 'device/status' --message 'online' --will-topic 'device/status' --will-payload 'offline' --will-retain -d"
  },
  {
    "instruction": "Subscribe with strict topic match not allowed",
    "output": "mosquitto_sub --topic 'sensor/temperature' -R -v"
  }
]