[
  {
    "instruction": "Create an OVS bridge named br0",
    "output": "ovs-vsctl add-br br0"
  },
  {
    "instruction": "Delete OVS bridge br0",
    "output": "ovs-vsctl del-br br0"
  },
  {
    "instruction": "Add port eth0 to bridge br0",
    "output": "ovs-vsctl add-port br0 eth0"
  },
  {
    "instruction": "Delete port eth0 from br0",
    "output": "ovs-vsctl del-port br0 eth0"
  },
  {
    "instruction": "Set bridge br0 to use OpenFlow 1.3",
    "output": "ovs-vsctl set bridge br0 protocols=OpenFlow13"
  },
  {
    "instruction": "Get the datapath ID of br0",
    "output": "ovs-vsctl get bridge br0 datapath_id"
  },
  {
    "instruction": "List all bridges",
    "output": "ovs-vsctl list bridge"
  },
  {
    "instruction": "Find bridges with fail-mode secure",
    "output": "ovs-vsctl find bridge fail_mode=secure"
  },
  {
    "instruction": "Show OVS configuration",
    "output": "ovs-vsctl show"
  },
  {
    "instruction": "Check if br0 exists",
    "output": "ovs-vsctl br-exists br0"
  },
  {
    "instruction": "Get VLAN tag of port eth0",
    "output": "ovs-vsctl br-to-vlan eth0"
  },
  {
    "instruction": "Get parent bridge of a port",
    "output": "ovs-vsctl br-to-parent eth0"
  },
  {
    "instruction": "Destroy interface veth0",
    "output": "ovs-vsctl destroy interface veth0"
  },
  {
    "instruction": "Set controller for bridge br0",
    "output": "ovs-vsctl set-controller br0 tcp:192.168.1.10:6653"
  },
  {
    "instruction": "List all ports of br0",
    "output": "ovs-vsctl list-ports br0"
  },
  {
    "instruction": "Add a GRE tunnel port",
    "output": "ovs-vsctl add-port br0 gre0 -- set interface gre0 type=gre options:remote_ip=10.0.0.2"
  },
  {
    "instruction": "Set interface eth0 to down",
    "output": "ovs-vsctl set interface eth0 admin-state=down"
  },
  {
    "instruction": "Remove controller from br0",
    "output": "ovs-vsctl del-controller br0"
  },
  {
    "instruction": "Add VLAN 100 to port eth0",
    "output": "ovs-vsctl set port eth0 tag=100"
  },
  {
    "instruction": "Show OpenFlow version of br0",
    "output": "ovs-vsctl get bridge br0 protocols"
  },
  {
    "instruction": "Set bridge br0 to use stp",
    "output": "ovs-vsctl set bridge br0 stp_enable=true"
  },
  {
    "instruction": "List all interfaces",
    "output": "ovs-vsctl list interface"
  }
]