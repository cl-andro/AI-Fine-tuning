[
  {"instruction": "Check Clair status", "output": "clairctl health"},
  {"instruction": "Analyze an image with Clair", "output": "clairctl analyze nginx:latest"},
  {"instruction": "Show Clair vulnerability report", "output": "clairctl vulnerabilities nginx:latest"},
  {"instruction": "Push an image to Clair", "output": "clairctl push nginx:latest"},
  {"instruction": "Run Dockle to check Dockerfile best practices", "output": "dockle nginx:latest"},
  {"instruction": "Run Dockle with verbose output", "output": "dockle --verbose nginx:latest"},
  {"instruction": "Run Dockle with non-zero exit on findings", "output": "dockle --exit-code 1 nginx:latest"},
  {"instruction": "Ignore specific Dockle checks", "output": "dockle --ignore CIS-DI-0010 nginx:latest"},
  {"instruction": "Run Dockle with JSON output", "output": "dockle --format json nginx:latest"},
  {"instruction": "Run Dockle and output to file", "output": "dockle --output report.txt nginx:latest"},
  {"instruction": "Run Dockle with custom CIS profile", "output": "dockle --profile CIS nginx:latest"},
  {"instruction": "Scan image with Clair local", "output": "clairctl --config /etc/clair/config.yaml analyze nginx:latest"},
  {"instruction": "List all Clair namespaces", "output": "clairctl --config /etc/clair/config.yaml list"},
  {"instruction": "Delete an image from Clair", "output": "clairctl delete nginx:latest"},
  {"instruction": "Run Dockle ignoring unset user", "output": "dockle --ignore CIS-DI-0010 --ignore CIS-DI-0001 nginx:latest"},
  {"instruction": "Check Dockle version", "output": "dockle --version"},
  {"instruction": "Run Dockle with CVSS threshold", "output": "dockle --threshold critical nginx:latest"},
  {"instruction": "Run Dockle with specific CIS version", "output": "dockle --cis-version v1.0.0 nginx:latest"},
  {"instruction": "Export Dockle report as SARIF", "output": "dockle --format sarif nginx:latest"},
  {"instruction": "Run Dockle on a local Dockerfile build context", "output": "dockle -i nginx-dockerfile-review nginx:latest"}
]