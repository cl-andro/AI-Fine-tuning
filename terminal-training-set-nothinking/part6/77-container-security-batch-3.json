[
  {"instruction": "Scan a Docker image with Grype", "output": "grype nginx:latest"},
  {"instruction": "Scan a directory with Grype", "output": "grype dir:/path/to/project"},
  {"instruction": "Scan with all-layers scope", "output": "grype nginx:latest --scope all-layers"},
  {"instruction": "Scan with squashed scope", "output": "grype nginx:latest --scope squashed"},
  {"instruction": "Search by CVE identifier", "output": "grype nginx:latest --by-cve CVE-2024-XXXX"},
  {"instruction": "Show only fixed vulnerabilities", "output": "grype --only-fixed nginx:latest"},
  {"instruction": "Fail on critical or high severity", "output": "grype --fail-on critical nginx:latest"},
  {"instruction": "Output results as JSON", "output": "grype -o json nginx:latest"},
  {"instruction": "Output results as table", "output": "grype -o table nginx:latest"},
  {"instruction": "Output results as CycloneDX", "output": "grype -o cyclonedx nginx:latest"},
  {"instruction": "Write results to a file", "output": "grype --file scan-results.json -o json nginx:latest"},
  {"instruction": "Add CPES if missing", "output": "grype --add-cpes-if-none nginx:latest"},
  {"instruction": "Scan for specific platform", "output": "grype --platform linux/arm64 nginx:latest"},
  {"instruction": "Scan with custom config file", "output": "grype -c /path/to/grype.yaml nginx:latest"},
  {"instruction": "Exclude specific paths", "output": "grype nginx:latest --exclude /usr/lib"},
  {"instruction": "Check Grype version and DB status", "output": "grype version"},
  {"instruction": "Update Grype vulnerability database", "output": "grype db update"},
  {"instruction": "List all Grype DB revisions", "output": "grype db list"},
  {"instruction": "Use specific Grype DB", "output": "grype --db-cache-dir /opt/grype/db nginx:latest"},
  {"instruction": "Scan by CPE match string", "output": "grype nginx:latest --only-fixed --fail-on high -o json"}
]