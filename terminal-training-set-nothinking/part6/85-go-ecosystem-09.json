[
  {"instruction": "Set GOTOOLCHAIN environment", "output": "go env -w GOTOOLCHAIN=go1.22"},
  {"instruction": "Set GOTOOLCHAIN to auto", "output": "go env -w GOTOOLCHAIN=auto"},
  {"instruction": "Set GOFLAGS for all builds", "output": "go env -w GOFLAGS='-tags=netgo'"},
  {"instruction": "Set GOPROXY for modules", "output": "go env -w GOPROXY='https://goproxy.cn,direct'"},
  {"instruction": "Set GOPRIVATE for private repos", "output": "go env -w GOPRIVATE='git.mycompany.com/*'"},
  {"instruction": "Set GONOSUMCHECK for private", "output": "go env -w GONOSUMCHECK='git.mycompany.com/*'"},
  {"instruction": "Set GONOSUMDB for private", "output": "go env -w GONOSUMDB='git.mycompany.com/*'"},
  {"instruction": "Go build with asan", "output": "go build -asan"},
  {"instruction": "Go build with msan", "output": "go build -msan"},
  {"instruction": "Go build with coverage", "output": "go build -cover"},
  {"instruction": "Go test with count to disable cache", "output": "go test -count=1 ./..."},
  {"instruction": "Go test with full path", "output": "go test -fullpath"},
  {"instruction": "Go vet with composites check", "output": "go vet -composites=false ./..."},
  {"instruction": "Go vet with printf check", "output": "go vet -printf=false ./..."},
  {"instruction": "Go fmt with rewrite rule", "output": "go fmt -r 'a[b] -> b[a]'"},
  {"instruction": "Go doc with platform-specific", "output": "go doc -src os:windows"},
  {"instruction": "Go list with std packages", "output": "go list std"},
  {"instruction": "Go list with all modules", "output": "go list -m all"},
  {"instruction": "Go mod download with go.sum", "output": "go mod download -x"},
  {"instruction": "Go mod verify with go.sum", "output": "go mod verify -x"}
