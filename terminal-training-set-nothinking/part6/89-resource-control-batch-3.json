  {"instruction": "Allocate memory locally with numactl", "output": "numactl --localalloc command"},
  {"instruction": "Prefer a NUMA node for memory with numactl", "output": "numactl --preferred=1 command"},
  {"instruction": "Interleave memory across NUMA nodes with numactl", "output": "numactl --interleave=all command"},
  {"instruction": "Show NUMA architecture with numactl", "output": "numactl -l"},
