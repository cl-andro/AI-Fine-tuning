[
  {"instruction": "Set ulimit stack size (soft)", "output": "ulimit -s 8192"},
  {"instruction": "Set ulimit virtual memory (soft)", "output": "ulimit -v 1048576"},
  {"instruction": "Set ulimit pending signals (soft)", "output": "ulimit -i 1024"},
  {"instruction": "Configure /etc/security/limits.conf for user", "output": "echo 'user soft nofile 4096' >> /etc/security/limits.conf"},
  {"instruction": "Set hard limit in limits.conf", "output": "echo 'user hard nofile 8192' >> /etc/security/limits.conf"},
  {"instruction": "Set nproc limit for a group in limits.conf", "output": "echo '@developers soft nproc 500' >> /etc/security/limits.conf"},
  {"instruction": "Set stack limit for a domain in limits.conf", "output": "echo '* soft stack 8192' >> /etc/security/limits.conf"},
  {"instruction": "Enable pam_limits.so in PAM config", "output": "echo 'session required pam_limits.so' >> /etc/pam.d/common-session"},
  {"instruction": "Get resource limits of a running process with prlimit", "output": "prlimit -p 1234"},
  {"instruction": "Set resource limit with prlimit", "output": "prlimit -p 1234 --nofile=4096:8192"},
  {"instruction": "Set prlimit nice value", "output": "prlimit -p 1234 --nice=10"},
  {"instruction": "Set prlimit rttime (real-time timer)", "output": "prlimit -p 1234 --rttime=100000"},
  {"instruction": "Show /proc limits of a process", "output": "cat /proc/1234/limits"},
  {"instruction": "Check max number of processes per user", "output": "ulimit -u"},
  {"instruction": "Show setrlimit system call info", "output": "man setrlimit"},
  {"instruction": "Bind memory to specific NUMA nodes with numactl", "output": "numactl --membind=0 command"},
