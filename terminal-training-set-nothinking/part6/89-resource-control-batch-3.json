  {"instruction": "Show NUMA policy of a process", "output": "numactl -p 1234"},
  {"instruction": "Show NUMA policy of current process", "output": "numactl -s"},
  {"instruction": "Show NUMA hardware available nodes", "output": "lscpu | grep NUMA"},
