[
  {"instruction": "Mount NFS share with default NFSv4", "output": "mount -t nfs4 server:/export /mnt/nfs"},
  {"instruction": "Mount NFS share specifying NFSv4", "output": "mount -t nfs -o nfsvers=4 server:/export /mnt/nfs"},
