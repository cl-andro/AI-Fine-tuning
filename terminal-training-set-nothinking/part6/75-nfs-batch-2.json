  {"instruction": "Set read and write buffer sizes", "output": "mount -t nfs -o rsize=1048576,wsize=1048576 server:/export /mnt/data"},
  {"instruction": "Mount with custom timeout", "output": "mount -t nfs -o timeo=600 server:/export /mnt/nfs"},
  {"instruction": "Mount with specified retransmit count", "output": "mount -t nfs -o retrans=5 server:/export /mnt/nfs"},
  {"instruction": "Mount in background if server is down", "output": "mount -t nfs -o bg server:/export /mnt/nfs"},
