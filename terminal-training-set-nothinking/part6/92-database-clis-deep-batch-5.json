[
  {"instruction": "Install mycli MySQL client on Debian 12", "output": "sudo apt install mycli"},
  {"instruction": "Connect to MySQL with mycli", "output": "mycli -h localhost -u root -p -P 3306"},
  {"instruction": "List databases in mycli", "output": "SHOW DATABASES;"},
  {"instruction": "List tables in mycli", "output": "SHOW TABLES;"},
  {"instruction": "Run EXPLAIN in mycli", "output": "EXPLAIN SELECT * FROM users JOIN orders ON users.id = orders.user_id WHERE users.active = 1\\G"},
  {"instruction": "Run PROFILE a query in mycli", "output": "SET profiling = 1; SELECT * FROM users WHERE id = 42; SHOW PROFILE;"},
  {"instruction": "Install MongoDB CLI on Debian 12", "output": "sudo apt install mongodb-mongosh"},
  {"instruction": "Connect to MongoDB with mongosh", "output": "mongosh mongodb://localhost:27017/mydb"},
  {"instruction": "List databases in mongosh", "output": "show dbs"},
  {"instruction": "Use a database in mongosh", "output": "use mydb"},
  {"instruction": "List collections in mongosh", "output": "show collections"},
  {"instruction": "Find documents in MongoDB collection", "output": "db.users.find({status: 'active'}).pretty()"},
  {"instruction": "Insert document in MongoDB", "output": "db.users.insertOne({name: 'Alice', email: 'alice@example.com', status: 'active'})"},
  {"instruction": "Update document in MongoDB", "output": "db.users.updateOne({name: 'Alice'}, {$set: {status: 'inactive'}})"},
  {"instruction": "Delete document in MongoDB", "output": "db.users.deleteOne({name: 'Bob'})"},
  {"instruction": "Create index in MongoDB", "output": "db.users.createIndex({email: 1}, {unique: true})"},
  {"instruction": "Aggregation pipeline in mongosh", "output": "db.orders.aggregate([{$group: {_id: '$status', total: {$sum: '$amount'}}}])"},
  {"instruction": "Install Cassandra (cqlsh) on Debian 12", "output": "sudo apt install cassandra"},
  {"instruction": "Connect to Cassandra with cqlsh", "output": "cqlsh localhost 9042"},
  {"instruction": "List keyspaces in cqlsh", "output": "DESCRIBE KEYSPACES;"},
  {"instruction": "Create keyspace in cqlsh", "output": "CREATE KEYSPACE myapp WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 3};"},
  {"instruction": "Create table in cqlsh", "output": "CREATE TABLE myapp.users (id UUID PRIMARY KEY, name TEXT, email TEXT, status TEXT);"},
  {"instruction": "Insert into Cassandra with cqlsh", "output": "INSERT INTO myapp.users (id, name, email, status) VALUES (uuid(), 'Alice', 'alice@example.com', 'active');"},
  {"instruction": "SELECT from Cassandra in cqlsh", "output": "SELECT * FROM myapp.users WHERE status = 'active' ALLOW FILTERING;"},
  {"instruction": "Describe table in cqlsh", "output": "DESCRIBE TABLE myapp.users;"}
]
