[
  {"instruction": "Set csync2 key file path", "output": "echo 'key /etc/csync2/csync2.key' >> /etc/csync2.cfg"},
  {"instruction": "Exclude pattern in csync2 config", "output": "echo 'exclude *.log;' >> /etc/csync2.cfg"},
  {"instruction": "Add multiple hosts to csync2 config", "output": "echo -e 'host node1.local;\nhost node2.local;\nhost node3.local;' >> /etc/csync2.cfg"},
  {"instruction": "Set csync2 auto younger for conflict resolution", "output": "echo 'auto younger;' >> /etc/csync2.cfg"},
  {"instruction": "Dry-run csync2 with verbose XML output", "output": "csync2 -x -T -t -v"},
  {"instruction": "Run csync2 daemon in foreground", "output": "csync2 -i"},
  {"instruction": "Show csync2 version info", "output": "csync2 --version"},
  {"instruction": "Initialize a git-annex directory remote", "output": "git annex initremote dirremote type=directory directory=/mnt/backup encryption=none"},
  {"instruction": "Initialize git-annex S3 remote", "output": "git annex initremote s3remote type=S3 encryption=none bucket=mybucket"},
  {"instruction": "Initialize git-annex web remote", "output": "git annex initremote web type=web"},
  {"instruction": "Migrate git-annex backend for a file", "output": "git annex migrate --backend=SHA256E largefile.iso"},
  {"instruction": "Force git-annex to copy content to all remotes", "output": "git annex copy --to all largefile.iso"},
  {"instruction": "Git-annex whereis with all details", "output": "git annex whereis --all largefile.iso"},
  {"instruction": "Expire git-annex unused content", "output": "git annex dropunused 1-10"},
  {"instruction": "Schedule git-annex hourly/fhh", "output": "git annex schedule . \"1h\""},
  {"instruction": "Set git-annex preferred content", "output": "git annex wanted . \"(include=*.iso or include=*.zip)\""},
  {"instruction": "Set git-annex group for a repository", "output": "git annex group . client"},
  {"instruction": "Set git-annex required content", "output": "git annex required . \"(not (copies=backup:1))\""},
  {"instruction": "Git-annex sync with no push", "output": "git annex sync --no-push"},
  {"instruction": "Git-annex sync with no pull", "output": "git annex sync --no-pull"},
  {"instruction": "Git-annex sync with content of specified directory", "output": "git annex sync --content ."},
  {"instruction": "List git-annex available remotes with info", "output": "git annex info ."},
  {"instruction": "Lock all git-annex files in a directory", "output": "git annex lock --all"},
  {"instruction": "Unlock all git-annex files in a directory", "output": "git annex unlock ."},
  {"instruction": "Git-annex addurl to add file from URL", "output": "git annex addurl https://example.com/file.iso"},
  {"instruction": "Git-annex import from a directory", "output": "git annex import /media/usb/photos --duplicate"}
]
