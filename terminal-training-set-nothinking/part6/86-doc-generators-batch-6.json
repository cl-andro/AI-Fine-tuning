[
  {"instruction": "Convert multiple Markdown files to a single EPUB with pandoc", "output": "pandoc --epub-cover-image=cover.png -o book.epub title.txt chapter*.md"},
  {"instruction": "Create a PDF with sans-serif font in pandoc via xelatex", "output": "pandoc input.md -o output.pdf --pdf-engine=xelatex -V mainfont=DejaVuSans"},
