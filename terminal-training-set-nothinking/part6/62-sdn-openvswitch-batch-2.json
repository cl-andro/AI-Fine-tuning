[
  {
    "instruction": "Dump all port statistics",
    "output": "ovs-ofctl dump-ports br0"
  },
  {
    "instruction": "Dump flow tables of br0",
    "output": "ovs-ofctl dump-tables br0"
  },
  {
    "instruction": "Dump all flows in br0",
    "output": "ovs-ofctl dump-flows br0"
  },
  {
    "instruction": "Add a flow to forward all traffic to port 1",
    "output": "ovs-ofctl add-flow br0 'actions=output:1'"
  },
  {
    "instruction": "Delete all flows with output to port 2",
    "output": "ovs-ofctl del-flows br0 'actions=output:2'"
  },
  {
    "instruction": "Modify flows to set priority to 100",
    "output": "ovs-ofctl mod-flows br0 'priority=100'"
  },
  {
    "instruction": "Send a packet out on port 3",
    "output": "ovs-ofctl packet-out br0 3 'actions=output:1'"
  },
  {
    "instruction": "Show OVS datapath information",
    "output": "ovs-ofctl show br0"
  },
  {
    "instruction": "Dump port descriptions",
    "output": "ovs-ofctl dump-ports-desc br0"
  },
  {
    "instruction": "Dump aggregate statistics",
    "output": "ovs-ofctl dump-aggregate br0"
  },
  {
    "instruction": "Add flow to drop all ICMP traffic",
    "output": "ovs-ofctl add-flow br0 'icmp,in_port=1,actions=drop'"
  },
  {
    "instruction": "Dump port 1 stats in normal format",
    "output": "ovs-ofctl dump-ports br0 1"
  },
  {
    "instruction": "Add a flow matching TCP dst port 80",
    "output": "ovs-ofctl add-flow br0 'tcp,tp_dst=80,actions=output:2'"
  },
  {
    "instruction": "Delete all flows on table 0",
    "output": "ovs-ofctl del-flows br0 --table=0"
  },
  {
    "instruction": "Add a flow with cookie and idle timeout",
    "output": "ovs-ofctl add-flow br0 'cookie=0x1,idle_timeout=60,actions=normal'"
  },
  {
    "instruction": "Modify all flows to use normal action",
    "output": "ovs-ofctl mod-flows br0 'actions=normal'"
  },
  {
    "instruction": "Dump aggregated stats per table",
    "output": "ovs-ofctl dump-aggregate br0 --table=0"
  },
  {
    "instruction": "Add a flow that sends to the controller",
    "output": "ovs-ofctl add-flow br0 'in_port=1,actions=controller'"
  },
  {
    "instruction": "Dump flows with cookie 0x1",
    "output": "ovs-ofctl dump-flows br0 cookie=0x1/-1"
  },
  {
    "instruction": "Add a flow with VLAN push action",
    "output": "ovs-ofctl add-flow br0 'in_port=1,actions=push_vlan:0x8100,set_field:100->vlan_vid,output:2'"
  },
  {
    "instruction": "Replace all flows from a file",
    "output": "ovs-ofctl replace-flows br0 /etc/openvswitch/flows.conf"
  },
  {
    "instruction": "Monitor flow table changes",
    "output": "ovs-ofctl monitor br0"
  }
]