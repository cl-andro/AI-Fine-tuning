[
  {"instruction": "Login to Bitwarden CLI", "output": "bw login myuser@example.com"},
  {"instruction": "Login to Bitwarden CLI with API key", "output": "bw login --apikey"},
  {"instruction": "Logout of Bitwarden CLI", "output": "bw logout"},
  {"instruction": "Unlock Bitwarden vault with master password", "output": "bw unlock"},
  {"instruction": "Lock the Bitwarden vault", "output": "bw lock"},
  {"instruction": "Check Bitwarden CLI status", "output": "bw status"},
  {"instruction": "List all items in Bitwarden vault", "output": "bw list items"},
  {"instruction": "List all folders in Bitwarden vault", "output": "bw list folders"},
  {"instruction": "List all collections in Bitwarden vault", "output": "bw list collections"},
  {"instruction": "List all organization collections", "output": "bw list org-collections"},
  {"instruction": "List all organizations", "output": "bw list organizations"},
  {"instruction": "List all sends in Bitwarden", "output": "bw list sends"},
  {"instruction": "Get a specific item by ID from Bitwarden", "output": "bw get item abc123-def456"},
  {"instruction": "Get a specific folder by ID from Bitwarden", "output": "bw get folder my-folder-id"},
  {"instruction": "Get a specific collection by ID from Bitwarden", "output": "bw get collection my-collection-id"},
  {"instruction": "Get organization details by ID", "output": "bw get organization my-org-id"},
  {"instruction": "Get a send by ID", "output": "bw get send my-send-id"},
  {"instruction": "Create a new Bitwarden item (login)", "output": "bw create item --json '{\"type\":1,\"name\":\"My Server\",\"login\":{\"username\":\"admin\",\"password\":\"s3cret\"},\"folderId\":null}'"},
  {"instruction": "Create a new Bitwarden folder", "output": "bw create folder --json '{\"name\":\"Servers\"}'"},
  {"instruction": "Create a new Bitwarden send", "output": "bw create send --json '{\"type\":0,\"name\":\"My Secret\",\"text\":{\"text\":\"secret-message\"}}'"},
  {"instruction": "Edit an existing Bitwarden item", "output": "bw edit item abc123-def456 --json '{\"name\":\"Updated Name\",\"login\":{\"username\":\"newadmin\"}}'"},
  {"instruction": "Edit an existing Bitwarden folder", "output": "bw edit folder my-folder-id --json '{\"name\":\"Renamed Folder\"}'"},
  {"instruction": "Delete a Bitwarden item", "output": "bw delete item abc123-def456"},
  {"instruction": "Delete a Bitwarden folder", "output": "bw delete folder my-folder-id"},
  {"instruction": "Delete a Bitwarden collection", "output": "bw delete collection my-collection-id"},
  {"instruction": "Encode binary data for Bitwarden", "output": "bw encode /path/to/file.bin"}
]
