[
  {"instruction": "Show all current SMB connections", "output": "smbstatus"},
  {"instruction": "Show SMB connections with locks", "output": "smbstatus -L"},
  {"instruction": "Show SMB connections per process", "output": "smbstatus -p"},
  {"instruction": "Show SMB connections with profiles", "output": "smbstatus -P"},
  {"instruction": "Change a user's SMB password", "output": "smbpasswd jdoe"},
  {"instruction": "Change SMB password for another user as root", "output": "smbpasswd jdoe -r dc01 -U root"},
  {"instruction": "Add a new SMB user", "output": "smbpasswd -a jdoe"},
  {"instruction": "Delete an SMB user", "output": "smbpasswd -x jdoe"},
  {"instruction": "Enable an SMB user", "output": "smbpasswd -e jdoe"},
  {"instruction": "Disable an SMB user", "output": "smbpasswd -d jdoe"},
  {"instruction": "Set machine account password", "output": "smbpasswd -a -m MACHINE$"},
  {"instruction": "Synchronize password with remote server", "output": "smbpasswd -j DOMAIN -r dc01 -U administrator"},
  {"instruction": "Look up NetBIOS name by IP", "output": "nmblookup -A 192.168.1.100"},
  {"instruction": "Look up IP by NetBIOS name", "output": "nmblookup SERVER01"},
  {"instruction": "Browse all NetBIOS nodes on subnet", "output": "nmblookup -B 192.168.1.255 -S *"},
  {"instruction": "Query master browser", "output": "nmblookup -M WORKGROUP"},
  {"instruction": "Look up by broadcast", "output": "nmblookup -B 192.168.1.255 SERVER01"},
  {"instruction": "Query WINS server for a name", "output": "nmblookup -R -U 192.168.1.10 SERVER01"},
  {"instruction": "Set debug level for nmblookup", "output": "nmblookup -d 2 SERVER01"},
  {"instruction": "List all files open by a specific user", "output": "smbstatus -u jdoe"},
  {"instruction": "Show SMB connections with verbose output", "output": "smbstatus -v"}
]