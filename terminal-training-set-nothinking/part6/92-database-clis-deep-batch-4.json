[
  {"instruction": "CREATE INDEX in SQLite3", "output": "sqlite3 /home/user/data.db 'CREATE INDEX idx_users_email ON users(email);'"},
  {"instruction": "EXPLAIN QUERY PLAN in SQLite3", "output": "sqlite3 /home/user/data.db 'EXPLAIN QUERY PLAN SELECT * FROM users WHERE email = \"alice@example.com\";'"},
  {"instruction": "ATTACH another SQLite3 database", "output": "sqlite3 /home/user/data.db 'ATTACH DATABASE \"/home/user/archive.db\" AS archive;'"},
  {"instruction": "VACUUM SQLite3 database to reclaim space", "output": "sqlite3 /home/user/data.db 'VACUUM;'"},
  {"instruction": "PRAGMA table_info in SQLite3", "output": "sqlite3 /home/user/data.db 'PRAGMA table_info(users);'"},
  {"instruction": "PRAGMA integrity_check in SQLite3", "output": "sqlite3 /home/user/data.db 'PRAGMA integrity_check;'"},
  {"instruction": "PRAGMA journal_mode in SQLite3", "output": "sqlite3 /home/user/data.db 'PRAGMA journal_mode=WAL;'"},
  {"instruction": "PRAGMA synchronous in SQLite3", "output": "sqlite3 /home/user/data.db 'PRAGMA synchronous=NORMAL;'"},
  {"instruction": "Run SQL script from file with SQLite3 .read", "output": "sqlite3 /home/user/data.db '.read /home/user/migration.sql'"},
  {"instruction": "Backup SQLite3 database", "output": "sqlite3 /home/user/data.db '.backup /home/user/data.backup.db'"},
  {"instruction": "Restore SQLite3 database from backup", "output": "sqlite3 /home/user/restored.db '.restore /home/user/data.backup.db'"},
  {"instruction": "Clone SQLite3 database", "output": "sqlite3 /home/user/data.db '.clone /home/user/clone.db'"},
  {"instruction": "Recover data from corrupted SQLite3 database", "output": "sqlite3 /home/user/corrupt.db '.recover' | sqlite3 /home/user/recovered.db"},
  {"instruction": "Get SQLite3 database info with .dbinfo", "output": "sqlite3 /home/user/data.db '.dbinfo'"},
  {"instruction": "Install pgcli PostgreSQL client on Debian 12", "output": "sudo apt install pgcli"},
  {"instruction": "Connect to PostgreSQL with pgcli", "output": "pgcli -h localhost -p 5432 -U alice -d mydb"},
