[
  {"instruction": "Spider a website with katana (basic crawl)", "output": "katana -u https://example.com"},
  {"instruction": "katana: crawl with depth limit of 2", "output": "katana -u https://example.com -d 2"},
  {"instruction": "katana: use multiple threads", "output": "katana -u https://example.com -c 10"},
  {"instruction": "katana: output only JavaScript file URLs", "output": "katana -u https://example.com -kf robotstxt -jc -o js_urls.txt"},
  {"instruction": "katana: fetch known paths from a wordlist", "output": "katana -u https://example.com -path file://paths.txt"},
  {"instruction": "katana: crawl with proxy", "output": "katana -u https://example.com -p http://127.0.0.1:8080"},
  {"instruction": "Crawl a website for endpoints with gospider", "output": "gospider -s https://example.com"},
  {"instruction": "gospider: enable recursive crawling", "output": "gospider -s https://example.com -r"},
  {"instruction": "gospider: include subdomains in scope", "output": "gospider -s https://example.com --subs"},
  {"instruction": "gospider: output results to a file", "output": "gospider -s https://example.com -o ./spider_output"},
  {"instruction": "gospider: use cookie authentication", "output": "gospider -s https://example.com --cookie 'session=abc123'"},
  {"instruction": "gospider: set concurrency to 5", "output": "gospider -s https://example.com -c 5"},
  {"instruction": "Discover URLs with hakrawler", "output": "echo 'https://example.com' | hakrawler"},
  {"instruction": "hakrawler: include subdomains", "output": "echo 'https://example.com' | hakrawler -subs"},
  {"instruction": "hakrawler: output only unique URLs", "output": "echo 'https://example.com' | hakrawler -u"},
  {"instruction": "hakrawler: use a cookie", "output": "echo 'https://example.com' | hakrawler -cookie 'auth=token'"},
  {"instruction": "katana: use headless browser mode", "output": "katana -u https://example.com -headless"},
  {"instruction": "Combine katana output with httpx for status codes", "output": "katana -u https://example.com -silent | httpx -status-code"},
  {"instruction": "gospider: exclude certain file extensions", "output": "gospider -s https://example.com --blacklist 'png,jpg,gif,css,js'"},
  {"instruction": "hakrawler: pass through a proxy", "output": "echo 'https://example.com' | hakrawler -proxy http://127.0.0.1:8080"},
  {"instruction": "Crawl JavaScript files using katana", "output": "katana -u https://example.com -jc"},
  {"instruction": "gospider: show debug information", "output": "gospider -s https://example.com -v"}
]
