[
  {"instruction": "Generate a default Doxygen configuration file", "output": "doxygen -g"},
  {"instruction": "Generate a Doxyfile with a custom name", "output": "doxygen -g myconfig.conf"},
  {"instruction": "Run Doxygen to generate documentation from Doxyfile", "output": "doxygen Doxyfile"},
  {"instruction": "Launch the Doxygen GUI wizard", "output": "doxywizard"},
  {"instruction": "Update an existing Doxyfile with new default options", "output": "doxygen -u Doxyfile"},
  {"instruction": "Set the INPUT tag to scan src/ and include/", "output": "sed -i 's/INPUT *=.*/INPUT = src include/' Doxyfile"},
  {"instruction": "Enable RECURSIVE file scanning in Doxyfile", "output": "sed -i 's/RECURSIVE *=.*/RECURSIVE = YES/' Doxyfile"},
  {"instruction": "Set EXTRACT_ALL to YES in Doxyfile", "output": "sed -i 's/EXTRACT_ALL *=.*/EXTRACT_ALL = YES/' Doxyfile"},
  {"instruction": "Enable HTML output in Doxyfile", "output": "sed -i 's/GENERATE_HTML *=.*/GENERATE_HTML = YES/' Doxyfile"},
  {"instruction": "Enable LaTeX output in Doxyfile", "output": "sed -i 's/GENERATE_LATEX *=.*/GENERATE_LATEX = YES/' Doxyfile"},
  {"instruction": "Enable man page output in Doxyfile", "output": "sed -i 's/GENERATE_MAN *=.*/GENERATE_MAN = YES/' Doxyfile"},
  {"instruction": "Enable RTF output in Doxyfile", "output": "sed -i 's/GENERATE_RTF *=.*/GENERATE_RTF = YES/' Doxyfile"},
  {"instruction": "Enable XML output in Doxyfile", "output": "sed -i 's/GENERATE_XML *=.*/GENERATE_XML = YES/' Doxyfile"},
  {"instruction": "Enable DocSet output for Xcode in Doxyfile", "output": "sed -i 's/GENERATE_DOCSET *=.*/GENERATE_DOCSET = YES/' Doxyfile"},
  {"instruction": "Enable HAVE_DOT for Graphviz diagrams in Doxyfile", "output": "sed -i 's/HAVE_DOT *=.*/HAVE_DOT = YES/' Doxyfile"},
  {"instruction": "Set DOT_IMAGE_FORMAT to SVG in Doxyfile", "output": "sed -i 's/DOT_IMAGE_FORMAT *=.*/DOT_IMAGE_FORMAT = svg/' Doxyfile"},
  {"instruction": "Enable CALL_GRAPH in Doxyfile", "output": "sed -i 's/CALL_GRAPH *=.*/CALL_GRAPH = YES/' Doxyfile"},
  {"instruction": "Enable CALLER_GRAPH in Doxyfile", "output": "sed -i 's/CALLER_GRAPH *=.*/CALLER_GRAPH = YES/' Doxyfile"},
  {"instruction": "Enable INCLUDE_GRAPH in Doxyfile", "output": "sed -i 's/INCLUDE_GRAPH *=.*/INCLUDE_GRAPH = YES/' Doxyfile"},
  {"instruction": "Enable INCLUDED_BY_GRAPH in Doxyfile", "output": "sed -i 's/INCLUDED_BY_GRAPH *=.*/INCLUDED_BY_GRAPH = YES/' Doxyfile"},
  {"instruction": "Enable preprocessing in Doxyfile", "output": "sed -i 's/ENABLE_PREPROCESSING *=.*/ENABLE_PREPROCESSING = YES/' Doxyfile"},
  {"instruction": "Set PREDEFINED macros in Doxyfile", "output": "sed -i 's/PREDEFINED *=.*/PREDEFINED = MY_MACRO USE_DEBUG/' Doxyfile"},
  {"instruction": "Set EXPAND_AS_DEFINED in Doxyfile", "output": "sed -i 's/EXPAND_AS_DEFINED *=.*/EXPAND_AS_DEFINED = MY_MACRO/' Doxyfile"},
  {"instruction": "Skip function macros in Doxyfile", "output": "sed -i 's/SKIP_FUNCTION_MACROS *=.*/SKIP_FUNCTION_MACROS = YES/' Doxyfile"},
  {"instruction": "Exclude a directory from Doxygen processing", "output": "echo 'EXCLUDE = test/ third_party/' >> Doxyfile"},
  {"instruction": "Set EXCLUDE_PATTERNS in Doxyfile", "output": "echo 'EXCLUDE_PATTERNS = */build/* */tmp/*' >> Doxyfile"}
]
