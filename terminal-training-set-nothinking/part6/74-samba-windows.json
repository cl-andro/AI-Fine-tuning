[
  {"instruction": "List all shares on a Windows server", "output": "smbclient -L //192.168.1.100 -U administrator"},
  {"instruction": "Connect to a specific share", "output": "smbclient //192.168.1.100/data -U domain\\\\user"},
  {"instruction": "Connect using SMB3 protocol", "output": "smbclient //server/share -U user -m SMB3"},
  {"instruction": "Connect on a non-default port", "output": "smbclient //server/share -U user -p 4450"},
  {"instruction": "Connect using an IP address directly", "output": "smbclient //server/share -U user -I 10.0.0.50"},
  {"instruction": "Connect with no password prompt", "output": "smbclient //server/share -U user -N"},
  {"instruction": "List files in a share", "output": "smbclient //server/share -U user -c ls"},
  {"instruction": "Download a file from a share", "output": "smbclient //server/share -U user -c 'get remote-file local-file'"},
  {"instruction": "Upload a file to a share", "output": "smbclient //server/share -U user -c 'put local-file remote-file'"},
  {"instruction": "Create a directory on a share", "output": "smbclient //server/share -U user -c 'mkdir newdir'"},
  {"instruction": "Remove a directory from a share", "output": "smbclient //server/share -U user -c 'rmdir olddir'"},
  {"instruction": "Delete a file from a share", "output": "smbclient //server/share -U user -c 'del unwanted-file'"},
  {"instruction": "Change directory on a remote share", "output": "smbclient //server/share -U user -c 'cd subdir'"},
  {"instruction": "Enable debug level 3", "output": "smbclient //server/share -U user -d 3"},
  {"instruction": "Download multiple files interactively", "output": "smbclient -U user //server/share -c 'prompt; mget *.txt'"},
  {"instruction": "Upload multiple files", "output": "smbclient -U user //server/share -c 'prompt; mput *.log'"},
  {"instruction": "Exit smbclient after commands", "output": "smbclient //server/share -U user -c 'ls; exit'"},
  {"instruction": "Use tarmode for backup", "output": "smbclient //server/share -U user -c 'tarmode full; tar c backup.tar'"},
  {"instruction": "List shares with Kerberos auth", "output": "smbclient -k -L //dc.domain.local"},
  {"instruction": "Connect with explicit domain and username", "output": "smbclient //server/share -U 'DOMAIN\\\\username'%password"},
  {"instruction": "Query a share with debug level 1", "output": "smbclient -L //fileserver -U guest -d 1"},
  {"instruction": "Download a file preserving timestamps", "output": "smbclient //server/share -U user -c 'get backup.tar; exit'"}
]