[
  {"instruction": "Sync with Seafile using desktop client CLI", "output": "seaf-cli sync -l LIB-ID -d ~/seafile-data"},
  {"instruction": "Seafile copy file ID externally", "output": "seaf-cli copy -l LIB-ID -s https://server -u user -p pass"},
  {"instruction": "Upload file to Nextcloud with nextcloudcmd", "output": "nextcloudcmd --user user --password pass ~/nextcloud https://nextcloud.example.com/remote.php/dav/files/user/"},
  {"instruction": "Download single file from ownCloud with curl", "output": "curl -u user:pass -o file.zip https://owncloud.example.com/remote.php/dav/files/user/file.zip"},
  {"instruction": "Nextcloud sync with no hidden files", "output": "nextcloudcmd --exclude '.*' ~/nextcloud https://nextcloud.example.com"},
  {"instruction": "Sync with rclone to WebDAV", "output": "rclone sync /data webdav:backup"},
  {"instruction": "Sync with rclone to FTP", "output": "rclone sync /data ftp:backup"},
  {"instruction": "Sync with rclone to HTTP", "output": "rclone sync /data http:backup"},
  {"instruction": "Sync with rclone to Azure Blob", "output": "rclone sync /data azureblob:container"},
  {"instruction": "Sync with rclone to Backblaze B2", "output": "rclone sync /data b2:bucket"},
  {"instruction": "Sync with rclone to local filesystem as remote", "output": "rclone sync /data localremote:/backup"},
  {"instruction": "Rclone sync stats output (show transfer stats)", "output": "rclone sync /data remote:backup --stats 10s"},
  {"instruction": "Rclone sync with include filter", "output": "rclone sync /data remote:backup --include '*.docx'"},
  {"instruction": "Rclone sync with filter-from file", "output": "rclone sync /data remote:backup --filter-from /path/to/filter.txt"},
  {"instruction": "Rclone sync with --track-renames", "output": "rclone sync /data remote:backup --track-renames"},
  {"instruction": "Rclone sync with dry-run and verbose to see planned actions", "output": "rclone sync /data remote:backup -v --dry-run"},
  {"instruction": "Rclone sync without checking size", "output": "rclone sync /data remote:backup --size-only"},
  {"instruction": "Rclone sync ignoring checksum", "output": "rclone sync /data remote:backup --ignore-checksum"},
  {"instruction": "Rclone sync with low-level retries", "output": "rclone sync /data remote:backup --low-level-retries 10"},
  {"instruction": "Rclone sync using --use-json-log", "output": "rclone sync /data remote:backup --use-json-log"},
  {"instruction": "Rclone copy with --no-traverse", "output": "rclone copy /data remote:backup --no-traverse"},
  {"instruction": "Set rsync daemon to use chroot", "output": "echo 'use chroot = yes' >> /etc/rsyncd.conf"},
  {"instruction": "Create an rsync daemon secrets file", "output": "echo 'user:secretpass' > /etc/rsyncd.secrets && chmod 600 /etc/rsyncd.secrets"},
  {"instruction": "Set rsync daemon read-only module", "output": "echo -e '[public]\npath = /srv/pub\nread only = yes' >> /etc/rsyncd.conf"},
  {"instruction": "Restart rsync daemon after config change", "output": "sudo systemctl restart rsync"},
  {"instruction": "Git-annex upgrade repository format", "output": "git annex upgrade"}
]
