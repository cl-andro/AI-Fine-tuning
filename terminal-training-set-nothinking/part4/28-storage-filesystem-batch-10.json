[
  {"instruction": "Create a RAID0 array across /dev/sdb1 and /dev/sdc1", "output": "mdadm --create /dev/md0 --level=0 --raid-devices=2 /dev/sdb1 /dev/sdc1"},
  {"instruction": "Create a RAID1 mirror on /dev/sdd1 and /dev/sde1", "output": "mdadm --create /dev/md1 --level=1 --raid-devices=2 /dev/sdd1 /dev/sde1"},
  {"instruction": "Create a RAID5 array with 3 disks and 1 spare", "output": "mdadm --create /dev/md5 --level=5 --raid-devices=3 --spare-devices=1 /dev/sdf1 /dev/sdg1 /dev/sdh1 /dev/sdi1"},
  {"instruction": "Create a RAID6 array with 4 disks", "output": "mdadm --create /dev/md6 --level=6 --raid-devices=4 /dev/sdj1 /dev/sdk1 /dev/sdl1 /dev/sdm1"},
  {"instruction": "Create a RAID10 array (far layout)", "output": "mdadm --create /dev/md10 --level=10 --raid-devices=4 /dev/sdn1 /dev/sdo1 /dev/sdp1 /dev/sdq1"},
  {"instruction": "Set chunk size to 128K on RAID5", "output": "mdadm --create /dev/md5 --level=5 --chunk=128 --raid-devices=3 /dev/sdr1 /dev/sds1 /dev/sdt1"},
  {"instruction": "Show RAID detail for /dev/md0", "output": "mdadm --detail /dev/md0"},
  {"instruction": "Show brief RAID status", "output": "mdadm --detail --scan"},
  {"instruction": "Add a spare disk /dev/sdu1 to RAID1", "output": "mdadm --add /dev/md1 /dev/sdu1"},
  {"instruction": "Remove /dev/sdv1 from RAID5 array", "output": "mdadm --remove /dev/md5 /dev/sdv1"},
  {"instruction": "Mark /dev/sdw1 as failed in RAID6", "output": "mdadm --fail /dev/md6 /dev/sdw1"},
  {"instruction": "Manage array: stop /dev/md0", "output": "mdadm --stop /dev/md0"},
  {"instruction": "Assemble all arrays from mdadm.conf", "output": "mdadm --assemble --scan"},
  {"instruction": "Create LUKS container on /dev/sdX1", "output": "cryptsetup luksFormat /dev/sdX1"},
  {"instruction": "Create LUKS with cipher aes-xts-plain64 and key size 512", "output": "cryptsetup luksFormat --cipher aes-xts-plain64 --key-size 512 /dev/sdX1"},
  {"instruction": "Open LUKS container and map to cryptroot", "output": "cryptsetup open /dev/sdX1 cryptroot"},
  {"instruction": "Open LUKS with specific key slot 0", "output": "cryptsetup open --key-slot 0 /dev/sdX1 cryptroot"},
  {"instruction": "Close LUKS container cryptroot", "output": "cryptsetup close cryptroot"},
  {"instruction": "Add a passphrase to slot 1", "output": "cryptsetup luksAddKey /dev/sdX1"},
  {"instruction": "Remove passphrase from slot 2", "output": "cryptsetup luksRemoveKey /dev/sdX1"},
  {"instruction": "Change passphrase in slot 0", "output": "cryptsetup luksChangeKey /dev/sdX1 -s 0"},
  {"instruction": "Dump LUKS header information", "output": "cryptsetup luksDump /dev/sdX1"},
  {"instruction": "Backup LUKS header to file", "output": "cryptsetup luksHeaderBackup /dev/sdX1 --header-backup-file /root/luks-header.bin"},
  {"instruction": "Restore LUKS header from file", "output": "cryptsetup luksHeaderRestore /dev/sdX1 --header-backup-file /root/luks-header.bin"},
  {"instruction": "Erase LUKS header (destroy keys)", "output": "cryptsetup luksErase /dev/sdX1"},
  {"instruction": "Resize LUKS device to fill underlying block device", "output": "cryptsetup resize cryptroot"}
]
