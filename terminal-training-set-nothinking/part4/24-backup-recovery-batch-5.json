[
  {"instruction": "Rsync with custom filter rules", "output": "rsync -avh --filter='- .git' --filter='- .cache' /home/user/ /backup/data/"},
  {"instruction": "Borg create with verbose listing", "output": "borg create --list --stats /backup/borg::home-{now:%Y-%m-%d} /home/user"},
  {"instruction": "Restic check reading all data", "output": "restic -r /backup/restic check --read-data"},
  {"instruction": "Force rdiff-backup even with errors", "output": "rdiff-backup --force /etc /backup/etc"},
  {"instruction": "Duplicity backup without encryption", "output": "duplicity --no-encryption /home/user file:///backup/duplicity"},
  {"instruction": "Split DAR archive by size", "output": "dar -c /backup/home-dar -s 200M -R /home/user"},
  {"instruction": "Create level 0 dump with verbose", "output": "dump -0uf /backup/sda1.dump /dev/sda1 2>&1 | tee /backup/dump.log"},
  {"instruction": "Write zeros to disk with dd for wipe", "output": "dd if=/dev/zero of=/dev/sda bs=4M status=progress"},
  {"instruction": "Trim retry with ddrescue on bad sectors", "output": "ddrescue --retrim /dev/sda /backup/sda.img /backup/sda.log"},
  {"instruction": "Restore GNU tar incremental from snapshot file", "output": "tar --listed-incremental=/backup/snapshot.snar -xzvf /backup/home-inc.tar.gz -C /tmp/restore"},
  {"instruction": "Cpio pass-through copy preserving metadata", "output": "find /home/user -type f | cpio -pdm /tmp/restore"},
  {"instruction": "Extract pax archive to specific directory", "output": "pax -r -f /backup/www.pax -C /tmp/restore"},
  {"instruction": "Mount rclone remote as filesystem", "output": "rclone mount remote:backup-home /mnt/backup --daemon"},
  {"instruction": "Upload file to S3 with s3cmd and set public", "output": "s3cmd put --acl-public /home/user/file.txt s3://my-backup-bucket/"},
  {"instruction": "Dump MySQL with where condition", "output": "mysqldump mydb --where=\"created_at > '2026-01-01'\" > /backup/mydb-part.sql"},
  {"instruction": "Dump PostgreSQL schema only", "output": "pg_dump --schema-only mydb > /backup/mydb-schema.sql"},
  {"instruction": "Dump MongoDB with query filter", "output": "mongodump --db mydb --collection orders --query '{\"status\": \"active\"}' --out /backup/mongodb"},
  {"instruction": "Recompress Borg archive with different compression", "output": "borg recreate /backup/borg::home-2026-07-20 --compression zstd,8"},
  {"instruction": "Show Restic statistics for repository", "output": "restic -r /backup/restic stats"},
  {"instruction": "Perform backup rotation with find -mtime + delete", "output": "find /backup -name '*.tar.gz' -mtime +90 -delete"},
  {"instruction": "Extract specific file from Restic snapshot", "output": "restic -r /backup/restic restore latest --target /tmp --include /etc/hosts"},
  {"instruction": "Create incremental dump level 2", "output": "dump -2uf /backup/sda1-level2.dump /dev/sda1"},
  {"instruction": "Verify rdiff-backup repository", "output": "rdiff-backup --verify /backup/etc"},
  {"instruction": "Compare two DAR archives", "output": "dar -d /backup/home-dar /backup/home-dar.2"},
  {"instruction": "Generate completion script for restic", "output": "restic generate --bash-completion /etc/bash_completion.d/restic"}
]
