[
  {"instruction": "Dump BIOS/DMI information (full)", "output": "dmidecode"},
  {"instruction": "Show BIOS version and release date", "output": "dmidecode -t bios"},
  {"instruction": "Show system manufacturer and product name", "output": "dmidecode -t system"},
  {"instruction": "Show baseboard (motherboard) info", "output": "dmidecode -t baseboard"},
  {"instruction": "Show installed memory module details", "output": "dmidecode -t memory"},
  {"instruction": "Show processor information via DMI", "output": "dmidecode -t processor"},
  {"instruction": "Show chassis information", "output": "dmidecode -t chassis"},
  {"instruction": "List all PCI devices with class and vendor", "output": "lspci"},
  {"instruction": "List PCI devices with verbose driver info", "output": "lspci -v"},
  {"instruction": "Show PCI device tree", "output": "lspci -t"},
  {"instruction": "Show PCI devices in machine-readable format", "output": "lspci -mm"},
  {"instruction": "Show PCI vendor and device IDs as numbers", "output": "lspci -nn"},
  {"instruction": "Show kernel drivers in use for each PCI device", "output": "lspci -k"},
  {"instruction": "List PCI devices of class 'Network controller'", "output": "lspci | grep -i network"},
  {"instruction": "Query specific PCI device 0000:02:00.0", "output": "lspci -s 02:00.0 -vv"},
  {"instruction": "List USB buses and devices", "output": "lsusb"},
  {"instruction": "List USB devices with verbose descriptors", "output": "lsusb -v"},
  {"instruction": "Show USB device tree", "output": "lsusb -t"},
  {"instruction": "Show USB devices with numeric IDs", "output": "lsusb -vvv 2>/dev/null | head -5"},
  {"instruction": "List USB devices filtered by vendor 8087", "output": "lsusb -d 8087:"},
  {"instruction": "Dump USB descriptor for bus 001 device 003", "output": "lsusb -D /dev/bus/usb/001/003"},
  {"instruction": "Show USB power management info", "output": "lsusb -v 2>/dev/null | grep -i -A2 bMaxPower"},
  {"instruction": "Get DMI chassis type name", "output": "dmidecode -t chassis | grep -i type"},
  {"instruction": "Get DMI cache information", "output": "dmidecode -t cache"},
  {"instruction": "Get DMI connector information", "output": "dmidecode -t connector"},
  {"instruction": "Get DMI slot information (expansion slots)", "output": "dmidecode -t slot"}
]
