[
  {"instruction": "Print kernel release version", "output": "uname -r"},
  {"instruction": "Print all kernel system information", "output": "uname -a"},
  {"instruction": "Print kernel name and machine architecture", "output": "uname -m"},
  {"instruction": "Load the nvidia module", "output": "modprobe nvidia"},
  {"instruction": "Load module with parameters", "output": "modprobe usb-storage delay_use=0"},
  {"instruction": "Remove a kernel module", "output": "modprobe -r nvidia"},
  {"instruction": "List currently loaded modules", "output": "lsmod"},
  {"instruction": "Show information about the ext4 module", "output": "modinfo ext4"},
  {"instruction": "Show module filename and license of nvidia", "output": "modinfo -n nvidia"},
  {"instruction": "Show module dependencies of btrfs", "output": "modinfo -d btrfs"},
  {"instruction": "Load a module with insmod (absolute path)", "output": "insmod /lib/modules/$(uname -r)/kernel/fs/btrfs/btrfs.ko"},
  {"instruction": "Remove a module with rmmod", "output": "rmmod usb-storage"},
  {"instruction": "Unload module even if in use (force)", "output": "rmmod -f usb-storage"},
  {"instruction": "Build module dependencies database", "output": "depmod"},
  {"instruction": "Build dependencies for a specific kernel", "output": "depmod 6.1.0-17-amd64"},
  {"instruction": "Show quick depmap for a module", "output": "depmod -n 2>/dev/null | grep nvidia"},
  {"instruction": "List all available modules matching 'usb'", "output": "modprobe -l | grep usb"},
  {"instruction": "Show module configuration from modprobe.d", "output": "modprobe -c | grep -i alias"},
  {"instruction": "Dry-run load (show what would happen)", "output": "modprobe --dry-run nvidia"},
  {"instruction": "Force-load module ignoring version magic", "output": "modprobe --force-modversion nvidia"},
  {"instruction": "Remove all unused modules (autoclean)", "output": "modprobe -r --remove-dependencies nvidia"},
  {"instruction": "Show module built-in aliases", "output": "modprobe -c | grep -i '^alias' | head -5"},
  {"instruction": "List options for vfio-pci module", "output": "modinfo -p vfio-pci"},
  {"instruction": "Check if module is loaded by name", "output": "lsmod | grep -w nvidia"},
  {"instruction": "Reload a module (remove then insert)", "output": "modprobe -r nvidia && modprobe nvidia"}
]
