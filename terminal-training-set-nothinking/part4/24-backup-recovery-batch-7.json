[
  {"instruction": "Dry-run rsync to see what would be transferred", "output": "rsync -avh --dry-run --stats /home/user/ /backup/data/"},
  {"instruction": "Dry-run Borg create to see changes", "output": "borg create --dry-run --list /backup/borg::test /home/user"},
  {"instruction": "Dry-run Restic backup", "output": "restic -r /backup/restic backup --dry-run /home/user"},
  {"instruction": "Disable compression in rdiff-backup", "output": "rdiff-backup --no-compression /etc /backup/etc"},
  {"instruction": "Duplicity with exclude patterns", "output": "duplicity --exclude /home/user/.cache --exclude '**.mp3' /home/user file:///backup/duplicity"},
  {"instruction": "Alter DAR archive to add/remove files", "output": "dar -a /backup/home-dar -R /home/user -A home/user/newfile.txt"},
  {"instruction": "Restore single file from dump", "output": "restore -x -f /backup/sda1.dump /path/to/file"},
  {"instruction": "Display dd help and version", "output": "dd --help"},
  {"instruction": "Complete incomplete ddrescue run", "output": "ddrescue --complete-only /dev/sda /backup/sda.img /backup/sda.log"},
  {"instruction": "Extract tar archive to stdout", "output": "tar -xzvf /backup/home.tar.gz --to-stdout | less"},
  {"instruction": "Reset access time while reading with cpio", "output": "find /home/user -type f -print | cpio -oat > /backup/home.cpio"},
  {"instruction": "Substitute paths on pax extraction", "output": "pax -r -s '|/var/www|/tmp/restore|' -f /backup/www.pax"},
  {"instruction": "Sync with rclone using checksums", "output": "rclone sync --checksum /home/user remote:backup-home"},
  {"instruction": "Modify S3 object expiration with s3cmd", "output": "s3cmd modify --add-header=x-amz-expiration:90 s3://my-backup-bucket/file.tar.gz"},
  {"instruction": "Dump PostgreSQL in tar format", "output": "pg_dump -F tar mydb > /backup/mydb.tar"},
  {"instruction": "Dump MySQL without data", "output": "mysqldump --no-data mydb > /backup/mydb-schema.sql"},
  {"instruction": "Dump MongoDB to a specific output dir", "output": "mongodump --out /backup/mongodb"},
  {"instruction": "Export Borg encryption key", "output": "borg key export /backup/borg /backup/borg-key.txt"},
  {"instruction": "List Restic keys", "output": "restic -r /backup/restic key list"},
  {"instruction": "Create backup rotation script with date-based dirs", "output": "DATE=$(date +%Y-%m-%d) && mkdir -p /backup/$DATE && rsync -a /home/user/ /backup/$DATE/ && find /backup -maxdepth 1 -type d -mtime +30 -exec rm -rf {} \\;"},
  {"instruction": "Restore dump with verbosity", "output": "restore -v -rf /backup/sda1.dump"},
  {"instruction": "List all dump backup levels used", "output": "dump -W"},
  {"instruction": "Dump ext4 filesystem to tape drive", "output": "dump -0uf /dev/nst0 /dev/sda1"},
  {"instruction": "Restore from tape drive", "output": "restore -rf /dev/nst0"}
]
