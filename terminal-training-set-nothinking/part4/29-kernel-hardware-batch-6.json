[
  {"instruction": "Add a custom udev rule for persistent naming", "output": "echo 'SUBSYSTEM==\"block\", ATTR{serial}==\"XYZ123\", NAME=\"mydisk\"' > /etc/udev/rules.d/99-mydisk.rules"},
  {"instruction": "Reload udev rules and trigger them", "output": "udevadm control --reload-rules && udevadm trigger"},
  {"instruction": "Add a udev rule to set permissions for USB device", "output": "echo 'SUBSYSTEM==\"usb\", ATTRS{idVendor}==\"1234\", MODE=\"0660\", GROUP=\"plugdev\"' > /etc/udev/rules.d/99-usb-permissions.rules"},
  {"instruction": "Add udev rule to run script on USB insertion", "output": "echo 'ACTION==\"add\", SUBSYSTEM==\"usb\", ENV{ID_FS_UUID}==\"ABC123\", RUN+=\"/usr/local/bin/backup.sh\"' > /etc/udev/rules.d/99-usb-backup.rules"},
  {"instruction": "List all udev rules files", "output": "ls /etc/udev/rules.d/"},
  {"instruction": "Show kernel ring buffer messages", "output": "dmesg"},
  {"instruction": "Follow dmesg in real-time", "output": "dmesg -w"},
  {"instruction": "Clear dmesg ring buffer", "output": "dmesg -c"},
  {"instruction": "Show dmesg with human-readable timestamps", "output": "dmesg -T"},
  {"instruction": "Show dmesg with facility and level", "output": "dmesg -x"},
  {"instruction": "Show only kernel errors in dmesg", "output": "dmesg --level=err"},
  {"instruction": "Show dmesg for USB subsystem", "output": "dmesg | grep -i usb"},
  {"instruction": "Limit dmesg output to last 20 lines", "output": "dmesg | tail -20"},
  {"instruction": "Show kernel module parameters via sysfs", "output": "ls /sys/module/usb_storage/parameters/"},
  {"instruction": "Read a sysfs attribute for block device", "output": "cat /sys/block/sda/queue/scheduler"},
  {"instruction": "Change I/O scheduler via sysfs", "output": "echo none > /sys/block/sda/queue/scheduler"},
  {"instruction": "Show driver bind/unbind via sysfs", "output": "ls /sys/bus/pci/drivers/nvidia/"},
  {"instruction": "Show kernel parameter from /proc/cmdline", "output": "cat /proc/cmdline"},
  {"instruction": "Show interrupt requests via /proc/interrupts", "output": "cat /proc/interrupts"},
  {"instruction": "Show CPU info from /proc/cpuinfo", "output": "cat /proc/cpuinfo"},
  {"instruction": "Show memory info from /proc/meminfo", "output": "cat /proc/meminfo"},
  {"instruction": "Show filesystem mounts from /proc/mounts", "output": "cat /proc/mounts | head -10"},
  {"instruction": "Show kernel modules from /proc/modules", "output": "cat /proc/modules"},
  {"instruction": "Show partitions from /proc/partitions", "output": "cat /proc/partitions"},
  {"instruction": "Show disk stats from /proc/diskstats", "output": "cat /proc/diskstats | head -10"},
  {"instruction": "Test udev built-in path_id for network device", "output": "udevadm test-builtin path_id /sys/class/net/eth0 2>/dev/null"}
]
