[
  {"instruction": "Rsync with progress display", "output": "rsync -avh --progress /home/user/ /backup/data/"},
  {"instruction": "Borg create with return code check", "output": "borg create --show-rc /backup/borg::home-{now:%Y-%m-%d} /home/user"},
  {"instruction": "Find files in Restic snapshots", "output": "restic -r /backup/restic find myfile.txt"},
  {"instruction": "Set rdiff-backup checkpoint interval", "output": "rdiff-backup --checkpoint-interval 300 /etc /backup/etc"},
  {"instruction": "Duplicity force full backup if older than 7 days", "output": "duplicity --full-if-older-than 7D /home/user file:///backup/duplicity"},
  {"instruction": "Extract specific path from DAR archive", "output": "dar -x /backup/home-dar -R /tmp/restore -g home/user/Documents"},
  {"instruction": "Create incremental dump level 1 with file", "output": "dump -1uf /backup/sda1-level1.dump -f /dev/nst0 /dev/sda1"},
  {"instruction": "Zero-fill free space with dd", "output": "dd if=/dev/zero of=/zero.fill bs=4M; rm /zero.fill"},
  {"instruction": "Fill bad sectors with ddrescue", "output": "ddrescue --fill-mode=- /dev/sda /backup/sda.img /backup/sda.log"},
  {"instruction": "Tar backup excluding tag files", "output": "tar --exclude-tag=DO_NOT_BACKUP -czvf /backup/home.tar.gz /home/user"},
  {"instruction": "Cpio with make directories on extract", "output": "cpio -idmv < /backup/home.cpio"},
  {"instruction": "List contents of pax archive", "output": "pax -f /backup/www.pax"},
  {"instruction": "List rclone remote files as JSON", "output": "rclone lsjson remote:backup-home"},
  {"instruction": "Show info about s3cmd bucket", "output": "s3cmd info s3://my-backup-bucket/"},
  {"instruction": "Restore PostgreSQL dump with multiple jobs", "output": "pg_restore -d mydb -j 4 /backup/mydb.dump"},
  {"instruction": "Dump MySQL specific tables", "output": "mysqldump mydb users orders > /backup/mydb-tables.sql"},
  {"instruction": "Restore MongoDB with drop collections first", "output": "mongorestore --drop --db mydb /backup/mongodb/mydb/"},
  {"instruction": "Export Borg archive as tar", "output": "borg export-tar /backup/borg::home-2026-07-20 /backup/home.tar.gz"},
  {"instruction": "Tag a Restic snapshot", "output": "restic -r /backup/restic tag --add monthly 12345678"},
  {"instruction": "List files modified in last 7 days for backup", "output": "find /home/user -type f -mtime -7 -print0 | xargs -0 tar -czvf /backup/weekly.tar.gz"},
  {"instruction": "Create incremental backup with rdiff-backup", "output": "rdiff-backup --no-compression /etc /backup/etc"},
  {"instruction": "Backup MBR with dd", "output": "dd if=/dev/sda of=/backup/mbr.img bs=512 count=1"},
  {"instruction": "Restore MBR from backup", "output": "dd if=/backup/mbr.img of=/dev/sda bs=512 count=1"},
  {"instruction": "Dump ext4 filesystem with verbose", "output": "dump -0uf - /dev/sda1 | gzip > /backup/sda1.dump.gz"},
  {"instruction": "List restic snapshots with JSON output", "output": "restic -r /backup/restic snapshots --json"}
]
