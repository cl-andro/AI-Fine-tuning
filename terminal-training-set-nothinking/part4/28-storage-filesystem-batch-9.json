[
  {"instruction": "Initialize a physical volume on /dev/sdb1", "output": "pvcreate /dev/sdb1"},
  {"instruction": "Create a physical volume on /dev/sdc1", "output": "pvcreate /dev/sdc1"},
  {"instruction": "Initialize multiple disks as PVs at once", "output": "pvcreate /dev/sdd1 /dev/sde1 /dev/sdf1"},
  {"instruction": "Create a volume group named vg_data", "output": "vgcreate vg_data /dev/sdb1 /dev/sdc1"},
  {"instruction": "Create VG with 4MiB extent size", "output": "vgcreate -s 4M vg_data /dev/sdb1"},
  {"instruction": "Create a 10GiB logical volume from vg_data", "output": "lvcreate -L 10G -n lv_data vg_data"},
  {"instruction": "Create a logical volume using all free space", "output": "lvcreate -l 100%FREE -n lv_full vg_data"},
  {"instruction": "Create a thin pool of 100GiB", "output": "lvcreate -L 100G -T vg_data/thinpool"},
  {"instruction": "Create a thin volume from pool", "output": "lvcreate -V 50G -T vg_data/thinpool -n lv_thin"},
  {"instruction": "Extend lv_data to 20GiB", "output": "lvextend -L 20G /dev/vg_data/lv_data"},
  {"instruction": "Extend LV by 5GiB", "output": "lvextend -L +5G /dev/vg_data/lv_data"},
  {"instruction": "Extend LV to use all remaining free space", "output": "lvextend -l +100%FREE /dev/vg_data/lv_data"},
  {"instruction": "Reduce lv_data to 8GiB", "output": "lvreduce -L 8G /dev/vg_data/lv_data"},
  {"instruction": "Reduce LV by 2GiB", "output": "lvreduce -L -2G /dev/vg_data/lv_data"},
  {"instruction": "Resize LV to 15GiB (grow or shrink)", "output": "lvresize -L 15G /dev/vg_data/lv_data"},
  {"instruction": "Resize LV and filesystem in one step", "output": "lvresize -L +5G -r /dev/vg_data/lv_data"},
  {"instruction": "Display PV attributes", "output": "pvdisplay /dev/sdb1"},
  {"instruction": "Display all physical volumes", "output": "pvdisplay"},
  {"instruction": "Display VG details", "output": "vgdisplay vg_data"},
  {"instruction": "Display all volume groups", "output": "vgdisplay"},
  {"instruction": "Display LV details", "output": "lvdisplay /dev/vg_data/lv_data"},
  {"instruction": "Display all logical volumes", "output": "lvdisplay"},
  {"instruction": "Move physical extents from /dev/sdb1 to /dev/sdf1", "output": "pvmove /dev/sdb1 /dev/sdf1"},
  {"instruction": "Move all PEs off a failing disk", "output": "pvmove -i 5 /dev/sdb1"},
  {"instruction": "Extend VG by adding a PV", "output": "vgextend vg_data /dev/sdg1"},
  {"instruction": "Remove PV /dev/sdg1 from VG", "output": "vgreduce vg_data /dev/sdg1"}
]
