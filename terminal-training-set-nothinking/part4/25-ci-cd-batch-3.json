[
  {"instruction": "Download artifacts from a GitHub Actions run", "output": "gh run download 123456789"},
  {"instruction": "Watch GitHub Actions run waiting for completion", "output": "gh run watch 123456789 && gh run view 123456789 --log"},
  {"instruction": "Lint a GitLab CI config file", "output": "glab ci lint .gitlab-ci.yml"},
