  {"instruction": "Dry-run semantic-release", "output": "npx semantic-release --dry-run --no-ci"},
  {"instruction": "Lint last commit message", "output": "echo $(git log -1 --pretty=%B) | commitlint"},
  {"instruction": "Add a Husky hook", "output": "npx husky add .husky/commit-msg 'npx --no -- commitlint --edit $1'"},
