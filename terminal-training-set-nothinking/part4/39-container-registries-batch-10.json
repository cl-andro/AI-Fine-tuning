[
  {"instruction": "Scan a container image with Trivy", "output": "trivy image myregistry.example.com/myapp:1.0"},
  {"instruction": "Scan a container image with Grype", "output": "grype myregistry.example.com/myapp:1.0"},
  {"instruction": "Generate an SBOM for a container image with Syft", "output": "syft myregistry.example.com/myapp:1.0 -o spdx-json=sbom.json"},
  {"instruction": "Scan a container image with Docker Scout", "output": "docker scout quickview myregistry.example.com/myapp:1.0"},
  {"instruction": "Generate a Docker SBOM for an image", "output": "docker sbom myregistry.example.com/myapp:1.0"},
  {"instruction": "List the Red Hat Quay API endpoints", "output": "curl -s https://quay.example.com/api/v1/ | jq ."},
  {"instruction": "List repositories in a Quay organization", "output": "curl -s -u user:password https://quay.example.com/api/v1/repository?namespace=myorg | jq .repositories"},
  {"instruction": "Create a repository in Quay via API", "output": "curl -X POST -u user:password -H \"Content-Type: application/json\" -d '{\"namespace\":\"myorg\",\"repository\":\"myapp\",\"visibility\":\"public\"}' https://quay.example.com/api/v1/repository"},
  {"instruction": "Change the visibility of a Quay repository", "output": "curl -X PUT -u user:password -H \"Content-Type: application/json\" -d '{\"visibility\":\"private\"}' https://quay.example.com/api/v1/repository/myorg/myapp"},
  {"instruction": "List images in a GitLab container registry via API", "output": "curl -H \"PRIVATE-TOKEN: glpat-xxx\" https://gitlab.example.com/api/v4/projects/123/registry/repositories"},
  {"instruction": "Delete an image from GitLab container registry", "output": "curl -X DELETE -H \"PRIVATE-TOKEN: glpat-xxx\" https://gitlab.example.com/api/v4/projects/123/registry/repositories/456"},
  {"instruction": "Configure Renovate to update container images", "output": "cat > renovate.json << 'EOF'\n{\n  \"$schema\": \"https://docs.renovatebot.com/renovate-schema.json\",\n  \"packageRules\": [\n    {\n      \"matchDatasources\": [\"docker\"],\n      \"labels\": [\"docker-update\"]\n    }\n  ]\n}\nEOF"},
  {"instruction": "List vulnerabilities in a registry image with Trivy", "output": "trivy image --severity HIGH,CRITICAL myregistry.example.com/myapp:1.0"},
  {"instruction": "Scan a registry with Trivy for misconfigurations", "output": "trivy config --severity HIGH,CRITICAL myregistry.example.com/myapp:1.0"},
  {"instruction": "Pull all tags from a registry to local with skopeo", "output": "skopeo sync --src docker --dest dir myregistry.example.com/myapp /tmp/images"},
  {"instruction": "List all artifacts in a registry with ORAS", "output": "oras repo ls myregistry.example.com"},
  {"instruction": "Export the Red Hat Quay security report for an image", "output": "curl -s -u user:password https://quay.example.com/api/v1/repository/myorg/myapp/manifest/sha256:abc/security | jq ."},
  {"instruction": "Set a Docker Hub repository description via API", "output": "curl -X PATCH -u myuser:password -H \"Content-Type: application/json\" -d '{\"description\":\"My application image\"}' https://hub.docker.com/v2/repositories/myuser/myapp/"},
  {"instruction": "Get the number of pulls for a Docker Hub repository", "output": "curl -s https://hub.docker.com/v2/repositories/myuser/myapp/ | jq .pull_count"},
  {"instruction": "Install Trivy on Debian 12", "output": "wget https://github.com/aquasecurity/trivy/releases/latest/download/trivy_Linux-64bit.deb && sudo dpkg -i trivy_Linux-64bit.deb"},
  {"instruction": "Install Grype on Debian 12", "output": "curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin"},
  {"instruction": "Install Syft on Debian 12", "output": "curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin"},
  {"instruction": "List GitLab container registries for a group", "output": "curl -H \"PRIVATE-TOKEN: glpat-xxx\" https://gitlab.example.com/api/v4/groups/123/registry/repositories"},
  {"instruction": "Get Quay API status", "output": "curl -s https://quay.example.com/api/v1/ | jq .status"},
  {"instruction": "Export the raw SBOM with Syft in CycloneDX format", "output": "syft myregistry.example.com/myapp:1.0 -o cyclonedx-json=sbom.cdx.json"},
  {"instruction": "Compare two images with Trivy", "output": "trivy image --diff myregistry.example.com/myapp:1.0 myregistry.example.com/myapp:2.0"}
]
