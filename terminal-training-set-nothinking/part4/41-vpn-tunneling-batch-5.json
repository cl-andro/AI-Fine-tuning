[
  {
    "instruction": "Start a SoftEther VPN server (vpnserver)",
    "output": "sudo /usr/local/vpnserver/vpncmd localhost:443 /SERVER /CMD ServerStart"
  },
  {
    "instruction": "Stop the SoftEther VPN server",
    "output": "sudo /usr/local/vpnserver/vpncmd localhost:443 /SERVER /CMD ServerStop"
  },
  {
    "instruction": "Connect to a local SoftEther VPN server via vpncmd",
    "output": "sudo vpncmd localhost:5555 /SERVER /HUB:DEFAULT /PASSWORD:admin"
  },
  {
    "instruction": "Create a new virtual hub named HUB1 on SoftEther",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD HubCreate HUB1 /PASSWORD:hubpass"
  },
  {
    "instruction": "Delete a virtual hub named HUB1 on SoftEther",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD HubDelete HUB1"
  },
  {
    "instruction": "List all virtual hubs on the SoftEther server",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD HubList"
  },
  {
    "instruction": "Create a new user named alice on hub HUB1 with password",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD UserCreate alice /GROUP:none /REALNAME:none /NOTE:none"
  },
  {
    "instruction": "Set the password for user alice on hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD UserPasswordSet alice /PASSWORD:securepass"
  },
  {
    "instruction": "Delete user alice from hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD UserDelete alice"
  },
  {
    "instruction": "List all users on hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD UserList"
  },
  {
    "instruction": "Enable SecureNAT on the virtual hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD SecureNatEnable"
  },
  {
    "instruction": "Disable SecureNAT on the virtual hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD SecureNatDisable"
  },
  {
    "instruction": "Show SecureNAT status on hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD SecureNatStatusGet"
  },
  {
    "instruction": "Create a Local Bridge between HUB1 and network interface eth0",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD BridgeCreate HUB1 /DEVICE:eth0 /TAP:no"
  },
  {
    "instruction": "List all Local Bridges on the SoftEther server",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD BridgeList"
  },
  {
    "instruction": "Create a cascade connection to another SoftEther server",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD CascadeCreate cascade1 /SERVER:remote.example.com:443 /HUB:REMOTE_HUB /USERNAME:admin /PASSWORD:pass"
  },
  {
    "instruction": "Start a cascade connection named cascade1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD CascadeOnline cascade1"
  },
  {
    "instruction": "Stop a cascade connection named cascade1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD CascadeOffline cascade1"
  },
  {
    "instruction": "Set the SoftEther server listening port to 443",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD ListenerCreate 443"
  },
  {
    "instruction": "Set OpenVPN cloning on SoftEther hub HUB1 to enable OpenVPN compat",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD OpenVpnEnable yes /PORTS:1194"
  },
  {
    "instruction": "Get the SoftEther server version and build info",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD ServerVersionGet"
  },
  {
    "instruction": "Disable the SoftEther IPsec / L2TP server function",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD IPsecEnable /L2TP:no /L2TPRAW:no /ETHERIP:no"
  },
  {
    "instruction": "Enable the SoftEther EtherIP / L2TPv3 function",
    "output": "sudo vpncmd localhost:443 /SERVER /CMD IPsecEnable /L2TP:yes /L2TPRAW:yes /ETHERIP:no"
  },
  {
    "instruction": "List all connected VPN sessions on hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD SessionList"
  },
  {
    "instruction": "Disconnect a VPN session by name on hub HUB1",
    "output": "sudo vpncmd localhost:443 /SERVER /HUB:HUB1 /CMD SessionDisconnect SESSION-ALICE-001"
  }
]