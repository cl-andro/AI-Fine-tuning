[
  {"instruction": "Rsync with bandwidth limit", "output": "rsync -avh --bwlimit=5000 /home/user/ /backup/data/"},
  {"instruction": "Borg create with exclude-from file", "output": "borg create --exclude-from /home/user/.borg-exclude /backup/borg::home-{now:%Y-%m-%d} /home/user"},
  {"instruction": "Restic backup with exclude file", "output": "restic -r /backup/restic backup --exclude-file=/home/user/.restic-exclude /home/user"},
  {"instruction": "Exclude specific files in rdiff-backup", "output": "rdiff-backup --exclude /etc/ssl/certs /etc /backup/etc"},
  {"instruction": "Include pattern with duplicity", "output": "duplicity --include /home/user/Documents --exclude '**' /home/user file:///backup/duplicity"},
  {"instruction": "List FSA entries in DAR archive", "output": "dar -l /backup/home-dar --fsa"},
  {"instruction": "Display dump estimated sizes", "output": "dump -D /dev/sda1"},
  {"instruction": "Extract specific inode from dump", "output": "restore -x -f /backup/sda1.dump --inode 123456"},
  {"instruction": "Seek to position with dd", "output": "dd if=/backup/sda.img of=/dev/sda bs=4M seek=100 skip=100 status=progress"},
  {"instruction": "Set ddrescue cluster size", "output": "ddrescue --cluster-size=4096 /dev/sda /backup/sda.img /backup/sda.log"},
  {"instruction": "Preserve extended attributes in tar", "output": "tar --xattrs -czvf /backup/home-xattr.tar.gz /home/user"},
  {"instruction": "Cpio with no-absolute-filenames", "output": "find /home/user -type f | cpio -o --no-absolute-filenames > /backup/home-rel.cpio"},
  {"instruction": "Dereference symlinks in pax", "output": "pax -w -L -f /backup/www.pax /var/www"},
  {"instruction": "Deduplicate files on rclone remote", "output": "rclone dedupe remote:backup-home"},
  {"instruction": "Sync and delete removed files with s3cmd", "output": "s3cmd sync --delete-removed /home/user/ s3://my-backup-bucket/home/"},
  {"instruction": "Output pg_dump to a file explicitly", "output": "pg_dump -f /backup/mydb.sql mydb"},
  {"instruction": "Output mysqldump to result file", "output": "mysqldump --result-file=/backup/mydb.sql mydb"},
  {"instruction": "Borg create with stdin name", "output": "tar -czf - /home/user | borg create /backup/borg::home-stdin --stdin-name home.tar.gz -"},
  {"instruction": "Restic backup without local cache", "output": "restic -r /backup/restic --no-cache backup /home/user"},
  {"instruction": "Backup to tape using mt and tar", "output": "mt -f /dev/nst0 rewind && tar -czvf /dev/nst0 /home/user"},
  {"instruction": "Backup with dd and tape positioning", "output": "mt -f /dev/nst0 eom; dd if=/dev/sda of=/dev/nst0 bs=4M"},
  {"instruction": "List tape contents", "output": "mt -f /dev/nst0 rewind && tar -tzf /dev/nst0"},
  {"instruction": "Execute Borg info on all archives", "output": "borg list /backup/borg | awk '{print $1}' | xargs -I{} sh -c 'borg info /backup/borg::{}'"},
  {"instruction": "Restic forget keeping only last snapshot", "output": "restic -r /backup/restic forget --keep-last 1 --prune"},
  {"instruction": "Clone disk partition with sfdisk and dd", "output": "sfdisk -d /dev/sda | sfdisk /dev/sdb && dd if=/dev/sda1 of=/dev/sdb1 bs=4M status=progress"}
]
