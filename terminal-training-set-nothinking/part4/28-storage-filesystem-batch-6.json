[
  {"instruction": "Create a Btrfs subvolume @data", "output": "btrfs subvolume create /mnt/btrfs/@data"},
  {"instruction": "List all Btrfs subvolumes", "output": "btrfs subvolume list /mnt/btrfs"},
  {"instruction": "Show subvolume details of @data", "output": "btrfs subvolume show /mnt/btrfs/@data"},
  {"instruction": "Delete subvolume @olddata", "output": "btrfs subvolume delete /mnt/btrfs/@olddata"},
  {"instruction": "Snapshot @data to @snap-20240725", "output": "btrfs subvolume snapshot /mnt/btrfs/@data /mnt/btrfs/@snap-20240725"},
  {"instruction": "Create read-only snapshot of @data", "output": "btrfs subvolume snapshot -r /mnt/btrfs/@data /mnt/btrfs/@snap-ro"},
  {"instruction": "Send a snapshot to a file", "output": "btrfs send /mnt/btrfs/@snap-ro > /backup/snap.btrfs"},
  {"instruction": "Send snapshot incrementally (parent -> child)", "output": "btrfs send -p /mnt/btrfs/@snap-01 /mnt/btrfs/@snap-02 > /backup/incr.btrfs"},
  {"instruction": "Receive a Btrfs stream into /mnt/restore", "output": "btrfs receive /mnt/restore < /backup/snap.btrfs"},
  {"instruction": "Start a Btrfs balance on /mnt/btrfs", "output": "btrfs balance start /mnt/btrfs"},
  {"instruction": "Balance only metadata chunks", "output": "btrfs balance start -m /mnt/btrfs"},
  {"instruction": "Balance with usage filter (0-99%)", "output": "btrfs balance start -dusage=50 /mnt/btrfs"},
  {"instruction": "Cancel running balance operation", "output": "btrfs balance cancel /mnt/btrfs"},
  {"instruction": "Pause Btrfs balance", "output": "btrfs balance pause /mnt/btrfs"},
  {"instruction": "Resume Btrfs balance", "output": "btrfs balance resume /mnt/btrfs"},
  {"instruction": "Start a Btrfs scrub on /mnt/btrfs", "output": "btrfs scrub start /mnt/btrfs"},
  {"instruction": "Show scrub status on /mnt/btrfs", "output": "btrfs scrub status /mnt/btrfs"},
  {"instruction": "Cancel Btrfs scrub", "output": "btrfs scrub cancel /mnt/btrfs"},
  {"instruction": "Add device /dev/sdf1 to Btrfs filesystem", "output": "btrfs device add /dev/sdf1 /mnt/btrfs"},
  {"instruction": "Remove device /dev/sdf1 from Btrfs", "output": "btrfs device remove /dev/sdf1 /mnt/btrfs"},
  {"instruction": "Show Btrfs device stats", "output": "btrfs device stats /mnt/btrfs"},
  {"instruction": "Show Btrfs filesystem usage", "output": "btrfs filesystem usage /mnt/btrfs"},
  {"instruction": "Show Btrfs df-like space info", "output": "btrfs filesystem df /mnt/btrfs"},
  {"instruction": "Resize Btrfs filesystem to 50GiB", "output": "btrfs filesystem resize 50G /mnt/btrfs"},
  {"instruction": "Defragment a Btrfs directory", "output": "btrfs filesystem defragment -r /mnt/btrfs/@data"},
  {"instruction": "Enable compression globally on Btrfs", "output": "btrfs filesystem defragment -r -v -czstd /mnt/btrfs/@data"}
]
