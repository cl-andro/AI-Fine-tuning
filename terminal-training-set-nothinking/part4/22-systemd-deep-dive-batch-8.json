[
  {"instruction": "Check current system time and time zone", "output": "timedatectl"},
  {"instruction": "List all available time zones", "output": "timedatectl list-timezones"},
  {"instruction": "Set the system time zone to Europe/Berlin", "output": "sudo timedatectl set-timezone Europe/Berlin"},
  {"instruction": "Enable NTP time synchronization", "output": "sudo timedatectl set-ntp yes"},
  {"instruction": "Set system date and time manually", "output": "sudo timedatectl set-time '2024-12-25 08:30:00'"},
  {"instruction": "Show RTC time configuration", "output": "timedatectl show"},
  {"instruction": "Check system hostname", "output": "hostnamectl"},
  {"instruction": "Set the system hostname to server01", "output": "sudo hostnamectl set-hostname server01"},
  {"instruction": "Set a pretty hostname for the system", "output": "sudo hostnamectl set-hostname 'Production Server' --pretty"},
  {"instruction": "Show the current hostname configuration", "output": "hostnamectl status"},
  {"instruction": "Check system locale settings", "output": "localectl"},
  {"instruction": "List available locales", "output": "localectl list-locales"},
  {"instruction": "Set system locale to en_US.UTF-8", "output": "sudo localectl set-locale LANG=en_US.UTF-8"},
  {"instruction": "Set the system keymap to de-latin1", "output": "sudo localectl set-keymap de-latin1"},
  {"instruction": "List available keymaps", "output": "localectl list-keymaps"},
  {"instruction": "List current user sessions with loginctl", "output": "loginctl list-sessions"},
  {"instruction": "Show details of a specific user session", "output": "loginctl show-session 2"},
  {"instruction": "Show details for a specific user", "output": "loginctl show-user 1000"},
  {"instruction": "List all seats on the system", "output": "loginctl list-seats"},
  {"instruction": "Terminate a specific user session", "output": "sudo loginctl terminate-session 2"},
  {"instruction": "Terminate all sessions for a user", "output": "sudo loginctl terminate-user 1000"},
  {"instruction": "Lock all local sessions", "output": "sudo loginctl lock-sessions"},
  {"instruction": "Unlock all local sessions", "output": "sudo loginctl unlock-sessions"},
  {"instruction": "Show systemd-resolved DNS configuration", "output": "resolvectl status"},
  {"instruction": "Query DNS using systemd-resolved", "output": "resolvectl query debian.org"},
  {"instruction": "Flush DNS cache in systemd-resolved", "output": "sudo resolvectl flush-caches"}
]
