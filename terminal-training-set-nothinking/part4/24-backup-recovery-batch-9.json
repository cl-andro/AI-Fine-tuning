[
  {"instruction": "Rsync with partial transfer resume", "output": "rsync -avh --partial /home/user/bigfile.iso /backup/data/"},
  {"instruction": "Bypass Borg repository lock", "output": "borg create --bypass-lock /backup/borg::home-{now:%Y-%m-%d} /home/user"},
  {"instruction": "Restic backup using password file", "output": "restic -r /backup/restic --password-file=/etc/restic-passwd backup /home/user"},
  {"instruction": "Set rdiff-backup terminal verbosity", "output": "rdiff-backup --terminal-verbosity 5 /etc /backup/etc"},
  {"instruction": "Duplicity with specific encryption key", "output": "duplicity --encrypt-key A1B2C3D4 /home/user file:///backup/duplicity"},
  {"instruction": "Save DAR contents to alternate directory", "output": "dar -c /backup/home-dar --savedir /home/user/Documents -R /home/user"},
  {"instruction": "Estimate dump size before running", "output": "dump -E /dev/sda1"},
  {"instruction": "Restore with time specification", "output": "restore -T 202607201200 -rf /dev/nst0"},
  {"instruction": "Read specific count of blocks with dd", "output": "dd if=/dev/sda of=/backup/sda-part.img bs=4M count=100 status=progress"},
  {"instruction": "Ask before overwriting with ddrescue", "output": "ddrescue --ask /dev/sda /backup/sda.img /backup/sda.log"},
  {"instruction": "Check for broken links during tar", "output": "tar --check-links -czvf /backup/home.tar.gz /home/user"},
  {"instruction": "Cpio with pattern file", "output": "cpio -o < /backup/include-list.txt > /backup/selected.cpio"},
  {"instruction": "Compress pax archive", "output": "pax -w -z -f /backup/www.tar.gz /var/www"},
  {"instruction": "Create rclone crypt remote", "output": "rclone config create cryptremote crypt remote=backup-home: encrypted=''"},
  {"instruction": "Add destination for S3 copy with s3cmd", "output": "s3cmd cp --add-dest s3://other-bucket/ s3://my-backup-bucket/file.txt"},
  {"instruction": "Exclude specific tables with pg_dump", "output": "pg_dump -T logs -T temp_data mydb > /backup/mydb.sql"},
  {"instruction": "Dump MySQL in XML format", "output": "mysqldump --xml mydb > /backup/mydb.xml"},
  {"instruction": "Compress MongoDB dump with gzip", "output": "mongodump --db mydb --gzip --out /backup/mongodb"},
  {"instruction": "Benchmark Borg CPU compression", "output": "borg benchmark cpu /backup/borg"},
  {"instruction": "Self-update Restic binary", "output": "restic self-update"},
  {"instruction": "Test restore with dry-run", "output": "restic -r /backup/restic restore latest --target /tmp/restore --dry-run"},
  {"instruction": "List diff between two rdiff-backup times", "output": "rdiff-backup --list-changes-since 2026-07-20 /backup/etc"},
  {"instruction": "Create encrypted dump with dump", "output": "dump -0uf - /dev/sda1 | gzip | openssl enc -aes-256-cbc -out /backup/sda1.dump.enc"},
  {"instruction": "Restore encrypted dump", "output": "openssl enc -d -aes-256-cbc -in /backup/sda1.dump.enc | gunzip | restore -rf -"},
  {"instruction": "Show dump backup history", "output": "dump -W | grep /dev/sda1"}
]
