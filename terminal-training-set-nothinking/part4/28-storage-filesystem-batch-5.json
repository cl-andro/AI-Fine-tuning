[
  {"instruction": "Display XFS filesystem info on /dev/sdc1", "output": "xfs_info /dev/sdc1"},
  {"instruction": "Grow an XFS filesystem to fill the device", "output": "xfs_growfs /dev/sdc1"},
  {"instruction": "Grow XFS mountpoint /mnt/data to 100GiB", "output": "xfs_growfs -D 102400 /mnt/data"},
  {"instruction": "Grow XFS log area to 64MiB", "output": "xfs_growfs -L 65536 /mnt/data"},
  {"instruction": "Repair an XFS filesystem on /dev/sdc1", "output": "xfs_repair /dev/sdc1"},
  {"instruction": "Repair XFS and rebuild metadata", "output": "xfs_repair -v /dev/sdc1"},
  {"instruction": "Repair XFS with dirty log (force replay)", "output": "xfs_repair -L /dev/sdc1"},
  {"instruction": "Check XFS filesystem without modifying", "output": "xfs_repair -n /dev/sdc1"},
  {"instruction": "Enable reflink+dedupe on XFS", "output": "xfs_info /mnt/data | grep -i reflink"},
  {"instruction": "Set XFS project quota on /srv/project", "output": "xfs_quota -x -c 'project -s project1' /srv/project"},
  {"instruction": "Set XFS real-time device on new fs", "output": "mkfs.xfs -r rtdev=/dev/sdi1 /dev/sdc1"},
  {"instruction": "Dump XFS mount options and geometry", "output": "xfs_info /mnt/logs"},
  {"instruction": "Perform XFS filesystem freeze for backup", "output": "xfs_freeze -f /mnt/data"},
  {"instruction": "Unfreeze XFS filesystem after backup", "output": "xfs_freeze -u /mnt/data"},
  {"instruction": "Repair XFS with inode 64-bit handling", "output": "xfs_repair -i inode64 /dev/sdc1"},
  {"instruction": "Repair XFS phase specific (phase 2 only)", "output": "xfs_repair -P 2 /dev/sdc1"},
  {"instruction": "Set XFS speculative prealloc limit", "output": "xfs_io -c 'extsize 65536' /mnt/data"},
  {"instruction": "Check XFS log size on device", "output": "xfs_info /dev/sdc1 | grep 'log.*blocks'"},
  {"instruction": "Dump XFS ag geometry", "output": "xfs_db -c 'agf 0' -c 'p' /dev/sdc1"},
  {"instruction": "Corrupt XFS superblock check", "output": "xfs_db -c 'sb 0' -c 'p' /dev/sdc1"},
  {"instruction": "Increase XFS allocation group count", "output": "xfs_growfs -n 0 /mnt/data"},
  {"instruction": "Check XFS inode free count", "output": "xfs_info /mnt/data | grep 'inodes'"},
  {"instruction": "Repair XFS with max depth 100", "output": "xfs_repair -d 0 /dev/sdc1"},
  {"instruction": "Show XFS log content", "output": "xfs_logprint /dev/sdc1"}
]
