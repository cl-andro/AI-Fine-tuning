[
  {"instruction": "Update initramfs for current kernel", "output": "update-initramfs -u"},
  {"instruction": "Update initramfs for all kernels", "output": "update-initramfs -u -k all"},
  {"instruction": "Create initramfs for kernel 6.1.0-17-amd64", "output": "update-initramfs -c -k 6.1.0-17-amd64"},
  {"instruction": "Delete initramfs for a kernel", "output": "update-initramfs -d -k 6.1.0-17-amd64"},
  {"instruction": "Backup then update initramfs", "output": "update-initramfs -b -u -k 6.1.0-17-amd64"},
  {"instruction": "Create initramfs with mkinitramfs", "output": "mkinitramfs -o /boot/initrd.img-6.1.0-17-amd64 6.1.0-17-amd64"},
  {"instruction": "Create compressed initramfs with lz4", "output": "mkinitramfs -c lz4 -o /boot/initrd.img-custom 6.1.0-17-amd64"},
  {"instruction": "Set up a zram device of 2GiB", "output": "modprobe zram && echo 2G > /sys/block/zram0/disksize && mkswap /dev/zram0 && swapon -p 100 /dev/zram0"},
  {"instruction": "Configure zram with lz4 compression", "output": "echo lz4 > /sys/block/zram0/comp_algorithm"},
  {"instruction": "Reset zram device to free memory", "output": "swapoff /dev/zram0 && echo 1 > /sys/block/zram0/reset"},
  {"instruction": "Show zram stats and compression ratios", "output": "cat /sys/block/zram0/mm_stat"},
  {"instruction": "Enable zswap (compressed swap cache)", "output": "echo lz4 > /sys/module/zswap/parameters/compressor && echo 20 > /sys/module/zswap/parameters/max_pool_percent"},
  {"instruction": "Check zswap current usage", "output": "grep -r . /sys/kernel/debug/zswap/ 2>/dev/null || cat /sys/kernel/debug/zswap/stored_pages"},
  {"instruction": "Enable Kernel Same-page Merging (KSM)", "output": "echo 1 > /sys/kernel/mm/ksm/run"},
  {"instruction": "Set KSM sleep time (milliseconds)", "output": "echo 100 > /sys/kernel/mm/ksm/sleep_millisecs"},
  {"instruction": "Set KSM merge across nodes to 1", "output": "echo 1 > /sys/kernel/mm/ksm/merge_across_nodes"},
  {"instruction": "Show KSM statistics", "output": "cat /sys/kernel/mm/ksm/pages_shared"},
  {"instruction": "Allocate 512 hugepages dynamically", "output": "echo 512 > /sys/kernel/mm/hugepages/hugepages-2048kB/nr_hugepages"},
  {"instruction": "Allocate 1GiB huge pages", "output": "echo 4 > /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"},
  {"instruction": "Show hugepage allocation info", "output": "cat /proc/meminfo | grep -i huge"},
  {"instruction": "Make zram device persistent via /etc/initramfs-tools", "output": "echo 'zram' >> /etc/initramfs-tools/modules"},
  {"instruction": "Configure zram with multiple devices", "output": "modprobe zram num_devices=4"},
  {"instruction": "Check zswap compressor parameter", "output": "cat /sys/module/zswap/parameters/compressor"},
  {"instruction": "Check KSM full scans count", "output": "cat /sys/kernel/mm/ksm/full_scans"},
  {"instruction": "Set max hugepages at boot via sysctl", "output": "echo 'vm.nr_hugepages=1024' > /etc/sysctl.d/99-hugepages.conf"}
]
