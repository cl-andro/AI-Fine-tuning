[
  {"instruction": "Sign a container image with notation", "output": "notation sign --key mykey myregistry.example.com/myapp:1.0"},
  {"instruction": "Verify a notation signature on a container image", "output": "notation verify myregistry.example.com/myapp:1.0"},
  {"instruction": "List all signatures for a container image", "output": "notation list myregistry.example.com/myapp:1.0"},
  {"instruction": "Inspect a notation signature", "output": "notation inspect myregistry.example.com/myapp:1.0"},
  {"instruction": "Add a notation certificate to the trust store", "output": "notation certificate add --type ca --store mycert mycert.crt"},
  {"instruction": "Create a notation signing key", "output": "notation key generate default"},
  {"instruction": "List notation signing keys", "output": "notation key list"},
  {"instruction": "Delete a notation signing key", "output": "notation key delete mykey"},
  {"instruction": "Push an artifact with ORAS to a registry", "output": "oras push myregistry.example.com/myartifact:1.0 artifact.tar.gz:application/octet-stream"},
  {"instruction": "Pull an artifact from a registry with ORAS", "output": "oras pull myregistry.example.com/myartifact:1.0"},
  {"instruction": "Copy an artifact between registries with ORAS", "output": "oras copy myregistry.example.com/myartifact:1.0 other-registry.example.com/myartifact:1.0"},
  {"instruction": "Attach a file to an existing image with ORAS", "output": "oras attach myregistry.example.com/myapp:1.0 sbom.spdx.json:application/spdx+json"},
  {"instruction": "Discover attached artifacts for an image with ORAS", "output": "oras discover myregistry.example.com/myapp:1.0"},
  {"instruction": "Push an OCI artifact with custom media type", "output": "oras push myregistry.example.com/sbom:latest sbom.json:application/vnd.cyclonedx+json"},
  {"instruction": "Pull an OCI artifact to the current directory", "output": "oras pull myregistry.example.com/sbom:latest --output /tmp/sboms"},
  {"instruction": "List tags with ORAS", "output": "oras repo tags myregistry.example.com/myartifact"},
  {"instruction": "List repositories in a registry with ORAS", "output": "oras repo ls myregistry.example.com"},
  {"instruction": "Login to a registry with ORAS", "output": "oras login myregistry.example.com -u admin -p password"},
  {"instruction": "Logout from a registry with ORAS", "output": "oras logout myregistry.example.com"},
  {"instruction": "Pull a specific platform image with ORAS", "output": "oras pull --platform linux/amd64 myregistry.example.com/myapp:1.0"},
  {"instruction": "Push with ORAS using an OCI layout", "output": "oras push --oci-layout myregistry.example.com/myapp:1.0 ./bin:application/vnd.oci.image.layer.v1.tar+gzip"},
  {"instruction": "Install notation CLI on Debian 12", "output": "wget https://github.com/notaryproject/notation/releases/latest/download/notation-linux-amd64.tar.gz && tar -xzf notation-linux-amd64.tar.gz -C /usr/local/bin/ notation"},
  {"instruction": "Install ORAS CLI on Debian 12", "output": "wget https://github.com/oras-project/oras/releases/latest/download/oras_linux_amd64.tar.gz && tar -xzf oras_linux_amd64.tar.gz -C /usr/local/bin/ oras"},
  {"instruction": "Configure notation trust policy", "output": "cat > ~/.config/notation/trustpolicy.json << 'EOF'\n{\n  \"version\": \"1.0\",\n  \"trustPolicies\": [\n    {\n      \"name\": \"my-policy\",\n      \"registryScopes\": [\"*\"],\n      \"signatureVerification\": {\n        \"level\": \"strict\"\n      }\n    }\n  ]\n}\nEOF"},
  {"instruction": "Set notation default signing key", "output": "notation key set default"}
]
