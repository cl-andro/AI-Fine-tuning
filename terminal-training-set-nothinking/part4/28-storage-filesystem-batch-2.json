[
  {"instruction": "Create an ext4 filesystem on /dev/sdb1", "output": "mkfs.ext4 /dev/sdb1"},
  {"instruction": "Create ext4 with a volume label", "output": "mkfs.ext4 -L mydata /dev/sdb1"},
  {"instruction": "Create ext4 reserving 5% for root", "output": "mkfs.ext4 -m 5 /dev/sdb1"},
  {"instruction": "Create ext4 with 4096-byte inode size", "output": "mkfs.ext4 -I 4096 /dev/sdb1"},
  {"instruction": "Create an XFS filesystem on /dev/sdc1", "output": "mkfs.xfs /dev/sdc1"},
  {"instruction": "Create XFS with a label 'logs'", "output": "mkfs.xfs -L logs /dev/sdc1"},
  {"instruction": "Create XFS with 1MiB stripe unit and 4 stripes per group", "output": "mkfs.xfs -d sunit=2048,swidth=8192 /dev/sdc1"},
  {"instruction": "Create XFS with block size of 4096 bytes", "output": "mkfs.xfs -b size=4096 /dev/sdc1"},
  {"instruction": "Create a Btrfs filesystem on /dev/sdd1", "output": "mkfs.btrfs /dev/sdd1"},
  {"instruction": "Create Btrfs across two disks as RAID1", "output": "mkfs.btrfs -d raid1 -m raid1 /dev/sdd1 /dev/sde1"},
  {"instruction": "Create Btrfs with a label 'backup'", "output": "mkfs.btrfs -L backup /dev/sdd1"},
  {"instruction": "Create Btrfs with 16KiB node size", "output": "mkfs.btrfs -n 16k /dev/sdd1"},
  {"instruction": "Create a FAT32 filesystem on /dev/sdf1", "output": "mkfs.fat -F 32 /dev/sdf1"},
  {"instruction": "Create FAT32 with volume name 'BOOT'", "output": "mkfs.fat -n BOOT /dev/sdf1"},
  {"instruction": "Create exFAT filesystem on /dev/sdg1", "output": "mkfs.exfat /dev/sdg1"},
  {"instruction": "Create exFAT with label 'USBDRIVE'", "output": "mkfs.exfat -n USBDRIVE /dev/sdg1"},
  {"instruction": "Create ext4 with 64-bit feature and 1G block group", "output": "mkfs.ext4 -O 64bit -G 1 /dev/sdh1"},
  {"instruction": "Create ext4 with journal at /dev/sdi1 on /dev/sdh1", "output": "mkfs.ext4 -J device=/dev/sdi1 /dev/sdh1"},
  {"instruction": "Create ext4 with strict reliability (data=ordered)", "output": "mkfs.ext4 -O journal_data_writeback /dev/sdh1"},
  {"instruction": "Show mkfs.ext4 usage summary", "output": "mkfs.ext4 -h"},
  {"instruction": "Check available mkfs filesystem types", "output": "ls /sbin/mkfs.*"},
  {"instruction": "Create FAT16 filesystem (form factor floppy)", "output": "mkfs.fat -F 16 /dev/sdf1"},
  {"instruction": "Create XFS with external log on /dev/sdi1", "output": "mkfs.xfs -l logdev=/dev/sdi1,size=100m /dev/sdc1"}
