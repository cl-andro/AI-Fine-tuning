[
  {"instruction": "Rsync removing source files after transfer", "output": "rsync -avh --remove-source-files /home/user/ /backup/data/"},
  {"instruction": "Borg create with lock wait timeout", "output": "borg create --lock-wait 60 /backup/borg::home-{now:%Y-%m-%d} /home/user"},
  {"instruction": "Restic backup with upload speed limit", "output": "restic -r /backup/restic backup --limit-upload 1000 /home/user"},
  {"instruction": "Skip file-stat comparison in rdiff-backup", "output": "rdiff-backup --no-file-stat /etc /backup/etc"},
  {"instruction": "Duplicity with custom volume size", "output": "duplicity --volsize 250 /home/user file:///backup/duplicity"},
  {"instruction": "Skip nodump files in DAR", "output": "dar -c /backup/home-dar --nodump -R /home/user"},
  {"instruction": "Check dump progress", "output": "dump -0uf /backup/sda1.dump /dev/sda1 &; sleep 5; dump -W"},
  {"instruction": "Restore file system interactively", "output": "restore -i -f /backup/sda1.dump"},
  {"instruction": "Sparse file handling in dd", "output": "dd if=/dev/sda of=/backup/sda.img bs=4M conv=sparse status=progress"},
  {"instruction": "Synchronous ddrescue mode", "output": "ddrescue --synchronous /dev/sda /backup/sda.img /backup/sda.log"},
  {"instruction": "Tar incremental with snapshot bookkeeping", "output": "tar --listed-incremental=/backup/snapshot.snar -czvf /backup/home-$(date +%Y%m%d).tar.gz /home/user"},
  {"instruction": "Cpio with progress dots", "output": "find /home/user -type f | cpio -o | pv | gzip > /backup/home.cpio.gz"},
  {"instruction": "Pass extended options to pax", "output": "pax -w -o 'mtime=@0' -f /backup/www.pax /var/www"},
  {"instruction": "Configure rclone with interactive setup", "output": "rclone config"},
  {"instruction": "Exclude patterns with s3cmd sync", "output": "s3cmd sync --exclude '.git/*' --exclude '*.log' /home/user/ s3://my-backup-bucket/"},
  {"instruction": "Dump PostgreSQL with clean drop statements", "output": "pg_dump --clean mydb > /backup/mydb.sql"},
  {"instruction": "Compact MySQL dump output", "output": "mysqldump --compact --no-create-info mydb > /backup/mydb-data.sql"},
  {"instruction": "Restore MongoDB with namespace include", "output": "mongorestore --nsInclude 'mydb.users' /backup/mongodb"},
  {"instruction": "Borg with custom remote SSH path", "output": "borg create --remote-path /usr/local/bin/borg user@host:/backup/borg::home-{now:%Y-%m-%d} /home/user"},
  {"instruction": "Generate Restic bash completion", "output": "restic generate --bash-completion /etc/bash_completion.d/restic"},
  {"instruction": "Restore specific inode from dump", "output": "restore -x -f /backup/sda1.dump -i 123456"},
  {"instruction": "List directories in dump archive", "output": "restore -t -f /backup/sda1.dump"},
  {"instruction": "Create incremental level 3 dump", "output": "dump -3uf /backup/sda1-level3.dump /dev/sda1"},
  {"instruction": "Borg list with JSON output", "output": "borg list /backup/borg --json"},
  {"instruction": "Restic backup to SFTP repository", "output": "restic -r sftp:user@host:/backup/restic backup /home/user"}
]
