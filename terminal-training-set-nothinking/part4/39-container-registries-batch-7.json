[
  {"instruction": "Build a container image with kaniko using a Dockerfile", "output": "docker run -v $(pwd):/workspace gcr.io/kaniko-project/executor --dockerfile=Dockerfile --context=/workspace --destination=myregistry.example.com/myapp:1.0"},
  {"instruction": "Build a container image with kaniko using a custom cache", "output": "docker run -v $(pwd):/workspace gcr.io/kaniko-project/executor --dockerfile=Dockerfile --cache=true --cache-repo=myregistry.example.com/cache --destination=myregistry.example.com/myapp:1.0"},
  {"instruction": "Build a container image with kaniko in insecure registry mode", "output": "docker run -v $(pwd):/workspace gcr.io/kaniko-project/executor --dockerfile=Dockerfile --insecure --destination=myregistry.example.com/myapp:1.0"},
  {"instruction": "Build with kaniko using a tar archive output", "output": "docker run -v $(pwd):/workspace gcr.io/kaniko-project/executor --dockerfile=Dockerfile --no-push --tar-path=/workspace/image.tar"},
  {"instruction": "Copy an image between registries with crane", "output": "crane copy myregistry.example.com/myapp:1.0 other-registry.example.com/myapp:1.0"},
  {"instruction": "Delete an image from a registry with crane", "output": "crane delete myregistry.example.com/myapp:old-tag"},
  {"instruction": "Get the digest of an image with crane", "output": "crane digest myregistry.example.com/myapp:1.0"},
  {"instruction": "List tags for a repository with crane", "output": "crane ls myregistry.example.com/myapp"},
  {"instruction": "Pull the manifest of an image with crane", "output": "crane manifest myregistry.example.com/myapp:1.0"},
  {"instruction": "Tag an image in a registry with crane", "output": "crane tag myregistry.example.com/myapp:1.0 new-tag"},
  {"instruction": "Validate an image against a registry with crane", "output": "crane validate myregistry.example.com/myapp:1.0"},
  {"instruction": "List all repositories in a registry with crane", "output": "crane catalog myregistry.example.com"},
  {"instruction": "Copy all tags with crane", "output": "crane copy myregistry.example.com/myapp other-registry.example.com/myapp --all-tags"},
  {"instruction": "Authenticate crane with a registry", "output": "crane auth login myregistry.example.com -u admin -p password"},
  {"instruction": "Show crane auth status", "output": "crane auth status"},
  {"instruction": "Configure Amazon ECR credential helper for Docker", "output": "cat >> ~/.docker/config.json << 'EOF'\n{\n  \"credHelpers\": {\n    \"123456789012.dkr.ecr.us-east-1.amazonaws.com\": \"ecr-login\"\n  }\n}\nEOF"},
  {"instruction": "Pull an image via the ECR credential helper", "output": "docker pull 123456789012.dkr.ecr.us-east-1.amazonaws.com/myapp:1.0"},
  {"instruction": "Install Amazon ECR Docker credential helper", "output": "sudo apt-get install amazon-ecr-credential-helper -y"},
  {"instruction": "List crane available commands", "output": "crane --help"},
  {"instruction": "Copy an image with crane using platform selection", "output": "crane copy --platform linux/amd64 myregistry.example.com/myapp:1.0 other-registry.example.com/myapp:1.0"},
  {"instruction": "Install crane on Debian 12", "output": "wget https://github.com/google/go-containerregistry/releases/latest/download/go-containerregistry_Linux_x86_64.tar.gz && tar -xzf go-containerregistry_Linux_x86_64.tar.gz -C /usr/local/bin/ crane"},
  {"instruction": "Push an image with kaniko to multiple destinations", "output": "docker run -v $(pwd):/workspace gcr.io/kaniko-project/executor --destination=myregistry.example.com/myapp:1.0 --destination=other-registry.example.com/myapp:1.0"},
  {"instruction": "Build with kaniko using a specific target stage", "output": "docker run -v $(pwd):/workspace gcr.io/kaniko-project/executor --target=builder --destination=myregistry.example.com/builder:latest"},
  {"instruction": "Build with kaniko using a registry mirror", "output": "docker run -v $(pwd):/workspace -e REGISTRY_MIRROR=https://mirror.example.com gcr.io/kaniko-project/executor --destination=myregistry.example.com/myapp:1.0"},
  {"instruction": "Get crane configuration", "output": "crane config myregistry.example.com/myapp:1.0"}
]
