[
  {"instruction": "Enable IP forwarding via /proc", "output": "echo 1 > /proc/sys/net/ipv4/ip_forward"},
  {"instruction": "Disable IPv6 via sysctl parameter", "output": "echo 0 > /proc/sys/net/ipv6/conf/all/disable_ipv6"},
  {"instruction": "Set swappiness to 10 via proc", "output": "echo 10 > /proc/sys/vm/swappiness"},
  {"instruction": "Enable kernel panic on OOM", "output": "echo 1 > /proc/sys/vm/panic_on_oom"},
  {"instruction": "Set max user watches for inotify", "output": "echo 524288 > /proc/sys/fs/inotify/max_user_watches"},
  {"instruction": "Create a sysctl config for vm settings", "output": "echo 'vm.swappiness=10' > /etc/sysctl.d/99-swap.conf"},
  {"instruction": "Create sysctl config for network hardening", "output": "echo -e 'net.ipv4.conf.all.rp_filter=1\\nnet.ipv4.tcp_syncookies=1' > /etc/sysctl.d/99-network.conf"},
  {"instruction": "Apply all sysctl parameters from /etc/sysctl.d/", "output": "sysctl --system"},
  {"instruction": "Apply a single sysctl parameter immediately", "output": "sysctl -w vm.swappiness=10"},
  {"instruction": "Query current value of a sysctl parameter", "output": "sysctl net.ipv4.ip_forward"},
  {"instruction": "Query all sysctl parameters matching 'vm'", "output": "sysctl -a | grep '^vm\\.'"},
  {"instruction": "List all sysctl parameter names", "output": "sysctl -aN | wc -l"},
  {"instruction": "Reload sysctl from specific file", "output": "sysctl -p /etc/sysctl.d/99-swap.conf"},
  {"instruction": "Set kernel hostname via /proc", "output": "echo 'myhost' > /proc/sys/kernel/hostname"},
  {"instruction": "Enable TCP BBR congestion control", "output": "echo 'net.core.default_qdisc=fq' > /etc/sysctl.d/99-bbr.conf && echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.d/99-bbr.conf"},
  {"instruction": "Set kernel panic timeout to 5 seconds", "output": "echo 5 > /proc/sys/kernel/panic"},
  {"instruction": "Set kernel printk level to suppress debug", "output": "echo '4 4 1 7' > /proc/sys/kernel/printk"},
  {"instruction": "Set max number of open files system-wide", "output": "echo 'fs.file-max=200000' > /etc/sysctl.d/99-limits.conf"},
  {"instruction": "Enable kernel core dump with pipe to systemd-coredump", "output": "echo 'kernel.core_pattern=|/usr/lib/systemd/systemd-coredump %P %u %g %s %t %c %h' > /etc/sysctl.d/99-coredump.conf"},
  {"instruction": "Set shared memory max (SHMMAX) to 16GiB", "output": "echo 'kernel.shmmax=17179869184' > /etc/sysctl.d/99-shm.conf"},
  {"instruction": "Set max number of user namespaces", "output": "echo 'user.max_user_namespaces=10000' > /etc/sysctl.d/99-userns.conf"},
  {"instruction": "Disable magic SysRq key", "output": "echo 0 > /proc/sys/kernel/sysrq"},
  {"instruction": "Set vm.dirty_ratio to 30%", "output": "echo 30 > /proc/sys/vm/dirty_ratio"},
  {"instruction": "Set vm.vfs_cache_pressure to 50", "output": "echo 50 > /proc/sys/vm/vfs_cache_pressure"},
  {"instruction": "Persist kernel.exec-shield via sysctl", "output": "echo 'kernel.exec-shield=1' > /etc/sysctl.d/99-exec-shield.conf"},
  {"instruction": "Load a custom sysctl file without reboot", "output": "sysctl -f /etc/sysctl.d/99-custom.conf"}
