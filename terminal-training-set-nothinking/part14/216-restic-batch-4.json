[
  {
    "instruction": "How to mount restic repository",
    "output": "restic --repo /backup/restic-repo mount /mnt/restic"
  },
  {
    "instruction": "How to unmount restic repository",
    "output": "umount /mnt/restic"
  },
  {
    "instruction": "How to find file in restic repo",
    "output": "restic --repo /backup/restic-repo find filename.txt"
  },
  {
    "instruction": "How to copy restic snapshots between repos",
    "output": "restic --repo /backup/restic-repo copy --from-repo /old-backup"
  },
  {
    "instruction": "How to show restic stats",
    "output": "restic --repo /backup/restic-repo stats"
  },
  {
    "instruction": "How to borg create with compression",
    "output": "borg create --compression zstd,10 /backup/borg-repo::data-2025-01-01 /data"
  },
  {
    "instruction": "How to borg extract to specific directory",
    "output": "borg extract /backup/borg-repo::data-2025-01-01 /tmp/restore"
  },
  {
    "instruction": "How to borg list with prefix filter",
    "output": "borg list /backup/borg-repo --prefix home-"
  },
  {
    "instruction": "How to borg diff between archives",
    "output": "borg diff /backup/borg-repo::data-2025-01-01::data-2025-01-02"
  },
  {
    "instruction": "How to borg rename archive",
    "output": "borg rename /backup/borg-repo::old-name new-name"
  },
  {
    "instruction": "How to borg key export",
    "output": "borg key export /backup/borg-repo /tmp/borg-key-backup"
  },
  {
    "instruction": "How to restic backup with exclude patterns",
    "output": "restic --repo /backup/restic-repo backup --exclude '*.log' --exclude /tmp /home/user"
  },
  {
    "instruction": "How to restic backup from stdin",
    "output": "restic --repo /backup/restic-repo backup --stdin --stdin-filename dump.sql < dump.sql"
  },
  {
    "instruction": "How to borg info for archive",
    "output": "borg info /backup/borg-repo::home-2025-01-01"
  },
  {
    "instruction": "How to restic unlock repository",
    "output": "restic --repo /backup/restic-repo unlock"
  },
  {
