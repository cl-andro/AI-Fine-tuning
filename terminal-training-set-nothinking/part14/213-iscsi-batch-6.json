[
  {
    "instruction": "How to login to an iSCSI target",
    "output": "iscsiadm -m node -T iqn.2025-01.example:storage1 -p 192.168.1.10 --login"
  },
  {
    "instruction": "How to logout from an iSCSI target",
    "output": "iscsiadm -m node -T iqn.2025-01.example:storage1 -p 192.168.1.10 --logout"
  },
  {
    "instruction": "How to view active iSCSI sessions",
    "output": "iscsiadm -m session -P 3"
  },
  {
    "instruction": "How to list all iSCSI targets",
    "output": "iscsiadm -m node -o show"
  },
  {
    "instruction": "How to delete an iSCSI target",
    "output": "targetcli /iscsi delete iqn.2025-01.example:storage1"
  },
  {
    "instruction": "How to create an iSCSI portal",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1/portals create 0.0.0.0 3260"
  },
  {
    "instruction": "How to set target ACL",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1 set attribute generate_node_acls=1"
  },
  {
    "instruction": "How to add initiator to ACL",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1/acls create iqn.2025-01.initiator:client1"
  },
  {
    "instruction": "How to view iSCSI nodes",
    "output": "iscsiadm -m node"
  },
  {
    "instruction": "How to set LUN read-only",
    "output": "targetcli /backstores/block/disk1 set attribute read_only=1"
  },
  {
    "instruction": "How to configure iSCSI iface",
    "output": "iscsiadm -m iface -I iscsi0 --op=new"
  },
  {
    "instruction": "How to set CHAP initiator secret",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1 set auth userid=username password=secret"
  },
  {
    "instruction": "How to view target CLI status",
    "output": "targetcli / ls"
  },
  {
    "instruction": "How to save iSCSI configuration",
    "output": "targetcli saveconfig"
  },
  {
    "instruction": "How to restore iSCSI configuration",
    "output": "targetcli restoreconfig /etc/target/saveconfig.json"
  },
  {
    "instruction": "How to set iSCSI target authentication",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1 set attribute authentication=1"
  },
  {
    "instruction": "How to create iSCSI backstore from file",
    "output": "targetcli /backstores/fileio create file1 /opt/iscsi-disk.img 10G"
  },
  {
    "instruction": "How to delete a LUN from target",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1/luns delete lun1"
  },
  {
    "instruction": "How to set write-back cache for LUN",
    "output": "targetcli /backstores/block/disk1 set attribute write_back=1"
  },
  {
    "instruction": "How to list backstores",
    "output": "targetcli /backstores ls"
  },
  {
    "instruction": "How to set target TPG enable",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1 enable"
  },
  {
    "instruction": "How to set iSCSI login timeout",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1 set attribute login_timeout=15"
  },
  {
    "instruction": "How to view iSCSI statistics",
    "output": "iscsiadm -m session -s"
  },
  {
    "instruction": "How to set iSCSI error recovery",
    "output": "iscsiadm -m node -o update -T iqn.2025-01.example:storage1 -n node.conn[0].iscsi.ErrorRecoveryLevel -v 2"
  },
  {
    "instruction": "How to configure multiple LUNs per target",
    "output": "targetcli /iscsi/iqn.2025-01.example:storage1/tpg1/luns create /backstores/block/disk2"
  }
]