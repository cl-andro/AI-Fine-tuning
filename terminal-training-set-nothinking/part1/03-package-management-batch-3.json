  {"instruction": "Install Miniconda for Python envs", "output": "wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh && bash Miniconda3-latest-Linux-x86_64.sh -b"},
  {"instruction": "Install the AWS CLI v2", "output": "curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o awscliv2.zip && unzip awscliv2.zip && ./aws/install"},
  {"instruction": "Install kubectl (Kubernetes CLI)", "output": "curl -LO https://dl.k8s.io/release/v1.29.0/bin/linux/amd64/kubectl && chmod +x kubectl && mv kubectl /usr/local/bin/"},
  {"instruction": "Install Helm (Kubernetes package manager)", "output": "curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash"},
  {"instruction": "Install Terraform", "output": "wget -O- https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp.gpg && echo \"deb [signed-by=/usr/share/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main\" | tee /etc/apt/sources.list.d/hashicorp.list && apt update && apt install -y terraform"},
  {"instruction": "Install PostgreSQL client", "output": "apt install -y postgresql-client"},
  {"instruction": "Install MySQL client", "output": "apt install -y default-mysql-client"},
  {"instruction": "Install Redis server", "output": "apt install -y redis-server"},
