[
  {"instruction": "Create a Podman container (Docker alternative)", "output": "podman run -d --name web --pod new:webpod nginx"},
  {"instruction": "List Podman containers", "output": "podman ps -a"},
  {"instruction": "Build a container image with Podman", "output": "podman build -t myapp ."},
  {"instruction": "Run a Podman container as rootless", "output": "podman run -it --userns=keep-id ubuntu bash"},
  {"instruction": "Create a Podman pod (group of containers)", "output": "podman pod create --name mypod --publish 8080:80"},
  {"instruction": "List Podman pods", "output": "podman pod ls"},
  {"instruction": "Run a command in Podman with a compose file", "output": "podman-compose up -d"},
  {"instruction": "Install Docker via the convenience script", "output": "curl -fsSL https://get.docker.com | bash"},
  {"instruction": "Install Docker via apt (official repo)", "output": "apt install -y docker.io"},
  {"instruction": "Start and enable Docker daemon", "output": "systemctl enable --now docker"},
  {"instruction": "Check Docker daemon status", "output": "systemctl status docker --no-pager"},
  {"instruction": "Add current user to docker group", "output": "usermod -aG docker $USER"},
  {"instruction": "Restart Docker daemon safely", "output": "systemctl daemon-reload && systemctl restart docker"},
  {"instruction": "Change Docker data root directory", "output": "echo '{\"data-root\": \"/mnt/docker\"}' > /etc/docker/daemon.json && systemctl restart docker"},
  {"instruction": "Limit log file size globally in Docker daemon", "output": "echo '{\"log-driver\":\"json-file\",\"log-opts\":{\"max-size\":\"10m\",\"max-file\":\"3\"}}' > /etc/docker/daemon.json && systemctl restart docker"},
  {"instruction": "Enable Docker buildkit", "output": "echo '{\"features\":{\"buildkit\":true}}' > /etc/docker/daemon.json && systemctl restart docker"},
  {"instruction": "Set Docker to use a proxy", "output": "mkdir -p /etc/systemd/system/docker.service.d && echo -e '[Service]\\nEnvironment=\"HTTP_PROXY=http://proxy:8080/\"\\nEnvironment=\"HTTPS_PROXY=http://proxy:8080/\"\\nEnvironment=\"NO_PROXY=localhost,127.0.0.1\"' > /etc/systemd/system/docker.service.d/proxy.conf && systemctl daemon-reload && systemctl restart docker"},
  {"instruction": "Check Docker events stream", "output": "docker events --since 5m"},
  {"instruction": "Monitor Docker events for a specific container", "output": "docker events --filter 'container=web'"},
  {"instruction": "Show Docker system information (JSON)", "output": "docker info --format '{{json .}}' | jq '.'"},
  {"instruction": "Show number of running containers", "output": "docker info --format '{{.ContainersRunning}}'"},
  {"instruction": "Show total number of images", "output": "docker info --format '{{.Images}}'"},
  {"instruction": "Show Docker storage driver in use", "output": "docker info --format '{{.Driver}}'"},
  {"instruction": "Check if Docker runs in rootless mode", "output": "docker info --format '{{.SecurityOptions}}'"},
  {"instruction": "Check Docker networking configuration (CNI plugins)", "output": "ls /usr/lib/cni/ 2>/dev/null || echo no CNI"}
]
