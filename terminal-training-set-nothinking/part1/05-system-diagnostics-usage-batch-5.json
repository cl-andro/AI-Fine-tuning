[
  {"instruction": "Run a packet capture on interface eth0", "output": "tcpdump -i eth0 -c 100"},
  {"instruction": "Capture HTTP traffic on port 80 to a file", "output": "tcpdump -i eth0 port 80 -w http.pcap"},
  {"instruction": "Read a pcap file and show HTTP hosts", "output": "tcpdump -r http.pcap -A | grep -E 'Host:' | sort -u"},
  {"instruction": "Show DHCP traffic only", "output": "tcpdump -i eth0 port 67 or port 68"},
  {"instruction": "Show DNS queries and responses", "output": "tcpdump -i eth0 port 53"},
  {"instruction": "Show TCP SYN packets (new connections)", "output": "tcpdump -i eth0 'tcp[13] & 2 != 0'"},
  {"instruction": "Show traffic from a specific IP", "output": "tcpdump -i eth0 host 192.168.1.100"},
  {"instruction": "Show traffic between two hosts", "output": "tcpdump -i eth0 host 192.168.1.1 and 192.168.1.2"},
  {"instruction": "Show all network interfaces with stats", "output": "ip -s link"},
  {"instruction": "Show the MAC address of all interfaces", "output": "ip link show | grep -E 'link/ether'"},
  {"instruction": "Show the default gateway", "output": "ip route show default"},
  {"instruction": "Show the routing table with numeric addresses", "output": "ip route show"},
  {"instruction": "Add a static route", "output": "ip route add 10.0.0.0/24 via 192.168.1.1 dev eth0"},
  {"instruction": "Delete a static route", "output": "ip route del 10.0.0.0/24"},
  {"instruction": "Show neighbor (ARP) cache", "output": "ip neigh show"},
  {"instruction": "Flush the ARP cache", "output": "ip neigh flush all"},
  {"instruction": "Add a static ARP entry", "output": "ip neigh add 192.168.1.100 lladdr aa:bb:cc:dd:ee:ff dev eth0 nud permanent"},
  {"instruction": "Show the network namespace list", "output": "ip netns list"},
  {"instruction": "Execute a command in a network namespace", "output": "ip netns exec myns ping 8.8.8.8"},
  {"instruction": "Create a new network namespace", "output": "ip netns add myns"},
  {"instruction": "Show bridge forwarding table", "output": "bridge fdb show"},
  {"instruction": "Show VLAN tagging on interfaces", "output": "ip -d link show | grep -E 'vlan|vlan_id'"},
  {"instruction": "Show bond interface status", "output": "cat /proc/net/bonding/bond0 2>/dev/null || echo no bond"},
  {"instruction": "Show wireless network info", "output": "iwconfig 2>/dev/null || iw dev"},
  {"instruction": "Scan for available Wi-Fi networks", "output": "iwlist wlan0 scan 2>/dev/null | grep -E 'ESSID|Channel|Quality'"}
]
