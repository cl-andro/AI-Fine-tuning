[
  {"instruction": "Download multiple files in parallel with curl", "output": "curl -O https://example.com/file1.zip -O https://example.com/file2.zip"},
  {"instruction": "Download with a user-agent string", "output": "curl -A \"Mozilla/5.0\" https://example.com"},
  {"instruction": "Follow redirects when downloading", "output": "curl -L -O https://example.com/redirected-file"},
  {"instruction": "Download only if the remote file is newer than local", "output": "curl -z local.zip -O https://example.com/file.zip"},
  {"instruction": "Set download speed limit with curl", "output": "curl --limit-rate 500K -O https://example.com/large-file.iso"},
  {"instruction": "Upload a file via FTP with curl", "output": "curl -T file.txt ftp://ftp.example.com/upload/ --user user:pass"},
  {"instruction": "Download using HTTP/2", "output": "curl --http2 -O https://example.com/file.zip"},
  {"instruction": "Test IPv6 connectivity", "output": "curl -6 https://ipv6.google.com"},
  {"instruction": "Fetch the page with verbose headers", "output": "curl -v https://example.com"},
  {"instruction": "Send a POST request with JSON data", "output": "curl -X POST -H \"Content-Type: application/json\" -d '{\"key\":\"value\"}' https://api.example.com/data"},
  {"instruction": "Send a PUT request with file data", "output": "curl -X PUT -T file.txt https://api.example.com/upload"},
  {"instruction": "Send a DELETE request", "output": "curl -X DELETE https://api.example.com/resource/42"},
  {"instruction": "Authenticate with Bearer token", "output": "curl -H \"Authorization: Bearer token123\" https://api.example.com/data"},
  {"instruction": "Authenticate with Basic auth", "output": "curl -u username:password https://api.example.com/data"},
  {"instruction": "Set a cookie jar for session persistence", "output": "curl -c cookies.txt -b cookies.txt https://example.com"},
  {"instruction": "Show the full request/response with headers and body", "output": "curl -v -X POST https://httpbin.org/post -d 'data=test'"},
  {"instruction": "Silently check if a URL is accessible (no output)", "output": "curl -s -o /dev/null -w \"%{http_code}\" https://example.com"},
  {"instruction": "Show the time breakdown of each step of a request", "output": "curl -w \"@\" -o /dev/null -s https://example.com"},
  {"instruction": "Download with wget and continue if interrupted", "output": "wget -c https://example.com/large-file.iso"},
  {"instruction": "Download a file with wget in the background", "output": "wget -b https://example.com/large-file.iso"},
  {"instruction": "Set wget download speed limit", "output": "wget --limit-rate=500K https://example.com/file.zip"},
  {"instruction": "Download from FTP with wget", "output": "wget --user=user --password=pass ftp://ftp.example.com/file.zip"},
  {"instruction": "Set wget retry attempts", "output": "wget --tries=5 https://example.com/file.zip"},
  {"instruction": "Download and save with a specific output name", "output": "wget -O output.zip https://example.com/file.zip"},
  {"instruction": "Download a file with aria2c to multiple connections", "output": "aria2c -s 4 -x 4 https://example.com/large-file.iso"}
]
