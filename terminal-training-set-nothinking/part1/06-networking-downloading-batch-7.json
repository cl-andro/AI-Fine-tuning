[
  {"instruction": "Install and fail2ban for SSH brute force protection", "output": "apt install -y fail2ban && systemctl enable --now fail2ban"},
  {"instruction": "Check fail2ban status for SSH jail", "output": "fail2ban-client status sshd"},
  {"instruction": "Unban an IP from fail2ban", "output": "fail2ban-client set sshd unbanip 192.168.1.100"},
  {"instruction": "Check iptables rules managed by fail2ban", "output": "iptables -L f2b-sshd -n"},
  {"instruction": "Set up a simple firewall with a single iptables rule", "output": "iptables -A INPUT -p tcp --dport 22 -s 192.168.1.0/24 -j ACCEPT"},
  {"instruction": "Block an IP address with iptables", "output": "iptables -A INPUT -s 10.0.0.5 -j DROP"},
  {"instruction": "Allow established connections through iptables", "output": "iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"},
  {"instruction": "Log dropped packets with iptables", "output": "iptables -A INPUT -j LOG --log-prefix \"DROPPED: \" --log-level 4"},
  {"instruction": "Port forward with iptables (DNAT)", "output": "iptables -t nat -A PREROUTING -p tcp --dport 80 -j DNAT --to-destination 10.0.0.10:8080"},
  {"instruction": "MASQUERADE (SNAT) outgoing traffic", "output": "iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE"},
  {"instruction": "Set a default policy of DROP for INPUT", "output": "iptables -P INPUT DROP"},
  {"instruction": "Allow loopback traffic in iptables", "output": "iptables -A INPUT -i lo -j ACCEPT"},
  {"instruction": "Rate limit SSH connections with iptables", "output": "iptables -A INPUT -p tcp --dport 22 -m state --state NEW -m recent --set && iptables -A INPUT -p tcp --dport 22 -m state --state NEW -m recent --update --seconds 60 --hitcount 4 -j DROP"},
  {"instruction": "Block a specific MAC address", "output": "iptables -A INPUT -m mac --mac-source 00:11:22:33:44:55 -j DROP"},
  {"instruction": "Check conntrack table size", "output": "cat /proc/sys/net/netfilter/nf_conntrack_max"},
  {"instruction": "Show the connection tracking table", "output": "conntrack -L | head -20"},
  {"instruction": "Flush the connection tracking table", "output": "conntrack -F"},
  {"instruction": "Disable IPv6 temporarily", "output": "sysctl -w net.ipv6.conf.all.disable_ipv6=1"},
  {"instruction": "Enable IPv6 back", "output": "sysctl -w net.ipv6.conf.all.disable_ipv6=0"},
  {"instruction": "Check if IPv6 is active on an interface", "output": "cat /proc/sys/net/ipv6/conf/eth0/disable_ipv6"},
  {"instruction": "Add an IPv6 address to an interface", "output": "ip addr add 2001:db8::100/64 dev eth0"},
  {"instruction": "Ping an IPv6 address", "output": "ping6 2001:4860:4860::8888"},
  {"instruction": "Trace IPv6 route", "output": "traceroute6 2001:4860:4860::8888"},
  {"instruction": "Show IPv6 neighbor discovery cache", "output": "ip -6 neigh show"},
  {"instruction": "Check IPv6 router advertisement", "output": "radvdump"}
]
