[
  {"instruction": "Show available entropy for random number generation", "output": "cat /proc/sys/kernel/random/entropy_avail"},
  {"instruction": "Show the hostname and domain name", "output": "hostnamectl"},
  {"instruction": "Set the system hostname", "output": "hostnamectl set-hostname my-server"},
  {"instruction": "Show system locale settings", "output": "locale"},
  {"instruction": "List all available timezones", "output": "timedatectl list-timezones"},
  {"instruction": "Show current date and time with timezone", "output": "timedatectl"},
  {"instruction": "Set the system timezone", "output": "timedatectl set-timezone America/New_York"},
  {"instruction": "Synchronize system time with NTP", "output": "timedatectl set-ntp true"},
  {"instruction": "Show the NTP synchronization status", "output": "timedatectl show-timesync"},
  {"instruction": "Check hardware clock (RTC) time", "output": "hwclock --show"},
  {"instruction": "Sync hardware clock to system time", "output": "hwclock --systohc"},
  {"instruction": "Show the system default target (runlevel)", "output": "systemctl get-default"},
  {"instruction": "List active kernel parameters", "output": "sysctl -a | head -30"},
  {"instruction": "Show kernel parameter value", "output": "sysctl net.ipv4.ip_forward"},
  {"instruction": "Enable IP forwarding temporarily", "output": "sysctl -w net.ipv4.ip_forward=1"},
  {"instruction": "List available kernel command-line parameters", "output": "cat /proc/cmdline"},
  {"instruction": "Show SELinux status", "output": "getenforce 2>/dev/null || echo SELinux not enabled"},
  {"instruction": "Show AppArmor status", "output": "aa-status 2>/dev/null || echo AppArmor not enabled"},
  {"instruction": "Check if a reboot is required", "output": "ls -1 /var/run/reboot-required* 2>/dev/null && cat /var/run/reboot-required.pkgs || echo no reboot needed"},
  {"instruction": "Show recent system crashes", "output": "ls /var/crash/ 2>/dev/null || echo no crashes"},
  {"instruction": "Show core dump configuration", "output": "cat /proc/sys/kernel/core_pattern"},
  {"instruction": "Check system default ulimits", "output": "ulimit -a"},
  {"instruction": "Check ulimits for a running process", "output": "cat /proc/1234/limits"},
  {"instruction": "Show the number of CPUs/cores online", "output": "nproc"},
  {"instruction": "Show all CPU flags (supports AES, SSE, etc.)", "output": "lscpu | grep Flags"}
]
