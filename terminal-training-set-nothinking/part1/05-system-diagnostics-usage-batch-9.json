[
  {"instruction": "Show all filesystems and their mount options", "output": "mount -v | column -t"},
  {"instruction": "Check if a filesystem is mounted read-only", "output": "mount | grep ro | head -5"},
  {"instruction": "Show filesystem creation time", "output": "tune2fs -l /dev/sda1 | grep 'Filesystem created'"},
  {"instruction": "Show the UUID of root filesystem", "output": "blkid /dev/sda1 | grep -o 'UUID=\"[^\"]*\"'"},
  {"instruction": "Check filesystem for bad blocks (read-only)", "output": "badblocks -sv /dev/sda1"},
  {"instruction": "Show the last time filesystem was checked", "output": "tune2fs -l /dev/sda1 | grep 'Last checked'"},
  {"instruction": "Show filesystem features", "output": "tune2fs -l /dev/sda1 | grep 'Filesystem features'"},
  {"instruction": "Show reserved block count for root", "output": "tune2fs -l /dev/sda1 | grep 'Reserved block'"},
  {"instruction": "Change reserved block percentage to 2%", "output": "tune2fs -m 2 /dev/sda1"},
  {"instruction": "Enable filesystem writeback mode", "output": "mount -o remount,data=writeback /dev/sda1"},
  {"instruction": "Show LVM volume groups", "output": "vgdisplay"},
  {"instruction": "Show LVM logical volumes", "output": "lvdisplay"},
  {"instruction": "Show LVM physical volumes", "output": "pvdisplay"},
  {"instruction": "Create a logical volume", "output": "lvcreate -L 10G -n mylv vg0"},
  {"instruction": "Extend a logical volume", "output": "lvextend -L +5G /dev/vg0/mylv && resize2fs /dev/vg0/mylv"},
  {"instruction": "Reduce a logical volume", "output": "resize2fs /dev/vg0/mylv 5G && lvreduce -L 5G /dev/vg0/mylv"},
  {"instruction": "Show RAID array status", "output": "cat /proc/mdstat"},
  {"instruction": "Show detailed RAID info", "output": "mdadm --detail /dev/md0"},
  {"instruction": "Check ZFS pool status", "output": "zpool status 2>/dev/null || echo ZFS not loaded"},
  {"instruction": "Check ZFS filesystem usage", "output": "zfs list 2>/dev/null || echo ZFS not loaded"},
  {"instruction": "Show Btrfs filesystem usage", "output": "btrfs filesystem usage / 2>/dev/null || echo not btrfs"},
  {"instruction": "Show Btrfs device info", "output": "btrfs device show / 2>/dev/null || echo not btrfs"},
  {"instruction": "Defragment a Btrfs filesystem", "output": "btrfs filesystem defragment -r / 2>/dev/null || echo not btrfs"},
  {"instruction": "Check F2FS status", "output": "cat /sys/fs/f2fs/*/ckpt 2>/dev/null || echo F2FS not in use"},
  {"instruction": "Show NFS mount stats", "output": "nfsstat -s"}
]
