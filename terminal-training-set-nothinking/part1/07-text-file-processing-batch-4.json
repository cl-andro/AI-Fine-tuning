  {"instruction": "Convert INI file to JSON", "output": "python3 -c \"import configparser, json; c = configparser.ConfigParser(); c.read('config.ini'); print(json.dumps({s: dict(c[s]) for s in c.sections()}))\""},
  {"instruction": "Convert CSV to JSON", "output": "python3 -c \"import csv, json; print(json.dumps(list(csv.DictReader(open('data.csv')))))\" > data.json"},
  {"instruction": "Convert JSON to YAML", "output": "python3 -c \"import yaml, json; print(yaml.dump(json.load(open('data.json'))))\""},
