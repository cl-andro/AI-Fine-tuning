[
  {"instruction": "Format a JSON file with jq for readability", "output": "jq '.' data.json > pretty.json"},
  {"instruction": "Extract a specific key from a JSON file", "output": "jq '.name' data.json"},
  {"instruction": "Extract nested JSON value", "output": "jq '.user.address.city' data.json"},
  {"instruction": "Extract multiple fields from JSON array", "output": "jq '.[] | {name, email}' users.json"},
  {"instruction": "Filter JSON array by condition", "output": "jq '.[] | select(.age > 30)' users.json"},
  {"instruction": "Count items in a JSON array", "output": "jq 'length' data.json"},
  {"instruction": "Get keys of a JSON object", "output": "jq 'keys' data.json"},
  {"instruction": "Transform JSON to CSV", "output": "jq -r '.[] | [.name, .email] | @csv' users.json > users.csv"},
  {"instruction": "Merge two JSON files", "output": "jq -s '.[0] * .[1]' file1.json file2.json > merged.json"},
  {"instruction": "Pretty-print XML with xmllint", "output": "xmllint --format file.xml --output formatted.xml"},
  {"instruction": "Validate XML against a schema", "output": "xmllint --schema schema.xsd file.xml --noout"},
  {"instruction": "Extract a specific element from XML", "output": "xmllint --xpath '//element' file.xml"},
  {"instruction": "Parse YAML with yq (Python-based)", "output": "pip install yq && yq '.key' file.yml"},
  {"instruction": "Convert YAML to JSON", "output": "python3 -c \"import yaml,json; print(json.dumps(yaml.safe_load(open('file.yml'))))\" > output.json"},
