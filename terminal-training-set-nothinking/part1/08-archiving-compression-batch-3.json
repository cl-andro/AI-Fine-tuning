[
  {"instruction": "Create a lz4-compressed tar (fastest)", "output": "tar cf - ./dir/ | lz4 - archive.tar.lz4"},
  {"instruction": "Extract a lz4 tarball", "output": "lz4 -d archive.tar.lz4 | tar xf -"},
  {"instruction": "Compress with lzip", "output": "tar --lzip -cf archive.tar.lz ./dir/"},
  {"instruction": "Extract lzip tarball", "output": "tar --lzip -xf archive.tar.lz"},
  {"instruction": "Compress with lzop", "output": "tar --lzop -cf archive.tar.lzo ./dir/"},
  {"instruction": "Extract lzop tarball", "output": "tar --lzop -xf archive.tar.lzo"},
  {"instruction": "Create a compressed cpio archive", "output": "find ./dir/ -type f | cpio -o | gzip > archive.cpio.gz"},
  {"instruction": "Extract a cpio archive", "output": "cpio -idv < archive.cpio"},
  {"instruction": "Create an uncompressed cpio (for initramfs)", "output": "find ./dir/ -type f | cpio -o -H newc > initramfs.cpio"},
  {"instruction": "Create a compressed archive with 7z", "output": "7z a -t7z -mx=9 archive.7z ./dir/"},
  {"instruction": "Extract a 7z archive with full paths", "output": "7z x archive.7z"},
  {"instruction": "List contents of a 7z archive", "output": "7z l archive.7z"},
  {"instruction": "Create a password-protected 7z archive", "output": "7z a -psecret -mhe=on secure.7z ./data/"},
  {"instruction": "Extract RAR archive", "output": "unrar x archive.rar"},
  {"instruction": "List contents of a RAR archive", "output": "unrar l archive.rar"},
  {"instruction": "Create a RAR archive", "output": "rar a archive.rar ./dir/"},
  {"instruction": "Extract a tar archive over SSH", "output": "ssh user@host 'tar xzf - -C /target' < archive.tar.gz"},
  {"instruction": "Remote backup with tar over SSH", "output": "tar czf - ./data/ | ssh user@host 'cat > backup-$(date +%Y%m%d).tar.gz'"},
  {"instruction": "Remote restore with tar over SSH", "output": "ssh user@host 'cat backup.tar.gz' | tar xzf - -C /restore/path"},
  {"instruction": "Send tar archive to a remote machine via Netcat", "output": "tar czf - ./dir/ | nc 192.168.1.100 9999"},
  {"instruction": "Receive tar archive via Netcat", "output": "nc -l -p 9999 | tar xzf -"},
  {"instruction": "Archive and send with progress display", "output": "tar czf - ./large-dir | pv | ssh user@host 'cat > backup.tar.gz'"},
  {"instruction": "Compress a block device (disk image)", "output": "dd if=/dev/sdb1 bs=4M | gzip > disk.img.gz"},
  {"instruction": "Restore a compressed disk image", "output": "gunzip -c disk.img.gz | dd of=/dev/sdb1 bs=4M"},
  {"instruction": "Verify a cd/dvd ISO after burning", "output": "dd if=/dev/cdrom bs=2048 count=1 | md5sum; isoinfo -d -i /dev/cdrom | grep 'Volume size'"}

]
