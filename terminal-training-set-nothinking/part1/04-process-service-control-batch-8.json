[
  {"instruction": "Trace kernel-level events with bpftrace", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_open { printf(\"%s %s\\n\", comm, str(args->filename)); }'"},
  {"instruction": "Show new processes in real-time", "output": "bpftrace -e 'tracepoint:syscalls:sys_enter_execve { printf(\"%s -> %s\\n\", comm, str(args->filename)); }'"},
  {"instruction": "Track file opens system-wide", "output": "opensnoop-bpfcc"},
  {"instruction": "Monitor TCP connections with bpftrace", "output": "bpftrace -e 'kprobe:tcp_connect { printf(\"%s -> %s:%d\\n\", comm, ntop2(args->sk->__sk_common.skc_daddr), args->sk->__sk_common.skc_dport); }' 2>/dev/null || tcpconnect-bpfcc"},
  {"instruction": "Show disk I/O latency distribution", "output": "biolatency-bpfcc"},
  {"instruction": "Monitor slow file operations (slower than 10ms)", "output": "biosnoop-bpfcc"},
  {"instruction": "Show CPU sampling flame graph data", "output": "perf record -F 99 -a -g -- sleep 30 && perf script | stackcollapse-perf.pl | flamegraph.pl > flame.svg"},
  {"instruction": "Trace memory allocations with ltrace", "output": "ltrace -e malloc+free ./myapp"},
  {"instruction": "Trace library calls of a process", "output": "ltrace -p 1234"},
  {"instruction": "Trace system calls and show timestamps", "output": "strace -t -p 1234"},
  {"instruction": "Profile CPU usage with gprof (needs -pg compiled)", "output": "gprof ./myapp gmon.out"},
  {"instruction": "Track process scheduling latency", "output": "cyclictest -m -n -p 99 -h 100 -q -l 100000"},
  {"instruction": "Dump process stack trace", "output": "cat /proc/1234/stack"},
  {"instruction": "Show kernel message buffer for hardware errors", "output": "dmesg | grep -iE 'error|fail|warn' | tail -20"},
  {"instruction": "Follow kernel messages in real time", "output": "dmesg -w"},
  {"instruction": "Show kernel ring buffer with human-readable timestamps", "output": "dmesg -T | tail -30"},
  {"instruction": "Clear kernel ring buffer", "output": "dmesg -c"},
  {"instruction": "Show kernel message for USB events", "output": "dmesg | grep -i usb | tail -10"},
  {"instruction": "Show kernel OOM killer messages", "output": "dmesg | grep -i oom"},
  {"instruction": "Check if kdump crash kernel is configured", "output": "cat /proc/cmdline | grep crashkernel"},
  {"instruction": "Show available kernel crash dumps", "output": "ls /var/crash/ 2>/dev/null || echo no crash dumps"},
  {"instruction": "Show kernel module parameters", "output": "systool -vm nvidia | head -20"},
  {"instruction": "List all loaded kernel modules", "output": "lsmod"},
  {"instruction": "Show module information for a kernel module", "output": "modinfo nvidia"},
  {"instruction": "Unload a kernel module", "output": "modprobe -r nvidia"}
