[
  {"instruction": "Install Synaptic package manager GUI", "output": "apt install -y synaptic"},
  {"instruction": "Install Gdebi for easy .deb installs", "output": "apt install -y gdebi"},
  {"instruction": "Install Nala (modern apt frontend)", "output": "apt install -y nala"},
  {"instruction": "Install Flatpak and Flathub support", "output": "apt install -y flatpak && flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo"},
  {"instruction": "Install an app via Flatpak", "output": "flatpak install -y flathub org.gimp.GIMP"},
  {"instruction": "List installed Flatpak apps", "output": "flatpak list"},
  {"instruction": "Update all Flatpak apps", "output": "flatpak update -y"},
  {"instruction": "Remove a Flatpak app", "output": "flatpak uninstall -y org.gimp.GIMP"},
  {"instruction": "Install AppImage support (fuse)", "output": "apt install -y fuse libfuse2"},
  {"instruction": "Run an AppImage directly", "output": "chmod +x app.AppImage && ./app.AppImage"},
  {"instruction": "List available Snap channels for a package", "output": "snap info lxd"},
  {"instruction": "Install a Snap with classic confinement", "output": "snap install --classic helm"},
  {"instruction": "List all installed Snap packages", "output": "snap list"},
  {"instruction": "Remove a Snap package", "output": "snap remove lxd"},
  {"instruction": "Disable a Snap package", "output": "snap disable lxd"},
  {"instruction": "Enable a Snap package", "output": "snap enable lxd"},
  {"instruction": "Show Snap change history", "output": "snap changes"},
  {"instruction": "Revert a Snap to the previous version", "output": "snap revert lxd"},
  {"instruction": "Download a package without installing (apt-get compatible)", "output": "apt-get download nginx"},
  {"instruction": "Check if dpkg database is locked (stale lockfile)", "output": "fuser /var/lib/dpkg/lock-frontend 2>/dev/null || echo no lock"},
  {"instruction": "Remove a stale dpkg lock", "output": "rm -f /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock"},
  {"instruction": "Configure partially installed packages", "output": "dpkg --configure -a"},
  {"instruction": "Force install despite dependency errors", "output": "dpkg -i --force-depends package.deb"},
  {"instruction": "Extract a .deb file without installing", "output": "dpkg-deb -x package.deb ./extracted/"},
  {"instruction": "Show control information of a .deb file", "output": "dpkg-deb -I package.deb"}
]
