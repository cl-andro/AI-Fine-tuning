[
  {"instruction": "Show all logind sessions", "output": "loginctl list-sessions"},
  {"instruction": "Show all seats on the system", "output": "loginctl list-seats"},
  {"instruction": "Show session details", "output": "loginctl show-session 1"},
  {"instruction": "Show all running user managers", "output": "ps aux | grep systemd --user"},
  {"instruction": "Show the X11 display number", "output": "echo $DISPLAY"},
  {"instruction": "Show the Wayland display", "output": "echo $WAYLAND_DISPLAY"},
  {"instruction": "Check if running under X11 or Wayland", "output": "echo $XDG_SESSION_TYPE"},
  {"instruction": "Show desktop environment version", "output": "echo $XDG_CURRENT_DESKTOP"},
  {"instruction": "List all systemd user units", "output": "systemctl --user list-units"},
  {"instruction": "Start a user service", "output": "systemctl --user start myapp.service"},
  {"instruction": "Check the status of PulseAudio", "output": "pulseaudio --check && echo running || echo not running"},
  {"instruction": "List audio output devices", "output": "pactl list sinks short"},
  {"instruction": "List audio input devices", "output": "pactl list sources short"},
  {"instruction": "Set the default audio sink", "output": "pactl set-default-sink alsa_output.pci-0000_00_1f.3.analog-stereo"},
  {"instruction": "Set system volume to 50%", "output": "pactl set-sink-volume @DEFAULT_SINK@ 50%"},
  {"instruction": "Mute the default audio sink", "output": "pactl set-sink-mute @DEFAULT_SINK@ 1"},
  {"instruction": "List all DBus services", "output": "busctl list | head -20"},
  {"instruction": "Monitor DBus messages", "output": "busctl monitor"},
  {"instruction": "List all system services available via DBus", "output": "gdbus call --system --dest org.freedesktop.DBus --object-path / --method org.freedesktop.DBus.ListNames"},
  {"instruction": "Check NetworkManager connectivity", "output": "nmcli general status"},
  {"instruction": "List all NetworkManager connections", "output": "nmcli connection show"},
  {"instruction": "Show active WiFi connection details", "output": "nmcli device wifi show"},
  {"instruction": "Connect to a WiFi network", "output": "nmcli device wifi connect MyWiFi password mypassword"},
  {"instruction": "Show systemd-resolved DNS status", "output": "resolvectl status"},
  {"instruction": "Flush DNS cache (systemd-resolved)", "output": "resolvectl flush-caches"}
]
