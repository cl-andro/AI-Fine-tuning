[
  {
    "instruction": "Build a kustomization in the current directory",
    "output": "kustomize build ."
  },
  {
    "instruction": "Build and pipe to kubectl apply",
    "output": "kustomize build overlays/production/ | kubectl apply -f -"
  },
  {
    "instruction": "Build with load restrictions disabled",
    "output": "kustomize build --load-restrictor LoadRestrictionsNone ."
  },
  {
    "instruction": "Build with Helm chart inflation enabled",
    "output": "kustomize build --enable-helm ."
  },
  {
    "instruction": "Build with no resource reordering",
    "output": "kustomize build --reorder none ."
  },
  {
    "instruction": "Build without managed-by label",
    "output": "kustomize build --omit-managed-by-label ."
  },
  {
    "instruction": "Build staging overlay to a file",
    "output": "kustomize build overlays/staging > staging-manifests.yaml"
  },
  {
    "instruction": "Build with alpha plugins enabled",
    "output": "kustomize build --enable-alpha-plugins ."
  },
  {
    "instruction": "Build with all flags combined",
    "output": "kustomize build --load-restrictor LoadRestrictionsNone --reorder none --enable-helm ."
  },
  {
    "instruction": "Add a resource to kustomization",
    "output": "kustomize edit add resource deployment.yaml"
  },
  {
    "instruction": "Add multiple resources at once",
    "output": "kustomize edit add resource service.yaml --resource ingress.yaml"
  },
  {
    "instruction": "Remove a resource from kustomization",
    "output": "kustomize edit remove resource deployment.yaml"
  },
  {
    "instruction": "Add a ConfigMap generator from a file",
    "output": "kustomize edit add configmap my-config --from-file=config.properties"
  },
  {
    "instruction": "Add a ConfigMap generator from literals",
    "output": "kustomize edit add configmap app-config --from-literal=key1=val1 --from-literal=key2=val2"
  },
  {
    "instruction": "Add a secret generator from files",
    "output": "kustomize edit add secret app-secret --from-file=credentials.json"
  },
  {
    "instruction": "Add a secret generator from env file",
    "output": "kustomize edit add secret db-secret --from-env-file=.env.secret"
  },
  {
    "instruction": "Add a secret with from-literal",
    "output": "kustomize edit add secret my-secret --from-literal=api_key=abc123"
  },
  {
    "instruction": "Add a dockerconfigjson secret",
    "output": "kustomize edit add secret docker-creds --from-file=.dockerconfigjson=config.json --type=kubernetes.io/dockerconfigjson"
  },
  {
    "instruction": "Set the name prefix for all resources",
    "output": "kustomize edit set nameprefix production-"
  },
  {
    "instruction": "Remove the name prefix",
    "output": "kustomize edit set nameprefix ''"
  },
  {
    "instruction": "Set the namespace for all resources",
    "output": "kustomize edit set namespace staging"
  },
  {
    "instruction": "Add a name suffix to all resources",
    "output": "kustomize edit set namesuffix -v2"
  }
]