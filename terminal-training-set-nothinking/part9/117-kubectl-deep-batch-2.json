[
  {
    "instruction": "List available API resources",
    "output": "kubectl api-resources"
  },
  {
    "instruction": "List all namespaces and their status",
    "output": "kubectl get namespaces"
  },
  {
    "instruction": "List all API versions available on the server",
    "output": "kubectl api-versions"
  },
  {
    "instruction": "List all storage classes",
    "output": "kubectl get storageclass"
  },
  {
    "instruction": "List all network policies in a namespace",
    "output": "kubectl get netpol --namespace=default"
  },
  {
    "instruction": "Describe a pod in detail",
    "output": "kubectl describe pod web-app-5d8f9c"
  },
  {
    "instruction": "Describe a node with resource conditions",
    "output": "kubectl describe node worker-2"
  },
  {
    "instruction": "Describe a persistent volume claim",
    "output": "kubectl describe pvc data-pvc"
  },
  {
    "instruction": "Describe a service including endpoints",
    "output": "kubectl describe svc web-app"
  },
  {
    "instruction": "Describe a deployment",
    "output": "kubectl describe deploy web-app"
  },
  {
    "instruction": "Tail logs from a specific container in a pod",
    "output": "kubectl logs -f pod/api-server -c istio-proxy"
  },
  {
    "instruction": "Get last 50 lines of pod logs",
    "output": "kubectl logs --tail=50 web-app-5d8f9c"
  },
  {
    "instruction": "Get logs from previous crashed instance",
    "output": "kubectl logs web-app-5d8f9c --previous"
  },
  {
    "instruction": "Stream logs from pods matching a label",
    "output": "kubectl logs -l app=web-app --all-containers --tail=10 -f"
  },
  {
    "instruction": "Get logs since a specific time",
    "output": "kubectl logs web-app-5d8f9c --since=2024-01-01T00:00:00Z"
  },
  {
    "instruction": "Get logs for the last hour",
    "output": "kubectl logs web-app-5d8f9c --since=1h"
  },
  {
    "instruction": "Get logs from all containers in a pod",
    "output": "kubectl logs pod/api-server --all-containers"
  },
  {
    "instruction": "Run a shell command inside a pod",
    "output": "kubectl exec web-app-5d8f9c -- cat /etc/hostname"
  },
  {
    "instruction": "Open an interactive shell in a pod",
    "output": "kubectl exec -it web-app-5d8f9c -- /bin/bash"
  },
  {
    "instruction": "Exec into a specific container in a multi-container pod",
    "output": "kubectl exec web-app-5d8f9c -c sidecar -- ls /app"
  },
  {
    "instruction": "List pod names and IPs with jsonpath",
    "output": "kubectl get pods -o jsonpath='{range .items[*]}{.metadata.name}{\" \"}{.status.podIP}{\"\\n\"}{end}'"
  },
  {
    "instruction": "Get all images used in a deployment with jsonpath",
    "output": "kubectl get deploy web-app -o jsonpath='{.spec.template.spec.containers[*].image}'"
  }
]