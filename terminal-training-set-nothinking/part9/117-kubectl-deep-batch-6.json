[
  {
    "instruction": "Get the current context name",
    "output": "kubectl config current-context"
  },
  {
    "instruction": "Set the namespace for the current context",
    "output": "kubectl config set-context --current --namespace=production"
  },
  {
    "instruction": "List all available contexts",
    "output": "kubectl config get-contexts"
  },
  {
    "instruction": "Delete an old context from kubeconfig",
    "output": "kubectl config delete-context old-context"
  },
  {
    "instruction": "View kubeconfig as minified YAML",
    "output": "kubectl config view --minify --raw"
  },
  {
    "instruction": "Get the server version info",
    "output": "kubectl version --short"
  },
  {
    "instruction": "Wait for a pod to be ready with timeout",
    "output": "kubectl wait --for=condition=ready pod/web-app-5d8f9c --timeout=60s"
  },
  {
    "instruction": "Wait for deployment to be available",
    "output": "kubectl wait --for=condition=available deployment/web-app --timeout=5m"
  },
  {
    "instruction": "Watch events across all namespaces",
    "output": "kubectl get events --all-namespaces --watch"
  },
  {
    "instruction": "Get warning events from all namespaces",
    "output": "kubectl get events --all-namespaces --field-selector type=Warning"
  },
  {
    "instruction": "Debug a node with an ephemeral debug pod",
    "output": "kubectl debug node/worker-1 -it --image=ubuntu"
  },
  {
    "instruction": "Attach ephemeral container to running pod for debugging",
    "output": "kubectl debug web-app-5d8f9c -it --image=busybox --target=nginx"
  },
  {
    "instruction": "Get all pending pods across the cluster",
    "output": "kubectl get pods --field-selector=status.phase=Pending"
  },
  {
    "instruction": "Get pods with a specific priority class",
    "output": "kubectl get pods --field-selector=spec.priorityClassName=high-priority"
  },
  {
    "instruction": "List resource quotas across all namespaces",
    "output": "kubectl get quota --all-namespaces"
  },
  {
    "instruction": "List HPAs across all namespaces",
    "output": "kubectl get hpa --all-namespaces"
  },
  {
    "instruction": "Configure horizontal autoscaling for a deployment",
    "output": "kubectl autoscale deployment/web-app --min=2 --max=10 --cpu-percent=70"
  },
  {
    "instruction": "Get endpoints of a specific service",
    "output": "kubectl get endpoints web-app"
  },
  {
    "instruction": "List all service accounts in a namespace",
    "output": "kubectl get serviceaccounts --namespace=default"
  },
  {
    "instruction": "List all cluster roles",
    "output": "kubectl get clusterroles"
  },
  {
    "instruction": "Patch a service account with an image pull secret",
    "output": "kubectl patch serviceaccount default -p '{\"imagePullSecrets\": [{\"name\": \"regcred\"}]}'"
  },
  {
    "instruction": "Approve a certificate signing request",
    "output": "kubectl certificate approve my-csr"
  }
]