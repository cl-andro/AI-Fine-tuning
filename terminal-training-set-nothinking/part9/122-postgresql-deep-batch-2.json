[
  {
    "instruction": "Dump only globals (roles and tablespaces)",
    "output": "pg_dumpall --globals-only > globals.sql"
  },
  {
    "instruction": "Restore a custom format dump",
    "output": "pg_restore -d mydb mydb.dump"
  },
  {
    "instruction": "Restore with parallel jobs for speed",
    "output": "pg_restore -j 4 -d mydb mydb.dump"
  },
  {
    "instruction": "Restore schema only from a dump",
    "output": "pg_restore --schema-only -d mydb mydb.dump"
  },
  {
    "instruction": "Restore to a different database name",
    "output": "pg_restore -d newdb mydb.dump"
  },
  {
    "instruction": "Create a database owned by a specific user",
    "output": "createdb -O myuser mydb"
  },
  {
    "instruction": "Create database with specific encoding",
    "output": "createdb -E UTF8 -l en_US.UTF-8 mydb"
  },
  {
    "instruction": "Drop a database forcefully",
    "output": "dropdb -f mydb"
  },
  {
    "instruction": "Check if PostgreSQL is ready for connections",
    "output": "pg_isready"
  },
  {
    "instruction": "Check PostgreSQL connection with host and port",
    "output": "pg_isready -h localhost -p 5432"
  },
  {
    "instruction": "Start PostgreSQL server",
    "output": "pg_ctl start -D /var/lib/postgresql/15/main"
  },
  {
    "instruction": "Stop PostgreSQL server",
    "output": "pg_ctl stop -D /var/lib/postgresql/15/main"
  },
  {
    "instruction": "Reload PostgreSQL configuration",
    "output": "pg_ctl reload -D /var/lib/postgresql/15/main"
  },
  {
    "instruction": "Show PostgreSQL server status",
    "output": "pg_ctl status -D /var/lib/postgresql/15/main"
  },
  {
    "instruction": "Run pgbench with 10 clients and 1000 transactions",
    "output": "pgbench -c 10 -t 1000 mydb"
  },
  {
    "instruction": "Initialize pgbench with scale factor 50",
    "output": "pgbench -i -s 50 mydb"
  },
  {
    "instruction": "Run pgbench for 60 seconds",
    "output": "pgbench -c 10 -T 60 mydb"
  },
  {
    "instruction": "Run pgbench with custom script",
    "output": "pgbench -f /path/to/script.sql -c 10 -T 30 mydb"
  },
  {
    "instruction": "Execute a SQL script file",
    "output": "psql -f /path/to/script.sql"
  },
  {
    "instruction": "Export query result to CSV",
    "output": "psql -c \"COPY (SELECT * FROM users) TO STDOUT WITH CSV HEADER\" > users.csv"
  },
  {
    "instruction": "Import CSV file into a table",
    "output": "psql -c \"\\copy mytable FROM '/path/to/data.csv' WITH CSV HEADER\""
  },
  {
    "instruction": "Show replication statistics",
    "output": "psql -c \"SELECT * FROM pg_stat_replication\""
  }
]