[
  {
    "instruction": "Drop a collection entirely",
    "output": "mongosh --eval \"db.old_logs.drop()\""
  },
  {
    "instruction": "Rename a collection",
    "output": "mongosh --eval \"db.adminCommand({renameCollection: 'mydb.orders', to: 'mydb.archived_orders'})\""
  },
  {
    "instruction": "Enable sharding for a database",
    "output": "mongosh --eval \"sh.enableSharding('mydb')\""
  },
  {
    "instruction": "Shard a collection by hashed key",
    "output": "mongosh --eval \"sh.shardCollection('mydb.orders', {userId: 'hashed'})\""
  },
  {
    "instruction": "Get replica set status",
    "output": "mongosh --eval \"rs.status()\""
  },
  {
    "instruction": "Initiate a new replica set",
    "output": "mongosh --eval \"rs.initiate({_id: 'myReplicaSet', members: [{_id: 0, host: 'localhost:27017'}, {_id: 1, host: 'localhost:27018'}, {_id: 2, host: 'localhost:27019'}]})\""
  },
  {
    "instruction": "Get replica set configuration",
    "output": "mongosh --eval \"rs.conf()\""
  },
  {
    "instruction": "Add a member to the replica set",
    "output": "mongosh --eval \"rs.add('mongodb3.example.com:27017')\""
  },
  {
    "instruction": "Remove a member from the replica set",
    "output": "mongosh --eval \"rs.remove('mongodb3.example.com:27017')\""
  },
  {
    "instruction": "Step down the primary gracefully",
    "output": "mongosh --eval \"rs.stepDown(120)\""
  },
  {
    "instruction": "Freeze a node (temporary prevent primary)",
    "output": "mongosh --eval \"rs.freeze(300)\""
  },
  {
    "instruction": "Create a user with specific roles",
    "output": "mongosh --eval \"db.createUser({user: 'appuser', pwd: 'password', roles: [{role: 'readWrite', db: 'mydb'}, {role: 'read', db: 'logs'}]})\""
  },
  {
    "instruction": "Update user roles",
    "output": "mongosh --eval \"db.updateUser('appuser', {roles: [{role: 'readWrite', db: 'mydb'}]})\""
  },
  {
    "instruction": "Drop an existing user",
    "output": "mongosh --eval \"db.dropUser('appuser')\""
  },
  {
    "instruction": "Backup with mongodump to a directory",
    "output": "mongodump --uri mongodb://localhost:27017/mydb --out /backup/mongodb/"
  },
  {
    "instruction": "Backup with archive and gzip",
    "output": "mongodump --uri mongodb://localhost:27017/mydb --archive --gzip > /backup/mydb.archive.gz"
  },
  {
    "instruction": "Backup specific collections only",
    "output": "mongodump --db mydb --collection orders --out /backup/mongodb/"
  },
  {
    "instruction": "Restore a mongodump directory",
    "output": "mongorestore --uri mongodb://localhost:27017 /backup/mongodb/"
  },
  {
    "instruction": "Restore from a compressed archive",
    "output": "mongorestore --uri mongodb://localhost:27017 --archive --gzip < /backup/mydb.archive.gz"
  },
  {
    "instruction": "Restore with drop to replace data",
    "output": "mongorestore --drop --uri mongodb://localhost:27017/mydb /backup/mongodb/mydb/"
  },
  {
    "instruction": "Export collection to JSON file",
    "output": "mongoexport --uri mongodb://localhost:27017/mydb --collection orders --out orders.json"
  },
  {
    "instruction": "Export with query filter",
    "output": "mongoexport --uri mongodb://localhost:27017/mydb --collection orders --query '{\"status\": \"completed\"}' --out completed_orders.json"
  }
]