[
  {
    "instruction": "Dump all databases with routines and triggers",
    "output": "mysqldump --all-databases --single-transaction --routines --triggers > backup.sql"
  },
  {
    "instruction": "Dump a database with compression",
    "output": "mysqldump --single-transaction mydb | gzip > mydb.sql.gz"
  },
  {
    "instruction": "Dump only the schema without data",
    "output": "mysqldump --no-data mydb > schema.sql"
  },
  {
    "instruction": "Dump only specific tables",
    "output": "mysqldump mydb users orders > users_orders.sql"
  },
  {
    "instruction": "Dump with WHERE condition",
    "output": "mysqldump --where=\"created_at > '2024-01-01'\" mydb orders > recent_orders.sql"
  },
  {
    "instruction": "Dump with master data for replication",
    "output": "mysqldump --all-databases --master-data=2 > replication_dump.sql"
  },
  {
    "instruction": "Dump ignoring a table",
    "output": "mysqldump --ignore-table=mydb.logs mydb > no_logs.sql"
  },
  {
    "instruction": "Restore a MySQL dump",
    "output": "mysql -u root -p < backup.sql"
  },
  {
    "instruction": "Restore a compressed dump",
    "output": "gunzip < mydb.sql.gz | mysql -u root -p mydb"
  },
  {
    "instruction": "Execute a single SQL query",
    "output": "mysql -u root -p -e \"SELECT * FROM users WHERE status='active'\""
  },
  {
    "instruction": "Execute a SQL script file",
    "output": "mysql -u root -p mydb < /path/to/script.sql"
  },
  {
    "instruction": "Execute in batch mode with tab separators",
    "output": "mysql -u root -p -B -e \"SELECT * FROM users\" mydb > output.txt"
  },
  {
    "instruction": "List all databases",
    "output": "mysql -u root -p -e \"SHOW DATABASES\""
  },
  {
    "instruction": "List tables in a database",
    "output": "mysql -u root -p -e \"SHOW TABLES\" mydb"
  },
  {
    "instruction": "Show table status with detailed info",
    "output": "mysql -u root -p -e \"SHOW TABLE STATUS\" mydb"
  },
  {
    "instruction": "Show full processlist",
    "output": "mysql -u root -p -e \"SHOW FULL PROCESSLIST\""
  },
  {
    "instruction": "Show MySQL variables like buffer",
    "output": "mysql -u root -p -e \"SHOW VARIABLES LIKE '%buffer%'\""
  },
  {
    "instruction": "Show InnoDB engine status",
    "output": "mysql -u root -p -e \"SHOW ENGINE INNODB STATUS\""
  },
  {
    "instruction": "Show mutex status",
    "output": "mysql -u root -p -e \"SHOW MUTEX STATUS\""
  },
  {
    "instruction": "Check mysqladmin status",
    "output": "mysqladmin -u root -p status"
  },
  {
    "instruction": "Get extended mysqladmin status",
    "output": "mysqladmin -u root -p extended-status"
  },
  {
    "instruction": "View processlist via mysqladmin",
    "output": "mysqladmin -u root -p processlist"
  }
]