    "instruction": "Run nerdctl with overlayfs snapshotter",
    "output": "nerdctl run --snapshotter=overlayfs -d --name test nginx:latest"
  },
  {
    "instruction": "Run nerdctl with cgroupfs cgroup manager",
    "output": "nerdctl run --cgroup-manager=cgroupfs -d --name test nginx:latest"
  },
  {
    "instruction": "Copy file into a container",
    "output": "nerdctl cp ./config.json nginx:/etc/nginx/config.json"
  },
  {
    "instruction": "Copy file from a container",
    "output": "nerdctl cp nginx:/etc/nginx/nginx.conf ./nginx.conf"
  },
  {
    "instruction": "Create a container without starting it",
    "output": "nerdctl create --name prepped nginx:latest"
  },
  {
    "instruction": "Wait for a container to exit",
    "output": "nerdctl wait nginx"
  },
  {
    "instruction": "Show the port mapping of a container",
    "output": "nerdctl port nginx"
  },
  {
    "instruction": "Run a container with GPU support",
    "output": "nerdctl run -d --gpus all --name gpu-app nvidia/cuda:12.0-runtime"
  },
  {
    "instruction": "Run a container with macvlan network",
    "output": "nerdctl run -d --name macvlan-net --network macvlan nginx:latest"
  },
