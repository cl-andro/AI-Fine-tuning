[
  {
    "instruction": "Create a ConfigMap from env file",
    "output": "kubectl create configmap env-config --from-env-file=.env"
  },
  {
    "instruction": "Create a secret from literals",
    "output": "kubectl create secret generic db-secret --from-literal=password=s3cret"
  },
  {
    "instruction": "Create a secret from files",
    "output": "kubectl create secret generic tls-secret --from-file=tls.crt --from-file=tls.key"
  },
  {
    "instruction": "Create a job from a cronjob",
    "output": "kubectl create job --from=cronjob/backup backup-manual"
  },
  {
    "instruction": "Create a cronjob for periodic backup",
    "output": "kubectl create cronjob backup --image=busybox --schedule='0 */6 * * *' -- /bin/sh -c 'pg_dumpall > /backup/db.sql'"
  },
  {
    "instruction": "Create a PVC with specific storage class",
    "output": "kubectl create pvc data-pvc --storage-class=ssd --access-modes=ReadWriteOnce --size=10Gi"
  },
  {
    "instruction": "Create an ingress resource",
    "output": "kubectl create ingress web-ingress --rule='example.com/*=web-service:80'"
  },
  {
    "instruction": "Create a role with specific permissions",
    "output": "kubectl create role pod-reader --verb=get,list,watch --resource=pods"
  },
  {
    "instruction": "Create a role binding for a user",
    "output": "kubectl create rolebinding bob-admin --clusterrole=admin --user=bob --namespace=default"
  },
  {
    "instruction": "Attach to a running container",
    "output": "kubectl attach web-app-5d8f9c -c nginx"
  },
  {
    "instruction": "Run a temporary debug pod interactively",
    "output": "kubectl run debug --image=busybox:latest -it --rm --restart=Never -- sh"
  },
  {
    "instruction": "Copy file from pod to local machine",
    "output": "kubectl cp default/web-app-5d8f9c:/app/logs/app.log ./app.log"
  },
  {
    "instruction": "Copy file from local machine to pod",
    "output": "kubectl cp ./config.json default/web-app-5d8f9c:/app/config.json"
  },
  {
    "instruction": "Set image on a deployment to a new version",
    "output": "kubectl set image deployment/web-app nginx=nginx:1.25"
  },
  {
    "instruction": "Edit a deployment in-place with default editor",
    "output": "kubectl edit deploy web-app"
  },
  {
    "instruction": "Patch a service to change its type to LoadBalancer",
    "output": "kubectl patch svc web-app -p '{\"spec\":{\"type\":\"LoadBalancer\"}}'"
  },
  {
    "instruction": "Set resource limits on an existing deployment",
    "output": "kubectl set resources deployment/web-app --limits=cpu=500m,memory=512Mi --requests=cpu=200m,memory=256Mi"
  },
  {
    "instruction": "Add an emptyDir volume to a deployment",
    "output": "kubectl set volume deployment/web-app --add --name=tmp --mount-path=/tmp --type=EmptyDir"
  },
  {
    "instruction": "Remove a volume from a deployment",
    "output": "kubectl set volume deployment/web-app --remove --name=tmp"
  },
  {
    "instruction": "Get cluster-info dump for debugging",
    "output": "kubectl cluster-info dump"
  },
  {
    "instruction": "Check control plane component status",
    "output": "kubectl get componentstatuses"
  },
  {
    "instruction": "Switch kubectl to a specific context",
    "output": "kubectl config use-context production-cluster"
  }
]