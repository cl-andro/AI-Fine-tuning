[
  {
    "instruction": "Open Grafana dashboard",
    "output": "istioctl dashboard grafana"
  },
  {
    "instruction": "Open Prometheus dashboard",
    "output": "istioctl dashboard prometheus"
  },
  {
    "instruction": "Open Jaeger dashboard",
    "output": "istioctl dashboard jaeger"
  },
  {
    "instruction": "Open Envoy dashboard for a pod",
    "output": "istioctl dashboard envoy details-v1-6dccf6b8b6-b4v9x.default"
  },
  {
    "instruction": "Enable Istio injection on namespace",
    "output": "kubectl label namespace default istio-injection=enabled"
  },
  {
    "instruction": "Remove Istio injection from namespace",
    "output": "kubectl label namespace default istio-injection-"
  },
  {
    "instruction": "Verify Istio installation",
    "output": "istioctl verify-install"
  },
  {
    "instruction": "List Istio CRDs",
    "output": "kubectl get crd | grep istio"
  },
  {
    "instruction": "Get Istio webhook configuration",
    "output": "kubectl get mutatingwebhookconfiguration istio-sidecar-injector"
  },
  {
    "instruction": "Check Istio control plane status",
    "output": "kubectl get pods -n istio-system"
  },
  {
    "instruction": "Get Istio ingress gateway details",
    "output": "kubectl get svc -n istio-system istio-ingressgateway"
  },
  {
    "instruction": "Check unregistered mesh instances",
    "output": "istioctl experimental list-unregistered"
  },
  {
    "instruction": "Convert Kubernetes ingress to Istio",
    "output": "istioctl experimental convert-ingress -f ingress.yaml"
  },
  {
    "instruction": "Get all Istio configs",
    "output": "kubectl get vs,dr,se,gateway --all-namespaces"
  },
  {
    "instruction": "Describe pod Istio configuration",
    "output": "istioctl experimental describe pod details-v1-6dccf6b8b6-b4v9x.default"
  },
  {
    "instruction": "Get Istio version",
    "output": "istioctl version"
  },
  {
    "instruction": "Get Istio remote version",
    "output": "istioctl version --remote=true"
  },
  {
    "instruction": "Set proxy log level to debug",
    "output": "istioctl proxy-config log details-v1-6dccf6b8b6-b4v9x.default --level debug"
  },
  {
    "instruction": "Reset proxy log level to warning",
    "output": "istioctl proxy-config log details-v1-6dccf6b8b6-b4v9x.default --level warning"
  },
  {
    "instruction": "Apply a VirtualService for traffic routing",
    "output": "kubectl apply -f virtual-service.yaml"
  },
  {
    "instruction": "Apply a DestinationRule with traffic policy",
    "output": "kubectl apply -f destination-rule.yaml"
  },
  {
    "instruction": "Apply a ServiceEntry for external service",
    "output": "kubectl apply -f service-entry.yaml"
  }
]