  {
    "instruction": "Aggregate with group, sort, and project",
    "output": "mongosh --quiet --eval \"db.orders.aggregate([{\\$group: {_id: '\\$status', total: {\\$sum: '\\$amount'}, count: {\\$sum: 1}}}, {\\$sort: {total: -1}}]).toArray()\""
  },
  {
    "instruction": "Aggregate with lookup (JOIN)",
    "output": "mongosh --quiet --eval \"db.orders.aggregate([{\\$lookup: {from: 'users', localField: 'userId', foreignField: '_id', as: 'user'}}, {\\$unwind: '\\$user'}, {\\$project: {'user.name': 1, amount: 1, status: 1}}]).toArray()\""
  },
  {
    "instruction": "Aggregate with match and group",
    "output": "mongosh --quiet --eval \"db.orders.aggregate([{\\$match: {status: 'completed'}}, {\\$group: {_id: null, totalRevenue: {\\$sum: '\\$amount'}, avgOrder: {\\$avg: '\\$amount'}, maxOrder: {\\$max: '\\$amount'}}}]).toArray()\""
  },
  {
    "instruction": "Aggregate with bucket (histogram)",
    "output": "mongosh --quiet --eval \"db.orders.aggregate([{\\$bucket: {groupBy: '\\$amount', boundaries: [0, 50, 100, 500, 1000], default: 'Other', output: {count: {\\$sum: 1}, total: {\\$sum: '\\$amount'}}}}]).toArray()\""
  },
  {
    "instruction": "Aggregate with addFields computation",
    "output": "mongosh --quiet --eval \"db.orders.aggregate([{\\$addFields: {totalWithTax: {\\$multiply: ['\\$amount', 1.08]}}}]).toArray()\""
  },
  {
    "instruction": "Aggregate with unwind array",
    "output": "mongosh --quiet --eval \"db.orders.aggregate([{\\$unwind: '\\$items'}, {\\$group: {_id: '\\$items.product', totalQty: {\\$sum: '\\$items.qty'}}}]).toArray()\""
  },
  {
    "instruction": "Show current database operations",
    "output": "mongosh --eval \"db.currentOp({true: 1})\""
