  },
  {
    "instruction": "Use bulkWrite for mixed batch operations",
    "output": "mongosh --eval \"db.orders.bulkWrite([{insertOne: {document: {item: 'test', qty: 1}}}, {updateMany: {filter: {status: 'pending'}, update: {\\$set: {priority: 'low'}}}}])\""
  },
  {
    "instruction": "Show oplog entries from local db",
