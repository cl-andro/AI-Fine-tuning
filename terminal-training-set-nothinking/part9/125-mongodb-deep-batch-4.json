  },
  {
    "instruction": "Monitor server stats with mongostat",
    "output": "mongostat --uri mongodb://localhost:27017 --rowcount=10"
  },
  {
    "instruction": "Monitor operation times with mongotop",
    "output": "mongotop --uri mongodb://localhost:27017 --rowcount=10"
  },
  {
    "instruction": "Explain query execution stats",
    "output": "mongosh --eval \"db.orders.find({userId: ObjectId('...')}).explain('executionStats')\""
