    "instruction": "Use mapReduce for data aggregation",
    "output": "mongosh --quiet --eval \"db.orders.mapReduce(function() { emit(this.userId, this.amount); }, function(key, values) { return Array.sum(values); }, {out: 'order_totals'})\""
  },
  {
    "instruction": "Show server status",
    "output": "mongosh --eval \"db.serverStatus()\""
  },
  {
    "instruction": "Get build information",
    "output": "mongosh --eval \"db.adminCommand('buildInfo')\""
  },
  {
    "instruction": "Validate collection for corruption",
    "output": "mongosh --eval \"db.orders.validate({full: true})\""
  },
  {
    "instruction": "Compact a collection to reclaim space",
    "output": "mongosh --eval \"db.runCommand({compact: 'orders'})\""
  },
