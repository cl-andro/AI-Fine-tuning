[
  {
    "instruction": "Export collection to CSV",
    "output": "mongoexport --uri mongodb://localhost:27017/mydb --collection users --type=csv --fields=name,email,status --out users.csv"
  },
  {
    "instruction": "Import JSON file into collection",
