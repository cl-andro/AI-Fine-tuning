  {
    "instruction": "Set database profiler level",
    "output": "mongosh --eval \"db.setProfilingLevel(1, {slowms: 100})\""
  },
  {
    "instruction": "Show profiler data for slow queries",
    "output": "mongosh --eval \"db.system.profile.find({millis: {\\$gt: 100}}).pretty()\""
  },
  {
    "instruction": "Use multi-document transactions",
    "output": "mongosh --eval \"const session = db.getMongo().startSession(); session.startTransaction(); const orders = session.getDatabase('mydb').orders; orders.insertOne({item: 'test', qty: 1}); session.commitTransaction(); session.endSession()\""
  },
  {
    "instruction": "Watch for changes with changeStream",
    "output": "mongosh --eval \"const changeStream = db.orders.watch(); changeStream.next()\""
  },
