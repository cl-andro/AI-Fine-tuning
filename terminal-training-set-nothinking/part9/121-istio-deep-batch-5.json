[
  {
    "instruction": "Wait for Istio control plane to be ready",
    "output": "kubectl wait --for=condition=available deployment/istiod -n istio-system --timeout=5m"
  },
  {
    "instruction": "Install Istio with mesh expansion for VMs",
    "output": "istioctl install --set values.meshExpansion.enabled=true"
  },
  {
    "instruction": "Enable Istio access logging",
    "output": "kubectl apply -f mesh-config-access-log.yaml"
  },
  {
    "instruction": "Check Istio ingress gateway logs",
    "output": "kubectl logs -n istio-system deployment/istio-ingressgateway"
  },
  {
    "instruction": "Create a ServiceEntry for an external database",
    "output": "kubectl apply -f external-db-service-entry.yaml"
  },
  {
    "instruction": "Delete the default mesh configuration",
    "output": "istioctl uninstall --purge -y"
  },
  {
    "instruction": "Get all Istio configurations for a namespace",
    "output": "kubectl get vs,dr,se,gateway,peerauthentication,requestauthentication,authorizationpolicy -n default"
  },
