[
  {
    "instruction": "Package a chart and sign it in one step",
    "output": "helm package --sign --key 'mykey' ./mychart/"
  },
  {
    "instruction": "Install a chart with specific kube version context",
    "output": "helm install myapp ./mychart --kube-version 1.28"
  },
  {
    "instruction": "Set custom chart repository URL for dependencies",
    "output": "helm dependency update ./mychart"
  },
  {
    "instruction": "Check a chart's template for syntax errors",
    "output": "helm template myrelease ./mychart --validate"
  },
  {
    "instruction": "Render a chart and pipe to kubectl for review",
    "output": "helm template myrelease ./mychart | kubectl diff -f -"
  },
  {
    "instruction": "Get the completion script for zsh",
    "output": "helm completion zsh > /usr/share/zsh/vendor-completions/_helm"
  },
  {
    "instruction": "Start a local chart repository server",
    "output": "helm serve --address localhost:8879 --repo-path ./charts"
  },
  {
    "instruction": "Install a chart from a local repo server",
    "output": "helm install myapp local/myapp"
  },
  {
    "instruction": "View the contents of a packaged chart",
    "output": "helm show chart ./mychart-1.0.0.tgz"
  },
  {
    "instruction": "Fetch a chart and keep it local without unpacking",
    "output": "helm pull bitnami/nginx --destination ./charts"
