[
  {
    "instruction": "Connect to MongoDB locally",
    "output": "mongosh mongodb://localhost:27017"
  },
  {
    "instruction": "Connect with authentication",
    "output": "mongosh mongodb://admin:password@localhost:27017/mydb?authSource=admin"
  },
  {
    "instruction": "Connect to a replica set",
    "output": "mongosh mongodb://host1:27017,host2:27017,host3:27017/mydb?replicaSet=myReplicaSet"
  },
  {
    "instruction": "Run a JavaScript eval on the CLI",
    "output": "mongosh --eval \"db.users.find().limit(5)\""
  },
  {
    "instruction": "Execute a JavaScript file",
    "output": "mongosh mydb /path/to/script.js"
  },
  {
    "instruction": "Run an aggregation pipeline",
    "output": "mongosh --quiet --eval \"db.users.aggregate([{\\$group: {_id: '\\$status', count: {\\$sum: 1}}}])\""
  },
  {
    "instruction": "Find with filter and projection",
    "output": "mongosh --eval \"db.users.find({status: 'active'}, {name: 1, email: 1, _id: 0}).pretty()\""
  },
  {
    "instruction": "Find with sort, skip, and limit",
    "output": "mongosh --eval \"db.orders.find().sort({createdAt: -1}).skip(10).limit(5)\""
  },
  {
    "instruction": "Count documents matching a filter",
    "output": "mongosh --eval \"db.orders.countDocuments({status: 'pending'})\""
  },
  {
    "instruction": "Get estimated document count",
    "output": "mongosh --eval \"db.orders.estimatedDocumentCount()\""
  },
  {
    "instruction": "Find distinct values for a field",
    "output": "mongosh --eval \"db.orders.distinct('status')\""
  },
  {
    "instruction": "Insert a single document",
    "output": "mongosh --eval \"db.users.insertOne({name: 'Alice', email: 'alice@example.com', status: 'active'})\""
  },
  {
    "instruction": "Insert multiple documents at once",
    "output": "mongosh --eval \"db.orders.insertMany([{item: 'widget', qty: 5}, {item: 'gadget', qty: 10}])\""
  },
  {
    "instruction": "Update a single document",
    "output": "mongosh --eval \"db.users.updateOne({email: 'alice@example.com'}, {\\$set: {status: 'inactive'}})\""
  },
  {
    "instruction": "Update multiple documents",
    "output": "mongosh --eval \"db.orders.updateMany({status: 'pending'}, {\\$set: {status: 'processing', updatedAt: new Date()}})\""
  },
  {
    "instruction": "Replace an entire document",
    "output": "mongosh --eval \"db.users.replaceOne({email: 'alice@example.com'}, {name: 'Alice Smith', email: 'alice@example.com', status: 'active'})\""
  },
  {
    "instruction": "Delete a single document",
    "output": "mongosh --eval \"db.users.deleteOne({email: 'bob@example.com'})\""
  },
  {
    "instruction": "Delete multiple documents",
    "output": "mongosh --eval \"db.orders.deleteMany({status: 'cancelled'})\""
  },
  {
    "instruction": "FindOneAndUpdate",
    "output": "mongosh --eval \"db.orders.findOneAndUpdate({status: 'pending'}, {\\$set: {status: 'processing'}}, {returnDocument: 'after'})\""
  },
  {
    "instruction": "FindOneAndDelete",
    "output": "mongosh --eval \"db.orders.findOneAndDelete({status: 'cancelled', qty: 0})\""
  },
  {
    "instruction": "Create a capped collection",
    "output": "mongosh --eval \"db.createCollection('logs', {capped: true, size: 10485760, max: 5000})\""
  },
  {
    "instruction": "Create a unique index",
    "output": "mongosh --eval \"db.users.createIndex({email: 1}, {unique: true})\""
  }
]