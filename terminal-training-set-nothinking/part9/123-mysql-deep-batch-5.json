  },
  {
    "instruction": "Import CSV file into a table",
    "output": "mysql -u root -p -e \"LOAD DATA INFILE '/tmp/data.csv' INTO TABLE mytable FIELDS TERMINATED BY ',' ENCLOSED BY '\"' LINES TERMINATED BY '\\n' IGNORE 1 ROWS\" mydb"
  },
  {
    "instruction": "Show database size by table",
    "output": "mysql -u root -p -e \"SELECT table_name AS 'Table', ROUND(((data_length + index_length) / 1024 / 1024), 2) AS 'Size MB' FROM information_schema.TABLES WHERE table_schema = 'mydb' ORDER BY (data_length + index_length) DESC\""
  },
