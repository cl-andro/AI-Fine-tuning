[
  {
    "instruction": "Kill a MySQL process",
    "output": "mysqladmin -u root -p kill 12345"
  },
  {
    "instruction": "Flush tables and close connections",
    "output": "mysqladmin -u root -p flush-tables"
  },
  {
    "instruction": "Reload privileges",
    "output": "mysqladmin -u root -p reload"
  },
  {
    "instruction": "Create user with privileges",
    "output": "mysql -u root -p -e \"CREATE USER 'appuser'@'%' IDENTIFIED BY 'password'; GRANT SELECT, INSERT, UPDATE, DELETE ON mydb.* TO 'appuser'@'%'; FLUSH PRIVILEGES;\""
  },
  {
    "instruction": "Show grants for a user",
    "output": "mysql -u root -p -e \"SHOW GRANTS FOR 'appuser'@'%'\""
  },
  {
    "instruction": "Show slave replication status",
    "output": "mysql -u root -p -e \"SHOW SLAVE STATUS\""
  },
  {
    "instruction": "Show replica status (MySQL 8.4+)",
    "output": "mysql -u root -p -e \"SHOW REPLICA STATUS\""
  },
  {
    "instruction": "Start MySQL replication",
    "output": "mysql -u root -p -e \"START SLAVE\""
  },
  {
    "instruction": "Stop MySQL replication",
    "output": "mysql -u root -p -e \"STOP SLAVE\""
  },
  {
    "instruction": "Reset replication completely",
    "output": "mysql -u root -p -e \"RESET SLAVE ALL\""
  },
  {
    "instruction": "Show master binary log position",
    "output": "mysql -u root -p -e \"SHOW MASTER STATUS\""
  },
  {
    "instruction": "Show binary log status",
    "output": "mysql -u root -p -e \"SHOW BINARY LOG STATUS\""
  },
  {
    "instruction": "List all binary logs",
    "output": "mysql -u root -p -e \"SHOW BINARY LOGS\""
  },
  {
    "instruction": "Decode binary log events to SQL",
    "output": "mysqlbinlog --base64-output=DECODE-ROWS -v mysql-bin.000123 > decoded.sql"
  },
  {
    "instruction": "Read binary log from specific positions",
    "output": "mysqlbinlog --start-position=100 --stop-position=500 mysql-bin.000123"
  },
  {
    "instruction": "Read binary log from a remote server",
    "output": "mysqlbinlog --read-from-remote-server --host=10.0.0.1 --user=repl --password mysql-bin.000123"
  },
  {
    "instruction": "Check tables for corruption",
    "output": "mysqlcheck -u root -p --check mydb orders"
  },
  {
    "instruction": "Repair a corrupted table",
    "output": "mysqlcheck -u root -p --repair mydb orders"
  },
  {
    "instruction": "Optimize all tables in a database",
    "output": "mysqlcheck -u root -p --optimize --databases mydb"
  },
  {
    "instruction": "Analyze all tables in a database",
    "output": "mysqlcheck -u root -p --analyze --databases mydb"
  },
  {
    "instruction": "PT: Add column with no downtime",
    "output": "pt-online-schema-change --alter \"ADD COLUMN last_login DATETIME\" D=mydb,t=users --execute"
  },
  {
    "instruction": "PT: Drop column with chunk size limit",
    "output": "pt-online-schema-change --alter \"DROP COLUMN temp_field\" D=mydb,t=orders --chunk-size=500 --execute"
  }
]