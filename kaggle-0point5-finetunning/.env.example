# Kaggle API credentials (for pushing kernels/datasets)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Hugging Face (optional - for pushing adapter after training)
HF_TOKEN=hf_replace_me
HF_MODEL_REPO=your_hf_username/qwen2.5-0.5b-sql-qlora

# Weights & Biases (optional - for experiment tracking)
WANDB_API_KEY=

# Kernel settings
KAGGLE_KERNEL_SLUG=0point5-qlora-finetune

# Training overrides (optional)
# MAX_STEPS=100
# TRAIN_DATASET_PATH=/kaggle/input/your-dataset
# MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# OUTPUT_DIR=outputs
