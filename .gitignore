# ==============================================================
# Root safety-net .gitignore (monorepo)
# Subprojects have their own .gitignore; this catches everything.
# ==============================================================

# --- Secrets (NEVER commit) ---
.env
*.env.local
kaggle.json
.kaggle/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# --- Training artifacts / large model weights ---
outputs/
wandb/
runs/
*.bin
*.safetensors
*.gguf
*.pt
*.ckpt
*.onnx

# --- Kaggle push staging ---
.build/

# --- Data that stays local / on Kaggle ---
data/processed/

# --- Generator / validator scripts (local only) ---
gen*.py
validate*.py

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
