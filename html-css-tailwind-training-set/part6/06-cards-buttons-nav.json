    "output": "<style>\n  .product-card {\n    width: 280px; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden;\n    display: flex; flex-direction: column; background: #fff; transition: box-shadow .2s;\n  }\n  .product-card:hover { box-shadow: 0 12px 30px rgba(15,23,42,.1); }\n  .product-card img { width: 100%; height: 180px; object-fit: cover; }\n  .product-card .body { padding: 1rem; display: flex; flex-direction: column; gap: .4rem; flex: 1; }\n  .product-card h3 { margin: 0; font-size: 1.05rem; }\n  .product-card .price { font-weight: 700; font-size: 1.15rem; }\n  .product-card button {\n    margin-top: auto; padding: .6rem; border: none; border-radius: 8px;\n    background: #2563eb; color: #fff; font-weight: 600; cursor: pointer;\n  }\n  .product-card button:hover { background: #1d4ed8; }\n</style>\n<article class=\"product-card\">\n  <img src=\"headphones.jpg\" alt=\"Wireless headphones\">\n  <div class=\"body\">\n    <h3>Wireless Headphones</h3>\n    <p style=\"margin:0;color:#64748b;font-size:.9rem;\">Noise-cancelling, 30h battery.</p>\n    <span class=\"price\">$199</span>\n    <button type=\"button\">Add to cart</button>\n  </div>\n</article>"
