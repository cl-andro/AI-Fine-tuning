    "output": "<style>\n  :root { --th-bg: #f1f5f9; --row-alt: #f8fafc; --border: #e2e8f0; --text: #0f172a; --bg: #fff; }\n  @media (prefers-color-scheme: dark) {\n    :root { --th-bg: #1e293b; --row-alt: #0f172a; --border: #334155; --text: #e2e8f0; --bg: #0b1120; }\n  }\n  body { background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }\n  table { border-collapse: collapse; width: 100%; max-width: 560px; }\n  th, td { padding: .65rem 1rem; border-bottom: 1px solid var(--border); text-align: left; }\n  th { background: var(--th-bg); }\n  tbody tr:nth-child(even) { background: var(--row-alt); }\n</style>\n<table>\n  <thead><tr><th>Name</th><th>Role</th></tr></thead>\n  <tbody><tr><td>Ada</td><td>Engineer</td></tr><tr><td>Grace</td><td>Admiral</td></tr><tr><td>Alan</td><td>Scientist</td></tr></tbody>\n</table>"
