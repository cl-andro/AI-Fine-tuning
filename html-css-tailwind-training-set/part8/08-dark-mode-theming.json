    "output": "<style>\n  :root {\n    --bg: #fff; --text: #0f172a; --card: #f1f5f9; --border: #e2e8f0;\n  }\n  .dark {\n    --bg: #0b1120; --text: #e2e8f0; --card: #1e293b; --border: #334155;\n  }\n  body { background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; transition: background .2s, color .2s; }\n  .card { background: var(--card); border: 1px solid var(--border); padding: 1.5rem; border-radius: 12px; max-width: 420px; margin: 2rem auto; }\n  .toggle-btn { display: block; margin: 0 auto; padding: .6rem 1.25rem; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--text); cursor: pointer; }\n</style>\n<body>\n  <button class=\"toggle-btn\" onclick=\"document.documentElement.classList.toggle('dark')\">Toggle dark mode</button>\n  <div class=\"card\"><h2>Class-based theming</h2><p>Click the button to switch themes.</p></div>\n</body>"
