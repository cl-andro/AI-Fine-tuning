    "instruction": "Create a search autocomplete component with an input, a keyboard shortcut hint, and a grouped results dropdown.",
    "output": "<style>\n  .search { position: relative; max-width: 480px; font-family: system-ui, sans-serif; }\n  .search .field { display: flex; align-items: center; gap: .6rem; border: 1px solid #cbd5e1; background: #fff; border-radius: 12px; padding: .6rem .85rem; box-shadow: 0 2px 8px rgba(15,23,42,.05); }\n  .search .field:focus-within { border-color: #2563eb; box-shadow: 0 0 0 4px #dbeafe; }\n  .search .field svg { flex-shrink: 0; color: #94a3b8; }\n  .search input { flex: 1; border: none; outline: none; font-size: .95rem; background: transparent; color: #0f172a; }\n  .search kbd { font-family: ui-monospace, monospace; font-size: .72rem; background: #f1f5f9; border: 1px solid #e2e8f0; border-bottom-width: 2px; border-radius: 6px; padding: .15rem .4rem; color: #64748b; }\n  .search .results {\n    position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: #fff;\n    border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 18px 40px rgba(15,23,42,.16); overflow: hidden; z-index: 30;\n  }\n  .search .grp { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: #94a3b8; padding: .55rem .9rem .25rem; background: #f8fafc; }\n  .search .res { display: flex; justify-content: space-between; align-items: center; padding: .6rem .9rem; text-decoration: none; color: #334155; font-size: .9rem; }\n  .search .res:hover, .search .res.active { background: #eff6ff; color: #1e40af; }\n  .search .res .hint { font-size: .74rem; color: #94a3b8; }\n  .search .foot { display: flex; justify-content: space-between; padding: .5rem .9rem; border-top: 1px solid #f1f5f9; font-size: .74rem; color: #94a3b8; }\n</style>\n<div class=\"search\">\n  <div class=\"field\">\n    <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M21 21l-4-4\"/></svg>\n    <input type=\"search\" placeholder=\"Search docs, people, files...\" aria-label=\"Search\" aria-controls=\"search-results\" aria-expanded=\"true\" role=\"combobox\">\n    <kbd>Ctrl K</kbd>\n  </div>\n  <div class=\"results\" id=\"search-results\" role=\"listbox\" aria-label=\"Search results\">\n    <div class=\"grp\">Pages</div>\n    <a class=\"res active\" href=\"#\" role=\"option\" aria-selected=\"true\">Getting started<span class=\"hint\">Guide</span></a>\n    <a class=\"res\" href=\"#\" role=\"option\">Component tokens<span class=\"hint\">Docs</span></a>\n    <div class=\"grp\">People</div>\n    <a class=\"res\" href=\"#\" role=\"option\">Maya Kim<span class=\"hint\">Design</span></a>\n    <div class=\"foot\"><span>&uarr;&darr; to navigate</span><span>Enter to open</span></div>\n  </div>\n</div>"
