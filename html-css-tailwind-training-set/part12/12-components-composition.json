    "instruction": "Create a notification dropdown panel that opens from a bell button, showing grouped items with unread states.",
    "output": "<style>\n  .notif { position: relative; display: inline-block; font-family: system-ui, sans-serif; }\n  .notif .bell { position: relative; width: 42px; height: 42px; border-radius: 10px; border: 1px solid #e2e8f0; background: #fff; cursor: pointer; font-size: 1.1rem; }\n  .notif .count { position: absolute; top: -6px; right: -6px; min-width: 19px; height: 19px; padding: 0 5px; background: #ef4444; color: #fff; font-size: .68rem; font-weight: 700; border-radius: 999px; display: grid; place-items: center; border: 2px solid #fff; }\n  .notif .panel {\n    position: absolute; right: 0; top: calc(100% + 10px); width: min(92vw, 330px);\n    background: #fff; border: 1px solid #e2e8f0; border-radius: 14px;\n    box-shadow: 0 20px 45px rgba(15,23,42,.18); overflow: hidden; z-index: 40;\n  }\n  .notif .panel header { display: flex; justify-content: space-between; align-items: center; padding: .85rem 1rem; border-bottom: 1px solid #e2e8f0; }\n  .notif .panel header strong { font-size: .95rem; }\n  .notif .panel header a { font-size: .78rem; color: #2563eb; text-decoration: none; }\n  .notif .group { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: #94a3b8; padding: .6rem 1rem .3rem; background: #f8fafc; }\n  .notif .item { display: flex; gap: .7rem; padding: .75rem 1rem; text-decoration: none; color: inherit; border-bottom: 1px solid #f1f5f9; }\n  .notif .item:hover { background: #f8fafc; }\n  .notif .item.unread { background: #eff6ff; }\n  .notif .dot { width: 8px; height: 8px; border-radius: 50%; background: #2563eb; margin-top: .4rem; flex-shrink: 0; }\n  .notif .item .txt { font-size: .85rem; color: #334155; line-height: 1.45; }\n  .notif .item .txt time { display: block; font-size: .74rem; color: #94a3b8; margin-top: .15rem; }\n</style>\n<div class=\"notif\">\n  <button class=\"bell\" type=\"button\" aria-label=\"Notifications, 2 unread\" aria-expanded=\"true\">&#128276;<span class=\"count\">2</span></button>\n  <div class=\"panel