    "output": "<style>\n  .pricing { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: center; align-items: stretch; }\n  .plan {\n    flex: 1 1 250px; max-width: 300px; background: #fff; border: 1px solid #e2e8f0;\n    border-radius: 16px; padding: 1.75rem 1.5rem; display: flex; flex-direction: column; position: relative;\n  }\n  .plan.popular { border-color: #6366f1; box-shadow: 0 18px 40px rgba(99,102,241,.18); }\n  .plan .tag { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #6366f1; color: #fff; font-size: .7rem; font-weight: 700; padding: .25rem .7rem; border-radius: 999px; letter-spacing: .04em; white-space: nowrap; }\n  .plan h3 { margin: 0 0 .35rem; font-size: 1.05rem; }\n  .plan .price { font-size: 2.2rem; font-weight: 800; color: #0f172a; }\n  .plan .price span { font-size: .9rem; font-weight: 500; color: #64748b; }\n  .plan ul { list-style: none; padding: 0; margin: 1.25rem 0 1.5rem; flex: 1; }\n  .plan li { padding: .4rem 0; color: #475569; font-size: .92rem; }\n  .plan li::before { content: '\\2713  '; color: #16a34a; font-weight: 700; }\n  .plan li.off { color: #cbd5e1; }\n  .plan li.off::before { content: '\\2717  '; color: #cbd5e1; }\n  .plan .buy { padding: .7rem; border-radius: 10px; border: 1px solid #cbd5e1; background: #fff; font-weight: 700; cursor: pointer; }\n  .plan.popular .buy { background: #4f46e5; border-color: #4f46e5; color: #fff; }\n  .billing-toggle { display: flex; justify-content: center; gap: .5rem; margin-bottom: 1.75rem; }\n  .billing-toggle button { padding: .45rem 1rem; border-radius: 999px; border: 1px solid #e2e8f0; background: #fff; cursor: pointer; font-size: .85rem; color: #475569; }\n  .billing-toggle button.on { background: #0f172a; border-color: #0f172a; color: #fff; }\n</style>\n<div>\n  <div class=\"billing-toggle\">\n    <button class=\"on\" type=\"button\">Monthly</button>\n    <button type=\"button\">Annual (save 20%)</button>\n  </div>\n  <div class=\"pricing\">\n    <div class=\"plan\">\n      <h3>Starter</h3>\n      <div class=\"price\">$9<span>/mo</span></div>\n      <ul><li>1 project</li><li>Community support</li><li class=\"off\">Custom domains</li><li class=\"off\">Analytics</li></ul>\n      <button class=\"buy\" type=\"button\">Choose Starter</button>\n    </div>\n    <div class=\"plan popular\">\n      <span class=\"tag\">MOST POPULAR</span>\n      <h3>Pro</h3>\n      <div class=\"price\">$29<span>/mo</span></div>\n      <ul><li>20 projects</li><li>Priority email support</li><li>Custom domains</li><li>Advanced analytics</li></ul>\n      <button class=\"buy\" type=\"button\">Choose Pro</button>\n    </div>\n    <div class=\"plan\">\n      <h3>Team</h3>\n      <div class=\"price\">$79<span>/mo</span></div>\n      <ul><li>Unlimited projects</li><li>Dedicated success manager</li><li>Custom domains</li><li>SSO and audit logs</li></ul>\n      <button class=\"buy\" type=\"button\">Choose Team</button>\n    </div>\n  </div>\n</div>"
