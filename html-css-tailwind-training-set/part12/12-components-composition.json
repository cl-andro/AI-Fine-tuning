    "output": "<style>\n  .account { position: relative; display: inline-block; font-family: system-ui, sans-serif; }\n  .account .toggle { display: none; }\n  .account .trigger { display: flex; align-items: center; gap: .6rem; padding: .4rem .65rem .4rem .4rem; border: 1px solid #e2e8f0; border-radius: 999px; background: #fff; cursor: pointer; }\n  .account .trigger img, .account .trigger .ph { width: 30px; height: 30px; border-radius: 50%; background: #c7d2fe; display: grid; place-items: center; font-size: .78rem; font-weight: 700; color: #3730a3; }\n  .account .trigger .name { font-size: .86rem; font-weight: 600; color: #334155; }\n  .account .trigger .caret { font-size: .7rem; color: #94a3b8; }\n  .account .menu {\n    position: absolute; right: 0; top: calc(100% + 8px); min-width: 220px; background: #fff;\n    border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 16px 40px rgba(15,23,42,.16);\n    padding: .4rem; display: none; z-index: 40;\n  }\n  .account .toggle:checked ~ .menu { display: block; }\n  .account .menu a { display: flex; align-items: center; gap: .6rem; padding: .55rem .7rem; border-radius: 8px; text-decoration: none; color: #334155; font-size: .88rem; }\n  .account .menu a:hover { background: #f1f5f9; }\n  .account .menu .sep { height: 1px; background: #e2e8f0; margin: .35rem .3rem; }\n  .account .menu a.danger { color: #dc2626; }\n  .account .head { padding: .55rem .7rem .7rem; border-bottom: 1px solid #e2e8f0; margin-bottom: .35rem; }\n  .account .head strong { display: block; font-size: .9rem; color: #0f172a; }\n  .account .head span { font-size: .78rem; color: #94a3b8; }\n</style>\n<div class=\"account\">\n  <input class=\"toggle\" type=\"checkbox\" id=\"acct-toggle\">\n  <label class=\"trigger\" for=\"acct-toggle\">\n    <span class=\"ph\" aria-hidden=\"true\">MK</span>\n    <span class=\"name\">Maya Kim</span>\n    <span class=\"caret\" aria-hidden=\"true\">&#9662;</span>\n  </label>\n  <div class=\"menu\" role=\"menu\" aria-label=\"Account\">\n    <div class=\"head\"><strong>Maya Kim</strong><span>maya@example.com</span></div>\n    <a role=\"menuitem\" href=\"#\">Profile</a>\n    <a role=\"menuitem\" href=\"#\">Settings</a>\n    <a role=\"menuitem\" href=\"#\">Billing</a>\n    <div class=\"sep\"></div>\n    <a role=\"menuitem\" class=\"danger\" href=\"#\">Sign out</a>\n  </div>\n</div>"
