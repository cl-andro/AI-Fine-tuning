    "output": "<style>\n  .page-head { font-family: system-ui, sans-serif; border-bottom: 1px solid #e2e8f0; padding: 1.5rem clamp(1rem, 4vw, 2.25rem); background: #fff; }\n  .page-head .crumbs { font-size: .82rem; color: #64748b; margin-bottom: .6rem; }\n  .page-head .crumbs a { color: #2563eb; text-decoration: none; }\n  .page-head .crumbs a:hover { text-decoration: underline; }\n  .page-head .crumbs .sep { margin: 0 .45rem; color: #cbd5e1; }\n  .page-head .crumbs .cur { color: #0f172a; font-weight: 600; }\n  .page-head .row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; }\n  .page-head h1 { margin: 0; font-size: 1.5rem; color: #0f172a; }\n  .page-head .sub { margin: .3rem 0 0; color: #64748b; font-size: .92rem; }\n  .page-head .actions { display: flex; gap: .6rem; }\n  .page-head .btn { padding: .6rem 1.1rem; border-radius: 9px; font-size: .88rem; font-weight: 600; cursor: pointer; border: 1px solid #cbd5e1; background: #fff; color: #334155; }\n  .page-head .btn:hover { background: #f8fafc; }\n  .page-head .btn.primary { background: #2563eb; border-color: #2563eb; color: #fff; }\n  .page-head .btn.primary:hover { background: #1d4ed8; }\n</style>\n<header class=\"page-head\">\n  <nav class=\"crumbs\" aria-label=\"Breadcrumb\">\n    <a href=\"#\">Home</a><span class=\"sep\">&#8250;</span>\n    <a href=\"#\">Projects</a><span class=\"sep\">&#8250;</span>\n    <span class=\"cur\">Aurora</span>\n  </nav>\n  <div class=\"row\">\n    <div>\n      <h1>Aurora redesign</h1>\n      <p class=\"sub\">12 tasks &middot; Updated 2 hours ago &middot; 4 members</p>\n    </div>\n    <div class=\"actions\">\n      <button class=\"btn\" type=\"button\">Share</button>\n      <button class=\"btn\" type=\"button\">Export</button>\n      <button class=\"btn primary\" type=\"button\">New task</button>\n    </div>\n  </div>\n</header>"
