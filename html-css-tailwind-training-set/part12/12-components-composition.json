  {
    "instruction": "Compose a checkout stepper showing completed, current, and upcoming steps with connecting lines.",
    "output": "<style>\n  .stepper { display: flex; max-width: 620px; margin: 2rem auto; font-family: system-ui, sans-serif; }\n  .stepper .step { flex: 1; position: relative; text-align: center; }\n  .stepper .step::before {\n    content: ''; position: absolute; top: 17px; left: -50%; width: 100%; height: 3px; background: #e2e8f0; z-index: 0;\n  }\n  .stepper .step:first-child::before { display: none; }\n  .stepper .step.done::before, .stepper .step.current::before { background: #2563eb; }\n  .stepper .num {\n    position: relative; z-index: 1; width: 36px; height: 36px; margin: 0 auto; border-radius: 50%;\n    display: grid; place-items: center; font-weight: 700; font-size: .9rem;\n    background: #fff; border: 3px solid #cbd5e1; color: #94a3b8;\n  }\n  .stepper .step.done .num { background: #2563eb; border-color: #2563eb; color: #fff; }\n  .stepper .step.current .num { border-color: #2563eb; color: #2563eb; box-shadow: 0 0 0 5px #dbeafe; }\n  .stepper .lbl { display: block; margin-top: .6rem; font-size: .84rem; color: #64748b; }\n  .stepper .step.current .lbl { color: #0f172a; font-weight: 700; }\n  .stepper .step.done .lbl { color: #334155; }\n  .stepper .sub { display: block; font-size: .74rem; color: #94a3b8; margin-top: .15rem; }\n  .checkout-box { max-width: 620px; margin: 1.5rem auto 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1.5rem; text-align: center; }\n  .checkout-box h3 { margin: 0 0 .5rem; }\n  .checkout-box p { margin: 0 0 1.25rem; color: #64748b; font-size: .92rem; }\n  .checkout-box button { background: #2563eb; color: #fff; border: none; padding: .7rem 1.5rem; border-radius: 9px; font-weight: 700; cursor: pointer; }\n</style>\n<div>\n  <div class=\"stepper\" role=\"list\" aria-label=\"Checkout progress\">\n    <div class=\"step done\" role=\"listitem\"><span class=\"num\" aria-hidden=\"true\">&#10003;</span><span class=\"lbl\">Cart</span><span class=\"sub\">3 items</span></div>\n    <div class=\"step current\" role=\"listitem\"><span class=\"num\" aria-current=\"step\">2</span><span class=\"lbl\">Shipping</span><span class=\"sub\">Enter address</span></div>\n    <div class=\"step\" role=\"listitem\"><span class=\"num\">3</span><span class=\"lbl\">Payment</span><span class=\"sub\">Card details</span></div>\n    <div class=\"step\" role=\"listitem\"><span class=\"num\">4</span><span class=\"lbl\">Review</span><span class=\"sub\">Place order</span></div>\n  </div>\n  <div class=\"checkout-box\">\n    <h3>Where should we send it?</h3>\n    <p>Enter a shipping address to continue to payment.</p>\n    <button type=\"button\">Continue to payment</button>\n  </div>\n</div>"
  },
