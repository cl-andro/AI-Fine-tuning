    "output": "<style>\n  .site-footer { background: #0f172a; color: #94a3b8; padding: 3rem clamp(1.25rem, 5vw, 3.5rem) 1.5rem; }\n  .footer-top { display: flex; flex-wrap: wrap; gap: 2.5rem; justify-content: space-between; }\n  .footer-brand { max-width: 260px; }\n  .footer-brand .logo { color: #fff; font-weight: 800; font-size: 1.2rem; }\n  .footer-brand p { font-size: .9rem; line-height: 1.6; margin: .6rem 0 1rem; }\n  .socials { display: flex; gap: .6rem; }\n  .socials a { width: 34px; height: 34px; border-radius: 8px; background: #1e293b; display: grid; place-items: center; color: #cbd5e1; text-decoration: none; }\n  .socials a:hover { background: #2563eb; color: #fff; }\n  .footer-cols { display: flex; flex-wrap: wrap; gap: 3rem; }\n  .footer-col h4 { color: #fff; font-size: .82rem; text-transform: uppercase; letter-spacing: .08em; margin: 0 0 .8rem; }\n  .footer-col a { display: block; color: #94a3b8; text-decoration: none; font-size: .9rem; margin-bottom: .5rem; }\n  .footer-col a:hover { color: #fff; }\n  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid #1e293b; font-size: .82rem; }\n  .footer-bottom a { color: #94a3b8; margin-left: 1.25rem; text-decoration: none; }\n  .footer-bottom a:hover { color: #fff; }\n</style>\n<footer class=\"site-footer\">\n  <div class=\"footer-top\">\n    <div class=\"footer-brand\">\n      <div class=\"logo\">Northwind</div>\n      <p>Tooling for teams that ship fast without cutting corners.</p>\n      <div class=\"socials\">\n        <a href=\"#\" aria-label=\"Northwind on X\">X</a>\n        <a href=\"#\" aria-label=\"Northwind on GitHub\">GH</a>\n        <a href=\"#\" aria-label=\"Northwind on LinkedIn\">in</a>\n      </div>\n    </div>\n    <div class=\"footer-cols\">\n      <div class=\"footer-col\"><h4>Product</h4><a href=\"#\">Features</a><a href=\"#\">Pricing</a><a href=\"#\">Changelog</a></div>\n      <div class=\"footer-col\"><h4>Company</h4><a href=\"#\">About</a><a href=\"#\">Careers</a><a href=\"#\">Blog</a></div>\n      <div class=\"footer-col\"><h4>Resources</h4><a href=\"#\">Docs</a><a href=\"#\">Guides</a><a href=\"#\">API status</a></div>\n      <div class=\"footer-col\"><h4>Legal</h4><a href=\"#\">Privacy</a><a href=\"#\">Terms</a><a href=\"#\">Security</a></div>\n    </div>\n  </div>\n  <div class=\"footer-bottom\">\n    <span>&copy; 2026 Northwind Labs, Inc.</span>\n    <span><a href=\"#\">Cookie settings</a><a href=\"#\">Sitemap</a></span>\n  </div>\n</footer>"
