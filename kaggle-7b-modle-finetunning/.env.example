# ==============================================================
# .env.example  ->  copy to `.env` and fill in real values
#   cp .env.example .env && chmod 600 .env
# NEVER commit the real .env file (it is in .gitignore).
# ==============================================================

# --- Kaggle API credentials (https://www.kaggle.com/settings -> API -> Create New Token) ---
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# --- Hugging Face token (only needed for GATED models like Llama, or to push the adapter) ---
# Create at https://huggingface.co/settings/tokens  (role: write)
HF_TOKEN=hf_replace_me
# Where the trained adapter gets pushed (optional, leave empty to skip)
HF_MODEL_REPO=your_hf_username/qwen2.5-7b-qlora-finetuned

# --- Weights & Biases (optional, leave empty to disable) ---
WANDB_API_KEY=

# --- Run knobs (override values from config.yaml) ---
# Base model to fine-tune: any HF id or a local path
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# Folder containing your custom training set (*.jsonl / *.json / *.csv)
TRAIN_DATASET_PATH=data/raw
# Output directory for checkpoints + adapter
OUTPUT_DIR=outputs

# --- Kaggle kernel slug used by scripts/push_kernel.sh & pull_results.sh ---
KAGGLE_KERNEL_SLUG=7b-qlora-finetune
